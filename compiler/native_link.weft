pub(package) fn native_link_elf_object_data(object: NativeLinkElfObject) -> List<NativeLinkObjectDataSection> {
  match object { NativeLinkElfObject(bytes, len, text_offset, text_addr, text_size, text_align, text_relaoff, text_nrela, text_section, symoff, nsyms, stroff, strsize, data) -> data }
}

-- Parse one AArch64 ELF relocatable member. Empty text is valid: feature-gated
-- C sources and data-only members commonly retain a zero-length .text section.
-- Allocated data and RELA tables keep their exact section identities so the
-- shared archive closure can preserve them in the final image.
pub(package) fn native_link_elf_object_parse(bytes: i64, len: i64) -> NativeLinkElfObjectParse {
  if len < 64 or bytes_u32_le_at(bytes, len, 0, 0) != 1179403647 or
    bytes_u8_at(bytes, len, 4, 0) != 2 or bytes_u8_at(bytes, len, 5, 0) != 1 or
    bytes_u8_at(bytes, len, 6, 0) != 1 or native_link_u16_le_at(bytes, len, 16, 0) != 1 or
    native_link_u16_le_at(bytes, len, 18, 0) != 183 or bytes_u32_le_at(bytes, len, 20, 0) != 1 or
    native_link_u16_le_at(bytes, len, 52, 0) != 64 or native_link_u16_le_at(bytes, len, 58, 0) != 64 {
    NativeLinkElfObjectMalformed
  } else {
    let section_offset = bytes_u64_le_at(bytes, len, 40, 0 - 1)
    let section_count = native_link_u16_le_at(bytes, len, 60, 0)
    let mut malformed = section_count == 0 or section_offset < 0 or section_offset + section_count * 64 > len
    let mut text_offset = 0 - 1
    let mut text_addr = 0
    let mut text_size = 0
    let mut text_align = 0
    let mut text_section = 0
    let mut symoff = 0 - 1
    let mut nsyms = 0
    let mut symtab_section = 0 - 1
    let mut strtab_section = 0 - 1
    let mut stroff = 0 - 1
    let mut strsize = 0
    let mut relaoff = 0
    let mut nrela = 0
    let mut data = list_nil<NativeLinkObjectDataSection>()
    let mut section_index = 1
    while section_index < section_count and malformed == false {
      let section = section_offset + section_index * 64
      let kind = bytes_u32_le_at(bytes, len, section + 4, 0)
      let flags = bytes_u64_le_at(bytes, len, section + 8, 0)
      let address = bytes_u64_le_at(bytes, len, section + 16, 0)
      let offset = bytes_u64_le_at(bytes, len, section + 24, 0 - 1)
      let size = bytes_u64_le_at(bytes, len, section + 32, 0 - 1)
      let align = bytes_u64_le_at(bytes, len, section + 48, 0)
      let entry_size = bytes_u64_le_at(bytes, len, section + 56, 0)
      if size < 0 or offset < 0 or (kind != 8 and offset + size > len) { malformed = true }
      else {
        if kind == 1 and flags band 6 == 6 {
          let exponent = native_link_power_of_two_exponent(align)
          if text_offset >= 0 or exponent < 0 or exponent > 20 { malformed = true }
          else {
            text_offset = offset
            text_addr = address
            text_size = size
            text_align = exponent
            text_section = section_index
          }
        } else {
          if flags band 2 == 2 and size > 0 {
            let exponent = native_link_power_of_two_exponent(align)
            if flags band 4 == 4 or flags band 1024 == 1024 or exponent < 0 or exponent > 20 {
              malformed = true
            } else {
              if kind == 1 {
                data = list_append<NativeLinkObjectDataSection>(data, NativeLinkElfDataBytes(address, size, offset, exponent, section_index, 0, 0))
              } else {
                if kind == 8 {
                  data = list_append<NativeLinkObjectDataSection>(data, NativeLinkElfDataZeroFill(address, size, exponent, section_index, 0, 0))
                } else { malformed = true }
              }
            }
          }
          else {
            if kind == 2 {
              if symoff >= 0 or entry_size != 24 or size % 24 != 0 { malformed = true }
              else {
                symoff = offset
                nsyms = size / 24
                symtab_section = section_index
                strtab_section = bytes_u32_le_at(bytes, len, section + 40, 0 - 1)
              }
            } else { 0 }
          }
        }
      }
      section_index = section_index + 1
    }
    if malformed == false and strtab_section > 0 and strtab_section < section_count {
      let string_section = section_offset + strtab_section * 64
      let string_kind = bytes_u32_le_at(bytes, len, string_section + 4, 0)
      stroff = bytes_u64_le_at(bytes, len, string_section + 24, 0 - 1)
      strsize = bytes_u64_le_at(bytes, len, string_section + 32, 0 - 1)
      if string_kind != 3 or stroff < 0 or strsize <= 0 or stroff + strsize > len { malformed = true } else { 0 }
    } else { malformed = true }
    section_index = 1
    while section_index < section_count and malformed == false {
      let section = section_offset + section_index * 64
      let kind = bytes_u32_le_at(bytes, len, section + 4, 0)
      let linked_symbols = bytes_u32_le_at(bytes, len, section + 40, 0 - 1)
      let relocated_section = bytes_u32_le_at(bytes, len, section + 44, 0 - 1)
      let offset = bytes_u64_le_at(bytes, len, section + 24, 0 - 1)
      let size = bytes_u64_le_at(bytes, len, section + 32, 0 - 1)
      let entry_size = bytes_u64_le_at(bytes, len, section + 56, 0)
      if kind == 4 and relocated_section == text_section {
        if relaoff != 0 or linked_symbols != symtab_section or entry_size != 24 or size % 24 != 0 or offset < 0 or offset + size > len {
          malformed = true
        } else {
          relaoff = offset
          nrela = size / 24
        }
      } else {
        if kind == 4 and native_link_object_data_has_section(data, relocated_section) == 1 {
          if linked_symbols != symtab_section or entry_size != 24 or size % 24 != 0 or offset < 0 or offset + size > len or
            native_link_object_data_section_has_relocations(data, relocated_section) == 1 {
            malformed = true
          } else {
            data = native_link_elf_data_attach_relocations(data, relocated_section, offset, size / 24)
          }
        } else { if (kind == 4 or kind == 9) and relocated_section > 0 and relocated_section < section_count {
          let target_section = section_offset + relocated_section * 64
          let target_flags = bytes_u64_le_at(bytes, len, target_section + 8, 0)
          if target_flags band 2 == 2 { malformed = true } else { 0 }
        } else { 0 } }
      }
      section_index = section_index + 1
    }
    if malformed or text_offset < 0 or text_size < 0 or symoff < 0 or nsyms == 0 or
      native_link_object_data_sections_valid(data, len) == 0 {
      NativeLinkElfObjectMalformed
    } else {
      NativeLinkElfObjectParsed(NativeLinkElfObject(
        bytes, len, text_offset, text_addr, text_size, text_align, relaoff,
        nrela, text_section, symoff, nsyms, stroff, strsize, data
      ))
    }
  }
}

pub(package) fn native_link_object_parse_for_target(bytes: i64, len: i64, target: NativeLinkTarget) -> NativeLinkObjectParse {
  match target {
    NativeLinkMacosAarch64 -> match native_link_mach_object_parse(bytes, len) {
      NativeLinkMachObjectParsed(object) -> NativeLinkObjectParsed(NativeLinkMachRelocatableObject(object))
      NativeLinkMachObjectMalformed -> NativeLinkObjectMalformed
    }
    NativeLinkLinuxAarch64 -> match native_link_elf_object_parse(bytes, len) {
      NativeLinkElfObjectParsed(object) -> NativeLinkObjectParsed(NativeLinkElfRelocatableObject(object))
      NativeLinkElfObjectMalformed -> NativeLinkObjectMalformed
    }
  }
}

pub(package) fn native_link_archive_short_name_len(bytes: i64, len: i64, start: i64) -> i64 {
  let mut name_len = 0
  let mut done = false
  while name_len < 16 and done == false {
    let ch = bytes_u8_at(bytes, len, start + name_len, 0)
    if ch == 47 or ch == 32 or ch == 0 { done = true }
    else { name_len = name_len + 1 }
  }
  name_len
}

pub(package) fn native_link_archive_extended_name_len(bytes: i64, len: i64, start: i64, stored_len: i64) -> i64 {
  let mut name_len = stored_len
  while name_len > 0 and bytes_u8_at(bytes, len, start + name_len - 1, 0) == 0 {
    name_len = name_len - 1
  }
  name_len
}

pub(package) fn native_link_archive_parse_for_target(bytes: i64, len: i64, target: NativeLinkTarget) -> NativeLinkArchiveParse {
  if len < 8 or bytes_match_str_at(bytes, len, 0, "!<arch>\n") == 0 {
    NativeLinkArchiveMalformed
  } else {
    let mut members = list_nil<NativeLinkArchiveMember>()
    let mut cursor = 8
    let mut ordinal = 0
    let mut malformed = false
    while cursor < len and malformed == false {
      if cursor + 60 > len or bytes_match_str_at(bytes, len, cursor + 58, "`\n") == 0 {
        malformed = true
      } else {
        let stored_size = bytes_decimal_at(bytes, len, cursor + 48, 10)
        let data = cursor + 60
        let member_end = data + stored_size
        if stored_size < 0 or member_end > len { malformed = true }
        else {
          let extended = bytes_match_str_at(bytes, len, cursor, "#1/")
          let name_len = if extended == 1 { bytes_decimal_at(bytes, len, cursor + 3, 13) } else { 0 }
          let object = bytes + data + name_len
          let object_len = stored_size - name_len
          let metadata = if extended == 1 { bytes_match_str_at(bytes, len, data, "__.SYMDEF") }
          else { bytes_match_str_at(bytes, len, cursor, "/") }
          if name_len < 0 or object_len < 0 { malformed = true }
          else {
            match native_link_object_parse_for_target(object, object_len, target) {
              NativeLinkObjectParsed(parsed) -> {
                let name = if extended == 1 {
                  NativeLinkByteView(bytes + data, native_link_archive_extended_name_len(bytes, len, data, name_len))
                }
                  else { NativeLinkByteView(bytes + cursor, native_link_archive_short_name_len(bytes, len, cursor)) }
                members = list_append<NativeLinkArchiveMember>(members, NativeLinkArchiveMember(ordinal, name, parsed))
                ordinal = ordinal + 1
                0
              }
              -- Archive symbol indexes are the only admitted non-object
              -- members. A wrong-architecture or malformed object cannot hide
              -- beside one valid member.
              NativeLinkObjectMalformed -> if metadata == 1 { 0 } else { malformed = true 0 }
            }
            cursor = native_link_align(member_end, 2)
          }
        }
      }
    }
    if malformed or cursor != len or list_len<NativeLinkArchiveMember>(members) == 0 { NativeLinkArchiveMalformed }
    else { NativeLinkArchiveParsed(members) }
  }
}

pub(package) fn native_link_archive_parse(bytes: i64, len: i64) -> NativeLinkArchiveParse {
  native_link_archive_parse_for_target(bytes, len, NativeLinkMacosAarch64)
}

pub(package) fn native_link_mach_object_symbol_view(object: NativeLinkMachObject, symbol_index: i64) -> NativeLinkByteView {
  if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(object) { NativeLinkByteView(0, 0) }
  else {
    let bytes = native_link_mach_object_bytes(object)
    let len = native_link_mach_object_len(object)
    let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
    let string_index = bytes_u32_le_at(bytes, len, symbol, 0)
    let string_start = native_link_mach_object_stroff(object) + string_index
    let string_end = native_link_mach_object_stroff(object) + native_link_mach_object_strsize(object)
    let name_len = bytes_cstr_len_bounded(bytes, string_end, string_start)
    if string_index == 0 or name_len <= 0 { NativeLinkByteView(0, 0) }
    else { NativeLinkByteView(bytes + string_start, name_len) }
  }
}

pub(package) fn native_link_byte_view_matches_name(view: NativeLinkByteView, name: str) -> i64 {
  let ptr = native_link_byte_view_ptr(view)
  let len = native_link_byte_view_len(view)
  let name_len = __str_len(name)
  let prefix = if len == name_len + 1 and bytes_u8_at(ptr, len, 0, 0) == 95 { 1 } else { 0 }
  if len - prefix != name_len { 0 }
  else {
    let mut equal = 1
    let mut i = 0
    while i < name_len and equal == 1 {
      if bytes_u8_at(ptr, len, prefix + i, 0) != bytes_u8_at(__str_ptr(name), name_len, i, 0) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn native_link_mach_object_symbol_definition(object: NativeLinkMachObject, symbol_index: i64) -> NativeLinkObjectDefinition {
  if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(object) { NativeLinkNoObjectDefinition }
  else {
    let bytes = native_link_mach_object_bytes(object)
    let len = native_link_mach_object_len(object)
    let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
    let kind = bytes_u8_at(bytes, len, symbol + 4, 0)
    let desc = bytes_u8_at(bytes, len, symbol + 6, 0) + bytes_u8_at(bytes, len, symbol + 7, 0) * 256
    let value = bytes_u64_le_at(bytes, len, symbol + 8, 0)
    if kind band 1 == 0 { NativeLinkNoObjectDefinition }
    else {
      match kind band 14 {
        14 -> if desc band 128 == 128 {
          NativeLinkWeakObjectDefinition(symbol_index)
        } else {
          NativeLinkStrongObjectDefinition(symbol_index)
        }
        0 -> if value > 0 {
          NativeLinkCommonObjectDefinition(symbol_index, value, desc bshr 8 band 15)
        } else {
          NativeLinkNoObjectDefinition
        }
        _ -> NativeLinkNoObjectDefinition
      }
    }
  }
}

pub(package) fn native_link_mach_object_definition_is_text(object: NativeLinkMachObject, definition: NativeLinkObjectDefinition) -> i64 {
  match definition {
    NativeLinkStrongObjectDefinition(symbol_index) -> {
      let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
      if bytes_u8_at(native_link_mach_object_bytes(object), native_link_mach_object_len(object), symbol + 5, 0) == native_link_mach_object_text_section(object) { 1 } else { 0 }
    }
    NativeLinkWeakObjectDefinition(symbol_index) -> {
      let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
      if bytes_u8_at(native_link_mach_object_bytes(object), native_link_mach_object_len(object), symbol + 5, 0) == native_link_mach_object_text_section(object) { 1 } else { 0 }
    }
    NativeLinkCommonObjectDefinition(symbol_index, size, align) -> 0
    NativeLinkNoObjectDefinition -> 0
  }
}

pub(package) fn native_link_elf_object_symbol_view(object: NativeLinkElfObject, symbol_index: i64) -> NativeLinkByteView {
  if symbol_index < 0 or symbol_index >= native_link_elf_object_nsyms(object) { NativeLinkByteView(0, 0) }
  else {
    let bytes = native_link_elf_object_bytes(object)
    let len = native_link_elf_object_len(object)
    let symbol = native_link_elf_object_symoff(object) + symbol_index * 24
    let string_index = bytes_u32_le_at(bytes, len, symbol, 0)
    let string_start = native_link_elf_object_stroff(object) + string_index
    let string_end = native_link_elf_object_stroff(object) + native_link_elf_object_strsize(object)
    let name_len = bytes_cstr_len_bounded(bytes, string_end, string_start)
    if string_index == 0 or name_len <= 0 { NativeLinkByteView(0, 0) }
    else { NativeLinkByteView(bytes + string_start, name_len) }
  }
}

pub(package) fn native_link_elf_object_symbol_definition(object: NativeLinkElfObject, symbol_index: i64) -> NativeLinkObjectDefinition {
  if symbol_index < 0 or symbol_index >= native_link_elf_object_nsyms(object) { NativeLinkNoObjectDefinition }
  else {
    let bytes = native_link_elf_object_bytes(object)
    let len = native_link_elf_object_len(object)
    let symbol = native_link_elf_object_symoff(object) + symbol_index * 24
    let binding = bytes_u8_at(bytes, len, symbol + 4, 0) bshr 4
    let section = native_link_u16_le_at(bytes, len, symbol + 6, 0)
    let value = bytes_u64_le_at(bytes, len, symbol + 8, 0)
    let size = bytes_u64_le_at(bytes, len, symbol + 16, 0)
    if binding != 1 and binding != 2 { NativeLinkNoObjectDefinition }
    else {
      if section == 0 { NativeLinkNoObjectDefinition }
      else {
        if section == 65522 {
          let align = native_link_power_of_two_exponent(value)
          if size > 0 and align >= 0 { NativeLinkCommonObjectDefinition(symbol_index, size, align) }
          else { NativeLinkNoObjectDefinition }
        } else {
          if binding == 2 { NativeLinkWeakObjectDefinition(symbol_index) }
          else { NativeLinkStrongObjectDefinition(symbol_index) }
        }
      }
    }
  }
}

pub(package) fn native_link_elf_object_definition_is_text(object: NativeLinkElfObject, definition: NativeLinkObjectDefinition) -> i64 {
  let symbol_index = match definition {
    NativeLinkStrongObjectDefinition(index) -> index
    NativeLinkWeakObjectDefinition(index) -> index
    _ -> 0 - 1
  }
  if symbol_index < 0 { 0 }
  else {
    let symbol = native_link_elf_object_symoff(object) + symbol_index * 24
    if native_link_u16_le_at(native_link_elf_object_bytes(object), native_link_elf_object_len(object), symbol + 6, 0) == native_link_elf_object_text_section(object) { 1 }
    else { 0 }
  }
}

pub(package) fn native_link_object_bytes(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_bytes(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_bytes(value)
  }
}

pub(package) fn native_link_object_len(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_len(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_len(value)
  }
}

pub(package) fn native_link_object_text_offset(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_text_offset(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_text_offset(value)
  }
}

pub(package) fn native_link_object_text_size(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_text_size(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_text_size(value)
  }
}

pub(package) fn native_link_object_text_align(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_text_align(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_text_align(value)
  }
}

pub(package) fn native_link_object_text_relocation_count(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_text_nreloc(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_text_nrela(value)
  }
}

pub(package) fn native_link_object_data_relocation_count_from_sections(data: List<NativeLinkObjectDataSection>) -> i64 {
  match data {
    Nil -> 0
    Cons(entry, rest) -> native_link_object_data_relocation_count_for_section(entry) + native_link_object_data_relocation_count_from_sections(rest)
  }
}

pub(package) fn native_link_object_data_relocation_count(object: NativeLinkObject) -> i64 {
  native_link_object_data_relocation_count_from_sections(native_link_object_data(object))
}

pub(package) fn native_link_object_symbol_count(object: NativeLinkObject) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_nsyms(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_nsyms(value)
  }
}

pub(package) fn native_link_object_data(object: NativeLinkObject) -> List<NativeLinkObjectDataSection> {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_data(value)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_data(value)
  }
}

pub(package) fn native_link_mach_data_relocation(object: NativeLinkMachObject, data: List<NativeLinkObjectDataSection>, relocation_index: i64) -> NativeLinkObjectDataRelocation {
  match data {
    Nil -> NativeLinkObjectDataRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
    Cons(section, rest) -> {
      let count = native_link_object_data_relocation_count_for_section(section)
      if relocation_index >= count { native_link_mach_data_relocation(object, rest, relocation_index - count) }
      else {
        let bytes = native_link_mach_object_bytes(object)
        let len = native_link_mach_object_len(object)
        let relocation = native_link_object_data_relocation_offset(section) + relocation_index * 8
        let address = bytes_u32_le_at(bytes, len, relocation, 0 - 1)
        let info = bytes_u32_le_at(bytes, len, relocation + 4, 0)
        let symbol_index = info band 16777215
        let pcrel = info bshr 24 band 1
        let width = info bshr 25 band 3
        let external = info bshr 27 band 1
        let kind = info bshr 28 band 15
        let symbol = native_link_mach_object_symbol_view(object, symbol_index)
        if width != 3 or pcrel != 0 or external != 1 or kind != 0 {
          NativeLinkObjectDataRelocationUnsupported(symbol, kind)
        } else {
          let site = if address >= 0 and address + 8 <= native_link_object_data_size(section) { address } else { 0 - 1 }
          let addend = match section {
            NativeLinkMachDataBytes(addr, size, offset, align, section_index, reloff, nreloc) -> bytes_u64_le_at(bytes, len, offset + address, 0)
            NativeLinkMachDataZeroFill(addr, size, align, section_index, reloff, nreloc) -> 0
            _ -> 0
          }
          NativeLinkObjectDataAbsolute64(native_link_object_data_section(section), site, symbol_index, addend)
        }
      }
    }
  }
}

pub(package) fn native_link_elf_data_relocation(object: NativeLinkElfObject, data: List<NativeLinkObjectDataSection>, relocation_index: i64) -> NativeLinkObjectDataRelocation {
  match data {
    Nil -> NativeLinkObjectDataRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
    Cons(section, rest) -> {
      let count = native_link_object_data_relocation_count_for_section(section)
      if relocation_index >= count { native_link_elf_data_relocation(object, rest, relocation_index - count) }
      else {
        let bytes = native_link_elf_object_bytes(object)
        let len = native_link_elf_object_len(object)
        let relocation = native_link_object_data_relocation_offset(section) + relocation_index * 24
        let address = bytes_u64_le_at(bytes, len, relocation, 0 - 1) - native_link_object_data_addr(section)
        let info = bytes_u64_le_at(bytes, len, relocation + 8, 0)
        let addend = bytes_u64_le_at(bytes, len, relocation + 16, 0)
        let symbol_index = info bshr 32
        let kind = info band 4294967295
        let symbol = native_link_elf_object_symbol_view(object, symbol_index)
        if kind != 257 { NativeLinkObjectDataRelocationUnsupported(symbol, kind) }
        else {
          let site = if address >= 0 and address + 8 <= native_link_object_data_size(section) { address } else { 0 - 1 }
          NativeLinkObjectDataAbsolute64(native_link_object_data_section(section), site, symbol_index, addend)
        }
      }
    }
  }
}

pub(package) fn native_link_object_data_relocation(object: NativeLinkObject, relocation_index: i64) -> NativeLinkObjectDataRelocation {
  if relocation_index < 0 or relocation_index >= native_link_object_data_relocation_count(object) {
    NativeLinkObjectDataRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
  } else {
    match object {
      NativeLinkMachRelocatableObject(value) -> native_link_mach_data_relocation(value, native_link_mach_object_data(value), relocation_index)
      NativeLinkElfRelocatableObject(value) -> native_link_elf_data_relocation(value, native_link_elf_object_data(value), relocation_index)
    }
  }
}

pub(package) fn native_link_object_symbol_view(object: NativeLinkObject, symbol_index: i64) -> NativeLinkByteView {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_symbol_view(value, symbol_index)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_symbol_view(value, symbol_index)
  }
}

pub(package) fn native_link_byte_view_matches_exact_name(view: NativeLinkByteView, name: str) -> i64 {
  let ptr = native_link_byte_view_ptr(view)
  let len = native_link_byte_view_len(view)
  if len != __str_len(name) { 0 }
  else {
    let mut equal = 1
    let mut i = 0
    while i < len and equal == 1 {
      if bytes_u8_at(ptr, len, i, 0) != bytes_u8_at(__str_ptr(name), len, i, 0) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn native_link_object_symbol_matches_name(object: NativeLinkObject, symbol_index: i64, name: str) -> i64 {
  let view = native_link_object_symbol_view(object, symbol_index)
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_byte_view_matches_name(view, name)
    NativeLinkElfRelocatableObject(value) -> native_link_byte_view_matches_exact_name(view, name)
  }
}

pub(package) fn native_link_object_symbol_name(object: NativeLinkObject, symbol_index: i64) -> str {
  let view = native_link_object_symbol_view(object, symbol_index)
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_byte_view_symbol_name(view)
    NativeLinkElfRelocatableObject(value) -> pkg_str_view(native_link_byte_view_ptr(view), native_link_byte_view_len(view))
  }
}

pub(package) fn native_link_object_symbol_name_for_view(object: NativeLinkObject, wanted: NativeLinkByteView) -> str {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_byte_view_symbol_name(wanted)
    NativeLinkElfRelocatableObject(value) -> pkg_str_view(native_link_byte_view_ptr(wanted), native_link_byte_view_len(wanted))
  }
}

pub(package) fn native_link_object_symbol_definition(object: NativeLinkObject, symbol_index: i64) -> NativeLinkObjectDefinition {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_symbol_definition(value, symbol_index)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_symbol_definition(value, symbol_index)
  }
}

pub(package) fn native_link_object_definition_is_text(object: NativeLinkObject, definition: NativeLinkObjectDefinition) -> i64 {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_definition_is_text(value, definition)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_definition_is_text(value, definition)
  }
}

pub(package) fn native_link_object_symbol_is_text_definition(object: NativeLinkObject, symbol_index: i64) -> i64 {
  native_link_object_definition_is_text(object, native_link_object_symbol_definition(object, symbol_index))
}

pub(package) fn native_link_object_text_definition_for_name(object: NativeLinkObject, name: str) -> NativeLinkObjectDefinition {
  let mut symbol_index = 0
  let mut found = NativeLinkNoObjectDefinition
  let mut done = false
  while symbol_index < native_link_object_symbol_count(object) and done == false {
    let definition = native_link_object_symbol_definition(object, symbol_index)
    if native_link_object_definition_is_text(object, definition) == 1 and
      native_link_object_symbol_matches_name(object, symbol_index, name) == 1 {
      match definition {
        NativeLinkStrongObjectDefinition(index) -> { found = definition done = true 0 }
        NativeLinkWeakObjectDefinition(index) -> { found = definition symbol_index = symbol_index + 1 0 }
        _ -> { symbol_index = symbol_index + 1 0 }
      }
    } else { symbol_index = symbol_index + 1 }
  }
  found
}

pub(package) fn native_link_object_defines(object: NativeLinkObject, name: str) -> i64 {
  match native_link_object_text_definition_for_name(object, name) {
    NativeLinkStrongObjectDefinition(index) -> 1
    NativeLinkWeakObjectDefinition(index) -> 1
    _ -> 0
  }
}

pub(package) fn native_link_dynamic_loads_from_fmap(entry: i64) -> List<NativeLinkDynamicLoad> {
  let raw = fmap_native_link_library_dynamic_loads(entry)
  let mut loads = list_nil<NativeLinkDynamicLoad>()
  for i in 0..nlist_len(raw) {
    let load = nlist_get(raw, i)
    let identity = NativeLinkByteView(fmap_native_link_dynamic_load_ptr(load), fmap_native_link_dynamic_load_len(load))
    loads = list_append<NativeLinkDynamicLoad>(loads, match fmap_native_link_dynamic_load_kind(load) {
      1 -> NativeLinkRequiredDynamicLoad(identity)
      2 -> NativeLinkWeakDynamicLoad(identity)
      3 -> NativeLinkReexportDynamicLoad(identity)
      4 -> NativeLinkUpwardDynamicLoad(identity)
      _ -> NativeLinkLazyDynamicLoad(identity)
    })
  }
  loads
}

pub(package) fn native_link_library_from_fmap(entry: i64) -> NativeLinkLibrary {
  let name = pkg_str_view(fmap_native_link_library_link_ptr(entry), fmap_native_link_library_link_len(entry))
  let selected = pkg_str_view(fmap_native_link_library_selected_path_ptr(entry), fmap_native_link_library_selected_path_len(entry))
  let content = pkg_str_view(fmap_native_link_library_content_ptr(entry), fmap_native_link_library_content_len(entry))
  let license = pkg_native_library_license_fact(fmap_native_link_library_raw(entry))
  match pkg_native_library_kind_fact(fmap_native_link_library_kind(entry)) {
    NativeSystemLibrary -> {
      let load_path = if str_eq(name, "System") == 1 { "/usr/lib/libSystem.B.dylib" } else { "" }
      NativeLinkSystemLibrary(name, load_path)
    }
    NativeArchiveLibrary -> NativeLinkStaticArchive(
      name,
      selected,
      content,
      license,
      fmap_native_link_library_artifact_ptr(entry),
      fmap_native_link_library_artifact_len(entry)
    )
    NativeDynamicLibrary -> NativeLinkDynamicLibrary(
      name,
      selected,
      pkg_str_view(fmap_native_link_library_load_identity_ptr(entry), fmap_native_link_library_load_identity_len(entry)),
      content,
      license,
      native_link_dynamic_loads_from_fmap(entry)
    )
  }
}

pub(package) fn native_link_plan_libraries_from_fmap(fm: i64, target: NativeLinkTarget) -> List<NativeLinkLibrary> {
  let mut libraries = match target {
    NativeLinkMacosAarch64 -> list_cons<NativeLinkLibrary>(NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"), list_nil<NativeLinkLibrary>())
    NativeLinkLinuxAarch64 -> list_nil<NativeLinkLibrary>()
  }
  for i in 0..fmap_native_link_library_count(fm) {
    let entry = fmap_native_link_library_at(fm, i)
    if fmap_native_link_library_is_used(entry) == 1 {
      libraries = list_append<NativeLinkLibrary>(libraries, native_link_library_from_fmap(entry))
    } else { 0 }
  }
  libraries
}

-- Darwin reserves library index zero for its libSystem platform contract.
-- Standalone Linux has no implicit library: its manifest-selected libraries
-- begin at zero. Both targets then retain manifest order while skipping
-- unreachable entries.
pub(package) fn native_link_manifest_library_base(target: NativeLinkTarget) -> i64 {
  match target {
    NativeLinkMacosAarch64 -> 1
    NativeLinkLinuxAarch64 -> 0
  }
}

pub(package) fn native_link_used_library_index(fm: i64, wanted: i64) -> i64 {
  let mut index = native_link_manifest_library_base(fmap_native_target(fm))
  let mut found = 0 - 1
  let mut i = 0
  while i < fmap_native_link_library_count(fm) and found < 0 {
    let entry = fmap_native_link_library_at(fm, i)
    if fmap_native_link_library_is_used(entry) == 1 {
      if entry == wanted { found = index } else { index = index + 1 }
    } else { 0 }
    i = i + 1
  }
  found
}

pub(package) fn native_link_plan_imports_from_fmap(fm: i64) -> List<NativeLinkImport> {
  let mut imports = list_nil<NativeLinkImport>()
  for i in 0..got_sym_count() {
    imports = list_append<NativeLinkImport>(imports, NativeLinkImport(got_sym_name(i), 0, NativeLinkRuntimeImport))
  }
  for i in 0..fmap_native_external_used_count(fm) {
    let entry = fmap_native_external_used_at(fm, i)
    let library_index = native_link_used_library_index(fm, fmap_native_external_entry_library(entry))
    imports = list_append<NativeLinkImport>(
      imports,
      NativeLinkImport(
        pkg_str_view(fmap_native_external_entry_symbol_ptr(entry), fmap_native_external_entry_symbol_len(entry)),
        library_index,
        NativeLinkManifestImport(i)
      )
    )
  }
  imports
}

pub(package) fn native_link_plan_relocations_from_fmap(fm: i64) -> List<NativeLinkPlanRelocation> {
  let mut relocations = list_nil<NativeLinkPlanRelocation>()
  for i in 0..fmap_got_patch_count(fm) {
    relocations = list_cons<NativeLinkPlanRelocation>(
      NativeLinkPlanBranch26(fmap_got_patch_code_pos(fm, i), fmap_got_patch_index(fm, i)),
      relocations
    )
  }
  relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanPageAddress(fmap_native_provenance_adrp_pos(fm), NativeLinkCodeAddress(fmap_native_provenance_table_offset(fm))),
    relocations
  )
  for i in 0..fmap_static_pair_patch_count(fm) {
    relocations = list_cons<NativeLinkPlanRelocation>(
      NativeLinkPlanPageAddress(fmap_static_pair_patch_code_pos(fm, i), NativeLinkStaticAddress(fmap_static_pair_patch_slot_off(fm, i))),
      relocations
    )
  }
  list_reverse<NativeLinkPlanRelocation>(relocations)
}

pub(package) fn native_link_library_at(libraries: List<NativeLinkLibrary>, index: i64) -> Option<NativeLinkLibrary> {
  list_nth<NativeLinkLibrary>(libraries, index)
}

pub(package) fn native_link_import_at(imports: List<NativeLinkImport>, index: i64) -> NativeLinkImport {
  match list_nth<NativeLinkImport>(imports, index) {
    Some(value) -> value
    None -> NativeLinkInvalidImport
  }
}

pub(package) type NativeLinkResolvedSlot {
  NativeLinkResolvedSlot(i64, i64)
}

pub(package) fn native_link_resolved_slot(slots: List<NativeLinkResolvedSlot>, import_index: i64) -> i64 {
  match slots {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkResolvedSlot(candidate, slot) -> {
        if candidate == import_index { slot } else { native_link_resolved_slot(rest, import_index) }
      }
    }
  }
}

pub(package) fn native_link_archive_member_ordinal(member: NativeLinkArchiveMember) -> i64 {
  match member { NativeLinkArchiveMember(ordinal, name, object) -> ordinal }
}

pub(package) fn native_link_archive_member_object(member: NativeLinkArchiveMember) -> NativeLinkObject {
  match member { NativeLinkArchiveMember(ordinal, name, object) -> object }
}

pub(package) fn native_link_catalog_library_index(catalog: NativeLinkArchiveCatalog) -> i64 {
  match catalog { NativeLinkArchiveCatalog(library_index, name, path, content, members) -> library_index }
}

pub(package) fn native_link_catalog_members(catalog: NativeLinkArchiveCatalog) -> List<NativeLinkArchiveMember> {
  match catalog { NativeLinkArchiveCatalog(library_index, name, path, content, members) -> members }
}

pub(package) fn native_link_selected_contains(selected: List<NativeLinkSelectedMember>, library_index: i64, member_ordinal: i64) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(candidate_library, candidate_ordinal, member) -> {
        if candidate_library == library_index and candidate_ordinal == member_ordinal { 1 }
        else { native_link_selected_contains(rest, library_index, member_ordinal) }
      }
    }
  }
}

pub(package) fn native_link_byte_views_same_symbol(left: NativeLinkByteView, right: NativeLinkByteView) -> i64 {
  let left_ptr = native_link_byte_view_ptr(left)
  let left_len = native_link_byte_view_len(left)
  let right_ptr = native_link_byte_view_ptr(right)
  let right_len = native_link_byte_view_len(right)
  if left_len != right_len { 0 }
  else {
    let mut equal = 1
    let mut i = 0
    while i < left_len and equal == 1 {
      if bytes_u8_at(left_ptr, left_len, i, 0) != bytes_u8_at(right_ptr, right_len, i, 0) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn native_link_object_text_definition_for_view(object: NativeLinkObject, wanted: NativeLinkByteView) -> NativeLinkObjectDefinition {
  let mut symbol_index = 0
  let mut found = NativeLinkNoObjectDefinition
  let mut done = false
  while symbol_index < native_link_object_symbol_count(object) and done == false {
    let definition = native_link_object_symbol_definition(object, symbol_index)
    if native_link_object_definition_is_text(object, definition) == 1 and
      native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
      match definition {
        NativeLinkStrongObjectDefinition(index) -> {
          found = definition
          done = true
          0
        }
        NativeLinkWeakObjectDefinition(index) -> {
          found = definition
          symbol_index = symbol_index + 1
          0
        }
        _ -> { symbol_index = symbol_index + 1 0 }
      }
    } else { symbol_index = symbol_index + 1 }
  }
  found
}

pub(package) fn native_link_object_defines_view(object: NativeLinkObject, wanted: NativeLinkByteView) -> i64 {
  match native_link_object_text_definition_for_view(object, wanted) {
    NativeLinkStrongObjectDefinition(index) -> 1
    NativeLinkWeakObjectDefinition(index) -> 1
    _ -> 0
  }
}

pub(package) fn native_link_object_data_definition_for_view(object: NativeLinkObject, wanted: NativeLinkByteView) -> NativeLinkObjectDefinition {
  let mut symbol_index = 0
  let mut found = NativeLinkNoObjectDefinition
  let mut done = false
  while symbol_index < native_link_object_symbol_count(object) and done == false {
    if native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
      let definition = native_link_object_symbol_definition(object, symbol_index)
      let data_definition = match object {
        NativeLinkElfRelocatableObject(value) -> match definition {
          NativeLinkStrongObjectDefinition(index) -> {
            let symbol = native_link_elf_object_symoff(value) + index * 24
            native_link_object_data_has_section(
              native_link_elf_object_data(value),
              native_link_u16_le_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 6, 0)
            )
          }
          NativeLinkWeakObjectDefinition(index) -> {
            let symbol = native_link_elf_object_symoff(value) + index * 24
            native_link_object_data_has_section(
              native_link_elf_object_data(value),
              native_link_u16_le_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 6, 0)
            )
          }
          NativeLinkCommonObjectDefinition(index, size, align) -> 1
          NativeLinkNoObjectDefinition -> 0
        }
        NativeLinkMachRelocatableObject(value) -> match definition {
          NativeLinkStrongObjectDefinition(index) -> {
            let symbol = native_link_mach_object_symoff(value) + index * 16
            native_link_object_data_has_section(
              native_link_mach_object_data(value),
              bytes_u8_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 5, 0)
            )
          }
          NativeLinkWeakObjectDefinition(index) -> {
            let symbol = native_link_mach_object_symoff(value) + index * 16
            native_link_object_data_has_section(
              native_link_mach_object_data(value),
              bytes_u8_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 5, 0)
            )
          }
          NativeLinkCommonObjectDefinition(index, size, align) -> 1
          NativeLinkNoObjectDefinition -> 0
        }
      }
      if data_definition == 1 {
        match definition {
          NativeLinkStrongObjectDefinition(index) -> { found = definition done = true 0 }
          NativeLinkCommonObjectDefinition(index, size, align) -> {
            match found {
              NativeLinkStrongObjectDefinition(other) -> 0
              _ -> { found = definition 0 }
            }
            symbol_index = symbol_index + 1
            0
          }
          NativeLinkWeakObjectDefinition(index) -> {
            match found {
              NativeLinkNoObjectDefinition -> { found = definition 0 }
              _ -> 0
            }
            symbol_index = symbol_index + 1
            0
          }
          NativeLinkNoObjectDefinition -> { symbol_index = symbol_index + 1 0 }
        }
      } else { symbol_index = symbol_index + 1 }
    } else { symbol_index = symbol_index + 1 }
  }
  found
}

pub(package) fn native_link_archive_catalogs(libraries: List<NativeLinkLibrary>, target: NativeLinkTarget) -> List<NativeLinkArchiveCatalog> {
  let mut catalogs = list_nil<NativeLinkArchiveCatalog>()
  let mut current = libraries
  let mut library_index = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkStaticArchive(name, path, content, license, bytes, len) -> {
            match native_link_archive_parse_for_target(bytes, len, target) {
              NativeLinkArchiveParsed(members) -> {
                catalogs = list_append<NativeLinkArchiveCatalog>(catalogs, NativeLinkArchiveCatalog(library_index, name, path, content, members))
                0
              }
              NativeLinkArchiveMalformed -> 0
            }
          }
          _ -> 0
        }
        library_index = library_index + 1
        current = rest
        0
      }
    }
  }
  catalogs
}

pub(package) fn native_link_find_member_for_name(catalogs: List<NativeLinkArchiveCatalog>, constrained_library: i64, name: str) -> Option<NativeLinkSelectedMember> {
  let mut current_catalog = catalogs
  let mut candidate = NativeLinkNoMemberCandidate
  let mut done = false
  while done == false {
    match current_catalog {
      Nil -> { done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        if constrained_library < 0 or constrained_library == library_index {
          let mut current_member = native_link_catalog_members(catalog)
          let mut members_done = false
          while members_done == false and done == false {
            match current_member {
              Nil -> { members_done = true 0 }
              Cons(member, rest_members) -> {
                let selected = NativeLinkSelectedMember(library_index, native_link_archive_member_ordinal(member), member)
                match native_link_object_text_definition_for_name(native_link_archive_member_object(member), name) {
                  NativeLinkStrongObjectDefinition(index) -> {
                    candidate = NativeLinkStrongMemberCandidate(selected)
                    done = true
                    0
                  }
                  NativeLinkWeakObjectDefinition(index) -> {
                    match candidate {
                      NativeLinkNoMemberCandidate -> { candidate = NativeLinkWeakMemberCandidate(selected) 0 }
                      _ -> 0
                    }
                    current_member = rest_members
                    0
                  }
                  _ -> { current_member = rest_members 0 }
                }
                0
              }
            }
          }
        } else { 0 }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  match candidate {
    NativeLinkStrongMemberCandidate(selected) -> Some(selected)
    NativeLinkCommonMemberCandidate(selected) -> Some(selected)
    NativeLinkWeakMemberCandidate(selected) -> Some(selected)
    NativeLinkNoMemberCandidate -> None<NativeLinkSelectedMember>()
  }
}

pub(package) fn native_link_find_member_for_view(catalogs: List<NativeLinkArchiveCatalog>, wanted: NativeLinkByteView) -> Option<NativeLinkSelectedMember> {
  let mut current_catalog = catalogs
  let mut candidate = NativeLinkNoMemberCandidate
  let mut done = false
  while done == false {
    match current_catalog {
      Nil -> { done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        let mut current_member = native_link_catalog_members(catalog)
        let mut member_done = false
        while member_done == false and done == false {
          match current_member {
            Nil -> { member_done = true 0 }
            Cons(member, rest_members) -> {
              let selected = NativeLinkSelectedMember(library_index, native_link_archive_member_ordinal(member), member)
              match native_link_object_text_definition_for_view(native_link_archive_member_object(member), wanted) {
                NativeLinkStrongObjectDefinition(index) -> {
                  candidate = NativeLinkStrongMemberCandidate(selected)
                  done = true
                  0
                }
                NativeLinkWeakObjectDefinition(index) -> {
                  match candidate {
                    NativeLinkNoMemberCandidate -> { candidate = NativeLinkWeakMemberCandidate(selected) 0 }
                    _ -> 0
                  }
                  current_member = rest_members
                  0
                }
                _ -> { current_member = rest_members 0 }
              }
              0
            }
          }
        }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  match candidate {
    NativeLinkStrongMemberCandidate(selected) -> Some(selected)
    NativeLinkCommonMemberCandidate(selected) -> Some(selected)
    NativeLinkWeakMemberCandidate(selected) -> Some(selected)
    NativeLinkNoMemberCandidate -> None<NativeLinkSelectedMember>()
  }
}

pub(package) fn native_link_find_data_member_for_view(catalogs: List<NativeLinkArchiveCatalog>, wanted: NativeLinkByteView) -> Option<NativeLinkSelectedMember> {
  let mut current_catalog = catalogs
  let mut candidate = NativeLinkNoMemberCandidate
  let mut done = false
  while done == false {
    match current_catalog {
      Nil -> { done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        let mut current_member = native_link_catalog_members(catalog)
        let mut members_done = false
        while members_done == false and done == false {
          match current_member {
            Nil -> { members_done = true 0 }
            Cons(member, rest_members) -> {
              let selected = NativeLinkSelectedMember(library_index, native_link_archive_member_ordinal(member), member)
              match native_link_object_data_definition_for_view(native_link_archive_member_object(member), wanted) {
                NativeLinkStrongObjectDefinition(index) -> {
                  candidate = NativeLinkStrongMemberCandidate(selected)
                  done = true
                  0
                }
                NativeLinkCommonObjectDefinition(index, size, align) -> {
                  match candidate {
                    NativeLinkStrongMemberCandidate(other) -> 0
                    NativeLinkCommonMemberCandidate(other) -> 0
                    _ -> { candidate = NativeLinkCommonMemberCandidate(selected) 0 }
                  }
                  current_member = rest_members
                  0
                }
                NativeLinkWeakObjectDefinition(index) -> {
                  match candidate {
                    NativeLinkNoMemberCandidate -> { candidate = NativeLinkWeakMemberCandidate(selected) 0 }
                    _ -> 0
                  }
                  current_member = rest_members
                  0
                }
                NativeLinkNoObjectDefinition -> { current_member = rest_members 0 }
              }
            }
          }
        }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  match candidate {
    NativeLinkStrongMemberCandidate(selected) -> Some(selected)
    NativeLinkCommonMemberCandidate(selected) -> Some(selected)
    NativeLinkWeakMemberCandidate(selected) -> Some(selected)
    NativeLinkNoMemberCandidate -> None<NativeLinkSelectedMember>()
  }
}

pub(package) fn native_link_find_address_member_for_view(catalogs: List<NativeLinkArchiveCatalog>, wanted: NativeLinkByteView) -> Option<NativeLinkSelectedMember> {
  match native_link_find_member_for_view(catalogs, wanted) {
    Some(selected) -> Some(selected)
    None -> native_link_find_data_member_for_view(catalogs, wanted)
  }
}

pub(package) fn native_link_selected_defines_data_view(selected: List<NativeLinkSelectedMember>, wanted: NativeLinkByteView) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(library_index, ordinal, member) -> {
        match native_link_object_data_definition_for_view(native_link_archive_member_object(member), wanted) {
          NativeLinkNoObjectDefinition -> native_link_selected_defines_data_view(rest, wanted)
          _ -> 1
        }
      }
    }
  }
}

pub(package) fn native_link_selected_defines_view(selected: List<NativeLinkSelectedMember>, wanted: NativeLinkByteView) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(library_index, ordinal, member) -> {
        if native_link_object_defines_view(native_link_archive_member_object(member), wanted) == 1 { 1 }
        else { native_link_selected_defines_view(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_mach_object_relocation(object: NativeLinkMachObject, relocation_index: i64) -> NativeLinkObjectRelocation {
  if relocation_index < 0 or relocation_index >= native_link_mach_object_text_nreloc(object) {
    NativeLinkObjectRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
  } else {
  let bytes = native_link_mach_object_bytes(object)
  let len = native_link_mach_object_len(object)
  let relocation = native_link_mach_object_text_reloff(object) + relocation_index * 8
  let address = bytes_u32_le_at(bytes, len, relocation, 0 - 1)
  let info = bytes_u32_le_at(bytes, len, relocation + 4, 0)
  let symbol_index = info band 16777215
  let pcrel = info bshr 24 band 1
  let width = info bshr 25 band 3
  let external = info bshr 27 band 1
  let kind = info bshr 28 band 15
  let symbol = native_link_mach_object_symbol_view(object, symbol_index)
  let addend = if relocation_index > 0 {
    let prior = native_link_mach_object_text_reloff(object) + (relocation_index - 1) * 8
    let prior_address = bytes_u32_le_at(bytes, len, prior, 0 - 1)
    let prior_info = bytes_u32_le_at(bytes, len, prior + 4, 0)
    let prior_kind = prior_info bshr 28 band 15
    let raw = prior_info band 16777215
    if prior_address == address and prior_kind == 10 {
      if raw band 8388608 == 8388608 { raw - 16777216 } else { raw }
    } else { 0 }
  } else { 0 }
  if address < 0 or width != 2 { NativeLinkObjectRelocationUnsupported(symbol, kind) }
  else {
    match kind {
      2 -> {
        let instruction = bytes_u32_le_at(bytes, len, native_link_mach_object_text_offset(object) + address, 0)
        let opcode = instruction band 4227858432
        if pcrel != 1 or external != 1 { NativeLinkObjectRelocationUnsupported(symbol, kind) }
        else {
          if opcode == 2483027968 { NativeLinkObjectCall26(address, symbol_index, addend) }
          else { if opcode == 335544320 { NativeLinkObjectJump26(address, symbol_index, addend) }
          else { NativeLinkObjectRelocationUnsupported(symbol, kind) } }
        }
      }
      3 -> if pcrel == 1 and external == 1 { NativeLinkObjectPage21(address, symbol_index, addend) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      4 -> if pcrel == 0 and external == 1 { NativeLinkObjectPageOff12(address, symbol_index, addend) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      5 -> if pcrel == 1 and external == 1 and addend == 0 { NativeLinkObjectGotPage21(address, symbol_index) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      6 -> if pcrel == 0 and external == 1 and addend == 0 { NativeLinkObjectGotPageOff12(address, symbol_index) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      10 -> {
        if pcrel == 0 and external == 0 and relocation_index + 1 < native_link_mach_object_text_nreloc(object) {
          let next = native_link_mach_object_text_reloff(object) + (relocation_index + 1) * 8
          let next_address = bytes_u32_le_at(bytes, len, next, 0 - 1)
          let next_kind = bytes_u32_le_at(bytes, len, next + 4, 0) bshr 28 band 15
          if next_address == address and (next_kind == 2 or next_kind == 3 or next_kind == 4) {
            NativeLinkObjectPairedAddend(address)
          } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
        } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      }
      _ -> NativeLinkObjectRelocationUnsupported(symbol, kind)
    }
  }
  }
}

pub(package) fn native_link_elf_object_relocation(object: NativeLinkElfObject, relocation_index: i64) -> NativeLinkObjectRelocation {
  if relocation_index < 0 or relocation_index >= native_link_elf_object_text_nrela(object) {
    NativeLinkObjectRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
  } else {
    let bytes = native_link_elf_object_bytes(object)
    let len = native_link_elf_object_len(object)
    let relocation = native_link_elf_object_text_relaoff(object) + relocation_index * 24
    let address = bytes_u64_le_at(bytes, len, relocation, 0 - 1)
    let info = bytes_u64_le_at(bytes, len, relocation + 8, 0)
    let addend = bytes_u64_le_at(bytes, len, relocation + 16, 0)
    let symbol_index = info bshr 32
    let kind = info band 4294967295
    let symbol = native_link_elf_object_symbol_view(object, symbol_index)
    if address < 0 or address + 4 > native_link_elf_object_text_size(object) {
      NativeLinkObjectRelocationUnsupported(symbol, kind)
    } else {
      match kind {
        275 -> NativeLinkObjectPage21(address, symbol_index, addend)
        277 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        278 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        282 -> NativeLinkObjectJump26(address, symbol_index, addend)
        283 -> NativeLinkObjectCall26(address, symbol_index, addend)
        284 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        285 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        286 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        299 -> NativeLinkObjectPageOff12(address, symbol_index, addend)
        _ -> NativeLinkObjectRelocationUnsupported(symbol, kind)
      }
    }
  }
}

pub(package) fn native_link_object_relocation(object: NativeLinkObject, relocation_index: i64) -> NativeLinkObjectRelocation {
  match object {
    NativeLinkMachRelocatableObject(value) -> native_link_mach_object_relocation(value, relocation_index)
    NativeLinkElfRelocatableObject(value) -> native_link_elf_object_relocation(value, relocation_index)
  }
}

pub(package) fn native_link_select_archive_closure(plan: NativeLinkPlan, catalogs: List<NativeLinkArchiveCatalog>) -> List<NativeLinkSelectedMember> {
  let libraries = native_link_plan_libraries(plan)
  let imports = native_link_plan_imports(plan)
  let mut selected = list_nil<NativeLinkSelectedMember>()
  let mut current_relocation = native_link_plan_relocations(plan)
  let mut relocations_done = false
  while relocations_done == false {
    match current_relocation {
      Nil -> { relocations_done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkPlanBranch26(address, import_index) -> {
            match native_link_import_at(imports, import_index) {
              NativeLinkImport(name, library_index, origin) -> {
                match native_link_library_at(libraries, library_index) {
                  Some(NativeLinkStaticArchive(archive_name, path, content, license, bytes, len)) -> {
                    match native_link_find_member_for_name(catalogs, library_index, name) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  }
                  _ -> 0
                }
              }
              NativeLinkInvalidImport -> 0
            }
          }
          _ -> 0
        }
        current_relocation = rest
        0
      }
    }
  }

  let mut changed = true
  while changed {
    changed = false
    let mut current_selected = selected
    let mut selected_done = false
    while selected_done == false {
      match current_selected {
        Nil -> { selected_done = true 0 }
        Cons(entry, rest_selected) -> match entry {
          NativeLinkSelectedMember(library_index, ordinal, member) -> {
            let object = native_link_archive_member_object(member)
            let mut relocation_index = 0
            while relocation_index < native_link_object_text_relocation_count(object) {
              match native_link_object_relocation(object, relocation_index) {
                NativeLinkObjectCall26(address, symbol_index, addend) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                if native_link_object_symbol_is_external(object, symbol_index) == 1 and native_link_selected_defines_view(selected, wanted) == 0 {
                  match native_link_find_member_for_view(catalogs, wanted) {
                    Some(candidate) -> match candidate {
                      NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                        if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                          selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                          changed = true
                        } else { 0 }
                      }
                    }
                    None -> 0
                  }
                } else { 0 }
                }
                NativeLinkObjectJump26(address, symbol_index, addend) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                if native_link_object_symbol_is_external(object, symbol_index) == 1 and native_link_selected_defines_view(selected, wanted) == 0 {
                  match native_link_find_member_for_view(catalogs, wanted) {
                    Some(candidate) -> match candidate {
                      NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                        if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                          selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                          changed = true
                        } else { 0 }
                      }
                    }
                    None -> 0
                  }
                } else { 0 }
                }
                NativeLinkObjectPage21(address, symbol_index, addend) -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  if native_link_object_symbol_is_external(object, symbol_index) == 1 and
                    native_link_selected_defines_view(selected, wanted) == 0 and native_link_selected_defines_data_view(selected, wanted) == 0 {
                    match native_link_find_address_member_for_view(catalogs, wanted) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                            changed = true
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  } else { 0 }
                }
                NativeLinkObjectPageOff12(address, symbol_index, addend) -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  if native_link_object_symbol_is_external(object, symbol_index) == 1 and
                    native_link_selected_defines_view(selected, wanted) == 0 and native_link_selected_defines_data_view(selected, wanted) == 0 {
                    match native_link_find_address_member_for_view(catalogs, wanted) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                            changed = true
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  } else { 0 }
                }
                NativeLinkObjectGotPage21(address, symbol_index) -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  if native_link_object_symbol_is_external(object, symbol_index) == 1 and
                    native_link_selected_defines_view(selected, wanted) == 0 and native_link_selected_defines_data_view(selected, wanted) == 0 {
                    match native_link_find_address_member_for_view(catalogs, wanted) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                            changed = true
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  } else { 0 }
                }
                NativeLinkObjectGotPageOff12(address, symbol_index) -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  if native_link_object_symbol_is_external(object, symbol_index) == 1 and
                    native_link_selected_defines_view(selected, wanted) == 0 and native_link_selected_defines_data_view(selected, wanted) == 0 {
                    match native_link_find_address_member_for_view(catalogs, wanted) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                            changed = true
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  } else { 0 }
                }
                NativeLinkObjectPairedAddend(address) -> 0
                NativeLinkObjectRelocationUnsupported(wanted, kind) -> 0
              }
              relocation_index = relocation_index + 1
            }
            let mut data_relocation_index = 0
            while data_relocation_index < native_link_object_data_relocation_count(object) {
              match native_link_object_data_relocation(object, data_relocation_index) {
                NativeLinkObjectDataAbsolute64(section, address, symbol_index, addend) -> {
                  if native_link_object_symbol_is_external(object, symbol_index) == 1 {
                    let wanted = native_link_object_symbol_view(object, symbol_index)
                    if native_link_selected_defines_view(selected, wanted) == 0 and native_link_selected_defines_data_view(selected, wanted) == 0 {
                      match native_link_find_address_member_for_view(catalogs, wanted) {
                        Some(candidate) -> match candidate {
                          NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                            if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                              selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                              changed = true
                            } else { 0 }
                          }
                        }
                        None -> 0
                      }
                    } else { 0 }
                  } else { 0 }
                }
                NativeLinkObjectDataRelocationUnsupported(wanted, kind) -> 0
              }
              data_relocation_index = data_relocation_index + 1
            }
            current_selected = rest_selected
            0
          }
        }
      }
    }
  }
  selected
}

pub(package) type NativeLinkArchiveLayout {
  NativeLinkArchiveLayout(rc i64, rc i64, i64, List<NativeLinkPlacedMember>, List<NativeLinkPlacedCommon>)
}

pub(package) fn native_link_layout_archive_members(code: i64, catalogs: List<NativeLinkArchiveCatalog>, selected: List<NativeLinkSelectedMember>) -> NativeLinkArchiveLayout {
  let merged = buf_new(buf_len(code) + 4096)
  let merged_data = buf_new(4096)
  let mut archive_align = 0
  bscopy(merged, buf_ptr(code), buf_len(code), 0)
  let mut placements = list_nil<NativeLinkPlacedMember>()
  let mut current_catalog = catalogs
  let mut catalogs_done = false
  while catalogs_done == false {
    match current_catalog {
      Nil -> { catalogs_done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        let mut current_member = native_link_catalog_members(catalog)
        let mut members_done = false
        while members_done == false {
          match current_member {
            Nil -> { members_done = true 0 }
            Cons(member, rest_members) -> {
              let ordinal = native_link_archive_member_ordinal(member)
              if native_link_selected_contains(selected, library_index, ordinal) == 1 {
                let object = native_link_archive_member_object(member)
                bpad(merged, native_link_align(buf_len(merged), native_link_pow2(native_link_object_text_align(object))))
                let code_offset = buf_len(merged)
                bscopy(
                  merged,
                  native_link_object_bytes(object) + native_link_object_text_offset(object),
                  native_link_object_text_size(object),
                  0
                )
                let mut placed_sections = list_nil<NativeLinkPlacedSection>()
                let mut current_data = native_link_object_data(object)
                let mut data_done = false
                while data_done == false {
                  match current_data {
                    Nil -> { data_done = true 0 }
                    Cons(data_section, rest_data) -> {
                      if native_link_object_data_align(data_section) > archive_align {
                        archive_align = native_link_object_data_align(data_section)
                      } else { 0 }
                      bpad(merged_data, native_link_align(buf_len(merged_data), native_link_pow2(native_link_object_data_align(data_section))))
                      let data_offset = buf_len(merged_data)
                      match data_section {
                        NativeLinkMachDataZeroFill(data_addr, data_size, data_align, section, reloff, nreloc) -> {
                          bpad(merged_data, data_offset + data_size)
                        }
                        NativeLinkMachDataBytes(data_addr, data_size, source_offset, data_align, section, reloff, nreloc) -> {
                          bscopy(merged_data, native_link_object_bytes(object) + source_offset, data_size, 0)
                        }
                        NativeLinkElfDataZeroFill(data_addr, data_size, data_align, section, relaoff, nrela) -> {
                          bpad(merged_data, data_offset + data_size)
                        }
                        NativeLinkElfDataBytes(data_addr, data_size, source_offset, data_align, section, relaoff, nrela) -> {
                          bscopy(merged_data, native_link_object_bytes(object) + source_offset, data_size, 0)
                        }
                      }
                      placed_sections = list_append<NativeLinkPlacedSection>(placed_sections, NativeLinkPlacedSection(data_section, data_offset))
                      current_data = rest_data
                      0
                    }
                  }
                }
                placements = list_append<NativeLinkPlacedMember>(placements, NativeLinkPlacedMember(library_index, ordinal, member, code_offset, placed_sections))
              } else { 0 }
              current_member = rest_members
              0
            }
          }
        }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  let mut commons = list_nil<NativeLinkPlacedCommon>()
  let mut current_common = native_link_selected_common_requirements(selected)
  let mut commons_done = false
  while commons_done == false {
    match current_common {
      Nil -> { commons_done = true 0 }
      Cons(requirement, rest) -> match requirement {
        NativeLinkCommonRequirement(name, size, align) -> {
          if align > archive_align { archive_align = align } else { 0 }
          bpad(merged_data, native_link_align(buf_len(merged_data), native_link_pow2(align)))
          let offset = buf_len(merged_data)
          bpad(merged_data, offset + size)
          commons = list_append<NativeLinkPlacedCommon>(commons, NativeLinkPlacedCommon(name, offset, size, align))
          current_common = rest
          0
        }
      }
    }
  }
  NativeLinkArchiveLayout(merged, merged_data, archive_align, placements, commons)
}

pub(package) fn native_link_object_code_address(object: NativeLinkObject, definition: NativeLinkObjectDefinition, code_offset: i64) -> i64 {
  let symbol_index = match definition {
    NativeLinkStrongObjectDefinition(index) -> index
    NativeLinkWeakObjectDefinition(index) -> index
    _ -> 0 - 1
  }
  if symbol_index < 0 { 0 - 1 }
  else {
    match object {
      NativeLinkMachRelocatableObject(value) -> {
        let symbol = native_link_mach_object_symoff(value) + symbol_index * 16
        code_offset + bytes_u64_le_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 8, 0) - native_link_mach_object_text_addr(value)
      }
      NativeLinkElfRelocatableObject(value) -> {
        let symbol = native_link_elf_object_symoff(value) + symbol_index * 24
        code_offset + bytes_u64_le_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 8, 0) - native_link_elf_object_text_addr(value)
      }
    }
  }
}

pub(package) fn native_link_placed_address_for_name(placements: List<NativeLinkPlacedMember>, name: str) -> i64 {
  let mut current = placements
  let mut weak_target = 0 - 1
  let mut strong_target = 0 - 1
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
          let object = native_link_archive_member_object(member)
          let definition = native_link_object_text_definition_for_name(object, name)
          match definition {
            NativeLinkStrongObjectDefinition(index) -> {
              strong_target = native_link_object_code_address(object, definition, code_offset)
              done = true
              0
            }
            NativeLinkWeakObjectDefinition(index) -> {
              if weak_target < 0 { weak_target = native_link_object_code_address(object, definition, code_offset) } else { 0 }
              current = rest
              0
            }
            _ -> { current = rest 0 }
          }
        }
      }
    }
  }
  if strong_target >= 0 { strong_target } else { weak_target }
}

pub(package) fn native_link_placed_address_for_view(placements: List<NativeLinkPlacedMember>, wanted: NativeLinkByteView) -> i64 {
  let mut current = placements
  let mut weak_target = 0 - 1
  let mut strong_target = 0 - 1
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
          let object = native_link_archive_member_object(member)
          let definition = native_link_object_text_definition_for_view(object, wanted)
          match definition {
            NativeLinkStrongObjectDefinition(index) -> {
              strong_target = native_link_object_code_address(object, definition, code_offset)
              done = true
              0
            }
            NativeLinkWeakObjectDefinition(index) -> {
              if weak_target < 0 { weak_target = native_link_object_code_address(object, definition, code_offset) } else { 0 }
              current = rest
              0
            }
            _ -> { current = rest 0 }
          }
        }
      }
    }
  }
  if strong_target >= 0 { strong_target } else { weak_target }
}

pub(package) fn native_link_object_symbol_is_external(object: NativeLinkObject, symbol_index: i64) -> i64 {
  if symbol_index < 0 or symbol_index >= native_link_object_symbol_count(object) { 0 }
  else {
    match object {
      NativeLinkMachRelocatableObject(value) -> {
        let symbol = native_link_mach_object_symoff(value) + symbol_index * 16
        bytes_u8_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 4, 0) band 1
      }
      NativeLinkElfRelocatableObject(value) -> {
        let symbol = native_link_elf_object_symoff(value) + symbol_index * 24
        let binding = bytes_u8_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 4, 0) bshr 4
        if binding == 1 or binding == 2 { 1 } else { 0 }
      }
    }
  }
}

pub(package) fn native_link_source_local_code_address(placements: List<NativeLinkPlacedMember>, source_object: NativeLinkObject, symbol_index: i64) -> i64 {
  match placements {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
        let object = native_link_archive_member_object(member)
        if native_link_object_bytes(object) == native_link_object_bytes(source_object) {
          match object {
            NativeLinkMachRelocatableObject(value) -> {
              if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(value) { 0 - 1 }
              else {
                let symbol = native_link_mach_object_symoff(value) + symbol_index * 16
                let section = bytes_u8_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 5, 0)
                if section == native_link_mach_object_text_section(value) {
                  code_offset + bytes_u64_le_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 8, 0) - native_link_mach_object_text_addr(value)
                } else { 0 - 1 }
              }
            }
            NativeLinkElfRelocatableObject(value) -> {
              if symbol_index < 0 or symbol_index >= native_link_elf_object_nsyms(value) { 0 - 1 }
              else {
                let symbol = native_link_elf_object_symoff(value) + symbol_index * 24
                let section = native_link_u16_le_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 6, 0)
                if section == native_link_elf_object_text_section(value) {
                  code_offset + bytes_u64_le_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 8, 0) - native_link_elf_object_text_addr(value)
                } else { 0 - 1 }
              }
            }
          }
        } else { native_link_source_local_code_address(rest, source_object, symbol_index) }
      }
    }
  }
}

pub(package) fn native_link_placed_code_address_for_symbol(placements: List<NativeLinkPlacedMember>, source_object: NativeLinkObject, symbol_index: i64) -> i64 {
  if symbol_index < 0 or symbol_index >= native_link_object_symbol_count(source_object) { 0 - 1 }
  else {
    if native_link_object_symbol_is_external(source_object, symbol_index) == 0 {
      native_link_source_local_code_address(placements, source_object, symbol_index)
    } else {
      native_link_placed_address_for_view(placements, native_link_object_symbol_view(source_object, symbol_index))
    }
  }
}

pub(package) fn native_link_placed_data_relocation_site(placements: List<NativeLinkPlacedMember>, source_object: NativeLinkObject, section: i64, address: i64) -> i64 {
  if address < 0 { 0 - 1 }
  else {
    match placements {
      Nil -> 0 - 1
      Cons(entry, rest) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
          let object = native_link_archive_member_object(member)
          if native_link_object_bytes(object) == native_link_object_bytes(source_object) {
            let source_addr = native_link_object_data_addr_for_section(native_link_object_data(object), section)
            if source_addr < 0 { 0 - 1 } else { native_link_placed_section_address(sections, section, source_addr + address) }
          } else { native_link_placed_data_relocation_site(rest, source_object, section, address) }
        }
      }
    }
  }
}

pub(package) fn native_link_placed_section_address(sections: List<NativeLinkPlacedSection>, section: i64, value: i64) -> i64 {
  match sections {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedSection(data, offset) -> {
        let start = native_link_object_data_addr(data)
        let size = native_link_object_data_size(data)
        if native_link_object_data_section(data) == section and value >= start and value <= start + size {
          offset + value - start
        } else { native_link_placed_section_address(rest, section, value) }
      }
    }
  }
}

pub(package) fn native_link_object_local_data_address(object: NativeLinkObject, symbol_index: i64, sections: List<NativeLinkPlacedSection>) -> i64 {
  match object {
    NativeLinkElfRelocatableObject(value) -> {
      if symbol_index < 0 or symbol_index >= native_link_elf_object_nsyms(value) { 0 - 1 }
      else {
        let bytes = native_link_elf_object_bytes(value)
        let len = native_link_elf_object_len(value)
        let symbol = native_link_elf_object_symoff(value) + symbol_index * 24
        let section = native_link_u16_le_at(bytes, len, symbol + 6, 0)
        native_link_placed_section_address(sections, section, bytes_u64_le_at(bytes, len, symbol + 8, 0))
      }
    }
    NativeLinkMachRelocatableObject(value) -> {
      if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(value) { 0 - 1 }
      else {
        let bytes = native_link_mach_object_bytes(value)
        let len = native_link_mach_object_len(value)
        let symbol = native_link_mach_object_symoff(value) + symbol_index * 16
        let kind = bytes_u8_at(bytes, len, symbol + 4, 0)
        let section = bytes_u8_at(bytes, len, symbol + 5, 0)
        if kind band 14 == 14 {
          native_link_placed_section_address(sections, section, bytes_u64_le_at(bytes, len, symbol + 8, 0))
        } else { 0 - 1 }
      }
    }
  }
}

pub(package) fn native_link_object_data_address(object: NativeLinkObject, definition: NativeLinkObjectDefinition, sections: List<NativeLinkPlacedSection>) -> i64 {
  let symbol_index = match definition {
    NativeLinkStrongObjectDefinition(index) -> index
    NativeLinkWeakObjectDefinition(index) -> index
    _ -> 0 - 1
  }
  native_link_object_local_data_address(object, symbol_index, sections)
}

pub(package) fn native_link_placed_data_address_for_view(placements: List<NativeLinkPlacedMember>, wanted: NativeLinkByteView) -> NativeLinkDataAddress {
  let mut current = placements
  let mut weak_target = 0 - 1
  let mut strong_target = 0 - 1
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
          let object = native_link_archive_member_object(member)
          let mut symbol_index = 0
          while symbol_index < native_link_object_symbol_count(object) and strong_target < 0 {
            if native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
              let definition = native_link_object_symbol_definition(object, symbol_index)
              let target = native_link_object_data_address(object, definition, sections)
              if target >= 0 {
                match definition {
                  NativeLinkStrongObjectDefinition(index) -> { strong_target = target 0 }
                  NativeLinkWeakObjectDefinition(index) -> { if weak_target < 0 { weak_target = target } else { 0 } 0 }
                  _ -> 0
                }
              } else { 0 }
            } else { 0 }
            symbol_index = symbol_index + 1
          }
          if strong_target >= 0 { done = true } else { current = rest }
          0
        }
      }
    }
  }
  if strong_target >= 0 { NativeLinkStrongDataAddress(strong_target) }
  else {
    if weak_target >= 0 { NativeLinkWeakDataAddress(weak_target) }
    else { NativeLinkNoDataAddress }
  }
}

pub(package) fn native_link_placed_common_address(commons: List<NativeLinkPlacedCommon>, wanted: NativeLinkByteView) -> i64 {
  match commons {
    Nil -> 0 - 1
    Cons(common, rest) -> match common {
      NativeLinkPlacedCommon(name, offset, size, align) -> {
        if native_link_byte_views_same_symbol(name, wanted) == 1 { offset }
        else { native_link_placed_common_address(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_source_local_data_address(placements: List<NativeLinkPlacedMember>, source_object: NativeLinkObject, symbol_index: i64) -> i64 {
  match placements {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
        let object = native_link_archive_member_object(member)
        if native_link_object_bytes(object) == native_link_object_bytes(source_object) {
          let local = native_link_object_local_data_address(object, symbol_index, sections)
          if local >= 0 { local } else { native_link_source_local_data_address(rest, source_object, symbol_index) }
        } else { native_link_source_local_data_address(rest, source_object, symbol_index) }
      }
    }
  }
}

pub(package) fn native_link_placed_data_address_for_symbol(placements: List<NativeLinkPlacedMember>, commons: List<NativeLinkPlacedCommon>, source_object: NativeLinkObject, symbol_index: i64) -> i64 {
  if symbol_index < 0 or symbol_index >= native_link_object_symbol_count(source_object) { 0 - 1 }
  else {
    let external = match source_object {
      NativeLinkMachRelocatableObject(value) -> {
        let symbol = native_link_mach_object_symoff(value) + symbol_index * 16
        bytes_u8_at(native_link_mach_object_bytes(value), native_link_mach_object_len(value), symbol + 4, 0) band 1
      }
      NativeLinkElfRelocatableObject(value) -> {
        let symbol = native_link_elf_object_symoff(value) + symbol_index * 24
        let binding = bytes_u8_at(native_link_elf_object_bytes(value), native_link_elf_object_len(value), symbol + 4, 0) bshr 4
        if binding == 1 or binding == 2 { 1 } else { 0 }
      }
    }
    if external == 0 { native_link_source_local_data_address(placements, source_object, symbol_index) }
    else {
      let wanted = native_link_object_symbol_view(source_object, symbol_index)
      match native_link_placed_data_address_for_view(placements, wanted) {
        NativeLinkStrongDataAddress(target) -> target
        NativeLinkWeakDataAddress(target) -> {
          let common = native_link_placed_common_address(commons, wanted)
          if common >= 0 { common } else { target }
        }
        NativeLinkNoDataAddress -> native_link_placed_common_address(commons, wanted)
      }
    }
  }
}

pub(package) fn native_link_placed_archive_address_for_symbol(placements: List<NativeLinkPlacedMember>, commons: List<NativeLinkPlacedCommon>, source_object: NativeLinkObject, symbol_index: i64) -> Option<NativeLinkArchiveAddressTarget> {
  let code_target = native_link_placed_code_address_for_symbol(placements, source_object, symbol_index)
  if code_target >= 0 { Some(NativeLinkArchiveCodeAddress(code_target)) }
  else {
    let data_target = native_link_placed_data_address_for_symbol(placements, commons, source_object, symbol_index)
    if data_target >= 0 { Some(NativeLinkArchiveDataAddress(data_target)) }
    else { None<NativeLinkArchiveAddressTarget>() }
  }
}

pub(package) fn native_link_object_has_strong_definition_view(object: NativeLinkObject, wanted: NativeLinkByteView) -> i64 {
  let mut symbol_index = 0
  let mut found = 0
  while symbol_index < native_link_object_symbol_count(object) and found == 0 {
    match native_link_object_symbol_definition(object, symbol_index) {
      NativeLinkStrongObjectDefinition(index) -> {
        if native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
          found = 1
        } else { symbol_index = symbol_index + 1 }
      }
      _ -> { symbol_index = symbol_index + 1 }
    }
  }
  found
}

pub(package) fn native_link_selected_has_strong_definition_view(selected: List<NativeLinkSelectedMember>, wanted: NativeLinkByteView) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(library_index, ordinal, member) -> {
        if native_link_object_has_strong_definition_view(native_link_archive_member_object(member), wanted) == 1 { 1 }
        else { native_link_selected_has_strong_definition_view(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_common_requirements_contain(requirements: List<NativeLinkCommonRequirement>, wanted: NativeLinkByteView) -> i64 {
  match requirements {
    Nil -> 0
    Cons(requirement, rest) -> match requirement {
      NativeLinkCommonRequirement(name, size, align) -> {
        if native_link_byte_views_same_symbol(name, wanted) == 1 { 1 }
        else { native_link_common_requirements_contain(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_selected_common_extent(selected: List<NativeLinkSelectedMember>, wanted: NativeLinkByteView) -> NativeLinkCommonRequirement {
  let mut current = selected
  let mut max_size = 0
  let mut max_align = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkSelectedMember(library_index, ordinal, member) -> {
          let object = native_link_archive_member_object(member)
          let mut symbol_index = 0
          while symbol_index < native_link_object_symbol_count(object) {
            match native_link_object_symbol_definition(object, symbol_index) {
              NativeLinkCommonObjectDefinition(index, size, align) -> {
                if native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
                  if size > max_size { max_size = size } else { 0 }
                  if align > max_align { max_align = align } else { 0 }
                } else { 0 }
              }
              _ -> 0
            }
            symbol_index = symbol_index + 1
          }
          current = rest
          0
        }
      }
    }
  }
  NativeLinkCommonRequirement(wanted, max_size, max_align)
}

pub(package) fn native_link_selected_common_requirements(selected: List<NativeLinkSelectedMember>) -> List<NativeLinkCommonRequirement> {
  let mut requirements = list_nil<NativeLinkCommonRequirement>()
  let mut current = selected
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkSelectedMember(library_index, ordinal, member) -> {
          let object = native_link_archive_member_object(member)
          let mut symbol_index = 0
          while symbol_index < native_link_object_symbol_count(object) {
            match native_link_object_symbol_definition(object, symbol_index) {
              NativeLinkCommonObjectDefinition(index, size, align) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                if native_link_byte_view_len(wanted) > 0 and
                  native_link_selected_has_strong_definition_view(selected, wanted) == 0 and
                  native_link_common_requirements_contain(requirements, wanted) == 0 {
                  requirements = list_append<NativeLinkCommonRequirement>(requirements, native_link_selected_common_extent(selected, wanted))
                } else { 0 }
              }
              _ -> 0
            }
            symbol_index = symbol_index + 1
          }
          current = rest
          0
        }
      }
    }
  }
  requirements
}

pub(package) fn native_link_append_selected_definition_errors(errors: List<NativeLinkError>, selected: List<NativeLinkSelectedMember>) -> List<NativeLinkError> {
  let mut result = errors
  let mut current = selected
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(entry, rest) -> match entry {
        NativeLinkSelectedMember(library_index, ordinal, member) -> {
          let object = native_link_archive_member_object(member)
          let mut symbol_index = 0
          while symbol_index < native_link_object_symbol_count(object) {
            match native_link_object_symbol_definition(object, symbol_index) {
              NativeLinkStrongObjectDefinition(index) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                if native_link_byte_view_len(wanted) > 0 and native_link_selected_has_strong_definition_view(rest, wanted) == 1 {
                  result = list_append<NativeLinkError>(result, NativeLinkDuplicateStrongSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                } else { 0 }
              }
              _ -> 0
            }
            symbol_index = symbol_index + 1
          }
          current = rest
          0
        }
      }
    }
  }
  result
}

pub(package) fn native_link_dynamic_identity_declared(libraries: List<NativeLinkLibrary>, wanted: str) -> i64 {
  match libraries {
    Nil -> 0
    Cons(library, rest) -> {
      let identity = match library {
        NativeLinkSystemLibrary(name, load_path) -> load_path
        NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> load_identity
        NativeLinkStaticArchive(name, path, content, license, bytes, len) -> ""
      }
      if str_eq(identity, wanted) == 1 { 1 } else { native_link_dynamic_identity_declared(rest, wanted) }
    }
  }
}

pub(package) fn native_link_append_dynamic_closure_errors(errors: List<NativeLinkError>, libraries: List<NativeLinkLibrary>) -> List<NativeLinkError> {
  let mut result = errors
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
            let mut pending = loads
            let mut loads_done = false
            while loads_done == false {
              match pending {
                Nil -> { loads_done = true 0 }
                Cons(load, remaining) -> {
                  let wanted = native_link_dynamic_load_identity(load)
                  if native_link_dynamic_identity_declared(libraries, wanted) == 0 {
                    result = list_append<NativeLinkError>(result, NativeLinkUndeclaredDynamicDependency(load_identity, wanted))
                  } else { 0 }
                  pending = remaining
                  0
                }
              }
            }
            0
          }
          _ -> 0
        }
        current = rest
        0
      }
    }
  }
  result
}

pub(package) fn native_link_validate_libraries_for_target(target: NativeLinkTarget, libraries: List<NativeLinkLibrary>) -> List<NativeLinkError> {
  let mut errors = list_nil<NativeLinkError>()
  let linux = match target {
    NativeLinkMacosAarch64 -> false
    NativeLinkLinuxAarch64 -> true
  }
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkSystemLibrary(name, load_path) -> {
            if linux {
              errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedTargetLibrary(target, name))
              0
            } else { if __str_len(load_path) == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedSystemLibrary(name))
              0
            } else { 0 } }
          }
          NativeLinkStaticArchive(name, path, content, license, bytes, len) -> {
            if bytes == 0 or len == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkMissingArchiveArtifact(name, path))
              0
            } else {
              match native_link_archive_parse_for_target(bytes, len, target) {
                NativeLinkArchiveParsed(members) -> 0
                NativeLinkArchiveMalformed -> {
                  errors = list_append<NativeLinkError>(errors, NativeLinkMalformedArchive(name, path))
                  0
                }
              }
            }
          }
          NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
            if __str_len(path) == 0 or __str_len(load_identity) == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkMissingDynamicArtifact(name))
              0
            } else { 0 }
          }
        }
        current = rest
        0
      }
    }
  }
  native_link_append_dynamic_closure_errors(errors, libraries)
}

pub(package) fn native_link_validate_libraries(libraries: List<NativeLinkLibrary>) -> List<NativeLinkError> {
  native_link_validate_libraries_for_target(NativeLinkMacosAarch64, libraries)
}

-- Both targets admit their native archive and dynamic-image forms through the
-- same closed resolution graph. Target validation rejects only foreign system
-- library kinds and malformed artifact identities; finalizers own the exact
-- container and loader policy.
pub(package) fn native_link_validate_target_libraries(target: NativeLinkTarget, libraries: List<NativeLinkLibrary>) -> List<NativeLinkError> {
  native_link_validate_libraries_for_target(target, libraries)
}

pub(package) fn native_link_image_layout(code: i64, archive_data: i64, archive_align: i64, symbol_count: i64, static_slots: i64) -> NativeLinkImageLayout {
  let stub_base = native_link_align(buf_len(code), 4)
  let code_size = stub_base + symbol_count * 12
  let text_size = native_link_align(16384 + code_size, 16384)
  let static_offset = native_link_align(symbol_count * 8, 16)
  let static_size = static_slots * 16
  let archive_alignment = native_link_pow2(archive_align)
  let archive_offset = native_link_align(text_size + static_offset + static_size, archive_alignment) - text_size
  let archive_size = buf_len(archive_data)
  let data_need = if archive_size > 0 { archive_offset + archive_size } else { static_offset + static_size }
  let data_size = native_link_align(if data_need > 0 { data_need } else { 1 }, 16384)
  NativeLinkImageLayout(stub_base, code_size, text_size, static_offset, static_size, archive_offset, archive_size, archive_align, data_size)
}

pub(package) fn native_link_branch_delta_valid(delta: i64) -> i64 {
  if delta >= 0 - 134217728 and delta <= 134217724 and delta % 4 == 0 { 1 } else { 0 }
}

pub(package) fn native_link_page_delta_valid(delta: i64) -> i64 {
  if delta >= 0 - 1048576 and delta <= 1048575 { 1 } else { 0 }
}

pub(package) fn native_link_pageoff12_is_valid(word: i64, page_offset: i64) -> i64 {
  let add_immediate = if word band 2130706432 == 285212672 { 1 } else { 0 }
  -- SIMD/FP Q loads and stores encode their 16-byte access in the opc field,
  -- not the ordinary two-bit load/store size field.
  let vector_128 = if word band 1065353216 == 1031798784 { 1 } else { 0 }
  let scale = if add_immediate == 1 { 0 } else { if vector_128 == 1 { 4 } else { word bshr 30 band 3 } }
  let divisor = native_link_pow2(scale)
  if page_offset >= 0 and page_offset < 4096 and page_offset / divisor * divisor == page_offset { 1 } else { 0 }
}

pub(package) fn native_link_relocation_encoding(relocation: NativeLinkRelocation) -> NativeLinkRelocationEncoding {
  match relocation {
    NativeLinkBranch26(address, slot) -> NativeLinkBranch26Encoding
    NativeLinkJump26(address, slot) -> NativeLinkBranch26Encoding
    NativeLinkDirectBranch26(address, target) -> NativeLinkBranch26Encoding
    NativeLinkDirectJump26(address, target) -> NativeLinkBranch26Encoding
    NativeLinkArchivePage21(address, target, addend) -> NativeLinkPage21Encoding
    NativeLinkArchivePageOff12(address, target, addend) -> NativeLinkPageOff12Encoding
    NativeLinkArchiveGotPage21(address, target) -> NativeLinkGotPage21Encoding
    NativeLinkArchiveGotPageOff12(address, target) -> NativeLinkGotPageOff12Encoding
    NativeLinkArchiveDataAbsolute64(address, target, addend) -> NativeLinkAbsolute64Encoding
    NativeLinkPageAddress(address, target) -> NativeLinkPageAddressEncoding
  }
}

pub(package) fn native_link_relocation_address(relocation: NativeLinkRelocation) -> i64 {
  match relocation {
    NativeLinkBranch26(address, slot) -> address
    NativeLinkJump26(address, slot) -> address
    NativeLinkDirectBranch26(address, target) -> address
    NativeLinkDirectJump26(address, target) -> address
    NativeLinkArchivePage21(address, target, addend) -> address
    NativeLinkArchivePageOff12(address, target, addend) -> address
    NativeLinkArchiveGotPage21(address, target) -> address
    NativeLinkArchiveGotPageOff12(address, target) -> address
    NativeLinkArchiveDataAbsolute64(address, target, addend) -> address
    NativeLinkPageAddress(address, target) -> address
  }
}

pub(package) fn native_link_validate_relocations(code: i64, archive_data: i64, relocations: List<NativeLinkRelocation>, layout: NativeLinkImageLayout, symbol_count: i64) -> List<NativeLinkError> {
  let mut errors = list_nil<NativeLinkError>()
  match layout {
    NativeLinkImageLayout(stub_base, code_size, text_size, static_offset, static_size, archive_offset, archive_size, archive_align, data_size) -> {
      let mut current = relocations
      let mut done = false
      while done == false {
        match current {
          Nil -> { done = true 0 }
          Cons(relocation, rest) -> {
            let encoding = native_link_relocation_encoding(relocation)
            let address = native_link_relocation_address(relocation)
            let site_size = match relocation {
              NativeLinkPageAddress(site, target) -> 8
              NativeLinkArchiveDataAbsolute64(site, target, addend) -> 8
              _ -> 4
            }
            let site_limit = match relocation {
              NativeLinkArchiveDataAbsolute64(site, target, addend) -> buf_len(archive_data)
              _ -> buf_len(code)
            }
            if address < 0 or address + site_size > site_limit {
              errors = list_append<NativeLinkError>(errors, NativeLinkRelocationSiteOutOfRange(encoding, address))
            } else {
              match relocation {
                NativeLinkBranch26(site, slot) -> {
                  let target = stub_base + slot * 12
                  if slot < 0 or slot >= symbol_count or native_link_branch_delta_valid(target - site) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkJump26(site, slot) -> {
                  let target = stub_base + slot * 12
                  if slot < 0 or slot >= symbol_count or native_link_branch_delta_valid(target - site) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkDirectBranch26(site, target) -> {
                  if target < 0 or target >= buf_len(code) or native_link_branch_delta_valid(target - site) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkDirectJump26(site, target) -> {
                  if target < 0 or target >= buf_len(code) or native_link_branch_delta_valid(target - site) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkArchivePage21(site, target_fact, addend) -> {
                  let target = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> 16384 + code_offset + addend
                    NativeLinkArchiveDataAddress(data_offset) -> text_size + archive_offset + data_offset + addend
                  }
                  let target_valid = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> code_offset + addend >= 0 and code_offset + addend <= buf_len(code)
                    NativeLinkArchiveDataAddress(data_offset) -> data_offset + addend >= 0 and data_offset + addend <= archive_size
                  }
                  let source = 16384 + site
                  if target_valid == false or native_link_page_delta_valid(target / 4096 - source / 4096) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkArchivePageOff12(site, target_fact, addend) -> {
                  let target = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> 16384 + code_offset + addend
                    NativeLinkArchiveDataAddress(data_offset) -> text_size + archive_offset + data_offset + addend
                  }
                  let target_valid = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> code_offset + addend >= 0 and code_offset + addend <= buf_len(code)
                    NativeLinkArchiveDataAddress(data_offset) -> data_offset + addend >= 0 and data_offset + addend <= archive_size
                  }
                  let page_offset = target - target / 4096 * 4096
                  let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), site, 0)
                  if target_valid == false {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else {
                    if native_link_pageoff12_is_valid(word, page_offset) == 0 {
                      errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetMisaligned(encoding, site, target))
                    } else { 0 }
                  }
                }
                NativeLinkArchiveGotPage21(site, target_fact) -> {
                  let target = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> 16384 + code_offset
                    NativeLinkArchiveDataAddress(data_offset) -> text_size + archive_offset + data_offset
                  }
                  let target_valid = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> code_offset >= 0 and code_offset <= buf_len(code)
                    NativeLinkArchiveDataAddress(data_offset) -> data_offset >= 0 and data_offset <= archive_size
                  }
                  let source = 16384 + site
                  if target_valid == false or native_link_page_delta_valid(target / 4096 - source / 4096) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkArchiveGotPageOff12(site, target_fact) -> {
                  let target = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> 16384 + code_offset
                    NativeLinkArchiveDataAddress(data_offset) -> text_size + archive_offset + data_offset
                  }
                  let target_valid = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> code_offset >= 0 and code_offset <= buf_len(code)
                    NativeLinkArchiveDataAddress(data_offset) -> data_offset >= 0 and data_offset <= archive_size
                  }
                  let page_offset = target - target / 4096 * 4096
                  if target_valid == false or page_offset < 0 or page_offset >= 4096 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkArchiveDataAbsolute64(site, target_fact, addend) -> {
                  let target = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> 16384 + code_offset + addend
                    NativeLinkArchiveDataAddress(data_offset) -> text_size + archive_offset + data_offset + addend
                  }
                  let target_valid = match target_fact {
                    NativeLinkArchiveCodeAddress(code_offset) -> code_offset + addend >= 0 and code_offset + addend <= buf_len(code)
                    NativeLinkArchiveDataAddress(data_offset) -> data_offset + addend >= 0 and data_offset + addend <= archive_size
                  }
                  if target_valid == false {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
                NativeLinkPageAddress(site, target_fact) -> {
                  let target = match target_fact {
                    NativeLinkCodeAddress(code_offset) -> 16384 + code_offset
                    NativeLinkStaticAddress(slot_offset) -> text_size + static_offset + slot_offset
                  }
                  let target_valid = match target_fact {
                    NativeLinkCodeAddress(code_offset) -> code_offset >= 0 and code_offset < buf_len(code)
                    NativeLinkStaticAddress(slot_offset) -> slot_offset >= 0 and slot_offset < static_size
                  }
                  let source = 16384 + site
                  if target_valid == false or native_link_page_delta_valid(target / 4096 - source / 4096) == 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(encoding, site, target))
                  } else { 0 }
                }
              }
            }
            current = rest
            0
          }
        }
      }
      let mut slot = 0
      while slot < symbol_count {
        let stub = stub_base + slot * 12
        let got = text_size + slot * 8
        if stub + 12 > code_size or native_link_page_delta_valid(got / 4096 - (16384 + stub) / 4096) == 0 {
          errors = list_append<NativeLinkError>(errors, NativeLinkRelocationTargetOutOfRange(NativeLinkGotPage21Encoding, stub, got))
        } else { 0 }
        slot = slot + 1
      }
      0
    }
  }
  errors
}

pub(package) fn native_link_library_ordinal(libraries: List<NativeLinkLibrary>, wanted: i64) -> i64 {
  let mut current = libraries
  let mut index = 0
  let mut next_dynamic_ordinal = 2
  let mut found = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        if index == wanted {
          found = match library {
            NativeLinkSystemLibrary(name, load_path) -> 1
            NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> next_dynamic_ordinal
            NativeLinkStaticArchive(name, path, content, license, bytes, len) -> 0
          }
          done = true
          0
        } else {
          match library {
            NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> { next_dynamic_ordinal = next_dynamic_ordinal + 1 0 }
            _ -> 0
          }
          current = rest
          index = index + 1
          0
        }
      }
    }
  }
  found
}

pub(package) fn native_link_byte_view_symbol_name(view: NativeLinkByteView) -> str {
  let ptr = native_link_byte_view_ptr(view)
  let len = native_link_byte_view_len(view)
  let prefix = if len > 0 and bytes_u8_at(ptr, len, 0, 0) == 95 { 1 } else { 0 }
  pkg_str_view(ptr + prefix, len - prefix)
}

pub(package) fn native_link_symbol_slot(symbols: List<NativeLinkSymbol>, name: str, ordinal: i64, index: i64) -> i64 {
  match symbols {
    Nil -> 0 - 1
    Cons(symbol, rest) -> match symbol {
      NativeLinkUndefinedStrong(candidate, candidate_ordinal, origin) -> {
        if candidate_ordinal == ordinal and str_eq(candidate, name) == 1 { index }
        else { native_link_symbol_slot(rest, name, ordinal, index + 1) }
      }
    }
  }
}

fn native_link_linux_libc_identity(libraries: List<NativeLinkLibrary>) -> str {
  match libraries {
    Nil -> ""
    Cons(library, rest) -> match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
        if str_eq(load_identity, "libc.so.6") == 1 { load_identity }
        else { native_link_linux_libc_identity(rest) }
      }
      _ -> native_link_linux_libc_identity(rest)
    }
  }
}

pub(package) fn native_link_target_platform_abi(target: NativeLinkTarget, libraries: List<NativeLinkLibrary>) -> NativeArtifactPlatformAbi {
  match target {
    NativeLinkMacosAarch64 -> NativeArtifactMacosPlatformAbi(11, 0, 0)
    -- AArch64 entered the upstream Linux UAPI in 3.7. This kernel-only leaf
    -- uses only baseline arm64 mmap/exit_group syscalls. Later capability
    -- facts must raise this floor or provide an older-kernel fallback when
    -- they consume a newer syscall; target identity alone never guesses it.
    NativeLinkLinuxAarch64 -> {
      if native_link_has_dynamic_library(libraries) == 1 {
        let libc = native_link_linux_libc_identity(libraries)
        NativeArtifactLinuxDynamicAbi(
          3,
          7,
          0,
          if __str_len(libc) > 0 { libc } else { "none" },
          native_link_linux_aarch64_interpreter()
        )
      } else { NativeArtifactLinuxKernelAbi(3, 7, 0) }
    }
  }
}

pub(package) fn native_link_debug_artifact_information(debug_information: NativeLinkDebugInformation) -> NativeArtifactDebugInformation {
  match debug_information {
    NativeLinkDebugInformationAbsent -> NativeArtifactDebugInformationAbsent
    NativeLinkDwarfFunctionLineInformation(functions) -> {
      if list_len<NativeLinkDebugFunction>(functions) == 0 { NativeArtifactDebugInformationAbsent }
      else { NativeArtifactDwarfInformation("dwarf-v4-function-file-line") }
    }
  }
}

pub(package) fn native_link_debug_functions(debug_information: NativeLinkDebugInformation) -> List<NativeLinkDebugFunction> {
  match debug_information {
    NativeLinkDebugInformationAbsent -> list_nil<NativeLinkDebugFunction>()
    NativeLinkDwarfFunctionLineInformation(functions) -> functions
  }
}

pub(package) fn native_link_target_signing(target: NativeLinkTarget) -> NativeArtifactSigning {
  match target {
    NativeLinkMacosAarch64 -> NativeArtifactAdHocSigning("weft", "sha256")
    NativeLinkLinuxAarch64 -> NativeArtifactUnsigned
  }
}

pub(package) fn native_link_resolve(plan: NativeLinkPlan) -> NativeLinkOutcome {
  let libraries = native_link_plan_libraries(plan)
  let imports = native_link_plan_imports(plan)
  let plan_relocations = native_link_plan_relocations(plan)
  let target = native_link_plan_target(plan)
  let target_errors = native_link_validate_target_libraries(target, libraries)
  match target {
    NativeLinkMacosAarch64 -> 0
    NativeLinkLinuxAarch64 -> {
      if list_len<NativeLinkError>(target_errors) != 0 {
        return NativeLinkRejected(target_errors)
      } else { 0 }
    }
  }
  let mut errors = target_errors
  let catalogs = native_link_archive_catalogs(libraries, target)
  let selected = native_link_select_archive_closure(plan, catalogs)
  errors = native_link_append_selected_definition_errors(errors, selected)
  let layout = native_link_layout_archive_members(native_link_plan_code(plan), catalogs, selected)
  let merged_code = match layout { NativeLinkArchiveLayout(code, data, align, placements, commons) -> code }
  let merged_data = match layout { NativeLinkArchiveLayout(code, data, align, placements, commons) -> data }
  let archive_align = match layout { NativeLinkArchiveLayout(code, data, align, placements, commons) -> align }
  let placements = match layout { NativeLinkArchiveLayout(code, data, align, entries, commons) -> entries }
  let commons = match layout { NativeLinkArchiveLayout(code, data, align, placements, entries) -> entries }
  let import_count = list_len<NativeLinkImport>(imports)
  let mut slots = list_nil<NativeLinkResolvedSlot>()
  let mut symbols = list_nil<NativeLinkSymbol>()
  let mut relocations = list_nil<NativeLinkRelocation>()
  let mut symbol_count = 0
  let mut current = plan_relocations
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkPlanBranch26(address, import_index) -> {
            if import_index < 0 or import_index >= import_count {
              errors = list_append<NativeLinkError>(errors, NativeLinkInvalidImportIndex(import_index))
              0
            } else {
              let stored = native_link_resolved_slot(slots, import_index)
              let slot = if stored >= 0 { stored }
              else {
                match native_link_import_at(imports, import_index) {
                  NativeLinkImport(name, library_index, origin) -> {
                    match native_link_library_at(libraries, library_index) {
                      Some(NativeLinkStaticArchive(archive_name, path, content, license, bytes, len)) -> {
                        let target = native_link_placed_address_for_name(placements, name)
                        if target < 0 {
                          errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(name))
                          0
                        } else {
                          relocations = list_cons<NativeLinkRelocation>(NativeLinkDirectBranch26(address, target), relocations)
                          0
                        }
                        0 - 1
                      }
                      Some(library) -> {
                        let ordinal = native_link_library_ordinal(libraries, library_index)
                        if ordinal == 0 {
                          errors = list_append<NativeLinkError>(errors, NativeLinkInvalidLibraryIndex(library_index))
                          0
                        } else {
                          symbols = list_append<NativeLinkSymbol>(symbols, NativeLinkUndefinedStrong(name, ordinal, origin))
                          slots = list_cons<NativeLinkResolvedSlot>(NativeLinkResolvedSlot(import_index, symbol_count), slots)
                          symbol_count = symbol_count + 1
                          0
                        }
                        symbol_count - 1
                      }
                      None -> {
                        errors = list_append<NativeLinkError>(errors, NativeLinkInvalidLibraryIndex(library_index))
                        0 - 1
                      }
                    }
                  }
                  NativeLinkInvalidImport -> {
                    errors = list_append<NativeLinkError>(errors, NativeLinkInvalidImportIndex(import_index))
                    0
                  }
                }
              }
              if slot >= 0 { relocations = list_cons<NativeLinkRelocation>(NativeLinkBranch26(address, slot), relocations) } else { 0 }
              0
            }
          }
          NativeLinkPlanPageAddress(address, target) -> {
            relocations = list_cons<NativeLinkRelocation>(NativeLinkPageAddress(address, target), relocations)
            0
          }
        }
        current = rest
        0
      }
    }
  }
  let mut current_placement = placements
  let mut placements_done = false
  while placements_done == false {
    match current_placement {
      Nil -> { placements_done = true 0 }
      Cons(entry, rest_placements) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, sections) -> {
          let object = native_link_archive_member_object(member)
          let mut relocation_index = 0
          while relocation_index < native_link_object_text_relocation_count(object) {
            match native_link_object_relocation(object, relocation_index) {
              NativeLinkObjectCall26(relocation_address, symbol_index, addend) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                let target = native_link_placed_code_address_for_symbol(placements, object, symbol_index)
                if target >= 0 {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkDirectBranch26(code_offset + relocation_address, target + addend), relocations)
                  0
                } else {
                  let name = native_link_object_symbol_name_for_view(object, wanted)
                  if addend != 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedArchiveRelocation(name, 2))
                  } else {
                    let stored_slot = native_link_symbol_slot(symbols, name, 1, 0)
                    let slot = if stored_slot >= 0 { stored_slot }
                    else {
                      symbols = list_append<NativeLinkSymbol>(symbols, NativeLinkUndefinedStrong(name, 1, NativeLinkRuntimeImport))
                      symbol_count = symbol_count + 1
                      symbol_count - 1
                    }
                    relocations = list_cons<NativeLinkRelocation>(NativeLinkBranch26(code_offset + relocation_address, slot), relocations)
                  }
                  0
                }
              }
              NativeLinkObjectJump26(relocation_address, symbol_index, addend) -> {
                let wanted = native_link_object_symbol_view(object, symbol_index)
                let target = native_link_placed_code_address_for_symbol(placements, object, symbol_index)
                if target >= 0 {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkDirectJump26(code_offset + relocation_address, target + addend), relocations)
                  0
                } else {
                  let name = native_link_object_symbol_name_for_view(object, wanted)
                  if addend != 0 {
                    errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedArchiveRelocation(name, 2))
                  } else {
                    let stored_slot = native_link_symbol_slot(symbols, name, 1, 0)
                    let slot = if stored_slot >= 0 { stored_slot }
                    else {
                      symbols = list_append<NativeLinkSymbol>(symbols, NativeLinkUndefinedStrong(name, 1, NativeLinkRuntimeImport))
                      symbol_count = symbol_count + 1
                      symbol_count - 1
                    }
                    relocations = list_cons<NativeLinkRelocation>(NativeLinkJump26(code_offset + relocation_address, slot), relocations)
                  }
                  0
                }
              }
              NativeLinkObjectPage21(relocation_address, symbol_index, addend) -> {
                match native_link_placed_archive_address_for_symbol(placements, commons, object, symbol_index) {
                  None -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                  0
                  }
                  Some(target) -> {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchivePage21(code_offset + relocation_address, target, addend), relocations)
                  0
                  }
                }
              }
              NativeLinkObjectPageOff12(relocation_address, symbol_index, addend) -> {
                match native_link_placed_archive_address_for_symbol(placements, commons, object, symbol_index) {
                  None -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                  0
                  }
                  Some(target) -> {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchivePageOff12(code_offset + relocation_address, target, addend), relocations)
                  0
                  }
                }
              }
              NativeLinkObjectGotPage21(relocation_address, symbol_index) -> {
                match native_link_placed_archive_address_for_symbol(placements, commons, object, symbol_index) {
                  None -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                  0
                  }
                  Some(target) -> {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchiveGotPage21(code_offset + relocation_address, target), relocations)
                  0
                  }
                }
              }
              NativeLinkObjectGotPageOff12(relocation_address, symbol_index) -> {
                match native_link_placed_archive_address_for_symbol(placements, commons, object, symbol_index) {
                  None -> {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                  0
                  }
                  Some(target) -> {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchiveGotPageOff12(code_offset + relocation_address, target), relocations)
                  0
                  }
                }
              }
              NativeLinkObjectPairedAddend(address) -> 0
              NativeLinkObjectRelocationUnsupported(wanted, kind) -> {
                errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedArchiveRelocation(native_link_object_symbol_name_for_view(object, wanted), kind))
                0
              }
            }
            relocation_index = relocation_index + 1
          }
          let mut data_relocation_index = 0
          while data_relocation_index < native_link_object_data_relocation_count(object) {
            match native_link_object_data_relocation(object, data_relocation_index) {
              NativeLinkObjectDataAbsolute64(section, relocation_address, symbol_index, addend) -> {
                let site = native_link_placed_data_relocation_site(placements, object, section, relocation_address)
                let code_target = native_link_placed_code_address_for_symbol(placements, object, symbol_index)
                if code_target >= 0 {
                  relocations = list_cons<NativeLinkRelocation>(
                    NativeLinkArchiveDataAbsolute64(site, NativeLinkArchiveCodeAddress(code_target), addend),
                    relocations
                  )
                } else {
                  let data_target = native_link_placed_data_address_for_symbol(placements, commons, object, symbol_index)
                  if data_target >= 0 {
                    relocations = list_cons<NativeLinkRelocation>(
                      NativeLinkArchiveDataAbsolute64(site, NativeLinkArchiveDataAddress(data_target), addend),
                      relocations
                    )
                  } else {
                    let wanted = native_link_object_symbol_view(object, symbol_index)
                    errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_object_symbol_name_for_view(object, wanted)))
                  }
                }
              }
              NativeLinkObjectDataRelocationUnsupported(wanted, kind) -> {
                errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedArchiveRelocation(native_link_object_symbol_name_for_view(object, wanted), kind))
              }
            }
            data_relocation_index = data_relocation_index + 1
          }
          current_placement = rest_placements
          0
        }
      }
    }
  }
  let resolved_relocations = list_reverse<NativeLinkRelocation>(relocations)
  let image_layout = native_link_image_layout(merged_code, merged_data, archive_align, symbol_count, native_link_plan_static_slots(plan))
  errors = list_concat<NativeLinkError>(errors, native_link_validate_relocations(merged_code, merged_data, resolved_relocations, image_layout, symbol_count))
  if list_len<NativeLinkError>(errors) != 0 {
    NativeLinkRejected(errors)
  } else {
    let graph = NativeLinkGraph(
      native_link_plan_target(plan),
      native_link_target_platform_abi(native_link_plan_target(plan), libraries),
      native_link_plan_debug_information(plan),
      native_link_target_signing(native_link_plan_target(plan)),
      native_link_plan_trust_grants(plan),
      merged_code,
      merged_data,
      image_layout,
      libraries,
      placements,
      symbols,
      resolved_relocations,
      native_link_plan_static_slots(plan)
    )
    let facts = native_link_artifact_facts(graph)
    NativeLinkSucceeded(graph, facts)
  }
}

pub(package) fn native_link_graph_symbol_count(graph: NativeLinkGraph) -> i64 {
  match graph { NativeLinkGraph(target, platform, debug_information, signing, trust_grants, code, data, layout, libraries, placements, symbols, relocations, static_slots) -> list_len<NativeLinkSymbol>(symbols) }
}

pub(package) fn native_link_graph_relocation_count(graph: NativeLinkGraph) -> i64 {
  match graph { NativeLinkGraph(target, platform, debug_information, signing, trust_grants, code, data, layout, libraries, placements, symbols, relocations, static_slots) -> list_len<NativeLinkRelocation>(relocations) }
}

pub(package) fn native_link_graph_target(graph: NativeLinkGraph) -> NativeLinkTarget {
  match graph { NativeLinkGraph(target, platform, debug_information, signing, trust_grants, code, data, layout, libraries, placements, symbols, relocations, static_slots) -> target }
}

pub(package) fn native_link_error_count(outcome: NativeLinkOutcome) -> i64 {
  match outcome {
    NativeLinkSucceeded(graph, facts) -> 0
    NativeLinkRejected(errors) -> list_len<NativeLinkError>(errors)
  }
}

pub(package) fn native_link_dylibs(libraries: List<NativeLinkLibrary>) -> List<str> {
  let mut dylibs = list_cons<str>("/usr/lib/libSystem.B.dylib", list_nil<str>())
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> { dylibs = list_append<str>(dylibs, load_identity) 0 }
          _ -> 0
        }
        current = rest
        0
      }
    }
  }
  dylibs
}

pub(package) fn native_link_has_dynamic_library(libraries: List<NativeLinkLibrary>) -> i64 {
  match libraries {
    Nil -> 0
    Cons(library, rest) -> match library {
      NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> 1
      _ -> native_link_has_dynamic_library(rest)
    }
  }
}

pub(package) fn native_link_linux_aarch64_interpreter() -> str {
  "/lib/ld-linux-aarch64.so.1"
}

pub(package) fn native_link_artifact_dependencies(target: NativeLinkTarget, libraries: List<NativeLinkLibrary>) -> List<NativeArtifactDependency> {
  let mut dependencies = match target {
    NativeLinkMacosAarch64 -> list_cons<NativeArtifactDependency>(
      NativeArtifactSystemDependency("/usr/lib/libSystem.B.dylib"),
      list_nil<NativeArtifactDependency>()
    )
    NativeLinkLinuxAarch64 -> {
      if native_link_has_dynamic_library(libraries) == 1 {
        list_cons<NativeArtifactDependency>(
          NativeArtifactSystemDependency(native_link_linux_aarch64_interpreter()),
          list_nil<NativeArtifactDependency>()
        )
      } else { list_nil<NativeArtifactDependency>() }
    }
  }
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> {
            dependencies = list_append<NativeArtifactDependency>(dependencies, NativeArtifactDynamicDependency(load_identity))
            0
          }
          _ -> 0
        }
        current = rest
        0
      }
    }
  }
  dependencies
}

pub(package) fn native_link_artifact_is_standalone(facts: NativeArtifactFacts) -> bool {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> standalone }
}

pub(package) fn native_link_artifact_platform_abi(facts: NativeArtifactFacts) -> NativeArtifactPlatformAbi {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> platform }
}

pub(package) fn native_link_artifact_trust_grants(facts: NativeArtifactFacts) -> List<NativeArtifactTrustGrant> {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> trust_grants }
}

pub(package) fn native_link_artifact_debug_information(facts: NativeArtifactFacts) -> NativeArtifactDebugInformation {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> debug_information }
}

pub(package) fn native_link_artifact_signing(facts: NativeArtifactFacts) -> NativeArtifactSigning {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> signing }
}

pub(package) fn native_link_artifact_content_hash(bytes: i64, len: i64) -> str {
  let digest = buf_new(32)
  bpad(digest, 32)
  sha256(bytes, len, buf_ptr(digest))
  pkg_lock_digest_hex(buf_ptr(digest))
}

pub(package) fn native_link_archive_member_name(member: NativeLinkArchiveMember) -> str {
  match member {
    NativeLinkArchiveMember(ordinal, name, object) -> pkg_str_view(native_link_byte_view_ptr(name), native_link_byte_view_len(name))
  }
}

pub(package) fn native_link_artifact_symbol_facts(object: NativeLinkObject) -> List<NativeArtifactSymbolFact> {
  let mut facts = list_nil<NativeArtifactSymbolFact>()
  let mut symbol_index = 0
  while symbol_index < native_link_object_symbol_count(object) {
    let name = native_link_object_symbol_name(object, symbol_index)
    if __str_len(name) > 0 {
      match native_link_object_symbol_definition(object, symbol_index) {
        NativeLinkStrongObjectDefinition(index) -> {
          facts = list_append<NativeArtifactSymbolFact>(facts, NativeArtifactStrongSymbol(name))
          0
        }
        NativeLinkWeakObjectDefinition(index) -> {
          facts = list_append<NativeArtifactSymbolFact>(facts, NativeArtifactWeakSymbol(name))
          0
        }
        NativeLinkCommonObjectDefinition(index, size, align) -> {
          facts = list_append<NativeArtifactSymbolFact>(facts, NativeArtifactCommonSymbol(name, size, native_link_pow2(align)))
          0
        }
        NativeLinkNoObjectDefinition -> 0
      }
    } else { 0 }
    symbol_index = symbol_index + 1
  }
  facts
}

pub(package) fn native_link_artifact_member_fact(member: NativeLinkArchiveMember) -> NativeArtifactMemberFact {
  let object = native_link_archive_member_object(member)
  NativeArtifactMemberFact(
    native_link_archive_member_ordinal(member),
    native_link_archive_member_name(member),
    native_link_artifact_content_hash(native_link_object_bytes(object), native_link_object_len(object)),
    native_link_artifact_symbol_facts(object)
  )
}

pub(package) fn native_link_artifact_member_facts(placements: List<NativeLinkPlacedMember>, library_index: i64) -> List<NativeArtifactMemberFact> {
  let mut facts = list_nil<NativeArtifactMemberFact>()
  let mut current = placements
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(placement, rest) -> match placement {
        NativeLinkPlacedMember(candidate_library, ordinal, member, code_offset, sections) -> {
          if candidate_library == library_index {
            facts = list_append<NativeArtifactMemberFact>(facts, native_link_artifact_member_fact(member))
          } else { 0 }
          current = rest
          0
        }
      }
    }
  }
  facts
}

pub(package) fn native_link_artifact_static_input_facts(libraries: List<NativeLinkLibrary>, placements: List<NativeLinkPlacedMember>) -> List<NativeArtifactStaticInput> {
  let mut facts = list_nil<NativeArtifactStaticInput>()
  let mut current = libraries
  let mut library_index = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkStaticArchive(name, path, content, license, bytes, len) -> {
            facts = list_append<NativeArtifactStaticInput>(
              facts,
              NativeArtifactStaticInput(name, path, content, license, native_link_artifact_member_facts(placements, library_index))
            )
            0
          }
          _ -> 0
        }
        current = rest
        library_index = library_index + 1
        0
      }
    }
  }
  facts
}

pub(package) fn native_link_artifact_static_inputs(facts: NativeArtifactFacts) -> List<NativeArtifactStaticInput> {
  match facts { NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> static_inputs }
}

pub(package) fn native_link_artifact_facts(graph: NativeLinkGraph) -> NativeArtifactFacts {
  match graph {
    NativeLinkGraph(target, platform, debug_information, signing, trust_grants, code, data, layout, libraries, placements, symbols, relocations, static_slots) -> {
      let mut standalone = true
      let mut current = libraries
      let mut done = false
      while done == false {
        match current {
          Nil -> { done = true 0 }
          Cons(library, rest) -> {
            match library {
              NativeLinkDynamicLibrary(name, path, load_identity, content, license, loads) -> { standalone = false 0 }
              _ -> 0
            }
            current = rest
            0
          }
        }
      }
      NativeArtifactFacts(
        target,
        platform,
        standalone,
        native_link_artifact_dependencies(target, libraries),
        native_link_artifact_static_input_facts(libraries, placements),
        trust_grants,
        native_link_debug_artifact_information(debug_information),
        signing,
        symbols
      )
    }
  }
}

pub(package) fn native_link_artifact_dependency_json(dependency: NativeArtifactDependency) -> Json {
  match dependency {
    NativeArtifactSystemDependency(identity) -> list_cons<JsonEntry>(
      json_entry("kind", json_string("system")),
      list_cons<JsonEntry>(json_entry("identity", json_string(identity)), list_nil<JsonEntry>())
    ) |> json_object
    NativeArtifactDynamicDependency(identity) -> list_cons<JsonEntry>(
      json_entry("kind", json_string("dynamic")),
      list_cons<JsonEntry>(json_entry("identity", json_string(identity)), list_nil<JsonEntry>())
    ) |> json_object
  }
}

pub(package) fn native_link_artifact_dependencies_json(dependencies: List<NativeArtifactDependency>) -> Json {
  let mut items = list_nil<Json>()
  let mut current = dependencies
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(dependency, rest) -> {
        items = list_append<Json>(items, native_link_artifact_dependency_json(dependency))
        current = rest
        0
      }
    }
  }
  json_array(items)
}

pub(package) fn native_link_artifact_symbol_fact_json(fact: NativeArtifactSymbolFact) -> Json {
  match fact {
    NativeArtifactStrongSymbol(name) -> list_cons<JsonEntry>(
      json_entry("name", json_string(name)),
      list_cons<JsonEntry>(json_entry("definition", json_string("strong")), list_nil<JsonEntry>())
    ) |> json_object
    NativeArtifactWeakSymbol(name) -> list_cons<JsonEntry>(
      json_entry("name", json_string(name)),
      list_cons<JsonEntry>(json_entry("definition", json_string("weak")), list_nil<JsonEntry>())
    ) |> json_object
    NativeArtifactCommonSymbol(name, size, alignment) -> list_cons<JsonEntry>(
      json_entry("name", json_string(name)),
      list_cons<JsonEntry>(json_entry("definition", json_string("common")),
      list_cons<JsonEntry>(json_entry("size", json_number(size)),
      list_cons<JsonEntry>(json_entry("alignment", json_number(alignment)), list_nil<JsonEntry>())))
    ) |> json_object
  }
}

pub(package) fn native_link_artifact_symbol_facts_json(facts: List<NativeArtifactSymbolFact>) -> Json {
  let mut items = list_nil<Json>()
  let mut current = facts
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(fact, rest) -> {
        items = list_append<Json>(items, native_link_artifact_symbol_fact_json(fact))
        current = rest
        0
      }
    }
  }
  json_array(items)
}

pub(package) fn native_link_artifact_member_fact_json(fact: NativeArtifactMemberFact) -> Json {
  match fact {
    NativeArtifactMemberFact(ordinal, name, content, symbols) -> list_cons<JsonEntry>(
      json_entry("ordinal", json_number(ordinal)),
      list_cons<JsonEntry>(json_entry("name", json_string(name)),
      list_cons<JsonEntry>(json_entry("content", json_string(content)),
      list_cons<JsonEntry>(json_entry("symbols", native_link_artifact_symbol_facts_json(symbols)), list_nil<JsonEntry>())))
    ) |> json_object
  }
}

pub(package) fn native_link_artifact_member_facts_json(facts: List<NativeArtifactMemberFact>) -> Json {
  let mut items = list_nil<Json>()
  let mut current = facts
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(fact, rest) -> {
        items = list_append<Json>(items, native_link_artifact_member_fact_json(fact))
        current = rest
        0
      }
    }
  }
  json_array(items)
}

pub(package) fn native_link_artifact_static_input_json(input: NativeArtifactStaticInput) -> Json {
  match input {
    NativeArtifactStaticInput(name, path, content, license, members) -> {
      let license_json = match license {
        NativeLibraryLicenseDeclared(value) -> json_string(value)
        NativeLibraryLicenseUnspecified -> json_null()
      }
      list_cons<JsonEntry>(json_entry("name", json_string(name)),
        list_cons<JsonEntry>(json_entry("path", json_string(path)),
        list_cons<JsonEntry>(json_entry("content", json_string(content)),
        list_cons<JsonEntry>(json_entry("license", license_json),
        list_cons<JsonEntry>(json_entry("members", native_link_artifact_member_facts_json(members)), list_nil<JsonEntry>()))))) |> json_object
    }
  }
}

