  NativeLinkDebugFunction(i64, i64, str, str, i64, i64, bool)
}

pub(package) type NativeLinkDebugInformation {
  NativeLinkDebugInformationAbsent,
  NativeLinkDwarfFunctionLineInformation(List<NativeLinkDebugFunction>)
}

