pub(package) fn native_link_plan_target(plan: NativeLinkPlan) -> NativeLinkTarget {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> target }
}

pub(package) fn native_link_plan_code(plan: NativeLinkPlan) -> i64 {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> code }
}

pub(package) fn native_link_plan_libraries(plan: NativeLinkPlan) -> List<NativeLinkLibrary> {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> libraries }
}

pub(package) fn native_link_plan_imports(plan: NativeLinkPlan) -> List<NativeLinkImport> {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> imports }
}

pub(package) fn native_link_plan_relocations(plan: NativeLinkPlan) -> List<NativeLinkPlanRelocation> {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> relocations }
}

pub(package) fn native_link_plan_static_slots(plan: NativeLinkPlan) -> i64 {
  match plan { NativeLinkPlan(target, code, libraries, imports, relocations, static_slots) -> static_slots }
}

pub(package) fn native_link_plan_library_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkLibrary>(native_link_plan_libraries(plan))
}

pub(package) fn native_link_plan_import_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkImport>(native_link_plan_imports(plan))
}

pub(package) fn native_link_plan_relocation_count(plan: NativeLinkPlan) -> i64 {
  list_len<NativeLinkPlanRelocation>(native_link_plan_relocations(plan))
}

pub(package) fn native_link_dynamic_load_from_command(command: i64, identity: NativeLinkByteView) -> NativeLinkDynamicLoad {
  match command {
    12 -> NativeLinkRequiredDynamicLoad(identity)
    2147483672 -> NativeLinkWeakDynamicLoad(identity)
    2147483679 -> NativeLinkReexportDynamicLoad(identity)
    2147483683 -> NativeLinkUpwardDynamicLoad(identity)
    _ -> NativeLinkLazyDynamicLoad(identity)
  }
}

-- Parse the install identity and exact dependency closure from an acquired
-- aarch64 Mach-O dylib. The selected path remains provenance: only LC_ID_DYLIB
-- and the typed LC_LOAD_* family become loader semantics.
pub(package) fn native_link_macho_dynamic_image(bytes: i64, len: i64) -> NativeLinkDynamicImageParse {
  if len < 32 or bytes_u32_le_at(bytes, len, 0, 0) != 4277009103 or
    bytes_u32_le_at(bytes, len, 4, 0) != 16777228 or bytes_u32_le_at(bytes, len, 12, 0) != 6 {
    NativeLinkDynamicImageMalformed
  } else {
    let command_count = bytes_u32_le_at(bytes, len, 16, 0)
    let command_bytes = bytes_u32_le_at(bytes, len, 20, 0)
    let command_end = 32 + command_bytes
    if command_end > len {
      NativeLinkDynamicImageMalformed
    } else {
      let mut cursor = 32
      let mut index = 0
      let mut malformed = false
      let mut identity_ptr = 0
      let mut identity_len = 0
      let mut loads = list_nil<NativeLinkDynamicLoad>()
      while index < command_count and malformed == false {
        let command = bytes_u32_le_at(bytes, command_end, cursor, 0 - 1)
        let command_size = bytes_u32_le_at(bytes, command_end, cursor + 4, 0)
        if command_size < 8 or command_size % 8 != 0 or cursor + command_size > command_end {
          malformed = true
        } else {
          if command == 13 or command == 12 or command == 2147483672 or
            command == 2147483679 or command == 2147483683 or command == 32 {
            let name_offset = bytes_u32_le_at(bytes, command_end, cursor + 8, 0)
            let name_start = cursor + name_offset
            let name_len = if name_offset < 24 or name_start >= cursor + command_size { 0 - 1 }
            else { bytes_cstr_len_bounded(bytes, cursor + command_size, name_start) }
            if name_len <= 0 { malformed = true }
            else { if command == 13 {
              if identity_len != 0 { malformed = true }
              else {
                identity_ptr = bytes + name_start
                identity_len = name_len
              }
            } else {
              let load_identity = NativeLinkByteView(bytes + name_start, name_len)
              loads = list_append<NativeLinkDynamicLoad>(loads, native_link_dynamic_load_from_command(command, load_identity))
            } }
          } else { 0 }
          cursor = cursor + command_size
          index = index + 1
        }
      }
      if malformed or cursor != command_end { NativeLinkDynamicImageMalformed }
      else { if identity_len == 0 { NativeLinkDynamicImageIdentityMissing }
      else { NativeLinkDynamicImageParsed(NativeLinkDynamicImage(NativeLinkByteView(identity_ptr, identity_len), loads)) } }
    }
  }
}

pub(package) fn native_link_dynamic_image_identity(image: NativeLinkDynamicImage) -> NativeLinkByteView {
  match image { NativeLinkDynamicImage(identity, loads) -> identity }
}

pub(package) fn native_link_dynamic_image_loads(image: NativeLinkDynamicImage) -> List<NativeLinkDynamicLoad> {
  match image { NativeLinkDynamicImage(identity, loads) -> loads }
}

pub(package) fn native_link_dynamic_load_view(load: NativeLinkDynamicLoad) -> NativeLinkByteView {
  match load {
    NativeLinkRequiredDynamicLoad(identity) -> identity
    NativeLinkWeakDynamicLoad(identity) -> identity
    NativeLinkReexportDynamicLoad(identity) -> identity
    NativeLinkUpwardDynamicLoad(identity) -> identity
    NativeLinkLazyDynamicLoad(identity) -> identity
  }
}

pub(package) fn native_link_dynamic_load_identity(load: NativeLinkDynamicLoad) -> str {
  let view = native_link_dynamic_load_view(load)
  pkg_str_view(native_link_byte_view_ptr(view), native_link_byte_view_len(view))
}

pub(package) fn native_link_byte_view_ptr(view: NativeLinkByteView) -> i64 {
  match view { NativeLinkByteView(ptr, len) -> ptr }
}

pub(package) fn native_link_byte_view_len(view: NativeLinkByteView) -> i64 {
  match view { NativeLinkByteView(ptr, len) -> len }
}

