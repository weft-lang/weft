}

pub(package) fn native_link_mach_object_symoff(object: NativeLinkMachObject) -> i64 {
  match object { NativeLinkMachObject(bytes, len, text_offset, text_addr, text_size, text_align, text_reloff, text_nreloc, text_section, symoff, nsyms, stroff, strsize, data) -> symoff }
}

pub(package) fn native_link_mach_object_nsyms(object: NativeLinkMachObject) -> i64 {
  match object { NativeLinkMachObject(bytes, len, text_offset, text_addr, text_size, text_align, text_reloff, text_nreloc, text_section, symoff, nsyms, stroff, strsize, data) -> nsyms }
}

pub(package) fn native_link_mach_object_stroff(object: NativeLinkMachObject) -> i64 {
  match object { NativeLinkMachObject(bytes, len, text_offset, text_addr, text_size, text_align, text_reloff, text_nreloc, text_section, symoff, nsyms, stroff, strsize, data) -> stroff }
}

