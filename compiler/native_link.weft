pub(package) fn native_link_mach_object_text_nreloc(object: NativeLinkMachObject) -> i64 {
  match object { NativeLinkMachObject(bytes, len, text_offset, text_addr, text_size, text_align, text_reloff, text_nreloc, text_section, symoff, nsyms, stroff, strsize, data) -> text_nreloc }
}

