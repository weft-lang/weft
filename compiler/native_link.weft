pub(package) fn native_link_artifact_facts_json(facts: NativeArtifactFacts) -> Json {
  match facts {
    NativeArtifactFacts(target, platform, standalone, dependencies, static_inputs, trust_grants, debug_information, signing, symbols) -> list_cons<JsonEntry>(
      json_entry("artifact_facts_version", json_number(weft_artifact_facts_schema_version())),
      list_cons<JsonEntry>(json_entry("target", json_string(native_link_target_name(target))),
      list_cons<JsonEntry>(json_entry("minimum_platform_abi", native_link_artifact_platform_abi_json(platform)),
      list_cons<JsonEntry>(json_entry("standalone", json_bool(if standalone { 1 } else { 0 })),
      list_cons<JsonEntry>(json_entry("dependencies", native_link_artifact_dependencies_json(dependencies)),
      list_cons<JsonEntry>(json_entry("static_inputs", native_link_artifact_static_inputs_json(static_inputs)),
      list_cons<JsonEntry>(json_entry("trust_grants", native_link_artifact_trust_grants_json(trust_grants)),
      list_cons<JsonEntry>(json_entry("debug_information", native_link_artifact_debug_information_json(debug_information)),
      list_cons<JsonEntry>(json_entry("signing", native_link_artifact_signing_json(signing)),
      list_cons<JsonEntry>(json_entry("dynamic_symbols", native_link_artifact_dynamic_symbols_json(symbols)), list_nil<JsonEntry>())))))))))) |> json_object
  }
}

pub(package) fn native_link_artifact_facts_render(facts: NativeArtifactFacts) -> str {
  str_concat(
    json_stringify(native_link_artifact_facts_json(facts)).expect("native artifact facts contain only finite JSON"),
    "\n"
  )
}

pub(package) fn native_link_align(n: i64, alignment: i64) -> i64 {
  (n + alignment - 1) / alignment * alignment
}

pub(package) fn native_link_emit_uleb(buffer: i64, value: i64) -> i64 {
  let mut remaining = value
  let mut done = false
  while done == false {
    let low = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 {
      bu8(buffer, low)
      done = true
    } else {
      bu8(buffer, low + 128)
    }
  }
  0
}

pub(package) fn native_link_emit_nlists(output: i64, code_base: i64, debug_information: NativeLinkDebugInformation, symbols: List<NativeLinkSymbol>) -> i64 {
  let mut string_offset = 1
  let mut current_function = native_link_debug_functions(debug_information)
  let mut functions_done = false
  while functions_done == false {
    match current_function {
      Nil -> { functions_done = true 0 }
      Cons(NativeLinkDebugFunction(start, end, name, file, line, col, framed), rest) -> {
        bu32(output, string_offset)
        bu8(output, 15)
        bu8(output, 1)
        bu8(output, 0)
        bu8(output, 0)
        bu64(output, code_base + start)
        string_offset = string_offset + 2 + __str_len(name)
        current_function = rest
        0
      }
    }
  }
  let mut current = symbols
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(symbol, rest) -> {
        match symbol {
          NativeLinkUndefinedStrong(name, ordinal, origin) -> {
            bu32(output, string_offset)
            bu8(output, 1)
            bu8(output, 0)
            bu8(output, 0)
            bu8(output, ordinal)
            bu64(output, 0)
            string_offset = string_offset + 2 + __str_len(name)
          }
        }
        current = rest
        0
      }
    }
  }
  0
}

pub(package) fn native_link_dylib_command_size(path: str) -> i64 {
  native_link_align(24 + __str_len(path) + 1, 8)
}

pub(package) fn native_link_dylib_commands_size(dylibs: List<str>) -> i64 {
  let mut size = 0
  let mut current = dylibs
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(path, rest) -> {
        size = size + native_link_dylib_command_size(path)
        current = rest
        0
      }
    }
  }
  size
}

pub(package) fn native_link_emit_dylib_commands(output: i64, dylibs: List<str>) -> i64 {
  let mut current = dylibs
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(path, rest) -> {
        let start = buf_len(output)
        let size = native_link_dylib_command_size(path)
        bu32(output, 12)
        bu32(output, size)
        bu32(output, 24)
        bu32(output, 0)
        bu32(output, 65536)
        bu32(output, 65536)
        bstr(output, path)
        bu8(output, 0)
        bpad(output, start + size)
        current = rest
        0
      }
    }
  }
  0
}

pub(package) fn native_link_emit_data_segment(output: i64, text_size: i64, data_size: i64, symbol_count: i64, static_offset: i64, static_size: i64, archive_offset: i64, archive_size: i64, archive_align: i64) -> i64 {
  let section_count = 1 + (if static_size > 0 { 1 } else { 0 }) + (if archive_size > 0 { 1 } else { 0 })
  let command_size = 72 + section_count * 80
  bu32(output, 25)
  bu32(output, command_size)
  bstr(output, "__DATA") bfill(output, 10)
  bu64(output, 4294967296 + text_size)
  bu64(output, data_size)
  bu64(output, text_size)
  bu64(output, data_size)
  bu32(output, 3) bu32(output, 3)
  bu32(output, section_count) bu32(output, 0)
  bstr(output, "__got") bfill(output, 11)
  bstr(output, "__DATA") bfill(output, 10)
  bu64(output, 4294967296 + text_size)
  bu64(output, symbol_count * 8)
  bu32(output, text_size)
  bu32(output, 3)
  bu32(output, 0) bu32(output, 0)
  bu32(output, 6)
  bu32(output, 0) bu32(output, 0) bu32(output, 0)
  if static_size > 0 {
    bstr(output, "__wstatic") bfill(output, 7)
    bstr(output, "__DATA") bfill(output, 10)
    bu64(output, 4294967296 + text_size + static_offset)
    bu64(output, static_size)
    bu32(output, text_size + static_offset)
    bu32(output, 4)
    bu32(output, 0) bu32(output, 0)
    bu32(output, 0)
    bu32(output, 0) bu32(output, 0) bu32(output, 0)
  } else { 0 }
  if archive_size > 0 {
    bstr(output, "__archive") bfill(output, 7)
    bstr(output, "__DATA") bfill(output, 10)
    bu64(output, 4294967296 + text_size + archive_offset)
    bu64(output, archive_size)
    bu32(output, text_size + archive_offset)
    bu32(output, archive_align)
    bu32(output, 0) bu32(output, 0)
    bu32(output, 0)
    bu32(output, 0) bu32(output, 0) bu32(output, 0)
  } else { 0 }
  0
}

pub(package) fn native_link_emit_stubs_at(code: i64, symbols: List<NativeLinkSymbol>, code_base: i64, data_base: i64, stub_base: i64, slot: i64) -> i64 {
  match symbols {
    Nil -> 0
    Cons(symbol, rest) -> {
      let stub = stub_base + slot * 12
      let got = data_base + slot * 8
      let page_delta = got / 4096 - (code_base + stub) / 4096
      bu32(code, encode_adrp(16, page_delta))
      bu32(code, encode_ldr(16, 16, got - got / 4096 * 4096))
      bu32(code, encode_br(16))
      native_link_emit_stubs_at(code, rest, code_base, data_base, stub_base, slot + 1)
    }
  }
}

pub(package) fn native_link_emit_stubs(code: i64, symbols: List<NativeLinkSymbol>, text_size: i64, stub_base: i64, slot: i64) -> i64 {
  native_link_emit_stubs_at(code, symbols, 16384, text_size, stub_base, slot)
}

pub(package) fn native_link_pageoff12_word(word: i64, page_offset: i64) -> i64 {
  let add_immediate = if word band 2130706432 == 285212672 { 1 } else { 0 }
  let vector_128 = if word band 1065353216 == 1031798784 { 1 } else { 0 }
  let scale = if add_immediate == 1 { 0 } else { if vector_128 == 1 { 4 } else { word bshr 30 band 3 } }
  let divisor = native_link_pow2(scale)
  (word band 4290774015) + page_offset / divisor * 1024
}

pub(package) fn native_link_relax_got_pageoff12_word(word: i64, page_offset: i64) -> i64 {
  encode_add_imm(word band 31, word bshr 5 band 31, page_offset)
}

-- Branches are image-base independent. Page relocations consume the actual
-- code and data placements chosen by the target container.
pub(package) fn native_link_apply_relocations_at(code: i64, archive_data: i64, relocations: List<NativeLinkRelocation>, code_base: i64, data_base: i64, stub_base: i64, static_offset: i64, archive_offset: i64) -> i64 {
  let mut current = relocations
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkBranch26(address, slot) -> {
            bytes_set_u32(code, address, encode_bl(stub_base + slot * 12 - address))
            0
          }
          NativeLinkJump26(address, slot) -> {
            bytes_set_u32(code, address, encode_b(stub_base + slot * 12 - address))
            0
          }
          NativeLinkDirectBranch26(address, target) -> {
            bytes_set_u32(code, address, encode_bl(target - address))
            0
          }
          NativeLinkDirectJump26(address, target) -> {
            bytes_set_u32(code, address, encode_b(target - address))
            0
          }
          NativeLinkArchivePage21(address, target, addend) -> {
            let target_offset = match target {
              NativeLinkArchiveCodeAddress(code_offset) -> code_base + code_offset + addend
              NativeLinkArchiveDataAddress(data_offset) -> data_base + archive_offset + data_offset + addend
            }
            let source_offset = code_base + address
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, encode_adrp(word band 31, target_offset / 4096 - source_offset / 4096))
            0
          }
          NativeLinkArchivePageOff12(address, target, addend) -> {
            let target_offset = match target {
              NativeLinkArchiveCodeAddress(code_offset) -> code_base + code_offset + addend
              NativeLinkArchiveDataAddress(data_offset) -> data_base + archive_offset + data_offset + addend
            }
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, native_link_pageoff12_word(word, target_offset - target_offset / 4096 * 4096))
            0
          }
          NativeLinkArchiveGotPage21(address, target) -> {
            let target_offset = match target {
              NativeLinkArchiveCodeAddress(code_offset) -> code_base + code_offset
              NativeLinkArchiveDataAddress(data_offset) -> data_base + archive_offset + data_offset
            }
            let source_offset = code_base + address
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, encode_adrp(word band 31, target_offset / 4096 - source_offset / 4096))
            0
          }
          NativeLinkArchiveGotPageOff12(address, target) -> {
            let target_offset = match target {
              NativeLinkArchiveCodeAddress(code_offset) -> code_base + code_offset
              NativeLinkArchiveDataAddress(data_offset) -> data_base + archive_offset + data_offset
            }
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, native_link_relax_got_pageoff12_word(word, target_offset - target_offset / 4096 * 4096))
            0
          }
          NativeLinkArchiveDataAbsolute64(address, target, addend) -> {
            let target_address = match target {
              NativeLinkArchiveCodeAddress(code_offset) -> code_base + code_offset + addend
              NativeLinkArchiveDataAddress(data_offset) -> data_base + archive_offset + data_offset + addend
            }
            bytes_set_u32(archive_data, address, target_address band 4294967295)
            bytes_set_u32(archive_data, address + 4, target_address bshr 32 band 4294967295)
            0
          }
          NativeLinkPageAddress(address, target) -> {
            let target_offset = match target {
              NativeLinkCodeAddress(code_offset) -> code_base + code_offset
              NativeLinkStaticAddress(slot_offset) -> data_base + static_offset + slot_offset
            }
            let source_offset = code_base + address
            bytes_set_u32(code, address, encode_adrp(17, target_offset / 4096 - source_offset / 4096))
            bytes_set_u32(code, address + 4, encode_add_imm(17, 17, target_offset - target_offset / 4096 * 4096))
            0
          }
        }
        current = rest
        0
      }
    }
  }
  0
}

pub(package) fn native_link_apply_relocations(code: i64, archive_data: i64, relocations: List<NativeLinkRelocation>, text_size: i64, stub_base: i64, static_offset: i64, archive_offset: i64) -> i64 {
  native_link_apply_relocations_at(code, archive_data, relocations, 16384, text_size, stub_base, static_offset, archive_offset)
}
