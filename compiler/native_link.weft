pub(package) fn native_link_mach_object_data(object: NativeLinkMachObject) -> NativeLinkMachDataSection {
  match object { NativeLinkMachObject(bytes, len, text_offset, text_addr, text_size, text_align, text_reloff, text_nreloc, text_section, symoff, nsyms, stroff, strsize, data) -> data }
}

pub(package) fn native_link_mach_data_addr(data: NativeLinkMachDataSection) -> i64 {
  match data {
    NativeLinkMachDataAbsent -> 0
    NativeLinkMachDataBytes(addr, size, offset, align, section) -> addr
    NativeLinkMachDataZeroFill(addr, size, align, section) -> addr
  }
}

pub(package) fn native_link_mach_data_section(data: NativeLinkMachDataSection) -> i64 {
  match data {
    NativeLinkMachDataAbsent -> 0
    NativeLinkMachDataBytes(addr, size, offset, align, section) -> section
    NativeLinkMachDataZeroFill(addr, size, align, section) -> section
  }
}

pub(package) fn native_link_pow2(exponent: i64) -> i64 {
  let mut value = 1
  let mut i = 0
  while i < exponent and i < 30 { value = value * 2 i = i + 1 }
  value
}

-- Parse the object facts the shared closure needs. Debug/unwind sections stay
-- in the object view for later preservation work; this slice admits only the
-- executable text section and its explicit relocation table.
pub(package) fn native_link_mach_object_parse(bytes: i64, len: i64) -> NativeLinkMachObjectParse {
  if len < 32 or bytes_u32_le_at(bytes, len, 0, 0) != 4277009103 or
    bytes_u32_le_at(bytes, len, 4, 0) != 16777228 or bytes_u32_le_at(bytes, len, 12, 0) != 1 {
    NativeLinkMachObjectMalformed
  } else {
    let command_count = bytes_u32_le_at(bytes, len, 16, 0)
    let command_end = 32 + bytes_u32_le_at(bytes, len, 20, 0)
    let mut cursor = 32
    let mut command_index = 0
    let mut malformed = command_end > len
    let mut text_offset = 0 - 1
    let mut text_addr = 0
    let mut text_size = 0
    let mut text_align = 0
    let mut text_reloff = 0
    let mut text_nreloc = 0
    let mut text_section = 0
    let mut symoff = 0 - 1
    let mut nsyms = 0
    let mut stroff = 0 - 1
    let mut strsize = 0
    let mut data = NativeLinkMachDataAbsent
    let mut data_found = false
    while command_index < command_count and malformed == false {
      let command = bytes_u32_le_at(bytes, command_end, cursor, 0 - 1)
      let command_size = bytes_u32_le_at(bytes, command_end, cursor + 4, 0)
      if command_size < 8 or cursor + command_size > command_end { malformed = true }
      else {
        if command == 25 {
          let section_count = bytes_u32_le_at(bytes, command_end, cursor + 64, 0)
          if command_size < 72 + section_count * 80 { malformed = true }
          else {
            let mut section_index = 0
            while section_index < section_count {
              let section = cursor + 72 + section_index * 80
              if bytes_match_str_at(bytes, len, section, "__text") == 1 and bytes_match_str_at(bytes, len, section + 16, "__TEXT") == 1 {
                text_addr = bytes_u64_le_at(bytes, len, section + 32, 0)
                text_size = bytes_u64_le_at(bytes, len, section + 40, 0 - 1)
                text_offset = bytes_u32_le_at(bytes, len, section + 48, 0 - 1)
                text_align = bytes_u32_le_at(bytes, len, section + 52, 0)
                text_reloff = bytes_u32_le_at(bytes, len, section + 56, 0)
                text_nreloc = bytes_u32_le_at(bytes, len, section + 60, 0)
                text_section = section_index + 1
              } else {
                if bytes_match_str_at(bytes, len, section + 16, "__DATA") == 1 and
                  (bytes_match_str_at(bytes, len, section, "__data") == 1 or bytes_match_str_at(bytes, len, section, "__bss") == 1) {
                  if data_found { malformed = true }
                  else {
                    let data_addr = bytes_u64_le_at(bytes, len, section + 32, 0)
                    let data_size = bytes_u64_le_at(bytes, len, section + 40, 0 - 1)
                    let data_offset = bytes_u32_le_at(bytes, len, section + 48, 0 - 1)
                    let data_align = bytes_u32_le_at(bytes, len, section + 52, 0)
                    let data_flags = bytes_u32_le_at(bytes, len, section + 64, 0)
                    data = if data_flags band 255 == 1 {
                      NativeLinkMachDataZeroFill(data_addr, data_size, data_align, section_index + 1)
                    } else {
                      NativeLinkMachDataBytes(data_addr, data_size, data_offset, data_align, section_index + 1)
                    }
                    data_found = true
                  }
                } else { 0 }
              }
              section_index = section_index + 1
            }
          }
        } else {
          if command == 2 {
            if command_size < 24 { malformed = true }
            else {
              symoff = bytes_u32_le_at(bytes, len, cursor + 8, 0 - 1)
              nsyms = bytes_u32_le_at(bytes, len, cursor + 12, 0)
              stroff = bytes_u32_le_at(bytes, len, cursor + 16, 0 - 1)
              strsize = bytes_u32_le_at(bytes, len, cursor + 20, 0)
            }
          } else { 0 }
        }
        cursor = cursor + command_size
        command_index = command_index + 1
      }
    }
    if malformed or text_offset < 0 or text_size < 0 or text_offset + text_size > len or
      text_align > 20 or text_reloff < 0 or text_reloff + text_nreloc * 8 > len or
      symoff < 0 or symoff + nsyms * 16 > len or stroff < 0 or stroff + strsize > len {
      NativeLinkMachObjectMalformed
    } else {
      let data_malformed = match data {
        NativeLinkMachDataAbsent -> false
        NativeLinkMachDataZeroFill(data_addr, data_size, data_align, data_section) -> data_size < 0 or data_align > 20
        NativeLinkMachDataBytes(data_addr, data_size, data_offset, data_align, data_section) -> data_size < 0 or data_align > 20 or data_offset < 0 or data_offset + data_size > len
      }
      if data_malformed { NativeLinkMachObjectMalformed }
      else { NativeLinkMachObjectParsed(NativeLinkMachObject(
        bytes, len, text_offset, text_addr, text_size, text_align, text_reloff,
        text_nreloc, text_section, symoff, nsyms, stroff, strsize, data
      )) }
    }
  }
}

pub(package) fn native_link_archive_parse(bytes: i64, len: i64) -> NativeLinkArchiveParse {
  if len < 8 or bytes_match_str_at(bytes, len, 0, "!<arch>\n") == 0 {
    NativeLinkArchiveMalformed
  } else {
    let mut members = list_nil<NativeLinkArchiveMember>()
    let mut cursor = 8
    let mut ordinal = 0
    let mut malformed = false
    while cursor < len and malformed == false {
      if cursor + 60 > len or bytes_match_str_at(bytes, len, cursor + 58, "`\n") == 0 {
        malformed = true
      } else {
        let stored_size = bytes_decimal_at(bytes, len, cursor + 48, 10)
        let data = cursor + 60
        let member_end = data + stored_size
        if stored_size < 0 or member_end > len { malformed = true }
        else {
          let extended = bytes_match_str_at(bytes, len, cursor, "#1/")
          let name_len = if extended == 1 { bytes_decimal_at(bytes, len, cursor + 3, 13) } else { 0 }
          let object = bytes + data + name_len
          let object_len = stored_size - name_len
          let metadata = if extended == 1 { bytes_match_str_at(bytes, len, data, "__.SYMDEF") }
          else { bytes_match_str_at(bytes, len, cursor, "/") }
          if name_len < 0 or object_len < 0 { malformed = true }
          else {
            match native_link_mach_object_parse(object, object_len) {
              NativeLinkMachObjectParsed(parsed) -> {
                let name = if extended == 1 { NativeLinkByteView(bytes + data, name_len) } else { NativeLinkByteView(bytes + cursor, 16) }
                members = list_append<NativeLinkArchiveMember>(members, NativeLinkArchiveMember(ordinal, name, parsed))
                ordinal = ordinal + 1
                0
              }
              -- Archive symbol indexes are the only admitted non-object
              -- members. A wrong-architecture or malformed object cannot hide
              -- beside one valid member.
              NativeLinkMachObjectMalformed -> if metadata == 1 { 0 } else { malformed = true 0 }
            }
            cursor = native_link_align(member_end, 2)
          }
        }
      }
    }
    if malformed or cursor != len or list_len<NativeLinkArchiveMember>(members) == 0 { NativeLinkArchiveMalformed }
    else { NativeLinkArchiveParsed(members) }
  }
}

pub(package) fn native_link_object_symbol_view(object: NativeLinkMachObject, symbol_index: i64) -> NativeLinkByteView {
  if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(object) { NativeLinkByteView(0, 0) }
  else {
    let bytes = native_link_mach_object_bytes(object)
    let len = native_link_mach_object_len(object)
    let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
    let string_index = bytes_u32_le_at(bytes, len, symbol, 0)
    let string_start = native_link_mach_object_stroff(object) + string_index
    let string_end = native_link_mach_object_stroff(object) + native_link_mach_object_strsize(object)
    let name_len = bytes_cstr_len_bounded(bytes, string_end, string_start)
    if string_index == 0 or name_len <= 0 { NativeLinkByteView(0, 0) }
    else { NativeLinkByteView(bytes + string_start, name_len) }
  }
}

pub(package) fn native_link_byte_view_matches_name(view: NativeLinkByteView, name: str) -> i64 {
  let ptr = native_link_byte_view_ptr(view)
  let len = native_link_byte_view_len(view)
  let name_len = __str_len(name)
  let prefix = if len == name_len + 1 and bytes_u8_at(ptr, len, 0, 0) == 95 { 1 } else { 0 }
  if len - prefix != name_len { 0 }
  else {
    let mut equal = 1
    let mut i = 0
    while i < name_len and equal == 1 {
      if bytes_u8_at(ptr, len, prefix + i, 0) != bytes_u8_at(__str_ptr(name), name_len, i, 0) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn native_link_object_symbol_is_text_definition(object: NativeLinkMachObject, symbol_index: i64) -> i64 {
  if symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(object) { 0 }
  else {
    let bytes = native_link_mach_object_bytes(object)
    let len = native_link_mach_object_len(object)
    let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
    let kind = bytes_u8_at(bytes, len, symbol + 4, 0)
    let section = bytes_u8_at(bytes, len, symbol + 5, 0)
    if kind band 1 == 1 and kind band 14 == 14 and section == native_link_mach_object_text_section(object) { 1 } else { 0 }
  }
}

pub(package) fn native_link_object_defines(object: NativeLinkMachObject, name: str) -> i64 {
  let mut symbol_index = 0
  let mut found = 0
  while symbol_index < native_link_mach_object_nsyms(object) and found == 0 {
    if native_link_object_symbol_is_text_definition(object, symbol_index) == 1 and
      native_link_byte_view_matches_name(native_link_object_symbol_view(object, symbol_index), name) == 1 {
      found = 1
    } else { symbol_index = symbol_index + 1 }
  }
  found
}

pub(package) fn native_link_library_from_fmap(entry: i64) -> NativeLinkLibrary {
  let name = pkg_str_view(fmap_native_link_library_link_ptr(entry), fmap_native_link_library_link_len(entry))
  let selected = pkg_str_view(fmap_native_link_library_selected_path_ptr(entry), fmap_native_link_library_selected_path_len(entry))
  let content = pkg_str_view(fmap_native_link_library_content_ptr(entry), fmap_native_link_library_content_len(entry))
  match pkg_native_library_kind_fact(fmap_native_link_library_kind(entry)) {
    NativeSystemLibrary -> {
      let load_path = if str_eq(name, "System") == 1 { "/usr/lib/libSystem.B.dylib" } else { "" }
      NativeLinkSystemLibrary(name, load_path)
    }
    NativeArchiveLibrary -> NativeLinkStaticArchive(
      name,
      selected,
      content,
      fmap_native_link_library_artifact_ptr(entry),
      fmap_native_link_library_artifact_len(entry)
    )
    NativeDynamicLibrary -> NativeLinkDynamicLibrary(
      name,
      selected,
      pkg_str_view(fmap_native_link_library_load_identity_ptr(entry), fmap_native_link_library_load_identity_len(entry)),
      content
    )
  }
}

pub(package) fn native_link_plan_libraries_from_fmap(fm: i64) -> List<NativeLinkLibrary> {
  let mut libraries = list_cons<NativeLinkLibrary>(NativeLinkSystemLibrary("System", "/usr/lib/libSystem.B.dylib"), list_nil<NativeLinkLibrary>())
  for i in 0..fmap_native_link_library_count(fm) {
    let entry = fmap_native_link_library_at(fm, i)
    if fmap_native_link_library_is_used(entry) == 1 {
      libraries = list_append<NativeLinkLibrary>(libraries, native_link_library_from_fmap(entry))
    } else { 0 }
  }
  libraries
}

-- Library index zero is the platform contract. Manifest-selected libraries
-- follow in manifest order, skipping unreachable entries.
pub(package) fn native_link_used_library_index(fm: i64, wanted: i64) -> i64 {
  let mut index = 1
  let mut found = 0 - 1
  let mut i = 0
  while i < fmap_native_link_library_count(fm) and found < 0 {
    let entry = fmap_native_link_library_at(fm, i)
    if fmap_native_link_library_is_used(entry) == 1 {
      if entry == wanted { found = index } else { index = index + 1 }
    } else { 0 }
    i = i + 1
  }
  found
}

pub(package) fn native_link_plan_imports_from_fmap(fm: i64) -> List<NativeLinkImport> {
  let mut imports = list_nil<NativeLinkImport>()
  for i in 0..got_sym_count() {
    imports = list_append<NativeLinkImport>(imports, NativeLinkImport(got_sym_name(i), 0, NativeLinkRuntimeImport))
  }
  for i in 0..fmap_native_external_used_count(fm) {
    let entry = fmap_native_external_used_at(fm, i)
    let library_index = native_link_used_library_index(fm, fmap_native_external_entry_library(entry))
    imports = list_append<NativeLinkImport>(
      imports,
      NativeLinkImport(
        pkg_str_view(fmap_native_external_entry_symbol_ptr(entry), fmap_native_external_entry_symbol_len(entry)),
        library_index,
        NativeLinkManifestImport(i)
      )
    )
  }
  imports
}

pub(package) fn native_link_plan_relocations_from_fmap(fm: i64) -> List<NativeLinkPlanRelocation> {
  let mut relocations = list_nil<NativeLinkPlanRelocation>()
  for i in 0..fmap_got_patch_count(fm) {
    relocations = list_cons<NativeLinkPlanRelocation>(
      NativeLinkPlanBranch26(fmap_got_patch_code_pos(fm, i), fmap_got_patch_index(fm, i)),
      relocations
    )
  }
  relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanPageAddress(fmap_native_provenance_adrp_pos(fm), NativeLinkCodeAddress(fmap_native_provenance_table_offset(fm))),
    relocations
  )
  for i in 0..fmap_static_pair_patch_count(fm) {
    relocations = list_cons<NativeLinkPlanRelocation>(
      NativeLinkPlanPageAddress(fmap_static_pair_patch_code_pos(fm, i), NativeLinkStaticAddress(fmap_static_pair_patch_slot_off(fm, i))),
      relocations
    )
  }
  list_reverse<NativeLinkPlanRelocation>(relocations)
}

pub(package) fn native_link_library_at(libraries: List<NativeLinkLibrary>, index: i64) -> Option<NativeLinkLibrary> {
  list_nth<NativeLinkLibrary>(libraries, index)
}

pub(package) fn native_link_import_at(imports: List<NativeLinkImport>, index: i64) -> NativeLinkImport {
  match list_nth<NativeLinkImport>(imports, index) {
    Some(value) -> value
    None -> NativeLinkInvalidImport
  }
}

pub(package) type NativeLinkResolvedSlot {
  NativeLinkResolvedSlot(i64, i64)
}

pub(package) fn native_link_resolved_slot(slots: List<NativeLinkResolvedSlot>, import_index: i64) -> i64 {
  match slots {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkResolvedSlot(candidate, slot) -> {
        if candidate == import_index { slot } else { native_link_resolved_slot(rest, import_index) }
      }
    }
  }
}

pub(package) fn native_link_archive_member_ordinal(member: NativeLinkArchiveMember) -> i64 {
  match member { NativeLinkArchiveMember(ordinal, name, object) -> ordinal }
}

pub(package) fn native_link_archive_member_object(member: NativeLinkArchiveMember) -> NativeLinkMachObject {
  match member { NativeLinkArchiveMember(ordinal, name, object) -> object }
}

pub(package) fn native_link_catalog_library_index(catalog: NativeLinkArchiveCatalog) -> i64 {
  match catalog { NativeLinkArchiveCatalog(library_index, name, path, content, members) -> library_index }
}

pub(package) fn native_link_catalog_members(catalog: NativeLinkArchiveCatalog) -> List<NativeLinkArchiveMember> {
  match catalog { NativeLinkArchiveCatalog(library_index, name, path, content, members) -> members }
}

pub(package) fn native_link_selected_contains(selected: List<NativeLinkSelectedMember>, library_index: i64, member_ordinal: i64) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(candidate_library, candidate_ordinal, member) -> {
        if candidate_library == library_index and candidate_ordinal == member_ordinal { 1 }
        else { native_link_selected_contains(rest, library_index, member_ordinal) }
      }
    }
  }
}

pub(package) fn native_link_byte_views_same_symbol(left: NativeLinkByteView, right: NativeLinkByteView) -> i64 {
  let left_ptr = native_link_byte_view_ptr(left)
  let left_len = native_link_byte_view_len(left)
  let right_ptr = native_link_byte_view_ptr(right)
  let right_len = native_link_byte_view_len(right)
  let left_prefix = if left_len > 0 and bytes_u8_at(left_ptr, left_len, 0, 0) == 95 { 1 } else { 0 }
  let right_prefix = if right_len > 0 and bytes_u8_at(right_ptr, right_len, 0, 0) == 95 { 1 } else { 0 }
  if left_len - left_prefix != right_len - right_prefix { 0 }
  else {
    let mut equal = 1
    let mut i = 0
    while i < left_len - left_prefix and equal == 1 {
      if bytes_u8_at(left_ptr, left_len, left_prefix + i, 0) != bytes_u8_at(right_ptr, right_len, right_prefix + i, 0) { equal = 0 }
      else { i = i + 1 }
    }
    equal
  }
}

pub(package) fn native_link_object_defines_view(object: NativeLinkMachObject, wanted: NativeLinkByteView) -> i64 {
  let mut symbol_index = 0
  let mut found = 0
  while symbol_index < native_link_mach_object_nsyms(object) and found == 0 {
    if native_link_object_symbol_is_text_definition(object, symbol_index) == 1 and
      native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
      found = 1
    } else { symbol_index = symbol_index + 1 }
  }
  found
}

pub(package) fn native_link_archive_catalogs(libraries: List<NativeLinkLibrary>) -> List<NativeLinkArchiveCatalog> {
  let mut catalogs = list_nil<NativeLinkArchiveCatalog>()
  let mut current = libraries
  let mut library_index = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkStaticArchive(name, path, content, bytes, len) -> {
            match native_link_archive_parse(bytes, len) {
              NativeLinkArchiveParsed(members) -> {
                catalogs = list_append<NativeLinkArchiveCatalog>(catalogs, NativeLinkArchiveCatalog(library_index, name, path, content, members))
                0
              }
              NativeLinkArchiveMalformed -> 0
            }
          }
          _ -> 0
        }
        library_index = library_index + 1
        current = rest
        0
      }
    }
  }
  catalogs
}

pub(package) fn native_link_find_member_for_name(catalogs: List<NativeLinkArchiveCatalog>, constrained_library: i64, name: str) -> Option<NativeLinkSelectedMember> {
  let mut current_catalog = catalogs
  let mut found = None<NativeLinkSelectedMember>()
  let mut done = false
  while done == false {
    match current_catalog {
      Nil -> { done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        if constrained_library < 0 or constrained_library == library_index {
          let mut current_member = native_link_catalog_members(catalog)
          while done == false {
            match current_member {
              Nil -> { done = true 0 }
              Cons(member, rest_members) -> {
                if native_link_object_defines(native_link_archive_member_object(member), name) == 1 {
                  found = Some(NativeLinkSelectedMember(library_index, native_link_archive_member_ordinal(member), member))
                  done = true
                } else { current_member = rest_members }
                0
              }
            }
          }
          if match found { Some(entry) -> 1 None -> 0 } == 0 { done = false } else { 0 }
        } else { 0 }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  found
}

pub(package) fn native_link_find_member_for_view(catalogs: List<NativeLinkArchiveCatalog>, wanted: NativeLinkByteView) -> Option<NativeLinkSelectedMember> {
  let mut current_catalog = catalogs
  let mut found = None<NativeLinkSelectedMember>()
  let mut done = false
  while done == false {
    match current_catalog {
      Nil -> { done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        let mut current_member = native_link_catalog_members(catalog)
        let mut member_done = false
        while member_done == false and done == false {
          match current_member {
            Nil -> { member_done = true 0 }
            Cons(member, rest_members) -> {
              if native_link_object_defines_view(native_link_archive_member_object(member), wanted) == 1 {
                found = Some(NativeLinkSelectedMember(library_index, native_link_archive_member_ordinal(member), member))
                done = true
              } else { current_member = rest_members }
              0
            }
          }
        }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  found
}

pub(package) fn native_link_selected_defines_view(selected: List<NativeLinkSelectedMember>, wanted: NativeLinkByteView) -> i64 {
  match selected {
    Nil -> 0
    Cons(entry, rest) -> match entry {
      NativeLinkSelectedMember(library_index, ordinal, member) -> {
        if native_link_object_defines_view(native_link_archive_member_object(member), wanted) == 1 { 1 }
        else { native_link_selected_defines_view(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_object_relocation(object: NativeLinkMachObject, relocation_index: i64) -> NativeLinkObjectRelocation {
  if relocation_index < 0 or relocation_index >= native_link_mach_object_text_nreloc(object) {
    NativeLinkObjectRelocationUnsupported(NativeLinkByteView(0, 0), 0 - 1)
  } else {
  let bytes = native_link_mach_object_bytes(object)
  let len = native_link_mach_object_len(object)
  let relocation = native_link_mach_object_text_reloff(object) + relocation_index * 8
  let address = bytes_u32_le_at(bytes, len, relocation, 0 - 1)
  let info = bytes_u32_le_at(bytes, len, relocation + 4, 0)
  let symbol_index = info band 16777215
  let pcrel = info bshr 24 band 1
  let width = info bshr 25 band 3
  let external = info bshr 27 band 1
  let kind = info bshr 28 band 15
  let symbol = native_link_object_symbol_view(object, symbol_index)
  if address < 0 or width != 2 or external != 1 { NativeLinkObjectRelocationUnsupported(symbol, kind) }
  else {
    match kind {
      2 -> if pcrel == 1 { NativeLinkObjectBranch26(address, symbol) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      3 -> if pcrel == 1 { NativeLinkObjectPage21(address, symbol_index) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      4 -> if pcrel == 0 { NativeLinkObjectPageOff12(address, symbol_index) } else { NativeLinkObjectRelocationUnsupported(symbol, kind) }
      _ -> NativeLinkObjectRelocationUnsupported(symbol, kind)
    }
  }
  }
}

pub(package) fn native_link_select_archive_closure(plan: NativeLinkPlan, catalogs: List<NativeLinkArchiveCatalog>) -> List<NativeLinkSelectedMember> {
  let libraries = native_link_plan_libraries(plan)
  let imports = native_link_plan_imports(plan)
  let mut selected = list_nil<NativeLinkSelectedMember>()
  let mut current_relocation = native_link_plan_relocations(plan)
  let mut relocations_done = false
  while relocations_done == false {
    match current_relocation {
      Nil -> { relocations_done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkPlanBranch26(address, import_index) -> {
            match native_link_import_at(imports, import_index) {
              NativeLinkImport(name, library_index, origin) -> {
                match native_link_library_at(libraries, library_index) {
                  Some(NativeLinkStaticArchive(archive_name, path, content, bytes, len)) -> {
                    match native_link_find_member_for_name(catalogs, library_index, name) {
                      Some(candidate) -> match candidate {
                        NativeLinkSelectedMember(candidate_library, candidate_ordinal, member) -> {
                          if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                            selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                          } else { 0 }
                        }
                      }
                      None -> 0
                    }
                  }
                  _ -> 0
                }
              }
              NativeLinkInvalidImport -> 0
            }
          }
          _ -> 0
        }
        current_relocation = rest
        0
      }
    }
  }

  let mut changed = true
  while changed {
    changed = false
    let mut current_selected = selected
    let mut selected_done = false
    while selected_done == false {
      match current_selected {
        Nil -> { selected_done = true 0 }
        Cons(entry, rest_selected) -> match entry {
          NativeLinkSelectedMember(library_index, ordinal, member) -> {
            let object = native_link_archive_member_object(member)
            let mut relocation_index = 0
            while relocation_index < native_link_mach_object_text_nreloc(object) {
              match native_link_object_relocation(object, relocation_index) {
                NativeLinkObjectBranch26(address, wanted) -> {
                if native_link_selected_defines_view(selected, wanted) == 0 {
                  match native_link_find_member_for_view(catalogs, wanted) {
                    Some(candidate) -> match candidate {
                      NativeLinkSelectedMember(candidate_library, candidate_ordinal, candidate_member) -> {
                        if native_link_selected_contains(selected, candidate_library, candidate_ordinal) == 0 {
                          selected = list_append<NativeLinkSelectedMember>(selected, candidate)
                          changed = true
                        } else { 0 }
                      }
                    }
                    None -> 0
                  }
                } else { 0 }
                }
                _ -> 0
              }
              relocation_index = relocation_index + 1
            }
            current_selected = rest_selected
            0
          }
        }
      }
    }
  }
  selected
}

pub(package) type NativeLinkArchiveLayout {
  NativeLinkArchiveLayout(rc i64, rc i64, List<NativeLinkPlacedMember>)
}

pub(package) fn native_link_layout_archive_members(code: i64, catalogs: List<NativeLinkArchiveCatalog>, selected: List<NativeLinkSelectedMember>) -> NativeLinkArchiveLayout {
  let merged = buf_new(buf_len(code) + 4096)
  let merged_data = buf_new(4096)
  bscopy(merged, buf_ptr(code), buf_len(code), 0)
  let mut placements = list_nil<NativeLinkPlacedMember>()
  let mut current_catalog = catalogs
  let mut catalogs_done = false
  while catalogs_done == false {
    match current_catalog {
      Nil -> { catalogs_done = true 0 }
      Cons(catalog, rest_catalogs) -> {
        let library_index = native_link_catalog_library_index(catalog)
        let mut current_member = native_link_catalog_members(catalog)
        let mut members_done = false
        while members_done == false {
          match current_member {
            Nil -> { members_done = true 0 }
            Cons(member, rest_members) -> {
              let ordinal = native_link_archive_member_ordinal(member)
              if native_link_selected_contains(selected, library_index, ordinal) == 1 {
                let object = native_link_archive_member_object(member)
                bpad(merged, native_link_align(buf_len(merged), native_link_pow2(native_link_mach_object_text_align(object))))
                let code_offset = buf_len(merged)
                bscopy(
                  merged,
                  native_link_mach_object_bytes(object) + native_link_mach_object_text_offset(object),
                  native_link_mach_object_text_size(object),
                  0
                )
                let mut data_offset = 0 - 1
                match native_link_mach_object_data(object) {
                  NativeLinkMachDataAbsent -> 0
                  NativeLinkMachDataZeroFill(data_addr, data_size, data_align, data_section) -> {
                    bpad(merged_data, native_link_align(buf_len(merged_data), native_link_pow2(data_align)))
                    data_offset = buf_len(merged_data)
                    bpad(merged_data, data_offset + data_size)
                  }
                  NativeLinkMachDataBytes(data_addr, data_size, source_offset, data_align, data_section) -> {
                    bpad(merged_data, native_link_align(buf_len(merged_data), native_link_pow2(data_align)))
                    data_offset = buf_len(merged_data)
                    bscopy(merged_data, native_link_mach_object_bytes(object) + source_offset, data_size, 0)
                  }
                }
                placements = list_append<NativeLinkPlacedMember>(placements, NativeLinkPlacedMember(library_index, ordinal, member, code_offset, data_offset))
              } else { 0 }
              current_member = rest_members
              0
            }
          }
        }
        current_catalog = rest_catalogs
        0
      }
    }
  }
  NativeLinkArchiveLayout(merged, merged_data, placements)
}

pub(package) fn native_link_placed_address_for_name(placements: List<NativeLinkPlacedMember>, name: str) -> i64 {
  match placements {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedMember(library_index, ordinal, member, code_offset, data_offset) -> {
        let object = native_link_archive_member_object(member)
        let mut symbol_index = 0
        let mut target = 0 - 1
        while symbol_index < native_link_mach_object_nsyms(object) and target < 0 {
          if native_link_object_symbol_is_text_definition(object, symbol_index) == 1 and
            native_link_byte_view_matches_name(native_link_object_symbol_view(object, symbol_index), name) == 1 {
            let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
            let value = bytes_u64_le_at(native_link_mach_object_bytes(object), native_link_mach_object_len(object), symbol + 8, 0)
            target = code_offset + value - native_link_mach_object_text_addr(object)
          } else { symbol_index = symbol_index + 1 }
        }
        if target >= 0 { target } else { native_link_placed_address_for_name(rest, name) }
      }
    }
  }
}

pub(package) fn native_link_placed_address_for_view(placements: List<NativeLinkPlacedMember>, wanted: NativeLinkByteView) -> i64 {
  match placements {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedMember(library_index, ordinal, member, code_offset, data_offset) -> {
        let object = native_link_archive_member_object(member)
        let mut symbol_index = 0
        let mut target = 0 - 1
        while symbol_index < native_link_mach_object_nsyms(object) and target < 0 {
          if native_link_object_symbol_is_text_definition(object, symbol_index) == 1 and
            native_link_byte_views_same_symbol(native_link_object_symbol_view(object, symbol_index), wanted) == 1 {
            let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
            let value = bytes_u64_le_at(native_link_mach_object_bytes(object), native_link_mach_object_len(object), symbol + 8, 0)
            target = code_offset + value - native_link_mach_object_text_addr(object)
          } else { symbol_index = symbol_index + 1 }
        }
        if target >= 0 { target } else { native_link_placed_address_for_view(rest, wanted) }
      }
    }
  }
}

pub(package) fn native_link_object_local_data_address(object: NativeLinkMachObject, symbol_index: i64, data_offset: i64) -> i64 {
  if data_offset < 0 or symbol_index < 0 or symbol_index >= native_link_mach_object_nsyms(object) { 0 - 1 }
  else {
    let bytes = native_link_mach_object_bytes(object)
    let len = native_link_mach_object_len(object)
    let symbol = native_link_mach_object_symoff(object) + symbol_index * 16
    let kind = bytes_u8_at(bytes, len, symbol + 4, 0)
    let section = bytes_u8_at(bytes, len, symbol + 5, 0)
    let data = native_link_mach_object_data(object)
    if kind band 14 == 14 and section == native_link_mach_data_section(data) {
      data_offset + bytes_u64_le_at(bytes, len, symbol + 8, 0) - native_link_mach_data_addr(data)
    } else { 0 - 1 }
  }
}

pub(package) fn native_link_placed_data_address_for_symbol(placements: List<NativeLinkPlacedMember>, source_object: NativeLinkMachObject, symbol_index: i64) -> i64 {
  match placements {
    Nil -> 0 - 1
    Cons(entry, rest) -> match entry {
      NativeLinkPlacedMember(library_index, ordinal, member, code_offset, data_offset) -> {
        let object = native_link_archive_member_object(member)
        if native_link_mach_object_bytes(object) == native_link_mach_object_bytes(source_object) {
          let local = native_link_object_local_data_address(object, symbol_index, data_offset)
          if local >= 0 { local } else { native_link_placed_data_address_for_symbol(rest, source_object, symbol_index) }
        } else { native_link_placed_data_address_for_symbol(rest, source_object, symbol_index) }
      }
    }
  }
}

pub(package) fn native_link_validate_libraries(libraries: List<NativeLinkLibrary>) -> List<NativeLinkError> {
  let mut errors = list_nil<NativeLinkError>()
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkSystemLibrary(name, load_path) -> {
            if __str_len(load_path) == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedSystemLibrary(name))
              0
            } else { 0 }
          }
          NativeLinkStaticArchive(name, path, content, bytes, len) -> {
            if bytes == 0 or len == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkMissingArchiveArtifact(name, path))
              0
            } else {
              match native_link_archive_parse(bytes, len) {
                NativeLinkArchiveParsed(members) -> 0
                NativeLinkArchiveMalformed -> {
                  errors = list_append<NativeLinkError>(errors, NativeLinkMalformedArchive(name, path))
                  0
                }
              }
            }
          }
          NativeLinkDynamicLibrary(name, path, load_identity, content) -> {
            if __str_len(path) == 0 or __str_len(load_identity) == 0 {
              errors = list_append<NativeLinkError>(errors, NativeLinkMissingDynamicArtifact(name))
              0
            } else { 0 }
          }
        }
        current = rest
        0
      }
    }
  }
  errors
}

pub(package) fn native_link_library_ordinal(libraries: List<NativeLinkLibrary>, wanted: i64) -> i64 {
  let mut current = libraries
  let mut index = 0
  let mut next_dynamic_ordinal = 2
  let mut found = 0
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        if index == wanted {
          found = match library {
            NativeLinkSystemLibrary(name, load_path) -> 1
            NativeLinkDynamicLibrary(name, path, load_identity, content) -> next_dynamic_ordinal
            NativeLinkStaticArchive(name, path, content, bytes, len) -> 0
          }
          done = true
          0
        } else {
          match library {
            NativeLinkDynamicLibrary(name, path, load_identity, content) -> { next_dynamic_ordinal = next_dynamic_ordinal + 1 0 }
            _ -> 0
          }
          current = rest
          index = index + 1
          0
        }
      }
    }
  }
  found
}

pub(package) fn native_link_byte_view_symbol_name(view: NativeLinkByteView) -> str {
  let ptr = native_link_byte_view_ptr(view)
  let len = native_link_byte_view_len(view)
  let prefix = if len > 0 and bytes_u8_at(ptr, len, 0, 0) == 95 { 1 } else { 0 }
  pkg_str_view(ptr + prefix, len - prefix)
}

pub(package) fn native_link_symbol_slot(symbols: List<NativeLinkSymbol>, name: str, ordinal: i64, index: i64) -> i64 {
  match symbols {
    Nil -> 0 - 1
    Cons(symbol, rest) -> match symbol {
      NativeLinkUndefinedStrong(candidate, candidate_ordinal, origin) -> {
        if candidate_ordinal == ordinal and str_eq(candidate, name) == 1 { index }
        else { native_link_symbol_slot(rest, name, ordinal, index + 1) }
      }
    }
  }
}

pub(package) fn native_link_resolve(plan: NativeLinkPlan) -> NativeLinkOutcome {
  let libraries = native_link_plan_libraries(plan)
  let imports = native_link_plan_imports(plan)
  let plan_relocations = native_link_plan_relocations(plan)
  let mut errors = native_link_validate_libraries(libraries)
  let catalogs = native_link_archive_catalogs(libraries)
  let selected = native_link_select_archive_closure(plan, catalogs)
  let layout = native_link_layout_archive_members(native_link_plan_code(plan), catalogs, selected)
  let merged_code = match layout { NativeLinkArchiveLayout(code, data, placements) -> code }
  let merged_data = match layout { NativeLinkArchiveLayout(code, data, placements) -> data }
  let placements = match layout { NativeLinkArchiveLayout(code, data, entries) -> entries }
  let import_count = list_len<NativeLinkImport>(imports)
  let mut slots = list_nil<NativeLinkResolvedSlot>()
  let mut symbols = list_nil<NativeLinkSymbol>()
  let mut relocations = list_nil<NativeLinkRelocation>()
  let mut symbol_count = 0
  let mut current = plan_relocations
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkPlanBranch26(address, import_index) -> {
            if import_index < 0 or import_index >= import_count {
              errors = list_append<NativeLinkError>(errors, NativeLinkInvalidImportIndex(import_index))
              0
            } else {
              let stored = native_link_resolved_slot(slots, import_index)
              let slot = if stored >= 0 { stored }
              else {
                match native_link_import_at(imports, import_index) {
                  NativeLinkImport(name, library_index, origin) -> {
                    match native_link_library_at(libraries, library_index) {
                      Some(NativeLinkStaticArchive(archive_name, path, content, bytes, len)) -> {
                        let target = native_link_placed_address_for_name(placements, name)
                        if target < 0 {
                          errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(name))
                          0
                        } else {
                          relocations = list_cons<NativeLinkRelocation>(NativeLinkDirectBranch26(address, target), relocations)
                          0
                        }
                        0 - 1
                      }
                      Some(library) -> {
                        let ordinal = native_link_library_ordinal(libraries, library_index)
                        if ordinal == 0 {
                          errors = list_append<NativeLinkError>(errors, NativeLinkInvalidLibraryIndex(library_index))
                          0
                        } else {
                          symbols = list_append<NativeLinkSymbol>(symbols, NativeLinkUndefinedStrong(name, ordinal, origin))
                          slots = list_cons<NativeLinkResolvedSlot>(NativeLinkResolvedSlot(import_index, symbol_count), slots)
                          symbol_count = symbol_count + 1
                          0
                        }
                        symbol_count - 1
                      }
                      None -> {
                        errors = list_append<NativeLinkError>(errors, NativeLinkInvalidLibraryIndex(library_index))
                        0 - 1
                      }
                    }
                  }
                  NativeLinkInvalidImport -> {
                    errors = list_append<NativeLinkError>(errors, NativeLinkInvalidImportIndex(import_index))
                    0
                  }
                }
              }
              if slot >= 0 { relocations = list_cons<NativeLinkRelocation>(NativeLinkBranch26(address, slot), relocations) } else { 0 }
              0
            }
          }
          NativeLinkPlanPageAddress(address, target) -> {
            relocations = list_cons<NativeLinkRelocation>(NativeLinkPageAddress(address, target), relocations)
            0
          }
        }
        current = rest
        0
      }
    }
  }
  let mut current_placement = placements
  let mut placements_done = false
  while placements_done == false {
    match current_placement {
      Nil -> { placements_done = true 0 }
      Cons(entry, rest_placements) -> match entry {
        NativeLinkPlacedMember(library_index, ordinal, member, code_offset, data_offset) -> {
          let object = native_link_archive_member_object(member)
          let mut relocation_index = 0
          while relocation_index < native_link_mach_object_text_nreloc(object) {
            match native_link_object_relocation(object, relocation_index) {
              NativeLinkObjectBranch26(relocation_address, wanted) -> {
                let target = native_link_placed_address_for_view(placements, wanted)
                if target >= 0 {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkDirectBranch26(code_offset + relocation_address, target), relocations)
                  0
                } else {
                  let name = native_link_byte_view_symbol_name(wanted)
                  let stored_slot = native_link_symbol_slot(symbols, name, 1, 0)
                  let slot = if stored_slot >= 0 { stored_slot }
                  else {
                    symbols = list_append<NativeLinkSymbol>(symbols, NativeLinkUndefinedStrong(name, 1, NativeLinkRuntimeImport))
                    symbol_count = symbol_count + 1
                    symbol_count - 1
                  }
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkBranch26(code_offset + relocation_address, slot), relocations)
                  0
                }
              }
              NativeLinkObjectPage21(relocation_address, symbol_index) -> {
                let target = native_link_placed_data_address_for_symbol(placements, object, symbol_index)
                if target < 0 {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_byte_view_symbol_name(wanted)))
                  0
                } else {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchivePage21(code_offset + relocation_address, target), relocations)
                  0
                }
              }
              NativeLinkObjectPageOff12(relocation_address, symbol_index) -> {
                let target = native_link_placed_data_address_for_symbol(placements, object, symbol_index)
                if target < 0 {
                  let wanted = native_link_object_symbol_view(object, symbol_index)
                  errors = list_append<NativeLinkError>(errors, NativeLinkUndefinedArchiveSymbol(native_link_byte_view_symbol_name(wanted)))
                  0
                } else {
                  relocations = list_cons<NativeLinkRelocation>(NativeLinkArchivePageOff12(code_offset + relocation_address, target), relocations)
                  0
                }
              }
              NativeLinkObjectRelocationUnsupported(wanted, kind) -> {
                errors = list_append<NativeLinkError>(errors, NativeLinkUnsupportedArchiveRelocation(native_link_byte_view_symbol_name(wanted), kind))
                0
              }
            }
            relocation_index = relocation_index + 1
          }
          current_placement = rest_placements
          0
        }
      }
    }
  }
  if list_len<NativeLinkError>(errors) != 0 {
    NativeLinkRejected(errors)
  } else {
    let graph = NativeLinkGraph(
      native_link_plan_target(plan),
      merged_code,
      merged_data,
      libraries,
      symbols,
      list_reverse<NativeLinkRelocation>(relocations),
      native_link_plan_static_slots(plan)
    )
    let facts = native_link_artifact_facts(graph)
    NativeLinkSucceeded(graph, facts)
  }
}

pub(package) fn native_link_graph_symbol_count(graph: NativeLinkGraph) -> i64 {
  match graph { NativeLinkGraph(target, code, data, libraries, symbols, relocations, static_slots) -> list_len<NativeLinkSymbol>(symbols) }
}

pub(package) fn native_link_graph_relocation_count(graph: NativeLinkGraph) -> i64 {
  match graph { NativeLinkGraph(target, code, data, libraries, symbols, relocations, static_slots) -> list_len<NativeLinkRelocation>(relocations) }
}

pub(package) fn native_link_error_count(outcome: NativeLinkOutcome) -> i64 {
  match outcome {
    NativeLinkSucceeded(graph, facts) -> 0
    NativeLinkRejected(errors) -> list_len<NativeLinkError>(errors)
  }
}

pub(package) fn native_link_dylibs(libraries: List<NativeLinkLibrary>) -> List<str> {
  let mut dylibs = list_cons<str>("/usr/lib/libSystem.B.dylib", list_nil<str>())
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkDynamicLibrary(name, path, load_identity, content) -> { dylibs = list_append<str>(dylibs, load_identity) 0 }
          _ -> 0
        }
        current = rest
        0
      }
    }
  }
  dylibs
}

pub(package) fn native_link_artifact_dependencies(libraries: List<NativeLinkLibrary>) -> List<NativeArtifactDependency> {
  let mut dependencies = list_cons<NativeArtifactDependency>(
    NativeArtifactSystemDependency("/usr/lib/libSystem.B.dylib"),
    list_nil<NativeArtifactDependency>()
  )
  let mut current = libraries
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(library, rest) -> {
        match library {
          NativeLinkDynamicLibrary(name, path, load_identity, content) -> {
            dependencies = list_append<NativeArtifactDependency>(dependencies, NativeArtifactDynamicDependency(load_identity))
            0
          }
          _ -> 0
        }
        current = rest
        0
      }
    }
  }
  dependencies
}

pub(package) fn native_link_artifact_is_standalone(facts: NativeArtifactFacts) -> bool {
  match facts { NativeArtifactFacts(target, standalone, dependencies, symbols) -> standalone }
}

pub(package) fn native_link_artifact_facts(graph: NativeLinkGraph) -> NativeArtifactFacts {
  match graph {
    NativeLinkGraph(target, code, data, libraries, symbols, relocations, static_slots) -> {
      let mut standalone = true
      let mut current = libraries
      let mut done = false
      while done == false {
        match current {
          Nil -> { done = true 0 }
          Cons(library, rest) -> {
            match library {
              NativeLinkDynamicLibrary(name, path, load_identity, content) -> { standalone = false 0 }
              _ -> 0
            }
            current = rest
            0
          }
        }
      }
      NativeArtifactFacts(target, standalone, native_link_artifact_dependencies(libraries), symbols)
    }
  }
}

pub(package) fn native_link_align(n: i64, alignment: i64) -> i64 {
  (n + alignment - 1) / alignment * alignment
}

pub(package) fn native_link_emit_uleb(buffer: i64, value: i64) -> i64 {
  let mut remaining = value
  let mut done = false
  while done == false {
    let low = remaining band 127
    remaining = remaining bshr 7
    if remaining == 0 {
      bu8(buffer, low)
      done = true
    } else {
      bu8(buffer, low + 128)
    }
  }
  0
}

pub(package) fn native_link_emit_nlists(output: i64, symbols: List<NativeLinkSymbol>) -> i64 {
  let mut string_offset = 1
  let mut current = symbols
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(symbol, rest) -> {
        match symbol {
          NativeLinkUndefinedStrong(name, ordinal, origin) -> {
            bu32(output, string_offset)
            bu8(output, 1)
            bu8(output, 0)
            bu8(output, 0)
            bu8(output, ordinal)
            bu64(output, 0)
            string_offset = string_offset + 2 + __str_len(name)
          }
        }
        current = rest
        0
      }
    }
  }
  0
}

pub(package) fn native_link_dylib_command_size(path: str) -> i64 {
  native_link_align(24 + __str_len(path) + 1, 8)
}

pub(package) fn native_link_dylib_commands_size(dylibs: List<str>) -> i64 {
  let mut size = 0
  let mut current = dylibs
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(path, rest) -> {
        size = size + native_link_dylib_command_size(path)
        current = rest
        0
      }
    }
  }
  size
}

pub(package) fn native_link_emit_dylib_commands(output: i64, dylibs: List<str>) -> i64 {
  let mut current = dylibs
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(path, rest) -> {
        let start = buf_len(output)
        let size = native_link_dylib_command_size(path)
        bu32(output, 12)
        bu32(output, size)
        bu32(output, 24)
        bu32(output, 0)
        bu32(output, 65536)
        bu32(output, 65536)
        bstr(output, path)
        bu8(output, 0)
        bpad(output, start + size)
        current = rest
        0
      }
    }
  }
  0
}

pub(package) fn native_link_emit_data_segment(output: i64, text_size: i64, data_size: i64, symbol_count: i64, static_offset: i64, static_size: i64, archive_offset: i64, archive_size: i64) -> i64 {
  let section_count = 1 + (if static_size > 0 { 1 } else { 0 }) + (if archive_size > 0 { 1 } else { 0 })
  let command_size = 72 + section_count * 80
  bu32(output, 25)
  bu32(output, command_size)
  bstr(output, "__DATA") bfill(output, 10)
  bu64(output, 4294967296 + text_size)
  bu64(output, data_size)
  bu64(output, text_size)
  bu64(output, data_size)
  bu32(output, 3) bu32(output, 3)
  bu32(output, section_count) bu32(output, 0)
  bstr(output, "__got") bfill(output, 11)
  bstr(output, "__DATA") bfill(output, 10)
  bu64(output, 4294967296 + text_size)
  bu64(output, symbol_count * 8)
  bu32(output, text_size)
  bu32(output, 3)
  bu32(output, 0) bu32(output, 0)
  bu32(output, 6)
  bu32(output, 0) bu32(output, 0) bu32(output, 0)
  if static_size > 0 {
    bstr(output, "__wstatic") bfill(output, 7)
    bstr(output, "__DATA") bfill(output, 10)
    bu64(output, 4294967296 + text_size + static_offset)
    bu64(output, static_size)
    bu32(output, text_size + static_offset)
    bu32(output, 4)
    bu32(output, 0) bu32(output, 0)
    bu32(output, 0)
    bu32(output, 0) bu32(output, 0) bu32(output, 0)
  } else { 0 }
  if archive_size > 0 {
    bstr(output, "__archive") bfill(output, 7)
    bstr(output, "__DATA") bfill(output, 10)
    bu64(output, 4294967296 + text_size + archive_offset)
    bu64(output, archive_size)
    bu32(output, text_size + archive_offset)
    bu32(output, 12)
    bu32(output, 0) bu32(output, 0)
    bu32(output, 0)
    bu32(output, 0) bu32(output, 0) bu32(output, 0)
  } else { 0 }
  0
}

pub(package) fn native_link_emit_stubs(code: i64, symbols: List<NativeLinkSymbol>, text_size: i64, stub_base: i64, slot: i64) -> i64 {
  match symbols {
    Nil -> 0
    Cons(symbol, rest) -> {
      let stub = stub_base + slot * 12
      let got = text_size + slot * 8
      let page_delta = got / 4096 - (16384 + stub) / 4096
      bu32(code, encode_adrp(16, page_delta))
      bu32(code, encode_ldr(16, 16, got - got / 4096 * 4096))
      bu32(code, encode_br(16))
      native_link_emit_stubs(code, rest, text_size, stub_base, slot + 1)
    }
  }
}

pub(package) fn native_link_pageoff12_word(word: i64, page_offset: i64) -> i64 {
  let add_immediate = if word band 2130706432 == 285212672 { 1 } else { 0 }
  let scale = if add_immediate == 1 { 0 } else { word bshr 30 band 3 }
  let divisor = native_link_pow2(scale)
  if page_offset < 0 or page_offset >= 4096 or page_offset / divisor * divisor != page_offset {
    encode_brk(29)
  } else {
    (word band 4290774015) + page_offset / divisor * 1024
  }
}

pub(package) fn native_link_apply_relocations(code: i64, relocations: List<NativeLinkRelocation>, text_size: i64, stub_base: i64, static_offset: i64, archive_offset: i64) -> i64 {
  let mut current = relocations
  let mut done = false
  while done == false {
    match current {
      Nil -> { done = true 0 }
      Cons(relocation, rest) -> {
        match relocation {
          NativeLinkBranch26(address, slot) -> {
            bytes_set_u32(code, address, encode_bl(stub_base + slot * 12 - address))
            0
          }
          NativeLinkDirectBranch26(address, target) -> {
            bytes_set_u32(code, address, encode_bl(target - address))
            0
          }
          NativeLinkArchivePage21(address, data_offset) -> {
            let target_offset = text_size + archive_offset + data_offset
            let source_offset = 16384 + address
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, encode_adrp(word band 31, target_offset / 4096 - source_offset / 4096))
            0
          }
          NativeLinkArchivePageOff12(address, data_offset) -> {
            let target_offset = text_size + archive_offset + data_offset
            let word = bytes_u32_le_at(buf_ptr(code), buf_len(code), address, 0)
            bytes_set_u32(code, address, native_link_pageoff12_word(word, target_offset - target_offset / 4096 * 4096))
            0
          }
          NativeLinkPageAddress(address, target) -> {
            let target_offset = match target {
              NativeLinkCodeAddress(code_offset) -> 16384 + code_offset
              NativeLinkStaticAddress(slot_offset) -> text_size + static_offset + slot_offset
            }
            let source_offset = 16384 + address
            bytes_set_u32(code, address, encode_adrp(17, target_offset / 4096 - source_offset / 4096))
            bytes_set_u32(code, address + 4, encode_add_imm(17, 17, target_offset - target_offset / 4096 * 4096))
            0
          }
        }
        current = rest
        0
      }
    }
  }
  0
}
