-- compiler/native_link.weft -- typed native final-link graph and Mach-O leaf
--
-- The compiler's selected-target facts are projected once into NativeLinkPlan.
-- Resolution consumes only that typed value; Mach-O construction consumes the
-- resulting closed graph. The temporary archive residual is explicit, so the
-- platform-linker oracle cannot silently become part of link semantics.

use compiler/codegen.{*}
use compiler/encode.{*}
use compiler/lib.{*}
use compiler/object.{got_sym_count, got_sym_name}
use compiler/package.{*}
use compiler/package_lock.{pkg_lock_digest_hex}
use compiler/sha256.{sha256}
use runtime/buffer.{*}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/option.{None, Some}
use stdlib/string.{str_concat, str_eq}

pub(package) type NativeLinkTarget {
  NativeLinkMacosAarch64,
  NativeLinkLinuxAarch64
}

pub(package) type NativeLinkLibrary {
  NativeLinkSystemLibrary(str, str),
  NativeLinkStaticArchive(str, str, str, NativeLibraryLicense, i64, i64),
  NativeLinkDynamicLibrary(str, str, str, str, NativeLibraryLicense, List<NativeLinkDynamicLoad>)
}

pub(package) type NativeLinkByteView {
  NativeLinkByteView(i64, i64)
}

pub(package) type NativeLinkMachObject {
  NativeLinkMachObject(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, List<NativeLinkMachDataSection>)
}

pub(package) type NativeLinkMachDataSection {
  NativeLinkMachDataBytes(i64, i64, i64, i64, i64),
  NativeLinkMachDataZeroFill(i64, i64, i64, i64)
}

pub(package) type NativeLinkMachObjectParse {
  NativeLinkMachObjectParsed(NativeLinkMachObject),
  NativeLinkMachObjectMalformed
}

