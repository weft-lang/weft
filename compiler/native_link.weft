        current = rest
        0
      }
    }
  }
  json_array(items)
}

pub(package) fn native_link_artifact_platform_abi_json(platform: NativeArtifactPlatformAbi) -> Json {
  match platform {
    NativeArtifactMacosPlatformAbi(major, minor, patch) -> list_cons<JsonEntry>(
      json_entry("platform", json_string("macos")),
      list_cons<JsonEntry>(json_entry("major", json_number(major)),
      list_cons<JsonEntry>(json_entry("minor", json_number(minor)),
      list_cons<JsonEntry>(json_entry("patch", json_number(patch)), list_nil<JsonEntry>())))
    ) |> json_object
    NativeArtifactLinuxKernelAbi(major, minor, patch) -> list_cons<JsonEntry>(
      json_entry("platform", json_string("linux")),
      list_cons<JsonEntry>(json_entry("abi", json_string("kernel")),
      list_cons<JsonEntry>(json_entry("major", json_number(major)),
      list_cons<JsonEntry>(json_entry("minor", json_number(minor)),
      list_cons<JsonEntry>(json_entry("patch", json_number(patch)),
      list_cons<JsonEntry>(json_entry("libc", json_string("none")),
      list_cons<JsonEntry>(json_entry("dynamic_loader", json_string("none")), list_nil<JsonEntry>()))))))
    ) |> json_object
    NativeArtifactLinuxDynamicAbi(major, minor, patch, libc, loader) -> list_cons<JsonEntry>(
      json_entry("platform", json_string("linux")),
      list_cons<JsonEntry>(json_entry("abi", json_string("kernel+elf-dynamic")),
      list_cons<JsonEntry>(json_entry("major", json_number(major)),
      list_cons<JsonEntry>(json_entry("minor", json_number(minor)),
      list_cons<JsonEntry>(json_entry("patch", json_number(patch)),
      list_cons<JsonEntry>(json_entry("libc", json_string(libc)),
      list_cons<JsonEntry>(json_entry("dynamic_loader", json_string(loader)), list_nil<JsonEntry>()))))))
    ) |> json_object
    NativeArtifactPlatformAbiUnspecified -> list_cons<JsonEntry>(
      json_entry("platform", json_string("unspecified")),
      list_nil<JsonEntry>()
    ) |> json_object
  }
}

