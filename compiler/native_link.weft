  NativeLinkUnsupportedArchiveRelocation(str, i64),
  NativeLinkRelocationSiteOutOfRange(NativeLinkRelocationEncoding, i64),
  NativeLinkRelocationTargetOutOfRange(NativeLinkRelocationEncoding, i64, i64),
  NativeLinkRelocationTargetMisaligned(NativeLinkRelocationEncoding, i64, i64),
