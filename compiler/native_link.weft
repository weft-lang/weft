    NativeLinkMachDataZeroFill(addr, size, align, section, reloff, nreloc) -> nreloc
    NativeLinkElfDataBytes(addr, size, offset, align, section, relaoff, nrela) -> nrela
    NativeLinkElfDataZeroFill(addr, size, align, section, relaoff, nrela) -> nrela
  }
}

pub(package) fn native_link_object_data_has_section(data: List<NativeLinkObjectDataSection>, section: i64) -> i64 {
  match data {
    Nil -> 0
    Cons(entry, rest) -> {
      if native_link_object_data_section(entry) == section { 1 }
      else { native_link_object_data_has_section(rest, section) }
    }
  }
}

pub(package) fn native_link_object_data_addr_for_section(data: List<NativeLinkObjectDataSection>, section: i64) -> i64 {
  match data {
    Nil -> 0 - 1
    Cons(entry, rest) -> {
      if native_link_object_data_section(entry) == section { native_link_object_data_addr(entry) }
      else { native_link_object_data_addr_for_section(rest, section) }
    }
  }
}

pub(package) fn native_link_object_data_section_has_relocations(data: List<NativeLinkObjectDataSection>, section: i64) -> i64 {
  match data {
    Nil -> 0
    Cons(entry, rest) -> {
      if native_link_object_data_section(entry) == section and native_link_object_data_relocation_count_for_section(entry) > 0 { 1 }
      else { native_link_object_data_section_has_relocations(rest, section) }
    }
  }
}

pub(package) fn native_link_elf_data_attach_relocations(data: List<NativeLinkObjectDataSection>, section: i64, relaoff: i64, nrela: i64) -> List<NativeLinkObjectDataSection> {
  match data {
    Nil -> list_nil<NativeLinkObjectDataSection>()
    Cons(entry, rest) -> {
      let updated = match entry {
        NativeLinkElfDataBytes(addr, size, offset, align, candidate, old_relaoff, old_nrela) -> {
          if candidate == section { NativeLinkElfDataBytes(addr, size, offset, align, candidate, relaoff, nrela) } else { entry }
        }
        NativeLinkElfDataZeroFill(addr, size, align, candidate, old_relaoff, old_nrela) -> {
          if candidate == section { NativeLinkElfDataZeroFill(addr, size, align, candidate, relaoff, nrela) } else { entry }
        }
        _ -> entry
      }
      list_cons<NativeLinkObjectDataSection>(updated, native_link_elf_data_attach_relocations(rest, section, relaoff, nrela))
    }
  }
}

pub(package) fn native_link_pow2(exponent: i64) -> i64 {
  let mut value = 1
  let mut i = 0
  while i < exponent and i < 30 { value = value * 2 i = i + 1 }
  value
}

pub(package) fn native_link_mach_section_is_admitted_data(bytes: i64, len: i64, section: i64) -> i64 {
  let data_name = bytes_match_str_at(bytes, len, section, "__data") == 1 or
    bytes_match_str_at(bytes, len, section, "__bss") == 1 or
    bytes_match_str_at(bytes, len, section, "__const") == 1
  let text_constant = bytes_match_str_at(bytes, len, section, "__const") == 1 or
    bytes_match_str_at(bytes, len, section, "__cstring") == 1 or
    bytes_match_str_at(bytes, len, section, "__literal4") == 1 or
    bytes_match_str_at(bytes, len, section, "__literal8") == 1 or
    bytes_match_str_at(bytes, len, section, "__literal16") == 1
  if bytes_match_str_at(bytes, len, section + 16, "__DATA") == 1 and data_name { 1 }
  else {
    if bytes_match_str_at(bytes, len, section + 16, "__DATA_CONST") == 1 and data_name { 1 }
    else {
      if bytes_match_str_at(bytes, len, section + 16, "__TEXT") == 1 and text_constant { 1 }
      else { 0 }
    }
  }
}

pub(package) fn native_link_object_data_sections_valid(data: List<NativeLinkObjectDataSection>, len: i64) -> i64 {
  match data {
    Nil -> 1
    Cons(entry, rest) -> {
      let valid = match entry {
        NativeLinkMachDataZeroFill(data_addr, data_size, data_align, data_section, reloff, nreloc) -> {
          if data_size >= 0 and data_align <= 20 and reloff >= 0 and reloff + nreloc * 8 <= len { 1 } else { 0 }
        }
        NativeLinkMachDataBytes(data_addr, data_size, data_offset, data_align, data_section, reloff, nreloc) -> {
          if data_size >= 0 and data_align <= 20 and data_offset >= 0 and data_offset + data_size <= len and
            reloff >= 0 and reloff + nreloc * 8 <= len { 1 } else { 0 }
        }
        NativeLinkElfDataZeroFill(data_addr, data_size, data_align, data_section, relaoff, nrela) -> {
          if data_size >= 0 and data_align <= 20 and relaoff >= 0 and relaoff + nrela * 24 <= len { 1 } else { 0 }
        }
        NativeLinkElfDataBytes(data_addr, data_size, data_offset, data_align, data_section, relaoff, nrela) -> {
          if data_size >= 0 and data_align <= 20 and data_offset >= 0 and data_offset + data_size <= len and
            relaoff >= 0 and relaoff + nrela * 24 <= len { 1 } else { 0 }
        }
      }
      if valid == 1 { native_link_object_data_sections_valid(rest, len) } else { 0 }
    }
  }
}

-- Parse the object facts the shared closure needs. Debug/unwind sections stay
-- in the object view for later preservation work; executable text and the
-- admitted initialized, constant, and zerofill sections retain their exact
-- section identities and alignments.
pub(package) fn native_link_mach_object_parse(bytes: i64, len: i64) -> NativeLinkMachObjectParse {
  if len < 32 or bytes_u32_le_at(bytes, len, 0, 0) != 4277009103 or
    bytes_u32_le_at(bytes, len, 4, 0) != 16777228 or bytes_u32_le_at(bytes, len, 12, 0) != 1 {
    NativeLinkMachObjectMalformed
  } else {
    let command_count = bytes_u32_le_at(bytes, len, 16, 0)
    let command_end = 32 + bytes_u32_le_at(bytes, len, 20, 0)
    let mut cursor = 32
    let mut command_index = 0
    let mut malformed = command_end > len
    let mut text_offset = 0 - 1
    let mut text_addr = 0
    let mut text_size = 0
    let mut text_align = 0
    let mut text_reloff = 0
    let mut text_nreloc = 0
    let mut text_section = 0
    let mut symoff = 0 - 1
    let mut nsyms = 0
    let mut stroff = 0 - 1
    let mut strsize = 0
    let mut data = list_nil<NativeLinkObjectDataSection>()
    while command_index < command_count and malformed == false {
      let command = bytes_u32_le_at(bytes, command_end, cursor, 0 - 1)
      let command_size = bytes_u32_le_at(bytes, command_end, cursor + 4, 0)
      if command_size < 8 or cursor + command_size > command_end { malformed = true }
      else {
        if command == 25 {
          let section_count = bytes_u32_le_at(bytes, command_end, cursor + 64, 0)
          if command_size < 72 + section_count * 80 { malformed = true }
          else {
            let mut section_index = 0
            while section_index < section_count {
              let section = cursor + 72 + section_index * 80
              if bytes_match_str_at(bytes, len, section, "__text") == 1 and bytes_match_str_at(bytes, len, section + 16, "__TEXT") == 1 {
                text_addr = bytes_u64_le_at(bytes, len, section + 32, 0)
                text_size = bytes_u64_le_at(bytes, len, section + 40, 0 - 1)
                text_offset = bytes_u32_le_at(bytes, len, section + 48, 0 - 1)
                text_align = bytes_u32_le_at(bytes, len, section + 52, 0)
                text_reloff = bytes_u32_le_at(bytes, len, section + 56, 0)
                text_nreloc = bytes_u32_le_at(bytes, len, section + 60, 0)
                text_section = section_index + 1
              } else {
                if native_link_mach_section_is_admitted_data(bytes, len, section) == 1 {
                  let data_addr = bytes_u64_le_at(bytes, len, section + 32, 0)
                  let data_size = bytes_u64_le_at(bytes, len, section + 40, 0 - 1)
                  let data_offset = bytes_u32_le_at(bytes, len, section + 48, 0 - 1)
                  let data_align = bytes_u32_le_at(bytes, len, section + 52, 0)
                  let data_reloff = bytes_u32_le_at(bytes, len, section + 56, 0)
                  let data_nreloc = bytes_u32_le_at(bytes, len, section + 60, 0)
                  let data_flags = bytes_u32_le_at(bytes, len, section + 64, 0)
                  let admitted = if data_flags band 255 == 1 {
                    NativeLinkMachDataZeroFill(data_addr, data_size, data_align, section_index + 1, data_reloff, data_nreloc)
                  } else {
                    NativeLinkMachDataBytes(data_addr, data_size, data_offset, data_align, section_index + 1, data_reloff, data_nreloc)
                  }
                  data = list_append<NativeLinkObjectDataSection>(data, admitted)
                } else { 0 }
              }
              section_index = section_index + 1
            }
          }
        } else {
          if command == 2 {
            if command_size < 24 { malformed = true }
            else {
              symoff = bytes_u32_le_at(bytes, len, cursor + 8, 0 - 1)
              nsyms = bytes_u32_le_at(bytes, len, cursor + 12, 0)
              stroff = bytes_u32_le_at(bytes, len, cursor + 16, 0 - 1)
              strsize = bytes_u32_le_at(bytes, len, cursor + 20, 0)
            }
          } else { 0 }
        }
        cursor = cursor + command_size
        command_index = command_index + 1
      }
    }
    if malformed or text_offset < 0 or text_size < 0 or text_offset + text_size > len or
      text_align > 20 or text_reloff < 0 or text_reloff + text_nreloc * 8 > len or
      symoff < 0 or symoff + nsyms * 16 > len or stroff < 0 or stroff + strsize > len {
      NativeLinkMachObjectMalformed
    } else {
      if native_link_object_data_sections_valid(data, len) == 0 { NativeLinkMachObjectMalformed }
      else { NativeLinkMachObjectParsed(NativeLinkMachObject(
        bytes, len, text_offset, text_addr, text_size, text_align, text_reloff,
        text_nreloc, text_section, symoff, nsyms, stroff, strsize, data
      )) }
    }
  }
}

pub(package) fn native_link_u16_le_at(bytes: i64, len: i64, offset: i64, fallback: i64) -> i64 {
  if offset < 0 or offset + 2 > len { fallback }
  else { bytes_u8_at(bytes, len, offset, 0) + bytes_u8_at(bytes, len, offset + 1, 0) * 256 }
}

pub(package) fn native_link_power_of_two_exponent(value: i64) -> i64 {
  if value <= 1 { 0 }
  else {
    let mut power = 1
    let mut exponent = 0
    while power < value and exponent < 30 {
      power = power * 2
      exponent = exponent + 1
    }
    if power == value { exponent } else { 0 - 1 }
  }
}

