-- compiler/package_diagnostics.weft -- structured package/link diagnostics

use compiler/lib.{*}
use compiler/package.{*}
use runtime/buffer.{*}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic_registry.{*}
use stdlib/diagnostic_type.{*}

pub(package) fn package_diagnostic_dependency_name(path_ptr: i64, path_len: i64) -> str {
  let name_len = pkg_import_first_segment_len(path_ptr, path_len)
  let actual_len = if name_len > 0 { name_len } else { path_len }
  runtime_str_from_bytes_copy(path_ptr, actual_len)
}

pub(package) fn package_diagnostic_code(status: i64) -> DiagnosticCode {
  if status == pkg_resolve_status_malformed_manifest() { diagnostic_code_package_manifest_malformed() }
  else { if status == pkg_resolve_status_name_mismatch() { diagnostic_code_package_name_mismatch() }
  else { if status == pkg_resolve_status_source_conflict() { diagnostic_code_package_source_conflict() }
  else { if status == pkg_resolve_status_dependency_cycle() { diagnostic_code_package_dependency_cycle() }
  else { if status == pkg_resolve_status_malformed_lock() { diagnostic_code_package_lock_malformed() }
  else { if status == pkg_resolve_status_lock_mismatch() { diagnostic_code_package_lock_mismatch() }
  else { if status == pkg_resolve_status_dependency_trust_grant() { diagnostic_code_package_dependency_trust_grant() }
  else { DiagnosticCodeUnassigned } } } } } } }
}

pub(package) fn package_diagnostic_problem(status: i64) -> str {
  if status == pkg_resolve_status_malformed_manifest() { "has a malformed manifest" }
  else { if status == pkg_resolve_status_name_mismatch() { "does not match the package name in its manifest" }
  else { if status == pkg_resolve_status_source_conflict() { "resolves to conflicting source identities" }
  else { if status == pkg_resolve_status_dependency_cycle() { "forms a package dependency cycle" }
  else { if status == pkg_resolve_status_malformed_lock() { "is blocked by a malformed or unsupported package lock" }
  else { if status == pkg_resolve_status_lock_mismatch() { "does not match the identity recorded in weft.lock" }
  else { if status == pkg_resolve_status_dependency_trust_grant() { "attempts to grant package trust from a dependency manifest" }
  else { "could not be resolved" } } } } } } }
}

pub(package) fn package_diagnostic_message(status: i64, dependency: str) -> str {
  let problem = package_diagnostic_problem(status)
  let b = buf_new(__str_len(dependency) + __str_len(problem) + 20)
  bstr(b, "dependency '")
  bstr(b, dependency)
  bstr(b, "' ")
  bstr(b, problem)
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn package_diagnose_resolve_failure(status: i64, source: i64, path_ptr: i64, path_len: i64, source_offset: i64) -[Diagnose]> i64 {
  if status == pkg_resolve_status_unsafe_path() { 0 }
  else {
    let dependency = package_diagnostic_dependency_name(path_ptr, path_len)
    let name_len = __str_len(dependency)
    diagnostic_report(diagnostic_new(
      DiagnosticSeverityError,
      DiagnosticClassLink,
      package_diagnostic_code(status),
      package_diagnostic_message(status, dependency),
      DiagnosticSourceRange(DiagnosticSourceBuffer(source), source_offset, source_offset + name_len),
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(
        DiagnosticFieldText("dependency", dependency),
        DiagnosticFieldCons(DiagnosticFieldI64("resolver_status", status), DiagnosticFieldNil)
      )
    ))
  }
}

pub(package) fn package_binding_trust_message(package_name: str, module: str) -> str {
  let b = buf_new(__str_len(package_name) + __str_len(module) + 72)
  bstr(b, "binding module '")
  bstr(b, module)
  bstr(b, "' in package '")
  bstr(b, package_name)
  bstr(b, "' lacks an exact root trust grant")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn package_diagnose_binding_trust_failure(tt: i64, package_id: i64, source: i64, module_ptr: i64, module_len: i64, source_offset: i64) -[Diagnose]> i64 {
  let identity = pkg_identity_find_id(tt, package_id)
  let package_name = if identity == 0 { "<unknown>" } else { pkg_str_view(pkg_identity_name_ptr(identity), pkg_identity_name_len(identity)) }
  let module = runtime_str_from_bytes_copy(module_ptr, module_len)
  diagnostic_report(diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassLink,
    diagnostic_code_package_binding_trust_mismatch(),
    package_binding_trust_message(package_name, module),
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), source_offset, source_offset + module_len),
    DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(
      DiagnosticFieldText("package", package_name),
      DiagnosticFieldCons(DiagnosticFieldText("module", module), DiagnosticFieldNil)
    )
  ))
}

pub(package) fn package_native_target_message(module: str, target: str) -> str {
  let b = buf_new(__str_len(module) + __str_len(target) + 68)
  bstr(b, "native binding '")
  bstr(b, module)
  bstr(b, "' has no declaration for compilation target '")
  bstr(b, target)
  bstr(b, "'")
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn package_diagnose_native_target_missing(source: i64, module_ptr: i64, module_len: i64, source_offset: i64) -[Diagnose]> i64 {
  let module = runtime_str_from_bytes_copy(module_ptr, module_len)
  let target = pkg_native_target_name(pkg_native_compilation_target())
  diagnostic_report(diagnostic_new(
    DiagnosticSeverityError,
    DiagnosticClassLink,
    diagnostic_code_native_binding_target_missing(),
    package_native_target_message(module, target),
    DiagnosticSourceRange(DiagnosticSourceBuffer(source), source_offset, source_offset + module_len),
    DiagnosticRelatedLocationNil,
    DiagnosticFieldCons(
      DiagnosticFieldText("module", module),
      DiagnosticFieldCons(DiagnosticFieldText("target", target), DiagnosticFieldNil)
    )
  ))
}
