-- compiler/tool/console.weft -- best-effort report streams for tool commands
--
-- Tool reports and diagnostics are best effort: a command whose standard
-- streams are gone still reports through its exit status.

use stdlib/console as console
use stdlib/console.{ConsoleWrite}

--- Report a line on standard error.
pub(package) fn tool_note(text: str) -[ConsoleWrite]> nil {
  console.try_eprint(text)
  nil
}

--- Write output on standard output.
pub(package) fn tool_print(text: str) -[ConsoleWrite]> nil {
  console.try_print(text)
  nil
}
