-- compiler/package.weft -- local package manifest parsing and import roots
--
-- Manifest format:
--   {"package":"app_name","manifest_version":1,"version":"0.1.0",
--    "weft":"0.1","dependencies":{"package_name":"relative/path"}}
--
-- The legacy line-oriented format remains readable for compatibility:
--   package app_name
--   dep package_name relative/path
--
-- The resolver maps `use package_name/file.{*}` to
-- `relative/path/file.weft` when a matching local dep exists. Its result also
-- carries the owning package and package-relative logical module path; the
-- physical path is provenance, never semantic module identity.

use compiler/lib.{*}
use compiler/package_lock_data.{*}
use compiler/product_identity.{weft_language_version, weft_manifest_schema_version, weft_native_binding_abi_version}
use compiler/type_registry.{ttable_get_root_manifest, ttable_mark_native_binding_source, ttable_native_compilation_target, ttable_set_root_manifest}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{*}
use runtime/syscall.{*}
use stdlib/file.{FileRead, FileWrite, file_atomic_replace_text, file_create_new_text, file_read_text}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/path.{Path, path_from_utf8}
use stdlib/result.{Err, Ok, Result}
use stdlib/string.{*}

-- Native binding metadata is manifest-owned semantic data. The parser keeps a
-- compact storage form, while these exact variants are the typed fact surface
-- consumed by validation, lowering, audit and documentation. ABI v1 is a
-- deliberately small synchronous C boundary: no callbacks, variadics,
-- managed aggregates or exceptions can be represented here.
pub(package) type NativeBindingTarget {
  NativeMacosAarch64,
  NativeLinuxAarch64
}

pub(package) type NativeLibraryKind {
  NativeSystemLibrary,
  NativeDynamicLibrary,
  NativeArchiveLibrary
}

pub(package) type NativeLibraryLicense {
  NativeLibraryLicenseDeclared(str),
  NativeLibraryLicenseUnspecified
}

pub(package) type NativeAbiType {
  NativeAbiNil,
  NativeAbiI8,
  NativeAbiU8,
  NativeAbiI16,
  NativeAbiU16,
  NativeAbiI32,
  NativeAbiU32,
  NativeAbiI64,
  NativeAbiU64,
  NativeAbiIsize,
  NativeAbiUsize,
  NativeAbiF32,
  NativeAbiF64,
  NativeAbiOpaquePointer,
  NativeAbiConstPointer,
  NativeAbiMutPointer,
  NativeAbiConstBytes,
  NativeAbiMutBytes
}

pub(package) type NativeLibraryFact {
  NativeLibraryFact(str, NativeLibraryKind, str, List<str>, str, NativeLibraryLicense, bool)
}

pub(package) type NativeSymbolFact {
  NativeSymbolFact(str, str, str, List<NativeAbiType>, NativeAbiType, bool)
}

pub(package) type NativeTargetFact {
  NativeTargetFact(NativeBindingTarget, List<NativeLibraryFact>, List<NativeSymbolFact>)
}

pub(package) type NativeBindingFact {
  NativeBindingFact(str, i64, List<NativeTargetFact>)
}

pub(package) fn pkg_manifest_package_start(m: i64) -> i64 { mem_load64_at(m, 0) }
pub(package) fn pkg_manifest_package_len(m: i64) -> i64 { mem_load64_at(m, 8) }
pub(package) fn pkg_manifest_deps(m: i64) -> i64 { mem_load64_at(m, 16) }
pub(package) fn pkg_manifest_error_count(m: i64) -> i64 { mem_load64_at(m, 24) }
pub(package) fn pkg_manifest_version_ptr(m: i64) -> i64 { mem_load64_at(m, 32) }
pub(package) fn pkg_manifest_version_len(m: i64) -> i64 { mem_load64_at(m, 40) }
pub(package) fn pkg_manifest_weft_ptr(m: i64) -> i64 { mem_load64_at(m, 48) }
pub(package) fn pkg_manifest_weft_len(m: i64) -> i64 { mem_load64_at(m, 56) }
pub(package) fn pkg_manifest_schema_version(m: i64) -> i64 { mem_load64_at(m, 64) }
pub(package) fn pkg_manifest_trusted_bindings(m: i64) -> i64 { mem_load64_at(m, 72) }
pub(package) fn pkg_manifest_trust_grants(m: i64) -> i64 { mem_load64_at(m, 80) }
pub(package) fn pkg_manifest_exports(m: i64) -> i64 { mem_load64_at(m, 88) }
pub(package) fn pkg_manifest_native_bindings(m: i64) -> i64 { mem_load64_at(m, 96) }

pub(package) fn pkg_manifest_new() -> i64 {
  let m = alloc_zeroed(104)
  let language = weft_language_version()
  mem_store64_at(m, 16, nlist_new())
  mem_store64_at(m, 32, __str_ptr("0.0.0+local"))
  mem_store64_at(m, 40, __str_len("0.0.0+local"))
  mem_store64_at(m, 48, __str_ptr(language))
  mem_store64_at(m, 56, __str_len(language))
  mem_store64_at(m, 64, weft_manifest_schema_version())
  mem_store64_at(m, 72, nlist_new())
  mem_store64_at(m, 80, nlist_new())
  mem_store64_at(m, 88, nlist_new())
  mem_store64_at(m, 96, nlist_new())
  m
}

pub(package) fn pkg_manifest_add_error(m: i64) -> i64 {
  mem_store64_at(m, 24, pkg_manifest_error_count(m) + 1)
  m
}

pub(package) fn pkg_is_space(ch: i64) -> i64 {
  match ch {
    32 -> 1
    9 -> 1
    13 -> 1
    _ -> 0
  }
}

pub(package) fn pkg_skip_spaces(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  while i < n and pkg_is_space(mem_load8_at(src, i)) == 1 {
    i = i + 1
  }
  i
}

pub(package) fn pkg_skip_line(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    if mem_load8_at(src, i) == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if i < n and mem_load8_at(src, i) == 10 { i + 1 } else { i }
}

pub(package) fn pkg_read_token_end(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    let ch = mem_load8_at(src, i)
    if pkg_is_space(ch) == 1 or ch == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  i
}

pub(package) fn pkg_line_has_trailing_token(src: i64, n: i64, p: i64) -> i64 {
  let q = pkg_skip_spaces(src, n, p)
  if q >= n { 0 }
  else {
    let ch = mem_load8_at(src, q)
    if ch == 10 or ch == 35 { 0 } else { 1 }
  }
}

pub(package) fn pkg_bytes_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  src_eq(src, start, len, s)
}

pub(package) fn pkg_bytes_eq_at(a_ptr: i64, a_start: i64, a_len: i64, b_ptr: i64, b_start: i64, b_len: i64) -> i64 {
  if a_len != b_len { 0 }
  else { src_eq_at(a_ptr, a_start, b_ptr + b_start, 0, a_len) }
}

pub(package) fn pkg_str_view(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

pub(package) fn pkg_name_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      let ch = mem_load8_at(src, start + i)
      if ch == 47 or ch == 92 or ch == 46 {
        ok = 0
      } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_version_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      let ch = mem_load8_at(src, start + i)
      let allowed = if is_alnum(ch) == 1 { 1 }
        else { if ch == 46 or ch == 43 or ch == 45 { 1 } else { 0 } }
      if allowed == 0 { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_path_segment_is_dotdot(src: i64, start: i64, len: i64) -> i64 {
  if len == 2 {
    if mem_load8_at(src, start) == 46 {
      if mem_load8_at(src, start + 1) == 46 { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
}

pub(package) fn pkg_path_is_safe(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let first = mem_load8_at(src, start)
    if first == 47 or first == 126 { 0 }
    else {
      let mut i = 0
      let mut seg_start = 0
      let mut ok = 1
      while i <= len {
        if i == len or mem_load8_at(src, start + i) == 47 {
          let seg_len = i - seg_start
          if seg_len <= 0 or pkg_path_segment_is_dotdot(src, start + seg_start, seg_len) == 1 {
            ok = 0
          } else { 0 }
          seg_start = i + 1
        } else { 0 }
        i = i + 1
      }
      ok
    }
  }
}

pub(package) fn pkg_module_path_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let first = mem_load8_at(src, start)
    if first == 47 or first == 126 { 0 }
    else {
      let mut i = 0
      let mut segment_start = 0
      let mut ok = 1
      while i <= len {
        if i == len or mem_load8_at(src, start + i) == 47 {
          let segment_len = i - segment_start
          if segment_len <= 0 or pkg_name_is_valid(src, start + segment_start, segment_len) == 0 {
            ok = 0
          } else { 0 }
          segment_start = i + 1
        } else { 0 }
        i = i + 1
      }
      if len >= 5 and src_eq_at(src, start + len - 5, __str_ptr(".weft"), 0, 5) == 1 { 0 } else { ok }
    }
  }
}

-- Manifest text entries are stable copied ptr/len pairs. Trust data outlives
-- the temporary managed JSON tree used to parse it.
pub(package) fn pkg_manifest_text_new(value: str) -> i64 {
  let entry = alloc_words(2)
  mem_store64_at(entry, 0, pkg_lock_copy_text(value))
  mem_store64_at(entry, 8, __str_len(value))
  entry
}

pub(package) fn pkg_manifest_text_ptr(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_manifest_text_len(entry: i64) -> i64 { mem_load64_at(entry, 8) }
pub(package) fn pkg_manifest_text(entry: i64) -> str { pkg_str_view(pkg_manifest_text_ptr(entry), pkg_manifest_text_len(entry)) }

pub(package) fn pkg_manifest_text_list_contains(entries: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(pkg_manifest_text_ptr(entry), 0, pkg_manifest_text_len(entry), ptr, 0, len) == 1 { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_manifest_text_list_add_module(entries: i64, module: str) -> i64 {
  if pkg_module_path_is_valid(__str_ptr(module), 0, __str_len(module)) == 0 or pkg_manifest_text_list_contains(entries, __str_ptr(module), __str_len(module)) == 1 { 1 }
  else {
    nlist_add(entries, pkg_manifest_text_new(module))
    0
  }
}

pub(package) fn pkg_manifest_trusted_binding_count(m: i64) -> i64 { nlist_len(pkg_manifest_trusted_bindings(m)) }
pub(package) fn pkg_manifest_trust_grant_count(m: i64) -> i64 { nlist_len(pkg_manifest_trust_grants(m)) }

pub(package) fn pkg_manifest_declares_trusted_binding(m: i64, module_ptr: i64, module_len: i64) -> i64 {
  pkg_manifest_text_list_contains(pkg_manifest_trusted_bindings(m), module_ptr, module_len)
}

-- Trust grant layout: package/version/source/content ptr/len pairs plus module
-- list = 72 bytes. Grants are root-only authority facts.
pub(package) fn pkg_trust_grant_new(name: str, version: str, source: str, content: str, modules: i64) -> i64 {
  let grant = alloc_words(9)
  mem_store64_at(grant, 0, pkg_lock_copy_text(name))
  mem_store64_at(grant, 8, __str_len(name))
  mem_store64_at(grant, 16, pkg_lock_copy_text(version))
  mem_store64_at(grant, 24, __str_len(version))
  mem_store64_at(grant, 32, pkg_lock_copy_text(source))
  mem_store64_at(grant, 40, __str_len(source))
  mem_store64_at(grant, 48, pkg_lock_copy_text(content))
  mem_store64_at(grant, 56, __str_len(content))
  mem_store64_at(grant, 64, modules)
  grant
}

pub(package) fn pkg_trust_grant_name_ptr(grant: i64) -> i64 { mem_load64_at(grant, 0) }
pub(package) fn pkg_trust_grant_name_len(grant: i64) -> i64 { mem_load64_at(grant, 8) }
pub(package) fn pkg_trust_grant_version_ptr(grant: i64) -> i64 { mem_load64_at(grant, 16) }
pub(package) fn pkg_trust_grant_version_len(grant: i64) -> i64 { mem_load64_at(grant, 24) }
pub(package) fn pkg_trust_grant_source_ptr(grant: i64) -> i64 { mem_load64_at(grant, 32) }
pub(package) fn pkg_trust_grant_source_len(grant: i64) -> i64 { mem_load64_at(grant, 40) }
pub(package) fn pkg_trust_grant_content_ptr(grant: i64) -> i64 { mem_load64_at(grant, 48) }
pub(package) fn pkg_trust_grant_content_len(grant: i64) -> i64 { mem_load64_at(grant, 56) }
pub(package) fn pkg_trust_grant_modules(grant: i64) -> i64 { mem_load64_at(grant, 64) }

pub(package) fn pkg_manifest_find_trust_grant(m: i64, name_ptr: i64, name_len: i64) -> i64 {
  let grants = pkg_manifest_trust_grants(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(grants) and found == 0 {
    let grant = nlist_get(grants, i)
    if pkg_bytes_eq_at(pkg_trust_grant_name_ptr(grant), 0, pkg_trust_grant_name_len(grant), name_ptr, 0, name_len) == 1 { found = grant }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_trust_grant_names_module(grant: i64, module_ptr: i64, module_len: i64) -> i64 {
  if grant == 0 { 0 } else { pkg_manifest_text_list_contains(pkg_trust_grant_modules(grant), module_ptr, module_len) }
}

pub(package) fn pkg_native_target_macos_aarch64() -> i64 { 1 }
pub(package) fn pkg_native_target_linux_aarch64() -> i64 { 2 }

-- Manifest selection follows the same sealed host fact as native lowering.
-- This integer is retained only at the legacy manifest-storage boundary;
-- ordinary target consumers match NativeLinkTarget or NativeBindingTarget.
pub(package) fn pkg_native_compilation_target() -> i64 { sys_native_host_target() }

pub(package) fn pkg_native_compilation_target_for_table(tt: i64) -> i64 {
  let selected = ttable_native_compilation_target(tt)
  if selected > 0 { selected } else { pkg_native_compilation_target() }
}

pub(package) fn pkg_native_target_from_name(name: str) -> i64 {
  if str_eq(name, "macos-aarch64") == 1 { pkg_native_target_macos_aarch64() }
  else { if str_eq(name, "linux-aarch64") == 1 { pkg_native_target_linux_aarch64() } else { 0 - 1 } }
}

pub(package) fn pkg_native_target_name(target: i64) -> str {
  if target == pkg_native_target_macos_aarch64() { "macos-aarch64" }
  else { if target == pkg_native_target_linux_aarch64() { "linux-aarch64" } else { "" } }
}

pub(package) fn pkg_native_target_fact(target: i64) -> NativeBindingTarget {
  if target == pkg_native_target_linux_aarch64() { NativeLinuxAarch64 } else { NativeMacosAarch64 }
}

pub(package) fn pkg_native_library_kind_system() -> i64 { 1 }
pub(package) fn pkg_native_library_kind_dynamic() -> i64 { 2 }
pub(package) fn pkg_native_library_kind_archive() -> i64 { 3 }

pub(package) fn pkg_native_library_kind_from_name(name: str) -> i64 {
  if str_eq(name, "system") == 1 { pkg_native_library_kind_system() }
  else { if str_eq(name, "dynamic") == 1 { pkg_native_library_kind_dynamic() }
  else { if str_eq(name, "archive") == 1 { pkg_native_library_kind_archive() } else { 0 - 1 } } }
}

pub(package) fn pkg_native_library_kind_name(kind: i64) -> str {
  if kind == pkg_native_library_kind_system() { "system" }
  else { if kind == pkg_native_library_kind_dynamic() { "dynamic" }
  else { if kind == pkg_native_library_kind_archive() { "archive" } else { "" } } }
}

pub(package) fn pkg_native_library_kind_fact(kind: i64) -> NativeLibraryKind {
  if kind == pkg_native_library_kind_dynamic() { NativeDynamicLibrary }
  else { if kind == pkg_native_library_kind_archive() { NativeArchiveLibrary } else { NativeSystemLibrary } }
}

pub(package) fn pkg_native_abi_nil() -> i64 { 0 }
pub(package) fn pkg_native_abi_i8() -> i64 { 1 }
pub(package) fn pkg_native_abi_u8() -> i64 { 2 }
pub(package) fn pkg_native_abi_i16() -> i64 { 3 }
pub(package) fn pkg_native_abi_u16() -> i64 { 4 }
pub(package) fn pkg_native_abi_i32() -> i64 { 5 }
pub(package) fn pkg_native_abi_u32() -> i64 { 6 }
pub(package) fn pkg_native_abi_i64() -> i64 { 7 }
pub(package) fn pkg_native_abi_u64() -> i64 { 8 }
pub(package) fn pkg_native_abi_isize() -> i64 { 9 }
pub(package) fn pkg_native_abi_usize() -> i64 { 10 }
pub(package) fn pkg_native_abi_f32() -> i64 { 11 }
pub(package) fn pkg_native_abi_f64() -> i64 { 12 }
pub(package) fn pkg_native_abi_opaque_pointer() -> i64 { 13 }
pub(package) fn pkg_native_abi_const_pointer() -> i64 { 14 }
pub(package) fn pkg_native_abi_mut_pointer() -> i64 { 15 }
pub(package) fn pkg_native_abi_const_bytes() -> i64 { 16 }
pub(package) fn pkg_native_abi_mut_bytes() -> i64 { 17 }

pub(package) fn pkg_native_abi_type_from_name(name: str) -> i64 {
  if str_eq(name, "nil") == 1 { pkg_native_abi_nil() }
  else { if str_eq(name, "i8") == 1 { pkg_native_abi_i8() }
  else { if str_eq(name, "u8") == 1 { pkg_native_abi_u8() }
  else { if str_eq(name, "i16") == 1 { pkg_native_abi_i16() }
  else { if str_eq(name, "u16") == 1 { pkg_native_abi_u16() }
  else { if str_eq(name, "i32") == 1 { pkg_native_abi_i32() }
  else { if str_eq(name, "u32") == 1 { pkg_native_abi_u32() }
  else { if str_eq(name, "i64") == 1 { pkg_native_abi_i64() }
  else { if str_eq(name, "u64") == 1 { pkg_native_abi_u64() }
  else { if str_eq(name, "isize") == 1 { pkg_native_abi_isize() }
  else { if str_eq(name, "usize") == 1 { pkg_native_abi_usize() }
  else { if str_eq(name, "f32") == 1 { pkg_native_abi_f32() }
  else { if str_eq(name, "f64") == 1 { pkg_native_abi_f64() }
  else { if str_eq(name, "opaque_ptr") == 1 { pkg_native_abi_opaque_pointer() }
  else { if str_eq(name, "const_ptr") == 1 { pkg_native_abi_const_pointer() }
  else { if str_eq(name, "mut_ptr") == 1 { pkg_native_abi_mut_pointer() }
  else { if str_eq(name, "const_bytes") == 1 { pkg_native_abi_const_bytes() }
  else { if str_eq(name, "mut_bytes") == 1 { pkg_native_abi_mut_bytes() }
  else { 0 - 1 } } } } } } } } } } } } } } } } } }
}

pub(package) fn pkg_native_abi_type_name(kind: i64) -> str {
  match kind {
    0 -> "nil"
    1 -> "i8"
    2 -> "u8"
    3 -> "i16"
    4 -> "u16"
    5 -> "i32"
    6 -> "u32"
    7 -> "i64"
    8 -> "u64"
    9 -> "isize"
    10 -> "usize"
    11 -> "f32"
    12 -> "f64"
    13 -> "opaque_ptr"
    14 -> "const_ptr"
    15 -> "mut_ptr"
    16 -> "const_bytes"
    17 -> "mut_bytes"
    _ -> ""
  }
}

pub(package) fn pkg_native_abi_type_fact(kind: i64) -> NativeAbiType {
  match kind {
    1 -> NativeAbiI8
    2 -> NativeAbiU8
    3 -> NativeAbiI16
    4 -> NativeAbiU16
    5 -> NativeAbiI32
    6 -> NativeAbiU32
    7 -> NativeAbiI64
    8 -> NativeAbiU64
    9 -> NativeAbiIsize
    10 -> NativeAbiUsize
    11 -> NativeAbiF32
    12 -> NativeAbiF64
    13 -> NativeAbiOpaquePointer
    14 -> NativeAbiConstPointer
    15 -> NativeAbiMutPointer
    16 -> NativeAbiConstBytes
    17 -> NativeAbiMutBytes
    _ -> NativeAbiNil
  }
}

pub(package) fn pkg_native_link_name_is_valid(name: str) -> i64 {
  let len = __str_len(name)
  if len <= 0 { 0 }
  else {
    let first = mem_load8_at(__str_ptr(name), 0)
    if is_alpha(first) == false and first != 95 { 0 }
    else {
      let mut i = 1
      let mut ok = 1
      while i < len {
        let ch = mem_load8_at(__str_ptr(name), i)
        if is_alnum(ch) == false and ch != 95 and ch != 45 and ch != 46 { ok = 0 } else { 0 }
        i = i + 1
      }
      ok
    }
  }
}

pub(package) fn pkg_native_search_path_is_valid(path: str) -> i64 {
  if str_eq(path, "toolchain") == 1 { 1 }
  else { pkg_path_is_safe(__str_ptr(path), 0, __str_len(path)) }
}

-- Native module storage: module ptr/len, ABI version, target list.
pub(package) fn pkg_native_binding_new(module: str, abi: i64, targets: i64) -> i64 {
  let entry = alloc_words(4)
  mem_store64_at(entry, 0, pkg_lock_copy_text(module))
  mem_store64_at(entry, 8, __str_len(module))
  mem_store64_at(entry, 16, abi)
  mem_store64_at(entry, 24, targets)
  entry
}
pub(package) fn pkg_native_binding_module_ptr(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_native_binding_module_len(entry: i64) -> i64 { mem_load64_at(entry, 8) }
pub(package) fn pkg_native_binding_abi(entry: i64) -> i64 { mem_load64_at(entry, 16) }
pub(package) fn pkg_native_binding_targets(entry: i64) -> i64 { mem_load64_at(entry, 24) }
pub(package) fn pkg_manifest_native_binding_count(m: i64) -> i64 { nlist_len(pkg_manifest_native_bindings(m)) }

pub(package) fn pkg_manifest_find_native_binding(m: i64, module_ptr: i64, module_len: i64) -> i64 {
  let entries = pkg_manifest_native_bindings(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(pkg_native_binding_module_ptr(entry), 0, pkg_native_binding_module_len(entry), module_ptr, 0, module_len) == 1 { found = entry }
    else { i = i + 1 }
  }
  found
}

-- Target storage: target kind, library list, symbol list.
pub(package) fn pkg_native_target_new(target: i64, libraries: i64, symbols: i64) -> i64 {
  let entry = alloc_words(3)
  mem_store64_at(entry, 0, target)
  mem_store64_at(entry, 8, libraries)
