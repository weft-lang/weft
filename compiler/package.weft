    let mut grants = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(grants) == 0 {
      let entry = list_first_or<JsonEntry>(grants, json_entry("", json_null()))
      if pkg_manifest_fill_trust_grant(m, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 }
      grants = list_rest_or_nil<JsonEntry>(grants)
    }
    failed
  }
}

pub(package) fn pkg_native_keys_exact(value: Json, keys: List<str>, wanted: i64) -> i64 {
  if json_kind(value) != 5 or json_object_len(value) != wanted or list_len<str>(keys) != wanted { 0 }
  else {
    let mut entries = json_object_entries(value)
    let mut ok = 1
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      let key = json_entry_key(entry)
      let mut allowed = 0
      let mut remaining = keys
      while list_empty<str>(remaining) == 0 {
        if str_eq(key, list_first_or<str>(remaining, "")) == 1 { allowed = 1 } else { 0 }
        remaining = list_rest_or_nil<str>(remaining)
      }
      if allowed == 0 or pkg_lock_json_key_count(value, key) != 1 { ok = 0 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    let mut required = keys
    while list_empty<str>(required) == 0 {
      if pkg_lock_json_key_count(value, list_first_or<str>(required, "")) != 1 { ok = 0 } else { 0 }
      required = list_rest_or_nil<str>(required)
    }
    ok
  }
}

