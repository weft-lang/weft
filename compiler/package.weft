-- compiler/package.weft -- local package manifest parsing and import roots
--
-- MVP manifest format:
--   package app_name
--   dep package_name relative/path
--
-- The resolver maps `use "package_name/file.weft"` to
-- `relative/path/file.weft` when a matching local dep exists.

use "compiler/lib.weft"
use "runtime/alloc.weft"
use "runtime/buffer.weft"
use "runtime/memory.weft"
use "runtime/syscall.weft"

fn pkg_manifest_package_start(m: i64) -> i64 { __mem_load64(m) }
fn pkg_manifest_package_len(m: i64) -> i64 { __mem_load64(m + 8) }
fn pkg_manifest_deps(m: i64) -> i64 { __mem_load64(m + 16) }
fn pkg_manifest_error_count(m: i64) -> i64 { __mem_load64(m + 24) }

fn pkg_manifest_new() -> i64 {
  let m = alloc_bump(32)
  __mem_store64(m, 0)
  __mem_store64(m + 8, 0)
  __mem_store64(m + 16, nlist_new())
  __mem_store64(m + 24, 0)
  m
}

fn pkg_manifest_add_error(m: i64) -> i64 {
  __mem_store64(m + 24, pkg_manifest_error_count(m) + 1)
  m
}

fn pkg_is_space(ch: i64) -> i64 {
  match ch {
    32 -> 1
    9 -> 1
    13 -> 1
    _ -> 0
  }
}

fn pkg_skip_spaces(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  while i < n and pkg_is_space(__mem_load8(src + i)) == 1 {
    i = i + 1
  }
  i
}

fn pkg_skip_line(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    if __mem_load8(src + i) == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if i < n and __mem_load8(src + i) == 10 { i + 1 } else { i }
}

fn pkg_read_token_end(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    let ch = __mem_load8(src + i)
    if pkg_is_space(ch) == 1 or ch == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  i
}

fn pkg_line_has_trailing_token(src: i64, n: i64, p: i64) -> i64 {
  let q = pkg_skip_spaces(src, n, p)
  if q >= n { 0 }
  else {
    let ch = __mem_load8(src + q)
    if ch == 10 or ch == 35 { 0 } else { 1 }
  }
}

fn pkg_bytes_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  src_eq(src, start, len, s)
}

fn pkg_bytes_eq_at(a_ptr: i64, a_start: i64, a_len: i64, b_ptr: i64, b_start: i64, b_len: i64) -> i64 {
  if a_len != b_len { 0 }
  else { src_eq_at(a_ptr, a_start, b_ptr + b_start, 0, a_len) }
}

fn pkg_name_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      let ch = __mem_load8(src + start + i)
      if ch == 47 or ch == 92 or ch == 46 {
        ok = 0
      } else { 0 }
      i = i + 1
    }
    ok
  }
}

fn pkg_path_segment_is_dotdot(src: i64, start: i64, len: i64) -> i64 {
  if len == 2 {
    if __mem_load8(src + start) == 46 {
      if __mem_load8(src + start + 1) == 46 { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
}

fn pkg_path_is_safe(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let first = __mem_load8(src + start)
    if first == 47 or first == 126 { 0 }
    else {
      let mut i = 0
      let mut seg_start = 0
      let mut ok = 1
      while i <= len {
        if i == len or __mem_load8(src + start + i) == 47 {
          let seg_len = i - seg_start
          if seg_len <= 0 or pkg_path_segment_is_dotdot(src, start + seg_start, seg_len) == 1 {
            ok = 0
          } else { 0 }
          seg_start = i + 1
        } else { 0 }
        i = i + 1
      }
      ok
    }
  }
}

fn pkg_dep_new(name_start: i64, name_len: i64, path_start: i64, path_len: i64, src: i64) -> i64 {
  let d = alloc_bump(40)
  __mem_store64(d, name_start)
  __mem_store64(d + 8, name_len)
  __mem_store64(d + 16, path_start)
  __mem_store64(d + 24, path_len)
  __mem_store64(d + 32, src)
  d
}

fn pkg_dep_name_start(d: i64) -> i64 { __mem_load64(d) }
fn pkg_dep_name_len(d: i64) -> i64 { __mem_load64(d + 8) }
fn pkg_dep_path_start(d: i64) -> i64 { __mem_load64(d + 16) }
fn pkg_dep_path_len(d: i64) -> i64 { __mem_load64(d + 24) }
fn pkg_dep_src(d: i64) -> i64 { __mem_load64(d + 32) }

fn pkg_manifest_dep_count(m: i64) -> i64 {
  nlist_len(pkg_manifest_deps(m))
}

fn pkg_manifest_find_dep(m: i64, name_ptr: i64, name_len: i64) -> i64 {
  let deps = pkg_manifest_deps(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(deps) {
    let dep = nlist_get(deps, i)
    let dep_src = pkg_dep_src(dep)
    if pkg_bytes_eq_at(dep_src, pkg_dep_name_start(dep), pkg_dep_name_len(dep), name_ptr, 0, name_len) == 1 {
      found = dep
      i = nlist_len(deps)
    } else {
      i = i + 1
    }
  }
  found
}

fn pkg_manifest_has_dep(m: i64, name: str) -> i64 {
  if pkg_manifest_find_dep(m, __str_ptr(name), __str_len(name)) == 0 { 0 } else { 1 }
}

fn pkg_manifest_dep_path_eq(m: i64, name: str, expected: str) -> i64 {
  let dep = pkg_manifest_find_dep(m, __str_ptr(name), __str_len(name))
  if dep == 0 { 0 }
  else {
    let dep_src = pkg_dep_src(dep)
    pkg_bytes_eq_at(dep_src, pkg_dep_path_start(dep), pkg_dep_path_len(dep), __str_ptr(expected), 0, __str_len(expected))
  }
}

fn pkg_manifest_package_eq(m: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_manifest_package_start(m), 0, pkg_manifest_package_len(m), __str_ptr(expected), 0, __str_len(expected))
}

fn pkg_manifest_set_package(m: i64, src: i64, name_start: i64, name_len: i64) -> i64 {
  if pkg_manifest_package_len(m) != 0 {
    pkg_manifest_add_error(m)
  } else {
    if pkg_name_is_valid(src, name_start, name_len) == 0 {
      pkg_manifest_add_error(m)
    } else {
      __mem_store64(m, src + name_start)
      __mem_store64(m + 8, name_len)
    }
  }
  m
}

fn pkg_manifest_add_dep(m: i64, src: i64, name_start: i64, name_len: i64, path_start: i64, path_len: i64) -> i64 {
  let existing = pkg_manifest_find_dep(m, src + name_start, name_len)
  if existing != 0 {
    pkg_manifest_add_error(m)
  } else {
    if pkg_name_is_valid(src, name_start, name_len) == 0 or pkg_path_is_safe(src, path_start, path_len) == 0 {
      pkg_manifest_add_error(m)
    } else {
      nlist_add(pkg_manifest_deps(m), pkg_dep_new(name_start, name_len, path_start, path_len, src))
    }
  }
  m
}

fn pkg_manifest_add_dep_from_parts(m: i64, name_ptr: i64, name_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  if pkg_manifest_find_dep(m, name_ptr, name_len) != 0 { 1 }
  else {
    if pkg_name_is_valid(name_ptr, 0, name_len) == 0 or pkg_path_is_safe(path_ptr, 0, path_len) == 0 { 1 }
    else {
      let src = alloc_bump(name_len + path_len + 1)
      mem_copy(src, name_ptr, name_len)
      __mem_store8(src + name_len, 10)
      mem_copy(src + name_len + 1, path_ptr, path_len)
      nlist_add(pkg_manifest_deps(m), pkg_dep_new(0, name_len, name_len + 1, path_len, src))
      0
    }
  }
}

fn pkg_manifest_parse_line(m: i64, src: i64, n: i64, p: i64) -> i64 {
  let start = pkg_skip_spaces(src, n, p)
  if start >= n { n }
  else {
    let first = __mem_load8(src + start)
    if first == 10 { start + 1 }
    else { if first == 35 { pkg_skip_line(src, n, start) }
    else {
      let key_end = pkg_read_token_end(src, n, start)
      let key_len = key_end - start
      let arg1_start = pkg_skip_spaces(src, n, key_end)
      let arg1_end = pkg_read_token_end(src, n, arg1_start)
      let arg1_len = arg1_end - arg1_start
      if pkg_bytes_eq(src, start, key_len, "package") == 1 {
        if arg1_len <= 0 or pkg_line_has_trailing_token(src, n, arg1_end) == 1 {
          pkg_manifest_add_error(m)
        } else {
          pkg_manifest_set_package(m, src, arg1_start, arg1_len)
        }
      } else { if pkg_bytes_eq(src, start, key_len, "dep") == 1 {
        let arg2_start = pkg_skip_spaces(src, n, arg1_end)
        let arg2_end = pkg_read_token_end(src, n, arg2_start)
        let arg2_len = arg2_end - arg2_start
        if arg1_len <= 0 or arg2_len <= 0 or pkg_line_has_trailing_token(src, n, arg2_end) == 1 {
          pkg_manifest_add_error(m)
        } else {
          pkg_manifest_add_dep(m, src, arg1_start, arg1_len, arg2_start, arg2_len)
        }
      } else {
        pkg_manifest_add_error(m)
      } }
      pkg_skip_line(src, n, start)
    } }
  }
}

fn pkg_manifest_parse(src: i64, n: i64) -> i64 {
  let m = pkg_manifest_new()
  let mut p = 0
  while p < n {
    p = pkg_manifest_parse_line(m, src, n, p)
  }
  m
}

fn pkg_manifest_parse_str(src: str) -> i64 {
  pkg_manifest_parse(__str_ptr(src), __str_len(src))
}

fn pkg_manifest_file_path() -> i64 {
  let path = alloc_bump(16)
  __mem_store64(path, __str_ptr("weft.pkg"))
  __mem_store64(path + 8, __str_len("weft.pkg"))
  path
}

fn pkg_manifest_load_default() -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let ptr = __mem_load64(file)
  let len = __mem_load64(file + 8)
  if len <= 0 { pkg_manifest_new() } else { pkg_manifest_parse(ptr, len) }
}

fn pkg_import_first_segment_len(path_ptr: i64, path_len: i64) -> i64 {
  let mut i = 0
  let mut done = 0
  while i < path_len and done == 0 {
    if __mem_load8(path_ptr + i) == 47 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if done == 1 { i } else { 0 }
}

fn pkg_resolve_result(ptr: i64, len: i64, status: i64) -> i64 {
  let r = alloc_bump(24)
  __mem_store64(r, ptr)
  __mem_store64(r + 8, len)
  __mem_store64(r + 16, status)
  r
}

fn pkg_resolve_ptr(r: i64) -> i64 { __mem_load64(r) }
fn pkg_resolve_len(r: i64) -> i64 { __mem_load64(r + 8) }
fn pkg_resolve_status(r: i64) -> i64 { __mem_load64(r + 16) }

fn pkg_resolve_path_eq(r: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_resolve_ptr(r), 0, pkg_resolve_len(r), __str_ptr(expected), 0, __str_len(expected))
}

fn pkg_cache_path_for_parts(name_ptr: i64, name_len: i64, suffix_ptr: i64, suffix_len: i64) -> i64 {
  let b = buf_new(name_len + suffix_len + 16)
  bstr(b, ".weft/cache/")
  bscopy(b, name_ptr, name_len, 0)
  bu8(b, 47)
  bscopy(b, suffix_ptr, suffix_len, 0)
  pkg_resolve_result(buf_ptr(b), buf_len(b), 1)
}

fn pkg_cache_path_for_import(path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 { pkg_resolve_result(path_ptr, path_len, 0) }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result(path_ptr, path_len, 0 - 1)
    } else {
      pkg_cache_path_for_parts(path_ptr, seg_len, path_ptr + suffix_start, suffix_len)
    }
  }
}

fn pkg_cache_path_eq(import_path: str, expected: str) -> i64 {
  let r = pkg_cache_path_for_import(__str_ptr(import_path), __str_len(import_path))
  if pkg_resolve_status(r) != 1 { 0 }
  else { pkg_resolve_path_eq(r, expected) }
}

fn pkg_file_exists(path: i64) -> i64 {
  let file = read_file(path)
  if __mem_load64(file + 8) > 0 { 1 } else { 0 }
}

fn pkg_manifest_resolve_import(m: i64, path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 { pkg_resolve_result(path_ptr, path_len, 0) }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result(path_ptr, path_len, 0 - 1)
    } else {
      let dep = pkg_manifest_find_dep(m, path_ptr, seg_len)
      if dep == 0 {
        pkg_resolve_result(path_ptr, path_len, 0)
      } else {
        let dep_src = pkg_dep_src(dep)
        let dep_path_len = pkg_dep_path_len(dep)
        let cache = pkg_cache_path_for_parts(path_ptr, seg_len, path_ptr + suffix_start, suffix_len)
        if pkg_file_exists(cache) == 1 {
          pkg_resolve_result(pkg_resolve_ptr(cache), pkg_resolve_len(cache), 2)
        } else {
          let b = buf_new(dep_path_len + suffix_len + 2)
          bscopy(b, dep_src + pkg_dep_path_start(dep), dep_path_len, 0)
          bu8(b, 47)
          bscopy(b, path_ptr + suffix_start, suffix_len, 0)
          pkg_resolve_result(buf_ptr(b), buf_len(b), 1)
        }
      }
    }
  }
}

fn pkg_resolve_default_import(path_ptr: i64, path_len: i64) -> i64 {
  let manifest = pkg_manifest_load_default()
  pkg_manifest_resolve_import(manifest, path_ptr, path_len)
}

fn pkg_write_file(path: i64, data_ptr: i64, data_len: i64) -> i64 {
  let path_ptr = __mem_load64(path)
  let path_len = __mem_load64(path + 8)
  let path_buf = alloc_bump(path_len + 1)
  mem_copy(path_buf, path_ptr, path_len)
  __mem_store8(path_buf + path_len, 0)
  let fd = sys_open(path_buf, 1537, 420)
  if fd < 0 { 1 }
  else {
    let written = sys_write(fd, data_ptr, data_len)
    sys_close(fd)
    if written == data_len { 0 } else { 1 }
  }
}

fn pkg_manifest_render_into(b: i64, m: i64) -> i64 {
  if pkg_manifest_package_len(m) > 0 {
    bstr(b, "package ")
    bscopy(b, pkg_manifest_package_start(m), pkg_manifest_package_len(m), 0)
    bu8(b, 10)
  } else { 0 }
  let deps = pkg_manifest_deps(m)
  for i in 0..nlist_len(deps) {
    let dep = nlist_get(deps, i)
    let dep_src = pkg_dep_src(dep)
    bstr(b, "dep ")
    bscopy(b, dep_src + pkg_dep_name_start(dep), pkg_dep_name_len(dep), 0)
    bu8(b, 32)
    bscopy(b, dep_src + pkg_dep_path_start(dep), pkg_dep_path_len(dep), 0)
    bu8(b, 10)
  }
  buf_len(b)
}

fn pkg_manifest_rendered_eq(m: i64, expected: str) -> i64 {
  let b = buf_new(256)
  pkg_manifest_render_into(b, m)
  pkg_bytes_eq_at(buf_ptr(b), 0, buf_len(b), __str_ptr(expected), 0, __str_len(expected))
}

fn pkg_stdout(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

fn pkg_stderr(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}

fn pkg_cli_init(name_ptr: i64, name_len: i64) -> i64 {
  if pkg_name_is_valid(name_ptr, 0, name_len) == 0 {
    pkg_stderr("pkg: invalid package name\n")
    1
  } else {
    let existing = read_file(pkg_manifest_file_path())
    if __mem_load64(existing + 8) > 0 {
      pkg_stderr("pkg: weft.pkg already exists\n")
      1
    } else {
      let b = buf_new(name_len + 16)
      bstr(b, "package ")
      bscopy(b, name_ptr, name_len, 0)
      bu8(b, 10)
      if pkg_write_file(pkg_manifest_file_path(), buf_ptr(b), buf_len(b)) == 0 {
        pkg_stdout("pkg: wrote weft.pkg\n")
        0
      } else {
        pkg_stderr("pkg: could not write weft.pkg\n")
        1
      }
    }
  }
}

fn pkg_cli_add(name_ptr: i64, name_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let src = __mem_load64(file)
  let len = __mem_load64(file + 8)
  if len <= 0 {
    pkg_stderr("pkg: missing weft.pkg\n")
    1
  } else {
    let manifest = pkg_manifest_parse(src, len)
    if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_len(manifest) <= 0 {
      pkg_stderr("pkg: malformed weft.pkg\n")
      1
    } else {
      let added = pkg_manifest_add_dep_from_parts(manifest, name_ptr, name_len, path_ptr, path_len)
      if added != 0 {
        pkg_stderr("pkg: invalid or duplicate dependency\n")
        1
      } else {
        let b = buf_new(len + name_len + path_len + 32)
        pkg_manifest_render_into(b, manifest)
        if pkg_write_file(pkg_manifest_file_path(), buf_ptr(b), buf_len(b)) == 0 {
          pkg_stdout("pkg: added dependency\n")
          0
        } else {
          pkg_stderr("pkg: could not write weft.pkg\n")
          1
        }
      }
    }
  }
}
