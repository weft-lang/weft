pub(package) fn pkg_native_fill_search(m: i64, value: Json, kind: i64) -> i64 {
  let search = nlist_new()
  if json_kind(value) != 4 or json_array_len(value) <= 0 { pkg_manifest_add_error(m) 0 }
  else {
    let mut items = json_array_items(value)
    let mut failed = 0
    while list_empty<Json>(items) == 0 {
      let item = list_first_or<Json>(items, json_null())
      if json_kind(item) != 3 { failed = 1 }
      else {
        let path = json_string_value(item, "")
        let valid = pkg_native_search_path_is_valid(path)
        let system_valid = if kind == pkg_native_library_kind_system() { str_eq(path, "toolchain") } else { if str_eq(path, "toolchain") == 1 { 0 } else { 1 } }
        if valid == 0 or system_valid == 0 or pkg_manifest_text_list_contains(search, __str_ptr(path), __str_len(path)) == 1 { failed = 1 }
        else { nlist_add(search, pkg_manifest_text_new(path)) }
      }
      items = list_rest_or_nil<Json>(items)
    }
    if failed == 1 { pkg_manifest_add_error(m) 0 } else { search }
  }
}

pub(package) fn pkg_native_fill_library(m: i64, target: i64, value: Json) -> i64 {
  let has_license = pkg_lock_json_key_count(value, "license") == 1
  let shape_valid = if has_license { pkg_native_keys_exact(value, pkg_native_library_keys_with_license(), 7) }
    else { pkg_native_keys_exact(value, pkg_native_library_keys(), 6) }
  if shape_valid == 0 { pkg_manifest_add_error(m) 1 }
  else {
    let id_value = json_option_value_or(json_object_get(value, "id"), json_null())
    let kind_value = json_option_value_or(json_object_get(value, "kind"), json_null())
    let link_value = json_option_value_or(json_object_get(value, "link"), json_null())
    let search_value = json_option_value_or(json_object_get(value, "search"), json_null())
    let content_value = json_option_value_or(json_object_get(value, "content"), json_null())
    let license_value = json_option_value_or(json_object_get(value, "license"), json_null())
    let optional_value = json_option_value_or(json_object_get(value, "optional"), json_null())
    if json_kind(id_value) != 3 or json_kind(kind_value) != 3 or json_kind(link_value) != 3 or json_kind(content_value) != 3 or
      (has_license and json_kind(license_value) != 3) or json_kind(optional_value) != 1 {
      pkg_manifest_add_error(m)
      1
    } else {
      let id = json_string_value(id_value, "")
      let kind = pkg_native_library_kind_from_name(json_string_value(kind_value, ""))
      let link = json_string_value(link_value, "")
      let content = json_string_value(content_value, "")
      let license = if has_license { json_string_value(license_value, "") } else { "" }
      let optional = json_bool_value(optional_value, 0 - 1)
      let search = if kind < 0 { 0 } else { pkg_native_fill_search(m, search_value, kind) }
      let content_ok = if kind == pkg_native_library_kind_system() { str_eq(content, "toolchain") }
        else { pkg_lock_content_valid(content) }
      if pkg_identifier_is_valid(__str_ptr(id), 0, __str_len(id)) == 0 or
        pkg_native_target_find_library(target, __str_ptr(id), __str_len(id)) != 0 or
        kind < 0 or pkg_native_link_name_is_valid(link) == 0 or search == 0 or
        content_ok == 0 or (has_license and __str_len(license) == 0) or (optional != 0 and optional != 1) {
        pkg_manifest_add_error(m)
        1
      } else {
        nlist_add(pkg_native_target_libraries(target), pkg_native_library_new(id, kind, link, search, content, license, optional))
        0
      }
    }
  }
}

pub(package) fn pkg_native_fill_libraries(m: i64, target: i64, value: Json) -> i64 {
  if json_kind(value) != 4 or json_array_len(value) <= 0 { pkg_manifest_add_error(m) 1 }
  else {
    let mut items = json_array_items(value)
    let mut failed = 0
    while list_empty<Json>(items) == 0 {
      if pkg_native_fill_library(m, target, list_first_or<Json>(items, json_null())) != 0 { failed = 1 } else { 0 }
      items = list_rest_or_nil<Json>(items)
    }
    failed
  }
}

pub(package) fn pkg_native_target_has_symbol_name(target: i64, symbol: str) -> i64 {
  let entries = pkg_native_target_symbols(target)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(pkg_native_symbol_name_ptr(entry), 0, pkg_native_symbol_name_len(entry), __str_ptr(symbol), 0, __str_len(symbol)) == 1 { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_native_fill_params(m: i64, value: Json) -> i64 {
  let params = nlist_new()
  if json_kind(value) != 4 or json_array_len(value) > 8 { pkg_manifest_add_error(m) 0 }
  else {
    let mut items = json_array_items(value)
    let mut failed = 0
    while list_empty<Json>(items) == 0 {
      let item = list_first_or<Json>(items, json_null())
      if json_kind(item) != 3 { failed = 1 }
      else {
        let kind = pkg_native_abi_type_from_name(json_string_value(item, ""))
        if kind <= pkg_native_abi_nil() { failed = 1 } else { nlist_add(params, kind) }
      }
      items = list_rest_or_nil<Json>(items)
    }
    if failed == 1 { pkg_manifest_add_error(m) 0 } else { params }
  }
}

-- The supported alpha ABI is register-only. Darwin AAPCS64 supplies
-- independent x0..x7 and v0..v7 argument banks; a byte-buffer atom is the
-- semantic (pointer, length) product and therefore consumes two GPR lanes.
pub(package) fn pkg_native_params_fit_register_abi(params: i64) -> i64 {
  if params == 0 { 0 }
  else {
    let mut gpr = 0
    let mut fp = 0
    for i in 0..nlist_len(params) {
      match nlist_get(params, i) {
        11 -> { fp = fp + 1 }
        12 -> { fp = fp + 1 }
        16 -> { gpr = gpr + 2 }
        17 -> { gpr = gpr + 2 }
        _ -> { gpr = gpr + 1 }
      }
    }
    if gpr <= 8 and fp <= 8 { 1 } else { 0 }
  }
}

pub(package) fn pkg_native_fill_symbol(m: i64, target: i64, value: Json) -> i64 {
  if pkg_native_keys_exact(value, pkg_native_symbol_keys(), 6) == 0 { pkg_manifest_add_error(m) 1 }
  else {
    let declaration_value = json_option_value_or(json_object_get(value, "declaration"), json_null())
    let symbol_value = json_option_value_or(json_object_get(value, "symbol"), json_null())
    let library_value = json_option_value_or(json_object_get(value, "library"), json_null())
    let params_value = json_option_value_or(json_object_get(value, "params"), json_null())
    let result_value = json_option_value_or(json_object_get(value, "result"), json_null())
    let optional_value = json_option_value_or(json_object_get(value, "optional"), json_null())
    if json_kind(declaration_value) != 3 or json_kind(symbol_value) != 3 or json_kind(library_value) != 3 or json_kind(result_value) != 3 or json_kind(optional_value) != 1 {
      pkg_manifest_add_error(m)
      1
    } else {
      let declaration = json_string_value(declaration_value, "")
      let symbol = json_string_value(symbol_value, "")
      let library = json_string_value(library_value, "")
      let params = pkg_native_fill_params(m, params_value)
      let result = pkg_native_abi_type_from_name(json_string_value(result_value, ""))
      let optional = json_bool_value(optional_value, 0 - 1)
      let library_entry = pkg_native_target_find_library(target, __str_ptr(library), __str_len(library))
      let optional_ok = if library_entry != 0 and pkg_native_library_optional(library_entry) == 1 { optional == 1 } else { 1 }
      if pkg_identifier_is_valid(__str_ptr(declaration), 0, __str_len(declaration)) == 0 or
        pkg_native_target_find_symbol(target, __str_ptr(declaration), __str_len(declaration)) != 0 or
        pkg_native_link_name_is_valid(symbol) == 0 or pkg_native_target_has_symbol_name(target, symbol) == 1 or
        library_entry == 0 or params == 0 or pkg_native_params_fit_register_abi(params) == 0 or result < pkg_native_abi_nil() or
        result == pkg_native_abi_const_pointer() or result == pkg_native_abi_mut_pointer() or
        result == pkg_native_abi_const_bytes() or result == pkg_native_abi_mut_bytes() or
        (optional != 0 and optional != 1) or optional_ok == 0 {
        pkg_manifest_add_error(m)
        1
      } else {
        nlist_add(pkg_native_target_symbols(target), pkg_native_symbol_new(declaration, symbol, library, params, result, optional))
        0
      }
    }
  }
}

pub(package) fn pkg_native_fill_symbols(m: i64, target: i64, value: Json) -> i64 {
  if json_kind(value) != 4 or json_array_len(value) <= 0 { pkg_manifest_add_error(m) 1 }
  else {
    let mut items = json_array_items(value)
    let mut failed = 0
    while list_empty<Json>(items) == 0 {
      if pkg_native_fill_symbol(m, target, list_first_or<Json>(items, json_null())) != 0 { failed = 1 } else { 0 }
      items = list_rest_or_nil<Json>(items)
    }
    failed
  }
}

pub(package) fn pkg_native_fill_target(m: i64, binding: i64, name: str, value: Json) -> i64 {
  let target_kind = pkg_native_target_from_name(name)
  if target_kind < 0 or pkg_native_binding_find_target(binding, target_kind) != 0 or pkg_native_keys_exact(value, pkg_native_target_keys(), 2) == 0 {
    pkg_manifest_add_error(m)
    1
  } else {
    let target = pkg_native_target_new(target_kind, nlist_new(), nlist_new())
    let libraries = json_option_value_or(json_object_get(value, "libraries"), json_null())
    let symbols = json_option_value_or(json_object_get(value, "symbols"), json_null())
    let libraries_failed = pkg_native_fill_libraries(m, target, libraries)
    let symbols_failed = if libraries_failed == 0 { pkg_native_fill_symbols(m, target, symbols) } else { 1 }
    if libraries_failed != 0 or symbols_failed != 0 { 1 }
    else { nlist_add(pkg_native_binding_targets(binding), target) 0 }
  }
}

pub(package) fn pkg_native_fill_binding(m: i64, module: str, value: Json) -> i64 {
  if pkg_module_path_is_valid(__str_ptr(module), 0, __str_len(module)) == 0 or
    pkg_manifest_declares_trusted_binding(m, __str_ptr(module), __str_len(module)) == 0 or
    pkg_manifest_find_native_binding(m, __str_ptr(module), __str_len(module)) != 0 or
    pkg_native_keys_exact(value, pkg_native_binding_keys(), 2) == 0 {
    pkg_manifest_add_error(m)
    1
  } else {
    let abi_value = json_option_value_or(json_object_get(value, "abi_version"), json_null())
    let targets_value = json_option_value_or(json_object_get(value, "targets"), json_null())
    if json_kind(abi_value) != 2 or json_number_value(abi_value, 0) != weft_native_binding_abi_version() or json_kind(targets_value) != 5 or json_object_len(targets_value) <= 0 {
      pkg_manifest_add_error(m)
      1
    } else {
      let binding = pkg_native_binding_new(module, weft_native_binding_abi_version(), nlist_new())
      let mut targets = json_object_entries(targets_value)
      let mut failed = 0
      while list_empty<JsonEntry>(targets) == 0 {
        let entry = list_first_or<JsonEntry>(targets, json_entry("", json_null()))
        if pkg_lock_json_key_count(targets_value, json_entry_key(entry)) != 1 or pkg_native_fill_target(m, binding, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 }
        targets = list_rest_or_nil<JsonEntry>(targets)
      }
      if failed == 1 { 1 } else { nlist_add(pkg_manifest_native_bindings(m), binding) 0 }
    }
  }
}

pub(package) fn pkg_manifest_fill_native_bindings(m: i64, value: Json) -> i64 {
  if json_kind(value) != 5 or json_object_len(value) <= 0 { pkg_manifest_add_error(m) 1 }
  else {
    let mut entries = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_lock_json_key_count(value, json_entry_key(entry)) != 1 {
        pkg_manifest_add_error(m)
        failed = 1
      } else { if pkg_native_fill_binding(m, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 } }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    failed
  }
}

pub(package) fn pkg_export_entry_key_allowed(key: str, kind: i64) -> i64 {
  if str_eq(key, "module") == 1 or str_eq(key, "declaration") == 1 { 1 }
  else { if kind == pkg_export_kind_grammar() and str_eq(key, "execution") == 1 { 1 } else { 0 } }
}

pub(package) fn pkg_export_entry_keys_valid(value: Json, kind: i64) -> i64 {
  let wanted = if kind == pkg_export_kind_grammar() { 3 } else { 2 }
  if json_kind(value) != 5 or json_object_len(value) != wanted { 0 }
  else {
    let mut entries = json_object_entries(value)
    let mut ok = 1
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_export_entry_key_allowed(json_entry_key(entry), kind) == 0 { ok = 0 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    if pkg_lock_json_key_count(value, "module") != 1 or pkg_lock_json_key_count(value, "declaration") != 1 { 0 }
    else { if kind == pkg_export_kind_grammar() and pkg_lock_json_key_count(value, "execution") != 1 { 0 } else { ok } }
  }
}

pub(package) fn pkg_manifest_fill_export_entry(m: i64, kind: i64, name: str, value: Json) -> i64 {
  if pkg_identifier_is_valid(__str_ptr(name), 0, __str_len(name)) == 0 or pkg_manifest_find_export(m, kind, __str_ptr(name), __str_len(name)) != 0 or pkg_export_entry_keys_valid(value, kind) == 0 {
    pkg_manifest_add_error(m)
    1
  } else {
    let module_value = json_option_value_or(json_object_get(value, "module"), json_null())
    let declaration_value = json_option_value_or(json_object_get(value, "declaration"), json_null())
    let execution_value = if kind == pkg_export_kind_grammar() { json_option_value_or(json_object_get(value, "execution"), json_null()) } else { json_string("") }
    if json_kind(module_value) != 3 or json_kind(declaration_value) != 3 or (kind == pkg_export_kind_grammar() and json_kind(execution_value) != 3) {
      pkg_manifest_add_error(m)
      1
    } else {
      let module = json_string_value(module_value, "")
      let declaration = json_string_value(declaration_value, "")
      let execution = if kind == pkg_export_kind_grammar() { pkg_export_execution_from_name(json_string_value(execution_value, "")) } else { pkg_export_execution_none() }
      if pkg_module_path_is_valid(__str_ptr(module), 0, __str_len(module)) == 0 or pkg_identifier_is_valid(__str_ptr(declaration), 0, __str_len(declaration)) == 0 or execution < 0 {
        pkg_manifest_add_error(m)
        1
      } else {
        nlist_add(pkg_manifest_exports(m), pkg_export_new(kind, name, module, declaration, execution))
        0
      }
    }
  }
}

pub(package) fn pkg_manifest_fill_export_kind(m: i64, kind: i64, value: Json) -> i64 {
  if json_kind(value) != 5 {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut entries = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_manifest_fill_export_entry(m, kind, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    failed
  }
}

pub(package) fn pkg_manifest_fill_exports(m: i64, value: Json) -> i64 {
  if json_kind(value) != 5 {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut entries = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      let key = json_entry_key(entry)
      if str_eq(key, "grammars") == 1 {
        if pkg_lock_json_key_count(value, "grammars") != 1 {
          pkg_manifest_add_error(m)
          failed = 1
        } else { if pkg_manifest_fill_export_kind(m, pkg_export_kind_grammar(), json_entry_value(entry)) != 0 { failed = 1 } else { 0 } }
      } else { if str_eq(key, "tools") == 1 {
        if pkg_lock_json_key_count(value, "tools") != 1 {
          pkg_manifest_add_error(m)
          failed = 1
        } else { if pkg_manifest_fill_export_kind(m, pkg_export_kind_tool(), json_entry_value(entry)) != 0 { failed = 1 } else { 0 } }
      } else {
        pkg_manifest_add_error(m)
        failed = 1
      } }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    failed
  }
}

pub(package) fn pkg_manifest_fill_from_json(m: i64, root: Json) -> i64 {
  if json_kind(root) != 5 {
    pkg_manifest_add_error(m)
    m
  } else {
    pkg_manifest_validate_json_keys(m, root)
    let package_opt = json_object_get(root, "package")
    if json_option_is_some(package_opt) == 1 {
      let package_value = json_option_value_or(package_opt, json_null())
      if json_kind(package_value) != 3 {
        pkg_manifest_add_error(m)
      } else {
        let name = json_string_value(package_value, "")
        pkg_manifest_set_package(m, __str_ptr(name), 0, __str_len(name))
      }
    } else { 0 }

    let schema_opt = json_object_get(root, "manifest_version")
    if json_option_is_some(schema_opt) == 1 {
      let schema_value = json_option_value_or(schema_opt, json_null())
      if json_kind(schema_value) != 2 or json_number_value(schema_value, 0) != weft_manifest_schema_version() {
        pkg_manifest_add_error(m)
      } else { mem_store64_at(m, 64, weft_manifest_schema_version()) }
    } else { 0 }

    let version_opt = json_object_get(root, "version")
    if json_option_is_some(version_opt) == 1 {
      let version_value = json_option_value_or(version_opt, json_null())
      if json_kind(version_value) != 3 { pkg_manifest_add_error(m) }
      else {
        let version = json_string_value(version_value, "")
        pkg_manifest_set_version(m, __str_ptr(version), __str_len(version))
      }
    } else { 0 }

    let weft_opt = json_object_get(root, "weft")
    if json_option_is_some(weft_opt) == 1 {
      let weft_value = json_option_value_or(weft_opt, json_null())
      if json_kind(weft_value) != 3 { pkg_manifest_add_error(m) }
      else {
        let weft_version = json_string_value(weft_value, "")
        pkg_manifest_set_weft(m, __str_ptr(weft_version), __str_len(weft_version))
      }
    } else { 0 }

    let deps_opt = json_object_get(root, "dependencies")
    if json_option_is_some(deps_opt) == 1 {
      let deps_value = json_option_value_or(deps_opt, json_null())
      if json_kind(deps_value) != 5 {
        pkg_manifest_add_error(m)
      } else {
        let mut deps = json_object_entries(deps_value)
        while list_empty<JsonEntry>(deps) == 0 {
          let dep_entry = list_first_or<JsonEntry>(deps, json_entry("", json_null()))
          let dep_name = json_entry_key(dep_entry)
          let dep_value = json_entry_value(dep_entry)
          if json_kind(dep_value) != 3 {
            pkg_manifest_add_error(m)
          } else {
            let dep_path = json_string_value(dep_value, "")
            let added = pkg_manifest_add_dep_from_parts(m, __str_ptr(dep_name), __str_len(dep_name), __str_ptr(dep_path), __str_len(dep_path))
            if added != 0 { pkg_manifest_add_error(m) } else { 0 }
          }
          deps = list_rest_or_nil<JsonEntry>(deps)
        }
      }
    } else { 0 }

    let bindings_opt = json_object_get(root, "trusted_bindings")
    if json_option_is_some(bindings_opt) == 1 {
      pkg_manifest_fill_module_array(m, json_option_value_or(bindings_opt, json_null()), pkg_manifest_trusted_bindings(m), 0)
    } else { 0 }

    let trust_opt = json_object_get(root, "trust")
    if json_option_is_some(trust_opt) == 1 {
      pkg_manifest_fill_trust(m, json_option_value_or(trust_opt, json_null()))
    } else { 0 }

    let native_bindings_opt = json_object_get(root, "native_bindings")
    if json_option_is_some(native_bindings_opt) == 1 {
      pkg_manifest_fill_native_bindings(m, json_option_value_or(native_bindings_opt, json_null()))
    } else { 0 }

    let exports_opt = json_object_get(root, "exports")
    if json_option_is_some(exports_opt) == 1 {
      pkg_manifest_fill_exports(m, json_option_value_or(exports_opt, json_null()))
    } else { 0 }
    m
  }
}

pub(package) fn pkg_manifest_file_path() -> i64 {
  let path = alloc_words(2)
  mem_store64_at(path, 0, __str_ptr("weft.pkg"))
  mem_store64_at(path, 8, __str_len("weft.pkg"))
  path
}

pub(package) fn pkg_manifest_load_default() -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_manifest_new() } else { pkg_manifest_parse(ptr, len) }
}

pub(package) fn pkg_manifest_load_default_for_table(tt: i64) -> i64 {
  if tt == 0 { pkg_manifest_load_default() }
  else {
    let cached = ttable_get_root_manifest(tt)
    if cached != 0 { cached }
    else {
      let manifest = pkg_manifest_load_default()
      ttable_set_root_manifest(tt, manifest)
      manifest
    }
  }
}

pub(package) fn pkg_import_first_segment_len(path_ptr: i64, path_len: i64) -> i64 {
  let mut i = 0
  let mut done = 0
  while i < path_len and done == 0 {
    if mem_load8_at(path_ptr, i) == 47 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if done == 1 { i } else { 0 }
}

-- `stdlib/` and `runtime/` name the compiler-selected SDK, not package-local
-- directories. Their declaration identity must be shared by every package in
-- a build; resolving them below a dependency root would create counterfeit
-- Drop/effect/type identities and would make ordinary packages unable to use
-- the standard library at all. Visibility and the sealed-Unsafe checker still
-- decide what a package may import or exercise.
pub(package) fn pkg_import_is_sdk_module(path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len == 6 and pkg_bytes_eq_at(path_ptr, 0, seg_len, __str_ptr("stdlib"), 0, 6) == 1 { 1 }
  else { if seg_len == 7 and pkg_bytes_eq_at(path_ptr, 0, seg_len, __str_ptr("runtime"), 0, 7) == 1 { 1 }
  else { 0 } }
}

pub(package) fn pkg_resolve_result(ptr: i64, len: i64, status: i64) -> i64 {
  pkg_resolve_result_in_package(ptr, len, status, 0, ptr, len)
}

pub(package) fn pkg_resolve_result_in_package(ptr: i64, len: i64, status: i64, package_id: i64, logical_ptr: i64, logical_len: i64) -> i64 {
  let r = alloc_zeroed(48)
  mem_store64_at(r, 0, ptr)
  mem_store64_at(r, 8, len)
  mem_store64_at(r, 16, status)
  mem_store64_at(r, 24, package_id)
  mem_store64_at(r, 32, logical_ptr)
  mem_store64_at(r, 40, logical_len)
  r
}

pub(package) fn pkg_resolve_ptr(r: i64) -> i64 { mem_load64_at(r, 0) }
pub(package) fn pkg_resolve_len(r: i64) -> i64 { mem_load64_at(r, 8) }
pub(package) fn pkg_resolve_status(r: i64) -> i64 { mem_load64_at(r, 16) }
pub(package) fn pkg_resolve_package(r: i64) -> i64 { mem_load64_at(r, 24) }
pub(package) fn pkg_resolve_logical_ptr(r: i64) -> i64 { mem_load64_at(r, 32) }
pub(package) fn pkg_resolve_logical_len(r: i64) -> i64 { mem_load64_at(r, 40) }

pub(package) fn pkg_resolve_status_unsafe_path() -> i64 { 0 - 1 }
pub(package) fn pkg_resolve_status_malformed_manifest() -> i64 { 0 - 2 }
pub(package) fn pkg_resolve_status_source_conflict() -> i64 { 0 - 3 }
pub(package) fn pkg_resolve_status_name_mismatch() -> i64 { 0 - 4 }
pub(package) fn pkg_resolve_status_dependency_cycle() -> i64 { 0 - 5 }
pub(package) fn pkg_resolve_status_malformed_lock() -> i64 { 0 - 6 }
pub(package) fn pkg_resolve_status_lock_mismatch() -> i64 { 0 - 7 }
pub(package) fn pkg_resolve_status_dependency_trust_grant() -> i64 { 0 - 8 }

pub(package) fn pkg_resolve_path_eq(r: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_resolve_ptr(r), 0, pkg_resolve_len(r), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_cache_path_for_parts(name_ptr: i64, name_len: i64, suffix_ptr: i64, suffix_len: i64) -> i64 {
  let b = buf_new(name_len + suffix_len + 16)
  bstr(b, ".weft/cache/")
  bscopy(b, name_ptr, name_len, 0)
  bu8(b, 47)
  bscopy(b, suffix_ptr, suffix_len, 0)
  let len = buf_len(b)
  pkg_resolve_result(buf_take_data(b), len, 1)
}

pub(package) fn pkg_cache_path_for_import(path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 { pkg_resolve_result(path_ptr, path_len, 0) }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result(path_ptr, path_len, 0 - 1)
    } else {
      pkg_cache_path_for_parts(path_ptr, seg_len, path_ptr + suffix_start, suffix_len)
    }
  }
}

pub(package) fn pkg_cache_path_eq(import_path: str, expected: str) -> i64 {
  let r = pkg_cache_path_for_import(__str_ptr(import_path), __str_len(import_path))
  if pkg_resolve_status(r) != 1 { 0 }
  else { pkg_resolve_path_eq(r, expected) }
}

pub(package) fn pkg_file_exists(path: i64) -> i64 {
  let file = read_file(path)
  if mem_load64_at(file, 8) > 0 { 1 } else { 0 }
}

pub(package) fn pkg_path_join(root_ptr: i64, root_len: i64, suffix_ptr: i64, suffix_len: i64) -> i64 {
  if root_len <= 0 { pkg_resolve_result(suffix_ptr, suffix_len, 1) }
  else {
    let b = buf_new(root_len + suffix_len + 2)
    bscopy(b, root_ptr, root_len, 0)
    bu8(b, 47)
    bscopy(b, suffix_ptr, suffix_len, 0)
    let len = buf_len(b)
    pkg_resolve_result(buf_take_data(b), len, 1)
  }
}

pub(package) fn pkg_manifest_load_at_root(root_ptr: i64, root_len: i64) -> i64 {
  let manifest_path = pkg_path_join(root_ptr, root_len, __str_ptr("weft.pkg"), __str_len("weft.pkg"))
  let path = alloc_words(2)
  mem_store64_at(path, 0, pkg_resolve_ptr(manifest_path))
  mem_store64_at(path, 8, pkg_resolve_len(manifest_path))
  let file = read_file(path)
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_manifest_new() } else { pkg_manifest_parse(ptr, len) }
}

pub(package) fn pkg_lock_resolver_file_path() -> i64 {
  let path = alloc_words(2)
  mem_store64_at(path, 0, __str_ptr("weft.lock"))
  mem_store64_at(path, 8, __str_len("weft.lock"))
  path
}

pub(package) fn pkg_lock_load_default() -> i64 {
  let file = read_file(pkg_lock_resolver_file_path())
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_lock_data_absent() }
  else { pkg_lock_parse(pkg_str_view(ptr, len)) }
}

pub(package) fn pkg_lock_for_table(tt: i64) -> i64 {
  if tt == 0 { pkg_lock_data_absent() }
  else {
    let cached = mem_load64_at(tt + 152, 0)
    if cached != 0 { cached }
    else {
      let data = pkg_lock_load_default()
      mem_store64_at(tt + 152, 0, data)
      data
    }
  }
}

pub(package) fn pkg_lock_source_identity(root_ptr: i64, root_len: i64) -> str {
  if root_len <= 0 { "path:." }
  else {
    let b = buf_new(root_len + 5)
    bstr(b, "path:")
    bscopy(b, root_ptr, root_len, 0)
    runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
  }
}

-- Returns zero in unlocked mode, the matching lock entry on success, or -1
-- when a present semantic lock does not describe the resolved package.
pub(package) fn pkg_lock_match_package(data: i64, name_ptr: i64, name_len: i64, manifest: i64, source: str) -> i64 {
  if data == 0 or pkg_lock_data_status(data) == 0 { 0 }
  else {
    let entry = pkg_lock_data_find_name(data, name_ptr, name_len)
    if entry == 0 { 0 - 1 }
    else {
      let version_ok = pkg_bytes_eq_at(pkg_lock_entry_version_ptr(entry), 0, pkg_lock_entry_version_len(entry), pkg_manifest_version_ptr(manifest), 0, pkg_manifest_version_len(manifest))
      let source_ok = pkg_bytes_eq_at(pkg_lock_entry_source_ptr(entry), 0, pkg_lock_entry_source_len(entry), __str_ptr(source), 0, __str_len(source))
      let weft_ok = pkg_manifest_weft_eq(manifest, weft_language_version())
      if version_ok == 1 and source_ok == 1 and weft_ok == 1 { entry } else { 0 - 1 }
    }
  }
}

pub(package) fn pkg_manifest_resolve_import(m: i64, path_ptr: i64, path_len: i64) -> i64 {
  pkg_manifest_resolve_import_for_module(m, 0, 0, path_ptr, path_len)
}

pub(package) fn pkg_manifest_resolve_import_for_module(m: i64, tt: i64, importer_package: i64, path_ptr: i64, path_len: i64) -> i64 {
  pkg_manifest_resolve_import_from_root(m, tt, importer_package, 0, 0, path_ptr, path_len)
}

pub(package) fn pkg_manifest_resolve_import_from_root(m: i64, tt: i64, importer_package: i64, owner_root_ptr: i64, owner_root_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 {
    let physical = pkg_path_join(owner_root_ptr, owner_root_len, path_ptr, path_len)
    pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 0, importer_package, path_ptr, path_len)
  }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, 0 - 1, importer_package, path_ptr, path_len)
    } else {
      let dep = pkg_manifest_find_dep(m, path_ptr, seg_len)
      if dep == 0 {
        let physical = pkg_path_join(owner_root_ptr, owner_root_len, path_ptr, path_len)
        pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 0, importer_package, path_ptr, path_len)
      } else {
        let dep_src = pkg_dep_src(dep)
        let dep_path_len = pkg_dep_path_len(dep)
        let dep_root = pkg_path_join(owner_root_ptr, owner_root_len, dep_src + pkg_dep_path_start(dep), dep_path_len)
        let dep_root_ptr = pkg_resolve_ptr(dep_root)
        let dep_root_len = pkg_resolve_len(dep_root)
        let dep_manifest = pkg_manifest_load_at_root(dep_root_ptr, dep_root_len)
        if pkg_manifest_error_count(dep_manifest) > 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_manifest(), importer_package, path_ptr, path_len)
        } else { if pkg_manifest_package_len(dep_manifest) > 0 and pkg_bytes_eq_at(pkg_manifest_package_start(dep_manifest), 0, pkg_manifest_package_len(dep_manifest), path_ptr, 0, seg_len) == 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_name_mismatch(), importer_package, path_ptr, path_len)
        } else { if pkg_manifest_trust_grant_count(dep_manifest) > 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_dependency_trust_grant(), importer_package, path_ptr, path_len)
        } else {
          let existing_package = if tt == 0 { 0 } else { pkg_identity_find_name(tt, path_ptr, seg_len) }
          let closes_cycle = if existing_package == 0 { 0 } else { pkg_identity_is_ancestor(tt, importer_package, mem_load64_at(existing_package, 16)) }
          if closes_cycle == 1 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_dependency_cycle(), importer_package, path_ptr, path_len)
          } else {
          let lock_data = if tt == 0 { 0 } else { mem_load64_at(tt + 152, 0) }
          let lock_entry = pkg_lock_match_package(lock_data, path_ptr, seg_len, dep_manifest, pkg_lock_source_identity(dep_root_ptr, dep_root_len))
          if lock_entry < 0 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_lock_mismatch(), importer_package, path_ptr, path_len)
          } else {
          let content_ptr = if lock_entry == 0 { 0 } else { pkg_lock_entry_content_ptr(lock_entry) }
          let content_len = if lock_entry == 0 { 0 } else { pkg_lock_entry_content_len(lock_entry) }
          let package_id = if tt == 0 { 0 } else { pkg_identity_intern_under_owner_with_content(tt, path_ptr, seg_len, dep_root_ptr, dep_root_len, dep_manifest, importer_package, content_ptr, content_len) }
          if package_id < 0 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_source_conflict(), importer_package, path_ptr, path_len)
          } else {
            let physical = pkg_path_join(dep_root_ptr, dep_root_len, path_ptr + suffix_start, suffix_len)
            pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 1, package_id, path_ptr + suffix_start, suffix_len)
          }
          }
          }
        } } }
      }
    }
  }
}

pub(package) fn pkg_resolve_default_import(tt: i64, importer_package: i64, path_ptr: i64, path_len: i64) -> i64 {
  if importer_package != 0 and pkg_import_is_sdk_module(path_ptr, path_len) == 1 {
    pkg_resolve_result_in_package(path_ptr, path_len, 0, 0, path_ptr, path_len)
  } else { if importer_package == 0 {
    let lock_data = pkg_lock_for_table(tt)
    let manifest = pkg_manifest_load_default_for_table(tt)
    if pkg_lock_data_status(lock_data) < 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_lock(), importer_package, path_ptr, path_len)
    } else {
      let root_lock = pkg_lock_match_package(lock_data, pkg_manifest_package_start(manifest), pkg_manifest_package_len(manifest), manifest, "path:.")
      if root_lock < 0 {
        pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_lock_mismatch(), importer_package, path_ptr, path_len)
      } else {
        let content_ptr = if root_lock == 0 { 0 } else { pkg_lock_entry_content_ptr(root_lock) }
        let content_len = if root_lock == 0 { 0 } else { pkg_lock_entry_content_len(root_lock) }
        pkg_identity_register_root_with_content(tt, manifest, content_ptr, content_len)
        pkg_manifest_resolve_import_from_root(manifest, tt, importer_package, 0, 0, path_ptr, path_len)
      }
    }
  } else {
    let owner = pkg_identity_find_id(tt, importer_package)
    if owner == 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_manifest(), importer_package, path_ptr, path_len)
    } else {
      pkg_manifest_resolve_import_from_root(pkg_identity_manifest(owner), tt, importer_package, pkg_identity_root_ptr(owner), pkg_identity_root_len(owner), path_ptr, path_len)
    }
  } }
}

pub(package) fn pkg_safe_path(text: str) -> Path {
  match path_from_utf8(text) {
    Ok(path) -> path
    Err(error) -> pkg_safe_path("")
  }
}

-- Package metadata and individual source files are deliberately bounded at
-- the public capability boundary. The compiler's import-source loader remains
-- a separate trusted leaf until source acquisition becomes a pipeline effect.
pub(package) fn pkg_safe_read_limit() -> usize { 67108864 }

pub(package) fn pkg_safe_manifest_load_at_root(root: str) -[FileRead]> i64 {
  let joined = pkg_path_join(__str_ptr(root), __str_len(root), __str_ptr("weft.pkg"), __str_len("weft.pkg"))
  let path = pkg_safe_path(pkg_str_view(pkg_resolve_ptr(joined), pkg_resolve_len(joined)))
  match file_read_text(path, pkg_safe_read_limit()) {
    Err(error) -> pkg_manifest_new()
    Ok(text) -> if str_len(text) <= 0 { pkg_manifest_new() }
      else { pkg_manifest_parse(__str_ptr(text), __str_len(text)) }
  }
}

pub(package) fn pkg_manifest_render_into(b: i64, m: i64) -> i64 {
  bstr(b, json_stringify(pkg_manifest_to_json(m)))
  bu8(b, 10)
  buf_len(b)
}

pub(package) fn pkg_manifest_text_list_json(entries: i64) -> Json {
  let mut items: List<Json> = list_nil<Json>()
  let mut i = nlist_len(entries) - 1
  while i >= 0 {
    items = list_cons<Json>(json_string(pkg_manifest_text(nlist_get(entries, i))), items)
    i = i - 1
  }
  json_array(items)
}

pub(package) fn pkg_trust_grant_json(grant: i64) -> Json {
  json_object(
    list_cons<JsonEntry>(json_entry("version", json_string(pkg_str_view(pkg_trust_grant_version_ptr(grant), pkg_trust_grant_version_len(grant)))),
    list_cons<JsonEntry>(json_entry("source", json_string(pkg_str_view(pkg_trust_grant_source_ptr(grant), pkg_trust_grant_source_len(grant)))),
    list_cons<JsonEntry>(json_entry("content", json_string(pkg_str_view(pkg_trust_grant_content_ptr(grant), pkg_trust_grant_content_len(grant)))),
    list_cons<JsonEntry>(json_entry("modules", pkg_manifest_text_list_json(pkg_trust_grant_modules(grant))), list_nil<JsonEntry>()))))
  )
}

pub(package) fn pkg_manifest_trust_json(m: i64) -> Json {
  let grants = pkg_manifest_trust_grants(m)
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  let mut i = nlist_len(grants) - 1
  while i >= 0 {
    let grant = nlist_get(grants, i)
    entries = list_cons<JsonEntry>(json_entry(pkg_str_view(pkg_trust_grant_name_ptr(grant), pkg_trust_grant_name_len(grant)), pkg_trust_grant_json(grant)), entries)
    i = i - 1
  }
  json_object(entries)
}

pub(package) fn pkg_export_json(entry: i64) -> Json {
  let module = pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry))
  let declaration = pkg_str_view(pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry))
  let mut fields = list_cons<JsonEntry>(json_entry("declaration", json_string(declaration)), list_nil<JsonEntry>())
  fields = list_cons<JsonEntry>(json_entry("module", json_string(module)), fields)
  if pkg_export_kind(entry) == pkg_export_kind_grammar() {
    fields = list_append<JsonEntry>(fields, json_entry("execution", json_string(pkg_export_execution_name(pkg_export_execution(entry)))))
  } else { 0 }
  json_object(fields)
}

pub(package) fn pkg_manifest_export_kind_json(m: i64, kind: i64) -> Json {
  let exports = pkg_manifest_exports(m)
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  let mut i = nlist_len(exports) - 1
  while i >= 0 {
    let entry = nlist_get(exports, i)
    if pkg_export_kind(entry) == kind {
      entries = list_cons<JsonEntry>(json_entry(pkg_str_view(pkg_export_name_ptr(entry), pkg_export_name_len(entry)), pkg_export_json(entry)), entries)
    } else { 0 }
    i = i - 1
  }
  json_object(entries)
}

pub(package) fn pkg_manifest_export_kind_count(m: i64, kind: i64) -> i64 {
  let exports = pkg_manifest_exports(m)
  let mut count = 0
  for i in 0..nlist_len(exports) {
    if pkg_export_kind(nlist_get(exports, i)) == kind { count = count + 1 } else { 0 }
  }
  count
}

pub(package) fn pkg_manifest_exports_json(m: i64) -> Json {
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  if pkg_manifest_export_kind_count(m, pkg_export_kind_grammar()) > 0 {
    entries = list_append<JsonEntry>(entries, json_entry("grammars", pkg_manifest_export_kind_json(m, pkg_export_kind_grammar())))
  } else { 0 }
  if pkg_manifest_export_kind_count(m, pkg_export_kind_tool()) > 0 {
    entries = list_append<JsonEntry>(entries, json_entry("tools", pkg_manifest_export_kind_json(m, pkg_export_kind_tool())))
  } else { 0 }
  json_object(entries)
}

pub(package) fn pkg_native_abi_list_json(entries: i64) -> Json {
  let mut values: List<Json> = list_nil<Json>()
  for i in 0..nlist_len(entries) {
    values = list_append<Json>(values, json_string(pkg_native_abi_type_name(nlist_get(entries, i))))
  }
  json_array(values)
}

pub(package) fn pkg_native_library_json(entry: i64) -> Json {
  let mut fields: List<JsonEntry> = list_nil<JsonEntry>()
  fields = list_append<JsonEntry>(fields, json_entry("id", json_string(pkg_str_view(pkg_native_library_id_ptr(entry), pkg_native_library_id_len(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("kind", json_string(pkg_native_library_kind_name(pkg_native_library_kind(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("link", json_string(pkg_str_view(pkg_native_library_link_ptr(entry), pkg_native_library_link_len(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("search", pkg_manifest_text_list_json(pkg_native_library_search(entry))))
  fields = list_append<JsonEntry>(fields, json_entry("content", json_string(pkg_str_view(pkg_native_library_content_ptr(entry), pkg_native_library_content_len(entry)))))
  match pkg_native_library_license_fact(entry) {
    NativeLibraryLicenseDeclared(value) -> { fields = list_append<JsonEntry>(fields, json_entry("license", json_string(value))) 0 }
    NativeLibraryLicenseUnspecified -> 0
  }
  fields = list_append<JsonEntry>(fields, json_entry("optional", json_bool(pkg_native_library_optional(entry))))
  json_object(fields)
}

pub(package) fn pkg_native_symbol_json(entry: i64) -> Json {
  let mut fields: List<JsonEntry> = list_nil<JsonEntry>()
  fields = list_append<JsonEntry>(fields, json_entry("declaration", json_string(pkg_str_view(pkg_native_symbol_declaration_ptr(entry), pkg_native_symbol_declaration_len(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("symbol", json_string(pkg_str_view(pkg_native_symbol_name_ptr(entry), pkg_native_symbol_name_len(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("library", json_string(pkg_str_view(pkg_native_symbol_library_ptr(entry), pkg_native_symbol_library_len(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("params", pkg_native_abi_list_json(pkg_native_symbol_params(entry))))
  fields = list_append<JsonEntry>(fields, json_entry("result", json_string(pkg_native_abi_type_name(pkg_native_symbol_result(entry)))))
  fields = list_append<JsonEntry>(fields, json_entry("optional", json_bool(pkg_native_symbol_optional(entry))))
  json_object(fields)
}

pub(package) fn pkg_native_target_json(entry: i64) -> Json {
  let mut libraries: List<Json> = list_nil<Json>()
  let raw_libraries = pkg_native_target_libraries(entry)
  for i in 0..nlist_len(raw_libraries) { libraries = list_append<Json>(libraries, pkg_native_library_json(nlist_get(raw_libraries, i))) }
  let mut symbols: List<Json> = list_nil<Json>()
  let raw_symbols = pkg_native_target_symbols(entry)
  for i in 0..nlist_len(raw_symbols) { symbols = list_append<Json>(symbols, pkg_native_symbol_json(nlist_get(raw_symbols, i))) }
  list_cons<JsonEntry>(json_entry("libraries", json_array(libraries)), list_cons<JsonEntry>(json_entry("symbols", json_array(symbols)), list_nil<JsonEntry>())) |> json_object
}

pub(package) fn pkg_native_binding_json(entry: i64) -> Json {
  let mut targets: List<JsonEntry> = list_nil<JsonEntry>()
  let raw_targets = pkg_native_binding_targets(entry)
  for i in 0..nlist_len(raw_targets) {
    let target = nlist_get(raw_targets, i)
    targets = list_append<JsonEntry>(targets, json_entry(pkg_native_target_name(pkg_native_target_kind(target)), pkg_native_target_json(target)))
  }
  list_cons<JsonEntry>(json_entry("abi_version", json_number(pkg_native_binding_abi(entry))), list_cons<JsonEntry>(json_entry("targets", json_object(targets)), list_nil<JsonEntry>())) |> json_object
}

pub(package) fn pkg_manifest_native_bindings_json(m: i64) -> Json {
  let mut bindings: List<JsonEntry> = list_nil<JsonEntry>()
  let raw_bindings = pkg_manifest_native_bindings(m)
  for i in 0..nlist_len(raw_bindings) {
    let binding = nlist_get(raw_bindings, i)
    bindings = list_append<JsonEntry>(bindings, json_entry(pkg_str_view(pkg_native_binding_module_ptr(binding), pkg_native_binding_module_len(binding)), pkg_native_binding_json(binding)))
  }
  json_object(bindings)
}

pub(package) fn pkg_manifest_to_json(m: i64) -> Json {
  let mut dep_entries: List<JsonEntry> = list_nil<JsonEntry>()
  let deps = pkg_manifest_deps(m)
  for i in 0..nlist_len(deps) {
    let dep = nlist_get(deps, i)
    let dep_src = pkg_dep_src(dep)
    let name = pkg_str_view(dep_src + pkg_dep_name_start(dep), pkg_dep_name_len(dep))
    let path = pkg_str_view(dep_src + pkg_dep_path_start(dep), pkg_dep_path_len(dep))
    dep_entries = list_cons<JsonEntry>(json_entry(name, json_string(path)), dep_entries)
  }
  dep_entries = list_reverse<JsonEntry>(dep_entries)
  let mut root: List<JsonEntry> = list_cons<JsonEntry>(json_entry("dependencies", json_object(dep_entries)), list_nil<JsonEntry>())
  root = list_cons<JsonEntry>(json_entry("weft", json_string(pkg_str_view(pkg_manifest_weft_ptr(m), pkg_manifest_weft_len(m)))), root)
  root = list_cons<JsonEntry>(json_entry("version", json_string(pkg_str_view(pkg_manifest_version_ptr(m), pkg_manifest_version_len(m)))), root)
  root = list_cons<JsonEntry>(json_entry("manifest_version", json_number(pkg_manifest_schema_version(m))), root)
  if pkg_manifest_package_len(m) > 0 {
    root = list_cons<JsonEntry>(json_entry("package", json_string(pkg_str_view(pkg_manifest_package_start(m), pkg_manifest_package_len(m)))), root)
  } else { 0 }
  if pkg_manifest_trusted_binding_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("trusted_bindings", pkg_manifest_text_list_json(pkg_manifest_trusted_bindings(m))))
  } else { 0 }
  if pkg_manifest_trust_grant_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("trust", pkg_manifest_trust_json(m)))
  } else { 0 }
  if pkg_manifest_native_binding_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("native_bindings", pkg_manifest_native_bindings_json(m)))
  } else { 0 }
  if pkg_manifest_export_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("exports", pkg_manifest_exports_json(m)))
  } else { 0 }
  json_object(root)
}

pub(package) fn pkg_manifest_rendered_eq(m: i64, expected: str) -> i64 {
  let b = buf_new(256)
  pkg_manifest_render_into(b, m)
  pkg_bytes_eq_at(buf_ptr(b), 0, buf_len(b), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_stdout(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

pub(package) fn pkg_stderr(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}

pub(package) fn pkg_cli_exports() -[FileRead]> i64 {
  match file_read_text(pkg_safe_path("weft.pkg"), pkg_safe_read_limit()) {
    Err(error) -> {
      pkg_stderr("pkg: missing weft.pkg\n")
      1
    }
    Ok(text) -> if str_len(text) <= 0 {
      pkg_stderr("pkg: missing weft.pkg\n")
      1
    } else {
      let manifest = pkg_manifest_parse(__str_ptr(text), __str_len(text))
      if pkg_manifest_error_count(manifest) > 0 {
        pkg_stderr("pkg: malformed weft.pkg\n")
        1
      } else {
        let rendered = json_stringify(pkg_manifest_exports_json(manifest))
        pkg_stdout(rendered)
        pkg_stdout("\n")
        0
      }
    }
  }
}

pub(package) fn pkg_native_audit_entry_json(package_name: str, version: str, source: str, content: str, module: str, binding: i64) -> Json {
  let native = if binding == 0 { json_null() } else { pkg_native_binding_json(binding) }
  list_cons<JsonEntry>(json_entry("package", json_string(package_name)),
    list_cons<JsonEntry>(json_entry("version", json_string(version)),
    list_cons<JsonEntry>(json_entry("source", json_string(source)),
    list_cons<JsonEntry>(json_entry("content", json_string(content)),
    list_cons<JsonEntry>(json_entry("module", json_string(module)),
    list_cons<JsonEntry>(json_entry("native", native), list_nil<JsonEntry>())))))) |> json_object
}

pub(package) fn pkg_native_audit_root_entries(manifest: i64, entries: List<Json>) -> List<Json> {
  let package_name = pkg_str_view(pkg_manifest_package_start(manifest), pkg_manifest_package_len(manifest))
  let version = pkg_str_view(pkg_manifest_version_ptr(manifest), pkg_manifest_version_len(manifest))
  let trusted = pkg_manifest_trusted_bindings(manifest)
  let mut result = entries
  for i in 0..nlist_len(trusted) {
    let module = pkg_manifest_text(nlist_get(trusted, i))
    let binding = pkg_manifest_find_native_binding(manifest, __str_ptr(module), __str_len(module))
    result = list_append<Json>(result, pkg_native_audit_entry_json(package_name, version, "path:.", "root", module, binding))
  }
  result
}

pub(package) fn pkg_native_audit_dependency_entries(root: i64, entries: List<Json>) -[FileRead]> Result<List<Json>, str> {
  let grants = pkg_manifest_trust_grants(root)
  let mut result = entries
  let mut failure = ""
  for i in 0..nlist_len(grants) {
    if str_len(failure) == 0 {
      let grant = nlist_get(grants, i)
      let name_ptr = pkg_trust_grant_name_ptr(grant)
      let name_len = pkg_trust_grant_name_len(grant)
      let dependency = pkg_manifest_find_dep(root, name_ptr, name_len)
      if dependency == 0 { failure = "pkg: native audit trust grant has no dependency" }
      else {
        let dep_src = pkg_dep_src(dependency)
        let dep_root = pkg_path_join(0, 0, dep_src + pkg_dep_path_start(dependency), pkg_dep_path_len(dependency))
        let manifest_path = pkg_path_join(pkg_resolve_ptr(dep_root), pkg_resolve_len(dep_root), __str_ptr("weft.pkg"), __str_len("weft.pkg"))
        match file_read_text(pkg_safe_path(pkg_str_view(pkg_resolve_ptr(manifest_path), pkg_resolve_len(manifest_path))), pkg_safe_read_limit()) {
          Err(error) -> { failure = "pkg: native audit cannot read dependency manifest" }
          Ok(text) -> {
            let manifest = if str_len(text) == 0 { pkg_manifest_new() } else { pkg_manifest_parse(__str_ptr(text), __str_len(text)) }
            let package_ok = pkg_bytes_eq_at(pkg_manifest_package_start(manifest), 0, pkg_manifest_package_len(manifest), name_ptr, 0, name_len)
            let version_ok = pkg_bytes_eq_at(pkg_manifest_version_ptr(manifest), 0, pkg_manifest_version_len(manifest), pkg_trust_grant_version_ptr(grant), 0, pkg_trust_grant_version_len(grant))
            let source = pkg_lock_source_identity(pkg_resolve_ptr(dep_root), pkg_resolve_len(dep_root))
            let source_ok = pkg_bytes_eq_at(pkg_trust_grant_source_ptr(grant), 0, pkg_trust_grant_source_len(grant), __str_ptr(source), 0, __str_len(source))
            if pkg_manifest_error_count(manifest) > 0 or package_ok == 0 or version_ok == 0 or source_ok == 0 {
              failure = "pkg: native audit dependency identity does not match trust grant"
            } else {
              let modules = pkg_trust_grant_modules(grant)
              for j in 0..nlist_len(modules) {
                let module = pkg_manifest_text(nlist_get(modules, j))
                if pkg_manifest_declares_trusted_binding(manifest, __str_ptr(module), __str_len(module)) == 0 {
                  failure = "pkg: native audit dependency does not declare trusted module"
                } else {
                  let binding = pkg_manifest_find_native_binding(manifest, __str_ptr(module), __str_len(module))
                  result = list_append<Json>(result, pkg_native_audit_entry_json(
                    pkg_str_view(name_ptr, name_len),
                    pkg_str_view(pkg_trust_grant_version_ptr(grant), pkg_trust_grant_version_len(grant)),
                    source,
                    pkg_str_view(pkg_trust_grant_content_ptr(grant), pkg_trust_grant_content_len(grant)),
                    module,
                    binding
                  ))
                }
              }
            }
          }
        }
      }
    } else { 0 }
  }
  if str_len(failure) == 0 { Ok(result) } else { Err(failure) }
}

pub(package) fn pkg_native_audit_append_import(b: i64, package_name: str, module: str, index: i64) -> i64 {
  bstr(b, "use ")
  if str_len(package_name) > 0 {
    bstr(b, package_name)
    bstr(b, "/")
  } else { 0 }
  bstr(b, module)
  bstr(b, " as native_audit_")
  bstr(b, runtime_int_to_str(index))
  bstr(b, "\n")
  index + 1
}

-- Build a synthetic import root for the exact modules named by native trust.
-- The ordinary parser/resolver/checker then produces wrapper signatures and
-- effect sets from the same stable semantic facts as `weft doc`; the audit
-- never rescans function syntax or guesses which declarations are public.
pub(package) fn pkg_native_audit_import_source() -[FileRead]> Result<str, str> {
  match file_read_text(pkg_safe_path("weft.pkg"), pkg_safe_read_limit()) {
    Err(error) -> Err("pkg: missing weft.pkg")
    Ok(text) -> if str_len(text) <= 0 { Err("pkg: missing weft.pkg") }
    else {
      let manifest = pkg_manifest_parse(__str_ptr(text), __str_len(text))
      if pkg_manifest_error_count(manifest) > 0 { Err("pkg: malformed weft.pkg") }
      else {
        let b = buf_new(256)
        let mut index = 0
        let root_bindings = pkg_manifest_trusted_bindings(manifest)
        for i in 0..nlist_len(root_bindings) {
          index = pkg_native_audit_append_import(b, "", pkg_manifest_text(nlist_get(root_bindings, i)), index)
        }
        let grants = pkg_manifest_trust_grants(manifest)
        for i in 0..nlist_len(grants) {
          let grant = nlist_get(grants, i)
          let package_name = pkg_str_view(pkg_trust_grant_name_ptr(grant), pkg_trust_grant_name_len(grant))
          let modules = pkg_trust_grant_modules(grant)
          for j in 0..nlist_len(modules) {
            index = pkg_native_audit_append_import(b, package_name, pkg_manifest_text(nlist_get(modules, j)), index)
          }
        }
        bstr(b, "fn native_audit_root() -> i64 { 0 }\n")
        Ok(runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b)))
      }
    }
  }
}

-- Stable machine-readable authority inventory. This is a serializer over the
-- same typed manifest graph consumed by trust checking and native lowering;
-- changing a granted library or symbol therefore changes the audit bytes.
pub(package) fn pkg_cli_audit_with_wrappers(wrappers: List<Json>) -[FileRead]> i64 {
  match file_read_text(pkg_safe_path("weft.pkg"), pkg_safe_read_limit()) {
    Err(error) -> { pkg_stderr("pkg: missing weft.pkg\n") 1 }
    Ok(text) -> if str_len(text) <= 0 {
      pkg_stderr("pkg: missing weft.pkg\n")
      1
    } else {
      let manifest = pkg_manifest_parse(__str_ptr(text), __str_len(text))
      if pkg_manifest_error_count(manifest) > 0 {
        pkg_stderr("pkg: malformed weft.pkg\n")
        1
      } else {
        let root_entries = pkg_native_audit_root_entries(manifest, list_nil<Json>())
        match pkg_native_audit_dependency_entries(manifest, root_entries) {
          Err(message) -> { pkg_stderr(message) pkg_stderr("\n") 1 }
          Ok(entries) -> {
            let document = list_cons<JsonEntry>(json_entry("schema_version", json_number(1)),
              list_cons<JsonEntry>(json_entry("target", json_string(pkg_native_target_name(pkg_native_compilation_target()))),
              list_cons<JsonEntry>(json_entry("authority", json_array(entries)),
              list_cons<JsonEntry>(json_entry("wrappers", json_array(wrappers)), list_nil<JsonEntry>())))) |> json_object |> json_stringify
            pkg_stdout(document)
            pkg_stdout("\n")
            0
          }
        }
      }
    }
  }
}

pub(package) fn pkg_cli_audit() -[FileRead]> i64 {
  pkg_cli_audit_with_wrappers(list_nil<Json>())
}

pub(package) fn pkg_cli_init(name_ptr: i64, name_len: i64) -[FileWrite]> i64 {
  if pkg_name_is_valid(name_ptr, 0, name_len) == 0 {
    pkg_stderr("pkg: invalid package name\n")
    1
  } else {
    let manifest = pkg_manifest_new()
    pkg_manifest_set_package(manifest, name_ptr, 0, name_len)
    pkg_manifest_set_version(manifest, __str_ptr("0.1.0"), __str_len("0.1.0"))
    let b = buf_new(name_len + 48)
    pkg_manifest_render_into(b, manifest)
    let rendered = runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
    match file_create_new_text(pkg_safe_path("weft.pkg"), rendered) {
      Ok(count) -> {
        pkg_stdout("pkg: wrote weft.pkg\n")
        0
      }
      Err(error) -> {
        pkg_stderr("pkg: could not write weft.pkg\n")
        1
      }
    }
  }
}

pub(package) fn pkg_cli_add(name_ptr: i64, name_len: i64, path_ptr: i64, path_len: i64) -[FileRead, FileWrite]> i64 {
  match file_read_text(pkg_safe_path("weft.pkg"), pkg_safe_read_limit()) {
    Err(error) -> {
      pkg_stderr("pkg: missing weft.pkg\n")
      1
    }
    Ok(text) -> if str_len(text) <= 0 {
      pkg_stderr("pkg: missing weft.pkg\n")
      1
    } else {
    let manifest = pkg_manifest_parse(__str_ptr(text), __str_len(text))
    if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_len(manifest) <= 0 {
      pkg_stderr("pkg: malformed weft.pkg\n")
      1
    } else {
      let added = pkg_manifest_add_dep_from_parts(manifest, name_ptr, name_len, path_ptr, path_len)
      if added != 0 {
        pkg_stderr("pkg: invalid or duplicate dependency\n")
        1
      } else {
        let b = buf_new(str_len(text) + name_len + path_len + 32)
        pkg_manifest_render_into(b, manifest)
        let rendered = runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
        match file_atomic_replace_text(pkg_safe_path("weft.pkg"), rendered) {
          Ok(count) -> {
            pkg_stdout("pkg: added dependency\n")
            0
          }
          Err(error) -> {
            pkg_stderr("pkg: could not write weft.pkg\n")
            1
          }
        }
      }
    }
  } }
}
