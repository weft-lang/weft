  while i < nlist_len(entries) and result_entry == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(mem_load64_at(entry, 0), 0, mem_load64_at(entry, 8), name_ptr, 0, name_len) == 1 {
      result_entry = entry
    } else { i = i + 1 }
  }
  result_entry
}

