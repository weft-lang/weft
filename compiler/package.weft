pub(package) fn pkg_manifest_identity_equal(a: i64, b: i64) -> i64 {
  if a == 0 or b == 0 { if a == b { 1 } else { 0 } }
  else { if pkg_manifest_schema_version(a) != pkg_manifest_schema_version(b) { 0 }
  else { if pkg_bytes_eq_at(pkg_manifest_version_ptr(a), 0, pkg_manifest_version_len(a), pkg_manifest_version_ptr(b), 0, pkg_manifest_version_len(b)) == 0 { 0 }
  else { pkg_bytes_eq_at(pkg_manifest_weft_ptr(a), 0, pkg_manifest_weft_len(a), pkg_manifest_weft_ptr(b), 0, pkg_manifest_weft_len(b)) } } }
}

pub(package) fn pkg_identity_entries(tt: i64) -> i64 {
  mem_load64_at(tt + 144, 0)
}

-- A parsed-module product retains immutable package/lock/manifest identity,
-- but each instantiated checker table owns its registry cells and parent
-- lists. Compact package ids remain byte-for-byte stable across the copy.
pub(package) fn pkg_table_clone_resolution_state(source_tt: i64, dest_tt: i64) -> i64 {
  let source_entries = pkg_identity_entries(source_tt)
  let dest_entries = pkg_identity_entries(dest_tt)
  for i in 0..nlist_len(source_entries) {
    let source = nlist_get(source_entries, i)
    let entry = alloc_words(9)
    mem_copy(entry, source, 72)
    let source_parents = mem_load64_at(source, 48)
    let parents = nlist_new_capacity(nlist_len(source_parents))
    for parent_index in 0..nlist_len(source_parents) {
      nlist_add(parents, nlist_get(source_parents, parent_index))
    }
    mem_store64_at(entry, 48, parents)
    nlist_add(dest_entries, entry)
  }
  -- Lock data and the parsed manifest are immutable products after module
  -- resolution. Sharing their payloads is safe; only the destination table's
  -- cache cells are independently owned.
  mem_store64_at(dest_tt + 152, 0, mem_load64_at(source_tt + 152, 0))
  ttable_set_root_manifest(dest_tt, ttable_get_root_manifest(source_tt))
  dest_tt
}

-- Package identity entry: stable full name bytes, name length, compact id,
-- physical source-root ptr/len, parsed manifest, parent-id list, and lock
-- content digest ptr/len = 72 bytes. The compact id remains only a graph
-- handle; structural equality compares name/version/source/content.
pub(package) fn pkg_identity_intern(tt: i64, name_ptr: i64, name_len: i64) -> i64 {
  pkg_identity_intern_at_root(tt, name_ptr, name_len, 0, 0, 0)
}

