-- compiler/package.weft -- local package manifest parsing and import roots
--
-- Manifest format:
--   {"package":"app_name","manifest_version":1,"version":"0.1.0",
--    "weft":"0.1","dependencies":{"package_name":"relative/path"}}
--
-- The legacy line-oriented format remains readable for compatibility:
--   package app_name
--   dep package_name relative/path
--
-- The resolver maps `use package_name/file.{*}` to
-- `relative/path/file.weft` when a matching local dep exists. Its result also
-- carries the owning package and package-relative logical module path; the
-- physical path is provenance, never semantic module identity.

use compiler/lib.{*}
use compiler/package_lock_data.{*}
use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/memory.{*}
use runtime/string.{*}
use runtime/syscall.{*}
use stdlib/json.{*}
use stdlib/list.{*}
use stdlib/string.{*}

pub(package) fn pkg_manifest_package_start(m: i64) -> i64 { mem_load64_at(m, 0) }
pub(package) fn pkg_manifest_package_len(m: i64) -> i64 { mem_load64_at(m, 8) }
pub(package) fn pkg_manifest_deps(m: i64) -> i64 { mem_load64_at(m, 16) }
pub(package) fn pkg_manifest_error_count(m: i64) -> i64 { mem_load64_at(m, 24) }
pub(package) fn pkg_manifest_version_ptr(m: i64) -> i64 { mem_load64_at(m, 32) }
pub(package) fn pkg_manifest_version_len(m: i64) -> i64 { mem_load64_at(m, 40) }
pub(package) fn pkg_manifest_weft_ptr(m: i64) -> i64 { mem_load64_at(m, 48) }
pub(package) fn pkg_manifest_weft_len(m: i64) -> i64 { mem_load64_at(m, 56) }
pub(package) fn pkg_manifest_schema_version(m: i64) -> i64 { mem_load64_at(m, 64) }
pub(package) fn pkg_manifest_trusted_bindings(m: i64) -> i64 { mem_load64_at(m, 72) }
pub(package) fn pkg_manifest_trust_grants(m: i64) -> i64 { mem_load64_at(m, 80) }
pub(package) fn pkg_manifest_exports(m: i64) -> i64 { mem_load64_at(m, 88) }

pub(package) fn pkg_manifest_new() -> i64 {
  let m = alloc_zeroed(96)
  mem_store64_at(m, 16, nlist_new())
  mem_store64_at(m, 32, __str_ptr("0.0.0+local"))
  mem_store64_at(m, 40, __str_len("0.0.0+local"))
  mem_store64_at(m, 48, __str_ptr("0.1"))
  mem_store64_at(m, 56, __str_len("0.1"))
  mem_store64_at(m, 64, 1)
  mem_store64_at(m, 72, nlist_new())
  mem_store64_at(m, 80, nlist_new())
  mem_store64_at(m, 88, nlist_new())
  m
}

pub(package) fn pkg_manifest_add_error(m: i64) -> i64 {
  mem_store64_at(m, 24, pkg_manifest_error_count(m) + 1)
  m
}

pub(package) fn pkg_is_space(ch: i64) -> i64 {
  match ch {
    32 -> 1
    9 -> 1
    13 -> 1
    _ -> 0
  }
}

pub(package) fn pkg_skip_spaces(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  while i < n and pkg_is_space(mem_load8_at(src, i)) == 1 {
    i = i + 1
  }
  i
}

pub(package) fn pkg_skip_line(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    if mem_load8_at(src, i) == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if i < n and mem_load8_at(src, i) == 10 { i + 1 } else { i }
}

pub(package) fn pkg_read_token_end(src: i64, n: i64, p: i64) -> i64 {
  let mut i = p
  let mut done = 0
  while i < n and done == 0 {
    let ch = mem_load8_at(src, i)
    if pkg_is_space(ch) == 1 or ch == 10 {
      done = 1
    } else {
      i = i + 1
    }
  }
  i
}

pub(package) fn pkg_line_has_trailing_token(src: i64, n: i64, p: i64) -> i64 {
  let q = pkg_skip_spaces(src, n, p)
  if q >= n { 0 }
  else {
    let ch = mem_load8_at(src, q)
    if ch == 10 or ch == 35 { 0 } else { 1 }
  }
}

pub(package) fn pkg_bytes_eq(src: i64, start: i64, len: i64, s: str) -> i64 {
  src_eq(src, start, len, s)
}

pub(package) fn pkg_bytes_eq_at(a_ptr: i64, a_start: i64, a_len: i64, b_ptr: i64, b_start: i64, b_len: i64) -> i64 {
  if a_len != b_len { 0 }
  else { src_eq_at(a_ptr, a_start, b_ptr + b_start, 0, a_len) }
}

pub(package) fn pkg_str_view(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

pub(package) fn pkg_name_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      let ch = mem_load8_at(src, start + i)
      if ch == 47 or ch == 92 or ch == 46 {
        ok = 0
      } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_version_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let mut i = 0
    let mut ok = 1
    while i < len {
      let ch = mem_load8_at(src, start + i)
      let allowed = if is_alnum(ch) == 1 { 1 }
        else { if ch == 46 or ch == 43 or ch == 45 { 1 } else { 0 } }
      if allowed == 0 { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

pub(package) fn pkg_path_segment_is_dotdot(src: i64, start: i64, len: i64) -> i64 {
  if len == 2 {
    if mem_load8_at(src, start) == 46 {
      if mem_load8_at(src, start + 1) == 46 { 1 } else { 0 }
    } else { 0 }
  } else { 0 }
}

pub(package) fn pkg_path_is_safe(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let first = mem_load8_at(src, start)
    if first == 47 or first == 126 { 0 }
    else {
      let mut i = 0
      let mut seg_start = 0
      let mut ok = 1
      while i <= len {
        if i == len or mem_load8_at(src, start + i) == 47 {
          let seg_len = i - seg_start
          if seg_len <= 0 or pkg_path_segment_is_dotdot(src, start + seg_start, seg_len) == 1 {
            ok = 0
          } else { 0 }
          seg_start = i + 1
        } else { 0 }
        i = i + 1
      }
      ok
    }
  }
}

pub(package) fn pkg_module_path_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 { 0 }
  else {
    let first = mem_load8_at(src, start)
    if first == 47 or first == 126 { 0 }
    else {
      let mut i = 0
      let mut segment_start = 0
      let mut ok = 1
      while i <= len {
        if i == len or mem_load8_at(src, start + i) == 47 {
          let segment_len = i - segment_start
          if segment_len <= 0 or pkg_name_is_valid(src, start + segment_start, segment_len) == 0 {
            ok = 0
          } else { 0 }
          segment_start = i + 1
        } else { 0 }
        i = i + 1
      }
      if len >= 5 and src_eq_at(src, start + len - 5, __str_ptr(".weft"), 0, 5) == 1 { 0 } else { ok }
    }
  }
}

-- Manifest text entries are stable copied ptr/len pairs. Trust data outlives
-- the temporary managed JSON tree used to parse it.
pub(package) fn pkg_manifest_text_new(value: str) -> i64 {
  let entry = alloc_words(2)
  mem_store64_at(entry, 0, pkg_lock_copy_text(value))
  mem_store64_at(entry, 8, __str_len(value))
  entry
}

pub(package) fn pkg_manifest_text_ptr(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_manifest_text_len(entry: i64) -> i64 { mem_load64_at(entry, 8) }
pub(package) fn pkg_manifest_text(entry: i64) -> str { pkg_str_view(pkg_manifest_text_ptr(entry), pkg_manifest_text_len(entry)) }

pub(package) fn pkg_manifest_text_list_contains(entries: i64, ptr: i64, len: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(pkg_manifest_text_ptr(entry), 0, pkg_manifest_text_len(entry), ptr, 0, len) == 1 { found = 1 }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_manifest_text_list_add_module(entries: i64, module: str) -> i64 {
  if pkg_module_path_is_valid(__str_ptr(module), 0, __str_len(module)) == 0 or pkg_manifest_text_list_contains(entries, __str_ptr(module), __str_len(module)) == 1 { 1 }
  else {
    nlist_add(entries, pkg_manifest_text_new(module))
    0
  }
}

pub(package) fn pkg_manifest_trusted_binding_count(m: i64) -> i64 { nlist_len(pkg_manifest_trusted_bindings(m)) }
pub(package) fn pkg_manifest_trust_grant_count(m: i64) -> i64 { nlist_len(pkg_manifest_trust_grants(m)) }

pub(package) fn pkg_manifest_declares_trusted_binding(m: i64, module_ptr: i64, module_len: i64) -> i64 {
  pkg_manifest_text_list_contains(pkg_manifest_trusted_bindings(m), module_ptr, module_len)
}

-- Trust grant layout: package/version/source/content ptr/len pairs plus module
-- list = 72 bytes. Grants are root-only authority facts.
pub(package) fn pkg_trust_grant_new(name: str, version: str, source: str, content: str, modules: i64) -> i64 {
  let grant = alloc_words(9)
  mem_store64_at(grant, 0, pkg_lock_copy_text(name))
  mem_store64_at(grant, 8, __str_len(name))
  mem_store64_at(grant, 16, pkg_lock_copy_text(version))
  mem_store64_at(grant, 24, __str_len(version))
  mem_store64_at(grant, 32, pkg_lock_copy_text(source))
  mem_store64_at(grant, 40, __str_len(source))
  mem_store64_at(grant, 48, pkg_lock_copy_text(content))
  mem_store64_at(grant, 56, __str_len(content))
  mem_store64_at(grant, 64, modules)
  grant
}

pub(package) fn pkg_trust_grant_name_ptr(grant: i64) -> i64 { mem_load64_at(grant, 0) }
pub(package) fn pkg_trust_grant_name_len(grant: i64) -> i64 { mem_load64_at(grant, 8) }
pub(package) fn pkg_trust_grant_version_ptr(grant: i64) -> i64 { mem_load64_at(grant, 16) }
pub(package) fn pkg_trust_grant_version_len(grant: i64) -> i64 { mem_load64_at(grant, 24) }
pub(package) fn pkg_trust_grant_source_ptr(grant: i64) -> i64 { mem_load64_at(grant, 32) }
pub(package) fn pkg_trust_grant_source_len(grant: i64) -> i64 { mem_load64_at(grant, 40) }
pub(package) fn pkg_trust_grant_content_ptr(grant: i64) -> i64 { mem_load64_at(grant, 48) }
pub(package) fn pkg_trust_grant_content_len(grant: i64) -> i64 { mem_load64_at(grant, 56) }
pub(package) fn pkg_trust_grant_modules(grant: i64) -> i64 { mem_load64_at(grant, 64) }

pub(package) fn pkg_manifest_find_trust_grant(m: i64, name_ptr: i64, name_len: i64) -> i64 {
  let grants = pkg_manifest_trust_grants(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(grants) and found == 0 {
    let grant = nlist_get(grants, i)
    if pkg_bytes_eq_at(pkg_trust_grant_name_ptr(grant), 0, pkg_trust_grant_name_len(grant), name_ptr, 0, name_len) == 1 { found = grant }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_trust_grant_names_module(grant: i64, module_ptr: i64, module_len: i64) -> i64 {
  if grant == 0 { 0 } else { pkg_manifest_text_list_contains(pkg_trust_grant_modules(grant), module_ptr, module_len) }
}

pub(package) fn pkg_export_kind_grammar() -> i64 { 1 }
pub(package) fn pkg_export_kind_tool() -> i64 { 2 }

pub(package) fn pkg_export_execution_none() -> i64 { 0 }
pub(package) fn pkg_export_execution_validate_only() -> i64 { 1 }
pub(package) fn pkg_export_execution_typed_plan() -> i64 { 2 }
pub(package) fn pkg_export_execution_runtime() -> i64 { 3 }

pub(package) fn pkg_identifier_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 or is_alpha(mem_load8_at(src, start)) == 0 { 0 }
  else {
    let mut i = 1
    let mut ok = 1
    while i < len {
      if is_alnum(mem_load8_at(src, start + i)) == false { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

-- Export entry: kind, public name, module path, declaration ptr/len,
-- execution model, audit state, resolved declaration, diagnosed bit = 88 bytes.
pub(package) fn pkg_export_new(kind: i64, name: str, module: str, declaration: str, execution: i64) -> i64 {
  let entry = alloc_words(11)
  mem_store64_at(entry, 0, kind)
  mem_store64_at(entry, 8, pkg_lock_copy_text(name))
  mem_store64_at(entry, 16, __str_len(name))
  mem_store64_at(entry, 24, pkg_lock_copy_text(module))
  mem_store64_at(entry, 32, __str_len(module))
  mem_store64_at(entry, 40, pkg_lock_copy_text(declaration))
  mem_store64_at(entry, 48, __str_len(declaration))
  mem_store64_at(entry, 56, execution)
  mem_store64_at(entry, 64, 0)
  mem_store64_at(entry, 72, 0)
  mem_store64_at(entry, 80, 0)
  entry
}

pub(package) fn pkg_export_kind(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_export_name_ptr(entry: i64) -> i64 { mem_load64_at(entry, 8) }
pub(package) fn pkg_export_name_len(entry: i64) -> i64 { mem_load64_at(entry, 16) }
pub(package) fn pkg_export_module_ptr(entry: i64) -> i64 { mem_load64_at(entry, 24) }
pub(package) fn pkg_export_module_len(entry: i64) -> i64 { mem_load64_at(entry, 32) }
pub(package) fn pkg_export_declaration_ptr(entry: i64) -> i64 { mem_load64_at(entry, 40) }
pub(package) fn pkg_export_declaration_len(entry: i64) -> i64 { mem_load64_at(entry, 48) }
pub(package) fn pkg_export_execution(entry: i64) -> i64 { mem_load64_at(entry, 56) }
pub(package) fn pkg_export_audit_state(entry: i64) -> i64 { mem_load64_at(entry, 64) }
pub(package) fn pkg_export_set_audit_state(entry: i64, state: i64) -> i64 { mem_store64_at(entry, 64, state) }
pub(package) fn pkg_export_resolved_declaration(entry: i64) -> i64 { mem_load64_at(entry, 72) }
pub(package) fn pkg_export_set_resolved_declaration(entry: i64, declaration: i64) -> i64 { mem_store64_at(entry, 72, declaration) }
pub(package) fn pkg_export_is_diagnosed(entry: i64) -> i64 { mem_load64_at(entry, 80) }
pub(package) fn pkg_export_mark_diagnosed(entry: i64) -> i64 { mem_store64_at(entry, 80, 1) }

pub(package) fn pkg_manifest_export_count(m: i64) -> i64 { nlist_len(pkg_manifest_exports(m)) }

pub(package) fn pkg_manifest_find_export(m: i64, kind: i64, name_ptr: i64, name_len: i64) -> i64 {
  let entries = pkg_manifest_exports(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(entries) and found == 0 {
    let entry = nlist_get(entries, i)
    if pkg_export_kind(entry) == kind and pkg_bytes_eq_at(pkg_export_name_ptr(entry), 0, pkg_export_name_len(entry), name_ptr, 0, name_len) == 1 { found = entry }
    else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_export_execution_from_name(name: str) -> i64 {
  if str_eq(name, "validate_only") == 1 { pkg_export_execution_validate_only() }
  else { if str_eq(name, "typed_plan") == 1 { pkg_export_execution_typed_plan() }
  else { if str_eq(name, "runtime") == 1 { pkg_export_execution_runtime() }
  else { 0 - 1 } } }
}

pub(package) fn pkg_export_execution_name(execution: i64) -> str {
  if execution == pkg_export_execution_validate_only() { "validate_only" }
  else { if execution == pkg_export_execution_typed_plan() { "typed_plan" }
  else { if execution == pkg_export_execution_runtime() { "runtime" } else { "" } } }
}

pub(package) fn pkg_dep_new(name_start: i64, name_len: i64, path_start: i64, path_len: i64, src: i64) -> i64 {
  let d = alloc_zeroed(40)
  mem_store64_at(d, 0, name_start)
  mem_store64_at(d, 8, name_len)
  mem_store64_at(d, 16, path_start)
  mem_store64_at(d, 24, path_len)
  mem_store64_at(d, 32, src)
  d
}

pub(package) fn pkg_dep_name_start(d: i64) -> i64 { mem_load64_at(d, 0) }
pub(package) fn pkg_dep_name_len(d: i64) -> i64 { mem_load64_at(d, 8) }
pub(package) fn pkg_dep_path_start(d: i64) -> i64 { mem_load64_at(d, 16) }
pub(package) fn pkg_dep_path_len(d: i64) -> i64 { mem_load64_at(d, 24) }
pub(package) fn pkg_dep_src(d: i64) -> i64 { mem_load64_at(d, 32) }

pub(package) fn pkg_manifest_dep_count(m: i64) -> i64 {
  nlist_len(pkg_manifest_deps(m))
}

pub(package) fn pkg_manifest_find_dep(m: i64, name_ptr: i64, name_len: i64) -> i64 {
  let deps = pkg_manifest_deps(m)
  let mut i = 0
  let mut found = 0
  while i < nlist_len(deps) {
    let dep = nlist_get(deps, i)
    let dep_src = pkg_dep_src(dep)
    if pkg_bytes_eq_at(dep_src, pkg_dep_name_start(dep), pkg_dep_name_len(dep), name_ptr, 0, name_len) == 1 {
      found = dep
      i = nlist_len(deps)
    } else {
      i = i + 1
    }
  }
  found
}

pub(package) fn pkg_manifest_has_dep(m: i64, name: str) -> i64 {
  if pkg_manifest_find_dep(m, __str_ptr(name), __str_len(name)) == 0 { 0 } else { 1 }
}

pub(package) fn pkg_manifest_dep_path_eq(m: i64, name: str, expected: str) -> i64 {
  let dep = pkg_manifest_find_dep(m, __str_ptr(name), __str_len(name))
  if dep == 0 { 0 }
  else {
    let dep_src = pkg_dep_src(dep)
    pkg_bytes_eq_at(dep_src, pkg_dep_path_start(dep), pkg_dep_path_len(dep), __str_ptr(expected), 0, __str_len(expected))
  }
}

pub(package) fn pkg_manifest_package_eq(m: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_manifest_package_start(m), 0, pkg_manifest_package_len(m), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_manifest_version_eq(m: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_manifest_version_ptr(m), 0, pkg_manifest_version_len(m), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_manifest_weft_eq(m: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_manifest_weft_ptr(m), 0, pkg_manifest_weft_len(m), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_manifest_set_version(m: i64, ptr: i64, len: i64) -> i64 {
  if pkg_version_is_valid(ptr, 0, len) == 0 { pkg_manifest_add_error(m) }
  else {
    let stable = alloc_zeroed(len)
    mem_copy(stable, ptr, len)
    mem_store64_at(m, 32, stable)
    mem_store64_at(m, 40, len)
    m
  }
}

pub(package) fn pkg_manifest_set_weft(m: i64, ptr: i64, len: i64) -> i64 {
  if pkg_version_is_valid(ptr, 0, len) == 0 { pkg_manifest_add_error(m) }
  else {
    let stable = alloc_zeroed(len)
    mem_copy(stable, ptr, len)
    mem_store64_at(m, 48, stable)
    mem_store64_at(m, 56, len)
    m
  }
}

pub(package) fn pkg_manifest_identity_equal(a: i64, b: i64) -> i64 {
  if a == 0 or b == 0 { if a == b { 1 } else { 0 } }
  else { if pkg_manifest_schema_version(a) != pkg_manifest_schema_version(b) { 0 }
  else { if pkg_bytes_eq_at(pkg_manifest_version_ptr(a), 0, pkg_manifest_version_len(a), pkg_manifest_version_ptr(b), 0, pkg_manifest_version_len(b)) == 0 { 0 }
  else { pkg_bytes_eq_at(pkg_manifest_weft_ptr(a), 0, pkg_manifest_weft_len(a), pkg_manifest_weft_ptr(b), 0, pkg_manifest_weft_len(b)) } } }
}

pub(package) fn pkg_identity_entries(tt: i64) -> i64 {
  mem_load64_at(tt + 144, 0)
}

-- Package identity entry: stable full name bytes, name length, compact id,
-- physical source-root ptr/len, parsed manifest, parent-id list, and lock
-- content digest ptr/len = 72 bytes. The compact id remains only a graph
-- handle; structural equality compares name/version/source/content.
pub(package) fn pkg_identity_intern(tt: i64, name_ptr: i64, name_len: i64) -> i64 {
  pkg_identity_intern_at_root(tt, name_ptr, name_len, 0, 0, 0)
}

pub(package) fn pkg_identity_find_name(tt: i64, name_ptr: i64, name_len: i64) -> i64 {
  let entries = pkg_identity_entries(tt)
  let mut i = 0
  let mut result_entry = 0
  while i < nlist_len(entries) and result_entry == 0 {
    let entry = nlist_get(entries, i)
    if pkg_bytes_eq_at(mem_load64_at(entry, 0), 0, mem_load64_at(entry, 8), name_ptr, 0, name_len) == 1 {
      result_entry = entry
    } else { i = i + 1 }
  }
  result_entry
}

pub(package) fn pkg_identity_find_id(tt: i64, id: i64) -> i64 {
  let entries = pkg_identity_entries(tt)
  let mut i = 0
  let mut result_entry = 0
  while i < nlist_len(entries) and result_entry == 0 {
    let entry = nlist_get(entries, i)
    if mem_load64_at(entry, 16) == id { result_entry = entry }
    else { i = i + 1 }
  }
  result_entry
}

pub(package) fn pkg_identity_intern_at_root(tt: i64, name_ptr: i64, name_len: i64, root_ptr: i64, root_len: i64, manifest: i64) -> i64 {
  pkg_identity_intern_under_owner(tt, name_ptr, name_len, root_ptr, root_len, manifest, 0)
}

pub(package) fn pkg_identity_parent_list_contains(parents: i64, parent_id: i64) -> i64 {
  let mut i = 0
  let mut found = 0
  while i < nlist_len(parents) and found == 0 {
    if nlist_get(parents, i) == parent_id { found = 1 } else { i = i + 1 }
  }
  found
}

pub(package) fn pkg_identity_add_parent(entry: i64, parent_id: i64) -> i64 {
  if entry == 0 { 0 }
  else {
    let parents = mem_load64_at(entry, 48)
    if pkg_identity_parent_list_contains(parents, parent_id) == 0 { nlist_add(parents, parent_id) } else { 0 }
    0
  }
}

pub(package) fn pkg_identity_register_root(tt: i64, manifest: i64) -> i64 {
  pkg_identity_register_root_with_content(tt, manifest, 0, 0)
}

pub(package) fn pkg_identity_register_root_with_content(tt: i64, manifest: i64, content_ptr: i64, content_len: i64) -> i64 {
  let name_len = pkg_manifest_package_len(manifest)
  if name_len <= 0 { 0 }
  else {
    let name_ptr = pkg_manifest_package_start(manifest)
    let existing = pkg_identity_find_name(tt, name_ptr, name_len)
    if existing != 0 { existing }
    else {
      let owned_name = alloc_zeroed(name_len)
      mem_copy(owned_name, name_ptr, name_len)
      let entry = alloc_words(9)
      mem_store64_at(entry, 0, owned_name)
      mem_store64_at(entry, 8, name_len)
      mem_store64_at(entry, 16, 0)
      mem_store64_at(entry, 24, 0)
      mem_store64_at(entry, 32, 0)
      mem_store64_at(entry, 40, manifest)
      mem_store64_at(entry, 48, nlist_new())
      mem_store64_at(entry, 56, content_ptr)
      mem_store64_at(entry, 64, content_len)
      nlist_add(pkg_identity_entries(tt), entry)
      entry
    }
  }
}

pub(package) fn pkg_identity_is_ancestor_walk(tt: i64, current_id: i64, wanted_id: i64, visited: i64) -> i64 {
  if current_id == wanted_id { 1 }
  else { if current_id == 0 or pkg_identity_parent_list_contains(visited, current_id) == 1 { 0 }
  else {
    nlist_add(visited, current_id)
    let current = pkg_identity_find_id(tt, current_id)
    if current == 0 { 0 }
    else {
      let parents = mem_load64_at(current, 48)
      let mut i = 0
      let mut found = 0
      while i < nlist_len(parents) and found == 0 {
        found = pkg_identity_is_ancestor_walk(tt, nlist_get(parents, i), wanted_id, visited)
        i = i + 1
      }
      found
    }
  } }
}

pub(package) fn pkg_identity_is_ancestor(tt: i64, current_id: i64, wanted_id: i64) -> i64 {
  pkg_identity_is_ancestor_walk(tt, current_id, wanted_id, nlist_new())
}

pub(package) fn pkg_identity_intern_under_owner(tt: i64, name_ptr: i64, name_len: i64, root_ptr: i64, root_len: i64, manifest: i64, owner_id: i64) -> i64 {
  pkg_identity_intern_under_owner_with_content(tt, name_ptr, name_len, root_ptr, root_len, manifest, owner_id, 0, 0)
}

pub(package) fn pkg_identity_content_equal(entry: i64, content_ptr: i64, content_len: i64) -> i64 {
  let existing_len = mem_load64_at(entry, 64)
  if existing_len != content_len { 0 }
  else { if content_len == 0 { 1 }
  else { pkg_bytes_eq_at(mem_load64_at(entry, 56), 0, existing_len, content_ptr, 0, content_len) } }
}

pub(package) fn pkg_identity_intern_under_owner_with_content(tt: i64, name_ptr: i64, name_len: i64, root_ptr: i64, root_len: i64, manifest: i64, owner_id: i64, content_ptr: i64, content_len: i64) -> i64 {
  let entries = pkg_identity_entries(tt)
  let existing = pkg_identity_find_name(tt, name_ptr, name_len)
  if existing != 0 {
    let existing_root_len = mem_load64_at(existing, 32)
    if existing_root_len == 0 and root_len > 0 {
      mem_store64_at(existing, 24, root_ptr)
      mem_store64_at(existing, 32, root_len)
      mem_store64_at(existing, 40, manifest)
      mem_store64_at(existing, 56, content_ptr)
      mem_store64_at(existing, 64, content_len)
      pkg_identity_add_parent(existing, owner_id)
      mem_load64_at(existing, 16)
    } else { if existing_root_len == root_len and pkg_bytes_eq_at(mem_load64_at(existing, 24), 0, existing_root_len, root_ptr, 0, root_len) == 1 and pkg_manifest_identity_equal(mem_load64_at(existing, 40), manifest) == 1 and pkg_identity_content_equal(existing, content_ptr, content_len) == 1 {
      if mem_load64_at(existing, 40) == 0 and manifest != 0 { mem_store64_at(existing, 40, manifest) } else { 0 }
      pkg_identity_add_parent(existing, owner_id)
      mem_load64_at(existing, 16)
    } else {
      0 - mem_load64_at(existing, 16)
    } }
  }
  else {
    let owned_name = alloc_zeroed(name_len)
    mem_copy(owned_name, name_ptr, name_len)
    let id = nlist_len(entries) + 1
    let entry = alloc_words(9)
    mem_store64_at(entry, 0, owned_name)
    mem_store64_at(entry, 8, name_len)
    mem_store64_at(entry, 16, id)
    mem_store64_at(entry, 24, root_ptr)
    mem_store64_at(entry, 32, root_len)
    mem_store64_at(entry, 40, manifest)
    mem_store64_at(entry, 48, nlist_new())
    mem_store64_at(entry, 56, content_ptr)
    mem_store64_at(entry, 64, content_len)
    pkg_identity_add_parent(entry, owner_id)
    nlist_add(entries, entry)
    id
  }
}

pub(package) fn pkg_identity_root_ptr(entry: i64) -> i64 { mem_load64_at(entry, 24) }
pub(package) fn pkg_identity_root_len(entry: i64) -> i64 { mem_load64_at(entry, 32) }
pub(package) fn pkg_identity_manifest(entry: i64) -> i64 { mem_load64_at(entry, 40) }
pub(package) fn pkg_identity_content_ptr(entry: i64) -> i64 { mem_load64_at(entry, 56) }
pub(package) fn pkg_identity_content_len(entry: i64) -> i64 { mem_load64_at(entry, 64) }
pub(package) fn pkg_identity_name_ptr(entry: i64) -> i64 { mem_load64_at(entry, 0) }
pub(package) fn pkg_identity_name_len(entry: i64) -> i64 { mem_load64_at(entry, 8) }

pub(package) fn pkg_trust_grant_matches_identity(grant: i64, identity: i64) -> i64 {
  if grant == 0 or identity == 0 or pkg_identity_content_len(identity) <= 0 { 0 }
  else {
    let manifest = pkg_identity_manifest(identity)
    let source = pkg_lock_source_identity(pkg_identity_root_ptr(identity), pkg_identity_root_len(identity))
    let version_ok = pkg_bytes_eq_at(pkg_trust_grant_version_ptr(grant), 0, pkg_trust_grant_version_len(grant), pkg_manifest_version_ptr(manifest), 0, pkg_manifest_version_len(manifest))
    let source_ok = pkg_bytes_eq_at(pkg_trust_grant_source_ptr(grant), 0, pkg_trust_grant_source_len(grant), __str_ptr(source), 0, __str_len(source))
    let content_ok = pkg_bytes_eq_at(pkg_trust_grant_content_ptr(grant), 0, pkg_trust_grant_content_len(grant), pkg_identity_content_ptr(identity), 0, pkg_identity_content_len(identity))
    if version_ok == 1 and source_ok == 1 and content_ok == 1 { 1 } else { 0 }
  }
}

-- 0 ordinary module, 1 exact trusted binding, -1 declaration/grant mismatch.
pub(package) fn pkg_binding_module_trust_state(tt: i64, package_id: i64, module_ptr: i64, module_len: i64) -> i64 {
  let identity = pkg_identity_find_id(tt, package_id)
  if identity == 0 { 0 }
  else {
    let manifest = pkg_identity_manifest(identity)
    let declared = pkg_manifest_declares_trusted_binding(manifest, module_ptr, module_len)
    if package_id == 0 { declared }
    else {
      let root = pkg_identity_find_id(tt, 0)
      if root == 0 { if declared == 1 { 0 - 1 } else { 0 } }
      else {
        let grant = pkg_manifest_find_trust_grant(pkg_identity_manifest(root), pkg_identity_name_ptr(identity), pkg_identity_name_len(identity))
        let named = pkg_trust_grant_names_module(grant, module_ptr, module_len)
        if declared == 0 and named == 0 { 0 }
        else { if declared == 1 and named == 1 and pkg_trust_grant_matches_identity(grant, identity) == 1 { 1 } else { 0 - 1 } }
      }
    }
  }
}

pub(package) fn pkg_manifest_set_package(m: i64, src: i64, name_start: i64, name_len: i64) -> i64 {
  if pkg_manifest_package_len(m) != 0 {
    pkg_manifest_add_error(m)
  } else {
    if pkg_name_is_valid(src, name_start, name_len) == 0 {
      pkg_manifest_add_error(m)
    } else {
      let stable = alloc_zeroed(name_len)
      mem_copy(stable, src + name_start, name_len)
      mem_store64_at(m, 0, stable)
      mem_store64_at(m, 8, name_len)
    }
  }
  m
}

pub(package) fn pkg_manifest_add_dep(m: i64, src: i64, name_start: i64, name_len: i64, path_start: i64, path_len: i64) -> i64 {
  let existing = pkg_manifest_find_dep(m, src + name_start, name_len)
  if existing != 0 {
    pkg_manifest_add_error(m)
  } else {
    if pkg_name_is_valid(src, name_start, name_len) == 0 or pkg_path_is_safe(src, path_start, path_len) == 0 {
      pkg_manifest_add_error(m)
    } else {
      let stable = alloc_zeroed(name_len + path_len + 1)
      mem_copy(stable, src + name_start, name_len)
      mem_store8_at(stable, name_len, 10)
      mem_copy(stable + name_len + 1, src + path_start, path_len)
      nlist_add(pkg_manifest_deps(m), pkg_dep_new(0, name_len, name_len + 1, path_len, stable))
    }
  }
  m
}

pub(package) fn pkg_manifest_add_dep_from_parts(m: i64, name_ptr: i64, name_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  if pkg_manifest_find_dep(m, name_ptr, name_len) != 0 { 1 }
  else {
    if pkg_name_is_valid(name_ptr, 0, name_len) == 0 or pkg_path_is_safe(path_ptr, 0, path_len) == 0 { 1 }
    else {
      let src = alloc_zeroed(name_len + path_len + 1)
      mem_copy(src, name_ptr, name_len)
      mem_store8_at(src, name_len, 10)
      mem_copy(src + name_len + 1, path_ptr, path_len)
      nlist_add(pkg_manifest_deps(m), pkg_dep_new(0, name_len, name_len + 1, path_len, src))
      0
    }
  }
}

pub(package) fn pkg_manifest_parse_line(m: i64, src: i64, n: i64, p: i64) -> i64 {
  let start = pkg_skip_spaces(src, n, p)
  if start >= n { n }
  else {
    let first = mem_load8_at(src, start)
    if first == 10 { start + 1 }
    else { if first == 35 { pkg_skip_line(src, n, start) }
    else {
      let key_end = pkg_read_token_end(src, n, start)
      let key_len = key_end - start
      let arg1_start = pkg_skip_spaces(src, n, key_end)
      let arg1_end = pkg_read_token_end(src, n, arg1_start)
      let arg1_len = arg1_end - arg1_start
      if pkg_bytes_eq(src, start, key_len, "package") == 1 {
        if arg1_len <= 0 or pkg_line_has_trailing_token(src, n, arg1_end) == 1 {
          pkg_manifest_add_error(m)
        } else {
          pkg_manifest_set_package(m, src, arg1_start, arg1_len)
        }
      } else { if pkg_bytes_eq(src, start, key_len, "dep") == 1 {
        let arg2_start = pkg_skip_spaces(src, n, arg1_end)
        let arg2_end = pkg_read_token_end(src, n, arg2_start)
        let arg2_len = arg2_end - arg2_start
        if arg1_len <= 0 or arg2_len <= 0 or pkg_line_has_trailing_token(src, n, arg2_end) == 1 {
          pkg_manifest_add_error(m)
        } else {
          pkg_manifest_add_dep(m, src, arg1_start, arg1_len, arg2_start, arg2_len)
        }
      } else {
        pkg_manifest_add_error(m)
      } }
      pkg_skip_line(src, n, start)
    } }
  }
}

pub(package) fn pkg_manifest_parse(src: i64, n: i64) -> i64 {
  let start = json_skip_ws(src, n, 0)
  if start < n and mem_load8_at(src, start) == 123 {
    pkg_manifest_parse_json(src, n)
  } else {
    let m = pkg_manifest_new()
    let mut p = 0
    while p < n {
      p = pkg_manifest_parse_line(m, src, n, p)
    }
    m
  }
}

pub(package) fn pkg_manifest_parse_str(src: str) -> i64 {
  pkg_manifest_parse(__str_ptr(src), __str_len(src))
}

pub(package) fn pkg_manifest_parse_json(src: i64, n: i64) -> i64 {
  let m = pkg_manifest_new()
  let parsed = json_parse(pkg_str_view(src, n))
  if json_result_ok(parsed) == 0 {
    pkg_manifest_add_error(m)
    m
  } else {
    pkg_manifest_fill_from_json(m, json_result_value(parsed))
  }
}

pub(package) fn pkg_manifest_json_key_is_allowed(key: str) -> i64 {
  if str_eq(key, "package") == 1 { 1 }
  else { if str_eq(key, "manifest_version") == 1 { 1 }
  else { if str_eq(key, "version") == 1 { 1 }
  else { if str_eq(key, "weft") == 1 { 1 }
  else { if str_eq(key, "dependencies") == 1 { 1 }
  else { if str_eq(key, "trusted_bindings") == 1 { 1 }
  else { if str_eq(key, "trust") == 1 { 1 }
  else { if str_eq(key, "exports") == 1 { 1 } else { 0 } } } } } } } }
}

pub(package) fn pkg_manifest_validate_json_keys(m: i64, root: Json) -> i64 {
  let mut entries = json_object_entries(root)
  while list_empty<JsonEntry>(entries) == 0 {
    let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
    if pkg_manifest_json_key_is_allowed(json_entry_key(entry)) == 0 {
      pkg_manifest_add_error(m)
    } else { if pkg_lock_json_key_count(root, json_entry_key(entry)) != 1 {
      pkg_manifest_add_error(m)
    } else { 0 } }
    entries = list_rest_or_nil<JsonEntry>(entries)
  }
  m
}

pub(package) fn pkg_manifest_fill_module_array(m: i64, value: Json, target: i64, require_nonempty: i64) -> i64 {
  if json_kind(value) != 4 or (require_nonempty == 1 and json_array_len(value) <= 0) {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut items = json_array_items(value)
    let mut failed = 0
    while list_empty<Json>(items) == 0 {
      let item = list_first_or<Json>(items, json_null())
      if json_kind(item) != 3 { failed = 1 }
      else {
        let module = json_string_value(item, "")
        if pkg_manifest_text_list_add_module(target, module) != 0 { failed = 1 } else { 0 }
      }
      items = list_rest_or_nil<Json>(items)
    }
    if failed == 1 { pkg_manifest_add_error(m) } else { 0 }
    failed
  }
}

pub(package) fn pkg_trust_grant_key_allowed(key: str) -> i64 {
  if str_eq(key, "version") == 1 or str_eq(key, "source") == 1 or str_eq(key, "content") == 1 or str_eq(key, "modules") == 1 { 1 } else { 0 }
}

pub(package) fn pkg_trust_grant_keys_valid(value: Json) -> i64 {
  if json_kind(value) != 5 or json_object_len(value) != 4 { 0 }
  else {
    let mut entries = json_object_entries(value)
    let mut ok = 1
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_trust_grant_key_allowed(json_entry_key(entry)) == 0 { ok = 0 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    if pkg_lock_json_key_count(value, "version") != 1 or pkg_lock_json_key_count(value, "source") != 1 or pkg_lock_json_key_count(value, "content") != 1 or pkg_lock_json_key_count(value, "modules") != 1 { 0 } else { ok }
  }
}

pub(package) fn pkg_manifest_fill_trust_grant(m: i64, name: str, value: Json) -> i64 {
  if pkg_name_is_valid(__str_ptr(name), 0, __str_len(name)) == 0 or pkg_manifest_find_trust_grant(m, __str_ptr(name), __str_len(name)) != 0 or pkg_manifest_package_eq(m, name) == 1 or pkg_trust_grant_keys_valid(value) == 0 {
    pkg_manifest_add_error(m)
    1
  } else {
    let version_value = json_option_value_or(json_object_get(value, "version"), json_null())
    let source_value = json_option_value_or(json_object_get(value, "source"), json_null())
    let content_value = json_option_value_or(json_object_get(value, "content"), json_null())
    let modules_value = json_option_value_or(json_object_get(value, "modules"), json_null())
    if json_kind(version_value) != 3 or json_kind(source_value) != 3 or json_kind(content_value) != 3 {
      pkg_manifest_add_error(m)
      1
    } else {
      let version = json_string_value(version_value, "")
      let source = json_string_value(source_value, "")
      let content = json_string_value(content_value, "")
      let modules = nlist_new()
      let modules_failed = pkg_manifest_fill_module_array(m, modules_value, modules, 1)
      if modules_failed == 1 or pkg_version_is_valid(__str_ptr(version), 0, __str_len(version)) == 0 or pkg_lock_source_path_valid(source) == 0 or pkg_lock_content_valid(content) == 0 {
        if modules_failed == 0 { pkg_manifest_add_error(m) } else { 0 }
        1
      } else {
        nlist_add(pkg_manifest_trust_grants(m), pkg_trust_grant_new(name, version, source, content, modules))
        0
      }
    }
  }
}

pub(package) fn pkg_manifest_fill_trust(m: i64, value: Json) -> i64 {
  if json_kind(value) != 5 {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut grants = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(grants) == 0 {
      let entry = list_first_or<JsonEntry>(grants, json_entry("", json_null()))
      if pkg_manifest_fill_trust_grant(m, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 }
      grants = list_rest_or_nil<JsonEntry>(grants)
    }
    failed
  }
}

pub(package) fn pkg_export_entry_key_allowed(key: str, kind: i64) -> i64 {
  if str_eq(key, "module") == 1 or str_eq(key, "declaration") == 1 { 1 }
  else { if kind == pkg_export_kind_grammar() and str_eq(key, "execution") == 1 { 1 } else { 0 } }
}

pub(package) fn pkg_export_entry_keys_valid(value: Json, kind: i64) -> i64 {
  let wanted = if kind == pkg_export_kind_grammar() { 3 } else { 2 }
  if json_kind(value) != 5 or json_object_len(value) != wanted { 0 }
  else {
    let mut entries = json_object_entries(value)
    let mut ok = 1
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_export_entry_key_allowed(json_entry_key(entry), kind) == 0 { ok = 0 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    if pkg_lock_json_key_count(value, "module") != 1 or pkg_lock_json_key_count(value, "declaration") != 1 { 0 }
    else { if kind == pkg_export_kind_grammar() and pkg_lock_json_key_count(value, "execution") != 1 { 0 } else { ok } }
  }
}

pub(package) fn pkg_manifest_fill_export_entry(m: i64, kind: i64, name: str, value: Json) -> i64 {
  if pkg_identifier_is_valid(__str_ptr(name), 0, __str_len(name)) == 0 or pkg_manifest_find_export(m, kind, __str_ptr(name), __str_len(name)) != 0 or pkg_export_entry_keys_valid(value, kind) == 0 {
    pkg_manifest_add_error(m)
    1
  } else {
    let module_value = json_option_value_or(json_object_get(value, "module"), json_null())
    let declaration_value = json_option_value_or(json_object_get(value, "declaration"), json_null())
    let execution_value = if kind == pkg_export_kind_grammar() { json_option_value_or(json_object_get(value, "execution"), json_null()) } else { json_string("") }
    if json_kind(module_value) != 3 or json_kind(declaration_value) != 3 or (kind == pkg_export_kind_grammar() and json_kind(execution_value) != 3) {
      pkg_manifest_add_error(m)
      1
    } else {
      let module = json_string_value(module_value, "")
      let declaration = json_string_value(declaration_value, "")
      let execution = if kind == pkg_export_kind_grammar() { pkg_export_execution_from_name(json_string_value(execution_value, "")) } else { pkg_export_execution_none() }
      if pkg_module_path_is_valid(__str_ptr(module), 0, __str_len(module)) == 0 or pkg_identifier_is_valid(__str_ptr(declaration), 0, __str_len(declaration)) == 0 or execution < 0 {
        pkg_manifest_add_error(m)
        1
      } else {
        nlist_add(pkg_manifest_exports(m), pkg_export_new(kind, name, module, declaration, execution))
        0
      }
    }
  }
}

pub(package) fn pkg_manifest_fill_export_kind(m: i64, kind: i64, value: Json) -> i64 {
  if json_kind(value) != 5 {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut entries = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      if pkg_manifest_fill_export_entry(m, kind, json_entry_key(entry), json_entry_value(entry)) != 0 { failed = 1 } else { 0 }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    failed
  }
}

pub(package) fn pkg_manifest_fill_exports(m: i64, value: Json) -> i64 {
  if json_kind(value) != 5 {
    pkg_manifest_add_error(m)
    1
  } else {
    let mut entries = json_object_entries(value)
    let mut failed = 0
    while list_empty<JsonEntry>(entries) == 0 {
      let entry = list_first_or<JsonEntry>(entries, json_entry("", json_null()))
      let key = json_entry_key(entry)
      if str_eq(key, "grammars") == 1 {
        if pkg_lock_json_key_count(value, "grammars") != 1 {
          pkg_manifest_add_error(m)
          failed = 1
        } else { if pkg_manifest_fill_export_kind(m, pkg_export_kind_grammar(), json_entry_value(entry)) != 0 { failed = 1 } else { 0 } }
      } else { if str_eq(key, "tools") == 1 {
        if pkg_lock_json_key_count(value, "tools") != 1 {
          pkg_manifest_add_error(m)
          failed = 1
        } else { if pkg_manifest_fill_export_kind(m, pkg_export_kind_tool(), json_entry_value(entry)) != 0 { failed = 1 } else { 0 } }
      } else {
        pkg_manifest_add_error(m)
        failed = 1
      } }
      entries = list_rest_or_nil<JsonEntry>(entries)
    }
    failed
  }
}

pub(package) fn pkg_manifest_fill_from_json(m: i64, root: Json) -> i64 {
  if json_kind(root) != 5 {
    pkg_manifest_add_error(m)
    m
  } else {
    pkg_manifest_validate_json_keys(m, root)
    let package_opt = json_object_get(root, "package")
    if json_option_is_some(package_opt) == 1 {
      let package_value = json_option_value_or(package_opt, json_null())
      if json_kind(package_value) != 3 {
        pkg_manifest_add_error(m)
      } else {
        let name = json_string_value(package_value, "")
        pkg_manifest_set_package(m, __str_ptr(name), 0, __str_len(name))
      }
    } else { 0 }

    let schema_opt = json_object_get(root, "manifest_version")
    if json_option_is_some(schema_opt) == 1 {
      let schema_value = json_option_value_or(schema_opt, json_null())
      if json_kind(schema_value) != 2 or json_number_value(schema_value, 0) != 1 {
        pkg_manifest_add_error(m)
      } else { mem_store64_at(m, 64, 1) }
    } else { 0 }

    let version_opt = json_object_get(root, "version")
    if json_option_is_some(version_opt) == 1 {
      let version_value = json_option_value_or(version_opt, json_null())
      if json_kind(version_value) != 3 { pkg_manifest_add_error(m) }
      else {
        let version = json_string_value(version_value, "")
        pkg_manifest_set_version(m, __str_ptr(version), __str_len(version))
      }
    } else { 0 }

    let weft_opt = json_object_get(root, "weft")
    if json_option_is_some(weft_opt) == 1 {
      let weft_value = json_option_value_or(weft_opt, json_null())
      if json_kind(weft_value) != 3 { pkg_manifest_add_error(m) }
      else {
        let weft_version = json_string_value(weft_value, "")
        pkg_manifest_set_weft(m, __str_ptr(weft_version), __str_len(weft_version))
      }
    } else { 0 }

    let deps_opt = json_object_get(root, "dependencies")
    if json_option_is_some(deps_opt) == 1 {
      let deps_value = json_option_value_or(deps_opt, json_null())
      if json_kind(deps_value) != 5 {
        pkg_manifest_add_error(m)
      } else {
        let mut deps = json_object_entries(deps_value)
        while list_empty<JsonEntry>(deps) == 0 {
          let dep_entry = list_first_or<JsonEntry>(deps, json_entry("", json_null()))
          let dep_name = json_entry_key(dep_entry)
          let dep_value = json_entry_value(dep_entry)
          if json_kind(dep_value) != 3 {
            pkg_manifest_add_error(m)
          } else {
            let dep_path = json_string_value(dep_value, "")
            let added = pkg_manifest_add_dep_from_parts(m, __str_ptr(dep_name), __str_len(dep_name), __str_ptr(dep_path), __str_len(dep_path))
            if added != 0 { pkg_manifest_add_error(m) } else { 0 }
          }
          deps = list_rest_or_nil<JsonEntry>(deps)
        }
      }
    } else { 0 }

    let bindings_opt = json_object_get(root, "trusted_bindings")
    if json_option_is_some(bindings_opt) == 1 {
      pkg_manifest_fill_module_array(m, json_option_value_or(bindings_opt, json_null()), pkg_manifest_trusted_bindings(m), 0)
    } else { 0 }

    let trust_opt = json_object_get(root, "trust")
    if json_option_is_some(trust_opt) == 1 {
      pkg_manifest_fill_trust(m, json_option_value_or(trust_opt, json_null()))
    } else { 0 }

    let exports_opt = json_object_get(root, "exports")
    if json_option_is_some(exports_opt) == 1 {
      pkg_manifest_fill_exports(m, json_option_value_or(exports_opt, json_null()))
    } else { 0 }
    m
  }
}

pub(package) fn pkg_manifest_file_path() -> i64 {
  let path = alloc_words(2)
  mem_store64_at(path, 0, __str_ptr("weft.pkg"))
  mem_store64_at(path, 8, __str_len("weft.pkg"))
  path
}

pub(package) fn pkg_manifest_load_default() -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_manifest_new() } else { pkg_manifest_parse(ptr, len) }
}

pub(package) fn pkg_import_first_segment_len(path_ptr: i64, path_len: i64) -> i64 {
  let mut i = 0
  let mut done = 0
  while i < path_len and done == 0 {
    if mem_load8_at(path_ptr, i) == 47 {
      done = 1
    } else {
      i = i + 1
    }
  }
  if done == 1 { i } else { 0 }
}

pub(package) fn pkg_resolve_result(ptr: i64, len: i64, status: i64) -> i64 {
  pkg_resolve_result_in_package(ptr, len, status, 0, ptr, len)
}

pub(package) fn pkg_resolve_result_in_package(ptr: i64, len: i64, status: i64, package_id: i64, logical_ptr: i64, logical_len: i64) -> i64 {
  let r = alloc_zeroed(48)
  mem_store64_at(r, 0, ptr)
  mem_store64_at(r, 8, len)
  mem_store64_at(r, 16, status)
  mem_store64_at(r, 24, package_id)
  mem_store64_at(r, 32, logical_ptr)
  mem_store64_at(r, 40, logical_len)
  r
}

pub(package) fn pkg_resolve_ptr(r: i64) -> i64 { mem_load64_at(r, 0) }
pub(package) fn pkg_resolve_len(r: i64) -> i64 { mem_load64_at(r, 8) }
pub(package) fn pkg_resolve_status(r: i64) -> i64 { mem_load64_at(r, 16) }
pub(package) fn pkg_resolve_package(r: i64) -> i64 { mem_load64_at(r, 24) }
pub(package) fn pkg_resolve_logical_ptr(r: i64) -> i64 { mem_load64_at(r, 32) }
pub(package) fn pkg_resolve_logical_len(r: i64) -> i64 { mem_load64_at(r, 40) }

pub(package) fn pkg_resolve_status_unsafe_path() -> i64 { 0 - 1 }
pub(package) fn pkg_resolve_status_malformed_manifest() -> i64 { 0 - 2 }
pub(package) fn pkg_resolve_status_source_conflict() -> i64 { 0 - 3 }
pub(package) fn pkg_resolve_status_name_mismatch() -> i64 { 0 - 4 }
pub(package) fn pkg_resolve_status_dependency_cycle() -> i64 { 0 - 5 }
pub(package) fn pkg_resolve_status_malformed_lock() -> i64 { 0 - 6 }
pub(package) fn pkg_resolve_status_lock_mismatch() -> i64 { 0 - 7 }
pub(package) fn pkg_resolve_status_dependency_trust_grant() -> i64 { 0 - 8 }

pub(package) fn pkg_resolve_path_eq(r: i64, expected: str) -> i64 {
  pkg_bytes_eq_at(pkg_resolve_ptr(r), 0, pkg_resolve_len(r), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_cache_path_for_parts(name_ptr: i64, name_len: i64, suffix_ptr: i64, suffix_len: i64) -> i64 {
  let b = buf_new(name_len + suffix_len + 16)
  bstr(b, ".weft/cache/")
  bscopy(b, name_ptr, name_len, 0)
  bu8(b, 47)
  bscopy(b, suffix_ptr, suffix_len, 0)
  let len = buf_len(b)
  pkg_resolve_result(buf_take_data(b), len, 1)
}

pub(package) fn pkg_cache_path_for_import(path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 { pkg_resolve_result(path_ptr, path_len, 0) }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result(path_ptr, path_len, 0 - 1)
    } else {
      pkg_cache_path_for_parts(path_ptr, seg_len, path_ptr + suffix_start, suffix_len)
    }
  }
}

pub(package) fn pkg_cache_path_eq(import_path: str, expected: str) -> i64 {
  let r = pkg_cache_path_for_import(__str_ptr(import_path), __str_len(import_path))
  if pkg_resolve_status(r) != 1 { 0 }
  else { pkg_resolve_path_eq(r, expected) }
}

pub(package) fn pkg_file_exists(path: i64) -> i64 {
  let file = read_file(path)
  if mem_load64_at(file, 8) > 0 { 1 } else { 0 }
}

pub(package) fn pkg_path_join(root_ptr: i64, root_len: i64, suffix_ptr: i64, suffix_len: i64) -> i64 {
  if root_len <= 0 { pkg_resolve_result(suffix_ptr, suffix_len, 1) }
  else {
    let b = buf_new(root_len + suffix_len + 2)
    bscopy(b, root_ptr, root_len, 0)
    bu8(b, 47)
    bscopy(b, suffix_ptr, suffix_len, 0)
    let len = buf_len(b)
    pkg_resolve_result(buf_take_data(b), len, 1)
  }
}

pub(package) fn pkg_manifest_load_at_root(root_ptr: i64, root_len: i64) -> i64 {
  let manifest_path = pkg_path_join(root_ptr, root_len, __str_ptr("weft.pkg"), __str_len("weft.pkg"))
  let path = alloc_words(2)
  mem_store64_at(path, 0, pkg_resolve_ptr(manifest_path))
  mem_store64_at(path, 8, pkg_resolve_len(manifest_path))
  let file = read_file(path)
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_manifest_new() } else { pkg_manifest_parse(ptr, len) }
}

pub(package) fn pkg_lock_resolver_file_path() -> i64 {
  let path = alloc_words(2)
  mem_store64_at(path, 0, __str_ptr("weft.lock"))
  mem_store64_at(path, 8, __str_len("weft.lock"))
  path
}

pub(package) fn pkg_lock_load_default() -> i64 {
  let file = read_file(pkg_lock_resolver_file_path())
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 { pkg_lock_data_absent() }
  else { pkg_lock_parse(pkg_str_view(ptr, len)) }
}

pub(package) fn pkg_lock_for_table(tt: i64) -> i64 {
  if tt == 0 { pkg_lock_data_absent() }
  else {
    let cached = mem_load64_at(tt + 152, 0)
    if cached != 0 { cached }
    else {
      let data = pkg_lock_load_default()
      mem_store64_at(tt + 152, 0, data)
      data
    }
  }
}

pub(package) fn pkg_lock_source_identity(root_ptr: i64, root_len: i64) -> str {
  if root_len <= 0 { "path:." }
  else {
    let b = buf_new(root_len + 5)
    bstr(b, "path:")
    bscopy(b, root_ptr, root_len, 0)
    runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
  }
}

-- Returns zero in unlocked mode, the matching lock entry on success, or -1
-- when a present semantic lock does not describe the resolved package.
pub(package) fn pkg_lock_match_package(data: i64, name_ptr: i64, name_len: i64, manifest: i64, source: str) -> i64 {
  if data == 0 or pkg_lock_data_status(data) == 0 { 0 }
  else {
    let entry = pkg_lock_data_find_name(data, name_ptr, name_len)
    if entry == 0 { 0 - 1 }
    else {
      let version_ok = pkg_bytes_eq_at(pkg_lock_entry_version_ptr(entry), 0, pkg_lock_entry_version_len(entry), pkg_manifest_version_ptr(manifest), 0, pkg_manifest_version_len(manifest))
      let source_ok = pkg_bytes_eq_at(pkg_lock_entry_source_ptr(entry), 0, pkg_lock_entry_source_len(entry), __str_ptr(source), 0, __str_len(source))
      let weft_ok = pkg_manifest_weft_eq(manifest, "0.1")
      if version_ok == 1 and source_ok == 1 and weft_ok == 1 { entry } else { 0 - 1 }
    }
  }
}

pub(package) fn pkg_manifest_resolve_import(m: i64, path_ptr: i64, path_len: i64) -> i64 {
  pkg_manifest_resolve_import_for_module(m, 0, 0, path_ptr, path_len)
}

pub(package) fn pkg_manifest_resolve_import_for_module(m: i64, tt: i64, importer_package: i64, path_ptr: i64, path_len: i64) -> i64 {
  pkg_manifest_resolve_import_from_root(m, tt, importer_package, 0, 0, path_ptr, path_len)
}

pub(package) fn pkg_manifest_resolve_import_from_root(m: i64, tt: i64, importer_package: i64, owner_root_ptr: i64, owner_root_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  let seg_len = pkg_import_first_segment_len(path_ptr, path_len)
  if seg_len <= 0 {
    let physical = pkg_path_join(owner_root_ptr, owner_root_len, path_ptr, path_len)
    pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 0, importer_package, path_ptr, path_len)
  }
  else {
    let suffix_start = seg_len + 1
    let suffix_len = path_len - suffix_start
    if pkg_path_is_safe(path_ptr, suffix_start, suffix_len) == 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, 0 - 1, importer_package, path_ptr, path_len)
    } else {
      let dep = pkg_manifest_find_dep(m, path_ptr, seg_len)
      if dep == 0 {
        let physical = pkg_path_join(owner_root_ptr, owner_root_len, path_ptr, path_len)
        pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 0, importer_package, path_ptr, path_len)
      } else {
        let dep_src = pkg_dep_src(dep)
        let dep_path_len = pkg_dep_path_len(dep)
        let dep_root = pkg_path_join(owner_root_ptr, owner_root_len, dep_src + pkg_dep_path_start(dep), dep_path_len)
        let dep_root_ptr = pkg_resolve_ptr(dep_root)
        let dep_root_len = pkg_resolve_len(dep_root)
        let dep_manifest = pkg_manifest_load_at_root(dep_root_ptr, dep_root_len)
        if pkg_manifest_error_count(dep_manifest) > 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_manifest(), importer_package, path_ptr, path_len)
        } else { if pkg_manifest_package_len(dep_manifest) > 0 and pkg_bytes_eq_at(pkg_manifest_package_start(dep_manifest), 0, pkg_manifest_package_len(dep_manifest), path_ptr, 0, seg_len) == 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_name_mismatch(), importer_package, path_ptr, path_len)
        } else { if pkg_manifest_trust_grant_count(dep_manifest) > 0 {
          pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_dependency_trust_grant(), importer_package, path_ptr, path_len)
        } else {
          let existing_package = if tt == 0 { 0 } else { pkg_identity_find_name(tt, path_ptr, seg_len) }
          let closes_cycle = if existing_package == 0 { 0 } else { pkg_identity_is_ancestor(tt, importer_package, mem_load64_at(existing_package, 16)) }
          if closes_cycle == 1 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_dependency_cycle(), importer_package, path_ptr, path_len)
          } else {
          let lock_data = if tt == 0 { 0 } else { mem_load64_at(tt + 152, 0) }
          let lock_entry = pkg_lock_match_package(lock_data, path_ptr, seg_len, dep_manifest, pkg_lock_source_identity(dep_root_ptr, dep_root_len))
          if lock_entry < 0 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_lock_mismatch(), importer_package, path_ptr, path_len)
          } else {
          let content_ptr = if lock_entry == 0 { 0 } else { pkg_lock_entry_content_ptr(lock_entry) }
          let content_len = if lock_entry == 0 { 0 } else { pkg_lock_entry_content_len(lock_entry) }
          let package_id = if tt == 0 { 0 } else { pkg_identity_intern_under_owner_with_content(tt, path_ptr, seg_len, dep_root_ptr, dep_root_len, dep_manifest, importer_package, content_ptr, content_len) }
          if package_id < 0 {
            pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_source_conflict(), importer_package, path_ptr, path_len)
          } else {
            let physical = pkg_path_join(dep_root_ptr, dep_root_len, path_ptr + suffix_start, suffix_len)
            pkg_resolve_result_in_package(pkg_resolve_ptr(physical), pkg_resolve_len(physical), 1, package_id, path_ptr + suffix_start, suffix_len)
          }
          }
          }
        } } }
      }
    }
  }
}

pub(package) fn pkg_resolve_default_import(tt: i64, importer_package: i64, path_ptr: i64, path_len: i64) -> i64 {
  if importer_package == 0 {
    let lock_data = pkg_lock_for_table(tt)
    let manifest = pkg_manifest_load_default()
    if pkg_lock_data_status(lock_data) < 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_lock(), importer_package, path_ptr, path_len)
    } else {
      let root_lock = pkg_lock_match_package(lock_data, pkg_manifest_package_start(manifest), pkg_manifest_package_len(manifest), manifest, "path:.")
      if root_lock < 0 {
        pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_lock_mismatch(), importer_package, path_ptr, path_len)
      } else {
        let content_ptr = if root_lock == 0 { 0 } else { pkg_lock_entry_content_ptr(root_lock) }
        let content_len = if root_lock == 0 { 0 } else { pkg_lock_entry_content_len(root_lock) }
        pkg_identity_register_root_with_content(tt, manifest, content_ptr, content_len)
        pkg_manifest_resolve_import_from_root(manifest, tt, importer_package, 0, 0, path_ptr, path_len)
      }
    }
  } else {
    let owner = pkg_identity_find_id(tt, importer_package)
    if owner == 0 {
      pkg_resolve_result_in_package(path_ptr, path_len, pkg_resolve_status_malformed_manifest(), importer_package, path_ptr, path_len)
    } else {
      pkg_manifest_resolve_import_from_root(pkg_identity_manifest(owner), tt, importer_package, pkg_identity_root_ptr(owner), pkg_identity_root_len(owner), path_ptr, path_len)
    }
  }
}

pub(package) fn pkg_write_file(path: i64, data_ptr: i64, data_len: i64) -> i64 {
  let path_ptr = mem_load64_at(path, 0)
  let path_len = mem_load64_at(path, 8)
  let path_buf = alloc_zeroed(path_len + 1)
  mem_copy(path_buf, path_ptr, path_len)
  mem_store8_at(path_buf, path_len, 0)
  let fd = sys_open(path_buf, 1537, 420)
  if fd < 0 { 1 }
  else {
    let written = sys_write(fd, data_ptr, data_len)
    sys_close(fd)
    if written == data_len { 0 } else { 1 }
  }
}

pub(package) fn pkg_manifest_render_into(b: i64, m: i64) -> i64 {
  bstr(b, json_stringify(pkg_manifest_to_json(m)))
  bu8(b, 10)
  buf_len(b)
}

pub(package) fn pkg_manifest_text_list_json(entries: i64) -> Json {
  let mut items: List<Json> = list_nil<Json>()
  let mut i = nlist_len(entries) - 1
  while i >= 0 {
    items = list_cons<Json>(json_string(pkg_manifest_text(nlist_get(entries, i))), items)
    i = i - 1
  }
  json_array(items)
}

pub(package) fn pkg_trust_grant_json(grant: i64) -> Json {
  json_object(
    list_cons<JsonEntry>(json_entry("version", json_string(pkg_str_view(pkg_trust_grant_version_ptr(grant), pkg_trust_grant_version_len(grant)))),
    list_cons<JsonEntry>(json_entry("source", json_string(pkg_str_view(pkg_trust_grant_source_ptr(grant), pkg_trust_grant_source_len(grant)))),
    list_cons<JsonEntry>(json_entry("content", json_string(pkg_str_view(pkg_trust_grant_content_ptr(grant), pkg_trust_grant_content_len(grant)))),
    list_cons<JsonEntry>(json_entry("modules", pkg_manifest_text_list_json(pkg_trust_grant_modules(grant))), list_nil<JsonEntry>()))))
  )
}

pub(package) fn pkg_manifest_trust_json(m: i64) -> Json {
  let grants = pkg_manifest_trust_grants(m)
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  let mut i = nlist_len(grants) - 1
  while i >= 0 {
    let grant = nlist_get(grants, i)
    entries = list_cons<JsonEntry>(json_entry(pkg_str_view(pkg_trust_grant_name_ptr(grant), pkg_trust_grant_name_len(grant)), pkg_trust_grant_json(grant)), entries)
    i = i - 1
  }
  json_object(entries)
}

pub(package) fn pkg_export_json(entry: i64) -> Json {
  let module = pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry))
  let declaration = pkg_str_view(pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry))
  let mut fields = list_cons<JsonEntry>(json_entry("declaration", json_string(declaration)), list_nil<JsonEntry>())
  fields = list_cons<JsonEntry>(json_entry("module", json_string(module)), fields)
  if pkg_export_kind(entry) == pkg_export_kind_grammar() {
    fields = list_append<JsonEntry>(fields, json_entry("execution", json_string(pkg_export_execution_name(pkg_export_execution(entry)))))
  } else { 0 }
  json_object(fields)
}

pub(package) fn pkg_manifest_export_kind_json(m: i64, kind: i64) -> Json {
  let exports = pkg_manifest_exports(m)
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  let mut i = nlist_len(exports) - 1
  while i >= 0 {
    let entry = nlist_get(exports, i)
    if pkg_export_kind(entry) == kind {
      entries = list_cons<JsonEntry>(json_entry(pkg_str_view(pkg_export_name_ptr(entry), pkg_export_name_len(entry)), pkg_export_json(entry)), entries)
    } else { 0 }
    i = i - 1
  }
  json_object(entries)
}

pub(package) fn pkg_manifest_export_kind_count(m: i64, kind: i64) -> i64 {
  let exports = pkg_manifest_exports(m)
  let mut count = 0
  for i in 0..nlist_len(exports) {
    if pkg_export_kind(nlist_get(exports, i)) == kind { count = count + 1 } else { 0 }
  }
  count
}

pub(package) fn pkg_manifest_exports_json(m: i64) -> Json {
  let mut entries: List<JsonEntry> = list_nil<JsonEntry>()
  if pkg_manifest_export_kind_count(m, pkg_export_kind_grammar()) > 0 {
    entries = list_append<JsonEntry>(entries, json_entry("grammars", pkg_manifest_export_kind_json(m, pkg_export_kind_grammar())))
  } else { 0 }
  if pkg_manifest_export_kind_count(m, pkg_export_kind_tool()) > 0 {
    entries = list_append<JsonEntry>(entries, json_entry("tools", pkg_manifest_export_kind_json(m, pkg_export_kind_tool())))
  } else { 0 }
  json_object(entries)
}

pub(package) fn pkg_manifest_to_json(m: i64) -> Json {
  let mut dep_entries: List<JsonEntry> = list_nil<JsonEntry>()
  let deps = pkg_manifest_deps(m)
  for i in 0..nlist_len(deps) {
    let dep = nlist_get(deps, i)
    let dep_src = pkg_dep_src(dep)
    let name = pkg_str_view(dep_src + pkg_dep_name_start(dep), pkg_dep_name_len(dep))
    let path = pkg_str_view(dep_src + pkg_dep_path_start(dep), pkg_dep_path_len(dep))
    dep_entries = list_cons<JsonEntry>(json_entry(name, json_string(path)), dep_entries)
  }
  dep_entries = list_reverse<JsonEntry>(dep_entries)
  let mut root: List<JsonEntry> = list_cons<JsonEntry>(json_entry("dependencies", json_object(dep_entries)), list_nil<JsonEntry>())
  root = list_cons<JsonEntry>(json_entry("weft", json_string(pkg_str_view(pkg_manifest_weft_ptr(m), pkg_manifest_weft_len(m)))), root)
  root = list_cons<JsonEntry>(json_entry("version", json_string(pkg_str_view(pkg_manifest_version_ptr(m), pkg_manifest_version_len(m)))), root)
  root = list_cons<JsonEntry>(json_entry("manifest_version", json_number(pkg_manifest_schema_version(m))), root)
  if pkg_manifest_package_len(m) > 0 {
    root = list_cons<JsonEntry>(json_entry("package", json_string(pkg_str_view(pkg_manifest_package_start(m), pkg_manifest_package_len(m)))), root)
  } else { 0 }
  if pkg_manifest_trusted_binding_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("trusted_bindings", pkg_manifest_text_list_json(pkg_manifest_trusted_bindings(m))))
  } else { 0 }
  if pkg_manifest_trust_grant_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("trust", pkg_manifest_trust_json(m)))
  } else { 0 }
  if pkg_manifest_export_count(m) > 0 {
    root = list_append<JsonEntry>(root, json_entry("exports", pkg_manifest_exports_json(m)))
  } else { 0 }
  json_object(root)
}

pub(package) fn pkg_manifest_rendered_eq(m: i64, expected: str) -> i64 {
  let b = buf_new(256)
  pkg_manifest_render_into(b, m)
  pkg_bytes_eq_at(buf_ptr(b), 0, buf_len(b), __str_ptr(expected), 0, __str_len(expected))
}

pub(package) fn pkg_stdout(msg: str) -> i64 {
  sys_write(1, __str_ptr(msg), __str_len(msg))
}

pub(package) fn pkg_stderr(msg: str) -> i64 {
  sys_write(2, __str_ptr(msg), __str_len(msg))
}

pub(package) fn pkg_cli_exports() -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let src = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 {
    pkg_stderr("pkg: missing weft.pkg\n")
    1
  } else {
    let manifest = pkg_manifest_parse(src, len)
    if pkg_manifest_error_count(manifest) > 0 {
      pkg_stderr("pkg: malformed weft.pkg\n")
      1
    } else {
      let rendered = json_stringify(pkg_manifest_exports_json(manifest))
      pkg_stdout(rendered)
      pkg_stdout("\n")
      0
    }
  }
}

pub(package) fn pkg_cli_init(name_ptr: i64, name_len: i64) -> i64 {
  if pkg_name_is_valid(name_ptr, 0, name_len) == 0 {
    pkg_stderr("pkg: invalid package name\n")
    1
  } else {
    let existing = read_file(pkg_manifest_file_path())
    if mem_load64_at(existing, 8) > 0 {
      pkg_stderr("pkg: weft.pkg already exists\n")
      1
    } else {
      let manifest = pkg_manifest_new()
      pkg_manifest_set_package(manifest, name_ptr, 0, name_len)
      pkg_manifest_set_version(manifest, __str_ptr("0.1.0"), __str_len("0.1.0"))
      let b = buf_new(name_len + 48)
      pkg_manifest_render_into(b, manifest)
      if pkg_write_file(pkg_manifest_file_path(), buf_ptr(b), buf_len(b)) == 0 {
        pkg_stdout("pkg: wrote weft.pkg\n")
        0
      } else {
        pkg_stderr("pkg: could not write weft.pkg\n")
        1
      }
    }
  }
}

pub(package) fn pkg_cli_add(name_ptr: i64, name_len: i64, path_ptr: i64, path_len: i64) -> i64 {
  let file = read_file(pkg_manifest_file_path())
  let src = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if len <= 0 {
    pkg_stderr("pkg: missing weft.pkg\n")
    1
  } else {
    let manifest = pkg_manifest_parse(src, len)
    if pkg_manifest_error_count(manifest) > 0 or pkg_manifest_package_len(manifest) <= 0 {
      pkg_stderr("pkg: malformed weft.pkg\n")
      1
    } else {
      let added = pkg_manifest_add_dep_from_parts(manifest, name_ptr, name_len, path_ptr, path_len)
      if added != 0 {
        pkg_stderr("pkg: invalid or duplicate dependency\n")
        1
      } else {
        let b = buf_new(len + name_len + path_len + 32)
        pkg_manifest_render_into(b, manifest)
        if pkg_write_file(pkg_manifest_file_path(), buf_ptr(b), buf_len(b)) == 0 {
          pkg_stdout("pkg: added dependency\n")
          0
        } else {
          pkg_stderr("pkg: could not write weft.pkg\n")
          1
        }
      }
    }
  }
}
