pub(package) fn pkg_identifier_is_valid(src: i64, start: i64, len: i64) -> i64 {
  if len <= 0 or is_alpha(mem_load8_at(src, start)) == 0 { 0 }
  else {
    let mut i = 1
    let mut ok = 1
    while i < len {
      if is_alnum(mem_load8_at(src, start + i)) == false { ok = 0 } else { 0 }
      i = i + 1
    }
    ok
  }
}

