-- compiler/package_exports.weft -- package-qualified grammar/tool discovery.
--
-- Manifest metadata resolves back to ordinary module declaration facts. It
-- never creates another namespace and cannot widen declaration visibility.

use compiler/diagnose.{*}
use compiler/lib.{*}
use compiler/module.{*}
use compiler/package.{*}
use runtime/buffer.{*}
use runtime/memory.{mem_load64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{*}
use stdlib/diagnostic/registry.{*}
use stdlib/diagnostic/schema.{*}

pub(package) fn package_export_status_pending() -> i64 { 0 }
pub(package) fn package_export_status_resolved() -> i64 { 1 }
pub(package) fn package_export_status_missing_declaration() -> i64 { 0 - 1 }
pub(package) fn package_export_status_wrong_kind() -> i64 { 0 - 2 }
pub(package) fn package_export_status_not_public() -> i64 { 0 - 3 }

pub(package) fn package_export_expected_namespace(entry: i64) -> i64 {
  if pkg_export_kind(entry) == pkg_export_kind_grammar() { module_decl_namespace_type() }
  else { module_decl_namespace_value() }
}

pub(package) fn package_export_find_other_namespace(tt: i64, module_entry: i64, expected: i64, name_ptr: i64, name_len: i64) -> i64 {
  let mut namespace = module_decl_namespace_value()
  let mut found = 0
  while namespace <= module_decl_namespace_constructor() and found == 0 {
    if namespace == expected { 0 }
    else { found = module_decl_fact_find_indexed(tt, module_entry, 0, namespace, name_ptr, 0, name_len) }
    namespace = namespace + 1
  }
  found
}

-- Resolution is lazy: only a module already selected into the package graph
-- is audited. A future build/run consumer can select an export module through
-- the same resolver, then call this exact fact producer.
pub(package) fn package_export_resolve_loaded(tt: i64, package_id: i64, entry: i64) -> i64 {
  if pkg_export_audit_state(entry) != package_export_status_pending() { pkg_export_audit_state(entry) }
  else {
    let module_entry = module_fact_find_path(tt, pkg_export_module_ptr(entry), pkg_export_module_len(entry), package_id)
    if module_entry == 0 { package_export_status_pending() }
    else {
      let expected = package_export_expected_namespace(entry)
      let declaration = module_decl_fact_find_indexed(tt, module_entry, 0, expected, pkg_export_declaration_ptr(entry), 0, pkg_export_declaration_len(entry))
      let status = if declaration == 0 {
        if package_export_find_other_namespace(tt, module_entry, expected, pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry)) == 0 {
          package_export_status_missing_declaration()
        } else { package_export_status_wrong_kind() }
      } else { if module_decl_fact_visibility_code(declaration) != module_visibility_public() {
        package_export_status_not_public()
      } else {
        pkg_export_set_resolved_declaration(entry, declaration)
        package_export_status_resolved()
      } }
      pkg_export_set_audit_state(entry, status)
      status
    }
  }
}

pub(package) fn package_export_kind_name(entry: i64) -> str {
  if pkg_export_kind(entry) == pkg_export_kind_grammar() { "grammar" } else { "tool" }
}

pub(package) fn package_export_problem(status: i64) -> str {
  if status == package_export_status_missing_declaration() { "does not name a declaration in its module" }
  else { if status == package_export_status_wrong_kind() { "names the wrong declaration kind" }
  else { if status == package_export_status_not_public() { "names a declaration that is not public" }
  else { "is invalid" } } }
}

pub(package) fn package_export_message(entry: i64, status: i64) -> str {
  let b = buf_new(pkg_export_name_len(entry) + pkg_export_module_len(entry) + pkg_export_declaration_len(entry) + 96)
  bstr(b, "package ")
  bstr(b, package_export_kind_name(entry))
  bstr(b, " export '")
  bscopy(b, pkg_export_name_ptr(entry), pkg_export_name_len(entry), 0)
  bstr(b, "' ")
  bstr(b, package_export_problem(status))
  bstr(b, ": ")
  bscopy(b, pkg_export_module_ptr(entry), pkg_export_module_len(entry), 0)
  bstr(b, ".")
  bscopy(b, pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry), 0)
  runtime_str_from_bytes_copy(buf_ptr(b), buf_len(b))
}

pub(package) fn package_export_diagnose(identity: i64, entry: i64, status: i64) -[Diagnose]> i64 {
  if pkg_export_is_diagnosed(entry) == 1 { 0 }
  else {
    pkg_export_mark_diagnosed(entry)
    Diagnose.report(Diagnostic(
      DiagnosticSeverityError,
      DiagnosticClassLink,
      diagnostic_code_package_export_invalid(),
      package_export_message(entry, status),
      DiagnosticLocationNone,
      DiagnosticRelatedLocationNil,
      DiagnosticFieldCons(
        DiagnosticFieldText("package", pkg_str_view(pkg_identity_name_ptr(identity), pkg_identity_name_len(identity))),
        DiagnosticFieldCons(
          DiagnosticFieldText("kind", package_export_kind_name(entry)),
          DiagnosticFieldCons(
            DiagnosticFieldText("export", pkg_str_view(pkg_export_name_ptr(entry), pkg_export_name_len(entry))),
            DiagnosticFieldCons(
              DiagnosticFieldText("module", pkg_str_view(pkg_export_module_ptr(entry), pkg_export_module_len(entry))),
              DiagnosticFieldCons(DiagnosticFieldText("declaration", pkg_str_view(pkg_export_declaration_ptr(entry), pkg_export_declaration_len(entry))), DiagnosticFieldNil)
            )
          )
        )
      )
    ))
  }
}

pub(package) fn package_export_audit_loaded(tt: i64) -[Diagnose]> i64 {
  let identities = pkg_identity_entries(tt)
  let mut errors = 0
  for i in 0..nlist_len(identities) {
    let identity = nlist_get(identities, i)
    let exports = pkg_manifest_exports(pkg_identity_manifest(identity))
    for j in 0..nlist_len(exports) {
      let entry = nlist_get(exports, j)
      let status = package_export_resolve_loaded(tt, mem_load64_at(identity, 16), entry)
      if status < 0 {
        package_export_diagnose(identity, entry, status)
        errors = errors + 1
      } else { 0 }
    }
  }
  errors
}
