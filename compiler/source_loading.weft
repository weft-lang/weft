-- Retained compiler-host inputs. Resolution chooses authority before a loader
-- runs; grammars receive only the resulting immutable source span.

use compiler/source_owners as source_owners
use compiler/source_owners.{SourceOwners}
use compiler/source_input.{SourceRequest, SourceLoadResult, SourceLoaded, SourceUnavailable}
use stdlib/source.{Source}
use stdlib/diagnostic/schema.{DiagnosticSourceBuffer}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/vector as vector
use stdlib/vector.{Vector, vector_push, vector_len, vector_get_in_bounds}

-- Mutable acquisition state is scoped to assembly. Published products receive
-- an immutable owner snapshot, never this builder or its acquisition closure.
pub (package) type SourceLoadScope = opaque(Vector<SourceOwners>, SourceOwners)

pub (package) type SourceLoader<E> = ((SourceRequest) -[E]> SourceLoadResult, SourceLoadScope)

pub (package) fn source_loader<E>(acquire: (SourceRequest) -[E]> SourceLoadResult, inherited: SourceOwners) -> SourceLoader<E> {
  (acquire, SourceLoadScope((vector.new<SourceOwners>(), inherited)))
}

pub (package) fn source_loader_register<E>(loader: SourceLoader<E>, request: SourceRequest, source: Source) -> Source {
  let distinct = source_loader_distinct_source(loader, source)
  source_loader_retain(loader, source_owners.with_source(source_owners.new(), request, distinct))
  distinct
}

fn source_loader_distinct_source<E>(loader: SourceLoader<E>, source: Source) -> Source {
  let shared = match loader.1 {
    SourceLoadScope((owners, inherited)) -> {
      let mut found = source_owners.contains_source_storage(inherited, source)
      for index in 0..vector_len<SourceOwners>(owners) {
        if source_owners.contains_source_storage(vector_get_in_bounds<SourceOwners>(owners, index), source) { found = true }
      }
      found
    }
  }
  if shared {
    -- Remove this storage-identity copy when module identities no longer use
    -- source addresses. Public diagnostic identity is independent of storage.
    let text = runtime_str_from_bytes_copy(__str_ptr(source.text), __str_len(source.text))
    let identity = match source.identity {
      DiagnosticSourceBuffer(buffer) -> if buffer == __str_ptr(source.text) { DiagnosticSourceBuffer(__str_ptr(text)) } else { source.identity }
      other -> other
    }
    Source { text: text, identity: identity }
  } else { source }
}

pub (package) fn source_loader_retain<E>(loader: SourceLoader<E>, retained: SourceOwners) -> nil {
  match loader.1 {
    SourceLoadScope((owners, _)) -> {
      vector_push<SourceOwners>(owners, retained)
      nil
    }
  }
}

pub (package) fn source_loader_load<E>(loader: SourceLoader<E>, request: SourceRequest) -[E]> SourceLoadResult {
  let acquire = loader.0
  match loader.1 {
    SourceLoadScope((owners, inherited)) -> {
      match source_owners.lookup(inherited, request) {
        SourceLoaded(source) -> return SourceLoaded(source)
        SourceUnavailable -> nil
      }
      for index in 0..vector_len<SourceOwners>(owners) {
        let entry = vector_get_in_bounds<SourceOwners>(owners, index)
        match source_owners.lookup(entry, request) {
          SourceLoaded(source) -> return SourceLoaded(source)
          SourceUnavailable -> nil
        }
      }
      match acquire(request) {
        SourceLoaded(source) -> SourceLoaded(source_loader_register(loader, request, source))
        SourceUnavailable -> SourceUnavailable
      }
    }
  }
}

pub (package) fn source_loader_owners<E>(loader: SourceLoader<E>) -> SourceOwners {
  match loader.1 {
    SourceLoadScope((values, inherited)) -> {
      let mut owners = inherited
      for index in 0..vector_len<SourceOwners>(values) {
        owners = source_owners.combined(owners, vector_get_in_bounds<SourceOwners>(values, index))
      }
      owners
    }
  }
}

-- The legacy function forest remains private checker storage. Its source
-- backing is nevertheless a value and must accompany every returned forest.
pub (package) type LoadedModuleSyntax { functions: i64, owners: SourceOwners }
