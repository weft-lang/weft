}

pub type SemanticEffectOperationUseFact {
  SemanticEffectOperationUse(SemanticEffectAtomFact, str, SemanticTypeFact, SemanticSourceLocationFact, SemanticSourceLocationFact),
  SemanticEffectOperationUseOther(str)
}

pub type SemanticAssociatedTypeUseFact {
  SemanticAssociatedTypeUse(SemanticTypeFact, str, SemanticTypeFact, SemanticSourceLocationFact, SemanticSourceLocationFact),
  SemanticAssociatedTypeUseOther(str)
}

pub type SemanticMatchArmFact {
  SemanticMatchArm(SemanticTypeFact, SemanticTypeFact, bool, SemanticSourceLocationFact),
  SemanticMatchArmOther(str)
}

pub type SemanticConformanceDecisionFact {
  SemanticConformanceYes,
  SemanticConformanceNo,
  SemanticConformanceUnknown(str),
  SemanticConformanceDecisionOther(str)
}

pub type SemanticConformanceFact {
  SemanticConformance(SemanticTypeFact, str, SemanticConformanceDecisionFact),
  SemanticConformanceOther(str)
}

pub type SemanticBindingFact {
  SemanticBinding(str, SemanticSymbolKind, SemanticTypeFact),
  SemanticBindingOther(str)
}

pub type SemanticBindingFactList {
  SemanticBindingFactListNil,
  SemanticBindingFactListCons(SemanticBindingFact, SemanticBindingFactList),
  SemanticBindingFactListOther(str)
}

pub type SemanticFact {
  SemanticFactFunction(SemanticFunctionFact),
  SemanticFactTypeDeclaration(SemanticTypeDeclarationFact),
  SemanticFactEffectDeclaration(SemanticEffectDeclarationFact),
  SemanticFactSymbol(SemanticSymbolFact),
  SemanticFactEffectAtomUse(SemanticEffectAtomUseFact),
  SemanticFactEffectOperationUse(SemanticEffectOperationUseFact),
  SemanticFactAssociatedTypeUse(SemanticAssociatedTypeUseFact),
  SemanticFactMatchArm(SemanticMatchArmFact),
  SemanticFactConformance(SemanticConformanceFact),
  SemanticFactOther(str)
}

pub type SemanticFactQuery {
  SemanticFactQueryFunction(str),
  SemanticFactQueryType(str),
  SemanticFactQueryPosition(i64),
  SemanticFactQueryConformance(SemanticTypeFact, str),
  SemanticFactQueryOther(str)
}

pub type SemanticFactResult {
  SemanticFactFound(SemanticFact),
  SemanticFactMissing,
  SemanticFactResultOther(str)
}

pub type SemanticFactEnvelope {
  SemanticFactEnvelope(SemanticFactSchemaVersion, SemanticFactResult),
  SemanticFactEnvelopeOther(str)
}

pub effect SemanticFacts {
  fn query(request: SemanticFactQuery) -> SemanticFactEnvelope
}

pub fn semantic_fact_schema_version() -> SemanticFactSchemaVersion {
  SemanticFactSchemaV1
}

pub(package) fn semantic_fact_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes_copy(ptr, len)
}

pub(package) fn semantic_fact_entry_name(entry: i64) -> str {
  semantic_type_fact_entry_name(entry)
}

pub(package) fn semantic_fact_trait_name(tt: i64, hash: i64) -> str {
  semantic_type_fact_trait_name(tt, hash)
}

pub(package) fn semantic_fact_effect_atom(atom: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectAtomFact {
  semantic_type_fact_effect_atom(atom, tt, src, tparams)
}

pub(package) fn semantic_fact_effects(effects: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectSetFact {
  semantic_type_fact_effects(effects, tt, src, tparams)
}

pub(package) fn semantic_fact_type(ty: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFact {
  semantic_type_fact(ty, tt, src, tparams)
}

pub(package) fn semantic_fact_parameters(params: i64, tt: i64, src: i64, tparams: i64) -> SemanticParameterFactList {
  if params == 0 { SemanticParameterFactListNil }
  else {
    let mut result = SemanticParameterFactListNil
    let mut i = nlist_len(params)
    while i > 0 {
      i = i - 1
      let param = nlist_get(params, i)
      result = SemanticParameterFactListCons(SemanticParameter(semantic_fact_copy(src + node_f1(param), node_f2(param)), semantic_fact_type(node_f3(param), tt, src, tparams)), result)
    }
    result
  }
}

pub(package) fn semantic_fact_trait_atom_name(tt: i64, atom: i64) -> str {
  let decl = trait_atom_decl(atom)
  if decl != 0 { semantic_fact_copy(module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl)) }
  else { semantic_fact_trait_name(tt, trait_atom_head(atom)) }
}

pub(package) fn semantic_fact_trait_bounds(bounds: i64, tt: i64) -> SemanticTraitBoundFactList {
  if bounds == 0 { SemanticTraitBoundFactListNil }
  else {
    let mut result = SemanticTraitBoundFactListNil
    let mut i = nlist_len(bounds)
    while i > 0 {
      i = i - 1
      result = SemanticTraitBoundFactListCons(SemanticTraitBound(semantic_fact_trait_atom_name(tt, nlist_get(bounds, i))), result)
    }
    result
  }
}

pub(package) fn semantic_fact_type_parameters(tparams: i64, src: i64, tt: i64) -> SemanticTypeParameterFactList {
  if tparams == 0 { SemanticTypeParameterFactListNil }
  else {
    let mut result = SemanticTypeParameterFactListNil
    let mut i = nlist_len(tparams)
    while i > 0 {
      i = i - 1
      let tparam = nlist_get(tparams, i)
      result = SemanticTypeParameterFactListCons(SemanticTypeParameter(
        semantic_fact_copy(src + node_f1(tparam), node_f2(tparam)),
        SemanticBoundsTraits(semantic_fact_trait_bounds(node_f4(tparam), tt))
      ), result)
    }
    result
  }
}

pub(package) fn semantic_fact_effect_operations(entry: i64, tt: i64) -> SemanticEffectOperationFactList {
  if entry == 0 { SemanticEffectOperationFactListNil }
  else {
    let src = ttable_entry_source(entry)
    let tparams = ttable_entry_tparams(entry)
    let ops = ttable_entry_items(entry)
    let mut result = SemanticEffectOperationFactListNil
    let mut i = ttable_entry_item_count(entry)
    while i > 0 {
      i = i - 1
      let op = nlist_get(ops, i)
      let operation = if node_tag(op) == 31 {
        SemanticEffectOperation(
          semantic_fact_copy(src + node_f1(op), node_f2(op)),
          semantic_fact_parameters(node_f3(op), tt, src, tparams),
          semantic_fact_type(effect_op_ret_type(op), tt, src, tparams),
          effect_op_is_deferred(op) != 0
        )
      } else { SemanticEffectOperationOther("invalid_effect_operation") }
      result = SemanticEffectOperationFactListCons(operation, result)
    }
    result
  }
}

pub(package) fn semantic_fact_purity(effects: i64) -> SemanticPurityFact {
  if effects == 0 or ty_tag(effects) != 10 { SemanticPurityOther("invalid_effect_set") }
  else { if ty_f2(effects) != 0 { SemanticPurityOpen }
  else { if nlist_len(ty_f1(effects)) == 0 { SemanticPurityPure } else { SemanticPurityEffectful } } }
}

pub(package) fn semantic_fact_return_shape(ty: i64) -> SemanticValueShapeFact {
  let shape = ir_value_shape_for_type(ty)
  if shape == ir_value_shape_unknown() { SemanticValueShapeUnknown }
  else {
    let mut lanes = SemanticValueLaneFactListNil
    let mut i = ir_value_shape_lane_count(shape)
    while i > 0 {
      i = i - 1
      let lane = ir_value_shape_lane_at_or(shape, i, 0)
      let public_lane = if lane == ir_value_lane_gpr() { SemanticValueLaneGpr }
        else { if lane == ir_value_lane_f32() { SemanticValueLaneF32 }
        else { if lane == ir_value_lane_f64() { SemanticValueLaneF64 }
        else { SemanticValueLaneOther("unknown") } } }
      lanes = SemanticValueLaneFactListCons(public_lane, lanes)
    }
    SemanticValueShapeExactWords(ir_value_shape_lane_count(shape), lanes)
  }
}

pub(package) fn semantic_fact_index_list_insert(indices: SemanticIndexFactList, index: i64) -> SemanticIndexFactList {
  match indices {
    SemanticIndexFactListNil -> SemanticIndexFactListCons(index, SemanticIndexFactListNil)
    SemanticIndexFactListCons(head, rest) -> {
      if index == head { indices }
      else { if index < head { SemanticIndexFactListCons(index, indices) }
      else { SemanticIndexFactListCons(head, semantic_fact_index_list_insert(rest, index)) } }
    }
    SemanticIndexFactListOther(name) -> SemanticIndexFactListOther(name)
  }
}

pub(package) fn semantic_fact_indices_from_ir(values: IrValueList) -> SemanticIndexFactList {
  match values {
    IrValueNil -> SemanticIndexFactListNil
    IrValueCons(value, rest) -> semantic_fact_index_list_insert(semantic_fact_indices_from_ir(rest), value)
  }
}

-- Optimizer-owned provenance stops here. The Stable layer projects only the
-- source-level parameter indices a result may borrow from; no SSA value or IR
-- identity crosses the L7 boundary.
pub(package) fn semantic_fact_ownership_from_borrow_summary(summary: IrBorrowSummary) -> SemanticOwnershipFact {
  match summary {
    IrBorrowSummaryKnown(indices) -> SemanticOwnershipBorrowedParameters(semantic_fact_indices_from_ir(indices))
    IrBorrowSummaryUnknown -> SemanticOwnershipUnknown
  }
}

pub(package) fn semantic_fact_function_entry_with_ownership(tt: i64, entry: i64, ownership: SemanticOwnershipFact) -> SemanticFactEnvelope {
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let src = mem_load64_at(entry, 24)
    let tparams = ftypes_entry_tparams(entry)
    let effects = ftypes_entry_effects(entry)
    let name = semantic_fact_copy(src + mem_load64_at(entry, 0), mem_load64_at(entry, 8))
    let fact = SemanticFunction(
      name,
      semantic_fact_parameters(ftypes_entry_params(entry), tt, src, tparams),
      semantic_fact_type(ftypes_entry_return_type(entry), tt, src, tparams),
      semantic_fact_effects(effects, tt, src, tparams),
      semantic_fact_purity(effects),
      ownership,
      semantic_fact_return_shape(ftypes_entry_return_type(entry)),
      SemanticBoundsTypeParameters(semantic_fact_type_parameters(tparams, src, tt))
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact)))
  }
}

pub(package) fn semantic_fact_function_entry(tt: i64, entry: i64) -> SemanticFactEnvelope {
  semantic_fact_function_entry_with_ownership(tt, entry, SemanticOwnershipUnknown)
}

pub(package) fn semantic_fact_resolve_function_entry(tt: i64, caller_src: i64, name: str) -> i64 {
  let functions = ttable_get_checked_functions(tt)
  if functions == 0 { 0 }
  else {
    let decl = module_scope_lookup_declaration(tt, caller_src, module_decl_namespace_value(), __str_ptr(name), 0, __str_len(name))
    if decl != 0 { ftypes_find_decl(functions, decl) }
    else {
      let candidate = ftypes_find(functions, __str_ptr(name), 0, __str_len(name))
      let candidate_decl = ftypes_entry_decl_fact(candidate)
      -- Opaque wrapping is checker-internal constructor transport attached to
      -- the type DeclId, not a source-level function. Stable lookup must fall
      -- through to the type declaration instead of exposing that private ABI.
      if candidate_decl != 0 and module_decl_fact_namespace(candidate_decl) == module_decl_namespace_type() { 0 }
      else { candidate }
    }
  }
}

pub(package) fn semantic_fact_query_function(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  semantic_fact_function_entry(tt, semantic_fact_resolve_function_entry(tt, caller_src, name))
}

pub(package) fn semantic_fact_type_declaration_entry(entry: i64, tt: i64) -> SemanticFactEnvelope {
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let kind = match ttable_entry_kind(entry) {
      0 -> SemanticTypeDeclarationRecord
      1 -> SemanticTypeDeclarationVariant
      5 -> SemanticTypeDeclarationOpaque
      3 -> SemanticTypeDeclarationTrait
      _ -> SemanticTypeDeclarationKindOther("unsupported")
    }
    let declaration = SemanticTypeDeclaration(
      semantic_fact_entry_name(entry),
      kind,
      semantic_fact_type_parameters(ttable_entry_tparams(entry), ttable_entry_source(entry), tt),
      ttable_entry_item_count(entry)
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactTypeDeclaration(declaration)))
  }
}

pub(package) fn semantic_fact_record_declaration_fields(entry: i64, tt: i64) -> SemanticRecordFieldFactList {
  if entry == 0 or ttable_entry_kind(entry) != 0 { SemanticRecordFieldFactListNil }
  else {
    let src = ttable_entry_source(entry)
    let tparams = ttable_entry_tparams(entry)
    let fields = ttable_entry_items(entry)
    let mut result = SemanticRecordFieldFactListNil
    let mut i = ttable_entry_item_count(entry)
    while i > 0 {
      i = i - 1
      let field = fields + i * 24
      result = SemanticRecordFieldFactListCons(SemanticRecordField(
        semantic_fact_copy(src + mem_load64_at(field, 0), mem_load64_at(field + 8, 0)),
        i,
        semantic_fact_type(mem_load64_at(field + 16, 0), tt, src, tparams)
      ), result)
    }
    result
  }
}

pub(package) fn semantic_fact_variant_declaration_items(entry: i64, tt: i64) -> SemanticVariantDeclarationFactList {
  if entry == 0 or ttable_entry_kind(entry) != 1 { SemanticVariantDeclarationFactListNil }
  else {
    let src = ttable_entry_source(entry)
    let tparams = ttable_entry_tparams(entry)
    let variants = ttable_entry_items(entry)
    let mut result = SemanticVariantDeclarationFactListNil
    let mut i = ttable_entry_item_count(entry)
    while i > 0 {
      i = i - 1
      let variant = variants + i * 40
      result = SemanticVariantDeclarationFactListCons(SemanticVariantDeclaration(
        semantic_fact_copy(src + mem_load64_at(variant, 0), mem_load64_at(variant + 8, 0)),
        semantic_type_fact_list(mem_load64_at(variant + 32, 0), tt, src, tparams)
      ), result)
    }
    result
  }
}

pub(package) fn semantic_fact_function_parts(
  tt: i64,
  src: i64,
  name_start: i64,
  name_len: i64,
  params: i64,
  result: i64,
  effects: i64,
  tparams: i64
) -> SemanticFunctionFact {
  SemanticFunction(
    semantic_fact_copy(src + name_start, name_len),
    semantic_fact_parameters(params, tt, src, tparams),
    semantic_fact_type(result, tt, src, tparams),
    semantic_fact_effects(effects, tt, src, tparams),
    semantic_fact_purity(effects),
    SemanticOwnershipUnknown,
    semantic_fact_return_shape(result),
    SemanticBoundsTypeParameters(semantic_fact_type_parameters(tparams, src, tt))
  )
}

pub(package) fn semantic_fact_trait_members(entry: i64, tt: i64) -> SemanticTraitMemberFactList {
  if entry == 0 or ttable_entry_kind(entry) != 3 { SemanticTraitMemberFactListNil }
  else {
    let src = ttable_entry_source(entry)
    let tparams = ttable_entry_tparams(entry)
    let members = ttable_entry_items(entry)
    let mut result = SemanticTraitMemberFactListNil
    let mut i = ttable_entry_item_count(entry)
    while i > 0 {
      i = i - 1
      let member = nlist_get(members, i)
      let fact = if node_tag(member) == 39 {
        let signature = node_f4(member)
        SemanticTraitMethod(semantic_fact_function_parts(
          tt,
          src,
          node_f1(member),
          node_f2(member),
          node_f3(member),
          node_f1(signature),
          node_f2(signature),
          tparams
        ))
      } else { if node_tag(member) == 42 {
        SemanticTraitAssociatedType(
          semantic_fact_copy(src + node_f1(member), node_f2(member)),
          semantic_fact_trait_bounds(node_f3(member), tt)
        )
      } else { SemanticTraitMemberOther("invalid_trait_member") } }
      result = SemanticTraitMemberFactListCons(fact, result)
    }
    result
  }
}

pub(package) fn semantic_fact_query_type(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  let type_entry = ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_type(), __str_ptr(name), 0, __str_len(name))
  let trait_entry = if type_entry == 0 { ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_trait(), __str_ptr(name), 0, __str_len(name)) } else { 0 }
  semantic_fact_type_declaration_entry(if type_entry != 0 { type_entry } else { trait_entry }, tt)
}

pub(package) fn semantic_fact_effect_declaration_entry(entry: i64, tt: i64) -> SemanticFactEnvelope {
  if entry == 0 or ttable_entry_kind(entry) != 2 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let declaration = SemanticEffectDeclaration(
      semantic_fact_entry_name(entry),
      semantic_fact_type_parameters(ttable_entry_tparams(entry), ttable_entry_source(entry), tt),
      semantic_fact_effect_operations(entry, tt)
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(declaration)))
  }
}

pub(package) fn semantic_fact_query_effect(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  semantic_fact_effect_declaration_entry(
    ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_effect(), __str_ptr(name), 0, __str_len(name)),
    tt
  )
}

pub(package) fn semantic_fact_symbol_kind(kind: i64) -> SemanticSymbolKind {
  if kind == semantic_symbol_kind_function() { SemanticSymbolFunction }
  else { if kind == semantic_symbol_kind_constructor() { SemanticSymbolConstructor }
  else { if kind == semantic_symbol_kind_local() { SemanticSymbolLocal }
  else { if kind == semantic_symbol_kind_parameter() { SemanticSymbolParameter }
  else { if kind == semantic_symbol_kind_pattern() { SemanticSymbolPattern }
  else { if kind == semantic_symbol_kind_loop() { SemanticSymbolLoopBinding }
  else { if kind == semantic_symbol_kind_tuple_position() { SemanticSymbolTuplePosition }
  else { SemanticSymbolKindOther("unknown") } } } } } } }
}

pub(package) fn semantic_fact_source_location(tt: i64, src: i64, start: i64, len: i64) -> SemanticSourceLocationFact {
  let source_entry = ttable_find_source_buffer_entry(tt, src)
  let path_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 24, 0) }
  let path = if path_len == 0 { "" } else { semantic_fact_copy(mem_load64_at(source_entry + 16, 0), path_len) }
  SemanticSourceLocation(path, start, len)
}

pub(package) fn semantic_fact_query_position(tt: i64, caller_src: i64, offset: i64) -> SemanticFactEnvelope {
  let entry = ttable_find_semantic_symbol_fact(tt, caller_src, offset)
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let use_src = semantic_symbol_fact_use_source(entry)
    let use_start = semantic_symbol_fact_use_start(entry)
    let use_len = semantic_symbol_fact_use_len(entry)
    let def_src = semantic_symbol_fact_definition_source(entry)
    let occurrence = semantic_fact_source_location(tt, use_src, use_start, use_len)
    let kind = semantic_symbol_fact_kind(entry)
    let definition = if kind == semantic_symbol_kind_tuple_position() or kind == semantic_symbol_kind_match_arm() { SemanticSourceLocationOther("none") }
      else { semantic_fact_source_location(tt, def_src, semantic_symbol_fact_definition_start(entry), semantic_symbol_fact_definition_len(entry)) }
    let fact = if kind == semantic_symbol_kind_effect_atom() {
      SemanticFactEffectAtomUse(SemanticEffectAtomUse(semantic_fact_effect_atom(semantic_symbol_fact_context(entry), tt, use_src, semantic_symbol_fact_tparams(entry)), occurrence, definition))
    } else { if kind == semantic_symbol_kind_effect_operation() {
      SemanticFactEffectOperationUse(SemanticEffectOperationUse(
        semantic_fact_effect_atom(semantic_symbol_fact_context(entry), tt, use_src, semantic_symbol_fact_tparams(entry)),
        semantic_fact_copy(use_src + use_start, use_len),
        semantic_fact_type(semantic_symbol_fact_type(entry), tt, use_src, semantic_symbol_fact_tparams(entry)),
        occurrence,
        definition
      ))
    } else { if kind == semantic_symbol_kind_associated_type() {
      let projection = semantic_symbol_fact_context(entry)
      SemanticFactAssociatedTypeUse(SemanticAssociatedTypeUse(
        semantic_fact_type(ty_f1(projection), tt, use_src, semantic_symbol_fact_tparams(entry)),
        semantic_fact_copy(def_src + semantic_symbol_fact_definition_start(entry), semantic_symbol_fact_definition_len(entry)),
        semantic_fact_type(semantic_symbol_fact_type(entry), tt, use_src, semantic_symbol_fact_tparams(entry)),
        occurrence,
        definition
      ))
    } else { if kind == semantic_symbol_kind_match_arm() {
      let context = semantic_symbol_fact_context(entry)
      SemanticFactMatchArm(SemanticMatchArm(
        semantic_fact_type(semantic_symbol_fact_type(entry), tt, use_src, semantic_symbol_fact_tparams(entry)),
        semantic_fact_type(semantic_match_arm_context_residual(context), tt, use_src, semantic_symbol_fact_tparams(entry)),
        semantic_match_arm_context_guarded(context) != 0,
        occurrence
      ))
    } else {
      let symbol = SemanticSymbol(
        semantic_fact_copy(use_src + use_start, use_len),
        semantic_fact_symbol_kind(kind),
        semantic_fact_type(semantic_symbol_fact_type(entry), tt, if kind == semantic_symbol_kind_tuple_position() { use_src } else { def_src }, semantic_symbol_fact_tparams(entry)),
        occurrence,
        definition
      )
      SemanticFactSymbol(symbol)
    } } } }
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(fact))
  }
}

-- Cursor positions commonly sit immediately after an identifier. Keep that
-- transport convention at the stable fact boundary so LSP and MCP do not each
-- grow their own off-by-one recovery rule.
pub(package) fn semantic_fact_query_cursor_position(tt: i64, caller_src: i64, offset: i64) -> SemanticFactEnvelope {
  let exact = semantic_fact_query_position(tt, caller_src, offset)
  match exact {
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) -> if offset > 0 { semantic_fact_query_position(tt, caller_src, offset - 1) } else { exact }
    _ -> exact
  }
}

pub(package) fn semantic_fact_cursor_entry(tt: i64, caller_src: i64, offset: i64) -> i64 {
  let exact = ttable_find_semantic_symbol_fact(tt, caller_src, offset)
  if exact != 0 or offset <= 0 { exact }
  else { ttable_find_semantic_symbol_fact(tt, caller_src, offset - 1) }
}

pub(package) fn semantic_fact_query_conformance_at(tt: i64, caller_src: i64, offset: i64, trait_name: str) -> SemanticFactEnvelope {
  let entry = semantic_fact_cursor_entry(tt, caller_src, offset)
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let raw_ty = semantic_symbol_fact_type(entry)
    let tparams = semantic_symbol_fact_tparams(entry)
    let use_src = semantic_symbol_fact_use_source(entry)
    let public_ty = semantic_fact_type(raw_ty, tt, use_src, tparams)
    let trait_decl = module_scope_lookup_declaration(tt, caller_src, module_decl_namespace_trait(), __str_ptr(trait_name), 0, __str_len(trait_name))
    if trait_decl == 0 {
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactConformance(
        SemanticConformance(public_ty, trait_name, SemanticConformanceUnknown("unknown_trait"))
      )))
    } else {
      let trait_atom = ty_qualified_trait(trait_decl)
      let carried = if ty_tag(raw_ty) == 12 { impl_tparam_has_bound(tparams, ty_var_id(raw_ty), trait_atom) } else { false }
      let conforms = if carried { 1 } else { ctable_conforms_type_atom(ttable_get_ct(tt), raw_ty, trait_atom) }
      let canonical_name = semantic_fact_copy(module_decl_fact_name_ptr(trait_decl), module_decl_fact_name_len(trait_decl))
      let decision = if conforms == 1 { SemanticConformanceYes } else { SemanticConformanceNo }
      SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactConformance(
        SemanticConformance(public_ty, canonical_name, decision)
      )))
    }
  }
}

pub(package) fn semantic_fact_binding_name(binding: SemanticBindingFact) -> str {
  match binding {
    SemanticBinding(name, kind, ty) -> name
    SemanticBindingOther(name) -> name
  }
}

pub(package) fn semantic_fact_binding_list_contains(bindings: SemanticBindingFactList, name_ptr: i64, name_len: i64) -> i64 {
  match bindings {
    SemanticBindingFactListNil -> 0
    SemanticBindingFactListCons(binding, rest) -> {
      let name = semantic_fact_binding_name(binding)
      if __str_len(name) == name_len and src_eq_at(__str_ptr(name), 0, name_ptr, 0, name_len) == 1 { 1 }
      else { semantic_fact_binding_list_contains(rest, name_ptr, name_len) }
    }
    SemanticBindingFactListOther(name) -> 0
  }
}

pub(package) fn semantic_fact_scope_binding(tt: i64, scope: i64) -> SemanticBindingFact {
  let name_ptr = module_scope_entry_name_ptr(scope)
  let name_len = module_scope_entry_name_len(scope)
  let name = semantic_fact_copy(name_ptr, name_len)
  if module_scope_entry_kind(scope) == module_scope_kind_module() {
    SemanticBinding(name, SemanticSymbolModule, SemanticTypeOther("module"))
  } else {
    let decl = module_scope_entry_target(scope)
    let namespace = module_decl_fact_namespace(decl)
    if namespace == module_decl_namespace_value() or namespace == module_decl_namespace_constructor() {
      let functions = ttable_get_checked_functions(tt)
      let entry = if functions == 0 { 0 } else { ftypes_find_decl(functions, decl) }
      let kind = if namespace == module_decl_namespace_constructor() { SemanticSymbolConstructor } else { SemanticSymbolFunction }
      let ty = if entry == 0 { SemanticTypeOther("value") }
        else { semantic_fact_type(ftypes_entry_fn_type(entry), tt, ftypes_entry_source(entry), ftypes_entry_tparams(entry)) }
      SemanticBinding(name, kind, ty)
    } else { if namespace == module_decl_namespace_type() {
      SemanticBinding(name, SemanticSymbolType, SemanticTypeNamed(name, SemanticTypeFactListNil))
    } else { if namespace == module_decl_namespace_effect() {
      SemanticBinding(name, SemanticSymbolEffect, SemanticTypeOther("effect"))
    } else { if namespace == module_decl_namespace_trait() {
      SemanticBinding(name, SemanticSymbolTrait, SemanticTypeTrait(name))
    } else {
      SemanticBindingOther(name)
    } } } }
  }
}

pub(package) fn semantic_fact_visible_bindings(tt: i64, caller_src: i64, offset: i64) -> SemanticBindingFactList {
  let at = ttable_find_semantic_symbol_fact(tt, caller_src, offset)
  let preceding = if at != 0 or offset == 0 { at } else { ttable_find_semantic_symbol_fact(tt, caller_src, offset - 1) }
  let env = if preceding == 0 { 0 } else { semantic_symbol_fact_environment(preceding) }
  let tparams = if preceding == 0 { 0 } else { semantic_symbol_fact_tparams(preceding) }
  let mut bindings = SemanticBindingFactListNil
  let mut current = env
  while current != 0 {
    let source = tenv_entry_source(current)
    let start = tenv_entry_name_start(current)
    let len = tenv_entry_name_len(current)
    if semantic_fact_binding_list_contains(bindings, source + start, len) == 0 {
      bindings = SemanticBindingFactListCons(
        SemanticBinding(
          semantic_fact_copy(source + start, len),
          semantic_fact_symbol_kind(tenv_entry_kind(current)),
          semantic_fact_type(tenv_entry_type(current), tt, source, tparams)
        ),
        bindings
      )
    } else { 0 }
    current = mem_load64_at(current + 32, 0)
  }
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, caller_src)
  for i in 0..module_fact_scope_count(tt) {
    let scope = module_fact_scope_at(tt, i)
    let name_ptr = module_scope_entry_name_ptr(scope)
    let name_len = module_scope_entry_name_len(scope)
    if caller_module != 0 and module_scope_entry_module(scope) == caller_module and module_scope_entry_status(scope) == module_scope_status_resolved() and module_scope_entry_kind(scope) != module_scope_kind_issue() and semantic_fact_binding_list_contains(bindings, name_ptr, name_len) == 0 {
      bindings = SemanticBindingFactListCons(semantic_fact_scope_binding(tt, scope), bindings)
    } else { 0 }
  }
  bindings
}

pub(package) fn semantic_fact_fields_at(tt: i64, caller_src: i64, offset: i64) -> SemanticBindingFactList {
  let symbol = if offset < 2 { 0 } else { ttable_find_semantic_symbol_fact(tt, caller_src, offset - 2) }
  if symbol == 0 { SemanticBindingFactListNil }
  else {
    let raw_ty = semantic_symbol_fact_type(symbol)
    let named_entry = if ty_tag(raw_ty) == 9 {
      let record = ttable_find_entry_by_hash_kind(tt, ty_f1(raw_ty), 0)
      if record == 0 { ttable_find_entry_by_hash_kind(tt, ty_f1(raw_ty), 1) } else { record }
    } else { 0 }
    let shape = if ty_is_record(raw_ty) { raw_ty }
      else { if named_entry != 0 { typeck_named_record_projection(tt, raw_ty) } else { 0 } }
    if shape == 0 { SemanticBindingFactListNil }
    else {
      let fields = ty_record_fields(shape)
      let tuple = ty_record_tuple_kind(shape) == 1
      let field_src = if named_entry == 0 { semantic_symbol_fact_definition_source(symbol) } else { ttable_entry_source(named_entry) }
      let mut result = SemanticBindingFactListNil
      let mut i = if fields == 0 { 0 } else { nlist_len(fields) }
      while i > 0 {
        i = i - 1
        let field = nlist_get(fields, i)
        let name_len = ty_record_field_name_len(field)
        if name_len > 0 {
          result = SemanticBindingFactListCons(
            SemanticBinding(
              semantic_fact_copy(field_src + ty_record_field_name_start(field), name_len),
              SemanticSymbolField,
              semantic_fact_type(ty_record_field_type(field), tt, field_src, semantic_symbol_fact_tparams(symbol))
            ),
            result
          )
        } else { if tuple {
          result = SemanticBindingFactListCons(
            SemanticBinding(
              runtime_int_to_str(i),
              SemanticSymbolTuplePosition,
              semantic_fact_type(ty_record_field_type(field), tt, field_src, semantic_symbol_fact_tparams(symbol))
            ),
            result
          )
        } else { 0 } }
      }
      result
    }
  }
}

pub(package) fn semantic_fact_effect_operations_at(tt: i64, caller_src: i64, offset: i64) -> SemanticBindingFactList {
  let symbol = ttable_find_semantic_symbol_fact_before(tt, caller_src, offset)
  if symbol == 0 or (semantic_symbol_fact_kind(symbol) != semantic_symbol_kind_effect_atom() and semantic_symbol_fact_kind(symbol) != semantic_symbol_kind_effect_operation()) {
    SemanticBindingFactListNil
  } else {
    let atom = semantic_symbol_fact_context(symbol)
    let entry = if atom == 0 { 0 }
      else { if ty_tag(atom) == 25 { ttable_lookup_decl_fact(tt, ty_f1(atom)) }
      else { ttable_find_entry_by_hash_kind(tt, effect_atom_head(atom), 2) } }
    if entry == 0 { SemanticBindingFactListNil }
    else {
      let ops = ttable_entry_items(entry)
      let mut i = ttable_entry_item_count(entry)
      let mut result = SemanticBindingFactListNil
      while i > 0 {
        i = i - 1
        let op = nlist_get(ops, i)
        result = SemanticBindingFactListCons(
          SemanticBinding(
            semantic_fact_copy(ttable_entry_source(entry) + node_f1(op), node_f2(op)),
            SemanticSymbolEffectOperation,
            semantic_fact_type(typeck_instantiated_effect_op_type(op, atom, entry), tt, caller_src, semantic_symbol_fact_tparams(symbol))
          ),
          result
        )
      }
      result
    }
  }
}
