-- compiler/semantic_fact.weft -- stable, versioned semantic facts for tools
--
-- This is the L7 boundary: public consumers see source-language facts, never
-- the checker's storage layout or typed IR. Every public union has an explicit
-- Other variant so old readers can remain total as the v1 vocabulary grows.

use compiler/lib.{*}
use compiler/module.{*}
use compiler/type_registry.{*}
use compiler/typeck.{*}
use compiler/types.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_from_bytes_copy}

pub type SemanticFactSchemaVersion {
  SemanticFactSchemaV1,
  SemanticFactSchemaVersionOther(str)
}

pub type SemanticTypeFact {
  SemanticTypeBottom,
  SemanticTypeTop,
  SemanticTypePrimitive(str),
  SemanticTypeNamed(str, SemanticTypeFactList),
  SemanticTypeVariable(str),
  SemanticTypeUnion(SemanticTypeFact, SemanticTypeFact),
  SemanticTypeIntersection(SemanticTypeFact, SemanticTypeFact),
  SemanticTypeComplement(SemanticTypeFact),
  SemanticTypeFunction(SemanticTypeFactList, SemanticTypeFact, SemanticEffectSetFact),
  SemanticTypeRecord(SemanticRecordFieldFactList, bool, bool),
  SemanticTypeContinuation(SemanticTypeFact, SemanticTypeFact),
  SemanticTypePointer(SemanticTypeFact, bool),
  SemanticTypeWeak(SemanticTypeFact),
  SemanticTypeUnique(SemanticTypeFact),
  SemanticTypeOwned(SemanticTypeFact),
  SemanticTypeTrait(str),
  SemanticTypeArray(SemanticTypeFact, i64),
  SemanticTypeSlice(SemanticTypeFact, bool),
  SemanticTypeAssociated(SemanticTypeFact, str),
  SemanticTypeOther(str)
}

pub type SemanticTypeFactList {
  SemanticTypeFactListNil,
  SemanticTypeFactListCons(SemanticTypeFact, SemanticTypeFactList),
  SemanticTypeFactListOther(str)
}

pub type SemanticRecordFieldFact {
  SemanticRecordField(str, i64, SemanticTypeFact),
  SemanticRecordFieldOther(str)
}

pub type SemanticRecordFieldFactList {
  SemanticRecordFieldFactListNil,
  SemanticRecordFieldFactListCons(SemanticRecordFieldFact, SemanticRecordFieldFactList),
  SemanticRecordFieldFactListOther(str)
}

pub type SemanticEffectAtomFact {
  SemanticEffectAtom(str, SemanticTypeFactList),
  SemanticEffectAtomOther(str)
}

pub type SemanticEffectAtomFactList {
  SemanticEffectAtomFactListNil,
  SemanticEffectAtomFactListCons(SemanticEffectAtomFact, SemanticEffectAtomFactList),
  SemanticEffectAtomFactListOther(str)
}

pub type SemanticEffectSetFact {
  SemanticEffectsClosed(SemanticEffectAtomFactList),
  SemanticEffectsOpen(SemanticEffectAtomFactList, str),
  SemanticEffectsOther(str)
}

pub type SemanticPurityFact {
  SemanticPurityPure,
  SemanticPurityEffectful,
  SemanticPurityOpen,
  SemanticPurityOther(str)
}

pub type SemanticOwnershipFact {
  SemanticOwnershipUnknown,
  SemanticOwnershipBorrowedParameters(SemanticIndexFactList),
  SemanticOwnershipOther(str)
}

pub type SemanticIndexFactList {
  SemanticIndexFactListNil,
  SemanticIndexFactListCons(i64, SemanticIndexFactList),
  SemanticIndexFactListOther(str)
}

pub type SemanticValueShapeFact {
  SemanticValueShapeUnknown,
  SemanticValueShapeWords(i64),
  SemanticValueShapeOther(str)
}

pub type SemanticBoundsFact {
  SemanticBoundsUnknown,
  SemanticBoundsOther(str)
}

pub type SemanticTypeParameterFact {
  SemanticTypeParameter(str, SemanticBoundsFact),
  SemanticTypeParameterOther(str)
}

pub type SemanticTypeParameterFactList {
  SemanticTypeParameterFactListNil,
  SemanticTypeParameterFactListCons(SemanticTypeParameterFact, SemanticTypeParameterFactList),
  SemanticTypeParameterFactListOther(str)
}

pub type SemanticParameterFact {
  SemanticParameter(str, SemanticTypeFact),
  SemanticParameterOther(str)
}

pub type SemanticParameterFactList {
  SemanticParameterFactListNil,
  SemanticParameterFactListCons(SemanticParameterFact, SemanticParameterFactList),
  SemanticParameterFactListOther(str)
}

pub type SemanticFunctionFact {
  SemanticFunction(
    str,
    SemanticParameterFactList,
    SemanticTypeFact,
    SemanticEffectSetFact,
    SemanticPurityFact,
    SemanticOwnershipFact,
    SemanticValueShapeFact,
    SemanticBoundsFact
  ),
  SemanticFunctionOther(str)
}

pub type SemanticTypeDeclarationKind {
  SemanticTypeDeclarationRecord,
  SemanticTypeDeclarationVariant,
  SemanticTypeDeclarationTrait,
  SemanticTypeDeclarationKindOther(str)
}

pub type SemanticTypeDeclarationFact {
  SemanticTypeDeclaration(str, SemanticTypeDeclarationKind, SemanticTypeParameterFactList, i64),
  SemanticTypeDeclarationOther(str)
}

pub type SemanticEffectOperationFact {
  SemanticEffectOperation(str, SemanticParameterFactList, SemanticTypeFact, bool),
  SemanticEffectOperationOther(str)
}

pub type SemanticEffectOperationFactList {
  SemanticEffectOperationFactListNil,
  SemanticEffectOperationFactListCons(SemanticEffectOperationFact, SemanticEffectOperationFactList),
  SemanticEffectOperationFactListOther(str)
}

pub type SemanticEffectDeclarationFact {
  SemanticEffectDeclaration(str, SemanticTypeParameterFactList, SemanticEffectOperationFactList),
  SemanticEffectDeclarationOther(str)
}

pub type SemanticSymbolKind {
  SemanticSymbolFunction,
  SemanticSymbolConstructor,
  SemanticSymbolLocal,
  SemanticSymbolParameter,
  SemanticSymbolPattern,
  SemanticSymbolLoopBinding,
  SemanticSymbolKindOther(str)
}

pub type SemanticSourceLocationFact {
  SemanticSourceLocation(str, i64, i64),
  SemanticSourceLocationOther(str)
}

pub type SemanticSymbolFact {
  SemanticSymbol(str, SemanticSymbolKind, SemanticTypeFact, SemanticSourceLocationFact, SemanticSourceLocationFact),
  SemanticSymbolOther(str)
}

pub type SemanticBindingFact {
  SemanticBinding(str, SemanticSymbolKind, SemanticTypeFact),
  SemanticBindingOther(str)
}

pub type SemanticBindingFactList {
  SemanticBindingFactListNil,
  SemanticBindingFactListCons(SemanticBindingFact, SemanticBindingFactList),
  SemanticBindingFactListOther(str)
}

pub type SemanticFact {
  SemanticFactFunction(SemanticFunctionFact),
  SemanticFactTypeDeclaration(SemanticTypeDeclarationFact),
  SemanticFactEffectDeclaration(SemanticEffectDeclarationFact),
  SemanticFactSymbol(SemanticSymbolFact),
  SemanticFactOther(str)
}

pub type SemanticFactQuery {
  SemanticFactQueryFunction(str),
  SemanticFactQueryType(str),
  SemanticFactQueryPosition(i64),
  SemanticFactQueryConformance(SemanticTypeFact, str),
  SemanticFactQueryOther(str)
}

pub type SemanticFactResult {
  SemanticFactFound(SemanticFact),
  SemanticFactMissing,
  SemanticFactResultOther(str)
}

pub type SemanticFactEnvelope {
  SemanticFactEnvelope(SemanticFactSchemaVersion, SemanticFactResult),
  SemanticFactEnvelopeOther(str)
}

pub effect SemanticFacts {
  fn query(request: SemanticFactQuery) -> SemanticFactEnvelope
}

pub fn semantic_fact_schema_version() -> SemanticFactSchemaVersion {
  SemanticFactSchemaV1
}

pub(package) fn semantic_fact_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes_copy(ptr, len)
}

pub(package) fn semantic_fact_primitive_name(id: i64) -> str {
  if id == PRIM_I64() { "i64" }
  else { if id == PRIM_STR() { "str" }
  else { if id == PRIM_BOOL() { "bool" }
  else { if id == PRIM_NIL() { "nil" }
  else { if id == PRIM_F64() { "f64" }
  else { if id == PRIM_I32() { "i32" }
  else { if id == PRIM_I8() { "i8" }
  else { if id == PRIM_I16() { "i16" }
  else { if id == PRIM_U8() { "u8" }
  else { if id == PRIM_U16() { "u16" }
  else { if id == PRIM_U32() { "u32" }
  else { if id == PRIM_U64() { "u64" }
  else { if id == PRIM_ISIZE() { "isize" }
  else { if id == PRIM_USIZE() { "usize" }
  else { if id == PRIM_F32() { "f32" } else { "unknown" } } } } } } } } } } } } } } }
}

pub(package) fn semantic_fact_entry_name(entry: i64) -> str {
  if entry == 0 { "unknown" }
  else { semantic_fact_copy(ttable_entry_name_ptr(entry), ttable_entry_name_len(entry)) }
}

pub(package) fn semantic_fact_named_name(tt: i64, hash: i64) -> str {
  let record = ttable_find_entry_by_hash_kind(tt, hash, 0)
  let variant = if record == 0 { ttable_find_entry_by_hash_kind(tt, hash, 1) } else { 0 }
  let entry = if record != 0 { record } else { variant }
  semantic_fact_entry_name(entry)
}

pub(package) fn semantic_fact_trait_name(tt: i64, hash: i64) -> str {
  semantic_fact_entry_name(ttable_find_entry_by_hash_kind(tt, hash, 3))
}

pub(package) fn semantic_fact_type_param_name(tparams: i64, src: i64, id: i64) -> str {
  if id == 0 - 1 { "Self" }
  else { if tparams == 0 { "unknown" }
  else {
    let mut i = 0
    let mut found = 0
    while i < nlist_len(tparams) and found == 0 {
      let tp = nlist_get(tparams, i)
      if node_f3(tp) == id { found = tp } else { i = i + 1 }
    }
    if found == 0 { "unknown" }
    else { semantic_fact_copy(src + node_f1(found), node_f2(found)) }
  } }
}

pub(package) fn semantic_fact_type_list(types: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFactList {
  if types == 0 { SemanticTypeFactListNil }
  else {
    let mut result = SemanticTypeFactListNil
    let mut i = nlist_len(types)
    while i > 0 {
      i = i - 1
      result = SemanticTypeFactListCons(semantic_fact_type(nlist_get(types, i), tt, src, tparams), result)
    }
    result
  }
}

pub(package) fn semantic_fact_record_fields(fields: i64, tt: i64, src: i64, tparams: i64, tuple: bool) -> SemanticRecordFieldFactList {
  if fields == 0 { SemanticRecordFieldFactListNil }
  else {
    let mut result = SemanticRecordFieldFactListNil
    let mut i = nlist_len(fields)
    while i > 0 {
      i = i - 1
      let field = nlist_get(fields, i)
      let len = ty_record_field_name_len(field)
      let name = if tuple or len == 0 { "" } else { semantic_fact_copy(src + ty_record_field_name_start(field), len) }
      result = SemanticRecordFieldFactListCons(SemanticRecordField(name, i, semantic_fact_type(ty_record_field_type(field), tt, src, tparams)), result)
    }
    result
  }
}

pub(package) fn semantic_fact_effect_atom(atom: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectAtomFact {
  if atom == 0 { SemanticEffectAtomOther("missing") }
  else {
    let tag = ty_tag(atom)
    if tag == 25 {
      let decl = ty_f1(atom)
      SemanticEffectAtom(semantic_fact_copy(module_decl_fact_name_ptr(decl), module_decl_fact_name_len(decl)), semantic_fact_type_list(effect_atom_args(atom), tt, src, tparams))
    } else { if tag == 11 {
      let entry = ttable_find_entry_by_hash_kind(tt, effect_atom_head(atom), 2)
      if entry == 0 { SemanticEffectAtomOther("unknown_effect") }
      else { SemanticEffectAtom(semantic_fact_entry_name(entry), semantic_fact_type_list(effect_atom_args(atom), tt, src, tparams)) }
    } else { SemanticEffectAtomOther("invalid_effect_atom") } }
  }
}

pub(package) fn semantic_fact_effect_atoms(atoms: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectAtomFactList {
  if atoms == 0 { SemanticEffectAtomFactListNil }
  else {
    let mut result = SemanticEffectAtomFactListNil
    let mut i = nlist_len(atoms)
    while i > 0 {
      i = i - 1
      result = SemanticEffectAtomFactListCons(semantic_fact_effect_atom(nlist_get(atoms, i), tt, src, tparams), result)
    }
    result
  }
}

pub(package) fn semantic_fact_effects(effects: i64, tt: i64, src: i64, tparams: i64) -> SemanticEffectSetFact {
  if effects == 0 { SemanticEffectsClosed(SemanticEffectAtomFactListNil) }
  else { if ty_tag(effects) != 10 { SemanticEffectsOther("invalid_effect_set") }
  else {
    let atoms = semantic_fact_effect_atoms(ty_f1(effects), tt, src, tparams)
    let tail = ty_f2(effects)
    if tail == 0 { SemanticEffectsClosed(atoms) }
    -- Effect tails reserve zero for a closed set, so the parser stores the
    -- owning type-parameter id plus one. Decode that representation here;
    -- the public fact carries the source name, never the internal integer.
    else { SemanticEffectsOpen(atoms, semantic_fact_type_param_name(tparams, src, tail - 1)) }
  } }
}

pub(package) fn semantic_fact_type(ty: i64, tt: i64, src: i64, tparams: i64) -> SemanticTypeFact {
  if ty == 0 { SemanticTypeOther("missing") }
  else {
    let tag = ty_tag(ty)
    match tag {
      0 -> SemanticTypeBottom
      1 -> SemanticTypeTop
      2 -> SemanticTypePrimitive(semantic_fact_primitive_name(ty_f1(ty)))
      3 -> SemanticTypeUnion(semantic_fact_type(ty_f1(ty), tt, src, tparams), semantic_fact_type(ty_f2(ty), tt, src, tparams))
      4 -> SemanticTypeIntersection(semantic_fact_type(ty_f1(ty), tt, src, tparams), semantic_fact_type(ty_f2(ty), tt, src, tparams))
      5 -> SemanticTypeComplement(semantic_fact_type(ty_f1(ty), tt, src, tparams))
      6 -> SemanticTypeFunction(semantic_fact_type_list(ty_f1(ty), tt, src, tparams), semantic_fact_type(ty_f2(ty), tt, src, tparams), semantic_fact_effects(ty_f3(ty), tt, src, tparams))
      7 -> SemanticTypeRecord(semantic_fact_record_fields(ty_record_fields(ty), tt, src, tparams, ty_record_tuple_kind(ty) != 0), ty_record_open(ty) != 0, ty_record_tuple_kind(ty) != 0)
      9 -> SemanticTypeNamed(semantic_fact_named_name(tt, ty_f1(ty)), semantic_fact_type_list(ty_f3(ty), tt, src, tparams))
      10 -> SemanticTypeOther("effect_set_is_not_a_value_type")
      12 -> SemanticTypeVariable(semantic_fact_type_param_name(tparams, src, ty_var_id(ty)))
      13 -> SemanticTypeTrait(semantic_fact_trait_name(tt, ty_f1(ty)))
      14 -> SemanticTypeContinuation(semantic_fact_type(ty_f1(ty), tt, src, tparams), semantic_fact_type(ty_f2(ty), tt, src, tparams))
      15 -> SemanticTypePointer(semantic_fact_type(ty_f1(ty), tt, src, tparams), ty_f2(ty) != 0)
      16 -> SemanticTypeWeak(semantic_fact_type(ty_f1(ty), tt, src, tparams))
      17 -> SemanticTypeOther("promoted_atomic_managed")
      18 -> SemanticTypeUnique(semantic_fact_type(ty_f1(ty), tt, src, tparams))
      19 -> SemanticTypeOwned(semantic_fact_type(ty_f1(ty), tt, src, tparams))
      21 -> SemanticTypeAssociated(semantic_fact_type(ty_f1(ty), tt, src, tparams), "unknown")
      22 -> SemanticTypeArray(semantic_fact_type(ty_array_inner(ty), tt, src, tparams), ty_array_length(ty))
      23 -> SemanticTypeSlice(semantic_fact_type(ty_slice_inner(ty), tt, src, tparams), ty_slice_mutable(ty) != 0)
      _ -> SemanticTypeOther("unsupported")
    }
  }
}

pub(package) fn semantic_fact_parameters(params: i64, tt: i64, src: i64, tparams: i64) -> SemanticParameterFactList {
  if params == 0 { SemanticParameterFactListNil }
  else {
    let mut result = SemanticParameterFactListNil
    let mut i = nlist_len(params)
    while i > 0 {
      i = i - 1
      let param = nlist_get(params, i)
      result = SemanticParameterFactListCons(SemanticParameter(semantic_fact_copy(src + node_f1(param), node_f2(param)), semantic_fact_type(node_f3(param), tt, src, tparams)), result)
    }
    result
  }
}

pub(package) fn semantic_fact_type_parameters(tparams: i64, src: i64) -> SemanticTypeParameterFactList {
  if tparams == 0 { SemanticTypeParameterFactListNil }
  else {
    let mut result = SemanticTypeParameterFactListNil
    let mut i = nlist_len(tparams)
    while i > 0 {
      i = i - 1
      let tparam = nlist_get(tparams, i)
      result = SemanticTypeParameterFactListCons(SemanticTypeParameter(semantic_fact_copy(src + node_f1(tparam), node_f2(tparam)), SemanticBoundsUnknown), result)
    }
    result
  }
}

pub(package) fn semantic_fact_effect_operations(entry: i64, tt: i64) -> SemanticEffectOperationFactList {
  if entry == 0 { SemanticEffectOperationFactListNil }
  else {
    let src = ttable_entry_source(entry)
    let tparams = ttable_entry_tparams(entry)
    let ops = ttable_entry_items(entry)
    let mut result = SemanticEffectOperationFactListNil
    let mut i = ttable_entry_item_count(entry)
    while i > 0 {
      i = i - 1
      let op = nlist_get(ops, i)
      let operation = if node_tag(op) == 31 {
        SemanticEffectOperation(
          semantic_fact_copy(src + node_f1(op), node_f2(op)),
          semantic_fact_parameters(node_f3(op), tt, src, tparams),
          semantic_fact_type(effect_op_ret_type(op), tt, src, tparams),
          effect_op_is_deferred(op) != 0
        )
      } else { SemanticEffectOperationOther("invalid_effect_operation") }
      result = SemanticEffectOperationFactListCons(operation, result)
    }
    result
  }
}

pub(package) fn semantic_fact_purity(effects: i64) -> SemanticPurityFact {
  if effects == 0 or ty_tag(effects) != 10 { SemanticPurityOther("invalid_effect_set") }
  else { if ty_f2(effects) != 0 { SemanticPurityOpen }
  else { if nlist_len(ty_f1(effects)) == 0 { SemanticPurityPure } else { SemanticPurityEffectful } } }
}

pub(package) fn semantic_fact_return_shape(ty: i64) -> SemanticValueShapeFact {
  let words = ty_value_storage_word_count(ty)
  if words == 0 { SemanticValueShapeUnknown } else { SemanticValueShapeWords(words) }
}

pub(package) fn semantic_fact_function_entry(tt: i64, entry: i64) -> SemanticFactEnvelope {
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let src = mem_load64_at(entry, 24)
    let tparams = ftypes_entry_tparams(entry)
    let effects = ftypes_entry_effects(entry)
    let name = semantic_fact_copy(src + mem_load64_at(entry, 0), mem_load64_at(entry, 8))
    let fact = SemanticFunction(
      name,
      semantic_fact_parameters(ftypes_entry_params(entry), tt, src, tparams),
      semantic_fact_type(ftypes_entry_return_type(entry), tt, src, tparams),
      semantic_fact_effects(effects, tt, src, tparams),
      semantic_fact_purity(effects),
      SemanticOwnershipUnknown,
      semantic_fact_return_shape(ftypes_entry_return_type(entry)),
      SemanticBoundsUnknown
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactFunction(fact)))
  }
}

pub(package) fn semantic_fact_query_function(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  let functions = ttable_get_checked_functions(tt)
  if functions == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let decl = module_scope_lookup_declaration(tt, caller_src, module_decl_namespace_value(), __str_ptr(name), 0, __str_len(name))
    let entry = if decl == 0 { ftypes_find(functions, __str_ptr(name), 0, __str_len(name)) } else { ftypes_find_decl(functions, decl) }
    semantic_fact_function_entry(tt, entry)
  }
}

pub(package) fn semantic_fact_type_declaration_entry(entry: i64) -> SemanticFactEnvelope {
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let kind = match ttable_entry_kind(entry) {
      0 -> SemanticTypeDeclarationRecord
      1 -> SemanticTypeDeclarationVariant
      3 -> SemanticTypeDeclarationTrait
      _ -> SemanticTypeDeclarationKindOther("unsupported")
    }
    let declaration = SemanticTypeDeclaration(
      semantic_fact_entry_name(entry),
      kind,
      semantic_fact_type_parameters(ttable_entry_tparams(entry), ttable_entry_source(entry)),
      ttable_entry_item_count(entry)
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactTypeDeclaration(declaration)))
  }
}

pub(package) fn semantic_fact_query_type(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  let type_entry = ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_type(), __str_ptr(name), 0, __str_len(name))
  let trait_entry = if type_entry == 0 { ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_trait(), __str_ptr(name), 0, __str_len(name)) } else { 0 }
  semantic_fact_type_declaration_entry(if type_entry != 0 { type_entry } else { trait_entry })
}

pub(package) fn semantic_fact_effect_declaration_entry(entry: i64, tt: i64) -> SemanticFactEnvelope {
  if entry == 0 or ttable_entry_kind(entry) != 2 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let declaration = SemanticEffectDeclaration(
      semantic_fact_entry_name(entry),
      semantic_fact_type_parameters(ttable_entry_tparams(entry), ttable_entry_source(entry)),
      semantic_fact_effect_operations(entry, tt)
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactEffectDeclaration(declaration)))
  }
}

pub(package) fn semantic_fact_query_effect(tt: i64, caller_src: i64, name: str) -> SemanticFactEnvelope {
  semantic_fact_effect_declaration_entry(
    ttable_lookup_resolved_decl(tt, caller_src, module_decl_namespace_effect(), __str_ptr(name), 0, __str_len(name)),
    tt
  )
}

pub(package) fn semantic_fact_symbol_kind(kind: i64) -> SemanticSymbolKind {
  if kind == semantic_symbol_kind_function() { SemanticSymbolFunction }
  else { if kind == semantic_symbol_kind_constructor() { SemanticSymbolConstructor }
  else { if kind == semantic_symbol_kind_local() { SemanticSymbolLocal }
  else { if kind == semantic_symbol_kind_parameter() { SemanticSymbolParameter }
  else { if kind == semantic_symbol_kind_pattern() { SemanticSymbolPattern }
  else { if kind == semantic_symbol_kind_loop() { SemanticSymbolLoopBinding }
  else { SemanticSymbolKindOther("unknown") } } } } } }
}

pub(package) fn semantic_fact_source_location(tt: i64, src: i64, start: i64, len: i64) -> SemanticSourceLocationFact {
  let source_entry = ttable_find_source_buffer_entry(tt, src)
  let path_len = if source_entry == 0 { 0 } else { mem_load64_at(source_entry + 24, 0) }
  let path = if path_len == 0 { "" } else { semantic_fact_copy(mem_load64_at(source_entry + 16, 0), path_len) }
  SemanticSourceLocation(path, start, len)
}

pub(package) fn semantic_fact_query_position(tt: i64, caller_src: i64, offset: i64) -> SemanticFactEnvelope {
  let entry = ttable_find_semantic_symbol_fact(tt, caller_src, offset)
  if entry == 0 { SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactMissing) }
  else {
    let use_src = semantic_symbol_fact_use_source(entry)
    let use_start = semantic_symbol_fact_use_start(entry)
    let use_len = semantic_symbol_fact_use_len(entry)
    let def_src = semantic_symbol_fact_definition_source(entry)
    let symbol = SemanticSymbol(
      semantic_fact_copy(use_src + use_start, use_len),
      semantic_fact_symbol_kind(semantic_symbol_fact_kind(entry)),
      semantic_fact_type(semantic_symbol_fact_type(entry), tt, def_src, semantic_symbol_fact_tparams(entry)),
      semantic_fact_source_location(tt, use_src, use_start, use_len),
      semantic_fact_source_location(tt, def_src, semantic_symbol_fact_definition_start(entry), semantic_symbol_fact_definition_len(entry))
    )
    SemanticFactEnvelope(SemanticFactSchemaV1, SemanticFactFound(SemanticFactSymbol(symbol)))
  }
}

pub(package) fn semantic_fact_binding_name(binding: SemanticBindingFact) -> str {
  match binding {
    SemanticBinding(name, kind, ty) -> name
    SemanticBindingOther(name) -> name
  }
}

pub(package) fn semantic_fact_binding_list_contains(bindings: SemanticBindingFactList, name_ptr: i64, name_len: i64) -> i64 {
  match bindings {
    SemanticBindingFactListNil -> 0
    SemanticBindingFactListCons(binding, rest) -> {
      let name = semantic_fact_binding_name(binding)
      if __str_len(name) == name_len and src_eq_at(__str_ptr(name), 0, name_ptr, 0, name_len) == 1 { 1 }
      else { semantic_fact_binding_list_contains(rest, name_ptr, name_len) }
    }
    SemanticBindingFactListOther(name) -> 0
  }
}

pub(package) fn semantic_fact_scope_binding(tt: i64, scope: i64) -> SemanticBindingFact {
  let name_ptr = module_scope_entry_name_ptr(scope)
  let name_len = module_scope_entry_name_len(scope)
  let name = semantic_fact_copy(name_ptr, name_len)
  if module_scope_entry_kind(scope) == module_scope_kind_module() {
    SemanticBinding(name, SemanticSymbolKindOther("module"), SemanticTypeOther("module"))
  } else {
    let decl = module_scope_entry_target(scope)
    let namespace = module_decl_fact_namespace(decl)
    if namespace == module_decl_namespace_value() or namespace == module_decl_namespace_constructor() {
      let functions = ttable_get_checked_functions(tt)
      let entry = if functions == 0 { 0 } else { ftypes_find_decl(functions, decl) }
      let kind = if namespace == module_decl_namespace_constructor() { SemanticSymbolConstructor } else { SemanticSymbolFunction }
      let ty = if entry == 0 { SemanticTypeOther("value") }
        else { semantic_fact_type(ftypes_entry_fn_type(entry), tt, ftypes_entry_source(entry), ftypes_entry_tparams(entry)) }
      SemanticBinding(name, kind, ty)
    } else { if namespace == module_decl_namespace_type() {
      SemanticBinding(name, SemanticSymbolKindOther("type"), SemanticTypeNamed(name, SemanticTypeFactListNil))
    } else { if namespace == module_decl_namespace_effect() {
      SemanticBinding(name, SemanticSymbolKindOther("effect"), SemanticTypeOther("effect"))
    } else { if namespace == module_decl_namespace_trait() {
      SemanticBinding(name, SemanticSymbolKindOther("trait"), SemanticTypeTrait(name))
    } else {
      SemanticBindingOther(name)
    } } } }
  }
}

pub(package) fn semantic_fact_visible_bindings(tt: i64, caller_src: i64, offset: i64) -> SemanticBindingFactList {
  let at = ttable_find_semantic_symbol_fact(tt, caller_src, offset)
  let preceding = if at != 0 or offset == 0 { at } else { ttable_find_semantic_symbol_fact(tt, caller_src, offset - 1) }
  let env = if preceding == 0 { 0 } else { semantic_symbol_fact_environment(preceding) }
  let tparams = if preceding == 0 { 0 } else { semantic_symbol_fact_tparams(preceding) }
  let mut bindings = SemanticBindingFactListNil
  let mut current = env
  while current != 0 {
    let source = tenv_entry_source(current)
    let start = tenv_entry_name_start(current)
    let len = tenv_entry_name_len(current)
    if semantic_fact_binding_list_contains(bindings, source + start, len) == 0 {
      bindings = SemanticBindingFactListCons(
        SemanticBinding(
          semantic_fact_copy(source + start, len),
          semantic_fact_symbol_kind(tenv_entry_kind(current)),
          semantic_fact_type(tenv_entry_type(current), tt, source, tparams)
        ),
        bindings
      )
    } else { 0 }
    current = mem_load64_at(current + 32, 0)
  }
  module_scope_build_all(tt)
  let caller_module = module_fact_find_source(tt, caller_src)
  for i in 0..module_fact_scope_count(tt) {
    let scope = module_fact_scope_at(tt, i)
    let name_ptr = module_scope_entry_name_ptr(scope)
    let name_len = module_scope_entry_name_len(scope)
    if caller_module != 0 and module_scope_entry_module(scope) == caller_module and module_scope_entry_status(scope) == module_scope_status_resolved() and module_scope_entry_kind(scope) != module_scope_kind_issue() and semantic_fact_binding_list_contains(bindings, name_ptr, name_len) == 0 {
      bindings = SemanticBindingFactListCons(semantic_fact_scope_binding(tt, scope), bindings)
    } else { 0 }
  }
  bindings
}

pub(package) fn semantic_fact_fields_at(tt: i64, caller_src: i64, offset: i64) -> SemanticBindingFactList {
  let symbol = if offset < 2 { 0 } else { ttable_find_semantic_symbol_fact(tt, caller_src, offset - 2) }
  if symbol == 0 { SemanticBindingFactListNil }
  else {
    let raw_ty = semantic_symbol_fact_type(symbol)
    let named_entry = if ty_tag(raw_ty) == 9 {
      let record = ttable_find_entry_by_hash_kind(tt, ty_f1(raw_ty), 0)
      if record == 0 { ttable_find_entry_by_hash_kind(tt, ty_f1(raw_ty), 1) } else { record }
    } else { 0 }
    let shape = if ty_is_record(raw_ty) { raw_ty }
      else { if named_entry != 0 { typeck_named_record_projection(tt, raw_ty) } else { 0 } }
    if shape == 0 { SemanticBindingFactListNil }
    else {
      let fields = ty_record_fields(shape)
      let field_src = if named_entry == 0 { semantic_symbol_fact_definition_source(symbol) } else { ttable_entry_source(named_entry) }
      let mut result = SemanticBindingFactListNil
      let mut i = if fields == 0 { 0 } else { nlist_len(fields) }
      while i > 0 {
        i = i - 1
        let field = nlist_get(fields, i)
        let name_len = ty_record_field_name_len(field)
        if name_len > 0 {
          result = SemanticBindingFactListCons(
            SemanticBinding(
              semantic_fact_copy(field_src + ty_record_field_name_start(field), name_len),
              SemanticSymbolKindOther("field"),
              semantic_fact_type(ty_record_field_type(field), tt, field_src, semantic_symbol_fact_tparams(symbol))
            ),
            result
          )
        } else { 0 }
      }
      result
    }
  }
}
