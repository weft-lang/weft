-- Observe diagnostics without changing their interpretation or the body's
-- residual effects. A private nominal counter keeps caller State atoms distinct.

use stdlib/diagnostic.{Diagnose, DiagnosticSeverityError}
use stdlib/state as state
use stdlib/state.{State}

type ErrorCount = opaque i64

fn increment_errors() -[State<ErrorCount>]> nil {
  state.modify((count: ErrorCount) => match count { ErrorCount(value) -> ErrorCount(value + 1) })
  nil
}

pub(package) fn observe_errors<T, E>(body: () -[Diagnose, E]> T) -[Diagnose, E]> (T, i64) {
  let observe: () -[State<ErrorCount>, Diagnose, E]> T = () => handle body() {
    Diagnose.report(diagnostic) -> {
      match diagnostic.severity() {
        DiagnosticSeverityError -> increment_errors()
        _ -> nil
      }
      Diagnose.report(diagnostic)
      resume(0)
    }
    Diagnose.error(message, position) -> {
      increment_errors()
      Diagnose.error(message, position)
      resume(0)
    }
    Diagnose.warn(message, position) -> { Diagnose.warn(message, position); resume(0) }
    Diagnose.note(message, position) -> { Diagnose.note(message, position); resume(0) }
  }
  let (result, count) = state.run(ErrorCount(0), observe)
  match count { ErrorCount(value) -> (result, value) }
}
