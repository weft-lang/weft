-- Checked adaptation between legacy compiler storage and structured locations.

use stdlib/diagnostic/schema.{*}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Err, Ok, Result}

pub (package) fn diagnostic_location_from_offsets(source: DiagnosticSource, start: i64, end: i64) -> DiagnosticLocation {
  if start < 0 or end < start { return DiagnosticLocationNone }
  DiagnosticSourceRange(source, start.to_usize_checked().unwrap(), end.to_usize_checked().unwrap())
}

-- Native source storage remains signed and bounded by its acquired length.
-- Rendering clamps a finite offset before crossing back to that representation.
pub (package) fn diagnostic_location_clamp_offset(offset: usize, source_len: i64) -> i64 {
  if source_len <= 0 { return 0 }
  let limit = source_len.to_usize_checked().unwrap()
  if offset >= limit { source_len }
  else { offset.to_u64().to_i64_checked().unwrap() }
}

-- Legacy transports use -1 for an unavailable absolute span. Never wrap a
-- full-width public offset or the addition of its source-buffer identity.
pub (package) fn diagnostic_location_absolute_offset(source: DiagnosticSource, offset: usize) -> i64 {
  let relative = match offset.to_u64().to_i64_checked() {
    Err(error) -> return 0 - 1
    Ok(value) -> value
  }
  match source {
    DiagnosticSourceBuffer(buffer) -> {
      if buffer < 0 or relative > 9223372036854775807 - buffer { 0 - 1 }
      else { buffer + relative }
    }
    _ -> relative
  }
}

-- Only legacy renderers without an acquired source length need this adapter.
pub (package) fn diagnostic_location_signed_offset(offset: usize) -> Option<i64> {
  match offset.to_u64().to_i64_checked() {
    Err(error) -> None
    Ok(value) -> Some(value)
  }
}
