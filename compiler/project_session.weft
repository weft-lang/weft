pub(package) fn project_session_parse_depends_on_overlay_set(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  if __str_len(context.overlay_set_identity) == 0 { 0 }
  else {
    incremental_query_depends_on<ProjectParseResult, ProjectOverlaySet>(
      project_session_parses(session),
      project_session_parse_key(session, context),
      project_session_overlay_sets(session),
      project_session_overlay_set_key(session, context)
    )
  }
}

