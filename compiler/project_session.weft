  incremental_query_depends_on<ProjectPreparedParseResult, ProjectPreparedSourceResult>(
    project_session_prepared_parses(session),
    project_session_prepared_parse_key(session, context),
    project_session_prepared_sources(session),
    project_session_prepared_source_key(session, context)
