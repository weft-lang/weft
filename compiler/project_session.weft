-- compiler/project_session.weft -- reusable project compilation session
--
-- A ProjectSession owns source inputs and the first honest compiler-as-data
-- query boundaries. Source bytes stay managed for as long as cached AST,
-- typed, and diagnostic values can refer to them. Disk and overlay identities
-- are distinct, and every semantic context dimension participates in keys.

use compiler/diagnose.{diagnose_report_severity_tag}
use compiler/grammar.{weft_grammar}
use compiler/incremental.{*}
use compiler/lib.{read_file_text}
use compiler/parse.{parse_module_with_loader}
use compiler/package.{pkg_identity_register_root, pkg_manifest_load_default_for_table}
use compiler/pipeline.{*}
use compiler/test_prepare.{*}
use compiler/type_registry.{str_hash, ttable_new, ttable_register_source}
use runtime/alloc.{alloc_words}
use runtime/buffer.{bstr, buf_len, buf_new, buf_ptr}
use runtime/memory.{mem_load8_at, mem_load64_at, mem_store64_at}
use runtime/string.{runtime_str_from_bytes_copy}
use stdlib/diagnostic.{diagnostic_uncoded}
use stdlib/diagnostic_type.{*}
use stdlib/string.{int_to_str, str_concat, str_eq}
use stdlib/vector.{vector_get_in_bounds, vector_insert_at, vector_len, vector_new, vector_push, vector_set}
use stdlib/vector_type.{Vector}

pub(package) fn project_source_origin_disk() -> i64 { 1 }

pub(package) fn project_source_origin_overlay() -> i64 { 2 }

pub(package) fn project_source_origin_generated() -> i64 { 3 }

pub(package) type ProjectQueryContext {
  package_id: i64,
    identity: str,
    physical_path: str,
    origin: i64,
    semantic_options: i64,
    target: i64,
    trusted: i64,
    strict: i64,
    can_grant_trust: i64,
    overlay_set_identity: str,
}

pub(package) type ProjectOverlaySet {
  ProjectOverlaySet(Vector<ProjectQueryContext>)
}

pub(package) type ProjectSourceSnapshot {
  ProjectSourcePresent(str),
    ProjectSourceMissing,
}

pub(package) type ProjectDiagnostics {
  ProjectDiagnostics(Vector<ProjectDiagnosticItem>, Vector<i64>, Vector<str>)
}

pub(package) type ProjectDiagnosticItem {
  ProjectDiagnosticItem(Diagnostic, bool, i64, i64, i64)
}

pub(package) type ProjectParseResult {
  ProjectParseSucceeded(AstModule, i64, ProjectDiagnostics),
    ProjectParseFailed(AstModule, i64, ProjectDiagnostics),
    ProjectParseSourceUnset,
    ProjectParseCycle(IncrementalDependencyCycle),
    ProjectParseCorrupt,
}

-- The preparation query is also the lifetime owner for generated test input.
-- Plain sources carry their already-parsed module so the next query can reuse
-- it without a second parse.
pub(package) type ProjectPreparedSourceResult {
  ProjectPreparedSourcePlain(AstModule, i64, ProjectDiagnostics),
    ProjectPreparedSourceTests(TestPreparedSource, ProjectDiagnostics),
    ProjectPreparedSourceParseFailed(ProjectParseResult),
    ProjectPreparedSourceUnset,
    ProjectPreparedSourceCycle(IncrementalDependencyCycle),
    ProjectPreparedSourceCorrupt,
}

pub(package) type ProjectPreparedParseResult {
  ProjectPreparedParseSucceeded(AstModule, i64, ProjectDiagnostics),
    ProjectPreparedParseFailed(AstModule, i64, ProjectDiagnostics),
    ProjectPreparedParseSourceUnset,
    ProjectPreparedParseCycle(IncrementalDependencyCycle),
    ProjectPreparedParseCorrupt,
}

pub(package) type ProjectCheckResult {
  ProjectCheckSucceeded(TypedModule, i64, ProjectDiagnostics, ProjectDiagnostics),
    ProjectCheckFailed(TypedModule, i64, ProjectDiagnostics, ProjectDiagnostics),
    ProjectCheckParseFailed(ProjectPreparedParseResult),
    ProjectCheckSourceUnset,
    ProjectCheckCycle(IncrementalDependencyCycle),
    ProjectCheckCorrupt,
}

pub(package) type ProjectSession {
  ProjectSession(
    IncrementalDatabase,
    IncrementalQueryTable<ProjectSourceSnapshot>,
    IncrementalQueryTable<ProjectOverlaySet>,
    IncrementalQueryTable<ProjectParseResult>,
    IncrementalQueryTable<ProjectPreparedSourceResult>,
    IncrementalQueryTable<ProjectPreparedParseResult>,
    IncrementalQueryTable<ProjectCheckResult>,
    Vector<ProjectQueryContext>,
    (i64, i64, i64, i64, i64) -> i64,
    i64
  )
}

pub(package) fn project_query_context(
  package_id: i64,
  identity: str,
  physical_path: str,
  origin: i64,
  semantic_options: i64,
  target: i64
) -> ProjectQueryContext {
  ProjectQueryContext {
    package_id: package_id,
      identity: identity,
      physical_path: physical_path,
      origin: origin,
      semantic_options: semantic_options,
      target: target,
      trusted: 0,
      strict: 1,
      can_grant_trust: 0,
      overlay_set_identity: "",
  }
}

pub(package) fn project_query_context_with_trust(
  package_id: i64,
  identity: str,
  physical_path: str,
  origin: i64,
  semantic_options: i64,
  target: i64,
  trusted: i64,
  strict: i64,
  can_grant_trust: i64
) -> ProjectQueryContext {
  ProjectQueryContext {
    package_id: package_id,
      identity: identity,
      physical_path: physical_path,
      origin: origin,
      semantic_options: semantic_options,
      target: target,
      trusted: trusted,
      strict: strict,
      can_grant_trust: can_grant_trust,
      overlay_set_identity: "",
  }
}

pub(package) fn project_query_context_with_overlay_set(
  package_id: i64,
  identity: str,
  physical_path: str,
  origin: i64,
  semantic_options: i64,
  target: i64,
  overlay_set_identity: str
) -> ProjectQueryContext {
  ProjectQueryContext {
    package_id: package_id,
      identity: identity,
      physical_path: physical_path,
      origin: origin,
      semantic_options: semantic_options,
      target: target,
      trusted: 0,
      strict: 1,
      can_grant_trust: 0,
      overlay_set_identity: overlay_set_identity,
  }
}

fn project_session_db(session: ProjectSession) -> IncrementalDatabase {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> db }
}

fn project_session_sources(session: ProjectSession) -> IncrementalQueryTable<ProjectSourceSnapshot> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> sources }
}

fn project_session_overlay_sets(session: ProjectSession) -> IncrementalQueryTable<ProjectOverlaySet> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> overlay_sets }
}

fn project_session_parses(session: ProjectSession) -> IncrementalQueryTable<ProjectParseResult> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> parses }
}

fn project_session_prepared_sources(session: ProjectSession) -> IncrementalQueryTable<ProjectPreparedSourceResult> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> prepared_sources }
}

fn project_session_prepared_parses(session: ProjectSession) -> IncrementalQueryTable<ProjectPreparedParseResult> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> prepared_parses }
}

fn project_session_checks(session: ProjectSession) -> IncrementalQueryTable<ProjectCheckResult> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> checks }
}

fn project_session_observed_sources(session: ProjectSession) -> Vector<ProjectQueryContext> {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> observed_sources }
}

fn project_session_root_registration(session: ProjectSession) -> (i64, i64, i64, i64, i64) -> i64 {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> register_root }
}

fn project_session_schema(session: ProjectSession) -> i64 {
  match session { ProjectSession(db, sources, overlay_sets, parses, prepared_sources, prepared_parses, checks, observed_sources, register_root, schema) -> schema }
}

fn project_context_options(context: ProjectQueryContext) -> i64 {
  context.semantic_options * 8 + context.trusted * 4 + context.strict * 2 + context.can_grant_trust
}

fn project_context_hash(context: ProjectQueryContext) -> i64 {
  str_hash(__str_ptr(context.identity), 0, __str_len(context.identity))
}

fn project_context_derived_identity(context: ProjectQueryContext) -> str {
  str_concat(
    int_to_str(__str_len(context.identity)),
    str_concat(":", str_concat(context.identity, str_concat(int_to_str(__str_len(context.overlay_set_identity)), str_concat(":", context.overlay_set_identity))))
  )
}

fn project_session_register_untrusted_root(tt: i64, src: i64, trusted: i64, strict: i64, can_grant_trust: i64) -> i64 {
  pipeline_mark_untrusted_root_origin(tt, src)
}

pub(package) fn project_session_new_with_root_registration(
  schema: i64,
  register_root: (i64, i64, i64, i64, i64) -> i64
) -> ProjectSession {
  let db = incremental_database_new()
  ProjectSession(
    db,
    incremental_query_table_new<ProjectSourceSnapshot>(db),
    incremental_query_table_new<ProjectOverlaySet>(db),
    incremental_query_table_new<ProjectParseResult>(db),
    incremental_query_table_new<ProjectPreparedSourceResult>(db),
    incremental_query_table_new<ProjectPreparedParseResult>(db),
    incremental_query_table_new<ProjectCheckResult>(db),
    vector_new<ProjectQueryContext>(),
    register_root,
    schema
  )
}

pub(package) fn project_session_new(schema: i64) -> ProjectSession {
  project_session_new_with_root_registration(schema, project_session_register_untrusted_root)
}

pub(package) fn project_session_database(session: ProjectSession) -> IncrementalDatabase {
  project_session_db(session)
}

pub(package) fn project_session_source_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  incremental_query_key<ProjectSourceSnapshot>(
    project_session_sources(session),
    context.package_id,
    context.identity,
    context.origin,
    0,
    0,
    project_session_schema(session),
    project_context_hash(context)
  )
}

pub(package) fn project_session_overlay_set_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  incremental_query_key<ProjectOverlaySet>(
    project_session_overlay_sets(session),
    context.package_id,
    context.overlay_set_identity,
    project_source_origin_overlay(),
    project_context_options(context),
    context.target,
    project_session_schema(session),
    str_hash(__str_ptr(context.overlay_set_identity), 0, __str_len(context.overlay_set_identity))
  )
}

pub(package) fn project_session_parse_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  let identity = project_context_derived_identity(context)
  incremental_query_key<ProjectParseResult>(
    project_session_parses(session),
    context.package_id,
    identity,
    context.origin,
    project_context_options(context),
    context.target,
    project_session_schema(session),
    str_hash(__str_ptr(identity), 0, __str_len(identity))
  )
}

pub(package) fn project_session_check_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  let identity = project_context_derived_identity(context)
  incremental_query_key<ProjectCheckResult>(
    project_session_checks(session),
    context.package_id,
    identity,
    context.origin,
    project_context_options(context),
    context.target,
    project_session_schema(session),
    str_hash(__str_ptr(identity), 0, __str_len(identity))
  )
}

pub(package) fn project_session_prepared_source_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  let identity = project_context_derived_identity(context)
  incremental_query_key<ProjectPreparedSourceResult>(
    project_session_prepared_sources(session),
    context.package_id,
    identity,
    context.origin,
    project_context_options(context),
    context.target,
    project_session_schema(session),
    str_hash(__str_ptr(identity), 0, __str_len(identity))
  )
}

pub(package) fn project_session_prepared_parse_key(session: ProjectSession, context: ProjectQueryContext) -> IncrementalQueryKey {
  let identity = project_context_derived_identity(context)
  incremental_query_key<ProjectPreparedParseResult>(
    project_session_prepared_parses(session),
    context.package_id,
    identity,
    context.origin,
    project_context_options(context),
    context.target,
    project_session_schema(session),
    str_hash(__str_ptr(identity), 0, __str_len(identity))
  )
}

fn project_source_fingerprint(snapshot: ProjectSourceSnapshot) -> IncrementalFingerprint {
  match snapshot {
    ProjectSourcePresent(content) -> {
      -- The explicit tag keeps a missing source distinct from every possible
      -- byte sequence, including the empty source.
      let tagged = str_concat("present:", content)
      incremental_fingerprint(tagged, str_hash(__str_ptr(tagged), 0, __str_len(tagged)))
    }
    ProjectSourceMissing -> incremental_fingerprint("missing:", str_hash(__str_ptr("missing:"), 0, __str_len("missing:")))
  }
}

pub(package) fn project_overlay_set_new() -> ProjectOverlaySet {
  ProjectOverlaySet(vector_new<ProjectQueryContext>())
}

fn project_overlay_set_contexts(overlays: ProjectOverlaySet) -> Vector<ProjectQueryContext> {
  match overlays { ProjectOverlaySet(contexts) -> contexts }
}

fn project_overlay_str_compare(left: str, right: str) -> i64 {
  let left_len = __str_len(left)
  let right_len = __str_len(right)
  let limit = if left_len < right_len { left_len } else { right_len }
  let mut i = 0
  let mut result = 0
  while i < limit and result == 0 {
    let left_byte = mem_load8_at(__str_ptr(left), i)
    let right_byte = mem_load8_at(__str_ptr(right), i)
    if left_byte < right_byte { result = 0 - 1 }
    else { if left_byte > right_byte { result = 1 } else { i = i + 1 } }
  }
  if result != 0 { result }
  else { if left_len < right_len { 0 - 1 } else { if left_len > right_len { 1 } else { 0 } } }
}

fn project_overlay_i64_compare(left: i64, right: i64) -> i64 {
  if left < right { 0 - 1 } else { if left > right { 1 } else { 0 } }
}

fn project_overlay_context_compare(left: ProjectQueryContext, right: ProjectQueryContext) -> i64 {
  let identity = project_overlay_str_compare(left.identity, right.identity)
  if identity != 0 { identity }
  else {
    let path = project_overlay_str_compare(left.physical_path, right.physical_path)
    if path != 0 { path }
    else {
      let package_order = project_overlay_i64_compare(left.package_id, right.package_id)
      if package_order != 0 { package_order }
      else {
        let origin = project_overlay_i64_compare(left.origin, right.origin)
        if origin != 0 { origin }
        else {
          let options = project_overlay_i64_compare(left.semantic_options, right.semantic_options)
          if options != 0 { options }
          else {
            let trusted = project_overlay_i64_compare(left.trusted, right.trusted)
            if trusted != 0 { trusted }
            else {
              let strict = project_overlay_i64_compare(left.strict, right.strict)
              if strict != 0 { strict }
              else {
                let grant = project_overlay_i64_compare(left.can_grant_trust, right.can_grant_trust)
                if grant != 0 { grant }
                else {
                  let target = project_overlay_i64_compare(left.target, right.target)
                  if target != 0 { target }
                  else { project_overlay_str_compare(left.overlay_set_identity, right.overlay_set_identity) }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub(package) fn project_overlay_set_add(overlays: ProjectOverlaySet, context: ProjectQueryContext) -> i64 {
  let contexts = project_overlay_set_contexts(overlays)
  let mut i = 0
  let mut order = 0 - 1
  while i < vector_len<ProjectQueryContext>(contexts) and order < 0 {
    order = project_overlay_context_compare(vector_get_in_bounds<ProjectQueryContext>(contexts, i), context)
    if order < 0 { i = i + 1 } else { 0 }
  }
  if order == 0 { 0 } else { vector_insert_at<ProjectQueryContext>(contexts, i, context) }
}

pub(package) fn project_overlay_set_len(overlays: ProjectOverlaySet) -> i64 {
  vector_len<ProjectQueryContext>(project_overlay_set_contexts(overlays))
}

fn project_overlay_fingerprint_append(buffer: i64, value: str) -> i64 {
  bstr(buffer, int_to_str(__str_len(value)))
  bstr(buffer, ":")
  bstr(buffer, value)
}

fn project_overlay_set_fingerprint(overlays: ProjectOverlaySet) -> IncrementalFingerprint {
  let contexts = project_overlay_set_contexts(overlays)
  let buffer = buf_new(vector_len<ProjectQueryContext>(contexts) * 64 + 32)
  project_overlay_fingerprint_append(buffer, "overlay-set-v1")
  project_overlay_fingerprint_append(buffer, int_to_str(vector_len<ProjectQueryContext>(contexts)))
  for i in 0..vector_len<ProjectQueryContext>(contexts) {
    let context = vector_get_in_bounds<ProjectQueryContext>(contexts, i)
    project_overlay_fingerprint_append(buffer, context.identity)
    project_overlay_fingerprint_append(buffer, context.physical_path)
    project_overlay_fingerprint_append(buffer, int_to_str(context.package_id))
    project_overlay_fingerprint_append(buffer, int_to_str(context.origin))
    project_overlay_fingerprint_append(buffer, int_to_str(context.semantic_options))
    project_overlay_fingerprint_append(buffer, int_to_str(context.target))
    project_overlay_fingerprint_append(buffer, int_to_str(context.trusted))
    project_overlay_fingerprint_append(buffer, int_to_str(context.strict))
    project_overlay_fingerprint_append(buffer, int_to_str(context.can_grant_trust))
    project_overlay_fingerprint_append(buffer, context.overlay_set_identity)
  }
  let content = runtime_str_from_bytes_copy(buf_ptr(buffer), buf_len(buffer))
  incremental_fingerprint(content, str_hash(__str_ptr(content), 0, __str_len(content)))
}

fn project_overlay_set_snapshot(overlays: ProjectOverlaySet) -> ProjectOverlaySet {
  let snapshot = project_overlay_set_new()
  let contexts = project_overlay_set_contexts(overlays)
  for i in 0..vector_len<ProjectQueryContext>(contexts) {
    project_overlay_set_add(snapshot, vector_get_in_bounds<ProjectQueryContext>(contexts, i))
  }
  snapshot
}

pub(package) fn project_session_set_overlay_set(session: ProjectSession, context: ProjectQueryContext, overlays: ProjectOverlaySet) -> IncrementalInputUpdate<ProjectOverlaySet> {
  if __str_len(context.overlay_set_identity) == 0 { IncrementalInputRejected<ProjectOverlaySet>() }
  else {
    -- Input values are immutable snapshots: callers may keep and reuse their
    -- mutable builder without changing cached membership behind its fingerprint.
    let snapshot = project_overlay_set_snapshot(overlays)
    incremental_input_set<ProjectOverlaySet>(
      project_session_overlay_sets(session),
      project_session_overlay_set_key(session, context),
      snapshot,
      project_overlay_set_fingerprint(snapshot)
    )
  }
}

pub(package) fn project_session_set_source(session: ProjectSession, context: ProjectQueryContext, content: str) -> IncrementalInputUpdate<ProjectSourceSnapshot> {
  let snapshot = ProjectSourcePresent(content)
  incremental_input_set<ProjectSourceSnapshot>(
    project_session_sources(session),
    project_session_source_key(session, context),
    snapshot,
    project_source_fingerprint(snapshot)
  )
}

pub(package) fn project_session_set_missing(session: ProjectSession, context: ProjectQueryContext) -> IncrementalInputUpdate<ProjectSourceSnapshot> {
  let snapshot = ProjectSourceMissing
  incremental_input_set<ProjectSourceSnapshot>(
    project_session_sources(session),
    project_session_source_key(session, context),
    snapshot,
    project_source_fingerprint(snapshot)
  )
}

pub(package) fn project_session_refresh_disk_source(session: ProjectSession, context: ProjectQueryContext) -> IncrementalInputUpdate<ProjectSourceSnapshot> {
  if context.origin != project_source_origin_disk() or __str_len(context.physical_path) == 0 {
    IncrementalInputRejected<ProjectSourceSnapshot>()
  } else {
    let file = read_file_text(context.physical_path)
    let ptr = mem_load64_at(file, 0)
    let len = mem_load64_at(file, 8)
    if ptr == 0 { project_session_set_missing(session, context) }
    else { project_session_set_source(session, context, runtime_str_from_bytes_copy(ptr, len)) }
  }
}

fn project_source_snapshot_from_disk(path: str) -> ProjectSourceSnapshot {
  let file = read_file_text(path)
  let ptr = mem_load64_at(file, 0)
  let len = mem_load64_at(file, 8)
  if ptr == 0 { ProjectSourceMissing }
  else { ProjectSourcePresent(runtime_str_from_bytes_copy(ptr, len)) }
}

fn project_source_snapshot_raw(snapshot: ProjectSourceSnapshot) -> i64 {
  let result = alloc_words(2)
  match snapshot {
    ProjectSourcePresent(content) -> {
      mem_store64_at(result, 0, __str_ptr(content))
      mem_store64_at(result, 8, __str_len(content))
    }
    ProjectSourceMissing -> {
      mem_store64_at(result, 0, 0)
      mem_store64_at(result, 8, 0)
    }
  }
  result
}

fn project_source_context_equal(left: ProjectQueryContext, right: ProjectQueryContext) -> bool {
  left.package_id == right.package_id and
    left.origin == right.origin and
    str_eq(left.identity, right.identity) == 1
}

fn project_session_record_observed_source(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  let observed = project_session_observed_sources(session)
  let mut i = 0
  let mut found = 0
  while i < vector_len<ProjectQueryContext>(observed) and found == 0 {
    if project_source_context_equal(vector_get_in_bounds<ProjectQueryContext>(observed, i), context) {
      -- Resolver/lock changes may preserve logical identity while selecting a
      -- new physical location. Keep the refresh target current without
      -- changing the source query's semantic key.
      vector_set<ProjectQueryContext>(observed, i, context)
      found = 1
    } else { i = i + 1 }
  }
  if found == 0 { vector_push<ProjectQueryContext>(observed, context) } else { 0 }
}

fn project_disk_context(parent: ProjectQueryContext, physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) -> ProjectQueryContext {
  project_query_context(
    package_id,
    runtime_str_from_bytes_copy(logical_ptr, logical_len),
    runtime_str_from_bytes_copy(physical_ptr, physical_len),
    project_source_origin_disk(),
    parent.semantic_options,
    parent.target
  )
}

fn project_session_load_observed_source(
  session: ProjectSession,
  parent: ProjectQueryContext,
  diagnostics: ProjectDiagnostics,
  physical_ptr: i64,
  physical_len: i64,
  logical_ptr: i64,
  logical_len: i64,
  package_id: i64
) -> i64 {
  let context = project_disk_context(parent, physical_ptr, physical_len, logical_ptr, logical_len, package_id)
  project_session_record_observed_source(session, context)
  let table = project_session_sources(session)
  let key = project_session_source_key(session, context)
  let snapshot = match incremental_query_begin<ProjectSourceSnapshot>(table, key) {
    IncrementalQueryHit(cached) -> cached
    IncrementalQueryMiss(ticket) -> {
      let loaded = project_source_snapshot_from_disk(context.physical_path)
      match incremental_query_finish<ProjectSourceSnapshot>(ticket, loaded, project_source_fingerprint(loaded)) {
        IncrementalQueryCommitted(committed) -> committed
        IncrementalQueryCommitRejected -> ProjectSourceMissing
      }
    }
    IncrementalQueryCycle(cycle) -> ProjectSourceMissing
    IncrementalQueryCorrupt -> ProjectSourceMissing
  }
  project_diagnostics_retain(diagnostics, context.identity)
  project_diagnostics_retain(diagnostics, context.physical_path)
  match snapshot {
    ProjectSourcePresent(content) -> project_diagnostics_retain(diagnostics, content)
    ProjectSourceMissing -> 0
  }
  project_source_snapshot_raw(snapshot)
}

pub(package) fn project_session_observed_source_count(session: ProjectSession) -> i64 {
  vector_len<ProjectQueryContext>(project_session_observed_sources(session))
}

pub(package) fn project_session_observed_source_at(session: ProjectSession, index: i64) -> ProjectQueryContext {
  vector_get_in_bounds<ProjectQueryContext>(project_session_observed_sources(session), index)
}

pub(package) fn project_session_refresh_observed_snapshot(session: ProjectSession, context: ProjectQueryContext, snapshot: ProjectSourceSnapshot) -> IncrementalLeafRefresh<ProjectSourceSnapshot> {
  if context.origin != project_source_origin_disk() or __str_len(context.physical_path) == 0 {
    IncrementalLeafRefreshRejected<ProjectSourceSnapshot>()
  } else {
    incremental_query_refresh_leaf<ProjectSourceSnapshot>(
      project_session_sources(session),
      project_session_source_key(session, context),
      snapshot,
      project_source_fingerprint(snapshot)
    )
  }
}

pub(package) fn project_session_refresh_observed_disk_source(session: ProjectSession, context: ProjectQueryContext) -> IncrementalLeafRefresh<ProjectSourceSnapshot> {
  if context.origin != project_source_origin_disk() or __str_len(context.physical_path) == 0 {
    IncrementalLeafRefreshRejected<ProjectSourceSnapshot>()
  } else {
    project_session_refresh_observed_snapshot(session, context, project_source_snapshot_from_disk(context.physical_path))
  }
}

fn project_diagnostics_items(diagnostics: ProjectDiagnostics) -> Vector<ProjectDiagnosticItem> {
  match diagnostics { ProjectDiagnostics(items, counters, owners) -> items }
}

fn project_diagnostics_counters(diagnostics: ProjectDiagnostics) -> Vector<i64> {
  match diagnostics { ProjectDiagnostics(items, counters, owners) -> counters }
}

fn project_diagnostics_owners(diagnostics: ProjectDiagnostics) -> Vector<str> {
  match diagnostics { ProjectDiagnostics(items, counters, owners) -> owners }
}

fn project_diagnostics_new() -> ProjectDiagnostics {
  let counters = vector_new<i64>()
  vector_push<i64>(counters, 0)
  ProjectDiagnostics(vector_new<ProjectDiagnosticItem>(), counters, vector_new<str>())
}

-- Token tables deliberately store raw source/path views. Query results must
-- therefore retain every managed string that backs one of those views for as
-- long as the cached AST, typed module, or diagnostic transport can escape.
fn project_diagnostics_retain(diagnostics: ProjectDiagnostics, owner: str) -> i64 {
  if __str_len(owner) > 0 { vector_push<str>(project_diagnostics_owners(diagnostics), owner) }
  else { 0 }
}

fn project_diagnostics_add_item(diagnostics: ProjectDiagnostics, item: ProjectDiagnosticItem) -> i64 {
  vector_push<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), item)
  let diagnostic = match item { ProjectDiagnosticItem(value, legacy, src, n, tt) -> value }
  if diagnose_report_severity_tag(diagnostic) == 1 {
    let counters = project_diagnostics_counters(diagnostics)
    vector_set<i64>(counters, 0, vector_get_in_bounds<i64>(counters, 0) + 1)
  } else { 0 }
}

fn project_diagnostics_add(diagnostics: ProjectDiagnostics, diagnostic: Diagnostic, src: i64, n: i64, tt: i64) -> i64 {
  project_diagnostics_add_item(diagnostics, ProjectDiagnosticItem(diagnostic, false, src, n, tt))
}

fn project_legacy_location(src: i64, span: i64) -> DiagnosticLocation {
  let start = if span >= src { span - src } else { span }
  if start < 0 { DiagnosticLocationNone }
  else { DiagnosticSourceRange(DiagnosticSourceBuffer(src), start, start + 1) }
}

fn project_diagnostics_add_legacy(diagnostics: ProjectDiagnostics, src: i64, n: i64, tt: i64, severity: DiagnosticSeverity, class: DiagnosticClass, msg: str, span: i64) -> i64 {
  project_diagnostics_add_item(diagnostics, ProjectDiagnosticItem(diagnostic_uncoded(severity, class, msg, project_legacy_location(src, span)), true, src, n, tt))
}

fn project_diagnostics_combine(first: ProjectDiagnostics, second: ProjectDiagnostics) -> ProjectDiagnostics {
  let combined = project_diagnostics_new()
  for i in 0..project_diagnostics_len(first) {
    project_diagnostics_add_item(combined, vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(first), i))
  }
  for i in 0..project_diagnostics_len(second) {
    project_diagnostics_add_item(combined, vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(second), i))
  }
  for i in 0..vector_len<str>(project_diagnostics_owners(first)) {
    project_diagnostics_retain(combined, vector_get_in_bounds<str>(project_diagnostics_owners(first), i))
  }
  for i in 0..vector_len<str>(project_diagnostics_owners(second)) {
    project_diagnostics_retain(combined, vector_get_in_bounds<str>(project_diagnostics_owners(second), i))
  }
  combined
}

pub(package) fn project_diagnostics_len(diagnostics: ProjectDiagnostics) -> i64 {
  vector_len<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics))
}

pub(package) fn project_diagnostics_error_count(diagnostics: ProjectDiagnostics) -> i64 {
  vector_get_in_bounds<i64>(project_diagnostics_counters(diagnostics), 0)
}

pub(package) fn project_diagnostics_get(diagnostics: ProjectDiagnostics, index: i64) -> Diagnostic {
  match vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), index) {
    ProjectDiagnosticItem(diagnostic, legacy, src, n, tt) -> diagnostic
  }
}

pub(package) fn project_diagnostics_item_is_legacy(diagnostics: ProjectDiagnostics, index: i64) -> bool {
  match vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), index) {
    ProjectDiagnosticItem(diagnostic, legacy, src, n, tt) -> legacy
  }
}

pub(package) fn project_diagnostics_item_source(diagnostics: ProjectDiagnostics, index: i64) -> i64 {
  match vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), index) {
    ProjectDiagnosticItem(diagnostic, legacy, src, n, tt) -> src
  }
}

pub(package) fn project_diagnostics_item_source_len(diagnostics: ProjectDiagnostics, index: i64) -> i64 {
  match vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), index) {
    ProjectDiagnosticItem(diagnostic, legacy, src, n, tt) -> n
  }
}

pub(package) fn project_diagnostics_item_type_table(diagnostics: ProjectDiagnostics, index: i64) -> i64 {
  match vector_get_in_bounds<ProjectDiagnosticItem>(project_diagnostics_items(diagnostics), index) {
    ProjectDiagnosticItem(diagnostic, legacy, src, n, tt) -> tt
  }
}

fn project_register_overlay_sources(session: ProjectSession, context: ProjectQueryContext, tt: i64) -> i64 {
  if __str_len(context.overlay_set_identity) == 0 { 1 }
  else { if incremental_query_is_ready<ProjectOverlaySet>(project_session_overlay_sets(session), project_session_overlay_set_key(session, context)) == 0 { 0 }
    else {
      match incremental_query_begin<ProjectOverlaySet>(project_session_overlay_sets(session), project_session_overlay_set_key(session, context)) {
        IncrementalQueryHit(overlays) -> {
          let contexts = project_overlay_set_contexts(overlays)
          let mut ok = 1
          let mut i = 0
          while i < vector_len<ProjectQueryContext>(contexts) and ok == 1 {
            let overlay = vector_get_in_bounds<ProjectQueryContext>(contexts, i)
            let overlay_source_key = project_session_source_key(session, overlay)
            if incremental_query_key_equal(overlay_source_key, project_session_source_key(session, context)) { 0 }
            else { if incremental_query_is_ready<ProjectSourceSnapshot>(project_session_sources(session), overlay_source_key) == 0 {
                ok = 0
              }
              else {
                match incremental_query_begin<ProjectSourceSnapshot>(project_session_sources(session), overlay_source_key) {
                  IncrementalQueryHit(snapshot) -> match snapshot {
                    ProjectSourcePresent(content) -> {
                      if __str_len(overlay.physical_path) > 0 {
                        ttable_register_source(
                          tt,
                          __str_ptr(content),
                          __str_len(content),
                          __str_ptr(overlay.physical_path),
                          __str_len(overlay.physical_path)
                        )
                      } else { 0 }
                    }
                    ProjectSourceMissing -> 0
                  }
                  IncrementalQueryMiss(source_ticket) -> {
                    incremental_query_abort<ProjectSourceSnapshot>(source_ticket)
                    ok = 0
                    0
                  }
                  IncrementalQueryCycle(cycle) -> { ok = 0 0 }
                  IncrementalQueryCorrupt -> { ok = 0 0 }
                }
              } }
            i = i + 1
          }
          ok
        }
        IncrementalQueryMiss(overlay_ticket) -> {
          incremental_query_abort<ProjectOverlaySet>(overlay_ticket)
          0
        }
        IncrementalQueryCycle(cycle) -> 0
        IncrementalQueryCorrupt -> 0
      }
    } }
}

fn project_register_root(session: ProjectSession, context: ProjectQueryContext, content: str) -> i64 {
  let src = __str_ptr(content)
  let tt = ttable_new()
  let register_root = project_session_root_registration(session)
  register_root(tt, src, context.trusted, context.strict, context.can_grant_trust)
  if __str_len(context.physical_path) > 0 {
    ttable_register_source(tt, src, __str_len(content), __str_ptr(context.physical_path), __str_len(context.physical_path))
    pkg_identity_register_root(tt, pkg_manifest_load_default_for_table(tt))
  } else { 0 }
  if project_register_overlay_sources(session, context, tt) == 1 { tt } else { 0 }
}

fn project_parse_present(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectParseResult>, snapshot: ProjectSourceSnapshot, content: str) -> ProjectParseResult {
  let src = __str_ptr(content)
  let diagnostics = project_diagnostics_new()
  project_diagnostics_retain(diagnostics, context.physical_path)
  project_diagnostics_retain(diagnostics, content)
  let tt = project_register_root(session, context, content)
  if tt == 0 {
    incremental_query_abort<ProjectParseResult>(ticket)
    ProjectParseCorrupt
  } else {
    let grammar = weft_grammar()
    let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => project_session_load_observed_source(
      session,
      context,
      diagnostics,
      physical_ptr,
      physical_len,
      logical_ptr,
      logical_len,
      package_id
    )
    let fns = handle parse_module_with_loader(grammar.lex(src, __str_len(content)), src, tt, loader) {
      Diagnose.report(diagnostic) -> { project_diagnostics_add(diagnostics, diagnostic, src, __str_len(content), tt) resume(0) }
      Diagnose.error(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityError, DiagnosticClassParse, msg, span) resume(0) }
      Diagnose.warn(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityWarning, DiagnosticClassParse, msg, span) resume(0) }
      Diagnose.note(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityNote, DiagnosticClassParse, msg, span) resume(0) }
    }
    let ast = AstModule(fns, src, tt)
    let result = if project_diagnostics_error_count(diagnostics) == 0 {
      ProjectParseSucceeded(ast, __str_len(content), diagnostics)
    } else { ProjectParseFailed(ast, __str_len(content), diagnostics) }
    match incremental_query_finish<ProjectParseResult>(ticket, result, project_source_fingerprint(snapshot)) {
      IncrementalQueryCommitted(committed) -> committed
      IncrementalQueryCommitRejected -> ProjectParseCorrupt
    }
  }
}

fn project_parse_compute(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectParseResult>) -> ProjectParseResult {
  let sources = project_session_sources(session)
  let source_key = project_session_source_key(session, context)
  if incremental_query_is_ready<ProjectSourceSnapshot>(sources, source_key) == 0 {
    incremental_query_abort<ProjectParseResult>(ticket)
    ProjectParseSourceUnset
  } else {
    match incremental_query_begin<ProjectSourceSnapshot>(sources, source_key) {
      IncrementalQueryHit(snapshot) -> match snapshot {
        ProjectSourceMissing -> {
          let result = ProjectParseSourceUnset
          match incremental_query_finish<ProjectParseResult>(ticket, result, project_source_fingerprint(snapshot)) {
            IncrementalQueryCommitted(committed) -> committed
            IncrementalQueryCommitRejected -> ProjectParseCorrupt
          }
        }
        ProjectSourcePresent(content) -> project_parse_present(session, context, ticket, snapshot, content)
      }
      IncrementalQueryMiss(source_ticket) -> {
        incremental_query_abort<ProjectSourceSnapshot>(source_ticket)
        incremental_query_abort<ProjectParseResult>(ticket)
        ProjectParseSourceUnset
      }
      IncrementalQueryCycle(cycle) -> {
        incremental_query_abort<ProjectParseResult>(ticket)
        ProjectParseCycle(cycle)
      }
      IncrementalQueryCorrupt -> {
        incremental_query_abort<ProjectParseResult>(ticket)
        ProjectParseCorrupt
      }
    }
  }
}

pub(package) fn project_session_parse(session: ProjectSession, context: ProjectQueryContext) -> ProjectParseResult {
  match incremental_query_begin<ProjectParseResult>(project_session_parses(session), project_session_parse_key(session, context)) {
    IncrementalQueryHit(result) -> result
    IncrementalQueryMiss(ticket) -> project_parse_compute(session, context, ticket)
    IncrementalQueryCycle(cycle) -> ProjectParseCycle(cycle)
    IncrementalQueryCorrupt -> ProjectParseCorrupt
  }
}

fn project_prepared_source_fingerprint(result: ProjectPreparedSourceResult, schema: i64) -> IncrementalFingerprint {
  match result {
    ProjectPreparedSourceTests(prepared, raw_diagnostics) -> {
      let content = test_prepare_source_content(prepared)
      incremental_fingerprint(content, str_hash(__str_ptr(content), 0, __str_len(content)))
    }
    ProjectPreparedSourcePlain(ast, n, diagnostics) -> incremental_fingerprint("project-plain-source", schema)
    ProjectPreparedSourceParseFailed(parse) -> incremental_fingerprint("project-prepare-parse-failed", schema)
    ProjectPreparedSourceUnset -> incremental_fingerprint("project-prepare-source-unset", schema)
    ProjectPreparedSourceCycle(cycle) -> incremental_fingerprint("project-prepare-cycle", schema)
    ProjectPreparedSourceCorrupt -> incremental_fingerprint("project-prepare-corrupt", schema)
  }
}

fn project_prepared_source_commit(session: ProjectSession, ticket: IncrementalQueryTicket<ProjectPreparedSourceResult>, result: ProjectPreparedSourceResult) -> ProjectPreparedSourceResult {
  match incremental_query_finish<ProjectPreparedSourceResult>(ticket, result, project_prepared_source_fingerprint(result, project_session_schema(session))) {
    IncrementalQueryCommitted(committed) -> committed
    IncrementalQueryCommitRejected -> ProjectPreparedSourceCorrupt
  }
}

fn project_prepared_source_compute(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectPreparedSourceResult>) -> ProjectPreparedSourceResult {
  match project_session_parse(session, context) {
    ProjectParseSucceeded(ast, n, diagnostics) -> match ast {
      AstModule(fns, src, tt) -> {
        let test_count = test_prepare_fns_test_count(fns)
        if test_count == 0 {
          project_prepared_source_commit(session, ticket, ProjectPreparedSourcePlain(ast, n, diagnostics))
        } else {
          let sources = project_session_sources(session)
          match incremental_query_begin<ProjectSourceSnapshot>(sources, project_session_source_key(session, context)) {
            IncrementalQueryHit(snapshot) -> match snapshot {
              ProjectSourcePresent(content) -> project_prepared_source_commit(session, ticket, ProjectPreparedSourceTests(test_prepare_source(content, test_count), diagnostics))
              ProjectSourceMissing -> project_prepared_source_commit(session, ticket, ProjectPreparedSourceUnset)
            }
            IncrementalQueryMiss(source_ticket) -> {
              incremental_query_abort<ProjectSourceSnapshot>(source_ticket)
              incremental_query_abort<ProjectPreparedSourceResult>(ticket)
              ProjectPreparedSourceUnset
            }
            IncrementalQueryCycle(cycle) -> {
              incremental_query_abort<ProjectPreparedSourceResult>(ticket)
              ProjectPreparedSourceCycle(cycle)
            }
            IncrementalQueryCorrupt -> {
              incremental_query_abort<ProjectPreparedSourceResult>(ticket)
              ProjectPreparedSourceCorrupt
            }
          }
        }
      }
    }
    ProjectParseFailed(ast, n, diagnostics) -> project_prepared_source_commit(session, ticket, ProjectPreparedSourceParseFailed(ProjectParseFailed(ast, n, diagnostics)))
    ProjectParseSourceUnset -> project_prepared_source_commit(session, ticket, ProjectPreparedSourceUnset)
    ProjectParseCycle(cycle) -> {
      incremental_query_abort<ProjectPreparedSourceResult>(ticket)
      ProjectPreparedSourceCycle(cycle)
    }
    ProjectParseCorrupt -> {
      incremental_query_abort<ProjectPreparedSourceResult>(ticket)
      ProjectPreparedSourceCorrupt
    }
  }
}

pub(package) fn project_session_prepared_source(session: ProjectSession, context: ProjectQueryContext) -> ProjectPreparedSourceResult {
  match incremental_query_begin<ProjectPreparedSourceResult>(project_session_prepared_sources(session), project_session_prepared_source_key(session, context)) {
    IncrementalQueryHit(result) -> result
    IncrementalQueryMiss(ticket) -> project_prepared_source_compute(session, context, ticket)
    IncrementalQueryCycle(cycle) -> ProjectPreparedSourceCycle(cycle)
    IncrementalQueryCorrupt -> ProjectPreparedSourceCorrupt
  }
}

fn project_prepared_parse_commit(session: ProjectSession, ticket: IncrementalQueryTicket<ProjectPreparedParseResult>, result: ProjectPreparedParseResult, fingerprint: IncrementalFingerprint) -> ProjectPreparedParseResult {
  match incremental_query_finish<ProjectPreparedParseResult>(ticket, result, fingerprint) {
    IncrementalQueryCommitted(committed) -> committed
    IncrementalQueryCommitRejected -> ProjectPreparedParseCorrupt
  }
}

fn project_prepared_parse_tests(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectPreparedParseResult>, prepared: TestPreparedSource, raw_diagnostics: ProjectDiagnostics) -> ProjectPreparedParseResult {
  let content = test_prepare_source_content(prepared)
  let src = __str_ptr(content)
  let diagnostics = project_diagnostics_new()
  project_diagnostics_retain(diagnostics, context.physical_path)
  project_diagnostics_retain(diagnostics, content)
  let tt = project_register_root(session, context, content)
  if tt == 0 {
    incremental_query_abort<ProjectPreparedParseResult>(ticket)
    ProjectPreparedParseCorrupt
  } else {
    let grammar = weft_grammar()
    let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => project_session_load_observed_source(
      session,
      context,
      diagnostics,
      physical_ptr,
      physical_len,
      logical_ptr,
      logical_len,
      package_id
    )
    let parsed = handle parse_module_with_loader(grammar.lex(src, __str_len(content)), src, tt, loader) {
      Diagnose.report(diagnostic) -> { project_diagnostics_add(diagnostics, diagnostic, src, __str_len(content), tt) resume(0) }
      Diagnose.error(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityError, DiagnosticClassParse, msg, span) resume(0) }
      Diagnose.warn(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityWarning, DiagnosticClassParse, msg, span) resume(0) }
      Diagnose.note(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, __str_len(content), tt, DiagnosticSeverityNote, DiagnosticClassParse, msg, span) resume(0) }
    }
    let fns = test_prepare_wrap_fns(parsed, test_prepare_source_wrapper_bank_start(prepared), tt)
    let ast = AstModule(fns, src, tt)
    let combined_diagnostics = project_diagnostics_combine(raw_diagnostics, diagnostics)
    let result = if project_diagnostics_error_count(diagnostics) == 0 {
      ProjectPreparedParseSucceeded(ast, __str_len(content), combined_diagnostics)
    } else { ProjectPreparedParseFailed(ast, __str_len(content), combined_diagnostics) }
    project_prepared_parse_commit(
      session,
      ticket,
      result,
      incremental_fingerprint(content, str_hash(src, 0, __str_len(content)))
    )
  }
}

fn project_prepared_parse_compute(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectPreparedParseResult>) -> ProjectPreparedParseResult {
  match project_session_prepared_source(session, context) {
    ProjectPreparedSourcePlain(ast, n, diagnostics) -> project_prepared_parse_commit(
      session,
      ticket,
      ProjectPreparedParseSucceeded(ast, n, diagnostics),
      incremental_fingerprint("project-plain-parse", project_session_schema(session))
    )
    ProjectPreparedSourceTests(prepared, raw_diagnostics) -> project_prepared_parse_tests(session, context, ticket, prepared, raw_diagnostics)
    ProjectPreparedSourceParseFailed(parse) -> match parse {
      ProjectParseFailed(ast, n, diagnostics) -> project_prepared_parse_commit(
        session,
        ticket,
        ProjectPreparedParseFailed(ast, n, diagnostics),
        incremental_fingerprint("project-prepared-parse-failed", project_session_schema(session))
      )
      ProjectParseSourceUnset -> project_prepared_parse_commit(session, ticket, ProjectPreparedParseSourceUnset, incremental_fingerprint("project-prepared-source-unset", project_session_schema(session)))
      ProjectParseCycle(cycle) -> {
        incremental_query_abort<ProjectPreparedParseResult>(ticket)
        ProjectPreparedParseCycle(cycle)
      }
      ProjectParseCorrupt -> {
        incremental_query_abort<ProjectPreparedParseResult>(ticket)
        ProjectPreparedParseCorrupt
      }
      ProjectParseSucceeded(ast, n, diagnostics) -> {
        incremental_query_abort<ProjectPreparedParseResult>(ticket)
        ProjectPreparedParseCorrupt
      }
    }
    ProjectPreparedSourceUnset -> project_prepared_parse_commit(session, ticket, ProjectPreparedParseSourceUnset, incremental_fingerprint("project-prepared-source-unset", project_session_schema(session)))
    ProjectPreparedSourceCycle(cycle) -> {
      incremental_query_abort<ProjectPreparedParseResult>(ticket)
      ProjectPreparedParseCycle(cycle)
    }
    ProjectPreparedSourceCorrupt -> {
      incremental_query_abort<ProjectPreparedParseResult>(ticket)
      ProjectPreparedParseCorrupt
    }
  }
}

pub(package) fn project_session_prepared_parse(session: ProjectSession, context: ProjectQueryContext) -> ProjectPreparedParseResult {
  match incremental_query_begin<ProjectPreparedParseResult>(project_session_prepared_parses(session), project_session_prepared_parse_key(session, context)) {
    IncrementalQueryHit(result) -> result
    IncrementalQueryMiss(ticket) -> project_prepared_parse_compute(session, context, ticket)
    IncrementalQueryCycle(cycle) -> ProjectPreparedParseCycle(cycle)
    IncrementalQueryCorrupt -> ProjectPreparedParseCorrupt
  }
}

fn project_check_compute(session: ProjectSession, context: ProjectQueryContext, ticket: IncrementalQueryTicket<ProjectCheckResult>) -> ProjectCheckResult {
  match project_session_prepared_parse(session, context) {
    ProjectPreparedParseSucceeded(ast, n, parse_diagnostics) -> match ast {
      AstModule(fns, src, tt) -> {
        let diagnostics = project_diagnostics_new()
        let loader = (physical_ptr: i64, physical_len: i64, logical_ptr: i64, logical_len: i64, package_id: i64) => project_session_load_observed_source(
          session,
          context,
          diagnostics,
          physical_ptr,
          physical_len,
          logical_ptr,
          logical_len,
          package_id
        )
        let errors = handle pipeline_check_with_loader(weft_grammar(), fns, src, tt, loader) {
          Diagnose.report(diagnostic) -> { project_diagnostics_add(diagnostics, diagnostic, src, n, tt) resume(0) }
          Diagnose.error(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, n, tt, DiagnosticSeverityError, DiagnosticClassType, msg, span) resume(0) }
          Diagnose.warn(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, n, tt, DiagnosticSeverityWarning, DiagnosticClassType, msg, span) resume(0) }
          Diagnose.note(msg, span) -> { project_diagnostics_add_legacy(diagnostics, src, n, tt, DiagnosticSeverityNote, DiagnosticClassType, msg, span) resume(0) }
        }
        let typed = TypedModule(fns, src, tt)
        let result = if errors == 0 and project_diagnostics_error_count(diagnostics) == 0 {
          ProjectCheckSucceeded(typed, n, parse_diagnostics, diagnostics)
        } else { ProjectCheckFailed(typed, n, parse_diagnostics, diagnostics) }
        match incremental_query_finish<ProjectCheckResult>(ticket, result, incremental_fingerprint("project-check", project_session_schema(session))) {
          IncrementalQueryCommitted(committed) -> committed
          IncrementalQueryCommitRejected -> ProjectCheckCorrupt
        }
      }
    }
    ProjectPreparedParseFailed(ast, n, diagnostics) -> {
      let result = ProjectCheckParseFailed(ProjectPreparedParseFailed(ast, n, diagnostics))
      match incremental_query_finish<ProjectCheckResult>(ticket, result, incremental_fingerprint("project-parse-failed", project_session_schema(session))) {
        IncrementalQueryCommitted(committed) -> committed
        IncrementalQueryCommitRejected -> ProjectCheckCorrupt
      }
    }
    ProjectPreparedParseSourceUnset -> {
      let result = ProjectCheckSourceUnset
      match incremental_query_finish<ProjectCheckResult>(ticket, result, incremental_fingerprint("project-source-unset", project_session_schema(session))) {
        IncrementalQueryCommitted(committed) -> committed
        IncrementalQueryCommitRejected -> ProjectCheckCorrupt
      }
    }
    ProjectPreparedParseCycle(cycle) -> {
      incremental_query_abort<ProjectCheckResult>(ticket)
      ProjectCheckCycle(cycle)
    }
    ProjectPreparedParseCorrupt -> {
      incremental_query_abort<ProjectCheckResult>(ticket)
      ProjectCheckCorrupt
    }
  }
}

pub(package) fn project_session_check(session: ProjectSession, context: ProjectQueryContext) -> ProjectCheckResult {
  match incremental_query_begin<ProjectCheckResult>(project_session_checks(session), project_session_check_key(session, context)) {
    IncrementalQueryHit(result) -> result
    IncrementalQueryMiss(ticket) -> project_check_compute(session, context, ticket)
    IncrementalQueryCycle(cycle) -> ProjectCheckCycle(cycle)
    IncrementalQueryCorrupt -> ProjectCheckCorrupt
  }
}

pub(package) fn project_session_parse_execution_count(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  incremental_query_execution_count<ProjectParseResult>(project_session_parses(session), project_session_parse_key(session, context))
}

pub(package) fn project_session_prepared_source_execution_count(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  incremental_query_execution_count<ProjectPreparedSourceResult>(project_session_prepared_sources(session), project_session_prepared_source_key(session, context))
}

pub(package) fn project_session_prepared_parse_execution_count(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  incremental_query_execution_count<ProjectPreparedParseResult>(project_session_prepared_parses(session), project_session_prepared_parse_key(session, context))
}

pub(package) fn project_session_check_execution_count(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  incremental_query_execution_count<ProjectCheckResult>(project_session_checks(session), project_session_check_key(session, context))
}

pub(package) fn project_session_check_depends_on_prepared_parse(session: ProjectSession, context: ProjectQueryContext) -> i64 {
  incremental_query_depends_on<ProjectCheckResult, ProjectPreparedParseResult>(
    project_session_checks(session),
    project_session_check_key(session, context),
    project_session_prepared_parses(session),
    project_session_prepared_parse_key(session, context)
  )
}

