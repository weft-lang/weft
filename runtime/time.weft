-- runtime/time.weft -- trusted target-semantic clock/sleep bridge

use runtime/alloc.{*}
use runtime/panic.{runtime_trap}
use runtime/unsafe.{*}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{MonotonicClock}
use stdlib/time/sleep as sleep
use stdlib/time/sleep.{Sleep}
use stdlib/time/wall as wall
use stdlib/time/wall.{WallClock}

type RuntimeTimeClock {
  RuntimeTimeRealtime
  RuntimeTimeMonotonic
}

pub(package) fn runtime_clock_gettime(clock: RuntimeTimeClock, timespec: i64) -[Unsafe]> i64 {
  match clock {
    RuntimeTimeRealtime -> __platform_time_realtime(timespec)
    RuntimeTimeMonotonic -> __platform_time_monotonic(timespec)
  }
}

pub(package) fn runtime_nanosleep(request: i64, remaining: i64) -[Unsafe]> i64 {
  __platform_time_sleep(request, remaining)
}

pub(package) fn runtime_time_read_nanos(clock: RuntimeTimeClock) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let timespec = alloc_bump(16)
  __mem_store64(timespec, 0)
  __mem_store64(timespec + 8, 0)
  let status = runtime_clock_gettime(clock, timespec)
  let result = if status == 0 {
    __mem_load64(timespec) * 1000000000 + __mem_load64(timespec + 8)
  } else {
    0 - 1
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_time_now_millis() -[Unsafe]> i64 {
  let nanos = runtime_time_read_nanos(RuntimeTimeRealtime)
  if nanos < 0 { 0 - 1 } else { nanos / 1000000 }
}

pub(package) fn runtime_time_now_nanos() -[Unsafe]> i64 {
  runtime_time_read_nanos(RuntimeTimeMonotonic)
}

pub(package) fn runtime_time_sleep_millis(ms: i64) -[Unsafe]> i64 {
  if ms < 0 {
    0 - 1
  } else {
    let mark = alloc_bump_mark()
    let request = alloc_bump(16)
    let seconds = ms / 1000
    let nanos = (ms - seconds * 1000) * 1000000
    __mem_store64(request, seconds)
    __mem_store64(request + 8, nanos)
    let status = runtime_nanosleep(request, 0)
    alloc_bump_restore_same_segment(mark)
    status
  }
}

fn runtime_time_now_millis_safe() -> i64 {
  handle runtime_time_now_millis() {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_time_now_nanos_safe() -> i64 {
  handle runtime_time_now_nanos() {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_time_sleep_millis_safe(ms: i64) -> i64 {
  handle runtime_time_sleep_millis(ms) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Safe scheduler leaves. The event-loop handler needs real clock/sleep policy
-- without inheriting Unsafe or recursively performing into its own clock
-- clauses. Each helper installs the same canonical platform handler used at
-- the program boundary.
pub(package) fn runtime_platform_now_nanos() -> i64 {
  runtime_time_now_nanos_safe()
}

pub(package) fn runtime_platform_sleep_millis(ms: i64) -> i64 {
  runtime_time_sleep_millis_safe(ms)
}

--- Interpret wall-clock observation, monotonic observation, and suspension
--- through the target platform while preserving unrelated residual effects.
---
--- The three capabilities remain independent in application signatures and
--- deterministic handlers. This convenience composes their production
--- interpretations only at the sealed platform boundary.
pub fn with_platform<T, E>(
  body: () -[WallClock, MonotonicClock, Sleep, E]> T
) -[E]> T {
  handle {
    handle {
      handle body() {
        WallClock.now() -> {
          let reading = wall.from_platform_milliseconds(runtime_time_now_millis_safe())
          resume(reading)
        }
      }
    } {
      MonotonicClock.now() -> {
        let now = runtime_time_now_nanos_safe()
        if now < 0 {
          runtime_trap(47, 0)
        } else {
          resume(monotonic.nanoseconds(now))
        }
      }
    }
  } {
    Sleep.wait(duration) -> {
      let milliseconds = duration.milliseconds()
      if milliseconds < 0 {
        resume(sleep.result_from_platform_status(0 - 1))
      } else {
        let result = sleep.result_from_platform_status(runtime_time_sleep_millis_safe(milliseconds))
        resume(result)
      }
    }
  }
}
