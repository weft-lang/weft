-- runtime/time.weft -- trusted libSystem clock/sleep bridge

use runtime/alloc.{*}
use runtime/unsafe.{*}
use stdlib/time.{*}

pub(package) fn runtime_clock_realtime() -> i64 { 0 }
pub(package) fn runtime_clock_monotonic() -> i64 { 6 }

pub(package) fn runtime_clock_gettime(clock_id: i64, timespec: i64) -[Unsafe]> i64 {
  __got_clock_gettime(clock_id, timespec, 0, 0, 0, 0)
}

pub(package) fn runtime_nanosleep(request: i64, remaining: i64) -[Unsafe]> i64 {
  __got_nanosleep(request, remaining, 0, 0, 0, 0)
}

pub(package) fn runtime_time_read_nanos(clock_id: i64) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let timespec = alloc_bump(16)
  __mem_store64(timespec, 0)
  __mem_store64(timespec + 8, 0)
  let status = runtime_clock_gettime(clock_id, timespec)
  let result = if status == 0 {
    __mem_load64(timespec) * 1000000000 + __mem_load64(timespec + 8)
  } else {
    0 - 1
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_time_now_millis() -[Unsafe]> i64 {
  let nanos = runtime_time_read_nanos(runtime_clock_realtime())
  if nanos < 0 { 0 - 1 } else { nanos / 1000000 }
}

pub(package) fn runtime_time_now_nanos() -[Unsafe]> i64 {
  runtime_time_read_nanos(runtime_clock_monotonic())
}

pub(package) fn runtime_time_sleep_millis(ms: i64) -[Unsafe]> i64 {
  if ms < 0 {
    0 - 1
  } else {
    let mark = alloc_bump_mark()
    let request = alloc_bump(16)
    let seconds = ms / 1000
    let nanos = (ms - seconds * 1000) * 1000000
    __mem_store64(request, seconds)
    __mem_store64(request + 8, nanos)
    let status = runtime_nanosleep(request, 0)
    alloc_bump_restore_same_segment(mark)
    status
  }
}

pub(package) fn runtime_time_handle(body: () -[Time]> i64) -[Unsafe]> i64 {
  handle body() {
    Time.now_millis() -> resume(runtime_time_now_millis())
    Time.now_nanos() -> resume(runtime_time_now_nanos())
    Time.sleep_millis(ms) -> resume(runtime_time_sleep_millis(ms))
  }
}

-- Program-boundary installer. Time remains an ordinary effect inside the
-- program, so tests can replace this handler with deterministic clauses.
pub(package) fn runtime_platform_time(body: () -[Time]> i64) -> i64 {
  handle runtime_time_handle(body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
