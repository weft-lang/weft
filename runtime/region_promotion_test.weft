-- Trusted helper surface for scoped region promotion tests that need raw addresses.

use runtime/alloc.{*}
use runtime/rc.{*}
use runtime/rc_implicit_test.{*}

pub(package) fn runtime_region_promote_probe(arena: i64, value: i64) -> RuntimeRcProbe {
  let promoted: rc i64 = with_scoped_arena_alloc_value<rc i64>(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, value)
    region_promote_rc(p, 8, 8)
  })
  let raw = runtime_rc_test_addr(promoted)
  rc_default_retain(raw)
  runtime_rc_probe_from_owned_word(raw)
}

pub(package) fn runtime_region_promote_auto_release_addr() -> i64 {
  let arena = arena_new(64)
  let promoted: rc i64 = with_scoped_arena_alloc_value<rc i64>(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 73)
    region_promote_rc(p, 8, 8)
  })
  let addr = runtime_rc_test_addr(promoted)
  arena_free(arena)
  addr
}
