-- Trusted helper surface for scoped region promotion tests that need raw addresses.

use "runtime/alloc.weft"
use "runtime/rc.weft"

fn runtime_region_promote_auto_release_addr() -> i64 {
  let arena = arena_new(64)
  let promoted: rc i64 = with_scoped_arena_alloc_value<rc i64>(arena, () => {
    let p = Alloc.alloc(8, 8)
    __mem_store64(p, 73)
    region_promote_rc(p, 8, 8)
  })
  let addr = promoted + 0
  arena_free(arena)
  addr
}
