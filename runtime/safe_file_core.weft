-- runtime/safe_file_core.weft — backend-neutral typed file engine
--
-- The linked and standalone program boundaries share these exact bounded-read,
-- partial-write, close and atomic-replace semantics. Directory installation
-- stays outside so importing this module never selects object/GOT output by
-- itself.

use runtime/descriptor_io.{
  DescriptorAppend,
  DescriptorCreateNew,
  DescriptorCreateOrTruncate,
  DescriptorOpenRead,
  DescriptorTargetAbsent,
  DescriptorTargetFailed,
  DescriptorTargetFile,
  DescriptorTargetOther,
  descriptor_close,
  descriptor_flush,
  descriptor_open,
  descriptor_read_append,
  descriptor_remove,
  descriptor_rename,
  descriptor_set_permissions,
  descriptor_target
}
use runtime/string.{runtime_str_byte_at, runtime_str_len, runtime_str_storage_from_vector}
use runtime/safe_write_core.{runtime_safe_write_fd}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/file.{
  FileAppend,
  FileAtomicReplace,
  FileCreateNew,
  FileCreateOrTruncate,
  FileWriteMode
}
use stdlib/io/types.{
  IoAlreadyExists,
  IoError,
  IoInterrupted,
  IoInvalidProgress,
  IoLimitExceeded,
  IoPermissionDenied,
  io_error_from_errno
}
use stdlib/num
use stdlib/path.{Path, path_runtime_string}
use stdlib/result.{Err, Ok, Result}
use stdlib/string.{int_to_str, str_concat}
use stdlib/vector as vector
use stdlib/vector.{vector_len}
use stdlib/vector/handles.{Vector}

fn runtime_safe_file_usize_to_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

fn runtime_safe_file_chunk_size() -> i64 { 4096 }

fn runtime_safe_file_u8(value: i64) -> u8 {
  value.to_u8_checked().unwrap_or(0)
}

pub(package) fn runtime_safe_path_string(path: Path) -> str {
  path_runtime_string(path)
}

pub(package) fn runtime_safe_file_read_result(path: Path, limit: usize) -> Result<Bytes, IoError>
{
  let raw_limit = runtime_safe_file_usize_to_i64(limit)
  if raw_limit < 0 {
    Err<Bytes, IoError>(IoLimitExceeded(limit))
  } else {
    let fd = descriptor_open(runtime_safe_path_string(path), DescriptorOpenRead)
    if fd < 0 {
      Err<Bytes, IoError>(io_error_from_errno(fd))
    } else {
      let initial = if raw_limit < runtime_safe_file_chunk_size() { raw_limit } else {
        runtime_safe_file_chunk_size()
      }
      let mut out = vector.with_capacity<u8>(__i64_to_usize(initial))
      let mut done = false
      let mut failed = false
      let mut failure = IoInvalidProgress
      while not done and not failed {
        let remaining = raw_limit - vector_len<u8>(out)
        let request = if remaining < runtime_safe_file_chunk_size() { remaining + 1 } else {
          runtime_safe_file_chunk_size()
        }
        let status = descriptor_read_append(fd, out, __i64_to_usize(request))
        if status > 0 {
          if status > request {
            failure = IoInvalidProgress
            failed = true
          } else {
            if status > remaining {
              failure = IoLimitExceeded(limit)
              failed = true
            } else { 0 }
          }
        } else {
          if status == 0 {
            done = true
          } else {
            match io_error_from_errno(status) {
              IoInterrupted -> 0
              error -> {
                failure = error
                failed = true
                0
              }
            }
          }
        }
      }
      let close_status = descriptor_close(fd)
      if failed {
        Err<Bytes, IoError>(failure)
      } else {
        if close_status != 0 {
          Err<Bytes, IoError>(io_error_from_errno(close_status))
        } else {
          Ok<Bytes, IoError>(bytes.from_vector(out))
        }
      }
    }
  }
}

fn runtime_safe_file_append_str_bytes(out: borrow mut Vector<u8>, suffix: str) -> i64 {
  let n = runtime_str_len(suffix)
  for i in 0..n {
    out.push(runtime_safe_file_u8(runtime_str_byte_at(suffix, i)))
  }
  n
}

fn runtime_safe_file_temp_path_string(path: Path, attempt: i64) -> str {
  let mut out = path.bytes().to_vector()
  runtime_safe_file_append_str_bytes(out, str_concat(".weft-tmp-", int_to_str(attempt)))
  runtime_str_storage_from_vector(out)
}

fn runtime_safe_file_open_write(path: str, mode: FileWriteMode) -> i64 {
  match mode {
    FileCreateNew -> descriptor_open(path, DescriptorCreateNew)
    FileCreateOrTruncate -> descriptor_open(path, DescriptorCreateOrTruncate)
    FileAppend -> descriptor_open(path, DescriptorAppend)
    FileAtomicReplace -> descriptor_open(path, DescriptorCreateNew)
  }
}

fn runtime_safe_file_write_opened(fd: i64, values: Bytes) -> Result<usize, IoError> {
  let result = runtime_safe_write_fd(fd, values)
  let close_status = descriptor_close(fd)
  match result {
    Err(error) -> Err<usize, IoError>(error)
    Ok(count) -> if close_status == 0 {
      Ok<usize, IoError>(count)
    } else {
      Err<usize, IoError>(io_error_from_errno(close_status))
    }
  }
}

fn runtime_safe_file_write_direct(
  path: Path,
  values: Bytes,
  mode: FileWriteMode
) -> Result<usize, IoError> {
  let fd = runtime_safe_file_open_write(runtime_safe_path_string(path), mode)
  if fd < 0 { Err<usize, IoError>(io_error_from_errno(fd)) }
  else { runtime_safe_file_write_opened(fd, values) }
}

-- Replacing a file's contents keeps what the file is: its permission bits
-- carry over, and a file that grants no write permission is refused exactly
-- as truncation refuses it. The replacement is durable before it becomes
-- visible: the temporary is synced, then renamed over the target in the same
-- directory, so readers see either the old bytes or the new ones.
fn runtime_safe_file_write_atomic(path: Path, values: Bytes) -> Result<usize, IoError> {
  let target = runtime_safe_path_string(path)
  let permissions = match descriptor_target(target) {
    DescriptorTargetFailed(status) -> return Err(io_error_from_errno(status))
    DescriptorTargetFile(bits) -> {
      if (bits band 146) == 0 { return Err(IoPermissionDenied) }
      bits
    }
    DescriptorTargetAbsent -> -1
    DescriptorTargetOther -> -1
  }
  let mut attempt = 0
  let mut fd = -1
  let mut temp = ""
  let mut failure = IoAlreadyExists
  while fd < 0 and attempt < 64 {
    temp = runtime_safe_file_temp_path_string(path, attempt)
    let opened = runtime_safe_file_open_write(temp, FileAtomicReplace)
    if opened >= 0 { fd = opened }
    else {
      match io_error_from_errno(opened) {
        IoAlreadyExists -> { attempt = attempt + 1 }
        error -> {
          failure = error
          attempt = 64
        }
      }
    }
  }
  if fd < 0 { return Err(failure) }
  let kept = if permissions < 0 { 0 } else { descriptor_set_permissions(fd, permissions) }
  let written = if kept < 0 { Err<usize, IoError>(io_error_from_errno(kept)) }
  else { runtime_safe_write_fd(fd, values) }
  let synced = match written {
    Ok(_) -> descriptor_flush(fd)
    Err(_) -> 0
  }
  let closed = descriptor_close(fd)
  match written {
    Err(error) -> {
      descriptor_remove(temp)
      Err(error)
    }
    Ok(count) -> if synced < 0 or closed < 0 {
      descriptor_remove(temp)
      Err(io_error_from_errno(if synced < 0 { synced } else { closed }))
    } else {
      let renamed = descriptor_rename(temp, target)
      if renamed == 0 { Ok(count) }
      else {
        descriptor_remove(temp)
        Err(io_error_from_errno(renamed))
      }
    }
  }
}

pub(package) fn runtime_safe_file_write_result(
  path: Path,
  values: Bytes,
  mode: FileWriteMode
) -> Result<usize, IoError> {
  match mode {
    FileAtomicReplace -> runtime_safe_file_write_atomic(path, values)
    _ -> runtime_safe_file_write_direct(path, values, mode)
  }
}
