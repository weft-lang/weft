-- runtime/types_storage.weft -- trusted storage bridge for compiler type nodes

use runtime/alloc.{*}

pub(package) fn types_storage_type_new(tag: i64, f1: i64, f2: i64, f3: i64, f4: i64) -> i64 {
  let t = alloc_bump(40)
  __mem_store64(t, tag)
  __mem_store64(t + 8, f1)
  __mem_store64(t + 16, f2)
  __mem_store64(t + 24, f3)
  __mem_store64(t + 32, f4)
  t
}

pub(package) fn types_storage_type_tag(t: i64) -> i64 { __mem_load64(t) }
pub(package) fn types_storage_type_f1(t: i64) -> i64 { __mem_load64(t + 8) }
pub(package) fn types_storage_type_f2(t: i64) -> i64 { __mem_load64(t + 16) }
pub(package) fn types_storage_type_f3(t: i64) -> i64 { __mem_load64(t + 24) }
pub(package) fn types_storage_type_f4(t: i64) -> i64 { __mem_load64(t + 32) }

pub(package) fn types_storage_dnf_clause_new(pos: i64, neg: i64) -> i64 {
  let c = alloc_bump(24)
  __mem_store64(c, pos)
  __mem_store64(c + 8, neg)
  __mem_store64(c + 16, 0)
  c
}

pub(package) fn types_storage_dnf_clause_pos(c: i64) -> i64 { __mem_load64(c) }
pub(package) fn types_storage_dnf_clause_neg(c: i64) -> i64 { __mem_load64(c + 8) }

pub(package) fn types_storage_type_entry_name_start(entry: i64) -> i64 { __mem_load64(entry) }
pub(package) fn types_storage_type_entry_name_len(entry: i64) -> i64 { __mem_load64(entry + 8) }
pub(package) fn types_storage_type_entry_kind(entry: i64) -> i64 { __mem_load64(entry + 16) }
pub(package) fn types_storage_type_entry_payload_count(entry: i64) -> i64 { __mem_load64(entry + 24) }
pub(package) fn types_storage_type_entry_payload(entry: i64) -> i64 { __mem_load64(entry + 32) }
pub(package) fn types_storage_type_entry_type_params(entry: i64) -> i64 { __mem_load64(entry + 40) }
pub(package) fn types_storage_type_entry_source(entry: i64) -> i64 { __mem_load64(entry + 48) }

pub(package) fn types_storage_type_table_entry(tt: i64, index: i64) -> i64 {
  __mem_load64(tt) + index * 64
}

pub(package) fn types_storage_type_table_count(tt: i64) -> i64 {
  __mem_load64(tt + 8)
}

pub(package) fn types_storage_record_field_name_start(fields: i64, index: i64) -> i64 {
  __mem_load64(fields + index * 24)
}

pub(package) fn types_storage_record_field_name_len(fields: i64, index: i64) -> i64 {
  __mem_load64(fields + index * 24 + 8)
}

pub(package) fn types_storage_record_field_type_node(fields: i64, index: i64) -> i64 {
  __mem_load64(fields + index * 24 + 16)
}

pub(package) fn types_storage_variant_name_start(variants: i64, index: i64) -> i64 {
  __mem_load64(variants + index * 40)
}

pub(package) fn types_storage_variant_name_len(variants: i64, index: i64) -> i64 {
  __mem_load64(variants + index * 40 + 8)
}

pub(package) fn types_storage_variant_payload_count(variants: i64, index: i64) -> i64 {
  __mem_load64(variants + index * 40 + 24)
}

pub(package) fn types_storage_variant_payloads(variants: i64, index: i64) -> i64 {
  __mem_load64(variants + index * 40 + 32)
}
