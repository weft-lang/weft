-- runtime/macho_storage.weft -- trusted Mach-O emission storage bridge

use "runtime/alloc.weft"

fn macho_storage_alloc_scratch(size: i64) -> i64 {
  alloc_bump(size)
}

fn macho_storage_byte_at(ptr: i64, off: i64) -> i64 {
  __mem_load8(ptr + off)
}

fn macho_storage_got_patch_count(fm: i64) -> i64 {
  __mem_load64(fm + 128)
}
