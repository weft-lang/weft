-- runtime/terminal.weft -- terminal presentation policy and capability probes

use runtime/alloc.{alloc_runtime_state_ptr, alloc_words}
use runtime/memory.{mem_load8_at, mem_load64_at, mem_store64_at}
use runtime/syscall.{sys_terminal_is_tty}

-- Scratch covers both supported native terminal records. The semantic leaf
-- owns target request constants and native layout; this storage is never
-- interpreted by ordinary runtime code.
pub(package) fn terminal_tty_scratch_words() -> i64 { 16 }

-- Compiler twin: runtime_state_diagnostic_color_mode_offset in codegen.weft.
-- Zero is auto, one is never, two is always. Explicit modes are resolved at
-- process entry, before any type/source registry can cache the TTY decision.
pub(package) fn terminal_diagnostic_color_mode_offset() -> i64 { 168 }
pub(package) fn terminal_color_mode_auto() -> i64 { 0 }
pub(package) fn terminal_color_mode_never() -> i64 { 1 }
pub(package) fn terminal_color_mode_always() -> i64 { 2 }

pub(package) fn terminal_fd_is_tty(fd: i64) -> i64 {
  sys_terminal_is_tty(fd, alloc_words(terminal_tty_scratch_words()))
}

pub(package) fn terminal_set_stderr_color_mode(mode: i64) -> i64 {
  let normalized = if mode == terminal_color_mode_never() or mode == terminal_color_mode_always() { mode }
    else { terminal_color_mode_auto() }
  mem_store64_at(alloc_runtime_state_ptr() + terminal_diagnostic_color_mode_offset(), 0, normalized)
  0
}

pub(package) fn terminal_stderr_color_mode() -> i64 {
  mem_load64_at(alloc_runtime_state_ptr() + terminal_diagnostic_color_mode_offset(), 0)
}

pub(package) fn terminal_color_policy(stderr_is_tty: i64, requested_mode: i64) -> i64 {
  if requested_mode == terminal_color_mode_always() { 1 }
  else { if requested_mode == terminal_color_mode_never() { 0 }
  else { if stderr_is_tty == 1 { 1 } else { 0 } } }
}

pub(package) fn terminal_env_name_matches(entry: i64, name: str) -> i64 {
  let name_ptr = __str_ptr(name)
  let name_len = __str_len(name)
  let mut i = 0
  while i < name_len and mem_load8_at(entry, i) == mem_load8_at(name_ptr, i) { i = i + 1 }
  if i == name_len and mem_load8_at(entry, name_len) == 61 { 1 } else { 0 }
}

pub(package) fn terminal_env_value_equals(entry: i64, name: str, expected: str) -> i64 {
  if terminal_env_name_matches(entry, name) == 0 { 0 }
  else {
    let value = entry + __str_len(name) + 1
    let expected_ptr = __str_ptr(expected)
    let expected_len = __str_len(expected)
    let mut i = 0
    while i < expected_len and mem_load8_at(value, i) == mem_load8_at(expected_ptr, i) { i = i + 1 }
    if i == expected_len and mem_load8_at(value, i) == 0 { 1 } else { 0 }
  }
}

pub(package) fn terminal_environment_color_mode(envp: i64) -> i64 {
  let mut i = 0
  let mut mode = terminal_color_mode_auto()
  while mem_load64_at(envp, i * 8) != 0 and mode == terminal_color_mode_auto() {
    let entry = mem_load64_at(envp, i * 8)
    if terminal_env_name_matches(entry, "NO_COLOR") == 1 and mem_load8_at(entry, __str_len("NO_COLOR") + 1) != 0 {
      mode = terminal_color_mode_never()
    } else { if terminal_env_value_equals(entry, "TERM", "dumb") == 1 {
      mode = terminal_color_mode_never()
    } else { 0 } }
    i = i + 1
  }
  mode
}

pub(package) fn terminal_stderr_color_enabled() -> i64 {
  terminal_color_policy(terminal_fd_is_tty(2), terminal_stderr_color_mode())
}
