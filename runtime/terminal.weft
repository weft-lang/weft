-- runtime/terminal.weft -- terminal presentation policy and capability probes
--
-- A trusted runtime leaf: it owns the diagnostic colour cell in the shared
-- runtime state and the native scratch its TTY probe hands the platform.
-- Every function it exports is safe; the scratch never outlives a probe.

use runtime/alloc.{
  alloc_bump_mark,
  alloc_bump_restore_same_segment,
  alloc_runtime_shared_state_ptr,
  alloc_words
}
use runtime/memory.{mem_load64_at, mem_store64_at}
use runtime/syscall.{sys_terminal_is_tty}

-- Scratch covers both supported native terminal records. The semantic leaf
-- owns target request constants and native layout; this storage is never
-- interpreted by ordinary runtime code.
pub(package) fn terminal_tty_scratch_words() -> i64 { 16 }

-- Compiler twin: runtime_state_diagnostic_color_mode_offset in codegen.weft.
-- Zero is auto, one is never, two is always. Explicit modes are resolved at
-- process entry, before any type/source registry can cache the TTY decision.
pub(package) fn terminal_diagnostic_color_mode_offset() -> i64 { 168 }

pub(package) fn terminal_color_mode_auto() -> i64 { 0 }

pub(package) fn terminal_color_mode_never() -> i64 { 1 }

pub(package) fn terminal_color_mode_always() -> i64 { 2 }

pub(package) fn terminal_fd_is_tty(fd: i64) -> i64 {
  let mark = alloc_bump_mark()
  let tty = sys_terminal_is_tty(fd, alloc_words(terminal_tty_scratch_words()))
  alloc_bump_restore_same_segment(mark)
  tty
}

pub(package) fn terminal_set_stderr_color_mode(mode: i64) -> i64 {
  let normalized = if mode == terminal_color_mode_never() or mode == terminal_color_mode_always() {
    mode
  }
  else { terminal_color_mode_auto() }
  mem_store64_at(
    alloc_runtime_shared_state_ptr() + terminal_diagnostic_color_mode_offset(),
    0,
    normalized
  )
  0
}

pub(package) fn terminal_stderr_color_mode() -> i64 {
  mem_load64_at(alloc_runtime_shared_state_ptr() + terminal_diagnostic_color_mode_offset(), 0)
}

pub(package) fn terminal_color_policy(stderr_is_tty: i64, requested_mode: i64) -> i64 {
  if requested_mode == terminal_color_mode_always() { 1 }
  else {
    if requested_mode == terminal_color_mode_never() { 0 }
    else { if stderr_is_tty == 1 { 1 } else { 0 } }
  }
}

pub(package) fn terminal_stderr_color_enabled() -> i64 {
  terminal_color_policy(terminal_fd_is_tty(2), terminal_stderr_color_mode())
}
