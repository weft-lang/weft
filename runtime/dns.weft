-- runtime/dns.weft — sealed Darwin system resolver handler
--
-- getaddrinfo-owned storage never crosses this module. Every sockaddr is
-- copied into public typed values before freeaddrinfo, and all temporary C ABI
-- buffers are reclaimed with the enclosing bump mark.

use runtime/alloc.{alloc_bump, alloc_bump_mark, alloc_bump_restore_same_segment}
use runtime/string.{runtime_str_cstring}
use runtime/unsafe.{Unsafe}
use stdlib/display.{Display}
use stdlib/dns.{DnsAnyFamily, DnsError, DnsFamily, DnsFamilyUnavailable, DnsIpv4Only, DnsIpv6Only, DnsNameNotFound, DnsPermanentFailure, DnsPlatform, DnsResolve, DnsResourceExhausted, DnsTemporaryFailure, dns_numeric_candidates}
use stdlib/idna.{DomainName}
use stdlib/net_address.{IpV4, SocketAddress, SocketV4, SocketV6, ip_address_parse, ipv4_address, ipv6_address}
use stdlib/num.{num_i64_to_u16_checked, num_i64_to_u32_checked, num_i64_to_u8_checked, num_int_cast_value_or}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/string.{int_to_str}
use stdlib/vector.{vector_len, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

fn runtime_dns_addrinfo_size() -> i64 { 48 }

fn runtime_dns_addrinfo_family_offset() -> i64 { 4 }

fn runtime_dns_addrinfo_socktype_offset() -> i64 { 8 }

fn runtime_dns_addrinfo_protocol_offset() -> i64 { 12 }

fn runtime_dns_addrinfo_addrlen_offset() -> i64 { 16 }

fn runtime_dns_addrinfo_addr_offset() -> i64 { 32 }

fn runtime_dns_addrinfo_next_offset() -> i64 { 40 }

fn runtime_dns_af_unspec() -> i64 { 0 }

fn runtime_dns_af_inet() -> i64 { 2 }

fn runtime_dns_af_inet6() -> i64 { 30 }

fn runtime_dns_sock_stream() -> i64 { 1 }

fn runtime_dns_ipproto_tcp() -> i64 { 6 }

fn runtime_dns_ai_numericserv() -> i64 { 4096 }

fn runtime_dns_getaddrinfo(host: i64, service: i64, hints: i64, result: i64) -[Unsafe]> i64 {
  __got_getaddrinfo(host, service, hints, result, 0, 0)
}

fn runtime_dns_freeaddrinfo(result: i64) -[Unsafe]> nil {
  __got_freeaddrinfo(result, 0, 0, 0, 0, 0)
  nil
}

fn runtime_dns_errno() -[Unsafe]> i64 {
  let pointer = __got___error(0, 0, 0, 0, 0, 0)
  __mem_load8(pointer) +
    __mem_load8(pointer + 1) * 256 +
    __mem_load8(pointer + 2) * 65536 +
    __mem_load8(pointer + 3) * 16777216
}

fn runtime_dns_store_u32(pointer: i64, value: i64) -[Unsafe]> nil {
  __mem_store8(pointer, value band 255)
  __mem_store8(pointer + 1, (value bshr 8) band 255)
  __mem_store8(pointer + 2, (value bshr 16) band 255)
  __mem_store8(pointer + 3, (value bshr 24) band 255)
  nil
}

fn runtime_dns_load_u32(pointer: i64) -[Unsafe]> i64 {
  __mem_load8(pointer) +
    __mem_load8(pointer + 1) * 256 +
    __mem_load8(pointer + 2) * 65536 +
    __mem_load8(pointer + 3) * 16777216
}

fn runtime_dns_i64_to_u8(value: i64) -> u8 {
  num_int_cast_value_or<u8>(num_i64_to_u8_checked(value), 0)
}

fn runtime_dns_i64_to_u16(value: i64) -> u16 {
  num_int_cast_value_or<u16>(num_i64_to_u16_checked(value), 0)
}

fn runtime_dns_i64_to_u32(value: i64) -> u32 {
  num_int_cast_value_or<u32>(num_i64_to_u32_checked(value), 0)
}

fn runtime_dns_family_code(family: DnsFamily) -> i64 {
  match family {
    DnsAnyFamily -> runtime_dns_af_unspec()
    DnsIpv4Only -> runtime_dns_af_inet()
    DnsIpv6Only -> runtime_dns_af_inet6()
  }
}

pub(package) fn runtime_dns_error_from_status(status: i64, system_error: i64) -> DnsError {
  match status {
    1 -> DnsFamilyUnavailable
    2 -> DnsTemporaryFailure
    3 -> DnsPermanentFailure
    4 -> DnsPermanentFailure
    5 -> DnsFamilyUnavailable
    6 -> DnsResourceExhausted
    7 -> DnsNameNotFound
    8 -> DnsNameNotFound
    9 -> DnsPermanentFailure
    10 -> DnsPermanentFailure
    11 -> DnsPlatform(system_error)
    12 -> DnsPermanentFailure
    13 -> DnsPermanentFailure
    14 -> DnsResourceExhausted
    _ -> DnsPlatform(status)
  }
}

fn runtime_dns_ipv4_candidate(sockaddr: i64, port: u16) -[Unsafe]> SocketAddress {
  SocketV4(
    ipv4_address(
    runtime_dns_i64_to_u8(__mem_load8(sockaddr + 4)),
    runtime_dns_i64_to_u8(__mem_load8(sockaddr + 5)),
    runtime_dns_i64_to_u8(__mem_load8(sockaddr + 6)),
    runtime_dns_i64_to_u8(__mem_load8(sockaddr + 7))
  ),
    port
  )
}

fn runtime_dns_ipv6_segment(sockaddr: i64, index: i64) -[Unsafe]> u16 {
  let offset = sockaddr + 8 + index * 2
  runtime_dns_i64_to_u16(__mem_load8(offset) * 256 + __mem_load8(offset + 1))
}

fn runtime_dns_ipv6_candidate(sockaddr: i64, port: u16) -[Unsafe]> SocketAddress {
  SocketV6(
    ipv6_address(
    runtime_dns_ipv6_segment(sockaddr, 0),
    runtime_dns_ipv6_segment(sockaddr, 1),
    runtime_dns_ipv6_segment(sockaddr, 2),
    runtime_dns_ipv6_segment(sockaddr, 3),
    runtime_dns_ipv6_segment(sockaddr, 4),
    runtime_dns_ipv6_segment(sockaddr, 5),
    runtime_dns_ipv6_segment(sockaddr, 6),
    runtime_dns_ipv6_segment(sockaddr, 7)
  ),
    port,
    runtime_dns_i64_to_u32(runtime_dns_load_u32(sockaddr + 24))
  )
}

fn runtime_dns_copy_results(first: i64, port: u16) -[Unsafe]> Result<Vector<SocketAddress>, DnsError> {
  let candidates = vector_with_capacity<SocketAddress>(4)
  let mut current = first
  let mut allocation_failed = false
  while current != 0 and not allocation_failed {
    let family = runtime_dns_load_u32(current + runtime_dns_addrinfo_family_offset())
    let address_len = runtime_dns_load_u32(current + runtime_dns_addrinfo_addrlen_offset())
    let address = __mem_load64(current + runtime_dns_addrinfo_addr_offset())
    if family == runtime_dns_af_inet() and address != 0 and address_len >= 16 {
      if vector_push<SocketAddress>(candidates, runtime_dns_ipv4_candidate(address, port)) == 0 {
        allocation_failed = true
      } else { 0 }
    } else { if family == runtime_dns_af_inet6() and address != 0 and address_len >= 28 {
        if vector_push<SocketAddress>(candidates, runtime_dns_ipv6_candidate(address, port)) == 0 {
          allocation_failed = true
        } else { 0 }
      } else { 0 } }
    current = __mem_load64(current + runtime_dns_addrinfo_next_offset())
  }
  if allocation_failed {
    result_err<Vector<SocketAddress>, DnsError>(DnsResourceExhausted)
  } else { if vector_len<SocketAddress>(candidates) == 0 {
      result_err<Vector<SocketAddress>, DnsError>(DnsFamilyUnavailable)
    } else {
      result_ok<Vector<SocketAddress>, DnsError>(candidates)
    } }
}

fn runtime_dns_resolve_system(
  host: DomainName,
  port: u16,
  family: DnsFamily
) -[Unsafe]> Result<Vector<SocketAddress>, DnsError> {
  let mark = alloc_bump_mark()
  let host_string = host.display()
  let service_string = int_to_str(__u64_to_i64(__u16_to_u64(port)))
  let host_c = runtime_str_cstring(host_string)
  let service_c = runtime_str_cstring(service_string)
  let hints = alloc_bump(runtime_dns_addrinfo_size())
  let result_slot = alloc_bump(8)
  for index in 0..runtime_dns_addrinfo_size() {
    __mem_store8(hints + index, 0)
  }
  runtime_dns_store_u32(hints, runtime_dns_ai_numericserv())
  runtime_dns_store_u32(hints + runtime_dns_addrinfo_family_offset(), runtime_dns_family_code(family))
  runtime_dns_store_u32(hints + runtime_dns_addrinfo_socktype_offset(), runtime_dns_sock_stream())
  runtime_dns_store_u32(hints + runtime_dns_addrinfo_protocol_offset(), runtime_dns_ipproto_tcp())
  __mem_store64(result_slot, 0)

  let status = runtime_dns_getaddrinfo(host_c, service_c, hints, result_slot)
  let system_error = if status == 11 { runtime_dns_errno() } else { 0 }
  let first = __mem_load64(result_slot)
  let resolved: Result<Vector<SocketAddress>, DnsError> = if status == 0 {
    if first == 0 {
      result_err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
    } else {
      runtime_dns_copy_results(first, port)
    }
  } else {
    result_err<Vector<SocketAddress>, DnsError>(runtime_dns_error_from_status(status, system_error))
  }
  if first != 0 { runtime_dns_freeaddrinfo(first) } else { nil }
  alloc_bump_restore_same_segment(mark)
  resolved
}

fn runtime_dns_resolve(
  host: DomainName,
  port: u16,
  family: DnsFamily
) -[Unsafe]> Result<Vector<SocketAddress>, DnsError> {
  match ip_address_parse(host.ascii()) {
    Ok(IpV4(address)) -> dns_numeric_candidates(IpV4(address), port, family)
    Ok(_) -> runtime_dns_resolve_system(host, port, family)
    Err(_) -> runtime_dns_resolve_system(host, port, family)
  }
}

fn runtime_dns_handle<T, E>(body: () -[DnsResolve, E]> T) -[Unsafe, E]> T {
  handle body() {
    DnsResolve.resolve(host, port, family) -> resume(runtime_dns_resolve(host, port, family))
  }
}

--- Install the Darwin system resolver while preserving result and residual effects.
pub fn runtime_platform_dns<T, E>(body: () -[DnsResolve, E]> T) -[E]> T {
  handle runtime_dns_handle<T, E>(body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
