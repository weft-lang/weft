-- runtime/descriptor_io.weft -- typed descriptor transfers for strict callers
--
-- Callers pass views and byte vectors; storage addresses stay inside this
-- trusted leaf. Every range is checked against the storage it names before a
-- syscall touches it, and every status is the platform result: a byte count,
-- or a negative error.

use runtime/syscall.{sys_read, sys_write}
use runtime/vector_storage.{
  vector_storage_data,
  vector_storage_handle_word,
  vector_storage_len,
  vector_storage_word_capacity,
  vector_storage_word_element_size,
  vector_storage_word_set_len
}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

fn descriptor_count(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

--- Read at most `buffer.len` bytes from `fd` into a non-escaping view.
pub(package) fn descriptor_read_into(fd: i64, buffer: [mut u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, __i64_to_u8(0)) }
    let status = sys_read(fd, vector_storage_data<u8>(scratch), length)
    if status > length { 0 - 1 }
    else {
      for index in 0..status {
        buffer[__i64_to_usize(index)] = vector_get_in_bounds<u8>(scratch, index)
      }
      status
    }
  }
}

--- Write at most `buffer.len` bytes from a non-escaping view to `fd`.
pub(package) fn descriptor_write_from(fd: i64, buffer: [u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, buffer[__i64_to_usize(index)]) }
    sys_write(fd, vector_storage_data<u8>(scratch), length)
  }
}

--- Read at most `request` bytes from `fd`, appending them to a byte vector's
--- reserved capacity. The read is refused when the reservation cannot hold
--- the request.
pub(package) fn descriptor_read_append(fd: i64, values: borrow Vector<u8>, request: i64) -> i64 {
  let word = vector_storage_handle_word<u8>(values)
  let len = vector_storage_len<u8>(values)
  if word == 0 or request < 0 or vector_storage_word_element_size(word) != 1 or
    request > vector_storage_word_capacity(word) - len { 0 - 1 }
  else {
    if request == 0 { 0 }
    else {
      let status = sys_read(fd, vector_storage_data<u8>(values) + len, request)
      if status > 0 {
        if status > request { 0 - 1 }
        else {
          vector_storage_word_set_len(word, len + status)
          status
        }
      } else { status }
    }
  }
}

--- Write bytes `[offset, offset + count)` of a byte vector to `fd`.
pub(package) fn descriptor_write_range(
  fd: i64,
  values: borrow Vector<u8>,
  offset: i64,
  count: i64
) -> i64 {
  let word = vector_storage_handle_word<u8>(values)
  let len = vector_storage_len<u8>(values)
  if word == 0 or offset < 0 or count < 0 or vector_storage_word_element_size(word) != 1 or
    offset > len - count { 0 - 1 }
  else {
    if count == 0 { 0 } else { sys_write(fd, vector_storage_data<u8>(values) + offset, count) }
  }
}
