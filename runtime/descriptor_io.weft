-- runtime/descriptor_io.weft -- typed descriptor and path syscalls for strict callers
--
-- Callers pass `str` paths, views and byte vectors; C strings and storage
-- addresses stay inside this trusted leaf. Every transfer is bounded by the
-- storage it names before a syscall touches it, and every status is the
-- platform result verbatim: a descriptor or byte count, or a negative error.
-- Callers classify impossible progress; a status above the request never
-- grows or writes caller storage.

use runtime/string.{runtime_str_with_cstring_i64}
use runtime/syscall.{
  sys_close,
  sys_file_flush,
  sys_open_read,
  sys_open_read_write_create_truncate,
  sys_open_write_append,
  sys_open_write_create_new,
  sys_open_write_create_truncate,
  sys_read,
  sys_remove,
  sys_rename,
  sys_seek_current,
  sys_seek_end,
  sys_seek_start,
  sys_write
}
use runtime/vector_storage.{
  vector_storage_data,
  vector_storage_handle_word,
  vector_storage_len,
  vector_storage_word_set_len
}
use stdlib/panic.{panic}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

fn descriptor_count(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

--- How `descriptor_open` opens or creates a path.
pub(package) type DescriptorOpen {
  --- Open an existing file for reading.
  DescriptorOpenRead,
  --- Create a file for writing, failing if it exists.
  DescriptorCreateNew,
  --- Create a file for writing or truncate an existing one.
  DescriptorCreateOrTruncate,
  --- Create a file for writing or append to an existing one.
  DescriptorAppend,
  --- Create a file for reading and writing or truncate an existing one.
  DescriptorReadWriteTruncate
}

--- The reference point of `descriptor_seek`.
pub(package) type DescriptorSeekOrigin {
  --- Offset from the beginning of the file.
  DescriptorSeekStart,
  --- Offset from the current position.
  DescriptorSeekCurrent,
  --- Offset from the end of the file.
  DescriptorSeekEnd
}

-- Created files are readable by everyone and writable by their owner.
fn descriptor_created_mode() -> i64 { 420 }

--- Open `path` as `mode` describes, returning a descriptor or a negative
--- platform status.
pub(package) fn descriptor_open(path: str, mode: DescriptorOpen) -> i64 {
  let created = descriptor_created_mode()
  runtime_str_with_cstring_i64(
    path,
    (raw_path) => match mode {
      DescriptorOpenRead -> sys_open_read(raw_path)
      DescriptorCreateNew -> sys_open_write_create_new(raw_path, created)
      DescriptorCreateOrTruncate -> sys_open_write_create_truncate(raw_path, created)
      DescriptorAppend -> sys_open_write_append(raw_path, created)
      DescriptorReadWriteTruncate -> sys_open_read_write_create_truncate(raw_path, created)
    }
  )
}

--- Close a descriptor.
pub(package) fn descriptor_close(fd: i64) -> i64 {
  sys_close(fd)
}

--- Reposition a descriptor, returning the new offset or a negative status.
pub(package) fn descriptor_seek(fd: i64, offset: i64, origin: DescriptorSeekOrigin) -> i64 {
  match origin {
    DescriptorSeekStart -> sys_seek_start(fd, offset)
    DescriptorSeekCurrent -> sys_seek_current(fd, offset)
    DescriptorSeekEnd -> sys_seek_end(fd, offset)
  }
}

--- Flush a descriptor's buffered writes to the platform.
pub(package) fn descriptor_flush(fd: i64) -> i64 {
  sys_file_flush(fd)
}

--- Remove the file at `path`.
pub(package) fn descriptor_remove(path: str) -> i64 {
  runtime_str_with_cstring_i64(path, (raw_path) => sys_remove(raw_path))
}

--- Rename `from` to `to`, replacing any existing file at `to`.
pub(package) fn descriptor_rename(from: str, to: str) -> i64 {
  runtime_str_with_cstring_i64(
    from,
    (raw_from) => runtime_str_with_cstring_i64(to, (raw_to) => sys_rename(raw_from, raw_to))
  )
}

--- Read at most `buffer.len` bytes from `fd` into a non-escaping view.
pub(package) fn descriptor_read_into(fd: i64, buffer: [mut u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, __i64_to_u8(0)) }
    let status = sys_read(fd, vector_storage_data<u8>(scratch), length)
    if status > 0 and status <= length {
      for index in 0..status {
        buffer[__i64_to_usize(index)] = vector_get_in_bounds<u8>(scratch, index)
      }
    } else { 0 }
    status
  }
}

--- Write at most `buffer.len` bytes from a non-escaping view to `fd`.
pub(package) fn descriptor_write_from(fd: i64, buffer: [u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, buffer[__i64_to_usize(index)]) }
    sys_write(fd, vector_storage_data<u8>(scratch), length)
  }
}

--- Read at most `request` bytes from `fd` directly after a byte vector's
--- initialized elements. The vector first reserves room for the request and
--- grows only by a count the platform could have produced.
pub(package) fn descriptor_read_append(
  fd: i64,
  values: borrow mut Vector<u8>,
  request: usize
) -> i64 {
  let count = descriptor_count(request)
  if count == 0 { 0 }
  else {
    -- An unrepresentable request panics here, before any syscall.
    values.reserve(request)
    let len = vector_storage_len<u8>(values)
    let status = sys_read(fd, vector_storage_data<u8>(values) + len, count)
    if status > 0 and status <= count {
      vector_storage_word_set_len(vector_storage_handle_word<u8>(values), len + status)
    } else { 0 }
    status
  }
}

--- Write the initialized bytes of a byte vector from `offset` to its end.
--- Panic when `offset` lies beyond the initialized elements.
pub(package) fn descriptor_write_suffix(fd: i64, values: borrow Vector<u8>, offset: usize) -> i64
{
  let len = vector_storage_len<u8>(values)
  let start = descriptor_count(offset)
  if start < 0 or start > len { panic("Descriptor write offset is outside the vector") }
  else { 0 }
  if start == len { 0 }
  else { sys_write(fd, vector_storage_data<u8>(values) + start, len - start) }
}
