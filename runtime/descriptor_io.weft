-- runtime/descriptor_io.weft -- typed descriptor transfers for strict callers
--
-- Callers pass views and byte vectors; storage addresses stay inside this
-- trusted leaf. Every transfer is bounded by the storage it names before a
-- syscall touches it, and every status is the platform result verbatim: a
-- byte count, or a negative error. Callers classify impossible progress; a
-- status above the request never grows or writes caller storage.

use runtime/syscall.{sys_read, sys_write}
use runtime/vector_storage.{
  vector_storage_data,
  vector_storage_handle_word,
  vector_storage_len,
  vector_storage_word_set_len
}
use stdlib/panic.{panic}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

fn descriptor_count(value: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(value))
}

--- Read at most `buffer.len` bytes from `fd` into a non-escaping view.
pub(package) fn descriptor_read_into(fd: i64, buffer: [mut u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, __i64_to_u8(0)) }
    let status = sys_read(fd, vector_storage_data<u8>(scratch), length)
    if status > 0 and status <= length {
      for index in 0..status {
        buffer[__i64_to_usize(index)] = vector_get_in_bounds<u8>(scratch, index)
      }
    } else { 0 }
    status
  }
}

--- Write at most `buffer.len` bytes from a non-escaping view to `fd`.
pub(package) fn descriptor_write_from(fd: i64, buffer: [u8]) -> i64 {
  let length = descriptor_count(buffer.len)
  if length <= 0 { 0 }
  else {
    let scratch = vector.with_capacity<u8>(buffer.len)
    for index in 0..length { vector_push<u8>(scratch, buffer[__i64_to_usize(index)]) }
    sys_write(fd, vector_storage_data<u8>(scratch), length)
  }
}

--- Read at most `request` bytes from `fd` directly after a byte vector's
--- initialized elements. The vector first reserves room for the request and
--- grows only by a count the platform could have produced.
pub(package) fn descriptor_read_append(
  fd: i64,
  values: borrow mut Vector<u8>,
  request: usize
) -> i64 {
  let count = descriptor_count(request)
  if count == 0 { 0 }
  else {
    -- An unrepresentable request panics here, before any syscall.
    values.reserve(request)
    let len = vector_storage_len<u8>(values)
    let status = sys_read(fd, vector_storage_data<u8>(values) + len, count)
    if status > 0 and status <= count {
      vector_storage_word_set_len(vector_storage_handle_word<u8>(values), len + status)
    } else { 0 }
    status
  }
}

--- Write the initialized bytes of a byte vector from `offset` to its end.
--- Panic when `offset` lies beyond the initialized elements.
pub(package) fn descriptor_write_suffix(fd: i64, values: borrow Vector<u8>, offset: usize) -> i64
{
  let len = vector_storage_len<u8>(values)
  let start = descriptor_count(offset)
  if start < 0 or start > len { panic("Descriptor write offset is outside the vector") }
  else { 0 }
  if start == len { 0 }
  else { sys_write(fd, vector_storage_data<u8>(values) + start, len - start) }
}
