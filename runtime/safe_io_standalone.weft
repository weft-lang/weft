-- runtime/safe_io_standalone.weft — direct semantic I/O for static tools
--
-- The self-hosted compiler must remain an executable rather than selecting the
-- dynamic-loader path. It shares the backend-neutral file and directory joins
-- with runtime/safe_io and installs the target-semantic direct Dir backend.

use runtime/dir.{runtime_platform_dir, runtime_platform_dir_with}
use runtime/safe_dir_core.{runtime_safe_dir_list_result, runtime_safe_dir_metadata_result, runtime_safe_dir_path_result, runtime_safe_nil_status}
use runtime/safe_file_core.{runtime_safe_file_read_result, runtime_safe_file_write_result, runtime_safe_path_string}
use stdlib/dir.{Dir, DirInspect, DirMutate}
use stdlib/file.{FileRead, FileWrite}

pub(package) fn runtime_standalone_file_read(body: () -[FileRead]> i64) -> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub(package) fn runtime_standalone_file_write(body: () -[FileWrite]> i64) -> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_standalone_read_write_read(body: () -[FileRead, FileWrite]> i64) -[FileWrite]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub(package) fn runtime_standalone_file_read_write(body: () -[FileRead, FileWrite]> i64) -> i64 {
  handle runtime_standalone_read_write_read(body) {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_standalone_package_file_read(
  body: () -[FileRead, FileWrite, DirInspect]> i64
) -[FileWrite, DirInspect]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

fn runtime_standalone_package_file_write(
  body: () -[FileWrite, DirInspect]> i64
) -[DirInspect]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_standalone_package_dir_inspect(
  body: () -[DirInspect, Dir]> i64
) -[Dir]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  }
}

-- Exact package boundary: FileWrite is self-contained; only DirInspect
-- consumes the legacy directory backend.
pub(package) fn runtime_standalone_package_io(
  body: () -[FileRead, FileWrite, DirInspect]> i64
) -> i64 {
  runtime_platform_dir(() =>
    runtime_standalone_package_dir_inspect(() =>
      runtime_standalone_package_file_write(() =>
        runtime_standalone_package_file_read(body))))
}

fn runtime_standalone_package_dir_mutate(
  body: () -[DirMutate, Dir]> i64
) -[Dir]> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(Dir.mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(Dir.remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(Dir.rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

fn runtime_standalone_package_mutation_file_read(
  body: () -[FileRead, FileWrite, DirInspect, DirMutate]> i64
) -[FileWrite, DirInspect, DirMutate]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

fn runtime_standalone_package_mutation_file_write(
  body: () -[FileWrite, DirInspect, DirMutate]> i64
) -[DirInspect, DirMutate]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_standalone_package_mutation_inspect(
  body: () -[DirInspect, DirMutate, Dir]> i64
) -[DirMutate, Dir]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  }
}

-- Package acquisition adds narrowly scoped tree mutation to the read/write/
-- inspect boundary above. The handler remains target-semantic and never grants
-- raw descriptor, pointer or ambient shell authority to the package code.
pub(package) fn runtime_standalone_package_mutation_io(
  body: () -[FileRead, FileWrite, DirInspect, DirMutate]> i64
) -> i64 {
  runtime_platform_dir(() =>
    runtime_standalone_package_dir_mutate(() =>
      runtime_standalone_package_mutation_inspect(() =>
        runtime_standalone_package_mutation_file_write(() =>
          runtime_standalone_package_mutation_file_read(body)))))
}

fn runtime_standalone_package_mutation_file_read_with<E>(
  body: () -[FileRead, FileWrite, DirInspect, DirMutate, E]> i64
) -[FileWrite, DirInspect, DirMutate, E]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

fn runtime_standalone_package_mutation_file_write_with<E>(
  body: () -[FileWrite, DirInspect, DirMutate, E]> i64
) -[DirInspect, DirMutate, E]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_standalone_package_mutation_inspect_with<E>(
  body: () -[DirInspect, DirMutate, Dir, E]> i64
) -[DirMutate, Dir, E]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  }
}

fn runtime_standalone_package_dir_mutate_with<E>(
  body: () -[DirMutate, Dir, E]> i64
) -[Dir, E]> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(Dir.mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(Dir.remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(Dir.rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

pub(package) fn runtime_standalone_package_mutation_io_with<E>(
  body: () -[FileRead, FileWrite, DirInspect, DirMutate, E]> i64
) -[E]> i64 {
  runtime_platform_dir_with<E>(() =>
    runtime_standalone_package_dir_mutate_with<E>(() =>
      runtime_standalone_package_mutation_inspect_with<E>(() =>
        runtime_standalone_package_mutation_file_write_with<E>(() =>
          runtime_standalone_package_mutation_file_read_with<E>(body)))))
}
