-- runtime/safe_io_standalone.weft — direct-syscall safe I/O for static tools
--
-- The self-hosted compiler must remain an executable rather than selecting the
-- libSystem/GOT object path. It shares the backend-neutral write engine with
-- runtime/safe_io and installs only the existing standalone Dir backend.

use runtime/dir_standalone.{runtime_standalone_dir}
use runtime/safe_file_core.{runtime_safe_file_write_result}
use stdlib/dir.{Dir}
use stdlib/file.{FileWrite}

pub(package) fn runtime_standalone_file_write(body: () -[FileWrite]> i64) -> i64 {
  runtime_standalone_dir(() => handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  })
}

-- Package traversal is still on the legacy combined Dir capability. This
-- exact seam avoids putting Dir in a generic residual tail where the same atom
-- would be both preserved and discharged.
pub(package) fn runtime_standalone_file_write_legacy_dir(body: () -[FileWrite, Dir]> i64) -> i64 {
  runtime_standalone_dir(() => handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  })
}
