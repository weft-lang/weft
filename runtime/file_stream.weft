-- runtime/file_stream.weft — production streaming-file interpretation
--
-- The handler installs direct descriptor I/O plus semantic file opens, seeks,
-- flush and close. Target syscall numbers, open flags and seek constants remain
-- sealed behind runtime/syscall and the native emitter.

use runtime/descriptor_io.{
  DescriptorAppend,
  DescriptorCreateOrTruncate,
  DescriptorOpenRead,
  DescriptorReadWriteTruncate,
  DescriptorSeekCurrent,
  DescriptorSeekEnd,
  DescriptorSeekStart,
  descriptor_close,
  descriptor_flush,
  descriptor_open,
  descriptor_read_into,
  descriptor_seek,
  descriptor_write_from
}
use stdlib/io.{IO}

--- Interpret owned streaming-file operations through the target platform.
pub implements IO() {
  IO.read_into(fd, buffer) -> resume(descriptor_read_into(fd, buffer))
  IO.write_from(fd, buffer) -> resume(descriptor_write_from(fd, buffer))
  IO.open_read(path) -> resume(descriptor_open(path, DescriptorOpenRead))
  IO.open_write(path) -> resume(descriptor_open(path, DescriptorCreateOrTruncate))
  IO.open_read_write(path) -> resume(descriptor_open(path, DescriptorReadWriteTruncate))
  IO.open_append(path) -> resume(descriptor_open(path, DescriptorAppend))
  IO.close(fd) -> resume(descriptor_close(fd))
  IO.seek_start(fd, offset) -> resume(descriptor_seek(fd, offset, DescriptorSeekStart))
  IO.seek_current(fd, offset) -> resume(descriptor_seek(fd, offset, DescriptorSeekCurrent))
  IO.seek_end(fd, offset) -> resume(descriptor_seek(fd, offset, DescriptorSeekEnd))
  IO.flush(fd) -> resume(descriptor_flush(fd))
}
