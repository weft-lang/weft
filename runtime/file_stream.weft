-- runtime/file_stream.weft — production streaming-file interpretation
--
-- The handler installs direct descriptor I/O plus semantic file opens, seeks,
-- flush and close. Target syscall numbers, open flags and seek constants remain
-- sealed behind runtime/syscall and the native emitter.

use stdlib/io.{IO, io_mode_user_rw, raw_close, raw_flush, raw_open_read, raw_open_read_write_create_truncate, raw_open_write_append, raw_open_write_create_truncate, raw_read, raw_seek_current, raw_seek_end, raw_seek_start, raw_write}

--- Interpret owned streaming-file operations through the target platform.
pub implements IO() {
  IO.read(fd, buffer, len) -> resume(raw_read(fd, buffer, len))
  IO.write(fd, buffer, len) -> resume(raw_write(fd, buffer, len))
  IO.open_read(path) -> resume(raw_open_read(path))
  IO.open_write(path) -> resume(raw_open_write_create_truncate(path, io_mode_user_rw()))
  IO.open_read_write(path) -> resume(raw_open_read_write_create_truncate(path, io_mode_user_rw()))
  IO.open_append(path) -> resume(raw_open_write_append(path, io_mode_user_rw()))
  IO.close(fd) -> resume(raw_close(fd))
  IO.seek_start(fd, offset) -> resume(raw_seek_start(fd, offset))
  IO.seek_current(fd, offset) -> resume(raw_seek_current(fd, offset))
  IO.seek_end(fd, offset) -> resume(raw_seek_end(fd, offset))
  IO.flush(fd) -> resume(raw_flush(fd))
}
