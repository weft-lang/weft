-- Trusted integration fixture proving that opaque values use the existing
-- sealed typed-transmute boundary without exposing representation authority.

use runtime/unsafe.{*}

type TrustedOpaqueValue = opaque i64

fn opaque_value_from_raw(value: i64) -> TrustedOpaqueValue {
  handle unsafe_transmute<i64, TrustedOpaqueValue>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn opaque_value_to_raw(value: TrustedOpaqueValue) -> i64 {
  handle unsafe_transmute<TrustedOpaqueValue, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn opaque_value_transmute_roundtrip(value: i64) -> i64 {
  opaque_value_to_raw(opaque_value_from_raw(value))
}
