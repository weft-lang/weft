-- runtime/test_fixtures.weft -- trusted Test effect fixtures for generated harnesses
--
-- Generated test harnesses delegate fixture interpretations here, so a change
-- to an interpreted effect's operations is ordinary checked source rather
-- than harness text emitted by the installed compiler.

use stdlib/io.{IO}

--- Interpret descriptor I/O deterministically for `Test.with_io_i64`. Opens
--- return fixed descriptors, a read supplies one byte `A`, a write reports its
--- full length, and seeks report their requested offset.
pub(package) fn test_fixture_with_io_i64(body: () -[IO]> i64) -> i64 {
  handle body() {
    IO.read_into(fd, buffer) -> if buffer.len > 0 {
      buffer[0] = __i64_to_u8(65)
      resume(1)
    } else { resume(0) }
    IO.write_from(fd, buffer) -> resume(__u64_to_i64(__usize_to_u64(buffer.len)))
    IO.open_read(path) -> resume(100)
    IO.open_write(path) -> resume(101)
    IO.open_read_write(path) -> resume(102)
    IO.open_append(path) -> resume(103)
    IO.close(fd) -> resume(0)
    IO.seek_start(fd, offset) -> resume(offset)
    IO.seek_current(fd, offset) -> resume(offset)
    IO.seek_end(fd, offset) -> resume(offset)
    IO.flush(fd) -> resume(0)
  }
}
