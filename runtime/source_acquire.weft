-- runtime/source_acquire.weft — compiler source acquisition boundary
--
-- Module parsing requests bytes through this internal effect. The production
-- handler is the only place that turns a source path into an open/read/close
-- sequence; overlay and project-session handlers can interpret the same
-- request without filesystem authority.

use runtime/alloc.{alloc_words, alloc_zeroed}
use runtime/buffer.{bscopy, buf_len, buf_new, buf_take_data}
use runtime/memory.{mem_copy, mem_load64_at, mem_store8_at, mem_store64_at}
use runtime/syscall.{sys_close, sys_open_read, sys_read}

pub(package) effect SourceAcquire {
  fn load(
    physical_path: i64,
    physical_len: i64,
    logical_path: i64,
    logical_len: i64,
    package_id: i64
  ) -> i64
}

fn source_acquire_read_fd_all(fd: i64) -> i64 {
  let chunk_size = 65536
  let scratch = alloc_words(chunk_size / 8)
  let out = buf_new(chunk_size)
  let mut done = 0
  while done == 0 {
    let n = sys_read(fd, scratch, chunk_size)
    if n > 0 {
      bscopy(out, scratch, n, 0)
    } else {
      done = 1
    }
  }
  let result = alloc_words(2)
  let len = buf_len(out)
  mem_store64_at(result, 0, buf_take_data(out))
  mem_store64_at(result, 8, len)
  result
}

fn source_acquire_load_file(path: i64, path_len: i64) -> i64 {
  let path_buf = alloc_zeroed(path_len + 1)
  mem_copy(path_buf, path, path_len)
  mem_store8_at(path_buf, path_len, 0)
  let fd = sys_open_read(path_buf)
  let result = alloc_words(2)
  if fd < 0 {
    mem_store64_at(result, 0, 0)
    mem_store64_at(result, 8, 0)
  } else {
    let file = source_acquire_read_fd_all(fd)
    sys_close(fd)
    mem_store64_at(result, 0, mem_load64_at(file, 0))
    mem_store64_at(result, 8, mem_load64_at(file, 8))
  }
  result
}

pub(package) fn source_acquire_with_standalone<T, E>(
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  handle body() {
    SourceAcquire.load(physical_path, physical_len, logical_path, logical_len, package_id) ->
      resume(source_acquire_load_file(physical_path, physical_len))
  }
}
