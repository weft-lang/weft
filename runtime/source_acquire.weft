-- runtime/source_acquire.weft — compiler source acquisition boundary
--
-- Module parsing requests bytes through this internal effect. The production
-- handler is the only place that turns a source path into an open/read/close
-- sequence; overlay and project-session handlers can interpret the same
-- request without filesystem authority.

use runtime/alloc.{alloc_words, alloc_zeroed}
use runtime/buffer.{bscopy, bu8, buf_len, buf_new, buf_take_data}
use runtime/memory.{mem_copy, mem_load8_at, mem_load64_at, mem_store8_at, mem_store64_at}
use runtime/sdk_archive.{EmbeddedSdkArchive, EmbeddedSdkArchiveAbsent, EmbeddedSdkArchivePresent, SdkArchiveFound, SdkArchiveLookup, SdkArchiveMalformed, SdkArchiveMissing, sdk_archive_digest, sdk_archive_embedded, sdk_archive_lookup}
use runtime/syscall.{sys_close, sys_open_read, sys_read}

pub(package) type SdkOrigin {
  EmbeddedSdk(str),
  CheckoutSdk(str),
  NoSdk
}

pub(package) effect SourceAcquire {
  -- Typed semantic origin selected for canonical SDK modules and assets.
  fn sdk_origin() -> SdkOrigin
  fn load_sdk(path: i64, path_len: i64) -> i64
  -- An installed compiler publishes the root of the SDK selected beside its
  -- executable. Checkout/test handlers return the empty string. Package
  -- resolution consumes this as semantic identity; source loading consumes
  -- the same root below, so authority and bytes cannot silently diverge.
  fn sdk_root() -> str
  fn load(
    physical_path: i64,
    physical_len: i64,
    logical_path: i64,
    logical_len: i64,
    package_id: i64
  ) -> i64
}

fn source_acquire_read_fd_all(fd: i64) -> i64 {
  let chunk_size = 65536
  let scratch = alloc_words(chunk_size / 8)
  let out = buf_new(chunk_size)
  let mut done = 0
  while done == 0 {
    let n = sys_read(fd, scratch, chunk_size)
    if n > 0 {
      bscopy(out, scratch, n, 0)
    } else {
      done = 1
    }
  }
  let result = alloc_words(2)
  let len = buf_len(out)
  mem_store64_at(result, 0, buf_take_data(out))
  mem_store64_at(result, 8, len)
  result
}

fn source_acquire_load_file(path: i64, path_len: i64) -> i64 {
  let path_buf = alloc_zeroed(path_len + 1)
  mem_copy(path_buf, path, path_len)
  mem_store8_at(path_buf, path_len, 0)
  let fd = sys_open_read(path_buf)
  let result = alloc_words(2)
  if fd < 0 {
    mem_store64_at(result, 0, 0)
    mem_store64_at(result, 8, 0)
  } else {
    let file = source_acquire_read_fd_all(fd)
    sys_close(fd)
    mem_store64_at(result, 0, mem_load64_at(file, 0))
    mem_store64_at(result, 8, mem_load64_at(file, 8))
  }
  result
}

pub(package) fn source_acquire_with_standalone<T, E>(
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  handle body() {
    SourceAcquire.sdk_origin() -> resume(NoSdk)
    SourceAcquire.load_sdk(path, path_len) -> resume(source_acquire_load_file(path, path_len))
    SourceAcquire.sdk_root() -> resume("")
    SourceAcquire.load(physical_path, physical_len, logical_path, logical_len, package_id) ->
      resume(source_acquire_load_file(physical_path, physical_len))
  }
}

fn source_acquire_is_sdk_path(path: i64, path_len: i64) -> bool {
  source_acquire_starts_with_segment(path, path_len, "stdlib") or
    source_acquire_starts_with_segment(path, path_len, "runtime") or
    source_acquire_starts_with_segment(path, path_len, "compiler")
}

fn source_acquire_starts_with_segment(path: i64, path_len: i64, segment: str) -> bool {
  let segment_len = __str_len(segment)
  if path_len <= segment_len or mem_load8_at(path, segment_len) != 47 { false }
  else {
    let mut index = 0
    let mut matches = true
    while index < segment_len and matches {
      if mem_load8_at(path, index) != mem_load8_at(__str_ptr(segment), index) { matches = false }
      else { index = index + 1 }
    }
    matches
  }
}

fn source_acquire_sdk_physical_path(sdk_root: str, path: i64, path_len: i64) -> i64 {
  let root_len = __str_len(sdk_root)
  let joined = buf_new(root_len + path_len + 2)
  bscopy(joined, __str_ptr(sdk_root), root_len, 0)
  if root_len > 0 and mem_load8_at(__str_ptr(sdk_root), root_len - 1) != 47 {
    bu8(joined, 47)
  } else { 0 }
  bscopy(joined, path, path_len, 0)
  let result = alloc_words(2)
  let len = buf_len(joined)
  mem_store64_at(result, 0, buf_take_data(joined))
  mem_store64_at(result, 8, len)
  result
}

-- Installed compilers select one relocatable SDK root at process startup.
-- Only canonical stdlib/runtime/compiler imports are redirected; package and root
-- paths retain their project-relative physical identity.
pub(package) fn source_acquire_with_sdk<T, E>(
  sdk_root: str,
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  handle body() {
    SourceAcquire.sdk_origin() -> resume(CheckoutSdk(sdk_root))
    SourceAcquire.load_sdk(path, path_len) -> {
      let installed = source_acquire_sdk_physical_path(sdk_root, path, path_len)
      resume(source_acquire_load_file(mem_load64_at(installed, 0), mem_load64_at(installed, 8)))
    }
    SourceAcquire.sdk_root() -> resume(sdk_root)
    SourceAcquire.load(physical_path, physical_len, logical_path, logical_len, package_id) -> {
      if source_acquire_is_sdk_path(physical_path, physical_len) {
        let installed = source_acquire_sdk_physical_path(sdk_root, physical_path, physical_len)
        resume(source_acquire_load_file(mem_load64_at(installed, 0), mem_load64_at(installed, 8)))
      } else {
        resume(source_acquire_load_file(physical_path, physical_len))
      }
    }
  }
}

fn source_acquire_archive_result(archive: i64, archive_len: i64, path: i64, path_len: i64) -> i64 {
  let result = alloc_words(2)
  match sdk_archive_lookup(archive, archive_len, path, path_len) {
    SdkArchiveFound(data, len) -> {
      mem_store64_at(result, 0, data)
      mem_store64_at(result, 8, len)
    }
    SdkArchiveMissing -> {
      mem_store64_at(result, 0, 0)
      mem_store64_at(result, 8, 0)
    }
    SdkArchiveMalformed -> {
      mem_store64_at(result, 0, 0)
      mem_store64_at(result, 8, 0)
    }
  }
  result
}

pub(package) fn source_acquire_with_archive<T, E>(
  archive: i64,
  archive_len: i64,
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  let digest = sdk_archive_digest(archive, archive_len)
  handle body() {
    SourceAcquire.sdk_origin() -> resume(if __str_len(digest) == 0 { NoSdk } else { EmbeddedSdk(digest) })
    SourceAcquire.load_sdk(path, path_len) -> resume(source_acquire_archive_result(archive, archive_len, path, path_len))
    SourceAcquire.sdk_root() -> resume("")
    SourceAcquire.load(physical_path, physical_len, logical_path, logical_len, package_id) -> {
      if source_acquire_is_sdk_path(physical_path, physical_len) {
        resume(source_acquire_archive_result(archive, archive_len, physical_path, physical_len))
      } else {
        resume(source_acquire_load_file(physical_path, physical_len))
      }
    }
  }
}

pub(package) fn source_acquire_with_embedded<T, E>(
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  match sdk_archive_embedded() {
    EmbeddedSdkArchivePresent(archive, archive_len, digest) -> source_acquire_with_archive<T, E>(archive, archive_len, body)
    EmbeddedSdkArchiveAbsent -> source_acquire_with_standalone<T, E>(body)
  }
}
