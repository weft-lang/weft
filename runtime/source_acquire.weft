-- runtime/source_acquire.weft — compiler source acquisition boundary
--
-- Module parsing requests bytes through this internal effect. The production
-- handler is the only place that turns a source path into an open/read/close
-- sequence; overlay and project-session handlers can interpret the same
-- request without filesystem authority.

use runtime/alloc.{alloc_words}
use runtime/buffer.{bscopy, buf_len, buf_new, buf_ptr}
use runtime/sdk_archive.{
  EmbeddedSdkArchiveAbsent,
  EmbeddedSdkArchivePresent,
  EmbeddedSdkArchiveRejected,
  SdkArchive,
  SdkArchiveError,
  SdkArchiveFound,
  SdkArchiveInvalidPath,
  SdkArchiveMissing,
  sdk_archive_digest,
  sdk_archive_embedded,
  sdk_archive_lookup,
  sdk_archive_path_is_canonical
}
use runtime/string.{runtime_str_concat, runtime_str_cstring, runtime_str_from_bytes}
use runtime/syscall.{sys_close, sys_open_read, sys_read}
use stdlib/bytes.{Bytes, bytes_from_storage}
use stdlib/result.{Err, Ok, Result}

pub(package) type SdkOrigin {
  EmbeddedSdk(str),
  CheckoutSdk(str),
  NoSdk
}

--- An SDK file's exact bytes, or why the selected SDK cannot supply it.
pub(package) type SdkSource {
  SdkSourceFound(Bytes),
  SdkSourceMissing,
  SdkSourceInvalidPath
}

pub(package) effect SourceAcquire {
  -- Typed semantic origin selected for canonical SDK modules and assets.
  fn sdk_origin() -> SdkOrigin
  --- The bytes of a canonical SDK path such as `stdlib/io.weft`.
  fn load_sdk(path: str) -> SdkSource
  --- The bytes of the file a resolved request names, or `nil` when it cannot
  --- be opened. An empty file is present, with no bytes.
  fn load(physical_path: str, logical_path: str, package_id: i64) -> Bytes?
}

fn source_acquire_read_fd(fd: i64) -> Bytes {
  let chunk_size = 65536
  let scratch = alloc_words(chunk_size / 8)
  let out = buf_new(chunk_size)
  let mut done = 0
  while done == 0 {
    let n = sys_read(fd, scratch, chunk_size)
    if n > 0 { bscopy(out, scratch, n, 0) } else { done = 1 }
  }
  -- The read buffer is released with `out`; the bytes keep their own copy.
  bytes_from_storage(runtime_str_from_bytes(buf_ptr(out), buf_len(out)))
}

fn source_acquire_load_file(path: str) -> Bytes? {
  let fd = sys_open_read(runtime_str_cstring(path))
  if fd < 0 { nil }
  else {
    let bytes = source_acquire_read_fd(fd)
    sys_close(fd)
    bytes
  }
}

fn source_acquire_path_is_canonical(path: str) -> bool {
  sdk_archive_path_is_canonical(__str_ptr(path), __str_len(path))
}

fn source_acquire_sdk_file(path: str) -> SdkSource {
  match source_acquire_load_file(path) {
    nil -> SdkSourceMissing
    bytes: Bytes -> SdkSourceFound(bytes)
  }
}

pub(package) fn source_acquire_with_standalone<T, E>(
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  handle body() {
    SourceAcquire.sdk_origin() -> resume(NoSdk)
    SourceAcquire.load_sdk(path) -> resume(
      if source_acquire_path_is_canonical(path) { source_acquire_sdk_file(path) }
      else { SdkSourceInvalidPath }
    )
    SourceAcquire.load(physical_path, logical_path, package_id) -> resume(
      source_acquire_load_file(physical_path)
    )
  }
}

fn source_acquire_sdk_physical_path(sdk_root: str, path: str) -> str {
  let root_len = __str_len(sdk_root)
  if root_len > 0 and __mem_load8(__str_ptr(sdk_root) + root_len - 1) != 47 {
    runtime_str_concat(runtime_str_concat(sdk_root, "/"), path)
  } else { runtime_str_concat(sdk_root, path) }
}

-- Checkout compilers select one package root at process startup. Only
-- explicit SDK requests are redirected; package and project paths retain
-- their project-relative physical identity regardless of directory spelling.
pub(package) fn source_acquire_with_checkout<T, E>(
  sdk_root: str,
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  handle body() {
    SourceAcquire.sdk_origin() -> resume(CheckoutSdk(sdk_root))
    SourceAcquire.load_sdk(path) -> resume(
      if source_acquire_path_is_canonical(path) {
        source_acquire_sdk_file(source_acquire_sdk_physical_path(sdk_root, path))
      } else { SdkSourceInvalidPath }
    )
    SourceAcquire.load(physical_path, logical_path, package_id) -> resume(
      source_acquire_load_file(physical_path)
    )
  }
}

fn source_acquire_archive_result(archive: SdkArchive, path: str) -> SdkSource {
  match sdk_archive_lookup(archive, __str_ptr(path), __str_len(path)) {
    SdkArchiveFound(data, len) -> SdkSourceFound(
      bytes_from_storage(runtime_str_from_bytes(data, len))
    )
    SdkArchiveMissing -> SdkSourceMissing
    SdkArchiveInvalidPath -> SdkSourceInvalidPath
  }
}

pub(package) fn source_acquire_with_archive<T, E>(
  archive: SdkArchive,
  body: () -[SourceAcquire, E]> T
) -[E]> T {
  let digest = sdk_archive_digest(archive)
  handle body() {
    SourceAcquire.sdk_origin() -> resume(EmbeddedSdk(digest))
    SourceAcquire.load_sdk(path) -> resume(source_acquire_archive_result(archive, path))
    SourceAcquire.load(physical_path, logical_path, package_id) -> resume(
      source_acquire_load_file(physical_path)
    )
  }
}

pub(package) fn source_acquire_with_embedded<T, E>(
  body: () -[SourceAcquire, E]> T
) -[E]> Result<T, SdkArchiveError> {
  match sdk_archive_embedded() {
    EmbeddedSdkArchivePresent(archive) -> Ok<T, SdkArchiveError>(
      source_acquire_with_archive<T, E>(archive, body)
    )
    EmbeddedSdkArchiveAbsent -> Ok<T, SdkArchiveError>(source_acquire_with_standalone<T, E>(body))
    EmbeddedSdkArchiveRejected(error) -> Err<T, SdkArchiveError>(error)
  }
}
