-- runtime/iter_state.weft -- trusted mutable storage for stdlib iterators

use runtime/alloc.{*}
use runtime/rc.{*}

pub(package) fn runtime_iter_kind_generator() -> i64 { 1 }
pub(package) fn runtime_iter_kind_range_i64() -> i64 { 2 }
pub(package) fn runtime_iter_state_size() -> i64 { 40 }
pub(package) fn runtime_iter_state_kind_offset() -> i64 { 0 }
pub(package) fn runtime_iter_state_first_offset() -> i64 { 8 }
pub(package) fn runtime_iter_state_second_offset() -> i64 { 16 }
pub(package) fn runtime_iter_state_closed_offset() -> i64 { 24 }
pub(package) fn runtime_iter_state_dropper_offset() -> i64 { 32 }

pub(package) fn runtime_iter_state_new(kind: i64, first: any, second: any, dropper: any) -> i64 {
  -- Iterator state has one linear owner. Use the recyclable runtime heap as
  -- raw storage without imposing reference-count traffic on each pull.
  let state = heap_alloc(rc_default_heap(), runtime_iter_state_size(), 8)
  __mem_store64(state + runtime_iter_state_kind_offset(), kind)
  __mem_store64(state + runtime_iter_state_first_offset(), first)
  __mem_store64(state + runtime_iter_state_second_offset(), second)
  __mem_store64(state + runtime_iter_state_closed_offset(), 0)
  __mem_store64(state + runtime_iter_state_dropper_offset(), dropper)
  closure_default_retain(__mem_load64(state + runtime_iter_state_dropper_offset()))
  state
}

pub(package) fn runtime_iter_state_release(state: i64) -> i64 {
  if state == 0 { 0 }
  else { heap_free(rc_default_heap(), state, runtime_iter_state_size()) }
}

pub(package) fn runtime_iter_state_kind(state: i64) -> i64 {
  if state == 0 { 0 } else { __mem_load64(state + runtime_iter_state_kind_offset()) }
}

pub(package) fn runtime_iter_state_first(state: i64) -> i64 {
  __mem_load64(state + runtime_iter_state_first_offset())
}

pub(package) fn runtime_iter_state_second(state: i64) -> i64 {
  __mem_load64(state + runtime_iter_state_second_offset())
}

pub(package) fn runtime_iter_state_closed(state: i64) -> i64 {
  if state == 0 { 1 } else { __mem_load64(state + runtime_iter_state_closed_offset()) }
}

pub(package) fn runtime_iter_state_set_first(state: i64, value: i64) -> i64 {
  __mem_store64(state + runtime_iter_state_first_offset(), value)
  0
}

pub(package) fn runtime_iter_state_set_closed(state: i64, value: i64) -> i64 {
  __mem_store64(state + runtime_iter_state_closed_offset(), value)
  0
}

pub(package) fn runtime_iter_state_release_dropper(state: i64) -> i64 {
  if state == 0 { 0 }
  else { closure_default_release(__mem_load64(state + runtime_iter_state_dropper_offset())) }
}

pub(package) fn runtime_iter_state_run_dropper(state: i64) -> nil {
  if state == 0 { nil }
  else {
    let dropper = runtime_generator_state_word_as<() -> nil>(__mem_load64(state + runtime_iter_state_dropper_offset()))
    dropper()
  }
}

-- Borrowed read of the raw generator state owned by this iterator.
-- Non-generator states return zero.
pub(package) fn runtime_iter_state_generator_word(state: i64) -> i64 {
  if state == 0 { 0 }
  else {
    if __mem_load64(state + runtime_iter_state_kind_offset()) == runtime_iter_kind_generator() {
      __mem_load64(state + runtime_iter_state_first_offset())
    } else { 0 }
  }
}

-- Close the raw generator state owned by this iterator. Zero-guards make
-- repeated iterator close paths effective no-ops.
pub(package) fn runtime_iter_state_release_generator(state: i64) -> i64 {
  if state == 0 { 0 }
  else {
    if __mem_load64(state + runtime_iter_state_kind_offset()) == runtime_iter_kind_generator() {
      let word = __mem_load64(state + runtime_iter_state_first_offset())
      if word == 0 { 0 }
      else {
        __mem_store64(state + runtime_iter_state_first_offset(), 0)
        runtime_generator_state_drop(word)
      }
    } else { 0 }
  }
}
