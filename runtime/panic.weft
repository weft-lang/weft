-- runtime/panic.weft -- trusted process-abort boundary

use "runtime/syscall.weft"

fn runtime_panic_exit_code() -> i64 { 101 }

fn runtime_panic(msg: str) -> never {
  let prefix = "weft: panic: "
  let newline = "\n"
  sys_write(2, __str_ptr(prefix), __str_len(prefix))
  sys_write(2, __str_ptr(msg), __str_len(msg))
  sys_write(2, __str_ptr(newline), __str_len(newline))
  sys_exit(runtime_panic_exit_code())
}
