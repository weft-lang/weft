-- runtime/panic.weft -- trusted process-abort boundary

use runtime/unsafe.{Unsafe}
use runtime/syscall.{*}
use runtime/provenance.{*}

pub(package) fn runtime_panic_exit_code() -> i64 { 101 }

-- Fatal reporting must not allocate: the allocator itself can panic, and an
-- exhausted/corrupt heap must not erase the original failure. All rendering
-- below writes static bytes or one digit at a time.
pub(package) fn runtime_panic_write(ptr: i64, len: i64) -> i64 {
  sys_write(2, ptr, len)
}

pub(package) fn runtime_panic_write_uint(value: i64) -> i64 {
  let digits = "0123456789"
  if value >= 10 { runtime_panic_write_uint(value / 10) } else { 0 }
  runtime_panic_write(__str_ptr(digits) + value % 10, 1)
}

pub(package) fn runtime_panic_write_u64(value: u64) -> i64 {
  let digits = "0123456789"
  if value >= 10 { runtime_panic_write_u64(value / 10) } else { 0 }
  runtime_panic_write(__str_ptr(digits) + __u64_to_i64(value % 10), 1)
}

pub(package) fn runtime_panic_write_entry(index: i64, entry: i64) -> i64 {
  runtime_panic_write(__str_ptr("  "), 2)
  runtime_panic_write_uint(index)
  runtime_panic_write(__str_ptr(": "), 2)
  if entry == 0 {
    runtime_panic_write(__str_ptr("<unknown>\n"), __str_len("<unknown>\n"))
  } else {
    let name_ptr = runtime_native_provenance_entry_name_ptr(entry)
    let name_len = runtime_native_provenance_entry_name_len(entry)
    if name_ptr != 0 and name_len > 0 {
      runtime_panic_write(name_ptr, name_len)
    } else {
      runtime_panic_write(__str_ptr("h"), 1)
      -- Function identities use the full 64-bit hash domain. Render the raw
      -- bits as unsigned decimal so the fatal path also handles i64::MIN.
      runtime_panic_write_u64(__i64_to_u64(runtime_native_provenance_entry_hash(entry)))
    }
    let path_ptr = runtime_native_provenance_entry_path_ptr(entry)
    let path_len = runtime_native_provenance_entry_path_len(entry)
    if path_ptr != 0 and path_len > 0 {
      runtime_panic_write(__str_ptr(" at "), 4)
      runtime_panic_write(path_ptr, path_len)
      runtime_panic_write(__str_ptr(":"), 1)
      runtime_panic_write_uint(runtime_native_provenance_entry_line(entry))
      runtime_panic_write(__str_ptr(":"), 1)
      runtime_panic_write_uint(runtime_native_provenance_entry_col(entry))
    } else { 0 }
    runtime_panic_write(__str_ptr("\n"), 1)
  }
}

pub(package) fn runtime_panic_write_trace_marker(marker: str) -> i64 {
  runtime_panic_write(__str_ptr("     <"), __str_len("     <"))
  runtime_panic_write(__str_ptr(marker), __str_len(marker))
  runtime_panic_write(__str_ptr(">\n"), 2)
}

pub(package) fn runtime_panic_write_trace_from(first_frame: i64, first_entry: i64) -> i64 {
  runtime_panic_write(__str_ptr("stack backtrace:\n"), __str_len("stack backtrace:\n"))
  let mut depth = 0
  if first_entry != 0 {
    runtime_panic_write_entry(depth, first_entry)
    depth = depth + 1
  } else { 0 }
  if first_frame <= 0 or first_frame % 16 != 0 {
    runtime_panic_write_trace_marker("frame chain unavailable")
  } else {
    let mut frame = first_frame
    let mut done = 0
    while done == 0 and depth < 64 {
      let caller_lr = __mem_load64(frame + 8)
      if caller_lr <= 4 {
        done = 1
      } else {
        -- AArch64 LR points one instruction after BL. Attribute the call site
        -- to the caller by looking up LR-4 inside its final native range.
        let entry = runtime_native_provenance_lookup_pc(caller_lr - 4)
        if entry == 0 {
          -- A normal program eventually crosses the emitted-image boundary
          -- above main. Stop there without inventing an "unknown" frame; if
          -- even the first caller is unknown, say the chain is unavailable.
          if depth == 0 { runtime_panic_write_trace_marker("frame chain unavailable") } else { 0 }
          done = 1
        } else {
          runtime_panic_write_entry(depth, entry)
          depth = depth + 1
          if runtime_native_provenance_entry_is_framed(entry) == 0 {
            -- x29 skips a naked function, so continuing would fabricate a
            -- caller relationship. Name the leaf we know, then stop honestly.
            runtime_panic_write_trace_marker("naked frame gap")
            done = 1
          } else {
            let next = __mem_load64(frame)
            if next <= frame or next % 16 != 0 or next - frame > 67108864 {
              done = 1
            } else { frame = next }
          }
        }
      }
    }
    if done == 0 { runtime_panic_write_trace_marker("trace truncated") } else { 0 }
  }
}

pub(package) fn runtime_panic_write_trace(first_frame: i64) -> i64 {
  runtime_panic_write_trace_from(first_frame, 0)
}

--- Record the return addresses of the frame chain above `first_frame` into
--- the words at `out`, at most `limit` of them, and return how many were
--- recorded. Capture does no symbol lookup, so debugging modes can record an
--- event's calling chain cheaply and name it only if a report needs it.
pub(package) fn runtime_capture_trace(first_frame: i64, out: i64, limit: i64) -> i64 {
  if first_frame <= 0 or first_frame % 16 != 0 { 0 }
  else {
    let mut frame = first_frame
    let mut count = 0
    let mut done = 0
    while done == 0 and count < limit {
      let caller_lr = __mem_load64(frame + 8)
      if caller_lr <= 4 { done = 1 }
      else {
        __mem_store64(out + count * 8, caller_lr)
        count = count + 1
        let next = __mem_load64(frame)
        if next <= frame or next % 16 != 0 or next - frame > 67108864 { done = 1 } else {
          frame = next
        }
      }
    }
    count
  }
}

--- Name a chain recorded by runtime_capture_trace, with the same stopping
--- rules as a live backtrace. `limit` is the capture bound: a full capture
--- may have been cut short.
pub(package) fn runtime_panic_write_captured_trace(pcs: i64, count: i64, limit: i64) -> i64 {
  runtime_panic_write(__str_ptr("stack backtrace:\n"), __str_len("stack backtrace:\n"))
  let mut depth = 0
  let mut done = 0
  while done == 0 and depth < count {
    let entry = runtime_native_provenance_lookup_pc(__mem_load64(pcs + depth * 8) - 4)
    if entry == 0 {
      if depth == 0 { runtime_panic_write_trace_marker("frame chain unavailable") } else { 0 }
      done = 1
    } else {
      runtime_panic_write_entry(depth, entry)
      depth = depth + 1
      if runtime_native_provenance_entry_is_framed(entry) == 0 {
        runtime_panic_write_trace_marker("naked frame gap")
        done = 1
      } else { 0 }
    }
  }
  if count == 0 { runtime_panic_write_trace_marker("frame chain unavailable") }
  else {
    if done == 0 and count >= limit { runtime_panic_write_trace_marker("trace truncated") } else {
      0
    }
  }
}

pub(package) fn runtime_trap_exit_code() -> i64 { 102 }

-- Stable fatal-reason registry for compiler-emitted trap islands. Several
-- historic BRK immediates cover a narrow family of related invariants; the
-- text stays deliberately useful without claiming more precision than the
-- transported reason code contains.
pub(package) fn runtime_trap_reason(reason: i64) -> str {
  match reason {
    2 -> "unhandled effect or incomplete control flow"
    3 -> "unresolved runtime or function reference"
    5 -> "bump allocator could not grow"
    8 -> "missing function specialization"
    9 -> "missing method implementation"
    16 -> "unknown native intrinsic"
    18 -> "invalid handler or deferred function"
    19 -> "invalid stack slot or closure target"
    20 -> "invalid native value home"
    21 -> "invalid instruction encoding or unsupported lowering"
    22 -> "invalid control-flow lowering"
    23 -> "invalid generic specialization lowering"
    24 -> "missing handler abort landing"
    25 -> "invalid call result lane"
    26 -> "invalid return lane or abort cleanup chain"
    27 -> "missing abort cleanup function"
    28 -> "invalid array drop plan"
    29 -> "invalid array storage plan"
    30 -> "invalid array copy plan"
    31 -> "missing entry point or invalid record-array layout"
    32 -> "unmatched value or invalid record-array load"
    33 -> "invalid lambda or record-array store lowering"
    34 -> "invalid record-field layout or drop target"
    35 -> "invalid optional-projection layout"
    46 -> "invalid typed Par carrier operation"
    48 -> "managed object retained or released after it was freed"
    62 -> "native call argument window overflow"
    _ -> "internal compiler invariant"
  }
}

pub(package) fn runtime_trap_write_reason(reason: i64) -> i64 {
  let text = runtime_trap_reason(reason)
  runtime_panic_write(__str_ptr(text), __str_len(text))
}

pub(package) fn runtime_trap_write_heading(reason: i64) -> i64 {
  runtime_panic_write(__str_ptr("weft: trap: "), __str_len("weft: trap: "))
  runtime_trap_write_reason(reason)
  runtime_panic_write(__str_ptr(" (code "), __str_len(" (code "))
  runtime_panic_write_uint(reason)
  runtime_panic_write(__str_ptr(")\n"), 2)
}

pub(package) fn runtime_trap(reason: i64, site_offset: i64) -> never {
  -- Trap islands tail-branch here, preserving the trapping function's LR.
  -- Capture before rendering so the walker observes that transported chain.
  let frame = __frame_pointer()
  runtime_trap_write_heading(reason)
  let site_entry = runtime_native_provenance_lookup_offset(site_offset)
  runtime_panic_write_trace_from(frame, site_entry)
  sys_exit(runtime_trap_exit_code())
}

--- Stop with trap `reason`, then report the earlier event that caused it:
--- `LABEL #ORDINAL:` and the calling chain recorded when it happened.
pub(package) fn runtime_trap_with_history(
  reason: i64,
  label: str,
  ordinal: i64,
  pcs: i64,
  count: i64,
  limit: i64
) -> never {
  let frame = __frame_pointer()
  runtime_trap_write_heading(reason)
  runtime_panic_write_trace_from(frame, 0)
  runtime_panic_write(__str_ptr(label), __str_len(label))
  runtime_panic_write(__str_ptr(" #"), 2)
  runtime_panic_write_uint(ordinal)
  runtime_panic_write(__str_ptr(":\n"), 2)
  runtime_panic_write_captured_trace(pcs, count, limit)
  sys_exit(runtime_trap_exit_code())
}

pub(package) fn runtime_panic(msg: str) -> never {
  -- This must remain the first source action. Capturing through a helper would
  -- snapshot the helper's frame and make panic provenance optimizer-dependent.
  let frame = __frame_pointer()
  let prefix = "weft: panic: "
  let newline = "\n"
  sys_write(2, __str_ptr(prefix), __str_len(prefix))
  sys_write(2, __str_ptr(msg), __str_len(msg))
  sys_write(2, __str_ptr(newline), __str_len(newline))
  runtime_panic_write_trace(frame)
  sys_exit(runtime_panic_exit_code())
}

-- Canonical checked-index boundary. The compiler passes the indexed-storage
-- facts explicitly: no runtime type/layout discovery sits on the hot path.
-- `usize` comparison is unsigned all the way through typed integer IR.
--
-- The Unsafe proof-mode wrappers are a sealed internal ABI between typed-IR
-- optimisation and native emission. Keep the checked implementation under a
-- name the optimiser never rewrites: otherwise optimising a wrapper body could
-- turn it into a recursive call to itself.
pub(package) fn runtime_index_address_checked(
  data: i64,
  len: usize,
  index: usize,
  stride: usize
) -> i64 {
  if index < len {
    data + __u64_to_i64(__usize_to_u64(index * stride))
  } else {
    runtime_panic("index out of bounds")
  }
}

pub(package) fn runtime_index_address(data: i64, len: usize, index: usize, stride: usize) -> i64 {
  runtime_index_address_checked(data, len, index, stride)
}

pub(package) fn runtime_index_address_lower_proven(
  data: i64,
  len: usize,
  index: usize,
  stride: usize
) -[Unsafe]> i64 {
  runtime_index_address_checked(data, len, index, stride)
}

pub(package) fn runtime_index_address_upper_proven(
  data: i64,
  len: usize,
  index: usize,
  stride: usize
) -[Unsafe]> i64 {
  runtime_index_address_checked(data, len, index, stride)
}

pub(package) fn runtime_index_address_full_proven(
  data: i64,
  len: usize,
  index: usize,
  stride: usize
) -[Unsafe]> i64 {
  data + __u64_to_i64(__usize_to_u64(index * stride))
}

-- Canonical half-open slice boundary. The owner word is deliberately carried
-- through this ABI even though runtime address formation does not inspect it:
-- the compiler's borrow-fact producer consumes it as the provenance edge.
pub(package) fn runtime_slice_address_checked(
  _ owner: i64,
  data: i64,
  len: usize,
  start: usize,
  end: usize,
  stride: usize
) -> i64 {
  if start <= end and end <= len {
    data + __u64_to_i64(__usize_to_u64(start * stride))
  } else {
    runtime_panic("index out of bounds")
  }
}

pub(package) fn runtime_slice_address(
  owner: i64,
  data: i64,
  len: usize,
  start: usize,
  end: usize,
  stride: usize
) -> i64 {
  runtime_slice_address_checked(owner, data, len, start, end, stride)
}

pub(package) fn runtime_mut_slice_address(
  owner: i64,
  data: i64,
  len: usize,
  start: usize,
  end: usize,
  stride: usize
) -> i64 {
  runtime_slice_address_checked(owner, data, len, start, end, stride)
}

pub(package) fn runtime_slice_address_order_proven(
  _ owner: i64,
  data: i64,
  len: usize,
  start: usize,
  end: usize,
  stride: usize
) -[Unsafe]> i64 {
  if end <= len { data + __u64_to_i64(__usize_to_u64(start * stride)) }
  else { runtime_panic("index out of bounds") }
}

pub(package) fn runtime_slice_address_upper_proven(
  _ owner: i64,
  data: i64,
  _ len: usize,
  start: usize,
  end: usize,
  stride: usize
) -[Unsafe]> i64 {
  if start <= end { data + __u64_to_i64(__usize_to_u64(start * stride)) }
  else { runtime_panic("index out of bounds") }
}

pub(package) fn runtime_slice_address_full_proven(
  _ owner: i64,
  data: i64,
  _ len: usize,
  start: usize,
  _ end: usize,
  stride: usize
) -[Unsafe]> i64 {
  data + __u64_to_i64(__usize_to_u64(start * stride))
}

pub(package) fn runtime_mut_slice_address_order_proven(
  _ owner: i64,
  data: i64,
  len: usize,
  start: usize,
  end: usize,
  stride: usize
) -[Unsafe]> i64 {
  if end <= len { data + __u64_to_i64(__usize_to_u64(start * stride)) }
  else { runtime_panic("index out of bounds") }
}

pub(package) fn runtime_mut_slice_address_upper_proven(
  _ owner: i64,
  data: i64,
  _ len: usize,
  start: usize,
  end: usize,
  stride: usize
) -[Unsafe]> i64 {
  if start <= end { data + __u64_to_i64(__usize_to_u64(start * stride)) }
  else { runtime_panic("index out of bounds") }
}

pub(package) fn runtime_mut_slice_address_full_proven(
  _ owner: i64,
  data: i64,
  _ len: usize,
  start: usize,
  _ end: usize,
  stride: usize
) -[Unsafe]> i64 {
  data + __u64_to_i64(__usize_to_u64(start * stride))
}
