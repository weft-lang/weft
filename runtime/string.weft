-- runtime/string.weft -- trusted string storage and C ABI helpers

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/rc.{*}
use runtime/unsafe.{*}

pub(package) fn runtime_str_word_as_str(value: i64) -> str {
  handle unsafe_transmute<i64, str>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Dynamic strings keep their descriptor and bytes in one default-
-- managed payload. The public str word points at the payload's
-- descriptor, exactly like a literal points at its bump-immortal
-- descriptor, so __str_ptr/__str_len keep one ABI for both forms.
pub(package) fn runtime_str_alloc_uninit(capacity: i64) -> str {
  let len = if capacity < 0 { 0 } else { capacity }
  -- The trusted builder owns this allocation immediately as a str;
  -- keep the raw descriptor word only long enough to initialise it.
  -- Zero-length results still allocate the descriptor here: returning
  -- a source literal would manufacture immortal bump data per call.
  let desc: i64 = rc_default_alloc(16 + len, 8)
  let data = desc + 16
  __mem_store64(desc, data)
  __mem_store64(desc + 8, len)
  runtime_str_word_as_str(desc)
}

pub(package) fn runtime_str_set_len(s: str, len: i64) -> i64 {
  __mem_store64(__str_ptr(s) - 8, len)
}

-- Trusted construction primitives for stdlib string algorithms. Bounds are
-- checked here so ordinary string APIs never expose a writable raw pointer.
pub(package) fn runtime_str_builder_set_byte(out_ptr: i64, out_len: i64, index: i64, byte: i64) -> i64 {
  if index < 0 or index >= out_len { 0 }
  else {
    __mem_store8(out_ptr + index, byte)
    1
  }
}

pub(package) fn runtime_str_builder_copy(out_ptr: i64, out_len: i64, out_start: i64, source: str, source_start: i64, count: i64) -> i64 {
  let source_len = __str_len(source)
  if out_start < 0 or source_start < 0 or count < 0 or
     out_start + count > out_len or source_start + count > source_len { 0 }
  else {
    if count > 0 { mem_copy(out_ptr + out_start, __str_ptr(source) + source_start, count) } else { 0 }
    count
  }
}

pub(package) fn runtime_str_promote(s: str) -> i64 {
  rc_default_promote_maybe(__str_ptr(s) - 16)
}

pub(package) fn runtime_str_from_bytes(ptr: i64, len: i64) -> str {
  let take = if len < 0 { 0 } else { len }
  let out = runtime_str_alloc_uninit(take)
  if take > 0 {
    mem_copy(__str_ptr(out), ptr, len)
  } else { 0 }
  out
}

pub(package) fn runtime_str_cstring(s: str) -> i64 {
  let len = __str_len(s)
  let out = alloc_bump(len + 1)
  mem_copy(out, __str_ptr(s), len)
  __mem_store8(out + len, 0)
  out
}

-- C string bytes are a synchronous foreign-call view, not an owned
-- process-lifetime value. Keep the raw pointer inside the trusted
-- callback and reclaim its bump storage as soon as the call returns.
pub(package) fn runtime_str_with_cstring_i64(s: str, body: (i64) -> i64) -> i64 {
  let mark = alloc_bump_mark()
  let raw = runtime_str_cstring(s)
  let result = body(raw)
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_str_ptr(s: str) -> i64 { __str_ptr(s) }

pub(package) fn runtime_str_len(s: str) -> i64 { __str_len(s) }

pub(package) fn runtime_str_word_len(s: i64) -> i64 { __str_len(s) }

pub(package) fn runtime_str_concat(a: str, b: str) -> str {
  let a_ptr = __str_ptr(a)
  let a_len = __str_len(a)
  let b_ptr = __str_ptr(b)
  let b_len = __str_len(b)
  let total = a_len + b_len
  let out = runtime_str_alloc_uninit(total)
  let data = __str_ptr(out)
  mem_copy(data, a_ptr, a_len)
  mem_copy(data + a_len, b_ptr, b_len)
  out
}

pub(package) fn runtime_int_to_str(n: i64) -> str {
  if n == 0 {
    let out = runtime_str_alloc_uninit(1)
    __mem_store8(__str_ptr(out), 48)
    out
  } else {
    let is_neg = if n < 0 { 1 } else { 0 }
    let mut val = if n < 0 { 0 - n } else { n }
    -- Two passes (count digits, then fill from the end) instead of a
    -- reversal scratch buffer abandoned on every call.
    let mut digits = 0
    let mut probe = val
    while probe > 0 {
      digits = digits + 1
      probe = probe / 10
    }
    let total = digits + is_neg
    let out = runtime_str_alloc_uninit(total)
    let data = __str_ptr(out)
    if is_neg == 1 { __mem_store8(data, 45) } else { 0 }
    let mut pos = total - 1
    while val > 0 {
      let digit = val - val / 10 * 10
      __mem_store8(data + pos, digit + 48)
      val = val / 10
      pos = pos - 1
    }
    out
  }
}

pub(package) fn runtime_str_word_byte_at(s: i64, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

pub(package) fn runtime_str_byte_at(s: str, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

pub(package) fn runtime_str_eq(a: str, b: str) -> i64 {
  let a_len = __str_len(a)
  let b_len = __str_len(b)
  if a_len != b_len { 0 }
  else {
    let a_ptr = __str_ptr(a)
    let b_ptr = __str_ptr(b)
    let mut eq = 1
    let mut i = 0
    while i < a_len {
      if __mem_load8(a_ptr + i) != __mem_load8(b_ptr + i) {
        eq = 0
        i = a_len
      } else { i = i + 1 }
    }
    eq
  }
}

pub(package) fn runtime_str_from_bytes_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

pub(package) fn runtime_str_slice_bytes(s: str, start: i64, len: i64) -> str {
  let n = __str_len(s)
  if start < 0 or len < 0 or start > n {
    ""
  } else {
    let take = if start + len > n { n - start } else { len }
    runtime_str_from_bytes_copy(__str_ptr(s) + start, take)
  }
}

pub(package) fn runtime_str_eq_at_bytes(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  let needle_len = __str_len(needle)
  if pos < 0 or pos + needle_len > n { 0 }
  else {
    let needle_ptr = __str_ptr(needle)
    let mut ok = 1
    let mut i = 0
    while ok == 1 and i < needle_len {
      if __mem_load8(src + pos + i) != __mem_load8(needle_ptr + i) {
        ok = 0
      } else {
        i = i + 1
      }
    }
    ok
  }
}
