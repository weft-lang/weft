-- runtime/string.weft -- trusted string storage and C ABI helpers

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/rc.{*}
use runtime/unsafe.{*}
use runtime/utf8.{
  Utf8StorageDecode,
  Utf8StorageMalformed,
  Utf8StorageResult,
  Utf8StorageScalar,
  utf8_storage_decode,
  utf8_storage_decode_as
}
use runtime/vector_storage.{vector_storage_data, vector_storage_len}
use stdlib/vector/handles.{Vector}

pub(package) fn runtime_str_word_as_str(value: i64) -> str {
  handle unsafe_transmute<i64, str>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Dynamic strings keep their descriptor and bytes in one default-
-- managed payload. The public str word points at the payload's
-- descriptor, exactly like a literal points at its bump-immortal
-- descriptor, so __str_ptr/__str_len keep one ABI for both forms.
pub(package) fn runtime_str_alloc_uninit(capacity: i64) -> str {
  let len = if capacity < 0 { 0 } else { capacity }
  -- The trusted builder owns this allocation immediately as a str;
  -- keep the raw descriptor word only long enough to initialise it.
  -- Zero-length results still allocate the descriptor here: returning
  -- a source literal would manufacture immortal bump data per call.
  let desc: i64 = rc_default_alloc(16 + len, 8)
  let data = desc + 16
  __mem_store64(desc, data)
  __mem_store64(desc + 8, len)
  runtime_str_word_as_str(desc)
}

pub(package) fn runtime_str_set_len(s: str, len: i64) -> i64 {
  __mem_store64(__str_ptr(s) - 8, len)
}

-- Trusted construction primitives for stdlib string algorithms. Bounds are
-- checked here so ordinary string APIs never expose a writable raw pointer.
pub(package) fn runtime_str_builder_set_byte(
  out_ptr: i64,
  out_len: i64,
  index: i64,
  byte: i64
) -> i64 {
  if index < 0 or index >= out_len { 0 }
  else {
    __mem_store8(out_ptr + index, byte)
    1
  }
}

pub(package) fn runtime_str_builder_copy(
  out_ptr: i64,
  out_len: i64,
  out_start: i64,
  source: str,
  source_start: i64,
  count: i64
) -> i64 {
  let source_len = __str_len(source)
  if out_start < 0 or source_start < 0 or count < 0 or
    out_start + count > out_len or source_start + count > source_len { 0 }
  else {
    if count > 0 { mem_copy(out_ptr + out_start, __str_ptr(source) + source_start, count) } else {
      0
    }
    count
  }
}

pub(package) fn runtime_str_promote(s: str) -> i64 {
  rc_default_promote_maybe(__str_ptr(s) - 16)
}

pub(package) fn runtime_str_from_bytes(ptr: i64, len: i64) -> str {
  let take = if len < 0 { 0 } else { len }
  let out = runtime_str_alloc_uninit(take)
  if take > 0 {
    mem_copy(__str_ptr(out), ptr, len)
  } else { 0 }
  out
}

pub(package) fn runtime_str_cstring(s: str) -> i64 {
  let len = __str_len(s)
  let out = alloc_bump(len + 1)
  mem_copy(out, __str_ptr(s), len)
  __mem_store8(out + len, 0)
  out
}

-- C string bytes are a synchronous foreign-call view, not an owned
-- process-lifetime value. Keep the raw pointer inside the trusted
-- callback and reclaim its bump storage as soon as the call returns.
pub(package) fn runtime_str_with_cstring_i64(s: str, body: (i64) -> i64) -> i64 {
  let mark = alloc_bump_mark()
  let raw = runtime_str_cstring(s)
  let result = body(raw)
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_str_ptr(s: str) -> i64 { __str_ptr(s) }

--- An opaque number naming this string's storage: two strings share it
--- exactly when they share storage. Strict code can compare it but has no
--- operation that dereferences it. Source registration uses it as the
--- transitional source identity until identities become registration ordinals.
pub(package) fn runtime_str_storage_identity(s: str) -> i64 { __str_ptr(s) }

--- Whether two strings share one storage, rather than merely equal bytes.
pub(package) fn runtime_str_same_storage(left: str, right: str) -> bool {
  __str_ptr(left) == __str_ptr(right)
}

--- A copy of `s` in fresh storage, byte for byte (malformed UTF-8 included).
pub(package) fn runtime_str_copy(s: str) -> str {
  runtime_str_from_bytes(__str_ptr(s), __str_len(s))
}

pub(package) fn runtime_str_len(s: str) -> i64 { __str_len(s) }

pub(package) fn runtime_str_concat(a: str, b: str) -> str {
  let a_ptr = __str_ptr(a)
  let a_len = __str_len(a)
  let b_ptr = __str_ptr(b)
  let b_len = __str_len(b)
  let total = a_len + b_len
  let out = runtime_str_alloc_uninit(total)
  let data = __str_ptr(out)
  mem_copy(data, a_ptr, a_len)
  mem_copy(data + a_len, b_ptr, b_len)
  out
}

pub(package) fn runtime_int_to_str(n: i64) -> str {
  let sign = if n < 0 { 1 } else { 0 }
  -- Every magnitude fits in the negative domain, including minimum i64.
  -- Count digits first, then fill the one managed allocation from its end.
  let mut remaining = if n > 0 { 0 - n } else { n }
  let mut digits = 1
  let mut probe = remaining
  while probe <= - 10 {
    digits = digits + 1
    probe = probe / 10
  }
  let out = runtime_str_alloc_uninit(digits + sign)
  let data = __str_ptr(out)
  if sign == 1 { __mem_store8(data, 45) } else { 0 }
  let mut position = digits + sign
  while position > sign {
    position = position - 1
    let quotient = remaining / 10
    let digit = quotient * 10 - remaining
    __mem_store8(data + position, digit + 48)
    remaining = quotient
  }
  out
}

pub(package) fn runtime_str_byte_at(s: str, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

pub(package) fn runtime_str_eq(a: str, b: str) -> i64 {
  let a_len = __str_len(a)
  let b_len = __str_len(b)
  if a_len != b_len { 0 }
  else {
    let a_ptr = __str_ptr(a)
    let b_ptr = __str_ptr(b)
    let mut eq = 1
    let mut i = 0
    while i < a_len {
      if __mem_load8(a_ptr + i) != __mem_load8(b_ptr + i) {
        eq = 0
        i = a_len
      } else { i = i + 1 }
    }
    eq
  }
}

fn runtime_utf8_storage_valid(data: i64, len: i64) -> bool {
  let mut position = 0
  loop {
    if position >= len { return true }
    match utf8_storage_decode(data, len, position) {
      Utf8StorageScalar(next, _) -> { position = next }
      Utf8StorageMalformed(_) -> return false
    }
  }
  false
}

--- Copy a byte vector's initialized bytes into immutable text. The copy is
--- refused when the bytes are not well-formed UTF-8, so mutable byte storage
--- can never manufacture malformed public text.
pub(package) fn runtime_str_from_utf8_vector(values: borrow Vector<u8>) -> str? {
  let data = vector_storage_data<u8>(values)
  let len = vector_storage_len<u8>(values)
  if runtime_utf8_storage_valid(data, len) { runtime_str_from_bytes_copy(data, len) } else { nil }
}

--- Copy a byte vector's initialized bytes into opaque byte storage. The result
--- may hold arbitrary bytes; only package-private byte containers wrap it.
pub(package) fn runtime_str_storage_from_vector(values: borrow Vector<u8>) -> str {
  runtime_str_from_bytes_copy(vector_storage_data<u8>(values), vector_storage_len<u8>(values))
}

--- Copy bytes `[start, start + count)` of a byte vector into opaque byte
--- storage, or `nil` unless the range lies within its initialized bytes.
pub(package) fn runtime_str_storage_from_vector_range(
  values: borrow Vector<u8>,
  start: i64,
  count: i64
) -> str? {
  let len = vector_storage_len<u8>(values)
  if start < 0 or count < 0 or start > len - count { return nil }
  runtime_str_from_bytes_copy(vector_storage_data<u8>(values) + start, count)
}

--- Decode one scalar from text beginning at byte offset `position`. Offsets
--- outside the text are malformed at `position`; the text bounds the read.
pub(package) fn runtime_str_utf8_decode(text: str, position: i64) -> Utf8StorageDecode {
  utf8_storage_decode(__str_ptr(text), __str_len(text), position)
}

--- Decode one scalar from text into the caller's typed result.
pub(package) fn runtime_str_utf8_decode_as<R: Utf8StorageResult>(
  text: str,
  position: usize
) -> R.Output {
  utf8_storage_decode_as<R>(__str_ptr(text), __str_len(text), position)
}

--- Return the first byte offset at which storage stops being well-formed
--- UTF-8, or `-1` when every byte belongs to a canonical scalar.
pub(package) fn runtime_str_utf8_first_malformed(storage: str) -> i64 {
  let data = __str_ptr(storage)
  let len = __str_len(storage)
  let mut position = 0
  loop {
    if position >= len { return 0 - 1 }
    match utf8_storage_decode(data, len, position) {
      Utf8StorageScalar(next, _) -> { position = next }
      Utf8StorageMalformed(offset) -> return offset
    }
  }
  0 - 1
}

--- Copy byte storage with one byte appended.
pub(package) fn runtime_str_storage_push_byte(storage: str, byte: u8) -> str {
  let len = __str_len(storage)
  let out = runtime_str_alloc_uninit(len + 1)
  let data = __str_ptr(out)
  if len > 0 { mem_copy(data, __str_ptr(storage), len) } else { 0 }
  __mem_store8(data + len, __u64_to_i64(__u8_to_u64(byte)))
  out
}

pub(package) fn runtime_str_from_bytes_copy(ptr: i64, len: i64) -> str {
  runtime_str_from_bytes(ptr, len)
}

pub(package) fn runtime_str_slice_bytes(s: str, start: i64, len: i64) -> str {
  let n = __str_len(s)
  if start < 0 or len < 0 or start > n {
    ""
  } else {
    let take = if start + len > n { n - start } else { len }
    runtime_str_from_bytes_copy(__str_ptr(s) + start, take)
  }
}

--- Return whether `needle` occurs in `text` at byte offset `position`.
pub(package) fn runtime_str_matches_at(text: str, position: i64, needle: str) -> bool {
  runtime_str_eq_at_bytes(__str_ptr(text), position, __str_len(text), needle) == 1
}

--- Copy text with ASCII letters mapped to one case. Every other byte is
--- preserved, so well-formed text stays well-formed.
pub(package) fn runtime_str_map_ascii_case(text: str, upper: bool) -> str {
  let len = __str_len(text)
  let out = runtime_str_alloc_uninit(len)
  let source = __str_ptr(text)
  let target = __str_ptr(out)
  let first = if upper { 97 } else { 65 }
  let last = if upper { 122 } else { 90 }
  let shift = if upper { 0 - 32 } else { 32 }
  let mut index = 0
  while index < len {
    let byte = __mem_load8(source + index)
    __mem_store8(target + index, if byte >= first and byte <= last { byte + shift } else { byte })
    index = index + 1
  }
  out
}

pub(package) fn runtime_str_eq_at_bytes(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  let needle_len = __str_len(needle)
  if pos < 0 or pos + needle_len > n { 0 }
  else {
    let needle_ptr = __str_ptr(needle)
    let mut ok = 1
    let mut i = 0
    while ok == 1 and i < needle_len {
      if __mem_load8(src + pos + i) != __mem_load8(needle_ptr + i) {
        ok = 0
      } else {
        i = i + 1
      }
    }
    ok
  }
}
