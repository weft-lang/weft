-- runtime/string.weft -- trusted string storage and C ABI helpers

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "runtime/unsafe.weft"

fn runtime_str_word_as_str(value: i64) -> str {
  handle unsafe_transmute<i64, str>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_str_from_bytes(ptr: i64, len: i64) -> str {
  let desc = alloc_words(2)
  __mem_store64(desc, ptr)
  __mem_store64(desc + 8, len)
  runtime_str_word_as_str(desc)
}

fn runtime_str_alloc_data(len: i64, align: i64) -> i64 {
  alloc_bump_rounded(len, align)
}

fn runtime_str_cstring(s: str) -> i64 {
  let len = __str_len(s)
  let out = alloc_bump(len + 1)
  mem_copy(out, __str_ptr(s), len)
  __mem_store8(out + len, 0)
  out
}

fn runtime_str_ptr(s: str) -> i64 { __str_ptr(s) }

fn runtime_str_len(s: str) -> i64 { __str_len(s) }

fn runtime_str_word_len(s: i64) -> i64 { __str_len(s) }

fn runtime_str_concat(a: str, b: str) -> str {
  let a_ptr = __str_ptr(a)
  let a_len = __str_len(a)
  let b_ptr = __str_ptr(b)
  let b_len = __str_len(b)
  let total = a_len + b_len
  let data = alloc_bump_rounded(total, 8)
  mem_copy(data, a_ptr, a_len)
  mem_copy(data + a_len, b_ptr, b_len)
  runtime_str_from_bytes(data, total)
}

fn runtime_int_to_str(n: i64) -> str {
  if n == 0 {
    "0"
  } else {
    let is_neg = if n < 0 { 1 } else { 0 }
    let mut val = if n < 0 { 0 - n } else { n }
    let buf = alloc_bump(24)
    let mut pos = 0
    while val > 0 {
      let digit = val - val / 10 * 10
      __mem_store8(buf + pos, digit + 48)
      val = val / 10
      pos = pos + 1
    }
    if is_neg == 1 {
      __mem_store8(buf + pos, 45)
      pos = pos + 1
    } else { 0 }
    let total = pos
    let data = alloc_bump_rounded(total, 8)
    for i in 0..total {
      __mem_store8(data + i, __mem_load8(buf + total - 1 - i))
    }
    runtime_str_from_bytes(data, total)
  }
}

fn runtime_str_word_byte_at(s: i64, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

fn runtime_str_byte_at(s: str, index: i64) -> i64 {
  if index < 0 or index >= __str_len(s) { 0 }
  else { __mem_load8(__str_ptr(s) + index) }
}

fn runtime_str_eq(a: str, b: str) -> i64 {
  let a_len = __str_len(a)
  let b_len = __str_len(b)
  if a_len != b_len { 0 }
  else {
    let a_ptr = __str_ptr(a)
    let b_ptr = __str_ptr(b)
    let mut eq = 1
    let mut i = 0
    while i < a_len {
      if __mem_load8(a_ptr + i) != __mem_load8(b_ptr + i) {
        eq = 0
        i = a_len
      } else { i = i + 1 }
    }
    eq
  }
}

fn runtime_str_from_bytes_copy(ptr: i64, len: i64) -> str {
  if len <= 0 {
    ""
  } else {
    let data = alloc_bump_rounded(len, 8)
    mem_copy(data, ptr, len)
    runtime_str_from_bytes(data, len)
  }
}

fn runtime_str_slice_bytes(s: str, start: i64, len: i64) -> str {
  let n = __str_len(s)
  if start < 0 or len < 0 or start > n {
    ""
  } else {
    let take = if start + len > n { n - start } else { len }
    runtime_str_from_bytes_copy(__str_ptr(s) + start, take)
  }
}

fn runtime_str_eq_at_bytes(src: i64, pos: i64, n: i64, needle: str) -> i64 {
  let needle_len = __str_len(needle)
  if pos < 0 or pos + needle_len > n { 0 }
  else {
    let needle_ptr = __str_ptr(needle)
    let mut ok = 1
    let mut i = 0
    while ok == 1 and i < needle_len {
      if __mem_load8(src + pos + i) != __mem_load8(needle_ptr + i) {
        ok = 0
      } else {
        i = i + 1
      }
    }
    ok
  }
}
