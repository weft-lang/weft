-- runtime/safe_io.weft — safe typed I/O over the transitional raw adapters
--
-- Public effects carry Path, Bytes and IoError. Descriptor integers, native
-- flags, pointer-shaped buffers and errno remain inside this platform bridge.

use runtime/dir.{runtime_platform_dir, runtime_platform_dir_with}
use runtime/safe_dir_core.{runtime_safe_dir_list_result, runtime_safe_dir_metadata_result, runtime_safe_dir_path_result, runtime_safe_nil_status}
use runtime/safe_file_core.{runtime_safe_file_read_result, runtime_safe_file_write_result, runtime_safe_path_string, runtime_safe_write_fd}
use stdlib/bytes.{Bytes, bytes_empty, bytes_from_vector}
use stdlib/console.{ConsoleRead, ConsoleStderr, ConsoleStdout, ConsoleStream, ConsoleWrite}
use stdlib/dir.{Dir, DirInspect, DirMetadata, DirMutate}
use stdlib/file.{FileRead, FileWrite}
use stdlib/io.{raw_read}
use stdlib/io_types.{IoError, IoInterrupted, IoInvalidProgress, IoLimitExceeded, io_error_from_errno}
use stdlib/num.{num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/path.{Path}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push, vector_with_capacity, vector_data}
use stdlib/vector_type.{Vector}

fn runtime_safe_io_chunk_size() -> i64 { 4096 }

fn runtime_safe_usize_to_i64(value: usize) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(value)), 0 - 1)
}

fn runtime_safe_scratch() -> Vector<u8> {
  let size = runtime_safe_io_chunk_size()
  let values = vector_with_capacity<u8>(size)
  for i in 0..size { vector_push<u8>(values, 0) }
  values
}

fn runtime_safe_console_fd(stream: ConsoleStream) -> i64 {
  match stream {
    ConsoleStdout -> 1
    ConsoleStderr -> 2
  }
}

fn runtime_safe_console_read(limit: usize) -> Result<Bytes, IoError> {
  let raw_limit = runtime_safe_usize_to_i64(limit)
  if raw_limit < 0 {
    result_err<Bytes, IoError>(IoLimitExceeded(limit))
  } else { if raw_limit == 0 {
    result_ok<Bytes, IoError>(bytes_empty())
  } else {
    let request = if raw_limit < runtime_safe_io_chunk_size() { raw_limit } else { runtime_safe_io_chunk_size() }
    let scratch = runtime_safe_scratch()
    let mut done = false
    let mut failed = false
    let mut count = 0
    let mut failure = IoInvalidProgress
    while not done and not failed {
      let status = raw_read(0, vector_data<u8>(scratch), request)
      if status >= 0 {
        count = status
        done = true
      } else {
        match io_error_from_errno(status) {
          IoInterrupted -> 0
          error -> {
            failure = error
            failed = true
            0
          }
        }
      }
    }
    if failed {
      result_err<Bytes, IoError>(failure)
    } else {
      let out = vector_with_capacity<u8>(count)
      for i in 0..count { vector_push<u8>(out, vector_get_in_bounds<u8>(scratch, i)) }
      result_ok<Bytes, IoError>(bytes_from_vector(out))
    }
  } }
}

pub fn runtime_platform_file_read(body: () -[FileRead]> i64) -> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub fn runtime_platform_file_read_with<E>(body: () -[FileRead, E]> i64) -[E]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

fn runtime_safe_file_write_layer<E>(body: () -[FileWrite, E]> i64) -[Dir, E]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

pub fn runtime_platform_file_write(body: () -[FileWrite]> i64) -> i64 {
  runtime_platform_dir(() => handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  })
}

pub fn runtime_platform_file_write_with<E>(body: () -[FileWrite, E]> i64) -[E]> i64 {
  runtime_platform_dir_with<E>(() => runtime_safe_file_write_layer<E>(body))
}

pub fn runtime_platform_console_read(body: () -[ConsoleRead]> i64) -> i64 {
  handle body() {
    ConsoleRead.read(limit) -> resume(runtime_safe_console_read(limit))
  }
}

pub fn runtime_platform_console_read_with<E>(body: () -[ConsoleRead, E]> i64) -[E]> i64 {
  handle body() {
    ConsoleRead.read(limit) -> resume(runtime_safe_console_read(limit))
  }
}

pub fn runtime_platform_console_write(body: () -[ConsoleWrite]> i64) -> i64 {
  handle body() {
    ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_write_fd(runtime_safe_console_fd(stream), values))
    -- Raw descriptor writes are unbuffered at this layer.
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
}

pub fn runtime_platform_console_write_with<E>(body: () -[ConsoleWrite, E]> i64) -[E]> i64 {
  handle body() {
    ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_write_fd(runtime_safe_console_fd(stream), values))
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
}

fn runtime_safe_dir_inspect_layer<E>(body: () -[DirInspect, E]> i64) -[Dir, E]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  }
}

pub fn runtime_platform_dir_inspect(body: () -[DirInspect]> i64) -> i64 {
  runtime_platform_dir(() => handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  })
}

pub fn runtime_platform_dir_inspect_with<E>(body: () -[DirInspect, E]> i64) -[E]> i64 {
  runtime_platform_dir_with<E>(() => runtime_safe_dir_inspect_layer<E>(body))
}

fn runtime_safe_dir_mutate_layer<E>(body: () -[DirMutate, E]> i64) -[Dir, E]> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(Dir.mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(Dir.remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(Dir.rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

pub fn runtime_platform_dir_mutate(body: () -[DirMutate]> i64) -> i64 {
  runtime_platform_dir(() => handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(Dir.mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(Dir.remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(Dir.rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  })
}

pub fn runtime_platform_dir_mutate_with<E>(body: () -[DirMutate, E]> i64) -[E]> i64 {
  runtime_platform_dir_with<E>(() => runtime_safe_dir_mutate_layer<E>(body))
}

fn runtime_safe_all_file_read(
  body: () -[FileRead, FileWrite, ConsoleRead, ConsoleWrite, DirInspect, DirMutate]> i64
) -[FileWrite, ConsoleRead, ConsoleWrite, DirInspect, DirMutate]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

fn runtime_safe_all_file_write(
  body: () -[FileWrite, ConsoleRead, ConsoleWrite, DirInspect, DirMutate]> i64
) -[ConsoleRead, ConsoleWrite, DirInspect, DirMutate, Dir]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_safe_all_console_read(
  body: () -[ConsoleRead, ConsoleWrite, DirInspect, DirMutate, Dir]> i64
) -[ConsoleWrite, DirInspect, DirMutate, Dir]> i64 {
  handle body() {
    ConsoleRead.read(limit) -> resume(runtime_safe_console_read(limit))
  }
}

fn runtime_safe_all_console_write(
  body: () -[ConsoleWrite, DirInspect, DirMutate, Dir]> i64
) -[DirInspect, DirMutate, Dir]> i64 {
  handle body() {
    ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_write_fd(runtime_safe_console_fd(stream), values))
    ConsoleWrite.flush(stream) -> resume(result_ok<nil, IoError>(nil))
  }
}

fn runtime_safe_all_dir_inspect(
  body: () -[DirInspect, DirMutate, Dir]> i64
) -[DirMutate, Dir]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(Dir.list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(Dir.stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(Dir.lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(Dir.getcwd()))
  }
}

fn runtime_safe_all_dir_mutate(body: () -[DirMutate, Dir]> i64) -[Dir]> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(Dir.mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(Dir.remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(Dir.rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

pub fn runtime_platform_safe_io(
  body: () -[FileRead, FileWrite, ConsoleRead, ConsoleWrite, DirInspect, DirMutate]> i64
) -> i64 {
  runtime_platform_dir(() =>
    runtime_safe_all_dir_mutate(() =>
      runtime_safe_all_dir_inspect(() =>
        runtime_safe_all_console_write(() =>
          runtime_safe_all_console_read(() =>
            runtime_safe_all_file_write(() =>
              runtime_safe_all_file_read(body)))))))
}
