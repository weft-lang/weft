-- Trusted helper surface for pointer semantics tests.

use runtime/unsafe.{*}

pub(package) fn pointer_test_read(p: *i64) -[Unsafe]> i64 {
  p.*
}

pub(package) fn pointer_test_mut_read(p: *mut i64) -[Unsafe]> i64 {
  p.*
}

pub(package) fn pointer_test_mut_write(p: *mut i64, value: i64) -[Unsafe]> i64 {
  p.* = value
  p.*
}

pub(package) fn pointer_test_choose(flag: bool, p: *i64, q: *i64) -> *i64 {
  if flag { p } else { q }
}

pub(package) fn pointer_test_run_unsafe(f: () -[Unsafe]> i64) -> i64 {
  handle f() {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

pub(package) fn pointer_test_basic_immutable_local_read_impl() -[Unsafe]> i64 {
  let x = 42
  let p = &x
  p.*
}

pub(package) fn pointer_test_basic_parameter_read_impl() -[Unsafe]> i64 {
  let x = 17
  pointer_test_read(&x)
}

pub(package) fn pointer_test_basic_repeated_address_keeps_identity_impl() -[Unsafe]> i64 {
  let x = 5
  let p = &x
  let q = &x
  if p == q { p.* } else { 0 }
}

pub(package) fn pointer_test_basic_mut_pointer_read_impl() -[Unsafe]> i64 {
  let mut y = 33
  pointer_test_mut_read(&mut y)
}

pub(package) fn pointer_test_basic_mut_pointer_subtypes_to_immutable_impl() -[Unsafe]> i64 {
  let mut y = 44
  pointer_test_read(&mut y)
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_updates_local_impl() -[Unsafe]> i64 {
  let mut y = 1
  let p = &mut y
  p.* = 9
  y
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_through_parameter_impl() -[Unsafe]> i64 {
  let mut y = 2
  let wrote = pointer_test_mut_write(&mut y, 15)
  wrote * 100 + y
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_alias_ordering_impl() -[Unsafe]> i64 {
  let mut y = 3
  let p = &mut y
  let q = p
  p.* = 21
  q.* = q.* + 1
  y
}

pub(package) fn pointer_test_basic_immutable_local_read() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_immutable_local_read_impl)
}

pub(package) fn pointer_test_basic_parameter_read() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_parameter_read_impl)
}

pub(package) fn pointer_test_basic_repeated_address_keeps_identity() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_repeated_address_keeps_identity_impl)
}

pub(package) fn pointer_test_basic_mut_pointer_read() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_mut_pointer_read_impl)
}

pub(package) fn pointer_test_basic_mut_pointer_subtypes_to_immutable() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_mut_pointer_subtypes_to_immutable_impl)
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_updates_local() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_mut_pointer_assignment_updates_local_impl)
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_through_parameter() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_mut_pointer_assignment_through_parameter_impl)
}

pub(package) fn pointer_test_basic_mut_pointer_assignment_alias_ordering() -> i64 {
  pointer_test_run_unsafe(pointer_test_basic_mut_pointer_assignment_alias_ordering_impl)
}

pub(package) fn pointer_test_types_signature_annotation_impl() -[Unsafe]> i64 {
  let x = 10
  pointer_test_read(&x)
}

pub(package) fn pointer_test_types_return_pointer_value_impl() -[Unsafe]> i64 {
  let x = 11
  let y = 12
  let p = pointer_test_choose(false, &x, &y)
  p.*
}

pub(package) fn pointer_test_types_mut_pointer_write_signature_impl() -[Unsafe]> i64 {
  let mut x = 1
  let wrote = pointer_test_mut_write(&mut x, 23)
  wrote * 100 + x
}

pub(package) fn pointer_test_types_signature_annotation() -> i64 {
  pointer_test_run_unsafe(pointer_test_types_signature_annotation_impl)
}

pub(package) fn pointer_test_types_return_pointer_value() -> i64 {
  pointer_test_run_unsafe(pointer_test_types_return_pointer_value_impl)
}

pub(package) fn pointer_test_types_mut_pointer_write_signature() -> i64 {
  pointer_test_run_unsafe(pointer_test_types_mut_pointer_write_signature_impl)
}
