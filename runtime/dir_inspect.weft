-- runtime/dir_inspect.weft — production directory inspection

use runtime/dir.{runtime_dir_getcwd, runtime_dir_list, runtime_dir_lstat, runtime_dir_stat}
use runtime/safe_dir_core.{runtime_safe_dir_list_result, runtime_safe_dir_metadata_result, runtime_safe_dir_path_result}
use runtime/safe_file_core.{runtime_safe_path_string}
use stdlib/dir.{DirInspect}

--- Interpret DirInspect through the target platform filesystem.
pub implements DirInspect() {
  DirInspect.list(path) ->
    resume(runtime_safe_dir_list_result(runtime_dir_list(runtime_safe_path_string(path))))
  DirInspect.stat(path) ->
    resume(runtime_safe_dir_metadata_result(runtime_dir_stat(runtime_safe_path_string(path))))
  DirInspect.lstat(path) ->
    resume(runtime_safe_dir_metadata_result(runtime_dir_lstat(runtime_safe_path_string(path))))
  DirInspect.current() -> resume(runtime_safe_dir_path_result(runtime_dir_getcwd()))
}
