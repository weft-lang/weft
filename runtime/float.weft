-- runtime/float.weft -- sealed IEEE representation bridges

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/string.{*}
use runtime/unsafe.{*}

pub(package) type RuntimeFloatDecimalInfo {
  RuntimeFloatDecimalInfo(i64, i64, i64, i64)
}

pub(package) type RuntimeFloatBitsResult {
  RuntimeFloatBitsResult(i64, i64)
}

pub(package) type RuntimeFloatRoundedResult {
  RuntimeFloatRoundedResult(i64, i64)
}

pub(package) fn runtime_float_decimal_info_number(info: RuntimeFloatDecimalInfo) -> i64 {
  match info { RuntimeFloatDecimalInfo(number, exponent, ok, zero) -> number }
}

pub(package) fn runtime_float_decimal_info_exponent(info: RuntimeFloatDecimalInfo) -> i64 {
  match info { RuntimeFloatDecimalInfo(number, exponent, ok, zero) -> exponent }
}

pub(package) fn runtime_float_decimal_info_ok(info: RuntimeFloatDecimalInfo) -> i64 {
  match info { RuntimeFloatDecimalInfo(number, exponent, ok, zero) -> ok }
}

pub(package) fn runtime_float_decimal_info_zero(info: RuntimeFloatDecimalInfo) -> i64 {
  match info { RuntimeFloatDecimalInfo(number, exponent, ok, zero) -> zero }
}

pub(package) fn runtime_float_bits_result_bits(result: RuntimeFloatBitsResult) -> i64 {
  match result { RuntimeFloatBitsResult(bits, ok) -> bits }
}

pub(package) fn runtime_float_bits_result_ok(result: RuntimeFloatBitsResult) -> i64 {
  match result { RuntimeFloatBitsResult(bits, ok) -> ok }
}

pub(package) fn runtime_float_rounded_value(result: RuntimeFloatRoundedResult) -> i64 {
  match result { RuntimeFloatRoundedResult(value, ok) -> value }
}

pub(package) fn runtime_float_rounded_ok(result: RuntimeFloatRoundedResult) -> i64 {
  match result { RuntimeFloatRoundedResult(value, ok) -> ok }
}

-- Float values already travel through the native pipeline as their exact
-- IEEE payload words. Keep the representation cast inside the sealed runtime
-- so ordinary numeric code gets a pure, typed operation rather than Unsafe.
pub(package) fn runtime_f64_to_bits(value: f64) -> u64 {
  handle unsafe_transmute<f64, u64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_f64_from_bits(bits: u64) -> f64 {
  handle unsafe_transmute<u64, f64>(bits) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_f32_to_bits(value: f32) -> u32 {
  handle unsafe_transmute<f32, u32>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_f32_from_bits(bits: u32) -> f32 {
  handle unsafe_transmute<u32, f32>(bits) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_float_i64_pow2(exp: i64) -> i64 {
  let mut value = 1
  let mut i = 0
  while i < exp {
    value = value * 2
    i = i + 1
  }
  value
}

pub(package) fn runtime_float_i64_cmp(a: i64, b: i64) -> i64 {
  if a < b { 0 - 1 } else { if a > b { 1 } else { 0 } }
}

pub(package) fn runtime_float_i64_mul_checked(a: i64, b: i64) -> i64 {
  if a == 0 or b == 0 { 0 }
  else { if a > 9223372036854775807 / b { 0 - 1 } else { a * b } }
}

pub(package) fn runtime_float_i64_pow5_checked(exp: i64) -> i64 {
  if exp < 0 or exp > 27 { 0 - 1 }
  else {
    let mut value = 1
    let mut i = 0
    while i < exp {
      value = value * 5
      i = i + 1
    }
    value
  }
}

pub(package) fn runtime_float_i64_mul_pow2_clamped(value0: i64, shift: i64) -> i64 {
  let mut value = value0
  let mut i = 0
  let mut overflow = 0
  while i < shift {
    if value > 4611686018427387903 {
      overflow = 1
      i = shift
    } else {
      value = value * 2
      i = i + 1
    }
  }
  if overflow == 1 { 0 - 1 } else { value }
}

pub(package) fn runtime_float_big_base() -> i64 { 1073741824 }

pub(package) fn runtime_float_big_new(cap0: i64) -> i64 {
  let cap = if cap0 < 1 { 1 } else { cap0 }
  let big = alloc_bump(24)
  let data = alloc_bump(cap * 8)
  mem_store64_at(big, 0, data)
  mem_store64_at(big + 8, 0, 0)
  mem_store64_at(big + 16, 0, cap)
  big
}

pub(package) fn runtime_float_big_data(big: i64) -> i64 { mem_load64_at(big, 0) }
pub(package) fn runtime_float_big_len(big: i64) -> i64 { mem_load64_at(big + 8, 0) }
pub(package) fn runtime_float_big_set_len(big: i64, len: i64) -> i64 { mem_store64_at(big + 8, 0, len) 0 }

pub(package) fn runtime_float_big_zero_fill(big: i64, len: i64) -> i64 {
  let data = runtime_float_big_data(big)
  let mut i = 0
  while i < len {
    mem_store64_at(data + i * 8, 0, 0)
    i = i + 1
  }
  0
}

pub(package) fn runtime_float_big_normalize(big: i64) -> i64 {
  let data = runtime_float_big_data(big)
  let mut len = runtime_float_big_len(big)
  while len > 0 and mem_load64_at(data + (len - 1) * 8, 0) == 0 {
    len = len - 1
  }
  runtime_float_big_set_len(big, len)
  big
}

pub(package) fn runtime_float_big_from_i64(value0: i64) -> i64 {
  let big = runtime_float_big_new(4)
  let data = runtime_float_big_data(big)
  let base = runtime_float_big_base()
  let mut value = value0
  let mut len = 0
  while value > 0 {
    mem_store64_at(data + len * 8, 0, value % base)
    value = value / base
    len = len + 1
  }
  runtime_float_big_set_len(big, len)
  big
}

pub(package) fn runtime_float_big_mul_small(big: i64, multiplier: i64) -> i64 {
  let len = runtime_float_big_len(big)
  if len == 0 or multiplier == 0 { runtime_float_big_from_i64(0) }
  else {
    let result = runtime_float_big_new(len + 4)
    let source = runtime_float_big_data(big)
    let out = runtime_float_big_data(result)
    let base = runtime_float_big_base()
    let mut carry = 0
    let mut i = 0
    while i < len {
      let current = mem_load64_at(source + i * 8, 0) * multiplier + carry
      mem_store64_at(out + i * 8, 0, current % base)
      carry = current / base
      i = i + 1
    }
    let mut out_len = len
    while carry > 0 {
      mem_store64_at(out + out_len * 8, 0, carry % base)
      carry = carry / base
      out_len = out_len + 1
    }
    runtime_float_big_set_len(result, out_len)
    runtime_float_big_normalize(result)
  }
}

pub(package) fn runtime_float_big_add_small(big: i64, addend: i64) -> i64 {
  let len = runtime_float_big_len(big)
  let result = runtime_float_big_new(len + 4)
  let source = runtime_float_big_data(big)
  let out = runtime_float_big_data(result)
  let base = runtime_float_big_base()
  let mut carry = addend
  let mut i = 0
  while i < len {
    let current = mem_load64_at(source + i * 8, 0) + carry
    mem_store64_at(out + i * 8, 0, current % base)
    carry = current / base
    i = i + 1
  }
  let mut out_len = len
  while carry > 0 {
    mem_store64_at(out + out_len * 8, 0, carry % base)
    carry = carry / base
    out_len = out_len + 1
  }
  runtime_float_big_set_len(result, out_len)
  runtime_float_big_normalize(result)
}

pub(package) fn runtime_float_big_mul_pow5(big: i64, exponent: i64) -> i64 {
  let mut result = big
  let mut i = 0
  while i < exponent {
    result = runtime_float_big_mul_small(result, 5)
    i = i + 1
  }
  result
}

pub(package) fn runtime_float_big_shl(big: i64, bits: i64) -> i64 {
  let len = runtime_float_big_len(big)
  if len == 0 { runtime_float_big_from_i64(0) }
  else {
    let limb_shift = bits / 30
    let bit_shift = bits % 30
    let multiplier = runtime_float_i64_pow2(bit_shift)
    let result = runtime_float_big_new(len + limb_shift + 4)
    runtime_float_big_zero_fill(result, len + limb_shift + 4)
    let source = runtime_float_big_data(big)
    let out = runtime_float_big_data(result)
    let base = runtime_float_big_base()
    let mut carry = 0
    let mut i = 0
    while i < len {
      let current = mem_load64_at(source + i * 8, 0) * multiplier + carry
      mem_store64_at(out + (i + limb_shift) * 8, 0, current % base)
      carry = current / base
      i = i + 1
    }
    let mut out_len = len + limb_shift
    while carry > 0 {
      mem_store64_at(out + out_len * 8, 0, carry % base)
      carry = carry / base
      out_len = out_len + 1
    }
    runtime_float_big_set_len(result, out_len)
    runtime_float_big_normalize(result)
  }
}

pub(package) fn runtime_float_big_cmp(a: i64, b: i64) -> i64 {
  let a_len = runtime_float_big_len(a)
  let b_len = runtime_float_big_len(b)
  if a_len < b_len { 0 - 1 }
  else { if a_len > b_len { 1 }
  else {
    let a_data = runtime_float_big_data(a)
    let b_data = runtime_float_big_data(b)
    let mut i = a_len
    let mut done = 0
    let mut result = 0
    while done == 0 {
      if i <= 0 { done = 1 }
      else {
        i = i - 1
        let a_value = mem_load64_at(a_data + i * 8, 0)
        let b_value = mem_load64_at(b_data + i * 8, 0)
        if a_value < b_value { result = 0 - 1 done = 1 }
        else { if a_value > b_value { result = 1 done = 1 } else { 0 } }
      }
    }
    result
  } }
}

pub(package) fn runtime_float_i64_bit_length(value0: i64) -> i64 {
  let mut value = value0
  let mut len = 0
  while value > 0 {
    value = value / 2
    len = len + 1
  }
  len
}

pub(package) fn runtime_float_big_bit_length(big: i64) -> i64 {
  let len = runtime_float_big_len(big)
  if len == 0 { 0 }
  else {
    let data = runtime_float_big_data(big)
    (len - 1) * 30 + runtime_float_i64_bit_length(mem_load64_at(data + (len - 1) * 8, 0))
  }
}

pub(package) fn runtime_float_big_add_product_at(result: i64, index0: i64, limb: i64, chunk: i64) -> i64 {
  if chunk == 0 { 0 }
  else {
    let out = runtime_float_big_data(result)
    let base = runtime_float_big_base()
    let mut index = index0
    let mut carry = limb * chunk
    while carry > 0 {
      let current = mem_load64_at(out + index * 8, 0) + carry
      mem_store64_at(out + index * 8, 0, current % base)
      carry = current / base
      index = index + 1
    }
    0
  }
}

pub(package) fn runtime_float_big_mul_i64(big: i64, multiplier: i64) -> i64 {
  let len = runtime_float_big_len(big)
  if len == 0 or multiplier == 0 { runtime_float_big_from_i64(0) }
  else {
    let base = runtime_float_big_base()
    let chunk0 = multiplier % base
    let chunk1 = (multiplier / base) % base
    let chunk2 = multiplier / (base * base)
    let result = runtime_float_big_new(len + 5)
    runtime_float_big_zero_fill(result, len + 5)
    let source = runtime_float_big_data(big)
    let mut i = 0
    while i < len {
      let limb = mem_load64_at(source + i * 8, 0)
      runtime_float_big_add_product_at(result, i, limb, chunk0)
      runtime_float_big_add_product_at(result, i + 1, limb, chunk1)
      runtime_float_big_add_product_at(result, i + 2, limb, chunk2)
      i = i + 1
    }
    runtime_float_big_set_len(result, len + 5)
    runtime_float_big_normalize(result)
  }
}

pub(package) fn runtime_float_big_floor_div_to_i64(numerator: i64, denominator: i64, max_q: i64) -> i64 {
  let mut low = 0
  let mut high = max_q
  while low < high {
    let middle = (low + high + 1) / 2
    let product = runtime_float_big_mul_i64(denominator, middle)
    if runtime_float_big_cmp(product, numerator) <= 0 { low = middle }
    else { high = middle - 1 }
  }
  low
}

pub(package) fn runtime_float_big_round_scaled_quotient(numerator0: i64, denominator0: i64, shift: i64, max_q: i64) -> i64 {
  let numerator = if shift >= 0 { runtime_float_big_shl(numerator0, shift) } else { numerator0 }
  let denominator = if shift >= 0 { denominator0 } else { runtime_float_big_shl(denominator0, 0 - shift) }
  let quotient = runtime_float_big_floor_div_to_i64(numerator, denominator, max_q)
  let left = runtime_float_big_shl(numerator, 1)
  let right = runtime_float_big_mul_i64(denominator, quotient * 2 + 1)
  let comparison = runtime_float_big_cmp(left, right)
  if comparison > 0 { quotient + 1 }
  else { if comparison == 0 and quotient % 2 == 1 { quotient + 1 } else { quotient } }
}

pub(package) fn runtime_float_decimal_exp_pos(source: i64, start: i64, len: i64) -> i64 {
  let mut position = 0
  let mut found = 0 - 1
  while position < len {
    let byte = mem_load8_at(source + start + position, 0)
    if byte == 101 or byte == 69 {
      found = position
      position = len
    } else {
      position = position + 1
    }
  }
  found
}

pub(package) fn runtime_float_decimal_parse_exponent(source: i64, start: i64, len: i64, exp_position: i64) -> i64 {
  if exp_position < 0 { 0 }
  else {
    let mut position = exp_position + 1
    let mut sign = 1
    if position < len {
      let byte = mem_load8_at(source + start + position, 0)
      if byte == 45 { sign = 0 - 1 position = position + 1 }
      else { if byte == 43 { position = position + 1 } else { 0 } }
    } else { 0 }
    let mut value = 0
    while position < len {
      if value < 10000 {
        value = value * 10 + mem_load8_at(source + start + position, 0) - 48
      } else { 0 }
      position = position + 1
    }
    value * sign
  }
}

pub(package) fn runtime_float_decimal_big_info(source: i64, start: i64, len: i64) -> RuntimeFloatDecimalInfo {
  let exp_position = runtime_float_decimal_exp_pos(source, start, len)
  let mantissa_end = if exp_position >= 0 { exp_position } else { len }
  let source_exponent = runtime_float_decimal_parse_exponent(source, start, len, exp_position)
  let mut dot = 0 - 1
  let mut last_nonzero = 0 - 1
  let mut i = 0
  while i < mantissa_end {
    let byte = mem_load8_at(source + start + i, 0)
    if byte == 46 { dot = i }
    else { if byte != 48 { last_nonzero = i } else { 0 } }
    i = i + 1
  }
  if last_nonzero < 0 {
    RuntimeFloatDecimalInfo(runtime_float_big_from_i64(0), 0, 1, 1)
  } else {
    let last_significant = if dot >= 0 {
      if last_nonzero > dot { last_nonzero } else { dot - 1 }
    } else { mantissa_end - 1 }
    let mut number = runtime_float_big_from_i64(0)
    let mut fractional_digits = 0
    let mut seen = 0
    let mut after_dot = false
    let mut position = 0
    while position <= last_significant {
      let byte = mem_load8_at(source + start + position, 0)
      if byte == 46 {
        after_dot = true
      } else {
        if after_dot { fractional_digits = fractional_digits + 1 } else { 0 }
        if seen == 1 or byte != 48 {
          seen = 1
          number = runtime_float_big_add_small(runtime_float_big_mul_small(number, 10), byte - 48)
        } else { 0 }
      }
      position = position + 1
    }
    RuntimeFloatDecimalInfo(number, source_exponent - fractional_digits, 1, 0)
  }
}

pub(package) fn runtime_float_decimal_cmp_pow2_big(numerator: i64, denominator: i64, binary_shift: i64, exponent: i64) -> i64 {
  let min_shift = if binary_shift < exponent { binary_shift } else { exponent }
  let left = runtime_float_big_shl(numerator, binary_shift - min_shift)
  let right = runtime_float_big_shl(denominator, exponent - min_shift)
  runtime_float_big_cmp(left, right)
}

pub(package) fn runtime_float_decimal_binary_exponent_big(numerator: i64, denominator: i64, binary_shift: i64) -> i64 {
  let mut exponent = runtime_float_big_bit_length(numerator) - runtime_float_big_bit_length(denominator) + binary_shift
  while runtime_float_decimal_cmp_pow2_big(numerator, denominator, binary_shift, exponent + 1) >= 0 {
    exponent = exponent + 1
  }
  while runtime_float_decimal_cmp_pow2_big(numerator, denominator, binary_shift, exponent) < 0 {
    exponent = exponent - 1
  }
  exponent
}

pub(package) fn runtime_float_decimal_small_info(source: i64, start: i64, len: i64) -> RuntimeFloatDecimalInfo {
  let exp_position = runtime_float_decimal_exp_pos(source, start, len)
  let mantissa_end = if exp_position >= 0 { exp_position } else { len }
  let source_exponent = runtime_float_decimal_parse_exponent(source, start, len, exp_position)
  let mut dot = 0 - 1
  let mut last_nonzero = 0 - 1
  let mut i = 0
  while i < mantissa_end {
    let byte = mem_load8_at(source + start + i, 0)
    if byte == 46 { dot = i }
    else { if byte != 48 { last_nonzero = i } else { 0 } }
    i = i + 1
  }
  if last_nonzero < 0 {
    RuntimeFloatDecimalInfo(0, 0, 1, 1)
  } else {
    let last_significant = if dot >= 0 {
      if last_nonzero > dot { last_nonzero } else { dot - 1 }
    } else { mantissa_end - 1 }
    let mut number = 0
    let mut fractional_digits = 0
    let mut significant_digits = 0
    let mut seen = 0
    let mut after_dot = false
    let mut overflow = 0
    let mut position = 0
    while position <= last_significant {
      let byte = mem_load8_at(source + start + position, 0)
      if byte == 46 {
        after_dot = true
      } else {
        if after_dot { fractional_digits = fractional_digits + 1 } else { 0 }
        if seen == 1 or byte != 48 {
          seen = 1
          if significant_digits >= 18 {
            overflow = 1
          } else {
            number = number * 10 + byte - 48
            significant_digits = significant_digits + 1
          }
        } else { 0 }
      }
      position = position + 1
    }
    let exponent = source_exponent - fractional_digits
    let ok = if overflow == 0 and exponent >= 0 - 27 and exponent <= 27 { 1 } else { 0 }
    RuntimeFloatDecimalInfo(number, exponent, ok, 0)
  }
}

pub(package) fn runtime_float_decimal_cmp_pow2_small(number: i64, denominator: i64, binary_shift: i64, exponent: i64) -> i64 {
  let shift = exponent - binary_shift
  if shift >= 0 {
    let right = runtime_float_i64_mul_pow2_clamped(denominator, shift)
    if right < 0 { 0 - 1 } else { runtime_float_i64_cmp(number, right) }
  } else {
    let left = runtime_float_i64_mul_pow2_clamped(number, 0 - shift)
    if left < 0 { 1 } else { runtime_float_i64_cmp(left, denominator) }
  }
}

pub(package) fn runtime_float_decimal_binary_exponent_small(number: i64, denominator: i64, binary_shift: i64) -> i64 {
  let mut exponent = runtime_float_i64_bit_length(number) - runtime_float_i64_bit_length(denominator) + binary_shift
  while runtime_float_decimal_cmp_pow2_small(number, denominator, binary_shift, exponent + 1) >= 0 {
    exponent = exponent + 1
  }
  while runtime_float_decimal_cmp_pow2_small(number, denominator, binary_shift, exponent) < 0 {
    exponent = exponent - 1
  }
  exponent
}

pub(package) fn runtime_float_decimal_round_scaled_quotient_small(number: i64, denominator0: i64, shift: i64, max_quotient: i64) -> RuntimeFloatRoundedResult {
  let mut quotient = 0
  let mut remainder = 0
  let mut denominator = denominator0
  if shift >= 0 {
    quotient = number / denominator
    remainder = number - quotient * denominator
    let mut i = 0
    let mut ok = 1
    while i < shift and ok == 1 {
      if remainder >= denominator - remainder {
        remainder = remainder - (denominator - remainder)
        quotient = quotient * 2 + 1
      } else {
        remainder = remainder + remainder
        quotient = quotient * 2
      }
      if quotient > max_quotient { ok = 0 } else { 0 }
      i = i + 1
    }
    if ok == 0 { RuntimeFloatRoundedResult(0, 0) }
    else {
      let half = denominator / 2
      if remainder > half { quotient = quotient + 1 }
      else {
        if denominator % 2 == 0 and remainder == half and quotient % 2 == 1 {
          quotient = quotient + 1
        } else { 0 }
      }
      if quotient > max_quotient { RuntimeFloatRoundedResult(0, 0) }
      else { RuntimeFloatRoundedResult(quotient, 1) }
    }
  } else {
    denominator = runtime_float_i64_mul_pow2_clamped(denominator, 0 - shift)
    if denominator < 0 { RuntimeFloatRoundedResult(0, 0) }
    else {
      quotient = number / denominator
      remainder = number - quotient * denominator
      let half = denominator / 2
      if remainder > half { quotient = quotient + 1 }
      else {
        if denominator % 2 == 0 and remainder == half and quotient % 2 == 1 {
          quotient = quotient + 1
        } else { 0 }
      }
      if quotient > max_quotient { RuntimeFloatRoundedResult(0, 0) }
      else { RuntimeFloatRoundedResult(quotient, 1) }
    }
  }
}

pub(package) fn runtime_float_decimal_ieee_bits_small(source: i64, start: i64, len: i64, fraction_bits: i64, bias: i64) -> RuntimeFloatBitsResult {
  let info = runtime_float_decimal_small_info(source, start, len)
  let number0 = runtime_float_decimal_info_number(info)
  let decimal_exponent = runtime_float_decimal_info_exponent(info)
  let ok = runtime_float_decimal_info_ok(info)
  if ok != 1 {
    RuntimeFloatBitsResult(0, 0)
  } else { if runtime_float_decimal_info_zero(info) == 1 {
    RuntimeFloatBitsResult(0, 1)
  } else {
    let power5 = runtime_float_i64_pow5_checked(if decimal_exponent >= 0 { decimal_exponent } else { 0 - decimal_exponent })
    if power5 < 0 {
      RuntimeFloatBitsResult(0, 0)
    } else {
      let number = if decimal_exponent >= 0 { runtime_float_i64_mul_checked(number0, power5) } else { number0 }
      if number < 0 {
        RuntimeFloatBitsResult(0, 0)
      } else {
        let denominator = if decimal_exponent >= 0 { 1 } else { power5 }
        let binary_shift = decimal_exponent
        let base = runtime_float_i64_pow2(fraction_bits)
        let max_exponent = bias * 2 + 1
        let mut exponent2 = runtime_float_decimal_binary_exponent_small(number, denominator, binary_shift)
        let mut exponent = exponent2 + bias
        if exponent <= 0 or exponent >= max_exponent {
          RuntimeFloatBitsResult(0, 0)
        } else {
          let shift = binary_shift + fraction_bits - exponent2
          let rounded = runtime_float_decimal_round_scaled_quotient_small(number, denominator, shift, base * 2)
          if runtime_float_rounded_ok(rounded) != 1 {
            RuntimeFloatBitsResult(0, 0)
          } else {
            let mut mantissa = runtime_float_rounded_value(rounded)
            if mantissa >= base * 2 {
              mantissa = mantissa / 2
              exponent2 = exponent2 + 1
              exponent = exponent2 + bias
            } else { 0 }
            if exponent <= 0 or exponent >= max_exponent {
              RuntimeFloatBitsResult(0, 0)
            } else {
              RuntimeFloatBitsResult(exponent * base + mantissa - base, 1)
            }
          }
        }
      }
    }
  } }
}

pub(package) fn runtime_float_decimal_ieee_bits_big(source: i64, start: i64, len: i64, fraction_bits: i64, bias: i64) -> RuntimeFloatBitsResult {
  let info = runtime_float_decimal_big_info(source, start, len)
  let number0 = runtime_float_decimal_info_number(info)
  let decimal_exponent = runtime_float_decimal_info_exponent(info)
  let ok = runtime_float_decimal_info_ok(info)
  if ok != 1 {
    RuntimeFloatBitsResult(0, 0)
  } else { if runtime_float_decimal_info_zero(info) == 1 {
    RuntimeFloatBitsResult(0, 1)
  } else {
    let base = runtime_float_i64_pow2(fraction_bits)
    let max_exponent = bias * 2 + 1
    let number = if decimal_exponent >= 0 {
      runtime_float_big_mul_pow5(number0, decimal_exponent)
    } else { number0 }
    let denominator = if decimal_exponent >= 0 {
      runtime_float_big_from_i64(1)
    } else {
      runtime_float_big_mul_pow5(runtime_float_big_from_i64(1), 0 - decimal_exponent)
    }
    let binary_shift = decimal_exponent
    let mut exponent2 = runtime_float_decimal_binary_exponent_big(number, denominator, binary_shift)
    let mut exponent = exponent2 + bias
    if exponent >= max_exponent {
      RuntimeFloatBitsResult(max_exponent * base, 1)
    } else {
      if exponent <= 0 {
        let subnormal_shift = binary_shift + fraction_bits + bias - 1
        let subnormal_mantissa = runtime_float_big_round_scaled_quotient(number, denominator, subnormal_shift, base)
        if subnormal_mantissa <= 0 {
          RuntimeFloatBitsResult(0, 1)
        } else {
          if subnormal_mantissa >= base {
            RuntimeFloatBitsResult(base, 1)
          } else {
            RuntimeFloatBitsResult(subnormal_mantissa, 1)
          }
        }
      } else {
        let shift = binary_shift + fraction_bits - exponent2
        let mut mantissa = runtime_float_big_round_scaled_quotient(number, denominator, shift, base * 2)
        if mantissa >= base * 2 {
          mantissa = mantissa / 2
          exponent2 = exponent2 + 1
          exponent = exponent2 + bias
        } else { 0 }
        if exponent >= max_exponent {
          RuntimeFloatBitsResult(max_exponent * base, 1)
        } else {
          RuntimeFloatBitsResult(exponent * base + mantissa - base, 1)
        }
      }
    }
  } }
}

pub(package) fn runtime_float_decimal_ieee_bits_raw(source: i64, start: i64, len: i64, fraction_bits: i64, bias: i64) -> RuntimeFloatBitsResult {
  let fast = runtime_float_decimal_ieee_bits_small(source, start, len, fraction_bits, bias)
  if runtime_float_bits_result_ok(fast) == 1 {
    fast
  } else {
    runtime_float_decimal_ieee_bits_big(source, start, len, fraction_bits, bias)
  }
}

-- Decimal conversion uses exact integer arithmetic and round-to-nearest,
-- ties-to-even. Its arbitrary-precision workspace is scoped to this call;
-- construct the surviving result only after restoring the bump pointer.
pub(package) fn runtime_float_decimal_ieee_bits(source: i64, start: i64, len: i64, fraction_bits: i64, bias: i64) -> RuntimeFloatBitsResult {
  let mark = alloc_bump_mark()
  let scratch_result = runtime_float_decimal_ieee_bits_raw(source, start, len, fraction_bits, bias)
  let bits = runtime_float_bits_result_bits(scratch_result)
  let ok = runtime_float_bits_result_ok(scratch_result)
  alloc_bump_restore_same_segment(mark)
  RuntimeFloatBitsResult(bits, ok)
}

pub(package) fn runtime_float_decimal_f64_bits(source: i64, start: i64, len: i64) -> RuntimeFloatBitsResult {
  runtime_float_decimal_ieee_bits(source, start, len, 52, 1023)
}

pub(package) fn runtime_float_decimal_f32_bits(source: i64, start: i64, len: i64) -> RuntimeFloatBitsResult {
  runtime_float_decimal_ieee_bits(source, start, len, 23, 127)
}

pub(package) fn runtime_float_i64_pow10(exponent: i64) -> i64 {
  let mut value = 1
  let mut i = 0
  while i < exponent {
    value = value * 10
    i = i + 1
  }
  value
}

pub(package) fn runtime_float_big_pow5(exponent: i64) -> i64 {
  runtime_float_big_mul_pow5(runtime_float_big_from_i64(1), exponent)
}

-- Compare mantissa * 2^binary_exponent with 10^decimal_exponent exactly.
pub(package) fn runtime_float_binary_cmp_pow10(mantissa: i64, binary_exponent: i64, decimal_exponent: i64) -> i64 {
  if decimal_exponent >= 0 {
    let left0 = runtime_float_big_from_i64(mantissa)
    let right0 = runtime_float_big_pow5(decimal_exponent)
    let min_shift = if binary_exponent < decimal_exponent { binary_exponent } else { decimal_exponent }
    let left = runtime_float_big_shl(left0, binary_exponent - min_shift)
    let right = runtime_float_big_shl(right0, decimal_exponent - min_shift)
    runtime_float_big_cmp(left, right)
  } else {
    let power = 0 - decimal_exponent
    let left0 = runtime_float_big_mul_pow5(runtime_float_big_from_i64(mantissa), power)
    let right0 = runtime_float_big_from_i64(1)
    let left_shift = binary_exponent + power
    let min_shift = if left_shift < 0 { left_shift } else { 0 }
    let left = runtime_float_big_shl(left0, left_shift - min_shift)
    let right = runtime_float_big_shl(right0, 0 - min_shift)
    runtime_float_big_cmp(left, right)
  }
}

pub(package) fn runtime_float_floor_div(value: i64, divisor: i64) -> i64 {
  if value >= 0 { value / divisor }
  else { 0 - ((0 - value + divisor - 1) / divisor) }
}

pub(package) fn runtime_float_decimal_exponent(mantissa: i64, binary_exponent: i64) -> i64 {
  let top_binary_exponent = runtime_float_i64_bit_length(mantissa) - 1 + binary_exponent
  let mut exponent = runtime_float_floor_div(top_binary_exponent * 30103, 100000)
  while runtime_float_binary_cmp_pow10(mantissa, binary_exponent, exponent + 1) >= 0 {
    exponent = exponent + 1
  }
  while runtime_float_binary_cmp_pow10(mantissa, binary_exponent, exponent) < 0 {
    exponent = exponent - 1
  }
  exponent
}

pub(package) fn runtime_float_round_decimal_significand(mantissa: i64, binary_exponent: i64, scale: i64, max_quotient: i64) -> i64 {
  if scale >= 0 {
    let numerator = runtime_float_big_from_i64(mantissa)
    let denominator = runtime_float_big_pow5(scale)
    runtime_float_big_round_scaled_quotient(numerator, denominator, binary_exponent - scale, max_quotient)
  } else {
    let power = 0 - scale
    let numerator = runtime_float_big_mul_pow5(runtime_float_big_from_i64(mantissa), power)
    let denominator = runtime_float_big_from_i64(1)
    runtime_float_big_round_scaled_quotient(numerator, denominator, binary_exponent + power, max_quotient)
  }
}

pub(package) fn runtime_float_zeroes(count0: i64) -> str {
  let count = if count0 < 0 { 0 } else { count0 }
  let out = runtime_str_alloc_uninit(count)
  let data = runtime_str_ptr(out)
  let mut i = 0
  while i < count {
    runtime_str_builder_set_byte(data, count, i, 48)
    i = i + 1
  }
  out
}

pub(package) fn runtime_float_render_decimal(significand0: i64, scale0: i64) -> str {
  let mut significand = significand0
  let mut scale = scale0
  while significand >= 10 and significand % 10 == 0 {
    significand = significand / 10
    scale = scale + 1
  }
  let digits = runtime_int_to_str(significand)
  let digit_count = runtime_str_len(digits)
  let scientific_exponent = scale + digit_count - 1
  if scientific_exponent >= 0 - 6 and scientific_exponent < 21 {
    if scale >= 0 {
      runtime_str_concat(digits, runtime_float_zeroes(scale))
    } else {
      let point = digit_count + scale
      if point > 0 {
        let left = runtime_str_slice_bytes(digits, 0, point)
        let right = runtime_str_slice_bytes(digits, point, digit_count - point)
        runtime_str_concat(runtime_str_concat(left, "."), right)
      } else {
        runtime_str_concat(runtime_str_concat("0.", runtime_float_zeroes(0 - point)), digits)
      }
    }
  } else {
    let exponent = runtime_int_to_str(scientific_exponent)
    if digit_count == 1 {
      runtime_str_concat(runtime_str_concat(digits, "e"), exponent)
    } else {
      let first = runtime_str_slice_bytes(digits, 0, 1)
      let rest = runtime_str_slice_bytes(digits, 1, digit_count - 1)
      runtime_str_concat(runtime_str_concat(runtime_str_concat(runtime_str_concat(first, "."), rest), "e"), exponent)
    }
  }
}

pub(package) fn runtime_float_decimal_parts_ieee_bits(significand: i64, decimal_exponent: i64, fraction_bits: i64, bias: i64) -> i64 {
  let base = runtime_float_i64_pow2(fraction_bits)
  let max_exponent = bias * 2 + 1
  let number0 = runtime_float_big_from_i64(significand)
  let number = if decimal_exponent >= 0 {
    runtime_float_big_mul_pow5(number0, decimal_exponent)
  } else { number0 }
  let denominator = if decimal_exponent >= 0 {
    runtime_float_big_from_i64(1)
  } else {
    runtime_float_big_pow5(0 - decimal_exponent)
  }
  let binary_shift = decimal_exponent
  let mut exponent2 = runtime_float_decimal_binary_exponent_big(number, denominator, binary_shift)
  let mut exponent = exponent2 + bias
  if exponent >= max_exponent {
    max_exponent * base
  } else { if exponent <= 0 {
    let subnormal_shift = binary_shift + fraction_bits + bias - 1
    let subnormal_mantissa = runtime_float_big_round_scaled_quotient(number, denominator, subnormal_shift, base)
    if subnormal_mantissa <= 0 { 0 }
    else { if subnormal_mantissa >= base { base } else { subnormal_mantissa } }
  } else {
    let shift = binary_shift + fraction_bits - exponent2
    let mut rounded = runtime_float_big_round_scaled_quotient(number, denominator, shift, base * 2)
    if rounded >= base * 2 {
      rounded = rounded / 2
      exponent2 = exponent2 + 1
      exponent = exponent2 + bias
    } else { 0 }
    if exponent >= max_exponent { max_exponent * base }
    else { exponent * base + rounded - base }
  } }
}

pub(package) fn runtime_float_shortest_finite(mantissa: i64, binary_exponent: i64, expected_bits: i64, fraction_bits: i64, bias: i64, max_digits: i64) -> str {
  let mark = alloc_bump_mark()
  let decimal_exponent = runtime_float_decimal_exponent(mantissa, binary_exponent)
  let mut digits = 1
  let mut found = 0
  let mut result_significand = 0
  let mut result_scale = 0
  while digits <= max_digits and found == 0 {
    let scale0 = decimal_exponent - digits + 1
    let limit = runtime_float_i64_pow10(digits)
    let mut significand = runtime_float_round_decimal_significand(mantissa, binary_exponent, scale0, limit)
    let mut scale = scale0
    if significand >= limit {
      significand = significand / 10
      scale = scale + 1
    } else { 0 }
    let candidate_bits = runtime_float_decimal_parts_ieee_bits(significand, scale, fraction_bits, bias)
    if candidate_bits == expected_bits {
      result_significand = significand
      result_scale = scale
      found = 1
    } else {
      digits = digits + 1
    }
  }
  alloc_bump_restore_same_segment(mark)
  runtime_float_render_decimal(result_significand, result_scale)
}

pub(package) fn runtime_float_with_sign(value: str, negative: i64) -> str {
  if negative == 1 { runtime_str_concat("-", value) } else { value }
}

pub(package) fn runtime_f64_to_shortest(value: f64) -> str {
  let word = runtime_f64_to_bits(value)
  let negative = if word >= 9223372036854775808 { 1 } else { 0 }
  let magnitude_word = word band 9223372036854775807
  let magnitude = __u64_to_i64(magnitude_word)
  let exponent = magnitude / 4503599627370496
  let fraction = magnitude % 4503599627370496
  if exponent == 2047 {
    if fraction == 0 { runtime_float_with_sign("inf", negative) } else { "NaN" }
  } else { if magnitude == 0 {
    runtime_float_with_sign("0", negative)
  } else {
    let mantissa = if exponent == 0 { fraction } else { 4503599627370496 + fraction }
    let binary_exponent = if exponent == 0 { 0 - 1074 } else { exponent - 1023 - 52 }
    let rendered = runtime_float_shortest_finite(mantissa, binary_exponent, magnitude, 52, 1023, 17)
    runtime_float_with_sign(rendered, negative)
  } }
}

pub(package) fn runtime_f32_to_shortest(value: f32) -> str {
  let word0 = runtime_f32_to_bits(value)
  let word = __u64_to_i64(__u32_to_u64(word0))
  let negative = if word >= 2147483648 { 1 } else { 0 }
  let magnitude = word % 2147483648
  let exponent = magnitude / 8388608
  let fraction = magnitude % 8388608
  if exponent == 255 {
    if fraction == 0 { runtime_float_with_sign("inf", negative) } else { "NaN" }
  } else { if magnitude == 0 {
    runtime_float_with_sign("0", negative)
  } else {
    let mantissa = if exponent == 0 { fraction } else { 8388608 + fraction }
    let binary_exponent = if exponent == 0 { 0 - 149 } else { exponent - 127 - 23 }
    let rendered = runtime_float_shortest_finite(mantissa, binary_exponent, magnitude, 23, 127, 9)
    runtime_float_with_sign(rendered, negative)
  } }
}
