pub(package) fn runtime_par_worker_enter_runtime_raw(worker: i64) -[Unsafe]> i64 {
  __set_runtime_state(runtime_par_worker_runtime_state(worker))
  __set_handler_stack(runtime_par_worker_handler_stack(worker))
  0
}

pub(package) fn runtime_par_worker_at(workers: i64, index: i64) -> i64 {
  runtime_par_word_array_get(workers, index)
}

pub(package) fn runtime_par_worker_steal_task_raw(worker: i64) -[Unsafe]> i64 {
  let pool = runtime_par_worker_pool(worker)
  let workers = runtime_par_pool_workers(pool)
  let total = runtime_par_pool_worker_count_value(pool)
  let self_id = runtime_par_worker_id(worker)
  let mut step = 1
  let mut task = runtime_par_queue_empty_value()
  while step < total {
    if task < 0 {
      let raw_victim_id = self_id + step
      let victim_id = if raw_victim_id >= total { raw_victim_id - total } else { raw_victim_id }
      let victim = runtime_par_worker_at(workers, victim_id)
      if victim != 0 {
        task = runtime_par_deque_steal_top_raw(runtime_par_worker_local_queue(victim))
      } else {
        0
      }
    } else {
      step = total
    }
    step = step + 1
  }
  task
}

pub(package) fn runtime_par_worker_pop_task_raw(worker: i64) -[Unsafe]> i64 {
  let local_task = runtime_par_deque_pop_bottom_raw(runtime_par_worker_local_queue(worker))
  if local_task >= 0 {
    local_task
  } else {
    let shared_task = runtime_par_queue_pop_raw(runtime_par_worker_shared_queue(worker))
    if shared_task >= 0 {
      shared_task
    } else {
      runtime_par_worker_steal_task_raw(worker)
    }
  }
}

pub(package) fn runtime_par_worker_steal_task(worker: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_worker_steal_task_raw(worker))
  }
}

pub(package) fn runtime_par_worker_pop_task(worker: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_worker_pop_task_raw(worker))
  }
}
