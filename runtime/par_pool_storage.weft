  __mem_load64(pool + runtime_par_pool_shutdown_offset())
}

pub(package) fn runtime_par_pool_control_mutex(pool: i64) -> i64 {
  __mem_load64(pool + runtime_par_pool_control_mutex_offset())
}

pub(package) fn runtime_par_pool_control_cond(pool: i64) -> i64 {
  __mem_load64(pool + runtime_par_pool_control_cond_offset())
