-- runtime/par_pool_storage.weft -- trusted Par pool/worker storage

use runtime/alloc.{*}
use runtime/par_queue.{*}
use runtime/par_sync.{*}
use runtime/par_task.{*}
use runtime/unsafe.{*}

pub(package) fn runtime_par_word_array_new(count: i64) -> i64 {
  let n = if count <= 0 { 1 } else { count }
  alloc_bump(n * 8)
}

pub(package) fn runtime_par_word_array_get(array: i64, index: i64) -> i64 {
  __mem_load64(array + index * 8)
}

pub(package) fn runtime_par_word_array_set(array: i64, index: i64, value: i64) -> i64 {
  __mem_store64(array + index * 8, value)
  value
}

-- Generic par_map indexes slices with usize. Keep the narrowing and address
-- arithmetic inside the trusted storage bridge; a realizable allocation
-- cannot exceed the signed address space on the supported 64-bit targets.
pub(package) fn runtime_par_map_count_i64(count: usize) -> i64 {
  __u64_to_i64(__usize_to_u64(count))
}

pub(package) fn runtime_par_map_slots_new(count: usize) -> i64 {
  runtime_par_word_array_new(runtime_par_map_count_i64(count))
}

pub(package) fn runtime_par_map_slots_get(slots: i64, index: usize) -> i64 {
  runtime_par_word_array_get(slots, runtime_par_map_count_i64(index))
}

pub(package) fn runtime_par_map_slots_set(slots: i64, index: usize, value: i64) -> i64 {
  runtime_par_word_array_set(slots, runtime_par_map_count_i64(index), value)
}

pub(package) fn runtime_par_pool_queue_offset() -> i64 { 0 }
pub(package) fn runtime_par_pool_count_offset() -> i64 { 8 }
pub(package) fn runtime_par_pool_items_offset() -> i64 { 16 }
pub(package) fn runtime_par_pool_results_offset() -> i64 { 24 }
pub(package) fn runtime_par_pool_reserved_offset() -> i64 { 32 }
pub(package) fn runtime_par_pool_workers_offset() -> i64 { 40 }
pub(package) fn runtime_par_pool_worker_count_offset() -> i64 { 48 }
pub(package) fn runtime_par_pool_shutdown_offset() -> i64 { 56 }
pub(package) fn runtime_par_pool_submit_cursor_offset() -> i64 { 64 }
pub(package) fn runtime_par_pool_control_mutex_offset() -> i64 { 72 }
pub(package) fn runtime_par_pool_control_cond_offset() -> i64 { 80 }
pub(package) fn runtime_par_pool_pending_count_offset() -> i64 { 88 }
pub(package) fn runtime_par_pool_handles_offset() -> i64 { 96 }
pub(package) fn runtime_par_pool_spawned_count_offset() -> i64 { 104 }
pub(package) fn runtime_par_pool_local_queues_offset() -> i64 { 112 }
pub(package) fn runtime_par_pool_task_scope_offset() -> i64 { 120 }
pub(package) fn runtime_par_pool_state_size() -> i64 { 128 }

pub(package) fn runtime_par_worker_id_offset() -> i64 { 0 }
pub(package) fn runtime_par_worker_pool_offset() -> i64 { 8 }
pub(package) fn runtime_par_worker_local_queue_offset() -> i64 { 16 }
pub(package) fn runtime_par_worker_shared_queue_offset() -> i64 { 24 }
pub(package) fn runtime_par_worker_count_offset() -> i64 { 32 }
pub(package) fn runtime_par_worker_runtime_state_offset() -> i64 { 40 }
pub(package) fn runtime_par_worker_handler_stack_offset() -> i64 { 48 }
pub(package) fn runtime_par_worker_size() -> i64 { 56 }

pub(package) fn runtime_par_current_runtime_state() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

pub(package) fn runtime_par_pool_state_new(queue: i64, count: i64, items: i64) -> i64 {
  let state = alloc_bump(runtime_par_pool_state_size())
  __mem_store64(state + runtime_par_pool_queue_offset(), queue)
  __mem_store64(state + runtime_par_pool_count_offset(), count)
  __mem_store64(state + runtime_par_pool_items_offset(), items)
  __mem_store64(state + runtime_par_pool_results_offset(), 0)
  __mem_store64(state + runtime_par_pool_reserved_offset(), 0)
  __mem_store64(state + runtime_par_pool_shutdown_offset(), 0)
  __mem_store64(state + runtime_par_pool_submit_cursor_offset(), 0)
  __mem_store64(state + runtime_par_pool_control_mutex_offset(), runtime_par_pthread_mutex_new())
  __mem_store64(state + runtime_par_pool_control_cond_offset(), runtime_par_pthread_cond_new())
  __mem_store64(state + runtime_par_pool_pending_count_offset(), 0)
  __mem_store64(state + runtime_par_pool_task_scope_offset(), runtime_par_task_scope_new())
  state
}

pub(package) fn runtime_par_pool_install_worker_arrays(state: i64, workers: i64, worker_count: i64, handles: i64, local_queues: i64) -> i64 {
  __mem_store64(state + runtime_par_pool_workers_offset(), workers)
  __mem_store64(state + runtime_par_pool_worker_count_offset(), worker_count)
  __mem_store64(state + runtime_par_pool_handles_offset(), handles)
  __mem_store64(state + runtime_par_pool_spawned_count_offset(), 0)
  __mem_store64(state + runtime_par_pool_local_queues_offset(), local_queues)
  state
}

pub(package) fn runtime_par_pool_workers(pool: i64) -> i64 {
  __mem_load64(pool + runtime_par_pool_workers_offset())
}

pub(package) fn runtime_par_pool_worker_count_value(pool: i64) -> i64 {
  __mem_load64(pool + runtime_par_pool_worker_count_offset())
}

pub(package) fn runtime_par_pool_queue(pool: i64) -> i64 {
  __mem_load64(pool + runtime_par_pool_queue_offset())
}

