pub(package) fn runtime_par_pool_task_new_raw(pool: i64, f: (i64) -> i64, arg: i64) -[Unsafe]> i64 {
  let mutex = runtime_par_pool_control_mutex(pool)
  runtime_par_pthread_mutex_lock_raw(mutex)
  let task = runtime_par_task_new(f, arg)
  runtime_par_task_scope_track(runtime_par_pool_task_scope(pool), task)
  runtime_par_pthread_mutex_unlock_raw(mutex)
  task
}

pub(package) fn runtime_par_pool_task_new(pool: i64, f: (i64) -> i64, arg: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pool_task_new_raw(pool, f, arg))
  }
}

pub(package) fn runtime_par_pool_task_scope_cleanup(pool: i64) -> i64 {
  runtime_par_task_scope_cleanup(runtime_par_pool_task_scope(pool))
}

pub(package) fn runtime_par_pool_record_spawned_count(pool: i64, spawned: i64) -> i64 {
  __mem_store64(pool + runtime_par_pool_spawned_count_offset(), spawned)
  spawned
}

pub(package) fn runtime_par_pool_pending_add_raw(pool: i64, delta: i64) -[Unsafe]> i64 {
  let mutex = runtime_par_pool_control_mutex(pool)
  runtime_par_pthread_mutex_lock_raw(mutex)
  let next = runtime_par_pool_pending_count(pool) + delta
  __mem_store64(pool + runtime_par_pool_pending_count_offset(), next)
  runtime_par_pthread_mutex_unlock_raw(mutex)
  next
}

pub(package) fn runtime_par_pool_pending_add(pool: i64, delta: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pool_pending_add_raw(pool, delta))
  }
}

pub(package) fn runtime_par_pool_signal_work_raw(pool: i64) -[Unsafe]> i64 {
  runtime_par_pthread_cond_signal_raw(runtime_par_pool_control_cond(pool))
}

pub(package) fn runtime_par_pool_signal_work(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pool_signal_work_raw(pool))
  }
}

pub(package) fn runtime_par_pool_request_shutdown_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = runtime_par_pool_control_mutex(pool)
  runtime_par_pthread_mutex_lock_raw(mutex)
  __mem_store64(pool + runtime_par_pool_shutdown_offset(), 1)
  runtime_par_pthread_cond_broadcast_raw(runtime_par_pool_control_cond(pool))
  runtime_par_pthread_mutex_unlock_raw(mutex)
  0
}

pub(package) fn runtime_par_pool_request_shutdown(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pool_request_shutdown_raw(pool))
  }
}

pub(package) fn runtime_par_pool_wait_for_work_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = runtime_par_pool_control_mutex(pool)
  runtime_par_pthread_mutex_lock_raw(mutex)
  let mut waiting = 1
  let mut should_stop = 0
  while waiting == 1 {
    if runtime_par_pool_pending_count(pool) > 0 {
      waiting = 0
    } else {
      if runtime_par_pool_shutdown_requested(pool) != 0 {
        should_stop = 1
        waiting = 0
      } else {
        runtime_par_pthread_cond_wait_raw(runtime_par_pool_control_cond(pool), mutex)
      }
    }
  }
  runtime_par_pthread_mutex_unlock_raw(mutex)
  should_stop
}

pub(package) fn runtime_par_pool_take_submit_cursor_raw(pool: i64) -[Unsafe]> i64 {
  let mutex = runtime_par_pool_control_mutex(pool)
  runtime_par_pthread_mutex_lock_raw(mutex)
  let worker_count = runtime_par_pool_worker_count_value(pool)
  let current = __mem_load64(pool + runtime_par_pool_submit_cursor_offset())
  if worker_count > 0 {
    __mem_store64(pool + runtime_par_pool_submit_cursor_offset(), runtime_par_queue_next(current, worker_count))
  } else { 0 }
  runtime_par_pthread_mutex_unlock_raw(mutex)
  current
}

pub(package) fn runtime_par_pool_take_submit_cursor(pool: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pool_take_submit_cursor_raw(pool))
  }
}

pub(package) fn runtime_par_worker_new(worker_id: i64, pool: i64, local_queue: i64, shared_queue: i64, worker_count: i64) -> i64 {
  let worker = alloc_bump(runtime_par_worker_size())
  __mem_store64(worker + runtime_par_worker_id_offset(), worker_id)
  __mem_store64(worker + runtime_par_worker_pool_offset(), pool)
  __mem_store64(worker + runtime_par_worker_local_queue_offset(), local_queue)
  __mem_store64(worker + runtime_par_worker_shared_queue_offset(), shared_queue)
  __mem_store64(worker + runtime_par_worker_count_offset(), worker_count)
  __mem_store64(worker + runtime_par_worker_runtime_state_offset(), runtime_par_current_runtime_state())
  __mem_store64(worker + runtime_par_worker_handler_stack_offset(), 0)
  worker
}

