-- runtime/tcp_listener_io.weft — production TCP listener operations

use runtime/tcp.{runtime_tcp_accept_safe, runtime_tcp_listener_local_address_safe, runtime_tcp_listener_release_safe}
use stdlib/tcp.{TcpListenerIO}

--- Interpret operations on owned TCP listeners through the target platform.
pub implements TcpListenerIO() {
  TcpListenerIO.accept(listener) -> resume(runtime_tcp_accept_safe(listener))
  TcpListenerIO.local_address(listener) -> resume(runtime_tcp_listener_local_address_safe(listener))
  TcpListenerIO.release(listener) -> resume(runtime_tcp_listener_release_safe(listener))
}
