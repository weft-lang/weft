-- Trusted helper surface for test/unsafe_boundary.weft.
-- Ordinary test sources should call these helpers rather than handling Unsafe
-- or touching raw memory directly.

use runtime/unsafe.{*}
use stdlib/thread.{*}

pub(package) fn unsafe_boundary_raw_memory_read_write() -> i64 {
  let p = __bump_alloc(8)
  __mem_store64(p, 9)
  __mem_load64(p)
}

pub(package) fn unsafe_boundary_write_empty() -> i64 {
  handle unsafe_raw_syscall(4, 1, __str_ptr(""), 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(__syscall(num, a0, a1, a2, a3, a4, a5))
  }
}

pub(package) fn unsafe_boundary_mocked_raw_syscall() -> i64 {
  handle unsafe_raw_syscall(4, 1, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(num + a0)
  }
}

pub(package) fn unsafe_boundary_int_to_mut_i64_ptr(addr: i64) -> *mut i64 {
  handle unsafe_int_to_ptr<i64>(addr) {
    Unsafe.int_to_ptr(raw) -> resume(__int_to_ptr(raw))
  }
}

pub(package) fn unsafe_boundary_raw_offset_i64(ptr: *i64, offset: i64) -> *i64 {
  handle unsafe_raw_offset<i64>(ptr, offset) {
    Unsafe.raw_offset(raw, off) -> resume(__raw_offset(raw, off))
  }
}

pub(package) fn unsafe_boundary_raw_offset_mut_i64(ptr: *mut i64, offset: i64) -> *mut i64 {
  handle unsafe_raw_offset_mut<i64>(ptr, offset) {
    Unsafe.raw_offset(raw, off) -> resume(__raw_offset(raw, off))
  }
}

pub(package) fn unsafe_boundary_transmute_i64_to_mut_i64_ptr(value: i64) -> *mut i64 {
  handle unsafe_transmute<i64, *mut i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn unsafe_boundary_transmute_mut_i64_ptr_to_i64(ptr: *mut i64) -> i64 {
  handle unsafe_transmute<*mut i64, i64>(ptr) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn unsafe_boundary_ptr_store_i64(ptr: *mut i64, value: i64) -[Unsafe]> i64 {
  ptr.* = value
  0
}

pub(package) fn unsafe_boundary_ptr_load_i64(ptr: *i64) -[Unsafe]> i64 {
  ptr.*
}

pub(package) fn unsafe_boundary_trusted_ptr_store_i64(ptr: *mut i64, value: i64) -> i64 {
  handle unsafe_boundary_ptr_store_i64(ptr, value) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

pub(package) fn unsafe_boundary_trusted_ptr_load_i64(ptr: *i64) -> i64 {
  handle unsafe_boundary_ptr_load_i64(ptr) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(0)
  }
}

pub(package) fn unsafe_boundary_raw_offset_base_value() -> i64 {
  let p = unsafe_boundary_int_to_mut_i64_ptr(__bump_alloc(16))
  unsafe_boundary_trusted_ptr_store_i64(p, 7)
  let q = unsafe_boundary_raw_offset_mut_i64(p, 8)
  unsafe_boundary_trusted_ptr_store_i64(q, 42)
  unsafe_boundary_trusted_ptr_load_i64(p)
}

pub(package) fn unsafe_boundary_raw_offset_next_value() -> i64 {
  let p = unsafe_boundary_int_to_mut_i64_ptr(__bump_alloc(16))
  unsafe_boundary_trusted_ptr_store_i64(p, 7)
  let q = unsafe_boundary_raw_offset_mut_i64(p, 8)
  unsafe_boundary_trusted_ptr_store_i64(q, 42)
  unsafe_boundary_trusted_ptr_load_i64(q)
}

pub(package) fn unsafe_boundary_raw_offset_preserves_immutable_pointer() -> i64 {
  let p = unsafe_boundary_int_to_mut_i64_ptr(__bump_alloc(16))
  unsafe_boundary_trusted_ptr_store_i64(p, 13)
  let q = unsafe_boundary_raw_offset_mut_i64(p, 8)
  unsafe_boundary_trusted_ptr_store_i64(q, 21)
  let read = unsafe_boundary_raw_offset_i64(p, 8)
  unsafe_boundary_trusted_ptr_load_i64(read)
}

pub(package) fn unsafe_boundary_transmute_back_matches() -> i64 {
  let base = __bump_alloc(8)
  let p = unsafe_boundary_transmute_i64_to_mut_i64_ptr(base)
  if unsafe_boundary_transmute_mut_i64_ptr_to_i64(p) == base { 1 } else { 0 }
}

pub(package) fn unsafe_boundary_transmute_store_value() -> i64 {
  let base = __bump_alloc(8)
  let p = unsafe_boundary_transmute_i64_to_mut_i64_ptr(base)
  unsafe_boundary_trusted_ptr_store_i64(p, 33)
  __mem_load64(base)
}

pub(package) fn unsafe_boundary_int_to_ptr_value() -> i64 {
  let p = unsafe_boundary_int_to_mut_i64_ptr(__bump_alloc(8))
  unsafe_boundary_trusted_ptr_store_i64(p, 51)
  unsafe_boundary_trusted_ptr_load_i64(p)
}

pub(package) fn unsafe_boundary_runtime_state_nonzero() -> i64 {
  let got = handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
  if got != 0 { 1 } else { 0 }
}

pub(package) fn unsafe_boundary_call_target(x: i64) -> i64 { x + 1 }

pub(package) fn unsafe_boundary_raw_call_i64_value() -> i64 {
  handle unsafe_raw_call_i64(fn_addr(unsafe_boundary_call_target), 41) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
}
