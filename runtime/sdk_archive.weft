-- runtime/sdk_archive.weft — sealed lookup for the compiler's embedded SDK
--
-- The archive is immutable native-image data. Numeric fields are little-endian
-- i64 values because this is an internal, versioned persistence boundary; the
-- ordinary compiler surface consumes the typed lookup alternatives below.

use runtime/alloc.{alloc_zeroed}
use runtime/memory.{mem_load8_at, mem_load64_at, mem_store8_at}
use runtime/provenance.{runtime_native_provenance_table}
use runtime/string.{runtime_str_from_bytes_copy}

pub(package) type SdkArchiveLookup {
  SdkArchiveFound(i64, i64),
  SdkArchiveMissing,
  SdkArchiveMalformed
}

pub(package) type EmbeddedSdkArchive {
  EmbeddedSdkArchivePresent(i64, i64, str),
  EmbeddedSdkArchiveAbsent
}

pub(package) fn sdk_archive_header_size() -> i64 { 96 }
pub(package) fn sdk_archive_entry_size() -> i64 { 32 }
pub(package) fn sdk_archive_version() -> i64 { 1 }

fn sdk_archive_magic_matches(archive: i64) -> bool {
  let magic = "WEFTSDK1"
  let mut index = 0
  let mut matches = true
  while index < 8 and matches {
    if mem_load8_at(archive, index) != mem_load8_at(__str_ptr(magic), index) {
      matches = false
    } else { index = index + 1 }
  }
  matches
}

fn sdk_archive_range_is_valid(offset: i64, len: i64, first_data: i64, total: i64) -> bool {
  offset >= first_data and offset <= total and len >= 0 and len <= total - offset
}

fn sdk_archive_bytes_compare(a: i64, a_len: i64, b: i64, b_len: i64) -> i64 {
  let common = if a_len < b_len { a_len } else { b_len }
  let mut index = 0
  let mut order = 0
  while index < common and order == 0 {
    let left = mem_load8_at(a, index)
    let right = mem_load8_at(b, index)
    if left < right { order = 0 - 1 }
    else { if left > right { order = 1 } else { index = index + 1 } }
  }
  if order != 0 { order }
  else { if a_len < b_len { 0 - 1 } else { if a_len > b_len { 1 } else { 0 } } }
}

fn sdk_archive_path_is_canonical(path: i64, len: i64) -> bool {
  if len <= 0 or mem_load8_at(path, 0) == 47 or mem_load8_at(path, len - 1) == 47 { false }
  else {
    let mut index = 0
    let mut segment_start = 0
    let mut valid = true
    while index <= len and valid {
      if index == len or mem_load8_at(path, index) == 47 {
        let segment_len = index - segment_start
        if segment_len == 0 or
          (segment_len == 1 and mem_load8_at(path, segment_start) == 46) or
          (segment_len == 2 and mem_load8_at(path, segment_start) == 46 and mem_load8_at(path, segment_start + 1) == 46) {
          valid = false
        } else { segment_start = index + 1 }
      } else { if mem_load8_at(path, index) == 0 { valid = false } else { 0 } }
      index = index + 1
    }
    valid
  }
}

fn sdk_archive_entry(archive: i64, index: i64) -> i64 {
  archive + sdk_archive_header_size() + index * sdk_archive_entry_size()
}

fn sdk_archive_is_valid(archive: i64, archive_len: i64) -> bool {
  if archive == 0 or archive_len < sdk_archive_header_size() or sdk_archive_magic_matches(archive) == false { false }
  else {
    let version = mem_load64_at(archive, 8)
    let count = mem_load64_at(archive, 16)
    let entry_size = mem_load64_at(archive, 24)
    let total = mem_load64_at(archive, 32)
    let index_offset = mem_load64_at(archive, 40)
    if version != sdk_archive_version() or entry_size != sdk_archive_entry_size() or
      total != archive_len or index_offset != sdk_archive_header_size() or
      count < 0 or count > (total - sdk_archive_header_size()) / sdk_archive_entry_size() {
      false
    } else {
      let first_data = sdk_archive_header_size() + count * sdk_archive_entry_size()
      let mut index = 0
      let mut previous_path = 0
      let mut previous_len = 0
      let mut valid = true
      while index < count and valid {
        let entry = sdk_archive_entry(archive, index)
        let path_offset = mem_load64_at(entry, 0)
        let path_len = mem_load64_at(entry, 8)
        let data_offset = mem_load64_at(entry, 16)
        let data_len = mem_load64_at(entry, 24)
        if sdk_archive_range_is_valid(path_offset, path_len, first_data, total) == false or
          sdk_archive_range_is_valid(data_offset, data_len, first_data, total) == false or
          sdk_archive_path_is_canonical(archive + path_offset, path_len) == false {
          valid = false
        } else { if index > 0 and sdk_archive_bytes_compare(previous_path, previous_len, archive + path_offset, path_len) >= 0 {
          valid = false
        } else {
          previous_path = archive + path_offset
          previous_len = path_len
          index = index + 1
        } }
      }
      valid
    }
  }
}

pub(package) fn sdk_archive_lookup(archive: i64, archive_len: i64, path: i64, path_len: i64) -> SdkArchiveLookup {
  if sdk_archive_is_valid(archive, archive_len) == false or sdk_archive_path_is_canonical(path, path_len) == false {
    SdkArchiveMalformed
  } else {
    let mut lower = 0
    let mut upper = mem_load64_at(archive, 16)
    let mut found = 0
    while lower < upper and found == 0 {
      let middle = lower + (upper - lower) / 2
      let entry = sdk_archive_entry(archive, middle)
      let entry_path = archive + mem_load64_at(entry, 0)
      let entry_path_len = mem_load64_at(entry, 8)
      let order = sdk_archive_bytes_compare(path, path_len, entry_path, entry_path_len)
      if order < 0 { upper = middle }
      else { if order > 0 { lower = middle + 1 } else { found = entry } }
    }
    if found == 0 { SdkArchiveMissing }
    else { SdkArchiveFound(archive + mem_load64_at(found, 16), mem_load64_at(found, 24)) }
  }
}

fn sdk_archive_hex_digit(value: i64) -> i64 {
  if value < 10 { 48 + value } else { 87 + value }
}

pub(package) fn sdk_archive_digest(archive: i64, archive_len: i64) -> str {
  if sdk_archive_is_valid(archive, archive_len) == false { "" }
  else {
    let result = alloc_zeroed(71)
    let prefix = "sha256:"
    for index in 0..7 { mem_store8_at(result, index, mem_load8_at(__str_ptr(prefix), index)) }
    for index in 0..32 {
      let byte = mem_load8_at(archive, 64 + index)
      mem_store8_at(result, 7 + index * 2, sdk_archive_hex_digit(byte / 16))
      mem_store8_at(result, 8 + index * 2, sdk_archive_hex_digit(byte - byte / 16 * 16))
    }
    runtime_str_from_bytes_copy(result, 71)
  }
}

-- The compiler appends its archive directly after the complete provenance
-- table. The table's own versioned size is the sole image-relative locator;
-- ordinary programs never receive this pointer-shaped representation.
pub(package) fn sdk_archive_embedded() -> EmbeddedSdkArchive {
  let provenance = runtime_native_provenance_table()
  if provenance == 0 { EmbeddedSdkArchiveAbsent }
  else {
    let archive = provenance + mem_load64_at(provenance, 56)
    if sdk_archive_magic_matches(archive) == false { EmbeddedSdkArchiveAbsent }
    else {
      let archive_len = mem_load64_at(archive, 32)
      let digest = sdk_archive_digest(archive, archive_len)
      if __str_len(digest) == 0 { EmbeddedSdkArchiveAbsent }
      else { EmbeddedSdkArchivePresent(archive, archive_len, digest) }
    }
  }
}
