-- runtime/unsafe.weft -- sealed typed boundary for unsafe operations
--
-- Unsafe is an internal runtime/platform capability. Trusted runtime modules
-- may perform and handle this effect to expose safe, effect-honest APIs.
-- Ordinary source may name the Unsafe effect, but cannot call these helpers or
-- discharge the effect.

pub(package) effect Unsafe {
  fn raw_offset(ptr: any, offset: i64) -> any
  fn transmute(value: any) -> any
  fn raw_syscall(num: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
  fn int_to_ptr(addr: i64) -> any
  fn runtime_state() -> i64
  fn raw_call_i64(fn_ptr: i64, arg: i64) -> i64
}

pub(package) fn unsafe_raw_offset<T>(ptr: *T, offset: i64) -[Unsafe]> *T {
  Unsafe.raw_offset(ptr, offset)
}

pub(package) fn unsafe_raw_offset_mut<T>(ptr: *mut T, offset: i64) -[Unsafe]> *mut T {
  Unsafe.raw_offset(ptr, offset)
}

pub(package) fn unsafe_transmute<T, U>(value: T) -[Unsafe]> U {
  Unsafe.transmute(value)
}

pub(package) fn unsafe_raw_syscall(num: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -[Unsafe]> i64 {
  Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5)
}

pub(package) fn unsafe_int_to_ptr<T>(addr: i64) -[Unsafe]> *mut T {
  Unsafe.int_to_ptr(addr)
}

pub(package) fn unsafe_runtime_state() -[Unsafe]> i64 {
  Unsafe.runtime_state()
}

pub(package) fn unsafe_raw_call_i64(fn_ptr: i64, arg: i64) -[Unsafe]> i64 {
  Unsafe.raw_call_i64(fn_ptr, arg)
}
