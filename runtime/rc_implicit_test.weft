-- Trusted helper surface for implicit RC runtime tests that need raw memory.

use "runtime/unsafe.weft"

-- Sealed managed probe for ordinary-source lifetime tests. The public tests
-- exercise implicit ownership with this nominal value; only this trusted
-- helper crosses to the raw RC payload for count and word inspection.
type RuntimeRcProbe { }

fn runtime_rc_probe_from_owned_word(value: i64) -> RuntimeRcProbe {
  handle unsafe_transmute<i64, RuntimeRcProbe>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_rc_probe_word(value: RuntimeRcProbe) -> i64 {
  handle unsafe_transmute<RuntimeRcProbe, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_rc_probe_new(value: i64) -> RuntimeRcProbe {
  let raw: i64 = rc_default_alloc(8, 8)
  __mem_store64(raw, value)
  runtime_rc_probe_from_owned_word(raw)
}

fn runtime_rc_probe_load(value: RuntimeRcProbe) -> i64 {
  __mem_load64(runtime_rc_probe_word(value))
}

fn runtime_rc_probe_count(value: RuntimeRcProbe) -> i64 {
  rc_count(runtime_rc_probe_word(value))
}

fn runtime_rc_probe_weak_count(value: RuntimeRcProbe) -> i64 {
  rc_weak_count(runtime_rc_probe_word(value))
}

fn runtime_rc_probe_is_nonnull(value: RuntimeRcProbe) -> i64 {
  if runtime_rc_probe_word(value) != 0 { 1 } else { 0 }
}

fn runtime_rc_test_addr(p: rc i64) -> i64 {
  handle unsafe_transmute<rc i64, i64>(p) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Current bump position of the default rc heap's live arena. A churn
-- loop whose allocations are all released settles into the free list:
-- the offset stops moving. Reclamation locks assert exactly that.
fn runtime_rc_test_heap_arena_offset() -> i64 {
  let heap = rc_default_heap_existing()
  if heap == 0 { 0 } else { arena_offset(heap_arena(heap)) }
}

fn runtime_rc_test_load64(ptr: i64) -> i64 {
  __mem_load64(ptr)
}

fn runtime_rc_test_store64(ptr: i64, value: i64) -> i64 {
  __mem_store64(ptr, value)
}

fn runtime_rc_test_alloc_bump(size: i64) -> i64 {
  alloc_bump(size)
}

fn runtime_rc_implicit_scope_addr() -> i64 {
  let p: rc i64 = rc_default_alloc(8, 8)
  runtime_rc_test_store64(p, 123)
  runtime_rc_test_addr(p)
}

fn runtime_rc_implicit_reuse_matches() -> i64 {
  let old = runtime_rc_implicit_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  if again == old { 1 } else { 0 }
}

fn runtime_rc_implicit_reuse_zeroed_value() -> i64 {
  let old = runtime_rc_implicit_scope_addr()
  let again: rc i64 = rc_default_alloc(8, 8)
  __mem_load64(again)
}
