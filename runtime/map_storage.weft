-- runtime/map_storage.weft -- trusted CHAMP storage bridge for stdlib/map.

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "runtime/rc.weft"

fn map_storage_node_size() -> i64 { 32 }
fn map_storage_data_map_offset() -> i64 { 0 }
fn map_storage_node_map_offset() -> i64 { 8 }
fn map_storage_content_offset() -> i64 { 16 }
fn map_storage_content_len_offset() -> i64 { 24 }

fn map_storage_node_new(region: i64, data_map: i64, node_map: i64, content: i64, content_len: i64) -> i64 {
  let node = rc_persistent_region_alloc(region, map_storage_node_size(), 8)
  __mem_store64(node + map_storage_data_map_offset(), data_map)
  __mem_store64(node + map_storage_node_map_offset(), node_map)
  __mem_store64(node + map_storage_content_offset(), content)
  __mem_store64(node + map_storage_content_len_offset(), content_len)
  node
}

fn map_storage_empty_node(region: i64) -> i64 {
  let content = rc_persistent_region_alloc(region, 8, 8)
  map_storage_node_new(region, 0, 0, content, 0)
}

fn map_storage_data_map(node: i64) -> i64 {
  __mem_load64(node + map_storage_data_map_offset())
}

fn map_storage_node_map(node: i64) -> i64 {
  __mem_load64(node + map_storage_node_map_offset())
}

fn map_storage_content(node: i64) -> i64 {
  __mem_load64(node + map_storage_content_offset())
}

fn map_storage_content_len(node: i64) -> i64 {
  __mem_load64(node + map_storage_content_len_offset())
}

fn map_storage_data_key(node: i64, idx: i64) -> i64 {
  __mem_load64(map_storage_content(node) + idx * 16)
}

fn map_storage_data_val(node: i64, idx: i64) -> i64 {
  __mem_load64(map_storage_content(node) + idx * 16 + 8)
}

fn map_storage_sub_node(node: i64, data_count: i64, idx: i64) -> i64 {
  __mem_load64(map_storage_content(node) + data_count * 16 + idx * 8)
}

fn map_storage_content_data_key(content: i64, idx: i64) -> i64 {
  __mem_load64(content + idx * 16)
}

fn map_storage_content_data_val(content: i64, idx: i64) -> i64 {
  __mem_load64(content + idx * 16 + 8)
}

fn map_storage_content_sub_node(content: i64, data_count: i64, idx: i64) -> i64 {
  __mem_load64(content + data_count * 16 + idx * 8)
}

fn map_storage_copy_content(region: i64, content: i64, size: i64) -> i64 {
  let next = rc_persistent_region_alloc(region, size, 8)
  mem_copy(next, content, size)
  next
}

fn map_storage_copy_content_update_val(region: i64, content: i64, size: i64, idx: i64, val: i64) -> i64 {
  let next = map_storage_copy_content(region, content, size)
  __mem_store64(next + idx * 16 + 8, val)
  next
}

fn map_storage_insert_data_content(region: i64, old_content: i64, dc: i64, nc: i64, idx: i64, key: i64, val: i64) -> i64 {
  let new_total = (dc + 1) * 16 + nc * 8
  let next = rc_persistent_region_alloc(region, new_total, 8)
  for i in 0..idx {
    __mem_store64(next + i * 16, __mem_load64(old_content + i * 16))
    __mem_store64(next + i * 16 + 8, __mem_load64(old_content + i * 16 + 8))
  }
  __mem_store64(next + idx * 16, key)
  __mem_store64(next + idx * 16 + 8, val)
  for i in idx..dc {
    __mem_store64(next + (i + 1) * 16, __mem_load64(old_content + i * 16))
    __mem_store64(next + (i + 1) * 16 + 8, __mem_load64(old_content + i * 16 + 8))
  }
  for i in 0..nc {
    __mem_store64(next + (dc + 1) * 16 + i * 8, __mem_load64(old_content + dc * 16 + i * 8))
  }
  next
}

fn map_storage_migrate_to_node_content(region: i64, old_content: i64, dc: i64, data_idx: i64, node_idx: i64, sub: i64) -> i64 {
  let new_dc = dc - 1
  let new_nc = 1
  let new_total = new_dc * 16 + new_nc * 8
  let next = rc_persistent_region_alloc(region, new_total, 8)
  let mut di = 0
  for i in 0..dc {
    if i != data_idx {
      __mem_store64(next + di * 16, __mem_load64(old_content + i * 16))
      __mem_store64(next + di * 16 + 8, __mem_load64(old_content + i * 16 + 8))
      di = di + 1
    } else { 0 }
  }
  __mem_store64(next + new_dc * 16 + node_idx * 8, sub)
  next
}

fn map_storage_migrate_with_nodes_content(region: i64, old_content: i64, dc: i64, new_nc: i64, data_idx: i64, node_idx: i64, sub: i64) -> i64 {
  let new_dc = dc - 1
  let next = rc_persistent_region_alloc(region, new_dc * 16 + new_nc * 8, 8)
  let mut di = 0
  for i in 0..dc {
    if i != data_idx {
      __mem_store64(next + di * 16, __mem_load64(old_content + i * 16))
      __mem_store64(next + di * 16 + 8, __mem_load64(old_content + i * 16 + 8))
      di = di + 1
    } else { 0 }
  }
  let mut ni = 0
  for i in 0..new_nc {
    if i == node_idx {
      __mem_store64(next + new_dc * 16 + i * 8, sub)
    } else {
      __mem_store64(next + new_dc * 16 + i * 8, __mem_load64(old_content + dc * 16 + ni * 8))
      ni = ni + 1
    }
  }
  next
}

fn map_storage_replace_sub_content(region: i64, old_content: i64, total: i64, data_count: i64, idx: i64, new_sub: i64) -> i64 {
  let next = map_storage_copy_content(region, old_content, total)
  __mem_store64(next + data_count * 16 + idx * 8, new_sub)
  next
}

fn map_storage_persistent_region_new() -> rc i64 {
  rc_persistent_region_new()
}

fn map_storage_persistent_box(root: i64, region: i64) -> rc i64 {
  let box: rc i64 = rc_default_alloc(16, 8)
  let raw: i64 = box
  rc_set_field_mask_word(raw, 16, 4)
  __mem_store64(raw, root)
  __mem_store64(raw + 8, region)
  rc_default_retain(region)
  box
}

fn map_storage_persistent_root(m: i64) -> i64 {
  if m == 0 { 0 } else { __mem_load64(m) }
}

fn map_storage_persistent_region(m: i64) -> i64 {
  if m == 0 { 0 } else { __mem_load64(m + 8) }
}
