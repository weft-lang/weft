    let need = alloc_round_up(size, align)
    let next_cap = if old_cap * 2 > need * 2 { old_cap * 2 } else { need * 2 }
    let grown = arena_new(next_cap)
    if grown == 0 {
      sys_write(2, __str_ptr("weft: persistent collection region growth failed\n"), __str_len("weft: persistent collection region growth failed\n"))
      sys_exit(70)
      0
    } else {
      __mem_store64(grown + rc_persistent_region_arena_next_offset(), arena)
      __mem_store64(region, grown)
      arena_alloc(grown, size, align)
    }
  }
}

