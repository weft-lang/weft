pub(package) fn runtime_generator_state_cell(state: i64) -> i64 {
  if state == 0 { 0 } else { __mem_load64(state) }
}

-- State layout: [prompt, current, has_current, done, result, producer].
-- The producer slot (+40) is an OWNING stash of the producer closure
-- (managed aggregate ownership): the fiber references it across suspensions long after
-- the creating scope's release fires. Released once on completion or
-- drop (zero-guarded).
pub(package) fn runtime_generator_state_size() -> i64 { 48 }

pub(package) fn runtime_generator_state_new() -> i64 {
  -- Generator state has one linear owner. Recyclable raw storage avoids both
  -- bump growth and reference-count traffic at each suspension boundary.
  let state = heap_alloc(rc_default_heap(), runtime_generator_state_size(), 8)
  __mem_store64(state, 0)
  __mem_store64(state + 8, 0)
  __mem_store64(state + 16, 0)
  __mem_store64(state + 24, 0)
  __mem_store64(state + 32, 0)
  __mem_store64(state + 40, 0)
  state
}

pub(package) fn runtime_generator_state_release_producer(state: i64) -> i64 {
  if state == 0 { 0 }
  else {
    let producer = __mem_load64(state + 40)
    if producer == 0 { 0 }
    else {
      __mem_store64(state + 40, 0)
      closure_default_release(producer)
    }
  }
}

pub(package) fn runtime_generator_state_has_current(state: i64) -> i64 {
  if state == 0 { 0 } else { __mem_load64(state + 16) }
}

pub(package) fn runtime_generator_state_word_as<T>(value: i64) -> T {
  handle unsafe_transmute<i64, T>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_generator_state_word_from<T>(value: T) -> i64 {
  handle unsafe_transmute<T, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_generator_state_word_from_any(value: any) -> i64 {
  handle unsafe_transmute<any, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_generator_word_retain_maybe(value: i64) -> i64 {
  if rc_default_payload_has_magic(value) == 1 { rc_default_retain(value) } else { 0 }
}

pub(package) fn runtime_generator_word_release_maybe(value: i64) -> i64 {
  if rc_default_payload_has_magic(value) == 1 { rc_default_release(value) } else { 0 }
}

pub(package) fn runtime_generator_state_take_current<T>(state: i64) -> T {
  if runtime_generator_state_has_current(state) == 1 {
    let value = __mem_load64(state + 8)
    __mem_store64(state + 8, 0)
    __mem_store64(state + 16, 0)
    runtime_generator_state_word_as<T>(value)
  } else { runtime_generator_state_word_as<T>(0) }
}

pub(package) fn runtime_generator_state_is_done(state: i64) -> i64 {
  if state == 0 { 1 } else { __mem_load64(state + 24) }
}

pub(package) fn runtime_generator_state_cleanup_count(state: i64) -> i64 {
  if state == 0 { 0 }
  else { fiber_prompt_cleanup_record_count(__mem_load64(state)) }
}

-- Retaining read of a completed generator's result carrier. The safe generic
-- surface checks completion first and exposes absence as Option.
pub(package) fn runtime_generator_state_result_word(state: i64) -> i64 {
  if state == 0 or runtime_generator_state_is_done(state) != 1 { 0 }
  else {
    let result = __mem_load64(state + 32)
    runtime_generator_word_retain_maybe(result)
    result
  }
}

pub(package) fn runtime_generator_state_mark_done_result(state: i64, value: i64) -> i64 {
  if state == 0 { 0 }
  else {
    __mem_store64(state + 24, 1)
    __mem_store64(state + 32, value)
    1
  }
}

pub(package) fn runtime_generator_packet_size() -> i64 { 16 }

pub(package) fn runtime_generator_packet_new(value: i64) -> i64 {
  let packet = heap_alloc(rc_default_heap(), runtime_generator_packet_size(), 8)
  __mem_store64(packet, 1)
  __mem_store64(packet + 8, value)
  packet
}

pub(package) fn runtime_generator_packet_value(packet: i64) -> i64 {
  if packet == 0 { 0 } else { __mem_load64(packet + 8) }
}

pub(package) fn runtime_generator_packet_release(packet: i64) -> i64 {
  if packet == 0 { 0 }
  else { heap_free(rc_default_heap(), packet, runtime_generator_packet_size()) }
}

pub(package) fn runtime_generator_state_store_suspended_packet(state: i64, packet: i64) -> i64 {
  if state == 0 { 0 }
  else {
    let value = runtime_generator_packet_value(packet)
    runtime_generator_word_retain_maybe(value)
    __mem_store64(state + 8, value)
    __mem_store64(state + 16, 1)
    runtime_generator_packet_release(packet)
    1
  }
}

pub(package) fn runtime_generator_yield_word_raw(value: i64) -[Unsafe]> i64 {
  __fiber_suspend(runtime_generator_packet_new(value))
}

pub(package) fn runtime_generator_yield_word(value: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_yield_word_raw(value))
  }
}

pub(package) fn runtime_generator_body_raw(producer: i64) -[Unsafe]> i64 {
  __call_closure_i64(producer, 0)
}

pub(package) fn runtime_generator_state_start_raw(producer: i64) -[Unsafe]> i64 {
  let state = runtime_generator_state_new()
  __mem_store64(state + 40, producer)
  closure_default_retain(producer)
  let segment = fiber_segment_new(fiber_default_stack_size())
  let prompt = fiber_prompt_new(segment)
  fiber_prompt_enable_cleanup(prompt)
  __mem_store64(state, prompt)
  let result = fiber_trampoline(prompt, runtime_fn_addr_unsafe(runtime_generator_body_raw), producer)
  let done = fiber_is_done()
  if done == 1 {
    runtime_generator_state_mark_done_result(state, result)
    runtime_generator_state_release_producer(state)
  } else {
    runtime_generator_state_store_suspended_packet(state, result)
  }
  state
}

pub(package) fn runtime_generator_state_start(producer: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_state_start_raw(producer))
  }
}

pub(package) fn runtime_generator_state_resume_word_raw(state: i64, sent: i64) -[Unsafe]> i64 {
  if state == 0 { 0 }
  else {
    let prompt = __mem_load64(state)
    if prompt == 0 { 0 }
    else {
      let result = fiber_resume(prompt, sent)
      let done = fiber_is_done()
      if done == 1 {
        runtime_generator_state_mark_done_result(state, result)
        runtime_generator_state_release_producer(state)
        0
      } else {
        -- The first yield is buffered in the state and owns a retained
        -- current stake. Later yields return directly from fiber_resume, so
        -- they need the same consumer stake before the suspended producer's
        -- cleanup can release its local/capture ownership. Without it, a
        -- managed value yielded after the first was borrowed but later
        -- released as owned by Some<T> (deferred continuations double-release).
        let value = runtime_generator_packet_value(result)
        runtime_generator_word_retain_maybe(value)
        runtime_generator_packet_release(result)
        value
      }
    }
  }
}

pub(package) fn runtime_generator_state_resume_word(state: i64, sent: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_state_resume_word_raw(state, sent))
  }
}

pub(package) fn runtime_generator_state_drop(state: i64) -> i64 {
  if runtime_generator_state_is_done(state) == 1 {
    if state == 0 { 0 }
    else {
      fiber_prompt_drop_cleanup(__mem_load64(state))
      let result = __mem_load64(state + 32)
      runtime_generator_word_release_maybe(result)
      __mem_store64(state + 32, 0)
      runtime_generator_state_release_producer(state)
      heap_free(rc_default_heap(), state, runtime_generator_state_size())
      0
    }
  }
  else {
    -- Closed-box suspended-fiber semantics (deferred continuations): first
    -- unwind the live fiber frames in LIFO order, then release the buffered
    -- current and producer stakes owned by the generator state.
    fiber_prompt_drop_cleanup(__mem_load64(state))
    let current = __mem_load64(state + 8)
    runtime_generator_word_release_maybe(current)
    __mem_store64(state + 8, 0)
    __mem_store64(state + 16, 0)
    __mem_store64(state + 24, 1)
    runtime_generator_state_release_producer(state)
    heap_free(rc_default_heap(), state, runtime_generator_state_size())
    1
  }
}
