    __mem_store64(binned + rc_payload_size_offset(), payload_size bor (mask bshl 32))
    __mem_store64(binned + rc_weak_count_offset(), 0)
    __mem_store64(binned + rc_promoted_offset(), 0)
    __mem_store64(binned + rc_atomic_lock_offset(), 0)
    __mem_store64(binned + rc_magic_offset(), rc_magic_value())
    binned + rc_header_size()
