  if env == 0 { 0 }
  else {
    let n = closure_env_capture_count_from_encoded(__mem_load64(env + closure_env_count_offset()))
    let mut i = 0
    let mut promoted = 0
    while i < n {
      let value = __mem_load64(env + closure_env_value_offset(i))
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        -- Managed lanes can legally hold static/bump-backed values such as
        -- string literals. Retain/release already treat those as guarded
        -- no-ops; promotion must preserve the same representation boundary
        -- instead of interpreting bytes before the value as an RC header.
        promoted = promoted + rc_default_promote_maybe(value)
      } else { if kind == continuation_cleanup_kind_closure() {
        promoted = promoted + closure_default_promote(value)
      } else { if kind == continuation_cleanup_kind_weak() {
        promoted = promoted + rc_default_promote_maybe(value)
      } else { 0 } } }
      i = i + 1
    }
    promoted
  }
}

pub(package) fn closure_default_promote(value: any) -> i64 {
  let closure = handle unsafe_transmute<any, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
  if closure == 0 { 0 }
  else { if rc_default_payload_has_magic(closure) != 1 { 0 }
  else {
    let promoted = rc_default_promote(closure)
    let env = __mem_load64(closure + 8)
    if env != 0 {
      promoted + rc_default_promote(env) + closure_env_promote_captures_raw(env)
    } else { promoted }
  } }
}

pub(package) fn closure_env_clone_into_raw(env: i64, clone: i64) -> i64 {
  if env == 0 or clone == 0 { 0 }
  else {
    let encoded = __mem_load64(env + closure_env_count_offset())
    let n = closure_env_capture_count_from_encoded(encoded)
    let has_evidence = closure_env_has_evidence_from_encoded(encoded)
    __mem_store64(clone + closure_env_count_offset(), encoded)
    let mut i = 0
    while i < n {
      let value = __mem_load64(env + closure_env_value_offset(i))
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      __mem_store64(clone + closure_env_value_offset(i), value)
      __mem_store64(clone + closure_env_kind_offset(i), kind)
      if kind == continuation_cleanup_kind_rc() {
        rc_default_retain(value)
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_retain(value)
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_retain(value)
      } else { 0 } } }
      i = i + 1
    }
    if has_evidence == 1 {
      __mem_store64(clone + 8 + n * closure_env_entry_size(), __mem_load64(env + 8 + n * closure_env_entry_size()))
      __mem_store64(clone + 16 + n * closure_env_entry_size(), __mem_load64(env + 16 + n * closure_env_entry_size()))
    } else { 0 }
    clone
  }
}

pub(package) fn closure_env_bump_clone_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let encoded = __mem_load64(env + closure_env_count_offset())
    closure_env_clone_into_raw(env, alloc_bump(closure_env_storage_size_from_encoded(encoded)))
  }
