pub(package) fn rc_deep_release_custom(payload: i64, word: i64, pending_start: i64, heap: i64) -> i64 {
  let kind = rc_size_word_finalizer(word)
  if kind == rc_finalizer_buffer() {
    let data = __mem_load64(payload)
    let cap = __mem_load64(payload + 16)
    if data != 0 and cap > 0 { heap_free(heap, data, cap) } else { 0 }
    pending_start
  } else { if kind == rc_finalizer_vector() {
    rc_vector_release_pending(payload, pending_start, heap)
  } else { if kind == rc_finalizer_persistent_region() {
    rc_persistent_region_release_pending(payload, pending_start)
  } else { if kind == rc_finalizer_array_storage() {
    rc_array_storage_release_pending(payload, pending_start, heap)
  } else {
    pending_start
  } } } }
}

pub(package) fn rc_deep_release_walk(first: i64) -> i64 {
  let heap = rc_default_heap()
  let mut pending = first
  while pending != 0 {
    let node = pending
    pending = rc_deep_pending_next(node)
    let header = rc_header_from_payload(node)
    __mem_store64(header + rc_promoted_offset(), 0)
    let word = __mem_load64(header + rc_payload_size_offset())
    let mask = rc_size_word_mask(word)
    let has_layout_descriptor = rc_size_word_has_layout_descriptor(word)
    if has_layout_descriptor == 1 {
      pending = rc_layout_descriptor_release_pending(node, pending)
    } else { 0 }
    -- Ordinary aggregates never pay a finalizer call. Only descriptors
    -- using the high mask pair can be runtime containers (or a real
    -- word-15 field, rejected by the helper's payload-size check).
    if mask >= 1073741824 {
      pending = rc_deep_release_custom(node, word, pending, heap)
    } else { 0 }
    if mask != 0 and has_layout_descriptor == 0 {
      let words = rc_size_word_size(word) / 8
      let limit = if words < 16 { words } else { 16 }
      let mut i = 0
      while i < limit {
        let kind = (mask bshr (i * 2)) band 3
        if kind == 1 {
          pending = rc_deep_release_child(__mem_load64(node + i * 8), pending)
        } else { if kind == 2 {
          closure_default_release(__mem_load64(node + i * 8))
        } else { if kind == 3 {
          rc_default_weak_release(__mem_load64(node + i * 8))
        } else { 0 } } }
        i = i + 1
      }
    } else { 0 }
    -- Free the dead node inline: the non-weak bin push is the hot
    -- case (magic cleared, [next, size] written into the block, LIFO
    -- push). Weak survivors and oversize blocks take the general
    -- finalize/free path.
    let wk = __mem_load64(header + rc_weak_count_offset())
    if wk <= 0 {
      let rounded = (rc_header_size() + rc_size_word_size(word) + 7) / 8 * 8
      let need = if rounded < heap_min_block_size() { heap_min_block_size() } else { rounded }
      __mem_store64(header + rc_magic_offset(), 0)
      if need <= heap_bin_limit() {
        heap_lock(heap)
        let cell = heap + 16 + (need / 8) * 8
        __mem_store64(header, __mem_load64(cell))
        __mem_store64(header + 8, need)
        __mem_store64(cell, header)
        heap_unlock(heap)
      } else {
        heap_free(heap, header, need)
      }
    } else {
      rc_finalize_zero_count_payload(heap, node)
    }
  }
  0
}

pub(package) fn rc_default_release_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 {
      rc_atomic_unlock(payload)
      0 - 1
    } else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      -- Fields drop while the node still holds its lock: the locked
      -- count decision is what makes the walk race-free for promoted
