pub(package) fn closure_env_heap_clone_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let encoded = __mem_load64(env + closure_env_count_offset())
    let size = closure_env_storage_size_from_encoded(encoded)
    closure_env_clone_into_raw(env, heap_alloc_zeroed(rc_default_heap(), size, 8))
  }
}

pub(package) fn closure_env_release_captures_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = closure_env_capture_count_from_encoded(__mem_load64(env + closure_env_count_offset()))
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_continuation() {
        continuation_drop_owned_managed(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } } } }
      i = i + 1
    }
    0
  }
}

pub(package) fn closure_env_heap_release_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let size = closure_env_storage_size_from_encoded(__mem_load64(env + closure_env_count_offset()))
    closure_env_release_captures_raw(env)
    if heap_free(rc_default_heap(), env, size) == 0 { 1 } else { 0 }
  }
}

pub(package) fn closure_default_release_env(env: i64) -> i64 {
  if env == 0 { 0 - 1 }
  else {
    let n = closure_env_capture_count_from_encoded(__mem_load64(env + closure_env_count_offset()))
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_continuation() {
        continuation_drop_owned_managed(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } } } }
      i = i + 1
    }
    rc_default_release(env)
  }
}

pub(package) fn closure_default_release_promoted(closure: i64) -> i64 {
  if closure == 0 { 0 - 1 }
  else {
    let heap = rc_default_heap()
    let header = rc_header_from_payload(closure)
    rc_atomic_lock(closure)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 {
      rc_atomic_unlock(closure)
      0 - 1
    } else { if count == 1 {
      let env = __mem_load64(closure + 8)
      __mem_store64(header + rc_count_offset(), 0)
      rc_atomic_unlock(closure)
      if env != 0 { closure_default_release_env(env) } else { 0 }
      rc_atomic_lock(closure)
      let result = rc_finalize_zero_count_payload(heap, closure)
      rc_atomic_unlock(closure)
      result
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      rc_atomic_unlock(closure)
      next
    } }
  }
}

pub(package) fn closure_default_release(closure: i64) -> i64 {
  if closure == 0 { 0 - 1 }
  else { if rc_default_payload_has_magic(closure) != 1 { 0 - 1 }
  else { if rc_is_promoted(closure) != 0 { closure_default_release_promoted(closure) }
  else {
    let count = rc_count(closure)
    if count == 1 {
      let env = __mem_load64(closure + 8)
      if env != 0 { closure_default_release_env(env) } else { 0 }
    } else { 0 }
    rc_default_release(closure)
  } } }
}

-- Compiler-generated defer closures use the ordinary abort-cleanup chain.
-- This action runs the scheduled work but deliberately leaves the closure's
-- backing ownership to the following closure_default_release descriptor.
-- Keeping those as two obligations gives the required order on both normal
-- scope exit and abort: explicit defer first, managed cleanup second.
pub(package) fn runtime_defer_abort_cleanup(closure: i64) -[Unsafe]> i64 {
  if closure == 0 { 0 } else { __call_closure_i64(closure, 0) }
}

pub(package) fn continuation_cleanup_segment_value(segment: i64, slot: i64) -> i64 {
  if segment == 0 { 0 }
  else { if slot < 0 { 0 } else { __mem_load64(segment + slot) } }
}

pub(package) fn continuation_cleanup_release_value(kind: i64, value: i64) -> i64 {
  if value == 0 { 0 }
  else {
    if kind == continuation_cleanup_kind_rc() {
      rc_default_release(value)
      1
    } else { if kind == continuation_cleanup_kind_closure() {
      closure_default_release(value)
      1
    } else { if kind == continuation_cleanup_kind_weak() {
      rc_default_weak_release(value)
      1
    } else { 0 } } }
  }
}

pub(package) fn continuation_cleanup_release_value_for(kind: i64, value: i64, dropping: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_rc(), value) }
  } else { if kind == continuation_cleanup_kind_closure_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_closure(), value) }
  } else { if kind == continuation_cleanup_kind_weak_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_weak(), value) }
  } else { if kind == continuation_cleanup_kind_prompt_drop_only() {
    if dropping == 0 { 0 } else { fiber_prompt_drop_cleanup(value) }
  } else {
    continuation_cleanup_release_value(kind, value)
  } } } }
}

pub(package) fn continuation_cleanup_mark_entry_dead(desc: i64, index: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { 0 }
  else {
    __mem_store64(entry + continuation_cleanup_entry_live_offset(), 0)
    1
  }
}

pub(package) fn continuation_cleanup_clear_segment_slot(segment: i64, slot: i64) -> i64 {
  if segment == 0 { 0 }
  else { if slot < 0 { 0 }
  else {
    __mem_store64(segment + slot, 0)
    1
  } }
}

pub(package) fn continuation_cleanup_release_segment_for(k: i64, dropping: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status_is_owned(continuation_status(k)) == 0 { 0 }
  else {
    let desc = continuation_cleanup_desc(k)
    let segment = continuation_segment(k)
    if desc == 0 or segment == 0 { 0 }
    else {
      let n = continuation_cleanup_desc_count(desc)
      let mut released = 0
      let mut i = 0
      while i < n {
        if continuation_cleanup_desc_live(desc, i) != 0 {
          let kind = continuation_cleanup_desc_kind(desc, i)
          let slot = continuation_cleanup_desc_slot(desc, i)
          let value = continuation_cleanup_segment_value(segment, slot)
          continuation_cleanup_mark_entry_dead(desc, i)
          continuation_cleanup_clear_segment_slot(segment, slot)
          released = released + continuation_cleanup_release_value_for(kind, value, dropping)
        } else { 0 }
        i = i + 1
      }
      released
    }
  } }
}

pub(package) fn continuation_cleanup_release_segment(k: i64) -> i64 {
  continuation_cleanup_release_segment_for(k, 0)
}

pub(package) fn continuation_drop_managed(k: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status(k) != continuation_status_active() { 0 }
  else {
    continuation_cleanup_release_segment_for(k, 1)
    continuation_drop(k)
  } }
}

pub(package) fn continuation_drop_owned_managed(k: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status_is_owned(continuation_status(k)) == 0 { 0 }
  else {
    continuation_cleanup_release_segment_for(k, 1)
    continuation_drop(k)
