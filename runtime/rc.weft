-- runtime/rc.weft -- explicit reference-counted heap blocks

use "runtime/alloc.weft"
use "runtime/effects.weft"
use "runtime/memory.weft"
use "runtime/thread.weft"
use "runtime/unsafe.weft"

fn rc_header_size() -> i64 { 48 }
fn rc_count_offset() -> i64 { 0 }
fn rc_payload_size_offset() -> i64 { 8 }
fn rc_weak_count_offset() -> i64 { 16 }
fn rc_promoted_offset() -> i64 { 24 }
fn rc_atomic_lock_offset() -> i64 { 32 }
fn rc_magic_offset() -> i64 { 40 }
fn rc_magic_value() -> i64 { 974319517 }
fn rc_default_heap_offset() -> i64 { 8 }
fn rc_default_heap_capacity() -> i64 { 16777216 }
fn rc_default_bounds_base_offset() -> i64 { 96 }
fn rc_default_bounds_end_offset() -> i64 { 104 }

fn rc_runtime_state_ptr() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

fn rc_atomic_lock_cell(payload: i64) -> i64 {
  rc_header_from_payload(payload) + rc_atomic_lock_offset()
}

fn rc_atomic_lock(payload: i64) -> i64 {
  __atomic_lock64(rc_atomic_lock_cell(payload))
}

fn rc_atomic_unlock(payload: i64) -> i64 {
  __atomic_unlock64(rc_atomic_lock_cell(payload))
}

fn rc_header_from_payload(payload: i64) -> i64 {
  payload - rc_header_size()
}

fn rc_payload_from_header(header: i64) -> i64 {
  header + rc_header_size()
}

fn rc_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_count_offset())
}

-- The header's size word packs the deep-release field mask into its
-- high 32 bits (2 bits per payload word: 0 none, 1 rc, 2 closure,
-- 3 weak; first 16 words). Sizes stay in the low 32 — every reader
-- must go through rc_size_word_size.
fn rc_size_word_size(word: i64) -> i64 { word band 4294967295 }
fn rc_size_word_mask(word: i64) -> i64 { (word bshr 32) band 4294967295 }

fn rc_payload_size(payload: i64) -> i64 {
  rc_size_word_size(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

fn rc_field_mask(payload: i64) -> i64 {
  rc_size_word_mask(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

fn rc_weak_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_weak_count_offset())
}

fn rc_is_promoted_raw(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

fn rc_is_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    rc_atomic_lock(payload)
    let result = rc_is_promoted_raw(payload)
    rc_atomic_unlock(payload)
    result
  }
}

fn rc_mark_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let result = if rc_is_promoted_raw(payload) != 0 {
      1
    } else {
      __mem_store64(header + rc_promoted_offset(), 1)
      1
    }
    rc_atomic_unlock(payload)
    result
  }
}

fn rc_block_size(payload: i64) -> i64 {
  rc_header_size() + rc_payload_size(payload)
}

fn rc_header_block_size(header: i64) -> i64 {
  rc_header_size() + rc_size_word_size(__mem_load64(header + rc_payload_size_offset()))
}

fn rc_free_if_unreferenced(heap: i64, header: i64) -> i64 {
  let strong = __mem_load64(header + rc_count_offset())
  let weak = __mem_load64(header + rc_weak_count_offset())
  if strong <= 0 and weak <= 0 {
    let block_size = rc_header_block_size(header)
    __mem_store64(header + rc_magic_offset(), 0)
    heap_free(heap, header, block_size)
  } else { 0 }
}

fn rc_finalize_zero_count_payload(heap: i64, payload: i64) -> i64 {
  let header = rc_header_from_payload(payload)
  let weak = __mem_load64(header + rc_weak_count_offset())
  if weak <= 0 {
    rc_free_if_unreferenced(heap, header)
  } else {
    mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
    0
  }
}

fn rc_alloc_core(heap: i64, payload_size: i64, align: i64, zero: i64) -> i64 {
  if heap == 0 { 0 }
  else { if payload_size < 0 { 0 }
  else {
    let block = heap_alloc(heap, rc_header_size() + payload_size, align)
    if block == 0 { 0 }
    else {
      __mem_store64(block + rc_count_offset(), 1)
      __mem_store64(block + rc_payload_size_offset(), payload_size)
      __mem_store64(block + rc_weak_count_offset(), 0)
      __mem_store64(block + rc_promoted_offset(), 0)
      __mem_store64(block + rc_atomic_lock_offset(), 0)
      __mem_store64(block + rc_magic_offset(), rc_magic_value())
      let payload = rc_payload_from_header(block)
      if zero == 1 { mem_zero(payload, payload_size) } else { 0 }
      payload
    }
  } }
}

fn rc_alloc(heap: i64, payload_size: i64, align: i64) -> i64 {
  rc_alloc_core(heap, payload_size, align, 1)
}

fn rc_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else {
      let next = count + 1
      __mem_store64(header + rc_count_offset(), next)
      next
    }
  }
}

fn rc_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      let weak = __mem_load64(header + rc_weak_count_offset())
      if weak <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else {
        mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
        0
      }
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      next
    } }
  } }
}

fn rc_weak_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let strong = __mem_load64(header + rc_count_offset())
    let weak = __mem_load64(header + rc_weak_count_offset())
    if strong <= 0 and weak <= 0 { 0 - 1 }
    else {
      let next = weak + 1
      __mem_store64(header + rc_weak_count_offset(), next)
      next
    }
  }
}

fn rc_weak_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let weak = __mem_load64(header + rc_weak_count_offset())
    if weak <= 0 { 0 - 1 }
    else {
      let next = weak - 1
      __mem_store64(header + rc_weak_count_offset(), next)
      let strong = __mem_load64(header + rc_count_offset())
      if next == 0 and strong <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else { next }
    }
  } }
}

fn rc_weak_load(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 }
    else {
      __mem_store64(header + rc_count_offset(), count + 1)
      payload
    }
  }
}

fn rc_atomic_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_retain(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_retain(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_load(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_load(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_default_heap_cell() -> i64 {
  rc_runtime_state_ptr() + rc_default_heap_offset()
}

fn rc_default_heap_existing() -> i64 {
  __mem_load64(rc_default_heap_cell())
}

fn rc_default_bounds_update(heap: i64) -> i64 {
  let st = rc_runtime_state_ptr()
  let arena = heap_arena(heap)
  let base = arena_base(arena)
  __mem_store64(st + rc_default_bounds_base_offset(), base)
  __mem_store64(st + rc_default_bounds_end_offset(), base + arena_capacity(arena))
  0
}

fn rc_default_heap() -> i64 {
  let cell = rc_default_heap_cell()
  let heap = __mem_load64(cell)
  if heap != 0 { heap }
  else {
    let new_heap = heap_new(rc_default_heap_capacity())
    __mem_store64(cell, new_heap)
    rc_default_bounds_update(new_heap)
    new_heap
  }
}

fn rc_default_alloc(payload_size: i64, align: i64) -> i64 {
  rc_alloc(rc_default_heap(), payload_size, align)
}

fn rc_null_i64() -> rc i64 {
  handle unsafe_transmute<i64, rc i64>(0) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn rc_default_word_new(value: i64) -> rc i64 {
  let payload = rc_default_alloc(8, 8)
  if payload == 0 { rc_null_i64() }
  else {
    __mem_store64(payload, value)
    payload
  }
}

fn rc_default_word_load(payload: i64) -> i64 {
  if payload == 0 { 0 } else { __mem_load64(payload) }
}

fn rc_default_word_store(payload: i64, value: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    __mem_store64(payload, value)
    value
  }
}

-- The retain/release magic guard is the hottest code in ownership-
-- heavy programs (17%+ of self-compile before flattening): it reads
-- the CACHED arena bounds from runtime state (written at heap
-- creation and arena growth) instead of chasing heap -> arena ->
-- base/capacity through four calls per check.
fn rc_default_payload_has_magic(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let st = rc_runtime_state_ptr()
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    if base == 0 { 0 }
    else {
      let header = payload - rc_header_size()
      if header < base { 0 }
      else { if payload > __mem_load64(st + rc_default_bounds_end_offset()) { 0 }
      else { if __mem_load64(header + rc_magic_offset()) == rc_magic_value() { 1 } else { 0 } } }
    }
  }
}

fn rc_default_promote_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_default_promote(payload)
  } else { 0 }
}

fn rc_default_is_promoted_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_is_promoted(payload)
  } else { 0 }
}

fn region_promote_rc(src: i64, payload_size: i64, align: i64) -> rc i64 {
  let dst = rc_default_alloc(payload_size, align)
  if dst == 0 { rc_null_i64() } else {
    mem_copy(dst, src, payload_size)
  }
  dst
}

-- Promotion is a one-way transition that happens BEFORE a value
-- crosses threads, so promoted == 0 proves single-owner-thread and
-- needs no lock. Nonzero promoted words (real promotions, or a deep-
-- release worklist zombie link) take the locked path unchanged.
--
-- retain/release are the hottest calls in ownership-heavy programs;
-- their fast paths are SELF-CONTAINED (inline magic guard via the
-- cached bounds, inline count update) — no nested calls.
fn rc_default_retain_promoted_slow(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let promoted = rc_is_promoted_raw(payload)
  let result = if promoted != 0 { rc_retain(payload) } else { 0 - 2 }
  rc_atomic_unlock(payload)
  if promoted != 0 { result } else { rc_retain(payload) }
}

fn rc_default_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let header = payload - rc_header_size()
    if base == 0 or header < base or payload > __mem_load64(st + rc_default_bounds_end_offset()) { 0 - 1 }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { 0 - 1 }
    else {
      if __mem_load64(header + rc_promoted_offset()) != 0 { rc_default_retain_promoted_slow(payload) }
      else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { 0 - 1 }
        else {
          __mem_store64(header + rc_count_offset(), count + 1)
          count + 1
        }
      }
    } }
  }
}

-- Deep release (2q slice 2 stage B): a dying node drops one count on
-- each managed payload field per its header mask. The cascade is a
-- WORKLIST, not recursion — list spines are millions deep. Dying
-- nodes (count already 0, not yet freed) link the pending list
-- through their header's promoted word: it is 0 on the non-promoted
-- path, nobody mutates a zero-count zombie, and any stale release in
-- the window no-ops on count <= 0. Kernel §10 rejects mutable strong
-- cycles, so the walk terminates. Closure/weak fields and promoted
-- children release recursively (bounded shapes).
fn rc_deep_pending_push(pending: i64, payload: i64) -> i64 {
  __mem_store64(rc_header_from_payload(payload) + rc_promoted_offset(), pending)
  payload
}

fn rc_deep_pending_next(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

fn rc_deep_release_child(child: i64, pending: i64) -> i64 {
  if rc_default_payload_has_magic(child) != 1 { pending }
  else {
    let promoted = rc_is_promoted_raw(child)
    if promoted != 0 {
      rc_default_release_promoted(child)
      pending
    } else {
      let header = rc_header_from_payload(child)
      let count = __mem_load64(header + rc_count_offset())
      if count <= 0 { pending }
      else { if count == 1 {
        __mem_store64(header + rc_count_offset(), 0)
        rc_deep_pending_push(pending, child)
      } else {
        __mem_store64(header + rc_count_offset(), count - 1)
        pending
      } }
    }
  }
}

fn rc_deep_release_walk(first: i64) -> i64 {
  let mut pending = first
  while pending != 0 {
    let node = pending
    pending = rc_deep_pending_next(node)
    let header = rc_header_from_payload(node)
    __mem_store64(header + rc_promoted_offset(), 0)
    let word = __mem_load64(header + rc_payload_size_offset())
    let mask = rc_size_word_mask(word)
    if mask != 0 {
      let words = rc_size_word_size(word) / 8
      let limit = if words < 16 { words } else { 16 }
      let mut i = 0
      while i < limit {
        let kind = (mask bshr (i * 2)) band 3
        if kind == 1 {
          pending = rc_deep_release_child(__mem_load64(node + i * 8), pending)
        } else { if kind == 2 {
          closure_default_release(__mem_load64(node + i * 8))
        } else { if kind == 3 {
          rc_default_weak_release(__mem_load64(node + i * 8))
        } else { 0 } } }
        i = i + 1
      }
    } else { 0 }
    rc_finalize_zero_count_payload(rc_default_heap(), node)
  }
  0
}

fn rc_default_release_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 {
      rc_atomic_unlock(payload)
      0 - 1
    } else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      -- Fields drop while the node still holds its lock: the locked
      -- count decision is what makes the walk race-free for promoted
      -- nodes. Child locks are distinct nodes (no cycles), so the
      -- nested releases cannot deadlock; non-promoted subtrees cascade
      -- iteratively inside rc_default_release.
      rc_deep_release_promoted_fields(payload)
      let weak = __mem_load64(header + rc_weak_count_offset())
      if weak <= 0 {
        rc_atomic_unlock(payload)
        rc_free_if_unreferenced(rc_default_heap(), header)
      } else {
        mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
        rc_atomic_unlock(payload)
        0
      }
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      rc_atomic_unlock(payload)
      next
    } }
  }
}

-- Promoted nodes walk their fields under the caller's lock; only
-- closure/weak/promoted children recurse — plain rc children cascade
-- through the worklist by re-entering rc_default_release.
fn rc_deep_release_promoted_fields(payload: i64) -> i64 {
  let header = rc_header_from_payload(payload)
  let word = __mem_load64(header + rc_payload_size_offset())
  let mask = rc_size_word_mask(word)
  if mask == 0 { 0 }
  else {
    let words = rc_size_word_size(word) / 8
    let limit = if words < 16 { words } else { 16 }
    let mut i = 0
    while i < limit {
      let kind = (mask bshr (i * 2)) band 3
      if kind == 1 {
        rc_default_release(__mem_load64(payload + i * 8))
      } else { if kind == 2 {
        closure_default_release(__mem_load64(payload + i * 8))
      } else { if kind == 3 {
        rc_default_weak_release(__mem_load64(payload + i * 8))
      } else { 0 } } }
      i = i + 1
    }
    0
  }
}

fn rc_default_release(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let header = payload - rc_header_size()
    if base == 0 or header < base or payload > __mem_load64(st + rc_default_bounds_end_offset()) { 0 - 1 }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { 0 - 1 }
    else {
      if __mem_load64(header + rc_promoted_offset()) != 0 { rc_default_release_promoted(payload) }
      else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { 0 - 1 }
        else { if count == 1 {
          __mem_store64(header + rc_count_offset(), 0)
          __mem_store64(header + rc_promoted_offset(), 0)
          rc_deep_release_walk(payload)
          0
        } else {
          __mem_store64(header + rc_count_offset(), count - 1)
          count - 1
        } }
      }
    } }
  }
}

fn rc_set_field_mask_word(payload: i64, payload_size: i64, mask: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    __mem_store64(rc_header_from_payload(payload) + rc_payload_size_offset(), payload_size bor (mask bshl 32))
    0
  }
}

-- Ctor-init allocations (variant/record) skip the zero fill: emission
-- stores the tag and every declared field word before the value is
-- observable, and slack words (size rounding) are mask-kind none —
-- the deep-release walk and pattern matching never read them.
fn rc_default_alloc_masked(payload_size: i64, align: i64, mask: i64) -> i64 {
  let payload = rc_alloc_core(rc_default_heap(), payload_size, align, 0)
  if mask == 0 { payload }
  else {
    rc_set_field_mask_word(payload, payload_size, mask)
    payload
  }
}

fn rc_default_weak_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else { if rc_default_payload_has_magic(payload) != 1 { 0 - 1 }
  else {
    rc_atomic_lock(payload)
    let promoted = rc_is_promoted_raw(payload)
    let result = if promoted != 0 { rc_weak_retain(payload) } else { 0 - 2 }
    rc_atomic_unlock(payload)
    if promoted != 0 { result } else { rc_weak_retain(payload) }
  } }
}

fn rc_default_weak_release(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else { if rc_default_payload_has_magic(payload) != 1 { 0 - 1 }
  else {
    let heap = rc_default_heap()
    rc_atomic_lock(payload)
    let promoted = rc_is_promoted_raw(payload)
    let result = if promoted != 0 { rc_weak_release(heap, payload) } else { 0 - 2 }
    rc_atomic_unlock(payload)
    if promoted != 0 { result } else { rc_weak_release(heap, payload) }
  } }
}

fn rc_default_weak_load(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else { if rc_default_payload_has_magic(payload) != 1 { 0 }
  else {
    rc_atomic_lock(payload)
    let promoted = rc_is_promoted_raw(payload)
    let result = if promoted != 0 { rc_weak_load(payload) } else { 0 }
    rc_atomic_unlock(payload)
    if promoted != 0 { result } else { rc_weak_load(payload) }
  } }
}

fn rc_default_promote(payload: i64) -> i64 {
  rc_mark_promoted(payload)
}

fn closure_env_count_offset() -> i64 { 0 }
fn closure_env_entry_size() -> i64 { 16 }
fn closure_env_value_offset(index: i64) -> i64 {
  8 + index * closure_env_entry_size()
}
fn closure_env_kind_offset(index: i64) -> i64 {
  16 + index * closure_env_entry_size()
}
fn closure_env_is_rc_offset(index: i64) -> i64 {
  closure_env_kind_offset(index)
}

fn closure_default_retain(closure: i64) -> i64 {
  if rc_default_payload_has_magic(closure) == 1 { rc_default_retain(closure) } else { 0 - 1 }
}

fn closure_env_promote_captures_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let mut i = 0
    let mut promoted = 0
    while i < n {
      let value = __mem_load64(env + closure_env_value_offset(i))
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        promoted = promoted + rc_default_promote(value)
      } else { if kind == continuation_cleanup_kind_closure() {
        promoted = promoted + closure_default_promote(value)
      } else { if kind == continuation_cleanup_kind_weak() {
        promoted = promoted + rc_default_promote(value)
      } else { 0 } } }
      i = i + 1
    }
    promoted
  }
}

fn closure_default_promote(value: any) -> i64 {
  let closure = handle unsafe_transmute<any, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
  if closure == 0 { 0 }
  else { if rc_default_payload_has_magic(closure) != 1 { 0 }
  else {
    let promoted = rc_default_promote(closure)
    let env = __mem_load64(closure + 8)
    if env != 0 {
      promoted + rc_default_promote(env) + closure_env_promote_captures_raw(env)
    } else { promoted }
  } }
}

fn closure_env_bump_clone_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let clone = alloc_bump(8 + n * closure_env_entry_size())
    __mem_store64(clone + closure_env_count_offset(), n)
    let mut i = 0
    while i < n {
      let value = __mem_load64(env + closure_env_value_offset(i))
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      __mem_store64(clone + closure_env_value_offset(i), value)
      __mem_store64(clone + closure_env_kind_offset(i), kind)
      if kind == continuation_cleanup_kind_rc() {
        rc_default_retain(value)
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_retain(value)
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_retain(value)
      } else { 0 } } }
      i = i + 1
    }
    clone
  }
}

fn closure_env_release_captures_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_continuation() {
        continuation_drop_owned_managed(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } } } }
      i = i + 1
    }
    0
  }
}

fn closure_default_release_env(env: i64) -> i64 {
  if env == 0 { 0 - 1 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == continuation_cleanup_kind_rc() {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_closure() {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_continuation() {
        continuation_drop_owned_managed(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == continuation_cleanup_kind_weak() {
        rc_default_weak_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } } } }
      i = i + 1
    }
    rc_default_release(env)
  }
}

fn closure_default_release_promoted(closure: i64) -> i64 {
  if closure == 0 { 0 - 1 }
  else {
    let heap = rc_default_heap()
    let header = rc_header_from_payload(closure)
    rc_atomic_lock(closure)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 {
      rc_atomic_unlock(closure)
      0 - 1
    } else { if count == 1 {
      let env = __mem_load64(closure + 8)
      __mem_store64(header + rc_count_offset(), 0)
      rc_atomic_unlock(closure)
      if env != 0 { closure_default_release_env(env) } else { 0 }
      rc_atomic_lock(closure)
      let result = rc_finalize_zero_count_payload(heap, closure)
      rc_atomic_unlock(closure)
      result
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      rc_atomic_unlock(closure)
      next
    } }
  }
}

fn closure_default_release(closure: i64) -> i64 {
  if closure == 0 { 0 - 1 }
  else { if rc_default_payload_has_magic(closure) != 1 { 0 - 1 }
  else { if rc_is_promoted(closure) != 0 { closure_default_release_promoted(closure) }
  else {
    let count = rc_count(closure)
    if count == 1 {
      let env = __mem_load64(closure + 8)
      if env != 0 { closure_default_release_env(env) } else { 0 }
    } else { 0 }
    rc_default_release(closure)
  } } }
}

fn continuation_cleanup_segment_value(segment: i64, slot: i64) -> i64 {
  if segment == 0 { 0 }
  else { if slot < 0 { 0 } else { __mem_load64(segment + slot) } }
}

fn continuation_cleanup_release_value(kind: i64, value: i64) -> i64 {
  if value == 0 { 0 }
  else {
    if kind == continuation_cleanup_kind_rc() {
      rc_default_release(value)
      1
    } else { if kind == continuation_cleanup_kind_closure() {
      closure_default_release(value)
      1
    } else { if kind == continuation_cleanup_kind_weak() {
      rc_default_weak_release(value)
      1
    } else { 0 } } }
  }
}

fn continuation_cleanup_release_value_for(kind: i64, value: i64, dropping: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_rc(), value) }
  } else { if kind == continuation_cleanup_kind_closure_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_closure(), value) }
  } else { if kind == continuation_cleanup_kind_weak_drop_only() {
    if dropping == 0 { 0 } else { continuation_cleanup_release_value(continuation_cleanup_kind_weak(), value) }
  } else {
    continuation_cleanup_release_value(kind, value)
  } } }
}

fn continuation_cleanup_mark_entry_dead(desc: i64, index: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { 0 }
  else {
    __mem_store64(entry + continuation_cleanup_entry_live_offset(), 0)
    1
  }
}

fn continuation_cleanup_clear_segment_slot(segment: i64, slot: i64) -> i64 {
  if segment == 0 { 0 }
  else { if slot < 0 { 0 }
  else {
    __mem_store64(segment + slot, 0)
    1
  } }
}

fn continuation_cleanup_release_segment_for(k: i64, dropping: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status_is_owned(continuation_status(k)) == 0 { 0 }
  else {
    let desc = continuation_cleanup_desc(k)
    let segment = continuation_segment(k)
    if desc == 0 or segment == 0 { 0 }
    else {
      let n = continuation_cleanup_desc_count(desc)
      let mut released = 0
      let mut i = 0
      while i < n {
        if continuation_cleanup_desc_live(desc, i) != 0 {
          let kind = continuation_cleanup_desc_kind(desc, i)
          let slot = continuation_cleanup_desc_slot(desc, i)
          let value = continuation_cleanup_segment_value(segment, slot)
          continuation_cleanup_mark_entry_dead(desc, i)
          continuation_cleanup_clear_segment_slot(segment, slot)
          released = released + continuation_cleanup_release_value_for(kind, value, dropping)
        } else { 0 }
        i = i + 1
      }
      released
    }
  } }
}

fn continuation_cleanup_release_segment(k: i64) -> i64 {
  continuation_cleanup_release_segment_for(k, 0)
}

fn continuation_drop_managed(k: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status(k) != continuation_status_active() { 0 }
  else {
    continuation_cleanup_release_segment_for(k, 1)
    continuation_drop(k)
  } }
}

fn continuation_drop_owned_managed(k: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status_is_owned(continuation_status(k)) == 0 { 0 }
  else {
    continuation_cleanup_release_segment_for(k, 1)
    continuation_drop(k)
  } }
}

fn continuation_resume_managed(k: i64) -> i64 {
  if k == 0 { 0 }
  else { if continuation_status_is_owned(continuation_status(k)) == 0 { 0 }
  else {
    continuation_cleanup_release_segment(k)
    continuation_mark_resumed(k)
  } }
}

fn continuation_closure_token(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    let env = __mem_load64(k + 8)
    if env == 0 { 0 } else { __mem_load64(env + 8) }
  }
}

fn runtime_continuation_cell_new() -> i64 {
  let cell = alloc_bump(8)
  __mem_store64(cell, 0)
  cell
}

fn runtime_continuation_cell_is_full(cell: i64) -> i64 {
  if cell == 0 { 0 }
  else { if __mem_load64(cell) == 0 { 0 } else { 1 } }
}

fn continuation_cell_store_i64_raw(cell: i64, k: i64) -[Unsafe]> i64 {
  if cell == 0 { 0 }
  else { if k == 0 { 0 }
  else { if __mem_load64(cell) != 0 { 0 }
  else {
    let token = continuation_closure_token(k)
    if continuation_mark_stored(token) == 1 {
      closure_default_retain(k)
      __mem_store64(cell, k)
      1
    } else { 0 }
  } } }
}

fn runtime_continuation_cell_store_i64(cell: i64, k: Continuation<i64, i64>) -> i64 {
  handle continuation_cell_store_i64_raw(cell, k) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(0)
  }
}

fn continuation_cell_resume_i64_raw(cell: i64, value: i64, default: i64) -[Unsafe]> i64 {
  if cell == 0 { default }
  else {
    let k = __mem_load64(cell)
    if k == 0 { default }
    else {
      __mem_store64(cell, 0)
      let result = __call_closure_i64(k, value)
      closure_default_release(k)
      result
    }
  }
}

fn runtime_continuation_cell_resume_i64(cell: i64, value: i64, default: i64) -> i64 {
  handle continuation_cell_resume_i64_raw(cell, value, default) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(0)
  }
}

fn continuation_cell_drop_i64_raw(cell: i64) -> i64 {
  if cell == 0 { 0 }
  else {
    let k = __mem_load64(cell)
    if k == 0 { 0 }
    else {
      __mem_store64(cell, 0)
      let token = continuation_closure_token(k)
      let dropped = continuation_drop_owned_managed(token)
      closure_default_release(k)
      dropped
    }
  }
}

fn runtime_continuation_cell_drop_i64(cell: i64) -> i64 {
  continuation_cell_drop_i64_raw(cell)
}

fn runtime_generator_state_cell(state: i64) -> i64 {
  if state == 0 { 0 } else { __mem_load64(state) }
}

-- State layout: [prompt, current, has_current, done, result, producer].
-- The producer slot (+40) is an OWNING stash of the producer closure
-- (2q slice 2): the fiber references it across suspensions long after
-- the creating scope's release fires. Released once on completion or
-- drop (zero-guarded).
fn runtime_generator_state_new() -> i64 {
  let state = alloc_bump(48)
  __mem_store64(state, 0)
  __mem_store64(state + 8, 0)
  __mem_store64(state + 16, 0)
  __mem_store64(state + 24, 0)
  __mem_store64(state + 32, 0)
  __mem_store64(state + 40, 0)
  state
}

fn runtime_generator_state_release_producer(state: i64) -> i64 {
  if state == 0 { 0 }
  else {
    let producer = __mem_load64(state + 40)
    if producer == 0 { 0 }
    else {
      __mem_store64(state + 40, 0)
      closure_default_release(producer)
    }
  }
}

fn runtime_generator_state_has_current(state: i64) -> i64 {
  if state == 0 { 0 } else { __mem_load64(state + 16) }
}

fn runtime_generator_state_word_as<T>(value: i64) -> T {
  handle unsafe_transmute<i64, T>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_generator_state_word_from<T>(value: T) -> i64 {
  handle unsafe_transmute<T, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_generator_state_word_from_any(value: any) -> i64 {
  handle unsafe_transmute<any, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_generator_word_retain_maybe(value: i64) -> i64 {
  if rc_default_payload_has_magic(value) == 1 { rc_default_retain(value) } else { 0 }
}

fn runtime_generator_word_release_maybe(value: i64) -> i64 {
  if rc_default_payload_has_magic(value) == 1 { rc_default_release(value) } else { 0 }
}

fn runtime_generator_state_take_current<T>(state: i64) -> T {
  if runtime_generator_state_has_current(state) == 1 {
    let value = __mem_load64(state + 8)
    __mem_store64(state + 8, 0)
    __mem_store64(state + 16, 0)
    runtime_generator_state_word_as<T>(value)
  } else { runtime_generator_state_word_as<T>(0) }
}

fn runtime_generator_state_is_done(state: i64) -> i64 {
  if state == 0 { 1 } else { __mem_load64(state + 24) }
}

fn runtime_generator_state_result_word_or(state: i64, default_word: i64) -> i64 {
  if runtime_generator_state_is_done(state) == 1 {
    if state == 0 {
      runtime_generator_word_retain_maybe(default_word)
      default_word
    } else {
      let result = __mem_load64(state + 32)
      runtime_generator_word_retain_maybe(result)
      result
    }
  } else {
    runtime_generator_word_retain_maybe(default_word)
    default_word
  }
}

fn runtime_generator_state_mark_done_result(state: i64, value: i64) -> i64 {
  if state == 0 { 0 }
  else {
    __mem_store64(state + 24, 1)
    __mem_store64(state + 32, value)
    1
  }
}

fn runtime_generator_packet_new(value: i64) -> i64 {
  let packet = alloc_bump(16)
  __mem_store64(packet, 1)
  __mem_store64(packet + 8, value)
  packet
}

fn runtime_generator_packet_value(packet: i64) -> i64 {
  if packet == 0 { 0 } else { __mem_load64(packet + 8) }
}

fn runtime_generator_state_store_suspended_packet(state: i64, packet: i64) -> i64 {
  if state == 0 { 0 }
  else {
    let value = runtime_generator_packet_value(packet)
    runtime_generator_word_retain_maybe(value)
    __mem_store64(state + 8, value)
    __mem_store64(state + 16, 1)
    1
  }
}

fn runtime_generator_yield_word_raw(value: i64) -[Unsafe]> i64 {
  __fiber_suspend(runtime_generator_packet_new(value))
}

fn runtime_generator_yield_word(value: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_yield_word_raw(value))
  }
}

fn runtime_generator_body_raw(producer: i64) -[Unsafe]> i64 {
  __call_closure_i64(producer, 0)
}

fn runtime_generator_state_start_raw(producer: i64) -[Unsafe]> i64 {
  let state = runtime_generator_state_new()
  __mem_store64(state + 40, producer)
  closure_default_retain(producer)
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  __mem_store64(state, prompt)
  let result = fiber_trampoline(prompt, runtime_fn_addr_unsafe(runtime_generator_body_raw), producer)
  let done = fiber_is_done()
  if done == 1 {
    runtime_generator_state_mark_done_result(state, result)
    runtime_generator_state_release_producer(state)
  } else {
    runtime_generator_state_store_suspended_packet(state, result)
  }
  state
}

fn runtime_generator_state_start(producer: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_state_start_raw(producer))
  }
}

fn runtime_generator_state_resume_word_raw(state: i64, sent: i64) -[Unsafe]> i64 {
  if state == 0 { 0 }
  else {
    let prompt = __mem_load64(state)
    if prompt == 0 { 0 }
    else {
      let result = fiber_resume(prompt, sent)
      let done = fiber_is_done()
      if done == 1 {
        runtime_generator_state_mark_done_result(state, result)
        runtime_generator_state_release_producer(state)
        0
      } else {
        runtime_generator_packet_value(result)
      }
    }
  }
}

fn runtime_generator_state_resume_word(state: i64, sent: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_generator_state_resume_word_raw(state, sent))
  }
}

fn runtime_generator_state_drop(state: i64) -> i64 {
  if runtime_generator_state_is_done(state) == 1 {
    if state == 0 { 0 }
    else {
      let result = __mem_load64(state + 32)
      runtime_generator_word_release_maybe(result)
      __mem_store64(state + 32, 0)
      runtime_generator_state_release_producer(state)
      0
    }
  }
  else {
    let current = __mem_load64(state + 8)
    runtime_generator_word_release_maybe(current)
    __mem_store64(state + 8, 0)
    __mem_store64(state + 16, 0)
    __mem_store64(state + 24, 1)
    runtime_generator_state_release_producer(state)
    1
  }
}
