-- runtime/rc.weft -- explicit reference-counted heap blocks

use "runtime/alloc.weft"
use "runtime/effects.weft"
use "runtime/memory.weft"
use "runtime/thread.weft"
use "runtime/unsafe.weft"

fn rc_header_size() -> i64 { 48 }
fn rc_count_offset() -> i64 { 0 }
fn rc_payload_size_offset() -> i64 { 8 }
fn rc_weak_count_offset() -> i64 { 16 }
fn rc_promoted_offset() -> i64 { 24 }
fn rc_atomic_lock_offset() -> i64 { 32 }
fn rc_magic_offset() -> i64 { 40 }
fn rc_magic_value() -> i64 { 974319517 }
fn rc_default_heap_offset() -> i64 { 8 }
fn rc_default_heap_capacity() -> i64 { 16777216 }
fn rc_default_bounds_base_offset() -> i64 { 96 }
fn rc_default_bounds_end_offset() -> i64 { 104 }

fn rc_runtime_state_ptr() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

fn rc_atomic_lock_cell(payload: i64) -> i64 {
  rc_header_from_payload(payload) + rc_atomic_lock_offset()
}

fn rc_atomic_lock(payload: i64) -> i64 {
  __atomic_lock64(rc_atomic_lock_cell(payload))
}

fn rc_atomic_unlock(payload: i64) -> i64 {
  __atomic_unlock64(rc_atomic_lock_cell(payload))
}

fn rc_header_from_payload(payload: i64) -> i64 {
  payload - rc_header_size()
}

fn rc_payload_from_header(header: i64) -> i64 {
  header + rc_header_size()
}

fn rc_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_count_offset())
}

-- The header's size word packs the deep-release field mask into its
-- high 32 bits (2 bits per payload word: 0 none, 1 rc, 2 closure,
-- 3 weak; first 16 words). Sizes stay in the low 32 — every reader
-- must go through rc_size_word_size.
fn rc_size_word_size(word: i64) -> i64 { word band 4294967295 }
fn rc_size_word_mask(word: i64) -> i64 { (word bshr 32) band 4294967295 }

-- Payloads shorter than sixteen words leave the mask's high two bits
-- outside their field range. Runtime-owned containers use those bits
-- as a finalizer descriptor without widening the common RC header.
-- The payload-size check keeps a legitimate word-15 aggregate field
-- from ever being mistaken for a finalizer.
fn rc_finalizer_none() -> i64 { 0 }
fn rc_finalizer_buffer() -> i64 { 1 }
fn rc_finalizer_vector() -> i64 { 2 }
fn rc_finalizer_persistent_region() -> i64 { 3 }
fn rc_finalizer_shift() -> i64 { 30 }
fn rc_buffer_payload_size() -> i64 { 24 }
fn rc_vector_payload_size() -> i64 { 40 }
fn rc_persistent_region_payload_size() -> i64 { 16 }
fn rc_persistent_region_arena_next_offset() -> i64 { 32 }
-- One demand-paged 64 KiB reservation covers the measured 100-element
-- CHAMP lifetime without a growth mmap; physical pages are committed only
-- as path copies touch them. Larger families still chain doubling segments.
fn rc_persistent_region_initial_capacity() -> i64 { 65536 }

fn rc_finalizer_mask(kind: i64) -> i64 {
  kind bshl rc_finalizer_shift()
}

fn rc_size_word_finalizer(word: i64) -> i64 {
  let size = rc_size_word_size(word)
  let kind = rc_size_word_mask(word) bshr rc_finalizer_shift()
  if size == rc_buffer_payload_size() and kind == rc_finalizer_buffer() {
    kind
  } else { if size == rc_vector_payload_size() and kind == rc_finalizer_vector() {
    kind
  } else { if size == rc_persistent_region_payload_size() and kind == rc_finalizer_persistent_region() {
    kind
  } else {
    rc_finalizer_none()
  } } }
}

fn rc_payload_size(payload: i64) -> i64 {
  rc_size_word_size(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

fn rc_field_mask(payload: i64) -> i64 {
  rc_size_word_mask(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

fn rc_weak_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_weak_count_offset())
}

fn rc_is_promoted_raw(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

fn rc_is_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    rc_atomic_lock(payload)
    let result = rc_is_promoted_raw(payload)
    rc_atomic_unlock(payload)
    result
  }
}

fn rc_mark_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let result = if rc_is_promoted_raw(payload) != 0 {
      1
    } else {
      __mem_store64(header + rc_promoted_offset(), 1)
      1
    }
    rc_atomic_unlock(payload)
    result
  }
}

fn rc_block_size(payload: i64) -> i64 {
  rc_header_size() + rc_payload_size(payload)
}

fn rc_header_block_size(header: i64) -> i64 {
  rc_header_size() + rc_size_word_size(__mem_load64(header + rc_payload_size_offset()))
}

fn rc_free_if_unreferenced(heap: i64, header: i64) -> i64 {
  let strong = __mem_load64(header + rc_count_offset())
  let weak = __mem_load64(header + rc_weak_count_offset())
  if strong <= 0 and weak <= 0 {
    let block_size = rc_header_block_size(header)
    __mem_store64(header + rc_magic_offset(), 0)
    heap_free(heap, header, block_size)
  } else { 0 }
}

fn rc_finalize_zero_count_payload(heap: i64, payload: i64) -> i64 {
  let header = rc_header_from_payload(payload)
  let weak = __mem_load64(header + rc_weak_count_offset())
  if weak <= 0 {
    rc_free_if_unreferenced(heap, header)
  } else {
    mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
    0
  }
}

fn rc_alloc_core(heap: i64, payload_size: i64, align: i64, zero: i64) -> i64 {
  if heap == 0 { 0 }
  else { if payload_size < 0 { 0 }
  else {
    let block = heap_alloc(heap, rc_header_size() + payload_size, align)
    if block == 0 { 0 }
    else {
      __mem_store64(block + rc_count_offset(), 1)
      __mem_store64(block + rc_payload_size_offset(), payload_size)
      __mem_store64(block + rc_weak_count_offset(), 0)
      __mem_store64(block + rc_promoted_offset(), 0)
      __mem_store64(block + rc_atomic_lock_offset(), 0)
      __mem_store64(block + rc_magic_offset(), rc_magic_value())
      let payload = rc_payload_from_header(block)
      if zero == 1 { mem_zero(payload, payload_size) } else { 0 }
      payload
    }
  } }
}

fn rc_alloc(heap: i64, payload_size: i64, align: i64) -> i64 {
  rc_alloc_core(heap, payload_size, align, 1)
}

fn rc_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else {
      let next = count + 1
      __mem_store64(header + rc_count_offset(), next)
      next
    }
  }
}

fn rc_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      let weak = __mem_load64(header + rc_weak_count_offset())
      if weak <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else {
        mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
        0
      }
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      next
    } }
  } }
}

fn rc_weak_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let strong = __mem_load64(header + rc_count_offset())
    let weak = __mem_load64(header + rc_weak_count_offset())
    if strong <= 0 and weak <= 0 { 0 - 1 }
    else {
      let next = weak + 1
      __mem_store64(header + rc_weak_count_offset(), next)
      next
    }
  }
}

fn rc_weak_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let weak = __mem_load64(header + rc_weak_count_offset())
    if weak <= 0 { 0 - 1 }
    else {
      let next = weak - 1
      __mem_store64(header + rc_weak_count_offset(), next)
      let strong = __mem_load64(header + rc_count_offset())
      if next == 0 and strong <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else { next }
    }
  } }
}

fn rc_weak_load(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 }
    else {
      __mem_store64(header + rc_count_offset(), count + 1)
      payload
    }
  }
}

fn rc_atomic_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_retain(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_retain(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_atomic_weak_load(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_load(payload)
  rc_atomic_unlock(payload)
  result
}

fn rc_default_heap_cell() -> i64 {
  rc_runtime_state_ptr() + rc_default_heap_offset()
}

fn rc_default_heap_existing() -> i64 {
  __mem_load64(rc_default_heap_cell())
}

fn rc_default_bounds_update(heap: i64) -> i64 {
  let st = rc_runtime_state_ptr()
  let arena = heap_arena(heap)
  let base = arena_base(arena)
  __mem_store64(st + rc_default_bounds_base_offset(), base)
  __mem_store64(st + rc_default_bounds_end_offset(), base + arena_capacity(arena))
  0
}

fn rc_default_heap() -> i64 {
  let cell = rc_default_heap_cell()
  let heap = __mem_load64(cell)
  if heap != 0 { heap }
  else {
    let new_heap = heap_new(rc_default_heap_capacity())
    __mem_store64(cell, new_heap)
    rc_default_bounds_update(new_heap)
    new_heap
  }
}

fn rc_default_alloc(payload_size: i64, align: i64) -> i64 {
  rc_alloc(rc_default_heap(), payload_size, align)
}

fn rc_null_i64() -> rc i64 {
  handle unsafe_transmute<i64, rc i64>(0) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn rc_default_word_new(value: i64) -> rc i64 {
  let payload = rc_default_alloc(8, 8)
  if payload == 0 { rc_null_i64() }
  else {
    __mem_store64(payload, value)
    payload
  }
}

fn rc_default_word_load(payload: i64) -> i64 {
  if payload == 0 { 0 } else { __mem_load64(payload) }
}

fn rc_default_word_store(payload: i64, value: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    __mem_store64(payload, value)
    value
  }
}

-- The retain/release magic guard is the hottest code in ownership-
-- heavy programs (17%+ of self-compile before flattening): it reads
-- the CACHED arena bounds from runtime state (written at heap
-- creation and arena growth) instead of chasing heap -> arena ->
-- base/capacity through four calls per check.
fn rc_default_payload_has_magic(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let st = rc_runtime_state_ptr()
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    if base == 0 { 0 }
    else {
      let header = payload - rc_header_size()
      if header < base { 0 }
      else { if payload > __mem_load64(st + rc_default_bounds_end_offset()) { 0 }
      else { if __mem_load64(header + rc_magic_offset()) == rc_magic_value() { 1 } else { 0 } } }
    }
  }
}

fn rc_default_promote_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_default_promote(payload)
  } else { 0 }
}

fn rc_default_is_promoted_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_is_promoted(payload)
  } else { 0 }
}

fn region_promote_rc(src: i64, payload_size: i64, align: i64) -> rc i64 {
  let dst = rc_default_alloc(payload_size, align)
  if dst == 0 { rc_null_i64() } else {
    mem_copy(dst, src, payload_size)
  }
  dst
}

-- Promotion is a one-way transition that happens BEFORE a value
-- crosses threads, so promoted == 0 proves single-owner-thread and
-- needs no lock. Nonzero promoted words (real promotions, or a deep-
-- release worklist zombie link) take the locked path unchanged.
--
-- retain/release are the hottest calls in ownership-heavy programs;
-- their fast paths are SELF-CONTAINED (inline magic guard via the
-- cached bounds, inline count update) — no nested calls.
fn rc_default_retain_promoted_slow(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let promoted = rc_is_promoted_raw(payload)
  let result = if promoted != 0 { rc_retain(payload) } else { 0 - 2 }
  rc_atomic_unlock(payload)
  if promoted != 0 { result } else { rc_retain(payload) }
}

fn rc_default_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let header = payload - rc_header_size()
    if base == 0 or header < base or payload > __mem_load64(st + rc_default_bounds_end_offset()) { 0 - 1 }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { 0 - 1 }
    else {
      if __mem_load64(header + rc_promoted_offset()) != 0 { rc_default_retain_promoted_slow(payload) }
      else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { 0 - 1 }
        else {
          __mem_store64(header + rc_count_offset(), count + 1)
          count + 1
        }
      }
    } }
  }
}

-- Deep release (2q slice 2 stage B): a dying node drops one count on
-- each managed payload field per its header mask. The cascade is a
-- WORKLIST, not recursion — list spines are millions deep. Dying
-- nodes (count already 0, not yet freed) link the pending list
-- through their header's promoted word: it is 0 on the non-promoted
-- path, nobody mutates a zero-count zombie, and any stale release in
-- the window no-ops on count <= 0. Kernel §10 rejects mutable strong
-- cycles, so the walk terminates. Closure/weak fields and promoted
-- children release recursively (bounded shapes).
fn rc_deep_pending_push(pending: i64, payload: i64) -> i64 {
  __mem_store64(rc_header_from_payload(payload) + rc_promoted_offset(), pending)
  payload
}

fn rc_deep_pending_next(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

-- Runs once per managed child field of every dying node, so it is the
-- walk's inner loop. It used to make four real calls before touching a
-- count — has_magic (which itself calls rc_runtime_state_ptr),
-- rc_is_promoted_raw, rc_header_from_payload — none of which fold,
-- because param'd helpers do not. The guard is now written out inline
-- exactly as rc_default_retain/release do it (cached arena bounds from
-- runtime state, lockless promoted read); the param-less offset fns
-- fold to literals (2r).
fn rc_deep_release_child(child: i64, pending: i64) -> i64 {
  if child == 0 { pending }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let header = child - rc_header_size()
    if base == 0 or header < base or child > __mem_load64(st + rc_default_bounds_end_offset()) { pending }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { pending }
    else {
      let promoted = __mem_load64(header + rc_promoted_offset())
      if promoted != 0 {
        rc_default_release_promoted(child)
        pending
      } else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { pending }
        else { if count == 1 {
          __mem_store64(header + rc_count_offset(), 0)
          rc_deep_pending_push(pending, child)
        } else {
          __mem_store64(header + rc_count_offset(), count - 1)
          pending
        } }
      }
    } }
  }
}

fn rc_persistent_region_release_pending(payload: i64, pending_start: i64) -> i64 {
  let mut pending = pending_start
  let mut cleanup = __mem_load64(payload + 8)
  while cleanup != 0 {
    pending = rc_deep_release_child(__mem_load64(cleanup + 8), pending)
    cleanup = __mem_load64(cleanup)
  }
  let mut arena = __mem_load64(payload)
  while arena != 0 {
    let next = __mem_load64(arena + rc_persistent_region_arena_next_offset())
    arena_free(arena)
    arena = next
  }
  pending
}

fn rc_deep_release_custom(payload: i64, word: i64, pending_start: i64, heap: i64) -> i64 {
  let kind = rc_size_word_finalizer(word)
  if kind == rc_finalizer_buffer() {
    let data = __mem_load64(payload)
    let cap = __mem_load64(payload + 16)
    if data != 0 and cap > 0 { heap_free(heap, data, cap) } else { 0 }
    pending_start
  } else { if kind == rc_finalizer_vector() {
    let data = __mem_load64(payload)
    let len = __mem_load64(payload + 8)
    let cap = __mem_load64(payload + 16)
    let elem_size = __mem_load64(payload + 24)
    let elem_mode = __mem_load64(payload + 32)
    let mut pending = pending_start
    if data != 0 and elem_size > 0 and elem_mode == 8 {
      let mut i = 0
      while i < len {
        pending = rc_deep_release_child(__mem_load64(data + i * elem_size), pending)
        i = i + 1
      }
    } else { 0 }
    if data != 0 and cap > 0 and elem_size > 0 {
      heap_free(heap, data, cap * elem_size)
    } else { 0 }
    pending
  } else { if kind == rc_finalizer_persistent_region() {
    rc_persistent_region_release_pending(payload, pending_start)
  } else {
    pending_start
  } } }
}

fn rc_deep_release_walk(first: i64) -> i64 {
  let heap = rc_default_heap()
  let mut pending = first
  while pending != 0 {
    let node = pending
    pending = rc_deep_pending_next(node)
    let header = rc_header_from_payload(node)
    __mem_store64(header + rc_promoted_offset(), 0)
    let word = __mem_load64(header + rc_payload_size_offset())
    let mask = rc_size_word_mask(word)
    -- Ordinary aggregates never pay a finalizer call. Only descriptors
    -- using the high mask pair can be runtime containers (or a real
    -- word-15 field, rejected by the helper's payload-size check).
    if mask >= 1073741824 {
      pending = rc_deep_release_custom(node, word, pending, heap)
    } else { 0 }
    if mask != 0 {
      let words = rc_size_word_size(word) / 8
      let limit = if words < 16 { words } else { 16 }
      let mut i = 0
      while i < limit {
        let kind = (mask bshr (i * 2)) band 3
        if kind == 1 {
          pending = rc_deep_release_child(__mem_load64(node + i * 8), pending)
        } else { if kind == 2 {
          closure_default_release(__mem_load64(node + i * 8))
        } else { if kind == 3 {
          rc_default_weak_release(__mem_load64(node + i * 8))
        } else { 0 } } }
        i = i + 1
      }
    } else { 0 }
    -- Free the dead node inline: the non-weak bin push is the hot
    -- case (magic cleared, [next, size] written into the block, LIFO
    -- push). Weak survivors and oversize blocks take the general
    -- finalize/free path.
    let wk = __mem_load64(header + rc_weak_count_offset())
    if wk <= 0 {
      let rounded = (rc_header_size() + (word band 4294967295) + 7) / 8 * 8
      let need = if rounded < heap_min_block_size() { heap_min_block_size() } else { rounded }
      __mem_store64(header + rc_magic_offset(), 0)
      if need <= heap_bin_limit() {
        let cell = heap + 16 + (need / 8) * 8
        __mem_store64(header, __mem_load64(cell))
        __mem_store64(header + 8, need)
        __mem_store64(cell, header)
      } else {
        heap_free(heap, header, need)
      }
    } else {
      rc_finalize_zero_count_payload(heap, node)
    }
  }
  0
}

fn rc_default_release_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 {
      rc_atomic_unlock(payload)
      0 - 1
    } else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      -- Fields drop while the node still holds its lock: the locked
      -- count decision is what makes the walk race-free for promoted
      -- nodes. Child locks are distinct nodes (no cycles), so the
      -- nested releases cannot deadlock; non-promoted subtrees cascade
      -- iteratively inside rc_default_release.
      rc_deep_release_promoted_fields(payload)
      let weak = __mem_load64(header + rc_weak_count_offset())
      if weak <= 0 {
        rc_atomic_unlock(payload)
        rc_free_if_unreferenced(rc_default_heap(), header)
      } else {
        mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
        rc_atomic_unlock(payload)
        0
      }
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      rc_atomic_unlock(payload)
      next
    } }
  }
}

-- Promoted nodes walk their fields under the caller's lock; only
-- closure/weak/promoted children recurse — plain rc children cascade
-- through the worklist by re-entering rc_default_release.
fn rc_deep_release_promoted_fields(payload: i64) -> i64 {
  let header = rc_header_from_payload(payload)
  let word = __mem_load64(header + rc_payload_size_offset())
  let mask = rc_size_word_mask(word)
  let finalizer = if mask >= 1073741824 { rc_size_word_finalizer(word) } else { rc_finalizer_none() }
  if finalizer == rc_finalizer_buffer() {
    let data = __mem_load64(payload)
    let cap = __mem_load64(payload + 16)
    if data != 0 and cap > 0 { heap_free(rc_default_heap(), data, cap) } else { 0 }
  } else { if finalizer == rc_finalizer_vector() {
    let data = __mem_load64(payload)
    let len = __mem_load64(payload + 8)
    let cap = __mem_load64(payload + 16)
    let elem_size = __mem_load64(payload + 24)
    let elem_mode = __mem_load64(payload + 32)
    if data != 0 and elem_size > 0 and elem_mode == 8 {
      let mut j = 0
      while j < len {
