-- runtime/rc.weft -- explicit reference-counted heap blocks

use "runtime/alloc.weft"
use "runtime/memory.weft"

fn rc_header_size() -> i64 { 16 }
fn rc_count_offset() -> i64 { 0 }
fn rc_payload_size_offset() -> i64 { 8 }
fn rc_default_heap_offset() -> i64 { 8 }
fn rc_default_heap_capacity() -> i64 { 1048576 }

fn rc_header_from_payload(payload: i64) -> i64 {
  payload - rc_header_size()
}

fn rc_payload_from_header(header: i64) -> i64 {
  header + rc_header_size()
}

fn rc_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_count_offset())
}

fn rc_payload_size(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset())
}

fn rc_block_size(payload: i64) -> i64 {
  rc_header_size() + rc_payload_size(payload)
}

fn rc_alloc(heap: i64, payload_size: i64, align: i64) -> i64 {
  if heap == 0 { 0 }
  else { if payload_size < 0 { 0 }
  else {
    let block = heap_alloc(heap, rc_header_size() + payload_size, align)
    if block == 0 { 0 }
    else {
      __mem_store64(block + rc_count_offset(), 1)
      __mem_store64(block + rc_payload_size_offset(), payload_size)
      let payload = rc_payload_from_header(block)
      mem_zero(payload, payload_size)
      payload
    }
  } }
}

fn rc_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else {
      let next = count + 1
      __mem_store64(header + rc_count_offset(), next)
      next
    }
  }
}

fn rc_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else { if count == 1 {
      let size = rc_header_size() + __mem_load64(header + rc_payload_size_offset())
      __mem_store64(header + rc_count_offset(), 0)
      heap_free(heap, header, size)
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      next
    } }
  } }
}

fn rc_default_heap_cell() -> i64 {
  __runtime_state() + rc_default_heap_offset()
}

fn rc_default_heap() -> i64 {
  let cell = rc_default_heap_cell()
  let heap = __mem_load64(cell)
  if heap != 0 { heap }
  else {
    let new_heap = heap_new(rc_default_heap_capacity())
    __mem_store64(cell, new_heap)
    new_heap
  }
}

fn rc_default_alloc(payload_size: i64, align: i64) -> i64 {
  rc_alloc(rc_default_heap(), payload_size, align)
}

fn rc_default_retain(payload: i64) -> i64 {
  rc_retain(payload)
}

fn rc_default_release(payload: i64) -> i64 {
  rc_release(rc_default_heap(), payload)
}
