-- runtime/rc.weft -- explicit reference-counted heap blocks

use runtime/alloc.{*}
use runtime/effects.{*}
use runtime/memory.{*}
use runtime/syscall.{*}
use runtime/thread.{*}
use runtime/unsafe.{*}

pub(package) fn rc_header_size() -> i64 { 48 }
pub(package) fn rc_count_offset() -> i64 { 0 }
pub(package) fn rc_payload_size_offset() -> i64 { 8 }
pub(package) fn rc_weak_count_offset() -> i64 { 16 }
pub(package) fn rc_promoted_offset() -> i64 { 24 }
pub(package) fn rc_atomic_lock_offset() -> i64 { 32 }
pub(package) fn rc_magic_offset() -> i64 { 40 }
pub(package) fn rc_magic_value() -> i64 { 974319517 }
pub(package) fn rc_default_heap_offset() -> i64 { 8 }
pub(package) fn rc_default_heap_capacity() -> i64 { 16777216 }
pub(package) fn rc_default_bounds_base_offset() -> i64 { 96 }
pub(package) fn rc_default_bounds_end_offset() -> i64 { 104 }
-- Compiler twin: runtime_state_default_heap_init_lock_offset.
pub(package) fn rc_default_heap_init_lock_offset() -> i64 { 160 }

pub(package) fn rc_runtime_state_ptr() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

pub(package) fn rc_atomic_lock_cell(payload: i64) -> i64 {
  rc_header_from_payload(payload) + rc_atomic_lock_offset()
}

pub(package) fn rc_atomic_lock(payload: i64) -> i64 {
  __atomic_lock64(rc_atomic_lock_cell(payload))
}

pub(package) fn rc_atomic_unlock(payload: i64) -> i64 {
  __atomic_unlock64(rc_atomic_lock_cell(payload))
}

pub(package) fn rc_header_from_payload(payload: i64) -> i64 {
  payload - rc_header_size()
}

pub(package) fn rc_payload_from_header(header: i64) -> i64 {
  header + rc_header_size()
}

pub(package) fn rc_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_count_offset())
}

-- The header's size word packs the deep-release field mask into its
-- high 32 bits (2 bits per payload word: 0 none, 1 rc, 2 closure,
-- 3 weak; first 16 words). Bit 31 marks an inline aggregate whose arbitrary
-- managed-leaf walk is described by a compiler-generated layout descriptor;
-- actual payload sizes occupy the remaining low 31 bits. Every reader must go
-- through rc_size_word_size.
pub(package) fn rc_layout_descriptor_flag() -> i64 { 2147483648 }
pub(package) fn rc_size_word_size(word: i64) -> i64 { word band 2147483647 }
pub(package) fn rc_size_word_has_layout_descriptor(word: i64) -> i64 { if (word band rc_layout_descriptor_flag()) != 0 { 1 } else { 0 } }
pub(package) fn rc_size_word_mask(word: i64) -> i64 { (word bshr 32) band 4294967295 }

-- Payloads shorter than sixteen words leave the mask's high two bits
-- outside their field range. Runtime-owned containers use those bits
-- as a finalizer descriptor without widening the common RC header.
-- The payload-size check keeps a legitimate word-15 aggregate field
-- from ever being mistaken for a finalizer.
pub(package) fn rc_finalizer_none() -> i64 { 0 }
pub(package) fn rc_finalizer_buffer() -> i64 { 1 }
pub(package) fn rc_finalizer_vector() -> i64 { 2 }
pub(package) fn rc_finalizer_persistent_region() -> i64 { 3 }
pub(package) fn rc_finalizer_array_storage() -> i64 { 4 }
pub(package) fn rc_finalizer_shift() -> i64 { 30 }
pub(package) fn rc_buffer_payload_size() -> i64 { 24 }
pub(package) fn rc_vector_payload_size() -> i64 { 64 }
pub(package) fn rc_persistent_region_payload_size() -> i64 { 16 }
pub(package) fn rc_array_storage_payload_size() -> i64 { 48 }
pub(package) fn rc_vector_data_offset() -> i64 { 0 }
pub(package) fn rc_vector_len_offset() -> i64 { 8 }
pub(package) fn rc_vector_capacity_offset() -> i64 { 16 }
pub(package) fn rc_vector_element_size_offset() -> i64 { 24 }
pub(package) fn rc_vector_element_mode_offset() -> i64 { 32 }
pub(package) fn rc_vector_element_leaf_count_offset() -> i64 { 40 }
pub(package) fn rc_vector_element_leaf_stride_offset() -> i64 { 48 }
pub(package) fn rc_vector_element_leaf_kind_offset() -> i64 { 56 }
pub(package) fn rc_array_storage_data_offset() -> i64 { 0 }
pub(package) fn rc_array_storage_byte_size_offset() -> i64 { 8 }
pub(package) fn rc_array_storage_leaf_count_offset() -> i64 { 16 }
pub(package) fn rc_array_storage_leaf_stride_offset() -> i64 { 24 }
pub(package) fn rc_array_storage_leaf_kind_offset() -> i64 { 32 }
pub(package) fn rc_array_storage_drop_glue_offset() -> i64 { 40 }
-- Compiler-generated inline aggregate descriptor:
-- [magic, data byte size, entry count], then 32-byte entries
-- [byte offset, leaf count, byte stride, managed kind]. Described payloads
-- reserve word 0 for the descriptor pointer; aggregate data begins at +8.
pub(package) fn rc_layout_descriptor_magic() -> i64 { 6289345512910263 }
pub(package) fn rc_layout_descriptor_header_size() -> i64 { 24 }
pub(package) fn rc_layout_descriptor_entry_size() -> i64 { 32 }
pub(package) fn rc_layout_descriptor_data_offset() -> i64 { 8 }
pub(package) fn rc_layout_descriptor_offset_offset(index: i64) -> i64 { rc_layout_descriptor_header_size() + index * rc_layout_descriptor_entry_size() }
pub(package) fn rc_layout_descriptor_count_offset(index: i64) -> i64 { rc_layout_descriptor_offset_offset(index) + 8 }
pub(package) fn rc_layout_descriptor_stride_offset(index: i64) -> i64 { rc_layout_descriptor_offset_offset(index) + 16 }
pub(package) fn rc_layout_descriptor_kind_offset(index: i64) -> i64 { rc_layout_descriptor_offset_offset(index) + 24 }
pub(package) fn rc_persistent_region_arena_next_offset() -> i64 { 32 }
-- One demand-paged 64 KiB reservation covers the measured 100-element
-- CHAMP lifetime without a growth mmap; physical pages are committed only
-- as path copies touch them. Larger families still chain doubling segments.
pub(package) fn rc_persistent_region_initial_capacity() -> i64 { 65536 }

pub(package) fn rc_finalizer_mask(kind: i64) -> i64 {
  -- The compact descriptor has only three nonzero bit patterns. Array
  -- storage reuses raw pattern 1 at its unique six-word payload size;
  -- rc_size_word_finalizer maps that pair back to the semantic kind 4.
  let raw = if kind == rc_finalizer_array_storage() { rc_finalizer_buffer() } else { kind }
  raw bshl rc_finalizer_shift()
}

pub(package) fn rc_size_word_finalizer(word: i64) -> i64 {
  let size = rc_size_word_size(word)
  let kind = rc_size_word_mask(word) bshr rc_finalizer_shift()
  if size == rc_array_storage_payload_size() and kind == rc_finalizer_buffer() {
    rc_finalizer_array_storage()
  } else { if size == rc_buffer_payload_size() and kind == rc_finalizer_buffer() {
    kind
  } else { if size == rc_vector_payload_size() and kind == rc_finalizer_vector() {
    kind
  } else { if size == rc_persistent_region_payload_size() and kind == rc_finalizer_persistent_region() {
    kind
  } else {
    rc_finalizer_none()
  } } } }
}

pub(package) fn rc_payload_size(payload: i64) -> i64 {
  rc_size_word_size(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

pub(package) fn rc_field_mask(payload: i64) -> i64 {
  rc_size_word_mask(__mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset()))
}

pub(package) fn rc_weak_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_weak_count_offset())
}

pub(package) fn rc_is_promoted_raw(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

pub(package) fn rc_is_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    rc_atomic_lock(payload)
    let result = rc_is_promoted_raw(payload)
    rc_atomic_unlock(payload)
    result
  }
}

pub(package) fn rc_mark_promoted(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    rc_atomic_lock(payload)
    let result = if rc_is_promoted_raw(payload) != 0 {
      1
    } else {
      __mem_store64(header + rc_promoted_offset(), 1)
      1
    }
    rc_atomic_unlock(payload)
    result
  }
}

pub(package) fn rc_block_size(payload: i64) -> i64 {
  rc_header_size() + rc_payload_size(payload)
}

pub(package) fn rc_header_block_size(header: i64) -> i64 {
  rc_header_size() + rc_size_word_size(__mem_load64(header + rc_payload_size_offset()))
}

pub(package) fn rc_free_if_unreferenced(heap: i64, header: i64) -> i64 {
  let strong = __mem_load64(header + rc_count_offset())
  let weak = __mem_load64(header + rc_weak_count_offset())
  if strong <= 0 and weak <= 0 {
    let block_size = rc_header_block_size(header)
    __mem_store64(header + rc_magic_offset(), 0)
    heap_free(heap, header, block_size)
  } else { 0 }
}

pub(package) fn rc_finalize_zero_count_payload(heap: i64, payload: i64) -> i64 {
  let header = rc_header_from_payload(payload)
  let weak = __mem_load64(header + rc_weak_count_offset())
  if weak <= 0 {
    rc_free_if_unreferenced(heap, header)
  } else {
    mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
    0
  }
}

pub(package) fn rc_alloc_core(heap: i64, payload_size: i64, align: i64, zero: i64) -> i64 {
  if heap == 0 { 0 }
  else { if payload_size < 0 or payload_size >= rc_layout_descriptor_flag() { 0 }
  else {
    let block = heap_alloc(heap, rc_header_size() + payload_size, align)
    if block == 0 { 0 }
    else {
      __mem_store64(block + rc_count_offset(), 1)
      __mem_store64(block + rc_payload_size_offset(), payload_size)
      __mem_store64(block + rc_weak_count_offset(), 0)
      __mem_store64(block + rc_promoted_offset(), 0)
      __mem_store64(block + rc_atomic_lock_offset(), 0)
      __mem_store64(block + rc_magic_offset(), rc_magic_value())
      let payload = rc_payload_from_header(block)
      if zero == 1 { mem_zero(payload, payload_size) } else { 0 }
      payload
    }
  } }
}

pub(package) fn rc_alloc(heap: i64, payload_size: i64, align: i64) -> i64 {
  rc_alloc_core(heap, payload_size, align, 1)
}

pub(package) fn rc_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else {
      let next = count + 1
      __mem_store64(header + rc_count_offset(), next)
      next
    }
  }
}

pub(package) fn rc_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else { if count == 1 {
      __mem_store64(header + rc_count_offset(), 0)
      let weak = __mem_load64(header + rc_weak_count_offset())
      if weak <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else {
        mem_zero(payload, rc_size_word_size(__mem_load64(header + rc_payload_size_offset())))
        0
      }
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      next
    } }
  } }
}

pub(package) fn rc_weak_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let strong = __mem_load64(header + rc_count_offset())
    let weak = __mem_load64(header + rc_weak_count_offset())
    if strong <= 0 and weak <= 0 { 0 - 1 }
    else {
      let next = weak + 1
      __mem_store64(header + rc_weak_count_offset(), next)
      next
    }
  }
}

pub(package) fn rc_weak_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let weak = __mem_load64(header + rc_weak_count_offset())
    if weak <= 0 { 0 - 1 }
    else {
      let next = weak - 1
      __mem_store64(header + rc_weak_count_offset(), next)
      let strong = __mem_load64(header + rc_count_offset())
      if next == 0 and strong <= 0 {
        rc_free_if_unreferenced(heap, header)
      } else { next }
    }
  } }
}

pub(package) fn rc_weak_load(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 }
    else {
      __mem_store64(header + rc_count_offset(), count + 1)
      payload
    }
  }
}

pub(package) fn rc_atomic_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_retain(payload)
  rc_atomic_unlock(payload)
  result
}

pub(package) fn rc_atomic_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

pub(package) fn rc_atomic_weak_retain(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_retain(payload)
  rc_atomic_unlock(payload)
  result
}

pub(package) fn rc_atomic_weak_release(heap: i64, payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_release(heap, payload)
  rc_atomic_unlock(payload)
  result
}

pub(package) fn rc_atomic_weak_load(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let result = rc_weak_load(payload)
  rc_atomic_unlock(payload)
  result
}

pub(package) fn rc_default_heap_cell() -> i64 {
  rc_runtime_state_ptr() + rc_default_heap_offset()
}

pub(package) fn rc_default_heap_existing() -> i64 {
  __mem_load64(rc_default_heap_cell())
}

pub(package) fn rc_default_bounds_update(heap: i64) -> i64 {
  let st = rc_runtime_state_ptr()
  let arena = heap_arena(heap)
  let base = arena_base(arena)
  __mem_store64(st + rc_default_bounds_base_offset(), base)
  __mem_store64(st + rc_default_bounds_end_offset(), base + arena_capacity(arena))
  0
}

pub(package) fn rc_default_heap() -> i64 {
  let st = rc_runtime_state_ptr()
  let cell = rc_default_heap_cell()
  let heap = __mem_load64(cell)
  if heap != 0 { heap }
  else {
    __atomic_lock64(st + rc_default_heap_init_lock_offset())
    let current = __mem_load64(cell)
    let result = if current != 0 { current }
    else {
      let new_heap = heap_new(rc_default_heap_capacity())
      rc_default_bounds_update(new_heap)
      __mem_store64(cell, new_heap)
      new_heap
    }
    __atomic_unlock64(st + rc_default_heap_init_lock_offset())
    result
  }
}

-- The current arena is covered by two cached runtime-state words. Heap growth
-- leaves older arenas live because values and recyclable blocks may still
-- reside there, so a cache miss must consult the heap's geometric arena chain
-- before treating a word as unmanaged.
pub(package) fn rc_default_payload_header_in_heap(st: i64, payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let header = payload - rc_header_size()
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let end = __mem_load64(st + rc_default_bounds_end_offset())
    if base != 0 and header >= base and header + rc_header_size() <= end { 1 }
    else { heap_contains_range(__mem_load64(st + rc_default_heap_offset()), header, rc_header_size()) }
  }
}

pub(package) fn rc_default_alloc(payload_size: i64, align: i64) -> i64 {
  rc_alloc(rc_default_heap(), payload_size, align)
}

pub(package) fn rc_null_i64() -> rc i64 {
  handle unsafe_transmute<i64, rc i64>(0) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn rc_default_word_new(value: i64) -> rc i64 {
  let payload = rc_default_alloc(8, 8)
  if payload == 0 { rc_null_i64() }
  else {
    __mem_store64(payload, value)
    payload
  }
}

pub(package) fn rc_default_word_load(payload: i64) -> i64 {
  if payload == 0 { 0 } else { __mem_load64(payload) }
}

pub(package) fn rc_default_word_store(payload: i64, value: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    __mem_store64(payload, value)
    value
  }
}

-- The retain/release magic guard is the hottest code in ownership-
-- heavy programs (17%+ of self-compile before flattening): it reads
-- the CACHED arena bounds from runtime state (written at heap
-- creation and arena growth) instead of chasing heap -> arena ->
-- base/capacity through four calls per check.
pub(package) fn rc_default_payload_has_magic(payload: i64) -> i64 {
  if payload == 0 { 0 }
  else {
    let st = rc_runtime_state_ptr()
    if rc_default_payload_header_in_heap(st, payload) == 0 { 0 }
    else {
      let header = payload - rc_header_size()
      if __mem_load64(header + rc_magic_offset()) == rc_magic_value() { 1 } else { 0 }
    }
  }
}

pub(package) fn rc_default_promote_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_default_promote(payload)
  } else { 0 }
}

pub(package) fn rc_default_is_promoted_maybe(payload: i64) -> i64 {
  if rc_default_payload_has_magic(payload) == 1 {
    rc_is_promoted(payload)
  } else { 0 }
}

pub(package) fn region_promote_rc(src: i64, payload_size: i64, align: i64) -> rc i64 {
  let dst = rc_default_alloc(payload_size, align)
  if dst == 0 { rc_null_i64() } else {
    mem_copy(dst, src, payload_size)
  }
  dst
}

-- Promotion is a one-way transition that happens BEFORE a value
-- crosses threads, so promoted == 0 proves single-owner-thread and
-- needs no lock. Nonzero promoted words (real promotions, or a deep-
-- release worklist zombie link) take the locked path unchanged.
--
-- retain/release are the hottest calls in ownership-heavy programs;
-- their fast paths are SELF-CONTAINED (inline magic guard via the
-- cached bounds, inline count update) — no nested calls.
pub(package) fn rc_default_retain_promoted_slow(payload: i64) -> i64 {
  rc_atomic_lock(payload)
  let promoted = rc_is_promoted_raw(payload)
  let result = if promoted != 0 { rc_retain(payload) } else { 0 - 2 }
  rc_atomic_unlock(payload)
  if promoted != 0 { result } else { rc_retain(payload) }
}

pub(package) fn rc_default_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let header = payload - rc_header_size()
    -- Keep the common ownership path call-free. This is the same exact
    -- current-arena proof as rc_default_payload_header_in_heap; only a miss
    -- enters the preserved-arena chain.
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let end = __mem_load64(st + rc_default_bounds_end_offset())
    let in_heap = if base != 0 and header >= base and header + rc_header_size() <= end {
      1
    } else { heap_contains_range(__mem_load64(st + rc_default_heap_offset()), header, rc_header_size()) }
    if in_heap == 0 { 0 - 1 }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { 0 - 1 }
    else {
      if __mem_load64(header + rc_promoted_offset()) != 0 { rc_default_retain_promoted_slow(payload) }
      else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { 0 - 1 }
        else {
          __mem_store64(header + rc_count_offset(), count + 1)
          count + 1
        }
      }
    } }
  }
}

-- Deep release (managed aggregate cleanup): a dying node drops one count on
-- each managed payload field per its header mask. The cascade is a
-- WORKLIST, not recursion — list spines are millions deep. Dying
-- nodes (count already 0, not yet freed) link the pending list
-- through their header's promoted word: it is 0 on the non-promoted
-- path, nobody mutates a zero-count zombie, and any stale release in
-- the window no-ops on count <= 0. Kernel §10 rejects mutable strong
-- cycles, so the walk terminates. Closure/weak fields and promoted
-- children release recursively (bounded shapes).
pub(package) fn rc_deep_pending_push(pending: i64, payload: i64) -> i64 {
  __mem_store64(rc_header_from_payload(payload) + rc_promoted_offset(), pending)
  payload
}

pub(package) fn rc_deep_pending_next(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_promoted_offset())
}

-- Runs once per managed child field of every dying node, so it is the
-- walk's inner loop. It used to make four real calls before touching a
-- count — has_magic (which itself calls rc_runtime_state_ptr),
-- rc_is_promoted_raw, rc_header_from_payload — none of which fold,
-- because param'd helpers do not. The guard is now written out inline
-- exactly as rc_default_retain/release do it (cached arena bounds from
-- runtime state, lockless promoted read); the param-less offset fns
-- fold to literals (managed-reference elision).
pub(package) fn rc_deep_release_child(child: i64, pending: i64) -> i64 {
  if child == 0 { pending }
  else {
    let st = handle unsafe_runtime_state() {
      Unsafe.runtime_state() -> resume(__runtime_state())
    }
    let header = child - rc_header_size()
    let base = __mem_load64(st + rc_default_bounds_base_offset())
    let end = __mem_load64(st + rc_default_bounds_end_offset())
    let in_heap = if base != 0 and header >= base and header + rc_header_size() <= end {
      1
    } else { heap_contains_range(__mem_load64(st + rc_default_heap_offset()), header, rc_header_size()) }
    if in_heap == 0 { pending }
    else { if __mem_load64(header + rc_magic_offset()) != rc_magic_value() { pending }
    else {
      let promoted = __mem_load64(header + rc_promoted_offset())
      if promoted != 0 {
        rc_default_release_promoted(child)
        pending
      } else {
        let count = __mem_load64(header + rc_count_offset())
        if count <= 0 { pending }
        else { if count == 1 {
          __mem_store64(header + rc_count_offset(), 0)
          rc_deep_pending_push(pending, child)
        } else {
          __mem_store64(header + rc_count_offset(), count - 1)
          pending
        } }
      }
    } }
  }
}

pub(package) fn rc_persistent_region_release_registered_pending(value: i64, kind: i64, pending: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() {
    rc_deep_release_child(value, pending)
  } else { if kind == continuation_cleanup_kind_closure() {
    closure_default_release(value)
    pending
  } else { if kind == continuation_cleanup_kind_weak() {
    rc_default_weak_release(value)
    pending
  } else { pending } } }
}

pub(package) fn rc_persistent_region_release_registered(value: i64, kind: i64) -> i64 {
  if kind == continuation_cleanup_kind_rc() {
    rc_default_release(value)
  } else { if kind == continuation_cleanup_kind_closure() {
    closure_default_release(value)
  } else { if kind == continuation_cleanup_kind_weak() {
    rc_default_weak_release(value)
  } else { 0 } } }
}

pub(package) fn rc_persistent_region_release_pending(payload: i64, pending_start: i64) -> i64 {
  let mut pending = pending_start
  let mut cleanup = __mem_load64(payload + 8)
  while cleanup != 0 {
