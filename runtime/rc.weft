-- runtime/rc.weft -- explicit reference-counted heap blocks

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "stdlib/unsafe.weft"

fn rc_header_size() -> i64 { 16 }
fn rc_count_offset() -> i64 { 0 }
fn rc_payload_size_offset() -> i64 { 8 }
fn rc_default_heap_offset() -> i64 { 8 }
fn rc_default_heap_capacity() -> i64 { 1048576 }

fn rc_runtime_state_ptr() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

fn rc_header_from_payload(payload: i64) -> i64 {
  payload - rc_header_size()
}

fn rc_payload_from_header(header: i64) -> i64 {
  header + rc_header_size()
}

fn rc_count(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_count_offset())
}

fn rc_payload_size(payload: i64) -> i64 {
  __mem_load64(rc_header_from_payload(payload) + rc_payload_size_offset())
}

fn rc_block_size(payload: i64) -> i64 {
  rc_header_size() + rc_payload_size(payload)
}

fn rc_alloc(heap: i64, payload_size: i64, align: i64) -> i64 {
  if heap == 0 { 0 }
  else { if payload_size < 0 { 0 }
  else {
    let block = heap_alloc(heap, rc_header_size() + payload_size, align)
    if block == 0 { 0 }
    else {
      __mem_store64(block + rc_count_offset(), 1)
      __mem_store64(block + rc_payload_size_offset(), payload_size)
      let payload = rc_payload_from_header(block)
      mem_zero(payload, payload_size)
      payload
    }
  } }
}

fn rc_retain(payload: i64) -> i64 {
  if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else {
      let next = count + 1
      __mem_store64(header + rc_count_offset(), next)
      next
    }
  }
}

fn rc_release(heap: i64, payload: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if payload == 0 { 0 - 1 }
  else {
    let header = rc_header_from_payload(payload)
    let count = __mem_load64(header + rc_count_offset())
    if count <= 0 { 0 - 1 }
    else { if count == 1 {
      let size = rc_header_size() + __mem_load64(header + rc_payload_size_offset())
      __mem_store64(header + rc_count_offset(), 0)
      heap_free(heap, header, size)
    } else {
      let next = count - 1
      __mem_store64(header + rc_count_offset(), next)
      next
    } }
  } }
}

fn rc_default_heap_cell() -> i64 {
  rc_runtime_state_ptr() + rc_default_heap_offset()
}

fn rc_default_heap() -> i64 {
  let cell = rc_default_heap_cell()
  let heap = __mem_load64(cell)
  if heap != 0 { heap }
  else {
    let new_heap = heap_new(rc_default_heap_capacity())
    __mem_store64(cell, new_heap)
    new_heap
  }
}

fn rc_default_alloc(payload_size: i64, align: i64) -> i64 {
  rc_alloc(rc_default_heap(), payload_size, align)
}

fn rc_default_retain(payload: i64) -> i64 {
  rc_retain(payload)
}

fn rc_default_release(payload: i64) -> i64 {
  rc_release(rc_default_heap(), payload)
}

fn closure_env_count_offset() -> i64 { 0 }
fn closure_env_entry_size() -> i64 { 16 }
fn closure_env_value_offset(index: i64) -> i64 {
  8 + index * closure_env_entry_size()
}
fn closure_env_kind_offset(index: i64) -> i64 {
  16 + index * closure_env_entry_size()
}
fn closure_env_is_rc_offset(index: i64) -> i64 {
  closure_env_kind_offset(index)
}

fn closure_default_retain(closure: i64) -> i64 {
  rc_default_retain(closure)
}

fn closure_env_bump_clone_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let clone = alloc_bump(8 + n * closure_env_entry_size())
    __mem_store64(clone + closure_env_count_offset(), n)
    let mut i = 0
    while i < n {
      let value = __mem_load64(env + closure_env_value_offset(i))
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      __mem_store64(clone + closure_env_value_offset(i), value)
      __mem_store64(clone + closure_env_kind_offset(i), kind)
      if kind == 1 {
        rc_default_retain(value)
      } else { if kind == 2 {
        closure_default_retain(value)
      } else { 0 } }
      i = i + 1
    }
    clone
  }
}

fn closure_env_release_captures_raw(env: i64) -> i64 {
  if env == 0 { 0 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == 1 {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == 2 {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } }
      i = i + 1
    }
    0
  }
}

fn closure_default_release_env(env: i64) -> i64 {
  if env == 0 { 0 - 1 }
  else {
    let n = __mem_load64(env + closure_env_count_offset())
    let mut i = 0
    while i < n {
      let kind = __mem_load64(env + closure_env_kind_offset(i))
      if kind == 1 {
        rc_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { if kind == 2 {
        closure_default_release(__mem_load64(env + closure_env_value_offset(i)))
      } else { 0 } }
      i = i + 1
    }
    rc_default_release(env)
  }
}

fn closure_default_release(closure: i64) -> i64 {
  if closure == 0 { 0 - 1 }
  else {
    let count = rc_count(closure)
    if count == 1 {
      let env = __mem_load64(closure + 8)
      if env != 0 { closure_default_release_env(env) } else { 0 }
    } else { 0 }
    rc_default_release(closure)
  }
}
