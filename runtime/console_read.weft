-- runtime/console_read.weft — package-private host standard-input leaf

use runtime/descriptor_io.{descriptor_read_append}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/io/types.{
  IoError,
  IoInterrupted,
  IoInvalidProgress,
  IoLimitExceeded,
  io_error_from_errno
}
use stdlib/num
use stdlib/result.{Result, Err, Ok}
use stdlib/vector as vector

fn runtime_safe_console_read_chunk_size() -> i64 { 4096 }

fn runtime_safe_console_read_limit_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

pub(package) fn runtime_safe_console_read(limit: usize) -> Result<Bytes, IoError> {
  let raw_limit = runtime_safe_console_read_limit_i64(limit)
  if raw_limit < 0 {
    Err<Bytes, IoError>(IoLimitExceeded(limit))
  } else {
    if raw_limit == 0 {
      Ok<Bytes, IoError>(bytes.empty())
    } else {
      let request = if raw_limit < runtime_safe_console_read_chunk_size() { raw_limit } else {
        runtime_safe_console_read_chunk_size()
      }
      let mut out = vector.with_capacity<u8>(
        request.to_usize_checked().expect("console read request is nonnegative")
      )
      let mut done = false
      let mut failed = false
      let mut failure = IoInvalidProgress
      while not done and not failed {
        let status = descriptor_read_append(0, out, __i64_to_usize(request))
        if status >= 0 and status <= request {
          done = true
        } else {
          if status > request {
            failure = IoInvalidProgress
            failed = true
          } else {
            match io_error_from_errno(status) {
              IoInterrupted -> 0
              error -> {
                failure = error
                failed = true
                0
              }
            }
          }
        }
      }
      if failed {
        Err<Bytes, IoError>(failure)
      } else {
        Ok<Bytes, IoError>(bytes.from_vector(out))
      }
    }
  }
}
