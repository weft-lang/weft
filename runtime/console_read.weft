-- runtime/console_read.weft — production terminal input interpretation

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/console.{ConsoleRead}
use stdlib/io.{raw_read}
use stdlib/io/types.{IoError, IoInterrupted, IoInvalidProgress, IoLimitExceeded, io_error_from_errno}
use stdlib/num
use stdlib/result.{Result, Err, Ok}
use stdlib/vector as vector
use stdlib/vector.{vector_data, vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

fn runtime_safe_console_read_chunk_size() -> i64 { 4096 }

fn runtime_safe_console_read_limit_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

fn runtime_safe_console_read_scratch() -> Vector<u8> {
  let size = runtime_safe_console_read_chunk_size()
  let values = vector.with_capacity<u8>(size.to_usize_checked().expect("console scratch size is nonnegative"))
  for i in 0..size { vector_push<u8>(values, 0) }
  values
}

pub(package) fn runtime_safe_console_read(limit: usize) -> Result<Bytes, IoError> {
  let raw_limit = runtime_safe_console_read_limit_i64(limit)
  if raw_limit < 0 {
    Err<Bytes, IoError>(IoLimitExceeded(limit))
  } else { if raw_limit == 0 {
    Ok<Bytes, IoError>(bytes.empty())
  } else {
    let request = if raw_limit < runtime_safe_console_read_chunk_size() { raw_limit } else { runtime_safe_console_read_chunk_size() }
    let scratch = runtime_safe_console_read_scratch()
    let mut done = false
    let mut failed = false
    let mut count = 0
    let mut failure = IoInvalidProgress
    while not done and not failed {
      let status = raw_read(0, vector_data<u8>(scratch), request)
      if status >= 0 and status <= request {
        count = status
        done = true
      } else { if status > request {
        failure = IoInvalidProgress
        failed = true
      } else {
        match io_error_from_errno(status) {
          IoInterrupted -> 0
          error -> {
            failure = error
            failed = true
            0
          }
        }
      } }
    }
    if failed {
      Err<Bytes, IoError>(failure)
    } else {
      let out = vector.with_capacity<u8>(count.to_usize_checked().expect("console read count is validated"))
      for i in 0..count { vector_push<u8>(out, vector_get_in_bounds<u8>(scratch, i)) }
      Ok<Bytes, IoError>(bytes.from_vector(out))
    }
  } }
}

--- Install the host terminal as the interpretation of ConsoleRead.
pub implements ConsoleRead() {
  ConsoleRead.read(limit) -> resume(runtime_safe_console_read(limit))
}
