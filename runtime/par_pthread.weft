-- runtime/par_pthread.weft -- trusted pthread spawn/join bridge for Par

use "runtime/alloc.weft"
use "runtime/thread.weft"
use "runtime/unsafe.weft"

fn runtime_par_handle_magic() -> i64 { 7319521 }
fn runtime_par_handle_magic_offset() -> i64 { 0 }
fn runtime_par_handle_tid_offset() -> i64 { 8 }
fn runtime_par_handle_joined_offset() -> i64 { 16 }
fn runtime_par_handle_size() -> i64 { 24 }

fn runtime_par_pair_status_offset() -> i64 { 0 }
fn runtime_par_pair_value_offset() -> i64 { 8 }
fn runtime_par_pair_size() -> i64 { 16 }

fn runtime_par_pair_new(status: i64, value: i64) -> i64 {
  let pair = alloc_bump(runtime_par_pair_size())
  __mem_store64(pair + runtime_par_pair_status_offset(), status)
  __mem_store64(pair + runtime_par_pair_value_offset(), value)
  pair
}

fn runtime_par_pair_status(pair: i64) -> i64 {
  __mem_load64(pair + runtime_par_pair_status_offset())
}

fn runtime_par_pair_value(pair: i64) -> i64 {
  __mem_load64(pair + runtime_par_pair_value_offset())
}

fn runtime_par_pthread_make_handle(tid: i64) -> i64 {
  let hnd = alloc_bump(runtime_par_handle_size())
  __mem_store64(hnd + runtime_par_handle_magic_offset(), runtime_par_handle_magic())
  __mem_store64(hnd + runtime_par_handle_tid_offset(), tid)
  __mem_store64(hnd + runtime_par_handle_joined_offset(), 0)
  hnd
}

fn runtime_par_pthread_handle_is_valid(h: i64) -> bool {
  if h == 0 {
    false
  } else {
    __mem_load64(h + runtime_par_handle_magic_offset()) == runtime_par_handle_magic()
  }
}

fn runtime_par_pthread_handle_joined(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_joined_offset())
}

fn runtime_par_pthread_handle_mark_joined(h: i64) -> i64 {
  __mem_store64(h + runtime_par_handle_joined_offset(), 1)
  1
}

fn runtime_par_pthread_handle_tid(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_tid_offset())
}

fn runtime_par_pthread_spawn(f: (i64) -> i64, arg: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let tid = alloc_bump(8)
      let status = __got_pthread_create(tid, 0, runtime_fn_addr(f), arg, 0, 0)
      let thread_id = if status == 0 { __mem_load64(tid) } else { 0 }
      resume(runtime_par_pair_new(status, thread_id))
    }
  }
}

fn runtime_par_pthread_spawn_unsafe(f: (i64) -[Unsafe]> i64, arg: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let tid = alloc_bump(8)
      let status = __got_pthread_create(tid, 0, runtime_fn_addr_unsafe(f), arg, 0, 0)
      let thread_id = if status == 0 { __mem_load64(tid) } else { 0 }
      resume(runtime_par_pair_new(status, thread_id))
    }
  }
}

fn runtime_par_pthread_join_handle(h: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let retval = alloc_bump(8)
      let status = __got_pthread_join(runtime_par_pthread_handle_tid(h), retval, 0, 0, 0, 0)
      let value = if status == 0 { __mem_load64(retval) } else { 0 }
      resume(runtime_par_pair_new(status, value))
    }
  }
}
