-- runtime/par_pthread.weft -- trusted pthread spawn/join bridge for Par

use runtime/alloc.{*}
use runtime/syscall.{*}
use runtime/thread.{*}
use runtime/unsafe.{*}

pub (package) fn runtime_par_handle_magic() -> i64 { 7319521 }

pub (package) fn runtime_par_handle_magic_offset() -> i64 { 0 }

pub (package) fn runtime_par_handle_tid_offset() -> i64 { 8 }

pub (package) fn runtime_par_handle_joined_offset() -> i64 { 16 }

pub (package) fn runtime_par_handle_stack_base_offset() -> i64 { 24 }

pub (package) fn runtime_par_handle_stack_size_offset() -> i64 { 32 }

pub (package) fn runtime_par_handle_result_offset() -> i64 { 40 }

pub (package) fn runtime_par_handle_size() -> i64 { 48 }

pub (package) fn runtime_par_thread_guard_size() -> i64 { 65536 }

pub (package) fn runtime_par_pair_status_offset() -> i64 { 0 }

pub (package) fn runtime_par_pair_value_offset() -> i64 { 8 }

pub (package) fn runtime_par_pair_size() -> i64 { 16 }

pub (package) fn runtime_par_pair_new(status: i64, value: i64) -> i64 {
  let pair = alloc_bump(runtime_par_pair_size())
  __mem_store64(pair + runtime_par_pair_status_offset(), status)
  __mem_store64(pair + runtime_par_pair_value_offset(), value)
  pair
}

pub (package) fn runtime_par_pair_status(pair: i64) -> i64 {
  __mem_load64(pair + runtime_par_pair_status_offset())
}

pub (package) fn runtime_par_pair_value(pair: i64) -> i64 {
  __mem_load64(pair + runtime_par_pair_value_offset())
}

pub (package) fn runtime_par_pthread_make_handle(tid: i64) -> i64 {
  let hnd = alloc_bump(runtime_par_handle_size())
  __mem_store64(hnd + runtime_par_handle_magic_offset(), runtime_par_handle_magic())
  __mem_store64(hnd + runtime_par_handle_tid_offset(), tid)
  __mem_store64(hnd + runtime_par_handle_joined_offset(), 0)
  __mem_store64(hnd + runtime_par_handle_stack_base_offset(), 0)
  __mem_store64(hnd + runtime_par_handle_stack_size_offset(), 0)
  __mem_store64(hnd + runtime_par_handle_result_offset(), 0)
  hnd
}

pub (package) fn runtime_par_pthread_handle_is_valid(h: i64) -> bool {
  if h == 0 {
    false
  } else {
    __mem_load64(h + runtime_par_handle_magic_offset()) == runtime_par_handle_magic()
  }
}

pub (package) fn runtime_par_pthread_handle_joined(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_joined_offset())
}

pub (package) fn runtime_par_pthread_handle_mark_joined(h: i64) -> i64 {
  __mem_store64(h + runtime_par_handle_joined_offset(), 1)
  1
}

pub (package) fn runtime_par_pthread_handle_tid(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_tid_offset())
}

pub (package) fn runtime_par_pthread_handle_stack_base(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_stack_base_offset())
}

pub (package) fn runtime_par_pthread_handle_stack_size(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_stack_size_offset())
}

pub (package) fn runtime_par_pthread_handle_result(h: i64) -> i64 {
  __mem_load64(h + runtime_par_handle_result_offset())
}

pub (package) fn runtime_par_pthread_release_stack(h: i64) -> i64 {
  let base = runtime_par_pthread_handle_stack_base(h)
  let size = runtime_par_pthread_handle_stack_size(h)
  if base != 0 and size > 0 {
    let status = sys_munmap(base, size)
    if status == 0 {
      __mem_store64(h + runtime_par_handle_stack_base_offset(), 0)
      __mem_store64(h + runtime_par_handle_stack_size_offset(), 0)
    } else { 0 }
    status
  } else { 0 }
}

pub (package) fn runtime_par_pthread_spawn_addr(entry: i64, arg: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let hnd = runtime_par_pthread_make_handle(0)
      let stack_size = __platform_thread_stack_size()
      let stack_base = if stack_size > 0 { sys_map_rw_anonymous(0, stack_size) } else { 0 }
      let map_status = if stack_size > 0 and stack_base <= 0 {
        if stack_base < 0 { 0 - stack_base } else { 12 }
      } else { 0 }
      let guard_status = if map_status == 0 and stack_size > 0 {
        let raw = __platform_thread_stack_guard(stack_base, runtime_par_thread_guard_size())
        if raw < 0 { 0 - raw } else { raw }
      } else { map_status }
      if guard_status != 0 {
        if stack_base > 0 { sys_munmap(stack_base, stack_size) } else { 0 }
        resume(runtime_par_pair_new(guard_status, 0))
      } else {
        __mem_store64(hnd + runtime_par_handle_stack_base_offset(), stack_base)
        __mem_store64(hnd + runtime_par_handle_stack_size_offset(), stack_size)
        let status = __platform_thread_create(
          hnd + runtime_par_handle_tid_offset(),
          entry,
          arg,
          stack_base + stack_size,
          hnd + runtime_par_handle_result_offset()
        )
        if status == 0 {
          resume(runtime_par_pair_new(0, hnd))
        } else {
          runtime_par_pthread_release_stack(hnd)
          resume(runtime_par_pair_new(status, 0))
        }
      }
    }
  }
}

pub (package) fn runtime_par_pthread_spawn(f: (i64) -> i64, arg: i64) -> i64 {
  runtime_par_pthread_spawn_addr(runtime_fn_addr(f), arg)
}

pub (package) fn runtime_par_pthread_spawn_unsafe(f: (i64) -[Unsafe]> i64, arg: i64) -> i64 {
  runtime_par_pthread_spawn_addr(runtime_fn_addr_unsafe(f), arg)
}

pub (package) fn runtime_par_pthread_join_handle(h: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let status = __platform_thread_join(
        h + runtime_par_handle_tid_offset(),
        h + runtime_par_handle_result_offset()
      )
      let value = if status == 0 { runtime_par_pthread_handle_result(h) } else { 0 }
      if status == 0 { runtime_par_pthread_release_stack(h) } else { 0 }
      resume(runtime_par_pair_new(status, value))
    }
  }
}
