-- runtime/process_environment.weft — platform processes with a given environment
--
-- A second platform interpretation of Proc beside runtime/process. Children
-- receive exactly the caller's environment entries instead of this process's
-- own, so tests and tools can start children deterministically. The clauses
-- call the process runtime's typed leaves, which perform process authority
-- behind pure signatures and therefore stay inside the trusted runtime.

use runtime/process.{
  RuntimeProcExplicit,
  runtime_proc_limit,
  runtime_proc_open_session_safe,
  runtime_proc_release_safe,
  runtime_proc_run_safe,
  runtime_proc_session_close_input_safe,
  runtime_proc_session_finish_until_safe,
  runtime_proc_session_read_safe,
  runtime_proc_session_release_safe,
  runtime_proc_session_write_safe,
  runtime_proc_spawn_safe,
  runtime_proc_wait_safe,
  runtime_proc_wait_until_safe
}
use stdlib/list.{List}
use stdlib/process.{Proc}

--- Interpret `Proc` through the host platform, starting every child with
--- exactly the entries of `environment`, in order, instead of this process's
--- own environment. Entries take the platform's `NAME=value` form and are
--- passed unchanged, so a child also observes entries a platform environment
--- can hold but a well-formed one would not, such as a repeated name.
pub implements Proc(environment: List<str>) {
  Proc.run(path, args) ->
    resume(runtime_proc_run_safe(RuntimeProcExplicit(environment), path, args))
  Proc.spawn(path, args) ->
    resume(runtime_proc_spawn_safe(RuntimeProcExplicit(environment), path, args))
  Proc.wait(resource) -> resume(runtime_proc_wait_safe(resource))
  Proc.wait_until(resource, deadline) ->
    resume(runtime_proc_wait_until_safe(resource, deadline.nanoseconds()))
  Proc.release(resource) -> resume(runtime_proc_release_safe(resource))
  Proc.open_session(path, args, store_limit) ->
    resume(
      runtime_proc_open_session_safe(
        RuntimeProcExplicit(environment),
        path,
        args,
        runtime_proc_limit(store_limit)
      )
    )
  Proc.session_write(session, chunk, deadline) ->
    resume(runtime_proc_session_write_safe(session, chunk, deadline.nanoseconds()))
  Proc.session_close_input(session) -> resume(runtime_proc_session_close_input_safe(session))
  Proc.session_read(session, limit, deadline) ->
    resume(
      runtime_proc_session_read_safe(session, runtime_proc_limit(limit), deadline.nanoseconds())
    )
  Proc.session_finish(session) -> resume(runtime_proc_session_finish_until_safe(session, 0 - 1))
  Proc.session_finish_until(session, deadline) ->
    resume(runtime_proc_session_finish_until_safe(session, deadline.nanoseconds()))
  Proc.session_release(session) -> resume(runtime_proc_session_release_safe(session))
}
