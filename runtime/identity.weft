-- Private generative identities for compiler-owned state. Only equality is
-- observable: the storage address never becomes a key, hash or public value.
-- Retaining the token keeps that identity alive, preventing address reuse
-- while a database key or another witness still refers to it.

use runtime/rc.{rc_identity_new, rc_identity_equal}
use stdlib/eq.{Eq}
pub (package) use runtime/rc.{RuntimeIdentity}

pub (package) fn runtime_identity_new() -> RuntimeIdentity { rc_identity_new() }

impl Eq for RuntimeIdentity {
  fn eq(self, other: Self) -> bool { rc_identity_equal(self, other) }
}
