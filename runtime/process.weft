-- runtime/process.weft -- trusted libSystem process bridge

use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/string.{*}
use runtime/syscall.{*}
use runtime/time.{*}
use runtime/unsafe.{*}
use runtime/env.{*}
use stdlib/drop.{*}
use stdlib/env.{Env}
use stdlib/list.{*}

pub(package) type ProcHandle {
  pid: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  spawn_error: i64
}

pub(package) type ProcOutput {
  status: i64,
  stdout_text: str,
  stderr_text: str,
  error: i64,
  timed_out: bool
}

-- Proc capability effect. `run` remains the compact synchronous operation;
-- spawn/wait is the process-level async surface with captured output. Handles
-- are owned resources: wait consumes one, while dropping an un-waited handle
-- routes through release so the child and pipe descriptors cannot leak.
-- wait_until accepts an absolute Time.now_nanos deadline; callers own timeout
-- policy while the platform handler owns deadlock-safe draining and cleanup.
pub(package) effect Proc {
  fn run(path: str, args: List<str>) -> i64
  fn spawn(path: str, args: List<str>) -> owned ProcHandle
  fn wait(resource: owned ProcHandle) -> ProcOutput
  fn wait_until(resource: owned ProcHandle, deadline_nanos: i64) -> ProcOutput
  fn release(resource: ProcHandle) -> i64
}

impl Drop for ProcHandle {
  fn drop(self) -[Proc]> i64 {
    Proc.release(self)
  }
}

-- These functions are trusted platform leaves. They keep raw GOT calls and
-- pid/status memory decoding out of ordinary stdlib source while preserving
-- the current Unsafe-facing process API during the 2j transition.

pub(package) fn runtime_posix_spawn(pid: i64, path: i64, file_actions: i64, attrp: i64, argv: i64, envp: i64) -[Unsafe]> i64 {
  __got_posix_spawn(pid, path, file_actions, attrp, argv, envp)
}

pub(package) fn runtime_waitpid(pid: i64, stat_loc: i64, options: i64) -[Unsafe]> i64 {
  __got_waitpid(pid, stat_loc, options)
}

pub(package) fn runtime_libc_exit(code: i64) -[Unsafe]> i64 {
  __got_exit(code, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_libsystem_write(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __got_write(fd, buf, len, 0, 0, 0)
}

pub(package) fn runtime_process_pipe(fds: i64) -[Unsafe]> i64 {
  __got_pipe(fds, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_fcntl(fd: i64, command: i64, value: i64) -[Unsafe]> i64 {
  -- Darwin arm64 passes variadic arguments on the stack, so the generic GOT
  -- bridge cannot call fcntl's third argument correctly. The BSD syscall ABI
  -- is fixed-arity and preserves the same sealed platform boundary.
  sys_raw(92, fd, command, value, 0, 0, 0)
}

pub(package) fn runtime_process_actions_init(actions: i64) -[Unsafe]> i64 {
  __got_posix_spawn_file_actions_init(actions, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_actions_adddup2(actions: i64, fd: i64, target: i64) -[Unsafe]> i64 {
  __got_posix_spawn_file_actions_adddup2(actions, fd, target, 0, 0, 0)
}

pub(package) fn runtime_process_actions_addclose(actions: i64, fd: i64) -[Unsafe]> i64 {
  __got_posix_spawn_file_actions_addclose(actions, fd, 0, 0, 0, 0)
}

pub(package) fn runtime_process_actions_destroy(actions: i64) -[Unsafe]> i64 {
  __got_posix_spawn_file_actions_destroy(actions, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_read(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __got_read(fd, buf, len, 0, 0, 0)
}

pub(package) fn runtime_process_close(fd: i64) -[Unsafe]> i64 {
  __got_close(fd, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_kill(pid: i64, signal: i64) -[Unsafe]> i64 {
  __got_kill(pid, signal, 0, 0, 0, 0)
}

pub(package) fn runtime_process_nanosleep(request: i64) -[Unsafe]> i64 {
  __got_nanosleep(request, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_errno_ptr() -[Unsafe]> i64 {
  __got___error(0, 0, 0, 0, 0, 0)
}

pub(package) fn runtime_process_errno() -[Unsafe]> i64 {
  let ptr = runtime_process_errno_ptr()
  __mem_load8(ptr) +
    __mem_load8(ptr + 1) * 256 +
    __mem_load8(ptr + 2) * 65536 +
    __mem_load8(ptr + 3) * 16777216
}

pub(package) fn runtime_process_load_i32(ptr: i64) -[Unsafe]> i64 {
  __mem_load8(ptr) +
    __mem_load8(ptr + 1) * 256 +
    __mem_load8(ptr + 2) * 65536 +
    __mem_load8(ptr + 3) * 16777216
}

pub(package) fn runtime_process_make_cstr(s: str) -> i64 {
  runtime_str_cstring(s)
}

pub(package) fn runtime_process_run_command(path: i64, argv: i64) -[Unsafe]> i64 {
  let pid_ptr = alloc_bump(8)
  let result = runtime_posix_spawn(pid_ptr, path, 0, 0, argv, 0)
  if result != 0 { 0 - 1 }
  else {
    let b0 = __mem_load8(pid_ptr)
    let b1 = __mem_load8(pid_ptr + 1)
    let b2 = __mem_load8(pid_ptr + 2)
    let b3 = __mem_load8(pid_ptr + 3)
    let pid = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    let status = alloc_bump(8)
    __mem_store64(status, 0)
    runtime_waitpid(pid, status, 0)
    __mem_load8(status + 1)
  }
}

pub(package) fn runtime_proc_args_count(args: List<str>) -> i64 {
  match args {
    Nil -> 0
    Cons(first, rest) -> 1 + runtime_proc_args_count(rest)
  }
}

pub(package) fn runtime_proc_fill_argv(argv_buf: i64, index: i64, args: List<str>) -[Unsafe]> i64 {
  match args {
    Nil -> {
      __mem_store64(argv_buf + index * 8, 0)
      0
    }
    Cons(first, rest) -> {
      __mem_store64(argv_buf + index * 8, runtime_str_cstring(first))
      runtime_proc_fill_argv(argv_buf, index + 1, rest)
    }
  }
}

pub(package) fn runtime_proc_close_if_open(fd: i64) -[Unsafe]> i64 {
  if fd < 0 { 0 } else { runtime_process_close(fd) }
}

pub(package) fn runtime_proc_set_nonblocking(fd: i64) -[Unsafe]> i64 {
  let flags = runtime_process_fcntl(fd, 3, 0)
  if flags < 0 { 0 - flags }
  else {
    let status = runtime_process_fcntl(fd, 4, flags bor 4)
    if status < 0 { 0 - status }
    else {
      let updated = runtime_process_fcntl(fd, 3, 0)
      if updated < 0 { 0 - updated }
      else { if (updated band 4) == 0 { 5 } else { 0 } }
    }
  }
}

pub(package) fn runtime_proc_action_status(current: i64, next: i64) -> i64 {
  if current != 0 { current } else { next }
}

pub(package) fn runtime_proc_spawn(path: str, args: List<str>) -[Unsafe]> owned ProcHandle {
  let mark = alloc_bump_mark()
  let stdout_pipe = alloc_bump(8)
  let stderr_pipe = alloc_bump(8)
  __mem_store64(stdout_pipe, 0)
  __mem_store64(stderr_pipe, 0)

  let mut stdout_read = 0 - 1
  let mut stdout_write = 0 - 1
  let mut stderr_read = 0 - 1
  let mut stderr_write = 0 - 1
  let mut error = 0

  if runtime_process_pipe(stdout_pipe) == 0 {
    stdout_read = runtime_process_load_i32(stdout_pipe)
    stdout_write = runtime_process_load_i32(stdout_pipe + 4)
  } else {
    error = runtime_process_errno()
  }
  if error == 0 {
    if runtime_process_pipe(stderr_pipe) == 0 {
      stderr_read = runtime_process_load_i32(stderr_pipe)
      stderr_write = runtime_process_load_i32(stderr_pipe + 4)
    } else {
      error = runtime_process_errno()
    }
  } else { 0 }

  let actions = alloc_bump(8)
  __mem_store64(actions, 0)
  let mut actions_ready = 0
  if error == 0 {
    let init_status = runtime_process_actions_init(actions)
    if init_status == 0 { actions_ready = 1 } else { error = init_status }
  } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_adddup2(actions, stdout_write, 1)) } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_adddup2(actions, stderr_write, 2)) } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_addclose(actions, stdout_read)) } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_addclose(actions, stderr_read)) } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_addclose(actions, stdout_write)) } else { 0 }
  if error == 0 { error = runtime_proc_action_status(error, runtime_process_actions_addclose(actions, stderr_write)) } else { 0 }

  if error == 0 { error = runtime_proc_set_nonblocking(stdout_read) } else { 0 }
  if error == 0 { error = runtime_proc_set_nonblocking(stderr_read) } else { 0 }

  let path_c = runtime_str_cstring(path)
  let n = runtime_proc_args_count(args)
  let argv_buf = alloc_bump((n + 2) * 8)
  __mem_store64(argv_buf, path_c)
  runtime_proc_fill_argv(argv_buf, 1, args)
  let pid_ptr = alloc_bump(8)
  __mem_store64(pid_ptr, 0)
  let mut pid = 0
  if error == 0 {
    let spawn_status = runtime_posix_spawn(pid_ptr, path_c, actions, 0, argv_buf, 0)
    if spawn_status == 0 { pid = runtime_process_load_i32(pid_ptr) } else { error = spawn_status }
  } else { 0 }

  if actions_ready == 1 { runtime_process_actions_destroy(actions) } else { 0 }
  runtime_proc_close_if_open(stdout_write)
  runtime_proc_close_if_open(stderr_write)
  if error != 0 {
    runtime_proc_close_if_open(stdout_read)
    runtime_proc_close_if_open(stderr_read)
    stdout_read = 0 - 1
    stderr_read = 0 - 1
    pid = 0
  } else { 0 }

  alloc_bump_restore_same_segment(mark)
  ProcHandle { pid: pid, stdout_fd: stdout_read, stderr_fd: stderr_read, spawn_error: error }
}

-- Drain all bytes immediately available from a nonblocking pipe.
-- 1 = EOF, 0 = would block, negative = errno.
pub(package) fn runtime_proc_drain(fd: i64, scratch: i64, out: i64) -[Unsafe]> i64 {
  let mut done = 0
  let mut result = 0
  while done == 0 {
    let n = runtime_process_read(fd, scratch, 4096)
    if n > 0 {
      bscopy(out, scratch, n, 0)
    } else { if n == 0 {
      result = 1
      done = 1
    } else {
      let error = runtime_process_errno()
      if error == 4 {
        0
      } else {
        result = if error == 35 { 0 } else { 0 - error }
        done = 1
      }
    } }
  }
  result
}

pub(package) fn runtime_proc_decode_wait_status(status_ptr: i64) -[Unsafe]> i64 {
  let raw = runtime_process_load_i32(status_ptr)
  let signal = raw band 127
  if signal == 0 { (raw bshr 8) band 255 } else { 128 + signal }
}

pub(package) fn runtime_proc_wait_blocking(pid: i64, status_ptr: i64) -[Unsafe]> i64 {
  let mut done = 0
  let mut result = 0
  while done == 0 {
    let waited = runtime_waitpid(pid, status_ptr, 0)
    if waited < 0 {
      let error = runtime_process_errno()
      if error == 4 { 0 }
      else {
        result = 0 - error
        done = 1
      }
    } else {
      result = waited
      done = 1
    }
  }
  result
}

-- A negative deadline waits without a timeout. Non-negative deadlines are
-- absolute values from Time.now_nanos, so timeout policy stays with the caller
-- and already-running children do not receive a fresh budget at wait time.
pub(package) fn runtime_proc_wait_until(resource: ProcHandle, deadline_nanos: i64) -[Unsafe]> ProcOutput {
  if resource.spawn_error != 0 {
    ProcOutput {
      status: 0 - 1,
      stdout_text: "",
      stderr_text: "",
      error: resource.spawn_error,
      timed_out: false
    }
  } else {
    let mark = alloc_bump_mark()
    let scratch = alloc_bump(4096)
    let status_ptr = alloc_bump(8)
    let pause_request = alloc_bump(16)
    __mem_store64(status_ptr, 0)
    __mem_store64(pause_request, 0)
    __mem_store64(pause_request + 8, 1000000)
    let stdout_buf = buf_new(4096)
    let stderr_buf = buf_new(4096)
    let mut stdout_eof = if resource.stdout_fd < 0 { 1 } else { 0 }
    let mut stderr_eof = if resource.stderr_fd < 0 { 1 } else { 0 }
    let mut capture_error = 0
    let mut wait_error = 0
    let mut status = 0 - 1
    let mut child_done = 0
    let mut timed_out = false

    while child_done == 0 {
      if stdout_eof == 0 {
        let state = runtime_proc_drain(resource.stdout_fd, scratch, stdout_buf)
        if state == 1 { stdout_eof = 1 }
        else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
      } else { 0 }
      if stderr_eof == 0 {
        let state = runtime_proc_drain(resource.stderr_fd, scratch, stderr_buf)
        if state == 1 { stderr_eof = 1 }
        else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
      } else { 0 }

      let waited = runtime_waitpid(resource.pid, status_ptr, 1)
      if waited == resource.pid {
        status = runtime_proc_decode_wait_status(status_ptr)
        child_done = 1
      } else { if waited < 0 {
        let error = runtime_process_errno()
        if error == 4 { runtime_process_nanosleep(pause_request) }
        else {
          wait_error = error
          child_done = 1
        }
      } else {
        let now = if deadline_nanos < 0 { 0 } else { runtime_time_now_nanos() }
        if deadline_nanos >= 0 and (now < 0 or now >= deadline_nanos) {
          runtime_process_kill(resource.pid, 9)
          let reaped = runtime_proc_wait_blocking(resource.pid, status_ptr)
          if reaped == resource.pid {
            status = runtime_proc_decode_wait_status(status_ptr)
            timed_out = if now < 0 { false } else { true }
            if now < 0 { wait_error = 5 } else { 0 }
          } else {
            wait_error = 0 - reaped
          }
          child_done = 1
        } else {
          runtime_process_nanosleep(pause_request)
        }
      } }
    }

    if stdout_eof == 0 {
      let state = runtime_proc_drain(resource.stdout_fd, scratch, stdout_buf)
      if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 }
    } else { 0 }
    if stderr_eof == 0 {
      let state = runtime_proc_drain(resource.stderr_fd, scratch, stderr_buf)
      if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 }
    } else { 0 }
    runtime_proc_close_if_open(resource.stdout_fd)
    runtime_proc_close_if_open(resource.stderr_fd)

    let stdout_text = runtime_str_from_bytes(buf_ptr(stdout_buf), buf_len(stdout_buf))
    let stderr_text = runtime_str_from_bytes(buf_ptr(stderr_buf), buf_len(stderr_buf))
    let error = if wait_error != 0 { wait_error } else { capture_error }
    alloc_bump_restore_same_segment(mark)
    ProcOutput {
      status: status,
      stdout_text: stdout_text,
      stderr_text: stderr_text,
      error: error,
      timed_out: timed_out
    }
  }
}

pub(package) fn runtime_proc_wait(resource: ProcHandle) -[Unsafe]> ProcOutput {
  runtime_proc_wait_until(resource, 0 - 1)
}

pub(package) fn runtime_proc_release(resource: ProcHandle) -[Unsafe]> i64 {
  if resource.pid > 0 { runtime_process_kill(resource.pid, 9) } else { 0 }
  runtime_proc_close_if_open(resource.stdout_fd)
  runtime_proc_close_if_open(resource.stderr_fd)
  if resource.pid > 0 {
    let mark = alloc_bump_mark()
    let status_ptr = alloc_bump(8)
    __mem_store64(status_ptr, 0)
    let waited = runtime_proc_wait_blocking(resource.pid, status_ptr)
    alloc_bump_restore_same_segment(mark)
    if waited < 0 { 0 - waited } else { 0 }
  } else { resource.spawn_error }
}

pub(package) fn proc_spawn(path: str, args: List<str>) -[Proc]> owned ProcHandle {
  Proc.spawn(path, args)
}

pub(package) fn proc_wait(resource: owned ProcHandle) -[Proc]> ProcOutput {
  Proc.wait(resource)
}

pub(package) fn proc_wait_until(resource: owned ProcHandle, deadline_nanos: i64) -[Proc]> ProcOutput {
  Proc.wait_until(resource, deadline_nanos)
}

pub(package) fn proc_handle_pid(resource: ProcHandle) -> i64 {
  resource.pid
}

-- argv = [path, args..., 0]; returns the child's exit status (or -1 when
-- the spawn itself fails), matching runtime_process_run_command.
pub(package) fn runtime_proc_run(path: str, args: List<str>) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let n = runtime_proc_args_count(args)
  let argv_buf = alloc_bump((n + 2) * 8)
  __mem_store64(argv_buf, path_c)
  runtime_proc_fill_argv(argv_buf, 1, args)
  let result = runtime_process_run_command(path_c, argv_buf)
  -- posix_spawn has consumed path/argv before it returns, and the
  -- command helper has already waited for the child. Reclaim the
  -- complete marshalling packet, including pid/status scratch.
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_proc_handle(body: () -[Proc]> i64) -[Unsafe]> i64 {
  handle body() {
    Proc.run(path, args) -> resume(runtime_proc_run(path, args))
    Proc.spawn(path, args) -> resume(runtime_proc_spawn(path, args))
    Proc.wait(resource) -> resume(runtime_proc_wait(resource))
    Proc.wait_until(resource, deadline_nanos) -> resume(runtime_proc_wait_until(resource, deadline_nanos))
    Proc.release(resource) -> resume(runtime_proc_release(resource))
  }
}

pub(package) fn runtime_platform_proc(body: () -[Proc]> i64) -> i64 {
  handle runtime_proc_handle(body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Combined boundary installer for programs that need both capabilities:
-- Proc is discharged innermost, Env next, Unsafe never leaves this module.
pub(package) fn runtime_proc_inner_with_env(body: () -[Env, Proc]> i64) -[Env, Unsafe]> i64 {
  handle body() {
    Proc.run(path, args) -> resume(runtime_proc_run(path, args))
    Proc.spawn(path, args) -> resume(runtime_proc_spawn(path, args))
    Proc.wait(resource) -> resume(runtime_proc_wait(resource))
    Proc.wait_until(resource, deadline_nanos) -> resume(runtime_proc_wait_until(resource, deadline_nanos))
    Proc.release(resource) -> resume(runtime_proc_release(resource))
  }
}

pub(package) fn runtime_env_proc_handle(argc: i64, argv: i64, body: () -[Env, Proc]> i64) -[Unsafe]> i64 {
  let envp = runtime_env_pointer(argc, argv)
  handle runtime_proc_inner_with_env(body) {
    Env.arg_count() -> resume(argc)
    Env.arg(index) -> resume(runtime_env_arg_str(argc, argv, index))
    Env.var(name) -> resume(runtime_env_var(envp, name))
  }
}

pub(package) fn runtime_platform_env_proc(argc: i64, argv: i64, body: () -[Env, Proc]> i64) -> i64 {
  handle runtime_env_proc_handle(argc, argv, body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
