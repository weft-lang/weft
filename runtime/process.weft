-- runtime/process.weft — trusted target-neutral process interpretation
--
-- Raw descriptors, startup environment pointers, argv packets, native wait
-- status and spawn protocol details remain sealed here. The emitter selects
-- Darwin posix_spawn or Linux clone/dup3/execve for the same semantic leaves.

use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/env.{runtime_env_pointer}
use runtime/rc.{rc_default_heap}
use runtime/string.{*}
use runtime/time.{runtime_time_now_nanos}
use runtime/unsafe.{*}
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/result.{Result, Err, Ok}

fn runtime_proc_plan_stdout_read_offset() -> i64 { 0 }
fn runtime_proc_plan_stdout_write_offset() -> i64 { 8 }
fn runtime_proc_plan_stderr_read_offset() -> i64 { 16 }
fn runtime_proc_plan_stderr_write_offset() -> i64 { 24 }
fn runtime_proc_plan_exec_read_offset() -> i64 { 32 }
fn runtime_proc_plan_exec_write_offset() -> i64 { 40 }
fn runtime_proc_plan_error_offset() -> i64 { 48 }
fn runtime_proc_plan_capture_offset() -> i64 { 56 }
fn runtime_proc_plan_size() -> i64 { 64 }

fn runtime_proc_state_pid_offset() -> i64 { 0 }
fn runtime_proc_state_stdout_offset() -> i64 { 8 }
fn runtime_proc_state_stderr_offset() -> i64 { 16 }
fn runtime_proc_state_error_offset() -> i64 { 24 }
fn runtime_proc_state_size() -> i64 { 32 }

pub(package) fn runtime_process_pipe(fds: i64) -[Unsafe]> i64 {
  __platform_proc_pipe(fds)
}

pub(package) fn runtime_process_set_cloexec(fd: i64) -[Unsafe]> i64 {
  __platform_proc_set_cloexec(fd)
}

pub(package) fn runtime_process_set_nonblocking(fd: i64) -[Unsafe]> i64 {
  __platform_proc_set_nonblocking(fd)
}

pub(package) fn runtime_process_spawn(pid: i64, path: i64, argv: i64, envp: i64, plan: i64) -[Unsafe]> i64 {
  __platform_proc_spawn(pid, path, argv, envp, plan)
}

pub(package) fn runtime_process_wait_blocking(pid: i64, status: i64) -[Unsafe]> i64 {
  __platform_proc_wait_blocking(pid, status)
}

pub(package) fn runtime_process_wait_nonblocking(pid: i64, status: i64) -[Unsafe]> i64 {
  __platform_proc_wait_nonblocking(pid, status)
}

pub(package) fn runtime_process_read(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __platform_read(fd, buf, len)
}

pub(package) fn runtime_process_close(fd: i64) -[Unsafe]> i64 {
  __platform_close(fd)
}

pub(package) fn runtime_process_kill(pid: i64) -[Unsafe]> i64 {
  __platform_proc_kill(pid)
}

pub(package) fn runtime_process_nanosleep(request: i64) -[Unsafe]> i64 {
  __platform_time_sleep(request, 0)
}

fn runtime_proc_error_code(status: i64) -> i64 {
  if status < 0 { 0 - status } else { status }
}

pub(package) fn runtime_process_make_cstr(s: str) -> i64 {
  runtime_str_cstring(s)
}

pub(package) fn runtime_proc_args_count(args: List<str>) -> i64 {
  match args {
    Nil -> 0
    Cons(first, rest) -> 1 + runtime_proc_args_count(rest)
  }
}

pub(package) fn runtime_proc_fill_argv(argv_buf: i64, index: i64, args: List<str>) -[Unsafe]> i64 {
  match args {
    Nil -> {
      __mem_store64(argv_buf + index * 8, 0)
      0
    }
    Cons(first, rest) -> {
      __mem_store64(argv_buf + index * 8, runtime_str_cstring(first))
      runtime_proc_fill_argv(argv_buf, index + 1, rest)
    }
  }
}

fn runtime_proc_plan_new(capture: bool) -[Unsafe]> i64 {
  let plan = alloc_bump(runtime_proc_plan_size())
  __mem_store64(plan + runtime_proc_plan_stdout_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stdout_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stderr_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stderr_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_exec_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_exec_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_error_offset(), 0)
  __mem_store64(plan + runtime_proc_plan_capture_offset(), if capture { 1 } else { 0 })
  plan
}

fn runtime_proc_plan_fd(plan: i64, offset: i64) -[Unsafe]> i64 {
  __mem_load64(plan + offset)
}

fn runtime_proc_plan_set_fd(plan: i64, offset: i64, fd: i64) -[Unsafe]> i64 {
  __mem_store64(plan + offset, fd)
  0
}

fn runtime_proc_open_pipe(plan: i64, read_offset: i64, write_offset: i64) -[Unsafe]> i64 {
  let fds = alloc_bump(16)
  __mem_store64(fds, 0 - 1)
  __mem_store64(fds + 8, 0 - 1)
  let status = runtime_process_pipe(fds)
  if status < 0 { runtime_proc_error_code(status) }
  else {
    __mem_store64(plan + read_offset, __mem_load64(fds))
    __mem_store64(plan + write_offset, __mem_load64(fds + 8))
    0
  }
}

fn runtime_proc_close_plan_fd(plan: i64, offset: i64) -[Unsafe]> i64 {
  let fd = runtime_proc_plan_fd(plan, offset)
  if fd < 0 { 0 }
  else {
    runtime_proc_plan_set_fd(plan, offset, 0 - 1)
    runtime_process_close(fd)
  }
}

fn runtime_proc_prepare_exec_pipe(plan: i64) -[Unsafe]> i64 {
  let opened = runtime_proc_open_pipe(
    plan,
    runtime_proc_plan_exec_read_offset(),
    runtime_proc_plan_exec_write_offset()
  )
  if opened != 0 { opened }
  else {
    let read_status = runtime_process_set_cloexec(
      runtime_proc_plan_fd(plan, runtime_proc_plan_exec_read_offset())
    )
    if read_status < 0 { runtime_proc_error_code(read_status) }
    else {
      let write_status = runtime_process_set_cloexec(
        runtime_proc_plan_fd(plan, runtime_proc_plan_exec_write_offset())
      )
      if write_status < 0 { runtime_proc_error_code(write_status) } else { 0 }
    }
  }
}

fn runtime_proc_prepare_capture(plan: i64) -[Unsafe]> i64 {
  let stdout_status = runtime_proc_open_pipe(
    plan,
    runtime_proc_plan_stdout_read_offset(),
    runtime_proc_plan_stdout_write_offset()
  )
  if stdout_status != 0 { stdout_status }
  else {
    let stderr_status = runtime_proc_open_pipe(
      plan,
      runtime_proc_plan_stderr_read_offset(),
      runtime_proc_plan_stderr_write_offset()
    )
    if stderr_status != 0 { stderr_status }
    else {
      let stdout_nonblocking = runtime_process_set_nonblocking(
        runtime_proc_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
      )
      if stdout_nonblocking < 0 { runtime_proc_error_code(stdout_nonblocking) }
      else {
        let stderr_nonblocking = runtime_process_set_nonblocking(
          runtime_proc_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
        )
        if stderr_nonblocking < 0 { runtime_proc_error_code(stderr_nonblocking) }
        else { runtime_proc_prepare_exec_pipe(plan) }
      }
    }
  }
}

fn runtime_proc_close_plan(plan: i64) -[Unsafe]> i64 {
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_write_offset())
  0
}

fn runtime_proc_exec_handshake(plan: i64) -[Unsafe]> i64 {
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_write_offset())
  let fd = runtime_proc_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  let mut done = false
  let mut result = 0
  while not done {
    let count = runtime_process_read(fd, plan + runtime_proc_plan_error_offset(), 8)
    if count == 0 {
      done = true
    } else { if count == 8 {
      result = __mem_load64(plan + runtime_proc_plan_error_offset())
      done = true
    } else { if count < 0 and runtime_proc_error_code(count) == 4 {
      0
    } else {
      result = if count < 0 { runtime_proc_error_code(count) } else { 5 }
      done = true
    } } }
  }
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  result
}

fn runtime_proc_make_argv(path: str, args: List<str>) -[Unsafe]> (i64, i64) {
  let path_c = runtime_str_cstring(path)
  let argv = alloc_bump((runtime_proc_args_count(args) + 2) * 8)
  __mem_store64(argv, path_c)
  runtime_proc_fill_argv(argv, 1, args)
  (path_c, argv)
}

fn runtime_proc_decode_wait_raw(raw: i64) -> ProcTermination {
  let signal = raw band 127
  if signal == 0 { ProcExited((raw bshr 8) band 255) }
  else { ProcSignaled(signal) }
}

fn runtime_proc_wait_blocking_raw(pid: i64, status_ptr: i64) -[Unsafe]> i64 {
  let mut done = false
  let mut result = 0
  while not done {
    let waited = runtime_process_wait_blocking(pid, status_ptr)
    if waited < 0 and runtime_proc_error_code(waited) == 4 { 0 }
    else {
      result = waited
      done = true
    }
  }
  result
}

fn runtime_proc_reap_spawn_failure(pid: i64) -[Unsafe]> i64 {
  if pid <= 0 { 0 }
  else {
    let status = alloc_bump(8)
    __mem_store64(status, 0)
    runtime_proc_wait_blocking_raw(pid, status)
  }
}

fn runtime_proc_spawn_into_plan(envp: i64, path: str, args: List<str>, plan: i64, capture: bool) -[Unsafe]> i64 {
  let mut error = if capture { runtime_proc_prepare_capture(plan) }
  else { runtime_proc_prepare_exec_pipe(plan) }
  let mut pid = 0
  if error == 0 {
    match runtime_proc_make_argv(path, args) {
      (path_c, argv) -> {
        let pid_ptr = alloc_bump(8)
        __mem_store64(pid_ptr, 0)
        let spawn_status = runtime_process_spawn(pid_ptr, path_c, argv, envp, plan)
        if spawn_status != 0 {
          error = runtime_proc_error_code(spawn_status)
        } else {
          pid = __mem_load64(pid_ptr)
          error = runtime_proc_exec_handshake(plan)
          if error != 0 {
            runtime_proc_reap_spawn_failure(pid)
            pid = 0
          } else { 0 }
        }
      }
    }
  } else { 0 }
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_write_offset())
  runtime_proc_plan_set_fd(plan, runtime_proc_plan_error_offset(), error)
  runtime_proc_plan_set_fd(plan, runtime_proc_plan_capture_offset(), pid)
  0
}

fn runtime_proc_construct_handle_after_restore(mark: i64, state: i64) -[Unsafe]> owned ProcHandle {
  alloc_bump_restore_same_segment(mark)
  proc_handle_from_token(state)
}

fn runtime_proc_finish_handle(mark: i64, pid: i64, stdout_fd: i64, stderr_fd: i64, error: i64) -[Unsafe]> owned ProcHandle {
  let state = heap_alloc_zeroed(rc_default_heap(), runtime_proc_state_size(), 8)
  __mem_store64(state + runtime_proc_state_pid_offset(), pid)
  __mem_store64(state + runtime_proc_state_stdout_offset(), stdout_fd)
  __mem_store64(state + runtime_proc_state_stderr_offset(), stderr_fd)
  __mem_store64(state + runtime_proc_state_error_offset(), error)
  runtime_proc_construct_handle_after_restore(mark, state)
}

fn runtime_proc_finish_spawn(mark: i64, pid: i64, plan: i64, error: i64) -[Unsafe]> owned ProcHandle {
  let stdout_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
  let stderr_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
  if error != 0 {
    runtime_proc_close_plan(plan)
  } else {
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stdout_read_offset(), 0 - 1)
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stderr_read_offset(), 0 - 1)
  }
  runtime_proc_finish_handle(
    mark,
    pid,
    if error == 0 { stdout_fd } else { 0 - 1 },
    if error == 0 { stderr_fd } else { 0 - 1 },
    if error == 0 { 0 } else { runtime_proc_error_code(error) }
  )
}

pub(package) fn runtime_proc_spawn(envp: i64, path: str, args: List<str>) -[Unsafe]> owned ProcHandle {
  let mark = alloc_bump_mark()
  let plan = runtime_proc_plan_new(true)
  runtime_proc_spawn_into_plan(envp, path, args, plan, true)
  runtime_proc_finish_spawn(
    mark,
    runtime_proc_plan_fd(plan, runtime_proc_plan_capture_offset()),
    plan,
    runtime_proc_plan_fd(plan, runtime_proc_plan_error_offset())
  )
}

-- Drain all bytes immediately available from a nonblocking pipe.
-- 1 = EOF, 0 = would block, negative = portable error code.
pub(package) fn runtime_proc_drain(fd: i64, scratch: i64, out: i64) -[Unsafe]> i64 {
  let mut done = false
  let mut result = 0
  while not done {
    let count = runtime_process_read(fd, scratch, 4096)
    if count > 0 {
      bscopy(out, scratch, count, 0)
    } else { if count == 0 {
      result = 1
      done = true
    } else {
      let error = runtime_proc_error_code(count)
      if error == 4 { 0 }
      else {
        result = if error == 11 or error == 35 { 0 } else { 0 - error }
        done = true
      }
    } }
  }
  result
}

fn runtime_proc_wait_until_raw(pid: i64, stdout_fd: i64, stderr_fd: i64, spawn_error: i64, deadline_nanos: i64) -[Unsafe]> ProcOutput {
  if spawn_error != 0 {
    ProcFailed(ProcSpawnFailed(spawn_error), "", "")
  } else {
    let mark = alloc_bump_mark()
    let scratch = alloc_bump(4096)
    let status_ptr = alloc_bump(8)
    let pause_request = alloc_bump(16)
    __mem_store64(status_ptr, 0)
    __mem_store64(pause_request, 0)
    __mem_store64(pause_request + 8, 1000000)
    let stdout_buf = buf_new(4096)
    let stderr_buf = buf_new(4096)
    let mut stdout_eof = stdout_fd < 0
    let mut stderr_eof = stderr_fd < 0
    let mut capture_error = 0
    let mut wait_error = 0
    let mut status_raw = 0
    let mut child_done = false
    let mut timed_out = false

    while not child_done {
      if not stdout_eof {
        let state = runtime_proc_drain(stdout_fd, scratch, stdout_buf)
        if state == 1 { stdout_eof = true }
        else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
      } else { 0 }
      if not stderr_eof {
        let state = runtime_proc_drain(stderr_fd, scratch, stderr_buf)
        if state == 1 { stderr_eof = true }
        else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
      } else { 0 }

      let waited = runtime_process_wait_nonblocking(pid, status_ptr)
      if waited == pid {
        status_raw = __mem_load64(status_ptr)
        child_done = true
      } else { if waited < 0 {
        let error = runtime_proc_error_code(waited)
        if error == 4 { runtime_process_nanosleep(pause_request) }
        else {
          wait_error = error
          child_done = true
        }
      } else {
        let now = if deadline_nanos < 0 { 0 } else { runtime_time_now_nanos() }
        if deadline_nanos >= 0 and (now < 0 or now >= deadline_nanos) {
          runtime_process_kill(pid)
          let reaped = runtime_proc_wait_blocking_raw(pid, status_ptr)
          if reaped == pid {
            status_raw = __mem_load64(status_ptr)
            timed_out = now >= 0
            if now < 0 { wait_error = 5 } else { 0 }
          } else {
            wait_error = runtime_proc_error_code(reaped)
          }
          child_done = true
        } else {
          runtime_process_nanosleep(pause_request)
        }
      } }
    }

    if not stdout_eof {
      let state = runtime_proc_drain(stdout_fd, scratch, stdout_buf)
      if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 }
    } else { 0 }
    if not stderr_eof {
      let state = runtime_proc_drain(stderr_fd, scratch, stderr_buf)
      if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 }
    } else { 0 }
    if stdout_fd >= 0 { runtime_process_close(stdout_fd) } else { 0 }
    if stderr_fd >= 0 { runtime_process_close(stderr_fd) } else { 0 }

    let stdout_text = runtime_str_from_bytes(buf_ptr(stdout_buf), buf_len(stdout_buf))
    let stderr_text = runtime_str_from_bytes(buf_ptr(stderr_buf), buf_len(stderr_buf))
    alloc_bump_restore_same_segment(mark)
    if wait_error != 0 {
      ProcFailed(ProcWaitFailed(wait_error), stdout_text, stderr_text)
    } else { if capture_error != 0 {
      ProcFailed(ProcCaptureFailed(capture_error), stdout_text, stderr_text)
    } else { if timed_out {
      ProcTimedOut(runtime_proc_decode_wait_raw(status_raw), stdout_text, stderr_text)
    } else {
      ProcCompleted(runtime_proc_decode_wait_raw(status_raw), stdout_text, stderr_text)
    } } }
  }
}

pub(package) fn runtime_proc_wait_until(resource: ProcHandle, deadline_nanos: i64) -[Unsafe]> ProcOutput {
  let state = proc_handle_release_token(resource)
  let pid = __mem_load64(state + runtime_proc_state_pid_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_state_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_state_stderr_offset())
  let spawn_error = __mem_load64(state + runtime_proc_state_error_offset())
  heap_free(rc_default_heap(), state, runtime_proc_state_size())
  runtime_proc_wait_until_raw(pid, stdout_fd, stderr_fd, spawn_error, deadline_nanos)
}

pub(package) fn runtime_proc_wait(resource: ProcHandle) -[Unsafe]> ProcOutput {
  runtime_proc_wait_until(resource, 0 - 1)
}

fn runtime_proc_release_raw(pid: i64, stdout_fd: i64, stderr_fd: i64, spawn_error: i64) -[Unsafe]> i64 {
  if pid > 0 { runtime_process_kill(pid) } else { 0 }
  if stdout_fd >= 0 { runtime_process_close(stdout_fd) } else { 0 }
  if stderr_fd >= 0 { runtime_process_close(stderr_fd) } else { 0 }
  if pid > 0 {
    let mark = alloc_bump_mark()
    let status_ptr = alloc_bump(8)
    __mem_store64(status_ptr, 0)
    let waited = runtime_proc_wait_blocking_raw(pid, status_ptr)
    alloc_bump_restore_same_segment(mark)
    if waited < 0 { runtime_proc_error_code(waited) } else { 0 }
  } else { spawn_error }
}

pub(package) fn runtime_proc_release(resource: ProcHandle) -[Unsafe]> i64 {
  let state = proc_handle_release_token(resource)
  let pid = __mem_load64(state + runtime_proc_state_pid_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_state_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_state_stderr_offset())
  let spawn_error = __mem_load64(state + runtime_proc_state_error_offset())
  heap_free(rc_default_heap(), state, runtime_proc_state_size())
  runtime_proc_release_raw(pid, stdout_fd, stderr_fd, spawn_error)
}

pub(package) fn runtime_proc_run(envp: i64, path: str, args: List<str>) -[Unsafe]> Result<ProcTermination, ProcError> {
  let mark = alloc_bump_mark()
  let plan = runtime_proc_plan_new(false)
  runtime_proc_spawn_into_plan(envp, path, args, plan, false)
  let pid = runtime_proc_plan_fd(plan, runtime_proc_plan_capture_offset())
  let spawn_error = runtime_proc_plan_fd(plan, runtime_proc_plan_error_offset())
  let status_ptr = alloc_bump(8)
  __mem_store64(status_ptr, 0)
  let waited = if spawn_error == 0 { runtime_proc_wait_blocking_raw(pid, status_ptr) } else { 0 }
  let status_raw = __mem_load64(status_ptr)
  runtime_proc_close_plan(plan)
  alloc_bump_restore_same_segment(mark)
  if spawn_error != 0 {
    Err<ProcTermination, ProcError>(ProcSpawnFailed(spawn_error))
  } else { if waited != pid {
    Err<ProcTermination, ProcError>(ProcWaitFailed(runtime_proc_error_code(waited)))
  } else {
    Ok<ProcTermination, ProcError>(runtime_proc_decode_wait_raw(status_raw))
  } }
}

pub(package) fn proc_spawn(path: str, args: List<str>) -[Proc]> owned ProcHandle {
  Proc.spawn(path, args)
}

pub(package) fn proc_wait(resource: owned ProcHandle) -[Proc]> ProcOutput {
  Proc.wait(resource)
}

pub(package) fn proc_wait_until(resource: owned ProcHandle, deadline_nanos: i64) -[Proc]> ProcOutput {
  Proc.wait_until(resource, deadline_nanos)
}

fn runtime_proc_run_safe(
  envp: i64,
  path: str,
  args: List<str>
) -> Result<ProcTermination, ProcError> {
  handle runtime_proc_run(envp, path, args) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_spawn_safe(envp: i64, path: str, args: List<str>) -> owned ProcHandle {
  handle runtime_proc_spawn(envp, path, args) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_wait_safe(resource: ProcHandle) -> ProcOutput {
  handle runtime_proc_wait(resource) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_wait_until_safe(resource: ProcHandle, deadline_nanos: i64) -> ProcOutput {
  handle runtime_proc_wait_until(resource, deadline_nanos) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_release_safe(resource: ProcHandle) -> i64 {
  handle runtime_proc_release(resource) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

--- Interpret Proc through the target platform with the current process's
--- inherited environment.
pub implements Proc(argc: i64, argv: i64) {
  Proc.run(path, args) ->
    resume(runtime_proc_run_safe(runtime_env_pointer(argc, argv), path, args))
  Proc.spawn(path, args) ->
    resume(runtime_proc_spawn_safe(runtime_env_pointer(argc, argv), path, args))
  Proc.wait(resource) -> resume(runtime_proc_wait_safe(resource))
  Proc.wait_until(resource, deadline_nanos) ->
    resume(runtime_proc_wait_until_safe(resource, deadline_nanos))
  Proc.release(resource) -> resume(runtime_proc_release_safe(resource))
}
