-- runtime/process.weft -- trusted libSystem process bridge

use "runtime/alloc.weft"
use "runtime/string.weft"
use "runtime/unsafe.weft"

-- These functions are trusted platform leaves. They keep raw GOT calls and
-- pid/status memory decoding out of ordinary stdlib source while preserving
-- the current Unsafe-facing process API during the 2j transition.

fn runtime_posix_spawn(pid: i64, path: i64, file_actions: i64, attrp: i64, argv: i64, envp: i64) -[Unsafe]> i64 {
  __got_posix_spawn(pid, path, file_actions, attrp, argv, envp)
}

fn runtime_waitpid(pid: i64, stat_loc: i64, options: i64) -[Unsafe]> i64 {
  __got_waitpid(pid, stat_loc, options)
}

fn runtime_libc_exit(code: i64) -[Unsafe]> i64 {
  __got_exit(code, 0, 0, 0, 0, 0)
}

fn runtime_libsystem_write(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __got_write(fd, buf, len, 0, 0, 0)
}

fn runtime_process_make_cstr(s: str) -> i64 {
  runtime_str_cstring(s)
}

fn runtime_process_run_command(path: i64, argv: i64) -[Unsafe]> i64 {
  let pid_ptr = alloc_bump(8)
  let result = runtime_posix_spawn(pid_ptr, path, 0, 0, argv, 0)
  if result != 0 { 0 - 1 }
  else {
    let b0 = __mem_load8(pid_ptr)
    let b1 = __mem_load8(pid_ptr + 1)
    let b2 = __mem_load8(pid_ptr + 2)
    let b3 = __mem_load8(pid_ptr + 3)
    let pid = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    let status = alloc_bump(8)
    __mem_store64(status, 0)
    runtime_waitpid(pid, status, 0)
    __mem_load8(status + 1)
  }
}
