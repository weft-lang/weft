-- runtime/process.weft — trusted target-neutral process interpretation
--
-- Raw descriptors, startup environment pointers, argv packets, native wait
-- status and spawn protocol details remain sealed here. The emitter selects
-- Darwin posix_spawn or Linux clone/dup3/execve for the same semantic leaves.

use runtime/alloc.{*}
use runtime/buffer.{*}
use runtime/env.{runtime_env_pointer}
use runtime/memory.{mem_copy}
use runtime/rc.{rc_default_heap}
use runtime/shutdown.{runtime_shutdown_set_disposition}
use runtime/string.{*}
use runtime/time.{runtime_time_now_nanos}
use runtime/unsafe.{*}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes, bytes_from_storage}
use stdlib/list.{*}
use stdlib/process.{*}
use stdlib/result.{Result, Err, Ok}
use stdlib/time/monotonic.{Instant}
use stdlib/vector.{vector_data}
use stdlib/vector/handles.{Vector}

fn runtime_proc_plan_stdout_read_offset() -> i64 { 0 }

fn runtime_proc_plan_stdout_write_offset() -> i64 { 8 }

fn runtime_proc_plan_stderr_read_offset() -> i64 { 16 }

fn runtime_proc_plan_stderr_write_offset() -> i64 { 24 }

fn runtime_proc_plan_exec_read_offset() -> i64 { 32 }

fn runtime_proc_plan_exec_write_offset() -> i64 { 40 }

fn runtime_proc_plan_error_offset() -> i64 { 48 }

fn runtime_proc_plan_capture_offset() -> i64 { 56 }

fn runtime_proc_plan_stdin_read_offset() -> i64 { 64 }

fn runtime_proc_plan_stdin_write_offset() -> i64 { 72 }

fn runtime_proc_plan_size() -> i64 { 80 }

-- Spawn modes shared with the emitter: inherit the standard streams, capture
-- the output streams, or capture them and pipe the child's standard input.
fn runtime_proc_mode_inherit() -> i64 { 0 }

fn runtime_proc_mode_capture() -> i64 { 1 }

fn runtime_proc_mode_session() -> i64 { 2 }

fn runtime_proc_state_pid_offset() -> i64 { 0 }

fn runtime_proc_state_stdout_offset() -> i64 { 8 }

fn runtime_proc_state_stderr_offset() -> i64 { 16 }

fn runtime_proc_state_error_offset() -> i64 { 24 }

fn runtime_proc_state_size() -> i64 { 32 }

-- Session state: pid, the parent's three descriptors, the spawn error, one
-- raw heap buffer (pointer, length, capacity) per output stream holding
-- output drained while a write waited, and each stream's end-of-input flag.
fn runtime_proc_session_pid_offset() -> i64 { 0 }

fn runtime_proc_session_stdin_offset() -> i64 { 8 }

fn runtime_proc_session_stdout_offset() -> i64 { 16 }

fn runtime_proc_session_stderr_offset() -> i64 { 24 }

fn runtime_proc_session_error_offset() -> i64 { 32 }

fn runtime_proc_session_stdout_buffer_offset() -> i64 { 40 }

fn runtime_proc_session_stderr_buffer_offset() -> i64 { 64 }

fn runtime_proc_session_stdout_eof_offset() -> i64 { 88 }

fn runtime_proc_session_stderr_eof_offset() -> i64 { 96 }

fn runtime_proc_session_store_limit_offset() -> i64 { 104 }

fn runtime_proc_session_size() -> i64 { 112 }

fn runtime_proc_session_scratch_size() -> i64 { 4096 }

-- An unbounded drain still returns after this many bytes so its caller can
-- re-check deadlines against a child that never stops writing.
fn runtime_proc_drain_call_cap() -> i64 { 65536 }

fn runtime_proc_signal_pipe() -> i64 { 13 }

fn runtime_proc_disposition_ignore() -> i64 { 1 }

pub(package) fn runtime_process_pipe(fds: i64) -[Unsafe]> i64 {
  __platform_proc_pipe(fds)
}

pub(package) fn runtime_process_set_cloexec(fd: i64) -[Unsafe]> i64 {
  __platform_proc_set_cloexec(fd)
}

pub(package) fn runtime_process_set_nonblocking(fd: i64) -[Unsafe]> i64 {
  __platform_proc_set_nonblocking(fd)
}

pub(package) fn runtime_process_spawn(
  pid: i64,
  path: i64,
  argv: i64,
  envp: i64,
  plan: i64
) -[Unsafe]> i64 {
  __platform_proc_spawn(pid, path, argv, envp, plan)
}

pub(package) fn runtime_process_wait_blocking(pid: i64, status: i64) -[Unsafe]> i64 {
  __platform_proc_wait_blocking(pid, status)
}

pub(package) fn runtime_process_wait_nonblocking(pid: i64, status: i64) -[Unsafe]> i64 {
  __platform_proc_wait_nonblocking(pid, status)
}

pub(package) fn runtime_process_read(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __platform_read(fd, buf, len)
}

pub(package) fn runtime_process_write(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __platform_write(fd, buf, len)
}

pub(package) fn runtime_process_close(fd: i64) -[Unsafe]> i64 {
  __platform_close(fd)
}

pub(package) fn runtime_process_kill(pid: i64) -[Unsafe]> i64 {
  __platform_proc_kill(pid)
}

pub(package) fn runtime_process_nanosleep(request: i64) -[Unsafe]> i64 {
  __platform_time_sleep(request, 0)
}

fn runtime_proc_error_code(status: i64) -> i64 {
  if status < 0 { 0 - status } else { status }
}

pub(package) fn runtime_process_make_cstr(s: str) -> i64 {
  runtime_str_cstring(s)
}

pub(package) fn runtime_proc_args_count(args: List<str>) -> i64 {
  match args {
    Nil -> 0
    Cons(first, rest) -> 1 + runtime_proc_args_count(rest)
  }
}

pub(package) fn runtime_proc_fill_argv(argv_buf: i64, index: i64, args: List<str>) -[Unsafe]> i64
{
  match args {
    Nil -> {
      __mem_store64(argv_buf + index * 8, 0)
      0
    }
    Cons(first, rest) -> {
      __mem_store64(argv_buf + index * 8, runtime_str_cstring(first))
      runtime_proc_fill_argv(argv_buf, index + 1, rest)
    }
  }
}

fn runtime_proc_plan_new(mode: i64) -[Unsafe]> i64 {
  let plan = alloc_bump(runtime_proc_plan_size())
  __mem_store64(plan + runtime_proc_plan_stdout_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stdout_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stderr_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stderr_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_exec_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_exec_write_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_error_offset(), 0)
  __mem_store64(plan + runtime_proc_plan_capture_offset(), mode)
  __mem_store64(plan + runtime_proc_plan_stdin_read_offset(), 0 - 1)
  __mem_store64(plan + runtime_proc_plan_stdin_write_offset(), 0 - 1)
  plan
}

fn runtime_proc_plan_fd(plan: i64, offset: i64) -[Unsafe]> i64 {
  __mem_load64(plan + offset)
}

fn runtime_proc_plan_set_fd(plan: i64, offset: i64, fd: i64) -[Unsafe]> i64 {
  __mem_store64(plan + offset, fd)
  0
}

fn runtime_proc_open_pipe(plan: i64, read_offset: i64, write_offset: i64) -[Unsafe]> i64 {
  let fds = alloc_bump(16)
  __mem_store64(fds, 0 - 1)
  __mem_store64(fds + 8, 0 - 1)
  let status = runtime_process_pipe(fds)
  if status < 0 { runtime_proc_error_code(status) }
  else {
    __mem_store64(plan + read_offset, __mem_load64(fds))
    __mem_store64(plan + write_offset, __mem_load64(fds + 8))
    0
  }
}

fn runtime_proc_close_plan_fd(plan: i64, offset: i64) -[Unsafe]> i64 {
  let fd = runtime_proc_plan_fd(plan, offset)
  if fd < 0 { 0 }
  else {
    runtime_proc_plan_set_fd(plan, offset, 0 - 1)
    runtime_process_close(fd)
  }
}

fn runtime_proc_prepare_exec_pipe(plan: i64) -[Unsafe]> i64 {
  let opened = runtime_proc_open_pipe(
    plan,
    runtime_proc_plan_exec_read_offset(),
    runtime_proc_plan_exec_write_offset()
  )
  if opened != 0 { opened }
  else {
    let read_status = runtime_process_set_cloexec(
      runtime_proc_plan_fd(plan, runtime_proc_plan_exec_read_offset())
    )
    if read_status < 0 { runtime_proc_error_code(read_status) }
    else {
      let write_status = runtime_process_set_cloexec(
        runtime_proc_plan_fd(plan, runtime_proc_plan_exec_write_offset())
      )
      if write_status < 0 { runtime_proc_error_code(write_status) } else { 0 }
    }
  }
}

fn runtime_proc_prepare_capture(plan: i64) -[Unsafe]> i64 {
  let stdout_status = runtime_proc_open_pipe(
    plan,
    runtime_proc_plan_stdout_read_offset(),
    runtime_proc_plan_stdout_write_offset()
  )
  if stdout_status != 0 { stdout_status }
  else {
    let stderr_status = runtime_proc_open_pipe(
      plan,
      runtime_proc_plan_stderr_read_offset(),
      runtime_proc_plan_stderr_write_offset()
    )
    if stderr_status != 0 { stderr_status }
    else {
      let stdout_nonblocking = runtime_process_set_nonblocking(
        runtime_proc_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
      )
      if stdout_nonblocking < 0 { runtime_proc_error_code(stdout_nonblocking) }
      else {
        let stderr_nonblocking = runtime_process_set_nonblocking(
          runtime_proc_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
        )
        if stderr_nonblocking < 0 { runtime_proc_error_code(stderr_nonblocking) }
        else { runtime_proc_prepare_exec_pipe(plan) }
      }
    }
  }
}

fn runtime_proc_plan_cloexec(plan: i64, offset: i64) -[Unsafe]> i64 {
  let status = runtime_process_set_cloexec(runtime_proc_plan_fd(plan, offset))
  if status < 0 { runtime_proc_error_code(status) } else { 0 }
}

-- A session keeps three descriptors open for its lifetime. None of them
-- may reach a later child, which would hold the session open after this
-- process closed its ends; the stdin read end is likewise kept from any
-- other child. Duplication into the child's standard streams clears the
-- flag on the duplicate only.
fn runtime_proc_session_protect_descriptors(plan: i64) -[Unsafe]> i64 {
  let stdin_write = runtime_proc_plan_cloexec(plan, runtime_proc_plan_stdin_write_offset())
  if stdin_write != 0 { stdin_write }
  else {
    let stdin_read = runtime_proc_plan_cloexec(plan, runtime_proc_plan_stdin_read_offset())
    if stdin_read != 0 { stdin_read }
    else {
      let stdout_read = runtime_proc_plan_cloexec(plan, runtime_proc_plan_stdout_read_offset())
      if stdout_read != 0 { stdout_read }
      else { runtime_proc_plan_cloexec(plan, runtime_proc_plan_stderr_read_offset()) }
    }
  }
}

-- Capture pipes plus the child's standard input.
fn runtime_proc_prepare_session(plan: i64) -[Unsafe]> i64 {
  let captured = runtime_proc_prepare_capture(plan)
  if captured != 0 { captured }
  else {
    let opened = runtime_proc_open_pipe(
      plan,
      runtime_proc_plan_stdin_read_offset(),
      runtime_proc_plan_stdin_write_offset()
    )
    if opened != 0 { opened }
    else {
      let nonblocking = runtime_process_set_nonblocking(
        runtime_proc_plan_fd(plan, runtime_proc_plan_stdin_write_offset())
      )
      if nonblocking < 0 { runtime_proc_error_code(nonblocking) }
      else { runtime_proc_session_protect_descriptors(plan) }
    }
  }
}

fn runtime_proc_close_plan(plan: i64) -[Unsafe]> i64 {
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdin_read_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdin_write_offset())
  0
}

fn runtime_proc_exec_handshake(plan: i64) -[Unsafe]> i64 {
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_write_offset())
  let fd = runtime_proc_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  let mut done = false
  let mut result = 0
  while not done {
    let count = runtime_process_read(fd, plan + runtime_proc_plan_error_offset(), 8)
    if count == 0 {
      done = true
    } else {
      if count == 8 {
        result = __mem_load64(plan + runtime_proc_plan_error_offset())
        done = true
      } else {
        if count < 0 and runtime_proc_error_code(count) == 4 {
          0
        } else {
          result = if count < 0 { runtime_proc_error_code(count) } else { 5 }
          done = true
        }
      }
    }
  }
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_exec_read_offset())
  result
}

fn runtime_proc_make_argv(path: str, args: List<str>) -[Unsafe]> (i64, i64) {
  let path_c = runtime_str_cstring(path)
  let argv = alloc_bump((runtime_proc_args_count(args) + 2) * 8)
  __mem_store64(argv, path_c)
  runtime_proc_fill_argv(argv, 1, args)
  (path_c, argv)
}

fn runtime_proc_decode_wait_raw(raw: i64) -> ProcTermination {
  let signal = raw band 127
  if signal == 0 { ProcExited((raw bshr 8) band 255) }
  else { ProcSignaled(signal) }
}

fn runtime_proc_wait_blocking_raw(pid: i64, status_ptr: i64) -[Unsafe]> i64 {
  let mut done = false
  let mut result = 0
  while not done {
    let waited = runtime_process_wait_blocking(pid, status_ptr)
    if waited < 0 and runtime_proc_error_code(waited) == 4 { 0 }
    else {
      result = waited
      done = true
    }
  }
  result
}

fn runtime_proc_reap_spawn_failure(pid: i64) -[Unsafe]> i64 {
  if pid <= 0 { 0 }
  else {
    let status = alloc_bump(8)
    __mem_store64(status, 0)
    runtime_proc_wait_blocking_raw(pid, status)
  }
}

fn runtime_proc_spawn_into_plan(
  envp: i64,
  path: str,
  args: List<str>,
  plan: i64,
  mode: i64
) -[Unsafe]> i64 {
  let mut error = if mode == runtime_proc_mode_session() { runtime_proc_prepare_session(plan) }
  else {
    if mode == runtime_proc_mode_capture() { runtime_proc_prepare_capture(plan) }
    else { runtime_proc_prepare_exec_pipe(plan) }
  }
  let mut pid = 0
  if error == 0 {
    match runtime_proc_make_argv(path, args) {
      (path_c, argv) -> {
        let pid_ptr = alloc_bump(8)
        __mem_store64(pid_ptr, 0)
        let spawn_status = runtime_process_spawn(pid_ptr, path_c, argv, envp, plan)
        if spawn_status != 0 {
          error = runtime_proc_error_code(spawn_status)
        } else {
          pid = __mem_load64(pid_ptr)
          error = runtime_proc_exec_handshake(plan)
          if error != 0 {
            runtime_proc_reap_spawn_failure(pid)
            pid = 0
          } else { 0 }
        }
      }
    }
  } else { 0 }
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdout_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stderr_write_offset())
  runtime_proc_close_plan_fd(plan, runtime_proc_plan_stdin_read_offset())
  runtime_proc_plan_set_fd(plan, runtime_proc_plan_error_offset(), error)
  runtime_proc_plan_set_fd(plan, runtime_proc_plan_capture_offset(), pid)
  0
}

fn runtime_proc_construct_handle_after_restore(mark: i64, state: i64) -[Unsafe]> owned ProcHandle
{
  alloc_bump_restore_same_segment(mark)
  proc_handle_from_token(state)
}

fn runtime_proc_finish_handle(
  mark: i64,
  pid: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  error: i64
) -[Unsafe]> owned ProcHandle {
  let state = heap_alloc_zeroed(rc_default_heap(), runtime_proc_state_size(), 8)
  __mem_store64(state + runtime_proc_state_pid_offset(), pid)
  __mem_store64(state + runtime_proc_state_stdout_offset(), stdout_fd)
  __mem_store64(state + runtime_proc_state_stderr_offset(), stderr_fd)
  __mem_store64(state + runtime_proc_state_error_offset(), error)
  runtime_proc_construct_handle_after_restore(mark, state)
}

fn runtime_proc_finish_spawn(
  mark: i64,
  pid: i64,
  plan: i64,
  error: i64
) -[Unsafe]> owned ProcHandle {
  let stdout_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
  let stderr_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
  if error != 0 {
    runtime_proc_close_plan(plan)
  } else {
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stdout_read_offset(), 0 - 1)
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stderr_read_offset(), 0 - 1)
  }
  runtime_proc_finish_handle(
    mark,
    pid,
    if error == 0 { stdout_fd } else { 0 - 1 },
    if error == 0 { stderr_fd } else { 0 - 1 },
    if error == 0 { 0 } else { runtime_proc_error_code(error) }
  )
}

pub(package) fn runtime_proc_spawn(
  envp: i64,
  path: str,
  args: List<str>
) -[Unsafe]> owned ProcHandle {
  let mark = alloc_bump_mark()
  let plan = runtime_proc_plan_new(runtime_proc_mode_capture())
  runtime_proc_spawn_into_plan(envp, path, args, plan, runtime_proc_mode_capture())
  runtime_proc_finish_spawn(
    mark,
    runtime_proc_plan_fd(plan, runtime_proc_plan_capture_offset()),
    plan,
    runtime_proc_plan_fd(plan, runtime_proc_plan_error_offset())
  )
}

-- Drain bytes immediately available from a nonblocking pipe into a managed
-- buffer: at most `budget` bytes, or one per-call cap when the budget is
-- negative, so a flooding child never keeps the caller from its deadline.
-- 1 = EOF, 0 = would block or budget reached, 2 = budget reached with more
-- output pending (the probe byte is discarded), negative = error code.
pub(package) fn runtime_proc_drain(fd: i64, scratch: i64, out: i64, budget: i64) -[Unsafe]> i64 {
  let bounded = budget >= 0
  let mut remaining = if bounded { budget } else { runtime_proc_drain_call_cap() }
  let mut done = false
  let mut result = 0
  while not done {
    if remaining <= 0 {
      if bounded {
        let probe = runtime_process_read(fd, scratch, 1)
        if probe > 0 { result = 2 }
        else {
          if probe == 0 { result = 1 }
          else {
            let error = runtime_proc_error_code(probe)
            result = if error == 4 or error == 11 or error == 35 { 0 } else { 0 - error }
          }
        }
      } else { 0 }
      done = true
    } else {
      let request = if remaining < 4096 { remaining } else { 4096 }
      let count = runtime_process_read(fd, scratch, request)
      if count > 0 {
        bscopy(out, scratch, count, 0)
        remaining = remaining - count
      } else {
        if count == 0 {
          result = 1
          done = true
        } else {
          let error = runtime_proc_error_code(count)
          if error == 4 { 0 }
          else {
            result = if error == 11 or error == 35 { 0 } else { 0 - error }
            done = true
          }
        }
      }
    }
  }
  result
}

fn runtime_proc_wait_until_raw(
  pid: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  spawn_error: i64,
  deadline_nanos: i64
) -[Unsafe]> ProcOutput {
  if spawn_error != 0 {
    ProcFailed(ProcSpawnFailed(spawn_error), "", "")
  } else {
    runtime_proc_collect_until_raw(
      pid,
      stdout_fd,
      stderr_fd,
      buf_new(4096),
      buf_new(4096),
      deadline_nanos,
      0 - 1
    )
  }
}

fn runtime_proc_capture_budget(
  capture_limit: i64,
  stdout_buf: i64,
  stderr_buf: i64
) -[Unsafe]> i64 {
  if capture_limit < 0 { 0 - 1 }
  else {
    let held = buf_len(stdout_buf) + buf_len(stderr_buf)
    if held >= capture_limit { 0 } else { capture_limit - held }
  }
}

-- Drain both output descriptors into the given buffers until the child is
-- reaped, the deadline kills it, or (with a non-negative capture limit) its
-- unread output would exceed the limit, which also kills it. Then close the
-- descriptors. Callers seed the buffers with output they had already stored.
fn runtime_proc_collect_until_raw(
  pid: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  stdout_buf: i64,
  stderr_buf: i64,
  deadline_nanos: i64,
  capture_limit: i64
) -[Unsafe]> ProcOutput {
  {
    let mark = alloc_bump_mark()
    let scratch = alloc_bump(4096)
    let status_ptr = alloc_bump(8)
    let pause_request = alloc_bump(16)
    __mem_store64(status_ptr, 0)
    __mem_store64(pause_request, 0)
    __mem_store64(pause_request + 8, 1000000)
    let mut stdout_eof = stdout_fd < 0
    let mut stderr_eof = stderr_fd < 0
    let mut capture_error = 0
    let mut wait_error = 0
    let mut status_raw = 0
    let mut child_done = false
    let mut timed_out = false
    let mut limit_exceeded = false

    while not child_done {
      if not stdout_eof {
        let state = runtime_proc_drain(
          stdout_fd,
          scratch,
          stdout_buf,
          runtime_proc_capture_budget(capture_limit, stdout_buf, stderr_buf)
        )
        if state == 1 { stdout_eof = true }
        else {
          if state == 2 { limit_exceeded = true }
          else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
        }
      } else { 0 }
      if not stderr_eof {
        let state = runtime_proc_drain(
          stderr_fd,
          scratch,
          stderr_buf,
          runtime_proc_capture_budget(capture_limit, stdout_buf, stderr_buf)
        )
        if state == 1 { stderr_eof = true }
        else {
          if state == 2 { limit_exceeded = true }
          else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
        }
      } else { 0 }

      let waited = if limit_exceeded {
        -- The child cannot be captured safely: kill and reap it now.
        runtime_process_kill(pid)
        runtime_proc_wait_blocking_raw(pid, status_ptr)
      } else { runtime_process_wait_nonblocking(pid, status_ptr) }
      if waited == pid {
        status_raw = __mem_load64(status_ptr)
        child_done = true
      } else {
        if waited < 0 {
          let error = runtime_proc_error_code(waited)
          if error == 4 { runtime_process_nanosleep(pause_request) }
          else {
            wait_error = error
            child_done = true
          }
        } else {
          let now = if deadline_nanos < 0 { 0 } else { runtime_time_now_nanos() }
          if deadline_nanos >= 0 and (now < 0 or now >= deadline_nanos) {
            runtime_process_kill(pid)
            let reaped = runtime_proc_wait_blocking_raw(pid, status_ptr)
            if reaped == pid {
              status_raw = __mem_load64(status_ptr)
              timed_out = now >= 0
              if now < 0 { wait_error = 5 } else { 0 }
            } else {
              wait_error = runtime_proc_error_code(reaped)
            }
            child_done = true
          } else {
            runtime_process_nanosleep(pause_request)
          }
        }
      }
    }

    if not stdout_eof and not limit_exceeded {
      let state = runtime_proc_drain(
        stdout_fd,
        scratch,
        stdout_buf,
        runtime_proc_capture_budget(capture_limit, stdout_buf, stderr_buf)
      )
      if state == 2 { limit_exceeded = true }
      else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
    } else { 0 }
    if not stderr_eof and not limit_exceeded {
      let state = runtime_proc_drain(
        stderr_fd,
        scratch,
        stderr_buf,
        runtime_proc_capture_budget(capture_limit, stdout_buf, stderr_buf)
      )
      if state == 2 { limit_exceeded = true }
      else { if state < 0 and capture_error == 0 { capture_error = 0 - state } else { 0 } }
    } else { 0 }
    if stdout_fd >= 0 { runtime_process_close(stdout_fd) } else { 0 }
    if stderr_fd >= 0 { runtime_process_close(stderr_fd) } else { 0 }

    let stdout_text = runtime_str_from_bytes(buf_ptr(stdout_buf), buf_len(stdout_buf))
    let stderr_text = runtime_str_from_bytes(buf_ptr(stderr_buf), buf_len(stderr_buf))
    alloc_bump_restore_same_segment(mark)
    if wait_error != 0 {
      ProcFailed(ProcWaitFailed(wait_error), stdout_text, stderr_text)
    } else {
      if capture_error != 0 {
        ProcFailed(ProcCaptureFailed(capture_error), stdout_text, stderr_text)
      } else {
        if limit_exceeded {
          ProcFailed(
            ProcOutputLimitExceeded(runtime_proc_usize(capture_limit)),
            stdout_text,
            stderr_text
          )
        } else {
          if timed_out {
            ProcTimedOut(runtime_proc_decode_wait_raw(status_raw), stdout_text, stderr_text)
          } else {
            ProcCompleted(runtime_proc_decode_wait_raw(status_raw), stdout_text, stderr_text)
          }
        }
      }
    }
  }
}

pub(package) fn runtime_proc_wait_until(
  resource: ProcHandle,
  deadline_nanos: i64
) -[Unsafe]> ProcOutput {
  let state = proc_handle_release_token(resource)
  let pid = __mem_load64(state + runtime_proc_state_pid_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_state_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_state_stderr_offset())
  let spawn_error = __mem_load64(state + runtime_proc_state_error_offset())
  heap_free(rc_default_heap(), state, runtime_proc_state_size())
  runtime_proc_wait_until_raw(pid, stdout_fd, stderr_fd, spawn_error, deadline_nanos)
}

pub(package) fn runtime_proc_wait(resource: ProcHandle) -[Unsafe]> ProcOutput {
  runtime_proc_wait_until(resource, 0 - 1)
}

fn runtime_proc_release_raw(
  pid: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  spawn_error: i64
) -[Unsafe]> i64 {
  if pid > 0 { runtime_process_kill(pid) } else { 0 }
  if stdout_fd >= 0 { runtime_process_close(stdout_fd) } else { 0 }
  if stderr_fd >= 0 { runtime_process_close(stderr_fd) } else { 0 }
  if pid > 0 {
    let mark = alloc_bump_mark()
    let status_ptr = alloc_bump(8)
    __mem_store64(status_ptr, 0)
    let waited = runtime_proc_wait_blocking_raw(pid, status_ptr)
    alloc_bump_restore_same_segment(mark)
    if waited < 0 { runtime_proc_error_code(waited) } else { 0 }
  } else { spawn_error }
}

pub(package) fn runtime_proc_release(resource: ProcHandle) -[Unsafe]> i64 {
  let state = proc_handle_release_token(resource)
  let pid = __mem_load64(state + runtime_proc_state_pid_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_state_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_state_stderr_offset())
  let spawn_error = __mem_load64(state + runtime_proc_state_error_offset())
  heap_free(rc_default_heap(), state, runtime_proc_state_size())
  runtime_proc_release_raw(pid, stdout_fd, stderr_fd, spawn_error)
}

pub(package) fn runtime_proc_run(
  envp: i64,
  path: str,
  args: List<str>
) -[Unsafe]> Result<ProcTermination, ProcError> {
  let mark = alloc_bump_mark()
  let plan = runtime_proc_plan_new(runtime_proc_mode_inherit())
  runtime_proc_spawn_into_plan(envp, path, args, plan, runtime_proc_mode_inherit())
  let pid = runtime_proc_plan_fd(plan, runtime_proc_plan_capture_offset())
  let spawn_error = runtime_proc_plan_fd(plan, runtime_proc_plan_error_offset())
  let status_ptr = alloc_bump(8)
  __mem_store64(status_ptr, 0)
  let waited = if spawn_error == 0 { runtime_proc_wait_blocking_raw(pid, status_ptr) } else { 0 }
  let status_raw = __mem_load64(status_ptr)
  runtime_proc_close_plan(plan)
  alloc_bump_restore_same_segment(mark)
  if spawn_error != 0 {
    Err<ProcTermination, ProcError>(ProcSpawnFailed(spawn_error))
  } else {
    if waited != pid {
      Err<ProcTermination, ProcError>(ProcWaitFailed(runtime_proc_error_code(waited)))
    } else {
      Ok<ProcTermination, ProcError>(runtime_proc_decode_wait_raw(status_raw))
    }
  }
}

-- Session buffers are raw heap blocks: pointer, length and capacity words
-- at the given state offset. They hold output drained while a write waited.
fn runtime_proc_session_buffer_len(state: i64, offset: i64) -[Unsafe]> i64 {
  __mem_load64(state + offset + 8)
}

fn runtime_proc_session_buffer_append(
  state: i64,
  offset: i64,
  src: i64,
  count: i64
) -[Unsafe]> i64 {
  let ptr = __mem_load64(state + offset)
  let len = __mem_load64(state + offset + 8)
  let cap = __mem_load64(state + offset + 16)
  if len + count > cap {
    let mut grown = if cap == 0 { runtime_proc_session_scratch_size() } else { cap * 2 }
    while grown < len + count { grown = grown * 2 }
    let moved = heap_alloc(rc_default_heap(), grown, 8)
    if len > 0 { mem_copy(moved, ptr, len) } else { 0 }
    if ptr != 0 { heap_free(rc_default_heap(), ptr, cap) } else { 0 }
    __mem_store64(state + offset, moved)
    __mem_store64(state + offset + 16, grown)
  } else { 0 }
  mem_copy(__mem_load64(state + offset) + len, src, count)
  __mem_store64(state + offset + 8, len + count)
  0
}

-- Take up to `limit` stored bytes as an immutable value and shift the rest
-- forward. Requires a non-empty buffer.
fn runtime_proc_session_buffer_take(state: i64, offset: i64, limit: i64) -[Unsafe]> Bytes {
  let ptr = __mem_load64(state + offset)
  let len = __mem_load64(state + offset + 8)
  let taken = if limit < len { limit } else { len }
  let out = bytes_from_storage(runtime_str_from_bytes_copy(ptr, taken))
  if len > taken { mem_copy(ptr, ptr + taken, len - taken) } else { 0 }
  __mem_store64(state + offset + 8, len - taken)
  out
}

fn runtime_proc_session_buffer_free(state: i64, offset: i64) -[Unsafe]> i64 {
  let ptr = __mem_load64(state + offset)
  let cap = __mem_load64(state + offset + 16)
  if ptr != 0 { heap_free(rc_default_heap(), ptr, cap) } else { 0 }
  __mem_store64(state + offset, 0)
  __mem_store64(state + offset + 8, 0)
  __mem_store64(state + offset + 16, 0)
  0
}

-- Move bytes immediately available on one output stream into its session
-- buffer, at most `budget` of them. 1 = end of input, 0 = drained, would
-- block or budget reached, negative = portable error code.
fn runtime_proc_session_drain(
  state: i64,
  fd_offset: i64,
  eof_offset: i64,
  buffer_offset: i64,
  scratch: i64,
  budget: i64
) -[Unsafe]> i64 {
  if __mem_load64(state + eof_offset) == 1 { 1 }
  else {
    let fd = __mem_load64(state + fd_offset)
    let mut remaining = budget
    let mut done = remaining <= 0
    let mut result = 0
    while not done {
      let request = if remaining < runtime_proc_session_scratch_size() { remaining } else {
        runtime_proc_session_scratch_size()
      }
      let count = runtime_process_read(fd, scratch, request)
      if count > 0 {
        runtime_proc_session_buffer_append(state, buffer_offset, scratch, count)
        remaining = remaining - count
        if remaining <= 0 { done = true } else { 0 }
      } else {
        if count == 0 {
          __mem_store64(state + eof_offset, 1)
          result = 1
          done = true
        } else {
          let error = runtime_proc_error_code(count)
          if error == 4 { 0 }
          else {
            result = if error == 11 or error == 35 { 0 } else { 0 - error }
            done = true
          }
        }
      }
    }
    result
  }
}

-- Read once from one output stream into scratch: bytes read, 0 when nothing
-- is available, negative error code. End of input sets the stream's flag.
fn runtime_proc_session_read_stream(
  state: i64,
  fd_offset: i64,
  eof_offset: i64,
  scratch: i64,
  request: i64
) -[Unsafe]> i64 {
  if __mem_load64(state + eof_offset) == 1 { 0 }
  else {
    let fd = __mem_load64(state + fd_offset)
    let mut done = false
    let mut result = 0
    while not done {
      let count = runtime_process_read(fd, scratch, request)
      if count > 0 {
        result = count
        done = true
      } else {
        if count == 0 {
          __mem_store64(state + eof_offset, 1)
          done = true
        } else {
          let error = runtime_proc_error_code(count)
          if error == 4 { 0 }
          else {
            result = if error == 11 or error == 35 { 0 } else { 0 - error }
            done = true
          }
        }
      }
    }
    result
  }
}

fn runtime_proc_session_stored_total(state: i64) -[Unsafe]> i64 {
  runtime_proc_session_buffer_len(state, runtime_proc_session_stdout_buffer_offset()) +
    runtime_proc_session_buffer_len(state, runtime_proc_session_stderr_buffer_offset())
}

fn runtime_proc_session_store_budget(state: i64) -[Unsafe]> i64 {
  let limit = __mem_load64(state + runtime_proc_session_store_limit_offset())
  let held = runtime_proc_session_stored_total(state)
  if held >= limit { 0 } else { limit - held }
}

fn runtime_proc_session_both_ended(state: i64) -[Unsafe]> bool {
  __mem_load64(state + runtime_proc_session_stdout_eof_offset()) == 1 and
    __mem_load64(state + runtime_proc_session_stderr_eof_offset()) == 1
}

fn runtime_proc_session_new_state(
  pid: i64,
  stdin_fd: i64,
  stdout_fd: i64,
  stderr_fd: i64,
  error: i64,
  store_limit: i64
) -[Unsafe]> i64 {
  let state = heap_alloc_zeroed(rc_default_heap(), runtime_proc_session_size(), 8)
  __mem_store64(state + runtime_proc_session_pid_offset(), pid)
  __mem_store64(
    state + runtime_proc_session_store_limit_offset(),
    if store_limit < 0 { 0 } else { store_limit }
  )
  __mem_store64(state + runtime_proc_session_stdin_offset(), stdin_fd)
  __mem_store64(state + runtime_proc_session_stdout_offset(), stdout_fd)
  __mem_store64(state + runtime_proc_session_stderr_offset(), stderr_fd)
  __mem_store64(state + runtime_proc_session_error_offset(), error)
  __mem_store64(
    state + runtime_proc_session_stdout_eof_offset(),
    if stdout_fd < 0 { 1 } else { 0 }
  )
  __mem_store64(
    state + runtime_proc_session_stderr_eof_offset(),
    if stderr_fd < 0 { 1 } else { 0 }
  )
  state
}

fn runtime_proc_session_free_state(state: i64) -[Unsafe]> i64 {
  runtime_proc_session_buffer_free(state, runtime_proc_session_stdout_buffer_offset())
  runtime_proc_session_buffer_free(state, runtime_proc_session_stderr_buffer_offset())
  heap_free(rc_default_heap(), state, runtime_proc_session_size())
}

fn runtime_proc_construct_session_after_restore(
  mark: i64,
  state: i64
) -[Unsafe]> owned ProcSession {
  alloc_bump_restore_same_segment(mark)
  proc_session_from_token(state)
}

pub(package) fn runtime_proc_open_session(
  envp: i64,
  path: str,
  args: List<str>,
  store_limit: i64
) -[Unsafe]> owned ProcSession {
  let mark = alloc_bump_mark()
  let plan = runtime_proc_plan_new(runtime_proc_mode_session())
  runtime_proc_spawn_into_plan(envp, path, args, plan, runtime_proc_mode_session())
  let pid = runtime_proc_plan_fd(plan, runtime_proc_plan_capture_offset())
  let error = runtime_proc_plan_fd(plan, runtime_proc_plan_error_offset())
  let stdin_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stdin_write_offset())
  let stdout_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stdout_read_offset())
  let stderr_fd = runtime_proc_plan_fd(plan, runtime_proc_plan_stderr_read_offset())
  if error != 0 {
    runtime_proc_close_plan(plan)
  } else {
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stdin_write_offset(), 0 - 1)
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stdout_read_offset(), 0 - 1)
    runtime_proc_plan_set_fd(plan, runtime_proc_plan_stderr_read_offset(), 0 - 1)
  }
  let state = runtime_proc_session_new_state(
    pid,
    if error == 0 { stdin_fd } else { 0 - 1 },
    if error == 0 { stdout_fd } else { 0 - 1 },
    if error == 0 { stderr_fd } else { 0 - 1 },
    if error == 0 { 0 } else { runtime_proc_error_code(error) },
    store_limit
  )
  runtime_proc_construct_session_after_restore(mark, state)
}

fn runtime_proc_usize(value: i64) -> usize { __i64_to_usize(value) }

-- SIGPIPE policy: a child that stopped reading must yield EPIPE, never
-- terminate this process, so the disposition is set to ignore for exactly
-- the duration of one write and restored afterwards. No child is spawned
-- inside the loop, so no child inherits the ignored disposition.
fn runtime_proc_session_write_raw(
  state: i64,
  fd: i64,
  chunk: Bytes,
  deadline_nanos: i64
) -[Unsafe]> ProcWriteOutcome {
  let mark = alloc_bump_mark()
  let scratch = alloc_bump(runtime_proc_session_scratch_size())
  let pause_request = alloc_bump(16)
  __mem_store64(pause_request, 0)
  __mem_store64(pause_request + 8, 1000000)
  let flat = chunk.to_vector()
  let total = __u64_to_i64(__usize_to_u64(flat.len()))
  let data = vector_data<u8>(flat)
  let previous_disposition = runtime_shutdown_set_disposition(
    runtime_proc_signal_pipe(),
    runtime_proc_disposition_ignore()
  )
  let mut written = 0
  let mut done = total == 0
  -- 0 written, 1 refused, 2 timed out, 3 blocked on stored output, negative = error code
  let mut verdict = 0
  while not done {
    let count = runtime_process_write(fd, data + written, total - written)
    if count > 0 {
      written = written + count
      if written >= total { done = true } else { 0 }
    } else {
      let error = if count == 0 { 11 } else { runtime_proc_error_code(count) }
      if error == 4 { 0 }
      else {
        if error == 11 or error == 35 {
          -- The child may be blocked on its own output: store what the limit
          -- allows, and if the store is full only the caller's reads can help.
          runtime_proc_session_drain(
            state,
            runtime_proc_session_stdout_offset(),
            runtime_proc_session_stdout_eof_offset(),
            runtime_proc_session_stdout_buffer_offset(),
            scratch,
            runtime_proc_session_store_budget(state)
          )
          runtime_proc_session_drain(
            state,
            runtime_proc_session_stderr_offset(),
            runtime_proc_session_stderr_eof_offset(),
            runtime_proc_session_stderr_buffer_offset(),
            scratch,
            runtime_proc_session_store_budget(state)
          )
          let held = runtime_proc_session_stored_total(state)
          if held > 0 and held >= __mem_load64(state + runtime_proc_session_store_limit_offset()) {
            verdict = 3
            done = true
          } else {
            runtime_process_nanosleep(pause_request)
          }
        } else {
          if error == 32 {
            verdict = 1
            done = true
          } else {
            verdict = 0 - error
            done = true
          }
        }
      }
    }
    -- The deadline is honoured on every iteration, progressing or not.
    if not done {
      let now = runtime_time_now_nanos()
      if now < 0 {
        verdict = 0 - 5
        done = true
      } else {
        if now >= deadline_nanos {
          verdict = 2
          done = true
        } else { 0 }
      }
    } else { 0 }
  }
  if previous_disposition >= 0 {
    runtime_shutdown_set_disposition(runtime_proc_signal_pipe(), previous_disposition)
  } else { 0 }
  alloc_bump_restore_same_segment(mark)
  if verdict == 0 { ProcWritten }
  else {
    if verdict == 1 { ProcWriteRefused(runtime_proc_usize(written)) }
    else {
      if verdict == 2 { ProcWriteTimedOut(runtime_proc_usize(written)) }
      else {
        if verdict == 3 { ProcWriteBlocked(runtime_proc_usize(written)) }
        else { ProcWriteFailed(ProcStreamFailed(0 - verdict), runtime_proc_usize(written)) }
      }
    }
  }
}

pub(package) fn runtime_proc_session_write(
  session: ProcSession,
  chunk: Bytes,
  deadline_nanos: i64
) -[Unsafe]> (owned ProcSession, ProcWriteOutcome) {
  let state = proc_session_release_token(session)
  let error = __mem_load64(state + runtime_proc_session_error_offset())
  let fd = __mem_load64(state + runtime_proc_session_stdin_offset())
  let outcome = if error != 0 { ProcWriteFailed(ProcSpawnFailed(error), runtime_proc_usize(0)) }
  else {
    if fd < 0 { ProcWriteRefused(runtime_proc_usize(0)) }
    else { runtime_proc_session_write_raw(state, fd, chunk, deadline_nanos) }
  }
  (proc_session_from_token(state), outcome)
}

pub(package) fn runtime_proc_session_close_input(
  session: ProcSession
) -[Unsafe]> owned ProcSession {
  let state = proc_session_release_token(session)
  let fd = __mem_load64(state + runtime_proc_session_stdin_offset())
  if fd >= 0 {
    __mem_store64(state + runtime_proc_session_stdin_offset(), 0 - 1)
    runtime_process_close(fd)
  } else { 0 }
  proc_session_from_token(state)
}

-- Poll both streams until a chunk, end of input on both, the deadline or a
-- failure. Verdict: 1 stdout chunk, 2 stderr chunk, 3 ended, 4 timed out,
-- negative = error code; the chunk is captured before the scratch is freed.
fn runtime_proc_session_read_raw(
  state: i64,
  limit: i64,
  deadline_nanos: i64
) -[Unsafe]> ProcReadOutcome {
  let mark = alloc_bump_mark()
  let scratch = alloc_bump(runtime_proc_session_scratch_size())
  let pause_request = alloc_bump(16)
  __mem_store64(pause_request, 0)
  __mem_store64(pause_request + 8, 1000000)
  let request = if limit < runtime_proc_session_scratch_size() { limit } else {
    runtime_proc_session_scratch_size()
  }
  let mut payload = bytes.empty()
  let mut verdict = 0
  while verdict == 0 {
    let stdout_count = runtime_proc_session_read_stream(
      state,
      runtime_proc_session_stdout_offset(),
      runtime_proc_session_stdout_eof_offset(),
      scratch,
      request
    )
    if stdout_count > 0 {
      payload = bytes_from_storage(runtime_str_from_bytes_copy(scratch, stdout_count))
      verdict = 1
    } else {
      if stdout_count < 0 {
        verdict = stdout_count
      } else {
        let stderr_count = runtime_proc_session_read_stream(
          state,
          runtime_proc_session_stderr_offset(),
          runtime_proc_session_stderr_eof_offset(),
          scratch,
          request
        )
        if stderr_count > 0 {
          payload = bytes_from_storage(runtime_str_from_bytes_copy(scratch, stderr_count))
          verdict = 2
        } else {
          if stderr_count < 0 {
            verdict = stderr_count
          } else {
            if runtime_proc_session_both_ended(state) {
              verdict = 3
            } else {
              let now = runtime_time_now_nanos()
              if now < 0 { verdict = 0 - 5 }
              else {
                if now >= deadline_nanos { verdict = 4 }
                else { runtime_process_nanosleep(pause_request) }
              }
            }
          }
        }
      }
    }
  }
  alloc_bump_restore_same_segment(mark)
  if verdict == 1 { ProcReadChunk(ProcStdout, payload) }
  else {
    if verdict == 2 { ProcReadChunk(ProcStderr, payload) }
    else {
      if verdict == 3 { ProcReadEnded }
      else {
        if verdict == 4 { ProcReadTimedOut }
        else { ProcReadFailed(ProcStreamFailed(0 - verdict)) }
      }
    }
  }
}

pub(package) fn runtime_proc_session_read(
  session: ProcSession,
  limit: i64,
  deadline_nanos: i64
) -[Unsafe]> (owned ProcSession, ProcReadOutcome) {
  let state = proc_session_release_token(session)
  let error = __mem_load64(state + runtime_proc_session_error_offset())
  let outcome = if error != 0 { ProcReadFailed(ProcSpawnFailed(error)) }
  else {
    if limit <= 0 { ProcReadFailed(ProcStreamFailed(22)) }
    else {
      if runtime_proc_session_buffer_len(state, runtime_proc_session_stdout_buffer_offset()) > 0 {
        ProcReadChunk(
          ProcStdout,
          runtime_proc_session_buffer_take(
            state,
            runtime_proc_session_stdout_buffer_offset(),
            limit
          )
        )
      } else {
        if runtime_proc_session_buffer_len(state, runtime_proc_session_stderr_buffer_offset()) >
          0 {
            ProcReadChunk(
              ProcStderr,
              runtime_proc_session_buffer_take(
                state,
                runtime_proc_session_stderr_buffer_offset(),
                limit
              )
            )
          } else { runtime_proc_session_read_raw(state, limit, deadline_nanos) }
      }
    }
  }
  (proc_session_from_token(state), outcome)
}

-- Seed a collection buffer with the output a session had stored.
fn runtime_proc_session_seed_buffer(state: i64, offset: i64) -[Unsafe]> i64 {
  let len = __mem_load64(state + offset + 8)
  let seeded = buf_new(4096 + len)
  if len > 0 { bscopy(seeded, __mem_load64(state + offset), len, 0) } else { 0 }
  seeded
}

pub(package) fn runtime_proc_session_finish_until(
  session: ProcSession,
  deadline_nanos: i64
) -[Unsafe]> ProcOutput {
  let state = proc_session_release_token(session)
  let pid = __mem_load64(state + runtime_proc_session_pid_offset())
  let stdin_fd = __mem_load64(state + runtime_proc_session_stdin_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_session_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_session_stderr_offset())
  let error = __mem_load64(state + runtime_proc_session_error_offset())
  if stdin_fd >= 0 { runtime_process_close(stdin_fd) } else { 0 }
  let store_limit = __mem_load64(state + runtime_proc_session_store_limit_offset())
  let stdout_buf = runtime_proc_session_seed_buffer(
    state,
    runtime_proc_session_stdout_buffer_offset()
  )
  let stderr_buf = runtime_proc_session_seed_buffer(
    state,
    runtime_proc_session_stderr_buffer_offset()
  )
  runtime_proc_session_free_state(state)
  if error != 0 {
    ProcFailed(ProcSpawnFailed(error), "", "")
  } else {
    runtime_proc_collect_until_raw(
      pid,
      stdout_fd,
      stderr_fd,
      stdout_buf,
      stderr_buf,
      deadline_nanos,
      store_limit
    )
  }
}

pub(package) fn runtime_proc_session_release(session: ProcSession) -[Unsafe]> i64 {
  let state = proc_session_release_token(session)
  let pid = __mem_load64(state + runtime_proc_session_pid_offset())
  let stdin_fd = __mem_load64(state + runtime_proc_session_stdin_offset())
  let stdout_fd = __mem_load64(state + runtime_proc_session_stdout_offset())
  let stderr_fd = __mem_load64(state + runtime_proc_session_stderr_offset())
  let error = __mem_load64(state + runtime_proc_session_error_offset())
  if stdin_fd >= 0 { runtime_process_close(stdin_fd) } else { 0 }
  runtime_proc_session_free_state(state)
  runtime_proc_release_raw(pid, stdout_fd, stderr_fd, error)
}

pub(package) fn proc_spawn(path: str, args: List<str>) -[Proc]> owned ProcHandle {
  Proc.spawn(path, args)
}

pub(package) fn proc_wait(resource: owned ProcHandle) -[Proc]> ProcOutput {
  Proc.wait(resource)
}

pub(package) fn proc_wait_until(resource: owned ProcHandle, deadline: Instant) -[Proc]> ProcOutput
{
  Proc.wait_until(resource, deadline)
}

fn runtime_proc_run_safe(
  envp: i64,
  path: str,
  args: List<str>
) -> Result<ProcTermination, ProcError> {
  handle runtime_proc_run(envp, path, args) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_spawn_safe(envp: i64, path: str, args: List<str>) -> owned ProcHandle {
  handle runtime_proc_spawn(envp, path, args) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_wait_safe(resource: ProcHandle) -> ProcOutput {
  handle runtime_proc_wait(resource) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_wait_until_safe(resource: ProcHandle, deadline_nanos: i64) -> ProcOutput {
  handle runtime_proc_wait_until(resource, deadline_nanos) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_release_safe(resource: ProcHandle) -> i64 {
  handle runtime_proc_release(resource) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_open_session_safe(
  envp: i64,
  path: str,
  args: List<str>,
  store_limit: i64
) -> owned ProcSession {
  handle runtime_proc_open_session(envp, path, args, store_limit) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_session_write_safe(
  session: ProcSession,
  chunk: Bytes,
  deadline_nanos: i64
) -> (owned ProcSession, ProcWriteOutcome) {
  handle runtime_proc_session_write(session, chunk, deadline_nanos) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_session_close_input_safe(session: ProcSession) -> owned ProcSession {
  handle runtime_proc_session_close_input(session) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_session_read_safe(
  session: ProcSession,
  limit: i64,
  deadline_nanos: i64
) -> (owned ProcSession, ProcReadOutcome) {
  handle runtime_proc_session_read(session, limit, deadline_nanos) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_session_finish_until_safe(session: ProcSession, deadline_nanos: i64) -> ProcOutput
{
  handle runtime_proc_session_finish_until(session, deadline_nanos) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_proc_session_release_safe(session: ProcSession) -> i64 {
  handle runtime_proc_session_release(session) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_proc_limit(limit: usize) -> i64 { __u64_to_i64(__usize_to_u64(limit)) }

--- Interpret Proc through the target platform with the current process's
--- inherited environment.
pub implements Proc(argc: i64, argv: i64) {
  Proc.run(path, args) ->
    resume(runtime_proc_run_safe(runtime_env_pointer(argc, argv), path, args))
  Proc.spawn(path, args) ->
    resume(runtime_proc_spawn_safe(runtime_env_pointer(argc, argv), path, args))
  Proc.wait(resource) -> resume(runtime_proc_wait_safe(resource))
  Proc.wait_until(resource, deadline) ->
    resume(runtime_proc_wait_until_safe(resource, deadline.nanoseconds()))
  Proc.release(resource) -> resume(runtime_proc_release_safe(resource))
  Proc.open_session(path, args, store_limit) ->
    resume(
      runtime_proc_open_session_safe(
        runtime_env_pointer(argc, argv),
        path,
        args,
        runtime_proc_limit(store_limit)
      )
    )
  Proc.session_write(session, chunk, deadline) ->
    resume(runtime_proc_session_write_safe(session, chunk, deadline.nanoseconds()))
  Proc.session_close_input(session) -> resume(runtime_proc_session_close_input_safe(session))
  Proc.session_read(session, limit, deadline) ->
    resume(
      runtime_proc_session_read_safe(session, runtime_proc_limit(limit), deadline.nanoseconds())
    )
  Proc.session_finish(session) -> resume(runtime_proc_session_finish_until_safe(session, 0 - 1))
  Proc.session_finish_until(session, deadline) ->
    resume(runtime_proc_session_finish_until_safe(session, deadline.nanoseconds()))
  Proc.session_release(session) -> resume(runtime_proc_session_release_safe(session))
}
