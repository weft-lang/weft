-- runtime/file_read.weft — production whole-file read interpretation

use runtime/safe_file_core.{runtime_safe_file_read_result}
use stdlib/file.{FileRead}

--- Interpret FileRead through the target platform filesystem.
pub implements FileRead() {
  FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
}
