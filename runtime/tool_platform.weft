-- runtime/tool_platform.weft -- combined platform boundary for native tools
--
-- Ordinary tools can compose Env, Dir, Time, and Proc while this narrowly
-- trusted leaf installs their real handlers and keeps Unsafe sealed. The
-- explicit residual effect sets are intentional: Weft does not infer effect
-- tails, so each layer documents exactly what it forwards.

use runtime/dir.{*}
use runtime/process.{*}

pub(package) fn runtime_tool_dir_inner(body: () -[Dir, Env, Proc, Time]> i64) -[Env, Proc, Time, Unsafe]> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_dir_list(path))
    Dir.stat(path) -> resume(runtime_dir_stat(path))
    Dir.mkdir(path) -> resume(runtime_dir_mkdir(path))
    Dir.remove(path) -> resume(runtime_dir_remove(path))
    Dir.rename(from, to) -> resume(runtime_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_dir_getcwd())
  }
}

pub(package) fn runtime_tool_time_inner(body: () -[Env, Proc, Time, Unsafe]> i64) -[Env, Proc, Unsafe]> i64 {
  handle body() {
    Time.now_millis() -> resume(runtime_time_now_millis())
    Time.now_nanos() -> resume(runtime_time_now_nanos())
    Time.sleep_millis(ms) -> resume(runtime_time_sleep_millis(ms))
  }
}

pub(package) fn runtime_tool_proc_inner(body: () -[Env, Proc, Unsafe]> i64) -[Env, Unsafe]> i64 {
  handle body() {
    Proc.run(path, args) -> resume(runtime_proc_run(path, args))
    Proc.spawn(path, args) -> resume(runtime_proc_spawn(path, args))
    Proc.wait(resource) -> resume(runtime_proc_wait(resource))
    Proc.wait_until(resource, deadline_nanos) -> resume(runtime_proc_wait_until(resource, deadline_nanos))
    Proc.release(resource) -> resume(runtime_proc_release(resource))
  }
}

pub(package) fn runtime_tool_env_outer(argc: i64, argv: i64, body: () -[Env, Unsafe]> i64) -[Unsafe]> i64 {
  handle body() {
    Env.arg_count() -> resume(argc)
    Env.arg(index) -> resume(runtime_env_arg_str(argc, argv, index))
    Env.var(name) -> resume(runtime_env_var(name))
  }
}

pub(package) fn runtime_tool_platform_handle(argc: i64, argv: i64, body: () -[Dir, Env, Proc, Time]> i64) -[Unsafe]> i64 {
  runtime_tool_env_outer(argc, argv, () =>
    runtime_tool_proc_inner(() =>
      runtime_tool_time_inner(() =>
        runtime_tool_dir_inner(body))))
}

pub(package) fn runtime_platform_tool(argc: i64, argv: i64, body: () -[Dir, Env, Proc, Time]> i64) -> i64 {
  handle runtime_tool_platform_handle(argc, argv, body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
