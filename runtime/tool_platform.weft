-- runtime/tool_platform.weft -- combined platform boundary for native tools
--
-- Ordinary tools can compose Env, Dir, monotonic time, and Proc while this narrowly
-- trusted leaf installs their real handlers and keeps Unsafe sealed. The
-- explicit residual effect sets are intentional: Weft does not infer effect
-- tails, so each layer documents exactly what it forwards.

use runtime/dir.{*}
use runtime/env.{*}
use runtime/panic.{runtime_trap}
use runtime/process.{*}
use runtime/time.{*}
use runtime/unsafe.{*}
use stdlib/dir.{*}
use stdlib/env.{Env}
use stdlib/process.{*}
use stdlib/time/monotonic as monotonic
use stdlib/time/monotonic.{MonotonicClock}

-- Linker fixture only: production process execution is syscall-backed and
-- runtime/process.weft intentionally has no Darwin GOT dependency.
pub(package) fn runtime_libsystem_write_fixture(fd: i64, buf: i64, len: i64) -[Unsafe]> i64 {
  __got_write(fd, buf, len, 0, 0, 0)
}

pub(package) fn runtime_tool_dir_inner(body: () -[Dir, Env, Proc, MonotonicClock]> i64) -[Env, Proc, MonotonicClock, Unsafe]> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_dir_list(path))
    Dir.stat(path) -> resume(runtime_dir_stat(path))
    Dir.lstat(path) -> resume(runtime_dir_lstat(path))
    Dir.mkdir(path) -> resume(runtime_dir_mkdir(path))
    Dir.remove(path) -> resume(runtime_dir_remove(path))
    Dir.rename(from, to) -> resume(runtime_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_dir_getcwd())
  }
}

pub(package) fn runtime_tool_monotonic_inner(body: () -[Env, Proc, MonotonicClock, Unsafe]> i64) -[Env, Proc, Unsafe]> i64 {
  handle body() {
    MonotonicClock.now() -> {
      let now = runtime_time_now_nanos()
      if now < 0 {
        runtime_trap(47, 0)
      } else {
        resume(monotonic.nanoseconds(now))
      }
    }
  }
}

pub(package) fn runtime_tool_proc_inner(envp: i64, body: () -[Env, Proc, Unsafe]> i64) -[Env, Unsafe]> i64 {
  handle body() {
    Proc.run(path, args) -> resume(runtime_proc_run(envp, path, args))
    Proc.spawn(path, args) -> resume(runtime_proc_spawn(envp, path, args))
    Proc.wait(resource) -> resume(runtime_proc_wait(resource))
    Proc.wait_until(resource, deadline) -> resume(runtime_proc_wait_until(resource, deadline.nanoseconds()))
    Proc.release(resource) -> resume(runtime_proc_release(resource))
  }
}

pub(package) fn runtime_tool_env_outer(argc: i64, argv: i64, body: () -[Env, Unsafe]> i64) -[Unsafe]> i64 {
  let envp = runtime_env_pointer(argc, argv)
  handle body() {
    Env.arg_count() -> resume(argc)
    Env.arg(index) -> resume(runtime_env_arg_str(argc, argv, index))
    Env.var(name) -> resume(runtime_env_var(envp, name))
  }
}

pub(package) fn runtime_tool_platform_handle(argc: i64, argv: i64, body: () -[Dir, Env, Proc, MonotonicClock]> i64) -[Unsafe]> i64 {
  let envp = runtime_env_pointer(argc, argv)
  runtime_tool_env_outer(argc, argv, () =>
    runtime_tool_proc_inner(envp, () =>
      runtime_tool_monotonic_inner(() =>
        runtime_tool_dir_inner(body))))
}

pub(package) fn runtime_platform_tool(argc: i64, argv: i64, body: () -[Dir, Env, Proc, MonotonicClock]> i64) -> i64 {
  handle runtime_tool_platform_handle(argc, argv, body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
