-- runtime/safe_write_core.weft — capability-neutral complete descriptor writes
--
-- This package bridge owns partial-progress and interruption semantics without
-- importing file paths, open flags, directories, or console stream policy.

use stdlib/bytes.{Bytes}
use stdlib/io.{raw_write}
use stdlib/io/types.{IoError, IoInterrupted, IoInvalidProgress, io_error_from_errno}
use stdlib/num
use stdlib/result.{Result, Err, Ok}
use stdlib/vector.{vector_data, vector_len}

fn runtime_safe_write_i64_to_usize(value: i64) -> usize {
  value.to_usize_checked().unwrap_or(0)
}

pub(package) fn runtime_safe_write_fd(fd: i64, values: Bytes) -> Result<usize, IoError> {
  let contiguous = values.to_vector()
  let total = vector_len<u8>(contiguous)
  let mut offset = 0
  let mut failed = false
  let mut failure = IoInvalidProgress
  while offset < total and not failed {
    let status = raw_write(fd, vector_data<u8>(contiguous) + offset, total - offset)
    if status > 0 {
      if status > total - offset {
        failure = IoInvalidProgress
        failed = true
      } else {
        offset = offset + status
      }
    } else { if status == 0 {
      failure = IoInvalidProgress
      failed = true
    } else {
      match io_error_from_errno(status) {
        IoInterrupted -> 0
        error -> {
          failure = error
          failed = true
          0
        }
      }
    } }
  }
  if failed { Err<usize, IoError>(failure) }
  else { Ok<usize, IoError>(runtime_safe_write_i64_to_usize(offset)) }
}
