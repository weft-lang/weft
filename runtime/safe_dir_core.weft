-- runtime/safe_dir_core.weft — backend-neutral typed directory joins
--
-- Linked and standalone boundaries share the exact native-path and errno
-- conversion rules while supplying their own legacy Dir implementation.

use stdlib/bytes.{bytes_from_str}
use stdlib/dir.{DirMetadata}
use stdlib/io_types.{IoError, io_error_from_errno}
use stdlib/path.{Path, path_from_bytes}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

pub(package) fn runtime_safe_path_from_raw(value: str) -> Path {
  match path_from_bytes(bytes_from_str(value)) {
    Ok(path) -> path
    Err(error) -> runtime_safe_path_from_raw("")
  }
}

pub(package) fn runtime_safe_dir_list_result(result: Result<Vector<str>, i64>) -> Result<Vector<Path>, IoError> {
  match result {
    Err(error) -> result_err<Vector<Path>, IoError>(io_error_from_errno(error))
    Ok(entries) -> {
      let paths = vector_with_capacity<Path>(vector_len<str>(entries))
      for i in 0..vector_len<str>(entries) {
        vector_push<Path>(paths, runtime_safe_path_from_raw(vector_get_in_bounds<str>(entries, i)))
      }
      result_ok<Vector<Path>, IoError>(paths)
    }
  }
}

pub(package) fn runtime_safe_dir_metadata_result(result: Result<DirMetadata, i64>) -> Result<DirMetadata, IoError> {
  match result {
    Ok(metadata) -> result_ok<DirMetadata, IoError>(metadata)
    Err(error) -> result_err<DirMetadata, IoError>(io_error_from_errno(error))
  }
}

pub(package) fn runtime_safe_dir_path_result(result: Result<str, i64>) -> Result<Path, IoError> {
  match result {
    Ok(path) -> result_ok<Path, IoError>(runtime_safe_path_from_raw(path))
    Err(error) -> result_err<Path, IoError>(io_error_from_errno(error))
  }
}

pub(package) fn runtime_safe_nil_status(status: i64) -> Result<nil, IoError> {
  if status == 0 { result_ok<nil, IoError>(nil) }
  else { result_err<nil, IoError>(io_error_from_errno(status)) }
}
