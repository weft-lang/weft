-- runtime/safe_dir_core.weft — backend-neutral typed directory joins
--
-- Linked and standalone boundaries share the exact native-path and errno
-- conversion rules while supplying their own legacy Dir implementation.

use stdlib/bytes as bytes
use stdlib/dir.{DirMetadata}
use stdlib/io/types.{IoError, io_error_from_errno}
use stdlib/path as path
use stdlib/path.{Path}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}
use stdlib/vector/handles.{Vector}

pub(package) fn runtime_safe_path_from_raw(value: str) -> Path {
  match path.from_bytes(bytes.from_str(value)) {
    Ok(path) -> path
    Err(error) -> runtime_safe_path_from_raw("")
  }
}

pub(package) fn runtime_safe_dir_list_result(result: Result<Vector<str>, i64>) -> Result<Vector<Path>, IoError> {
  match result {
    Err(error) -> Err<Vector<Path>, IoError>(io_error_from_errno(error))
    Ok(entries) -> {
      let paths = vector.with_capacity<Path>(vector_len<str>(entries))
      for i in 0..vector_len<str>(entries) {
        vector_push<Path>(paths, runtime_safe_path_from_raw(vector_get_in_bounds<str>(entries, i)))
      }
      Ok<Vector<Path>, IoError>(paths)
    }
  }
}

pub(package) fn runtime_safe_dir_metadata_result(result: Result<DirMetadata, i64>) -> Result<DirMetadata, IoError> {
  match result {
    Ok(metadata) -> Ok<DirMetadata, IoError>(metadata)
    Err(error) -> Err<DirMetadata, IoError>(io_error_from_errno(error))
  }
}

pub(package) fn runtime_safe_dir_path_result(result: Result<str, i64>) -> Result<Path, IoError> {
  match result {
    Ok(path) -> Ok<Path, IoError>(runtime_safe_path_from_raw(path))
    Err(error) -> Err<Path, IoError>(io_error_from_errno(error))
  }
}

pub(package) fn runtime_safe_nil_status(status: i64) -> Result<nil, IoError> {
  if status == 0 { Ok<nil, IoError>(nil) }
  else { Err<nil, IoError>(io_error_from_errno(status)) }
}
