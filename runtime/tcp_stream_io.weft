-- runtime/tcp_stream_io.weft — production TCP stream operations

use runtime/tcp.{runtime_tcp_configure_safe, runtime_tcp_read_safe, runtime_tcp_shutdown_safe, runtime_tcp_stream_local_address_safe, runtime_tcp_stream_peer_address_safe, runtime_tcp_stream_release_safe, runtime_tcp_write_safe}
use stdlib/tcp.{TcpStreamIO}

--- Interpret operations on owned TCP streams through the target platform.
pub implements TcpStreamIO() {
  TcpStreamIO.read(stream, buffer) -> resume(runtime_tcp_read_safe(stream, buffer))
  TcpStreamIO.write(stream, buffer) -> resume(runtime_tcp_write_safe(stream, buffer))
  TcpStreamIO.configure(stream, options) -> resume(runtime_tcp_configure_safe(stream, options))
  TcpStreamIO.shutdown(stream, direction) -> resume(runtime_tcp_shutdown_safe(stream, direction))
  TcpStreamIO.local_address(stream) -> resume(runtime_tcp_stream_local_address_safe(stream))
  TcpStreamIO.peer_address(stream) -> resume(runtime_tcp_stream_peer_address_safe(stream))
  TcpStreamIO.release(stream) -> resume(runtime_tcp_stream_release_safe(stream))
}
