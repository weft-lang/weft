-- runtime/shutdown.weft — sealed target-neutral process-disposition bridge
--
-- Package-visible only for runtime conformance probes that verify scoped
-- restoration. The event loop itself uses net_poller's target-owned semantic
-- shutdown ABI, and no target enters ordinary Weft code from signal context.

use runtime/unsafe.{Unsafe}

fn runtime_shutdown_set_disposition_unsafe(signal: i64, disposition: i64) -[Unsafe]> i64 {
  __platform_shutdown_set_disposition(signal, disposition)
}

pub (package) fn runtime_shutdown_set_disposition(signal: i64, disposition: i64) -> i64 {
  handle runtime_shutdown_set_disposition_unsafe(signal, disposition) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
