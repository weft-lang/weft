-- Trusted helpers for effect-runtime tests that need raw runtime-state access.

use runtime/effects.{*}

pub(package) fn handler_abort_cleanup_disarm_test() -> i64 {
  let st = alloc_runtime_state_ptr()
  let first = alloc_bump(handler_abort_cleanup_record_size())
  let middle = alloc_bump(handler_abort_cleanup_record_size())
  let top = alloc_bump(handler_abort_cleanup_record_size())
  __mem_store64(first + handler_abort_cleanup_record_prev_offset(), 0)
  __mem_store64(middle + handler_abort_cleanup_record_prev_offset(), first)
  __mem_store64(top + handler_abort_cleanup_record_prev_offset(), middle)
  __mem_store64(st + handler_abort_cleanup_active_offset(), 1)
  __mem_store64(st + handler_abort_cleanup_top_offset(), top)

  let removed_middle = handler_abort_cleanup_disarm(middle)
  let middle_spliced = __mem_load64(top + handler_abort_cleanup_record_prev_offset()) == first
  let middle_missing = handler_abort_cleanup_disarm(middle) == 0
  let removed_top = handler_abort_cleanup_disarm(top)
  let top_advanced = __mem_load64(st + handler_abort_cleanup_top_offset()) == first
  let removed_first = handler_abort_cleanup_disarm(first)
  let chain_empty = __mem_load64(st + handler_abort_cleanup_top_offset()) == 0

  __mem_store64(st + handler_abort_cleanup_active_offset(), 0)
  let inactive_missing = handler_abort_cleanup_disarm(first) == 0

  if removed_middle == 1 and middle_spliced and middle_missing and
     removed_top == 1 and top_advanced and removed_first == 1 and
     chain_empty and inactive_missing { 1 } else { 0 }
}
