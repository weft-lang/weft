-- runtime/safe_tcp.weft — production TCP interpretation
--
-- Applications retain the split typed, mockable TCP capabilities. Raw socket
-- families, sockaddr storage, descriptors and platform calls remain sealed in
-- runtime/tcp.

use runtime/tcp.{runtime_platform_tcp as runtime_tcp_handler}
use stdlib/tcp.{TcpConnect, TcpListen, TcpListenerIO, TcpStreamIO}

pub fn runtime_platform_tcp<T, E>(
  body: () -[TcpConnect, TcpListen, TcpStreamIO, TcpListenerIO, E]> T
) -[E]> T {
  runtime_tcp_handler<T, E>(body)
}
