-- runtime/dir_mutate.weft — production directory namespace mutation

use runtime/dir.{runtime_dir_mkdir, runtime_dir_remove, runtime_dir_rename}
use runtime/safe_dir_core.{runtime_safe_nil_status}
use runtime/safe_file_core.{runtime_safe_path_string}
use stdlib/dir.{DirMutate}

--- Interpret DirMutate through the target platform filesystem.
pub implements DirMutate() {
  DirMutate.mkdir(path) ->
    resume(runtime_safe_nil_status(runtime_dir_mkdir(runtime_safe_path_string(path))))
  DirMutate.remove(path) ->
    resume(runtime_safe_nil_status(runtime_dir_remove(runtime_safe_path_string(path))))
  DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(runtime_dir_rename(
    runtime_safe_path_string(from),
    runtime_safe_path_string(to)
  )))
}
