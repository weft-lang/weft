-- runtime/par_sync.weft -- trusted pthread mutex/cond bridge for Par

use runtime/alloc.{*}
use runtime/rc.{rc_default_heap}
use runtime/unsafe.{*}

-- Darwin storage includes its eight-byte signature before the opaque
-- payload. Linux uses only the leading futex word within the same storage.
pub (package) fn runtime_par_pthread_mutex_size() -> i64 { 64 }

pub (package) fn runtime_par_pthread_mutex_new() -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let mutex = heap_alloc(rc_default_heap(), runtime_par_pthread_mutex_size(), 8)
      __platform_thread_mutex_init(mutex)
      resume(mutex)
    }
  }
}

pub (package) fn runtime_par_pthread_mutex_destroy(mutex: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let status = __platform_thread_mutex_destroy(mutex)
      if status == 0 { heap_free(rc_default_heap(), mutex, runtime_par_pthread_mutex_size()) } else { 0 }
      resume(status)
    }
  }
}

pub (package) fn runtime_par_pthread_mutex_lock_raw(mutex: i64) -[Unsafe]> i64 {
  __platform_thread_mutex_lock(mutex)
}

pub (package) fn runtime_par_pthread_mutex_unlock_raw(mutex: i64) -[Unsafe]> i64 {
  __platform_thread_mutex_unlock(mutex)
}

pub (package) fn runtime_par_pthread_cond_size() -> i64 { 48 }

pub (package) fn runtime_par_pthread_cond_new() -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let cond = heap_alloc(rc_default_heap(), runtime_par_pthread_cond_size(), 8)
      __platform_thread_cond_init(cond)
      resume(cond)
    }
  }
}

pub (package) fn runtime_par_pthread_cond_destroy(cond: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      let status = __platform_thread_cond_destroy(cond)
      if status == 0 { heap_free(rc_default_heap(), cond, runtime_par_pthread_cond_size()) } else { 0 }
      resume(status)
    }
  }
}

pub (package) fn runtime_par_pthread_cond_wait_raw(cond: i64, mutex: i64) -[Unsafe]> i64 {
  __platform_thread_cond_wait(cond, mutex)
}

pub (package) fn runtime_par_pthread_cond_signal_raw(cond: i64) -[Unsafe]> i64 {
  __platform_thread_cond_signal(cond)
}

pub (package) fn runtime_par_pthread_cond_broadcast_raw(cond: i64) -[Unsafe]> i64 {
  __platform_thread_cond_broadcast(cond)
}

pub (package) fn runtime_par_pthread_cond_signal(cond: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pthread_cond_signal_raw(cond))
  }
}

pub (package) fn runtime_par_pthread_cond_broadcast(cond: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_pthread_cond_broadcast_raw(cond))
  }
}
