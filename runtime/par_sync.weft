-- runtime/par_sync.weft -- trusted pthread mutex/cond bridge for Par

use runtime/alloc.{*}
use runtime/rc.{rc_default_heap}
use runtime/unsafe.{*}

-- Darwin storage includes its eight-byte signature before the opaque
-- payload. Linux uses only the leading futex word within the same storage.
pub(package) fn runtime_par_pthread_mutex_size() -> i64 { 64 }

pub(package) fn runtime_par_pthread_mutex_new() -[Unsafe]> i64 {
  let mutex = heap_alloc(rc_default_heap(), runtime_par_pthread_mutex_size(), 8)
  __platform_thread_mutex_init(mutex)
  mutex
}

pub(package) fn runtime_par_pthread_mutex_destroy(mutex: i64) -[Unsafe]> i64 {
  let status = __platform_thread_mutex_destroy(mutex)
  if status == 0 { heap_free(rc_default_heap(), mutex, runtime_par_pthread_mutex_size()) } else {
    0
  }
  status
}

pub(package) fn runtime_par_pthread_mutex_lock_raw(mutex: i64) -[Unsafe]> i64 {
  __platform_thread_mutex_lock(mutex)
}

pub(package) fn runtime_par_pthread_mutex_unlock_raw(mutex: i64) -[Unsafe]> i64 {
  __platform_thread_mutex_unlock(mutex)
}

pub(package) fn runtime_par_pthread_cond_size() -> i64 { 48 }

pub(package) fn runtime_par_pthread_cond_new() -[Unsafe]> i64 {
  let cond = heap_alloc(rc_default_heap(), runtime_par_pthread_cond_size(), 8)
  __platform_thread_cond_init(cond)
  cond
}

pub(package) fn runtime_par_pthread_cond_destroy(cond: i64) -[Unsafe]> i64 {
  let status = __platform_thread_cond_destroy(cond)
  if status == 0 { heap_free(rc_default_heap(), cond, runtime_par_pthread_cond_size()) } else {
    0
  }
  status
}

pub(package) fn runtime_par_pthread_cond_wait_raw(cond: i64, mutex: i64) -[Unsafe]> i64 {
  __platform_thread_cond_wait(cond, mutex)
}

pub(package) fn runtime_par_pthread_cond_signal_raw(cond: i64) -[Unsafe]> i64 {
  __platform_thread_cond_signal(cond)
}

pub(package) fn runtime_par_pthread_cond_broadcast_raw(cond: i64) -[Unsafe]> i64 {
  __platform_thread_cond_broadcast(cond)
}

pub(package) fn runtime_par_pthread_cond_signal(cond: i64) -[Unsafe]> i64 {
  runtime_par_pthread_cond_signal_raw(cond)
}

pub(package) fn runtime_par_pthread_cond_broadcast(cond: i64) -[Unsafe]> i64 {
  runtime_par_pthread_cond_broadcast_raw(cond)
}

-- Par's implementation configures this interpretation for its private raw
-- scheduler work. The callback retains its authority contract; clauses are
-- ordinary trusted primitive implementations, never an implicit permission.
-- This package-only surface remains behind the existing raw import boundary.
pub(package) fn runtime_par_with_authority<T, E>(
  body: () -[Unsafe, E]> T
) -[E]> T {
  handle body() {
    Unsafe.raw_offset(ptr, offset) -> resume(__raw_offset(ptr, offset))
    Unsafe.transmute(value) -> resume(__transmute(value))
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) ->
      resume(__syscall(num, a0, a1, a2, a3, a4, a5))
    Unsafe.int_to_ptr(addr) -> resume(__int_to_ptr(addr))
    Unsafe.runtime_state() -> resume(__runtime_state())
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
}
