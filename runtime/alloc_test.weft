-- Trusted helper surface for runtime allocator layout tests.

use runtime/alloc.{*}
use runtime/par_sync.{*}
use runtime/rc.{rc_default_heap}
use runtime/unsafe.{*}

pub(package) fn runtime_alloc_bump_contiguous_delta() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  q - p
}

pub(package) fn runtime_alloc_bump_first_value() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  __mem_store64(p, 42)
  __mem_store64(q, 99)
  __mem_load64(p)
}

pub(package) fn runtime_alloc_bump_second_value() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  __mem_store64(p, 42)
  __mem_store64(q, 99)
  __mem_load64(q)
}

pub(package) fn runtime_alloc_zeroed_byte(index: i64) -> i64 {
  let p = alloc_zeroed(5)
  __mem_load8(p + index)
}

pub(package) fn runtime_alloc_words_delta() -> i64 {
  let p = alloc_words(3)
  let q = alloc_bump(1)
  q - p
}

pub(package) fn runtime_alloc_round_up_case(value: i64, align: i64) -> i64 {
  alloc_round_up(value, align)
}

pub(package) fn runtime_alloc_bump_rounded_delta() -> i64 {
  let p = alloc_bump_rounded(9, 8)
  let q = alloc_bump(1)
  q - p
}

pub(package) fn runtime_alloc_bump_grows_past_initial_segment() -> i64 {
  let p = alloc_bump(536870912)
  let q = alloc_bump(8)
  __mem_store8(p, 11)
  __mem_store64(q, 99)
  __mem_load8(p) + __mem_load64(q)
}

pub(package) fn runtime_heap_growth_range_facts() -> i64 {
  let heap = heap_new(64)
  let old_arena = heap_arena(heap)
  let old_ptr = heap_alloc(heap, 32, 8)
  let new_ptr = heap_alloc(heap, 128, 8)
  let new_arena = heap_arena(heap)
  let facts = (if new_arena != old_arena { 1 } else { 0 }) +
    (if arena_previous(new_arena) == old_arena { 10 } else { 0 }) +
    (if heap_contains_range(heap, old_ptr, 32) == 1 { 100 } else { 0 }) +
    (if heap_contains_range(heap, new_ptr, 128) == 1 { 1000 } else { 0 }) +
    (if heap_contains_range(heap, arena_base(old_arena) - 8, 8) == 0 { 10000 } else { 0 })
  heap_destroy(heap)
  facts
}

pub(package) fn runtime_alloc_worker_one_growth_links() -> i64 {
  let initial_base = alloc_bump_segment_base()
  let initial_end = alloc_bump_segment_end()
  let bytes = alloc_bump(initial_end - initial_base + 8)
  __mem_store64(bytes, 42)
  let grown_base = alloc_bump_segment_base()
  if grown_base != initial_base and
    alloc_bump_segment_previous_base(grown_base) == initial_base and
    alloc_bump_segment_previous_end(grown_base) == initial_end {
    __mem_load64(bytes)
  } else { 0 }
}

pub(package) fn runtime_alloc_worker_two_growth_links() -> i64 {
  let initial_base = alloc_bump_segment_base()
  let initial_end = alloc_bump_segment_end()
  let first = alloc_bump(initial_end - initial_base + 8)
  __mem_store64(first, 20)
  let first_base = alloc_bump_segment_base()
  let first_end = alloc_bump_segment_end()
  let second = alloc_bump(first_end - first_base + 8)
  __mem_store64(second, 22)
  let second_base = alloc_bump_segment_base()
  if second_base != first_base and
    alloc_bump_segment_previous_base(second_base) == first_base and
    alloc_bump_segment_previous_end(second_base) == first_end and
    alloc_bump_segment_previous_base(first_base) == initial_base and
    alloc_bump_segment_previous_end(first_base) == initial_end {
    __mem_load64(first) + __mem_load64(second)
  } else { 0 }
}

-- Guard the bytes immediately following the declared platform storage.
-- Initialization/destruction may touch its whole native object, including
-- the leading signature word on Darwin.
pub(package) fn runtime_alloc_mutex_storage_guard() -> i64 {
  let size = runtime_par_pthread_mutex_size()
  let memory = alloc_zeroed(size + 16)
  __mem_store64(memory + size, 123456789)
  __mem_store64(memory + size + 8, 987654321)
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      __platform_thread_mutex_init(memory)
      __platform_thread_mutex_lock(memory)
      __platform_thread_mutex_unlock(memory)
      __platform_thread_mutex_destroy(memory)
      resume(0)
    }
  }
  if __mem_load64(memory + size) == 123456789 and __mem_load64(memory + size + 8) == 987654321 { 42 } else { 0 }
}

pub(package) fn runtime_alloc_cond_storage_guard() -> i64 {
  let size = runtime_par_pthread_cond_size()
  let memory = alloc_zeroed(size + 16)
  __mem_store64(memory + size, 123456789)
  __mem_store64(memory + size + 8, 987654321)
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      __platform_thread_cond_init(memory)
      __platform_thread_cond_signal(memory)
      __platform_thread_cond_broadcast(memory)
      __platform_thread_cond_destroy(memory)
      resume(0)
    }
  }
  if __mem_load64(memory + size) == 123456789 and __mem_load64(memory + size + 8) == 987654321 { 42 } else { 0 }
}

pub(package) fn runtime_alloc_worker_growths_reclaimed(growths: i64) -> i64 {
  let _ = rc_default_heap()
  let parent = alloc_runtime_state_ptr()
  let worker = alloc_runtime_worker_state_new()
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> {
      __set_runtime_state(worker)
      for index in 0..growths {
        let bytes = alloc_bump(alloc_bump_segment_end() - alloc_bump_segment_base() + 8)
        __mem_store64(bytes, index)
      }
      __set_runtime_state(parent)
      resume(0)
    }
  }
  alloc_runtime_worker_state_destroy(worker)
}

-- Observe live heap storage while all workers are joined. A cursor alone also
-- counts freed blocks held in size bins after a different scheduling overlap.
pub(package) fn runtime_alloc_heap_retained_bytes(heap: i64) -> i64 {
  heap_lock(heap)
  let mut retained = 0
  let mut arena = heap_arena(heap)
  while arena != 0 {
    retained = retained + arena_offset(arena)
    arena = arena_previous(arena)
  }
  let mut block = heap_free_head(heap)
  while block != 0 {
    retained = retained - heap_free_node_size(block)
    block = heap_free_node_next(block)
  }
  let mut size = heap_min_block_size()
  while size <= heap_bin_limit() {
    block = heap_bin_head(heap, size)
    while block != 0 {
      retained = retained - heap_free_node_size(block)
      block = heap_free_node_next(block)
    }
    size = size + 8
  }
  heap_unlock(heap)
  retained
}

pub(package) fn runtime_alloc_heap_retained_bytes_guard() -> i64 {
  let heap = heap_new(4096)
  let start = runtime_alloc_heap_retained_bytes(heap)
  let small = heap_alloc(heap, 16, 8)
  let medium = heap_alloc(heap, 40, 8)
  let large = heap_alloc(heap, 400, 8)
  let growth = heap_alloc(heap, 8192, 8)
  let full = runtime_alloc_heap_retained_bytes(heap)
  heap_free(heap, small, 16)
  heap_free(heap, medium, 40)
  heap_free(heap, large, 400)
  let partial = runtime_alloc_heap_retained_bytes(heap)
  heap_free(heap, growth, 8192)
  let end = runtime_alloc_heap_retained_bytes(heap)
  heap_destroy(heap)
  if full - start == 8648 and partial - start == 8192 and end == start { 42 } else { 0 }
}
