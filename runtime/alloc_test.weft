-- Trusted helper surface for runtime allocator layout tests.

use "runtime/alloc.weft"

fn runtime_alloc_bump_contiguous_delta() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  q - p
}

fn runtime_alloc_bump_first_value() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  __mem_store64(p, 42)
  __mem_store64(q, 99)
  __mem_load64(p)
}

fn runtime_alloc_bump_second_value() -> i64 {
  let p = alloc_bump(8)
  let q = alloc_bump(16)
  __mem_store64(p, 42)
  __mem_store64(q, 99)
  __mem_load64(q)
}

fn runtime_alloc_zeroed_byte(index: i64) -> i64 {
  let p = alloc_zeroed(5)
  __mem_load8(p + index)
}

fn runtime_alloc_words_delta() -> i64 {
  let p = alloc_words(3)
  let q = alloc_bump(1)
  q - p
}

fn runtime_alloc_round_up_case(value: i64, align: i64) -> i64 {
  alloc_round_up(value, align)
}

fn runtime_alloc_bump_rounded_delta() -> i64 {
  let p = alloc_bump_rounded(9, 8)
  let q = alloc_bump(1)
  q - p
}
