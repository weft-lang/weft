-- runtime/file_write.weft — production whole-file write interpretation

use runtime/safe_file_core.{runtime_safe_file_write_result}
use stdlib/file.{FileWrite}

--- Interpret FileWrite through the target platform filesystem.
pub implements FileWrite() {
  FileWrite.write_all(path, values, mode) ->
    resume(runtime_safe_file_write_result(path, values, mode))
}
