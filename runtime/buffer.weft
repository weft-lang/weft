-- runtime/buffer.weft -- heap-backed byte buffer helpers. Data blocks
-- come from the default managed heap so growth can return the
-- abandoned buffer (2q slice 2: runtime-owned frees); the 24-byte
-- header stays bump-allocated (never abandoned).

use "runtime/memory.weft"
use "runtime/alloc.weft"
use "runtime/rc.weft"

fn buf_data_alloc(n: i64) -> i64 {
  if n <= 0 { 0 } else { heap_alloc(rc_default_heap(), n, 8) }
}

fn buf_new(cap: i64) -> i64 {
  let h = alloc_bump(24)
  let d = buf_data_alloc(cap)
  __mem_store64(h, d)
  __mem_store64(h + 8, 0)
  __mem_store64(h + 16, cap)
  h
}

fn buf_len(b: i64) -> i64 { __mem_load64(b + 8) }
fn buf_ptr(b: i64) -> i64 { __mem_load64(b) }
fn buf_cap(b: i64) -> i64 { __mem_load64(b + 16) }

fn buf_grown_cap(cap: i64, needed: i64) -> i64 {
  let mut new_cap = if cap <= 0 { 1 } else { cap * 2 }
  while new_cap < needed { new_cap = new_cap * 2 }
  new_cap
}

fn buf_grow_to(b: i64, needed: i64) -> i64 {
  let d = __mem_load64(b)
  let l = __mem_load64(b + 8)
  let cap = __mem_load64(b + 16)
  let new_cap = buf_grown_cap(cap, needed)
  let new_d = buf_data_alloc(new_cap)
  if d != 0 { mem_copy(new_d, d, l) } else { 0 }
  if d != 0 and cap > 0 { heap_free(rc_default_heap(), d, cap) } else { 0 }
  __mem_store64(b, new_d)
  __mem_store64(b + 16, new_cap)
  b
}

fn buf_grow(b: i64) -> i64 {
  let l = __mem_load64(b + 8)
  buf_grow_to(b, l + 1)
}

fn bu8(b: i64, v: i64) -> i64 {
  let l = __mem_load64(b + 8)
  let cap = __mem_load64(b + 16)
  if l >= cap { buf_grow_to(b, l + 1) } else { 0 }
  let d = __mem_load64(b)
  __mem_store8(d + l, v)
  __mem_store64(b + 8, l + 1)
  b
}

fn bu32(b: i64, v: i64) -> i64 {
  bu8(b, v - v / 256 * 256)
  bu8(b, v / 256 - v / 65536 * 256)
  bu8(b, v / 65536 - v / 16777216 * 256)
  bu8(b, v / 16777216 - v / 4294967296 * 256)
}

fn bu64(b: i64, v: i64) -> i64 {
  bu32(b, v - v / 4294967296 * 4294967296)
  bu32(b, v / 4294967296)
}

fn bscopy64(dst: i64, src_p: i64, off: i64, rem: i64) -> i64 {
  let mut cur = off
  let mut left = rem
  while left >= 64 {
    __mem_store64(dst + cur, __mem_load64(src_p + cur))
    __mem_store64(dst + cur + 8, __mem_load64(src_p + cur + 8))
    __mem_store64(dst + cur + 16, __mem_load64(src_p + cur + 16))
    __mem_store64(dst + cur + 24, __mem_load64(src_p + cur + 24))
    __mem_store64(dst + cur + 32, __mem_load64(src_p + cur + 32))
    __mem_store64(dst + cur + 40, __mem_load64(src_p + cur + 40))
    __mem_store64(dst + cur + 48, __mem_load64(src_p + cur + 48))
    __mem_store64(dst + cur + 56, __mem_load64(src_p + cur + 56))
    cur = cur + 64
    left = left - 64
  }
  cur
}

fn bscopy_tail(dst: i64, src_p: i64, off: i64, rem: i64) -> i64 {
  let mut cur = off
  let mut left = rem
  while left > 0 {
    __mem_store8(dst + cur, __mem_load8(src_p + cur))
    cur = cur + 1
    left = left - 1
  }
  0
}

fn buf_ensure(b: i64, needed: i64) -> i64 {
  let l = __mem_load64(b + 8)
  let cap = __mem_load64(b + 16)
  if l + needed > cap {
    buf_grow_to(b, l + needed)
    0
  } else { 0 }
}

fn bscopy(b: i64, p: i64, l: i64, i: i64) -> i64 {
  let total = l - i
  buf_ensure(b, total)
  let dst = __mem_load64(b)
  let cur = __mem_load64(b + 8)
  let done = bscopy64(dst + cur, p + i, 0, total)
  bscopy_tail(dst + cur, p + i, done, total - done)
  __mem_store64(b + 8, cur + total)
  b
}

fn bstr(b: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  bscopy(b, p, l, 0)
}

fn bfill64(d: i64, off: i64, rem: i64) -> i64 {
  let mut cur = off
  let mut left = rem
  while left >= 64 {
    __mem_store64(d + cur, 0)
    __mem_store64(d + cur + 8, 0)
    __mem_store64(d + cur + 16, 0)
    __mem_store64(d + cur + 24, 0)
    __mem_store64(d + cur + 32, 0)
    __mem_store64(d + cur + 40, 0)
    __mem_store64(d + cur + 48, 0)
    __mem_store64(d + cur + 56, 0)
    cur = cur + 64
    left = left - 64
  }
  cur
}

fn bfill_tail(d: i64, off: i64, rem: i64) -> i64 {
  let mut cur = off
  let mut left = rem
  while left > 0 {
    __mem_store8(d + cur, 0)
    cur = cur + 1
    left = left - 1
  }
  0
}

fn bfill_bulk(d: i64, off: i64, rem: i64) -> i64 {
  let done = bfill64(d, off, rem)
  bfill_tail(d, done, off + rem - done)
}

fn bfill(b: i64, n: i64) -> i64 {
  if n <= 0 { b }
  else {
    buf_ensure(b, n)
    let d = __mem_load64(b)
    let l = __mem_load64(b + 8)
    bfill_bulk(d, l, n)
    __mem_store64(b + 8, l + n)
    b
  }
}

fn bpad(b: i64, t: i64) -> i64 {
  let l = buf_len(b)
  if l >= t { b } else { bfill(b, t - l) }
}
