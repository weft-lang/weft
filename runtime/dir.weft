-- runtime/dir.weft -- target-neutral direct directory/filesystem substrate
--
-- Syscall selectors, flags and native dirent/stat layouts are compiler-owned
-- target facts. This trusted runtime consumes only semantic directory leaves
-- and the canonical stat record defined by runtime/syscall.

use runtime/alloc.{alloc_bump_mark, alloc_bump_restore_same_segment, alloc_zeroed}
use runtime/memory.{mem_load8_at, mem_store64_at}
use runtime/string.{runtime_str_cstring, runtime_str_from_bytes_copy}
use runtime/syscall.{*}
use stdlib/dir.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

pub(package) fn runtime_dir_error(status: i64) -> i64 {
  if status < 0 { 0 - status } else { status }
}

pub(package) fn runtime_dir_cstr_len_bounded(ptr: i64, capacity: i64) -> i64 {
  let mut len = 0
  while len < capacity and mem_load8_at(ptr, len) != 0 { len = len + 1 }
  if len < capacity { len } else { 0 - 1 }
}

pub(package) fn runtime_dir_entry_name_len(entry: i64, record_len: i64) -> i64 {
  let name = sys_dir_entry_name(entry)
  let header_len = name - entry
  if header_len < 0 or header_len >= record_len { 0 - 1 }
  else { runtime_dir_cstr_len_bounded(name, record_len - header_len) }
}

pub(package) fn runtime_dir_entry_is_dot(name: i64, len: i64) -> i64 {
  if len == 1 and mem_load8_at(name, 0) == 46 { 1 }
  else { if len == 2 and mem_load8_at(name, 0) == 46 and mem_load8_at(name, 1) == 46 { 1 }
  else { 0 } }
}

pub(package) fn runtime_dir_list(path: str) -> Result<Vector<str>, i64> {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let fd = sys_dir_open(path_c)
  let result: Result<Vector<str>, i64> = if fd < 0 {
    Err<Vector<str>, i64>(runtime_dir_error(fd))
  } else {
    let entries = vector_new<str>()
    let capacity = 16384
    let bytes = alloc_zeroed(capacity)
    let cookie = alloc_zeroed(8)
    mem_store64_at(cookie, 0, 0)
    let mut done = false
    let mut failure = 0
    while not done {
      let count = sys_dir_read(fd, bytes, capacity, cookie)
      if count == 0 { done = true }
      else { if count < 0 {
        failure = runtime_dir_error(count)
        done = true
      } else {
        let mut offset = 0
        while offset < count and failure == 0 {
          let entry = bytes + offset
          let record_len = sys_dir_entry_record_len(entry)
          if record_len <= 0 or offset + record_len > count {
            failure = 5
          } else {
            let name = sys_dir_entry_name(entry)
            let name_len = runtime_dir_entry_name_len(entry, record_len)
            if name_len < 0 {
              failure = 5
            } else {
              if runtime_dir_entry_is_dot(name, name_len) == 0 {
                vector_push<str>(entries, runtime_str_from_bytes_copy(name, name_len))
              } else { 0 }
              offset = offset + record_len
            }
          }
        }
      } }
    }
    let close_status = sys_close(fd)
    if failure != 0 { Err<Vector<str>, i64>(failure) }
    else { if close_status != 0 { Err<Vector<str>, i64>(runtime_dir_error(close_status)) }
    else { Ok<Vector<str>, i64>(entries) } }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_stat_kind(mode: i64) -> DirKind {
  match mode band 61440 {
    32768 -> DirFile
    16384 -> DirDirectory
    other -> DirOther
  }
}

pub(package) fn runtime_dir_missing_metadata() -> DirMetadata {
  DirMetadata { exists: false, kind: DirOther, size: 0, modified_millis: 0, device: 0, inode: 0 }
}

pub(package) fn runtime_dir_metadata_from_stat_buf(stat_buf: i64) -> DirMetadata {
  DirMetadata {
    exists: true,
    kind: runtime_dir_stat_kind(sys_stat_mode(stat_buf)),
    size: sys_stat_size(stat_buf),
    modified_millis: sys_stat_modified_seconds(stat_buf) * 1000 + sys_stat_modified_nanos(stat_buf) / 1000000,
    device: sys_stat_device(stat_buf),
    inode: sys_stat_inode(stat_buf)
  }
}

fn runtime_dir_stat_with(path: str, follow: bool) -> Result<DirMetadata, i64> {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let status = if follow { sys_stat_follow(path_c, stat_buf) }
  else { sys_stat_nofollow(path_c, stat_buf) }
  let result: Result<DirMetadata, i64> = if status == 0 {
    Ok<DirMetadata, i64>(runtime_dir_metadata_from_stat_buf(stat_buf))
  } else {
    let error = runtime_dir_error(status)
    if error == 2 { Ok<DirMetadata, i64>(runtime_dir_missing_metadata()) }
    else { Err<DirMetadata, i64>(error) }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_stat(path: str) -> Result<DirMetadata, i64> {
  runtime_dir_stat_with(path, true)
}

pub(package) fn runtime_dir_lstat(path: str) -> Result<DirMetadata, i64> {
  runtime_dir_stat_with(path, false)
}

pub(package) fn runtime_dir_mkdir(path: str) -> i64 {
  let mark = alloc_bump_mark()
  let status = sys_dir_mkdir(runtime_str_cstring(path), 493)
  alloc_bump_restore_same_segment(mark)
  runtime_dir_error(status)
}

pub(package) fn runtime_dir_remove(path: str) -> i64 {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let stat_buf = alloc_zeroed(sys_stat_scratch_size())
  let inspected = sys_stat_nofollow(path_c, stat_buf)
  let status = if inspected < 0 { inspected }
  else { match runtime_dir_stat_kind(sys_stat_mode(stat_buf)) {
    DirDirectory -> sys_dir_remove_directory(path_c)
    other -> sys_remove(path_c)
  } }
  alloc_bump_restore_same_segment(mark)
  runtime_dir_error(status)
}

pub(package) fn runtime_dir_rename(from: str, to: str) -> i64 {
  let mark = alloc_bump_mark()
  let from_c = runtime_str_cstring(from)
  let to_c = runtime_str_cstring(to)
  let status = sys_rename(from_c, to_c)
  alloc_bump_restore_same_segment(mark)
  runtime_dir_error(status)
}

pub(package) fn runtime_dir_getcwd() -> Result<str, i64> {
  let mark = alloc_bump_mark()
  let capacity = 4096
  let bytes = alloc_zeroed(capacity)
  let dot_path = runtime_str_cstring(".")
  let status = sys_dir_current(dot_path, bytes, capacity)
  let result: Result<str, i64> = if status < 0 {
    Err<str, i64>(runtime_dir_error(status))
  } else {
    let len = runtime_dir_cstr_len_bounded(bytes, capacity)
    if len < 0 { Err<str, i64>(22) }
    else { Ok<str, i64>(runtime_str_from_bytes_copy(bytes, len)) }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_handle(body: () -[Dir]> i64) -> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_dir_list(path))
    Dir.stat(path) -> resume(runtime_dir_stat(path))
    Dir.lstat(path) -> resume(runtime_dir_lstat(path))
    Dir.mkdir(path) -> resume(runtime_dir_mkdir(path))
    Dir.remove(path) -> resume(runtime_dir_remove(path))
    Dir.rename(from, to) -> resume(runtime_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_dir_getcwd())
  }
}

pub(package) fn runtime_dir_handle_with<E>(body: () -[Dir, E]> i64) -[E]> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_dir_list(path))
    Dir.stat(path) -> resume(runtime_dir_stat(path))
    Dir.lstat(path) -> resume(runtime_dir_lstat(path))
    Dir.mkdir(path) -> resume(runtime_dir_mkdir(path))
    Dir.remove(path) -> resume(runtime_dir_remove(path))
    Dir.rename(from, to) -> resume(runtime_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_dir_getcwd())
  }
}

pub(package) fn runtime_platform_dir(body: () -[Dir]> i64) -> i64 {
  runtime_dir_handle(body)
}

pub(package) fn runtime_platform_dir_with<E>(body: () -[Dir, E]> i64) -[E]> i64 {
  runtime_dir_handle_with<E>(body)
}
