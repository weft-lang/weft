-- runtime/dir.weft -- trusted Darwin directory/filesystem bridge

use runtime/alloc.{*}
use runtime/dir_syscall.{*}
use runtime/string.{*}
use runtime/unsafe.{*}
use stdlib/dir.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

pub(package) fn runtime_dir_errno() -[Unsafe]> i64 {
  let ptr = sys_errno_ptr()
  __mem_load8(ptr) +
    __mem_load8(ptr + 1) * 256 +
    __mem_load8(ptr + 2) * 65536 +
    __mem_load8(ptr + 3) * 16777216
}

pub(package) fn runtime_dir_clear_errno() -[Unsafe]> i64 {
  let ptr = sys_errno_ptr()
  __mem_store8(ptr, 0)
  __mem_store8(ptr + 1, 0)
  __mem_store8(ptr + 2, 0)
  __mem_store8(ptr + 3, 0)
  0
}

pub(package) fn runtime_dir_cstr_len(ptr: i64) -[Unsafe]> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

pub(package) fn runtime_dir_entry_name_len(entry: i64) -[Unsafe]> i64 {
  -- Darwin arm64 struct dirent: d_namlen is the u16 at byte 18.
  __mem_load8(entry + 18) + __mem_load8(entry + 19) * 256
}

pub(package) fn runtime_dir_entry_is_dot(entry: i64, len: i64) -[Unsafe]> i64 {
  let name = entry + 21
  if len == 1 and __mem_load8(name) == 46 { 1 }
  else { if len == 2 and __mem_load8(name) == 46 and __mem_load8(name + 1) == 46 { 1 }
  else { 0 } }
}

pub(package) fn runtime_dir_list(path: str) -[Unsafe]> Result<Vector<str>, i64> {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let dir = sys_opendir(path_c)
  let result: Result<Vector<str>, i64> = if dir == 0 {
    result_err<Vector<str>, i64>(runtime_dir_errno())
  } else {
    let entries = vector_new<str>()
    let mut done = 0
    let mut read_error = 0
    while done == 0 {
      runtime_dir_clear_errno()
      let entry = sys_readdir(dir)
      if entry == 0 {
        read_error = runtime_dir_errno()
        done = 1
      } else {
        let len = runtime_dir_entry_name_len(entry)
        if runtime_dir_entry_is_dot(entry, len) == 0 {
          vector_push<str>(entries, runtime_str_from_bytes(entry + 21, len))
        } else { 0 }
      }
    }
    let close_status = sys_closedir(dir)
    let close_error = if close_status == 0 { 0 } else { runtime_dir_errno() }
    if read_error != 0 { result_err<Vector<str>, i64>(read_error) }
    else { if close_error != 0 { result_err<Vector<str>, i64>(close_error) }
    else { result_ok<Vector<str>, i64>(entries) } }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_stat_kind(mode: i64) -> DirKind {
  let file_type = mode band 61440
  if file_type == 32768 { DirFile }
  else { if file_type == 16384 { DirDirectory }
  else { DirOther } }
}

pub(package) fn runtime_dir_missing_metadata() -> DirMetadata {
  DirMetadata { exists: false, kind: DirOther, size: 0, modified_millis: 0, device: 0, inode: 0 }
}

pub(package) fn runtime_dir_stat(path: str) -[Unsafe]> Result<DirMetadata, i64> {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  -- Locked against the installed Darwin arm64 SDK: sizeof(stat)=144,
  -- st_mode=4, st_mtimespec=48, and st_size=96.
  let stat_buf = alloc_bump(144)
  let status = sys_stat(path_c, stat_buf)
  let result: Result<DirMetadata, i64> = if status == 0 {
    let mode = __mem_load8(stat_buf + 4) + __mem_load8(stat_buf + 5) * 256
    let modified_millis = __mem_load64(stat_buf + 48) * 1000 + __mem_load64(stat_buf + 56) / 1000000
    result_ok<DirMetadata, i64>(DirMetadata {
      exists: true,
      kind: runtime_dir_stat_kind(mode),
      size: __mem_load64(stat_buf + 96),
      modified_millis: modified_millis,
      device: __mem_load8(stat_buf) + __mem_load8(stat_buf + 1) * 256 + __mem_load8(stat_buf + 2) * 65536 + __mem_load8(stat_buf + 3) * 16777216,
      inode: __mem_load64(stat_buf + 8)
    })
  } else {
    let error = runtime_dir_errno()
    if error == 2 {
      result_ok<DirMetadata, i64>(runtime_dir_missing_metadata())
    } else {
      result_err<DirMetadata, i64>(error)
    }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_mkdir(path: str) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let status = sys_mkdir(path_c, 493)
  let result = if status == 0 { 0 } else { runtime_dir_errno() }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_remove(path: str) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let path_c = runtime_str_cstring(path)
  let status = sys_remove(path_c)
  let result = if status == 0 { 0 } else { runtime_dir_errno() }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_rename(from: str, to: str) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let from_c = runtime_str_cstring(from)
  let to_c = runtime_str_cstring(to)
  let status = sys_rename(from_c, to_c)
  let result = if status == 0 { 0 } else { runtime_dir_errno() }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_getcwd() -[Unsafe]> Result<str, i64> {
  let mark = alloc_bump_mark()
  let capacity = 4096
  let buf = alloc_bump(capacity)
  let got = sys_getcwd(buf, capacity)
  let result: Result<str, i64> = if got == 0 {
    result_err<str, i64>(runtime_dir_errno())
  } else {
    result_ok<str, i64>(runtime_str_from_bytes(buf, runtime_dir_cstr_len(buf)))
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_dir_handle(body: () -[Dir]> i64) -[Unsafe]> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_dir_list(path))
    Dir.stat(path) -> resume(runtime_dir_stat(path))
    Dir.mkdir(path) -> resume(runtime_dir_mkdir(path))
    Dir.remove(path) -> resume(runtime_dir_remove(path))
    Dir.rename(from, to) -> resume(runtime_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_dir_getcwd())
  }
}

-- Program-boundary installer. Dir remains mockable in ordinary tests while
-- raw addresses, C strings, and platform errno stay inside this trusted leaf.
pub(package) fn runtime_platform_dir(body: () -[Dir]> i64) -> i64 {
  handle runtime_dir_handle(body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
