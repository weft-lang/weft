-- runtime/env.weft — Env capability effect and its trusted platform handler
--
-- Env exposes process arguments and environment variables as managed strings.
-- The platform handler materialises them from the raw argc/argv/envp startup
-- words that only this trusted module ever touches. Tests install handlers for
-- the same public stdlib effect.

use runtime/string.{*}
use runtime/unsafe.{*}
use stdlib/env.{Env}

pub(package) fn runtime_env_cstr_len(ptr: i64) -[Unsafe]> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

pub(package) fn runtime_env_arg_str(argc: i64, argv: i64, index: i64) -[Unsafe]> str | nil {
  if argv == 0 or index < 0 or index >= argc { nil }
  else {
    let p = __mem_load64(argv + index * 8)
    if p == 0 { nil } else { runtime_str_from_bytes(p, runtime_env_cstr_len(p)) }
  }
}

pub(package) fn runtime_env_pointer(argc: i64, argv: i64) -> i64 {
  if argc < 0 or argv == 0 { 0 } else { argv + (argc + 1) * 8 }
}

fn runtime_env_name_valid(name: str) -> bool {
  let n = __str_len(name)
  let mut i = 0
  let mut valid = n > 0
  while i < n and valid {
    if __mem_load8(__str_ptr(name) + i) == 61 { valid = false } else { 0 }
    i = i + 1
  }
  valid
}

fn runtime_env_entry_matches(entry: i64, name: str) -[Unsafe]> bool {
  let n = __str_len(name)
  let entry_len = runtime_env_cstr_len(entry)
  if entry_len <= n or __mem_load8(entry + n) != 61 { false }
  else {
    let mut i = 0
    let mut same = true
    while i < n and same {
      if __mem_load8(entry + i) != __mem_load8(__str_ptr(name) + i) {
        same = false
      } else { 0 }
      i = i + 1
    }
    same
  }
}

pub(package) fn runtime_env_var(envp: i64, name: str) -[Unsafe]> str | nil {
  if envp == 0 or runtime_env_name_valid(name) == false { nil }
  else {
    let mut i = 0
    let mut value = 0
    while value == 0 and __mem_load64(envp + i * 8) != 0 {
      let entry = __mem_load64(envp + i * 8)
      if runtime_env_entry_matches(entry, name) {
        value = entry + __str_len(name) + 1
      } else { 0 }
      i = i + 1
    }
    if value == 0 { nil }
    else { runtime_str_from_bytes(value, runtime_env_cstr_len(value)) }
  }
}

fn runtime_env_arg_safe(argc: i64, argv: i64, index: i64) -> str | nil {
  handle runtime_env_arg_str(argc, argv, index) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_env_var_safe(argc: i64, argv: i64, name: str) -> str | nil {
  handle runtime_env_var(runtime_env_pointer(argc, argv), name) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

--- Interpret Env through the current process's startup arguments and
--- environment.
pub implements Env(argc: i64, argv: i64) {
  Env.arg_count() -> resume(argc)
  Env.arg(index) -> resume(runtime_env_arg_safe(argc, argv, index))
  Env.var(name) -> resume(runtime_env_var_safe(argc, argv, name))
}
