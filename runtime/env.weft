-- runtime/env.weft — Env capability effect and its trusted platform handler
--
-- Env exposes process arguments and environment variables as managed strings.
-- The program entry records the operating system's startup vector: the
-- argument pointers and their terminator, then the environment entry pointers
-- and theirs. The platform handler reads that genuine vector, so no program
-- ever holds, forges or mismatches it. Only this trusted module and the
-- process runtime touch its raw words. Tests install handlers for the same
-- public stdlib effect.

use runtime/string.{*}
use runtime/unsafe.{*}
use stdlib/env.{Env}

pub(package) fn runtime_env_cstr_len(ptr: i64) -[Unsafe]> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

-- The recorded startup vector, or zero when no program entry recorded one.
fn runtime_env_startup_vector() -[Unsafe]> i64 { __platform_proc_startup_vector() }

-- The number of arguments before the vector's first terminator.
fn runtime_env_vector_count(vector: i64) -[Unsafe]> i64 {
  if vector == 0 { return 0 }
  let mut count = 0
  while __mem_load64(vector + count * 8) != 0 { count = count + 1 }
  count
}

-- Argument `index`, walking no further than the argument terminator.
fn runtime_env_vector_arg(vector: i64, index: i64) -[Unsafe]> str | nil {
  if vector == 0 or index < 0 { return nil }
  let mut position = 0
  while position < index and __mem_load64(vector + position * 8) != 0 {
    position = position + 1
  }
  let entry = __mem_load64(vector + position * 8)
  if entry == 0 { nil } else { runtime_str_from_bytes(entry, runtime_env_cstr_len(entry)) }
}

pub(package) fn runtime_env_startup_arg_count() -[Unsafe]> i64 {
  runtime_env_vector_count(runtime_env_startup_vector())
}

pub(package) fn runtime_env_startup_arg(index: i64) -[Unsafe]> str | nil {
  runtime_env_vector_arg(runtime_env_startup_vector(), index)
}

--- The recorded environment entries, which follow the argument terminator,
--- or zero when no program entry recorded a vector.
pub(package) fn runtime_env_startup_environment() -[Unsafe]> i64 {
  let vector = runtime_env_startup_vector()
  if vector == 0 { 0 } else { vector + (runtime_env_vector_count(vector) + 1) * 8 }
}

-- A name is valid when it is non-empty and contains neither `=` nor NUL, the
-- bytes that end a name or an entry.
fn runtime_env_name_valid(name: str) -> bool {
  let n = __str_len(name)
  let mut i = 0
  let mut valid = n > 0
  while i < n and valid {
    let byte = __mem_load8(__str_ptr(name) + i)
    if byte == 61 or byte == 0 { valid = false } else { 0 }
    i = i + 1
  }
  valid
}

fn runtime_env_entry_matches(entry: i64, name: str) -[Unsafe]> bool {
  let n = __str_len(name)
  let entry_len = runtime_env_cstr_len(entry)
  if entry_len <= n or __mem_load8(entry + n) != 61 { false }
  else {
    let mut i = 0
    let mut same = true
    while i < n and same {
      if __mem_load8(entry + i) != __mem_load8(__str_ptr(name) + i) {
        same = false
      } else { 0 }
      i = i + 1
    }
    same
  }
}

pub(package) fn runtime_env_var(envp: i64, name: str) -[Unsafe]> str | nil {
  if envp == 0 or runtime_env_name_valid(name) == false { nil }
  else {
    let mut i = 0
    let mut value = 0
    while value == 0 and __mem_load64(envp + i * 8) != 0 {
      let entry = __mem_load64(envp + i * 8)
      if runtime_env_entry_matches(entry, name) {
        value = entry + __str_len(name) + 1
      } else { 0 }
      i = i + 1
    }
    if value == 0 { nil }
    else { runtime_str_from_bytes(value, runtime_env_cstr_len(value)) }
  }
}

pub(package) fn runtime_env_startup_var(name: str) -[Unsafe]> str | nil {
  runtime_env_var(runtime_env_startup_environment(), name)
}

fn runtime_env_arg_count_safe() -> i64 {
  handle runtime_env_startup_arg_count() {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_env_arg_safe(index: i64) -> str | nil {
  handle runtime_env_startup_arg(index) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_env_var_safe(name: str) -> str | nil {
  handle runtime_env_startup_var(name) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

--- Interpret Env through the current process's startup arguments and
--- environment.
pub implements Env() {
  Env.arg_count() -> resume(runtime_env_arg_count_safe())
  Env.arg(index) -> resume(runtime_env_arg_safe(index))
  Env.var(name) -> resume(runtime_env_var_safe(name))
}
