-- runtime/env.weft — Env capability effect and its trusted platform handler
--
-- Env exposes process arguments and environment variables as ordinary str
-- values. Ordinary code declares -[Env]> and performs Env operations; the
-- platform
-- handler installed at the program boundary (see runtime_platform_env and
-- the combined installer in runtime/process.weft) materialises them from
-- the raw argv words that only this trusted module ever touches. Tests can
-- install their own Env handler for argv injection.

use "runtime/alloc.weft"
use "runtime/string.weft"
use "runtime/unsafe.weft"

effect Env {
  fn arg_count() -> i64
  fn arg(index: i64) -> str
  fn var(name: str) -> str?
}

fn runtime_getenv(name: i64) -[Unsafe]> i64 {
  __got_getenv(name, 0, 0, 0, 0, 0)
}

fn runtime_env_cstr_len(ptr: i64) -[Unsafe]> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

fn runtime_env_arg_str(argc: i64, argv: i64, index: i64) -[Unsafe]> str {
  if index < 0 or index >= argc { "" }
  else {
    let p = __mem_load64(argv + index * 8)
    if p == 0 { "" } else { runtime_str_from_bytes(p, runtime_env_cstr_len(p)) }
  }
}

fn runtime_env_var(name: str) -[Unsafe]> str | nil {
  let mark = alloc_bump_mark()
  let name_c = runtime_str_cstring(name)
  let value_c = runtime_getenv(name_c)
  let result: str | nil = if value_c == 0 {
    nil
  } else {
    runtime_str_from_bytes(value_c, runtime_env_cstr_len(value_c))
  }
  alloc_bump_restore_same_segment(mark)
  result
}

fn runtime_env_handle(argc: i64, argv: i64, body: () -[Env]> i64) -[Unsafe]> i64 {
  handle body() {
    Env.arg_count() -> resume(argc)
    Env.arg(index) -> resume(runtime_env_arg_str(argc, argv, index))
    Env.var(name) -> resume(runtime_env_var(name))
  }
}

-- Program-boundary installer: main passes its raw argc/argv words through;
-- the Unsafe discharge stays inside this trusted module.
fn runtime_platform_env(argc: i64, argv: i64, body: () -[Env]> i64) -> i64 {
  handle runtime_env_handle(argc, argv, body) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
