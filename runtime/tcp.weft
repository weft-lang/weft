-- runtime/tcp.weft — sealed target-neutral synchronous TCP handler
--
-- This leaf owns the sockaddr and syscall ABI. Public code observes only
-- typed addresses, partial progress, portable errors and opaque owned tokens.

use runtime/alloc.{alloc_bump, alloc_bump_mark, alloc_bump_restore_same_segment}
use runtime/syscall.{sys_close, sys_read, sys_write}
use runtime/unsafe.{Unsafe}
use stdlib/io/types.{IoEndOfFile, IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes}
use stdlib/net_address as net
use stdlib/net_address.{Ipv4Address, Ipv6Address, SocketAddress, SocketV4, SocketV6}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Result, Err, Ok}
use stdlib/tcp.{
  TcpConnect,
  TcpConnectOptions,
  TcpError,
  TcpInvalidProgress,
  TcpListen,
  TcpListenOptions,
  TcpListener,
  TcpListenerIO,
  TcpOwnerForeign,
  TcpPlatform,
  TcpShutdown,
  TcpShutdownBoth,
  TcpShutdownRead,
  TcpShutdownWrite,
  TcpStream,
  TcpStreamIO,
  tcp_error_from_platform_status,
  tcp_listener_descriptor,
  tcp_listener_from_platform,
  tcp_listener_release_descriptor,
  tcp_stream_descriptor,
  tcp_stream_from_platform,
  tcp_stream_release_descriptor
}
use stdlib/vector as vector
use stdlib/vector.{vector_data, vector_get_in_bounds, vector_push}
use stdlib/vector/handles.{Vector}

const RUNTIME_TCP_SOCKADDR_IN_SIZE: i64 = 16

const RUNTIME_TCP_SOCKADDR_IN6_SIZE: i64 = 28

const RUNTIME_TCP_SOCKADDR_STORAGE_SIZE: i64 = 28

fn runtime_tcp_i64_to_u8(value: i64) -> u8 {
  value.to_u8_checked().unwrap_or(0)
}

fn runtime_tcp_i64_to_u16(value: i64) -> u16 {
  value.to_u16_checked().unwrap_or(0)
}

fn runtime_tcp_i64_to_u32(value: i64) -> u32 {
  value.to_u32_checked().unwrap_or(0)
}

fn runtime_tcp_u16_to_i64(value: u16) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0)
}

fn runtime_tcp_u32_to_i64(value: u32) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0)
}

fn runtime_tcp_usize_to_i64(value: usize) -> i64 {
  value.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

fn runtime_tcp_zero(pointer: i64, size: i64) -[Unsafe]> nil {
  for index in 0..size { __mem_store8(pointer + index, 0) }
  nil
}

fn runtime_tcp_store_u32(pointer: i64, value: i64) -[Unsafe]> nil {
  __mem_store8(pointer, value band 255)
  __mem_store8(pointer + 1, (value bshr 8) band 255)
  __mem_store8(pointer + 2, (value bshr 16) band 255)
  __mem_store8(pointer + 3, (value bshr 24) band 255)
  nil
}

fn runtime_tcp_store_u16(pointer: i64, value: i64) -[Unsafe]> nil {
  __mem_store8(pointer, value band 255)
  __mem_store8(pointer + 1, (value bshr 8) band 255)
  nil
}

fn runtime_tcp_load_u16(pointer: i64) -[Unsafe]> i64 {
  __mem_load8(pointer) + __mem_load8(pointer + 1) * 256
}

fn runtime_tcp_load_u32(pointer: i64) -[Unsafe]> i64 {
  __mem_load8(pointer) +
    __mem_load8(pointer + 1) * 256 +
    __mem_load8(pointer + 2) * 65536 +
    __mem_load8(pointer + 3) * 16777216
}

fn runtime_tcp_ipv4_octet(address: Ipv4Address, index: i64) -> i64 {
  match address.octet(__i64_to_usize(index)) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0
  }
}

fn runtime_tcp_ipv6_segment(address: Ipv6Address, index: i64) -> i64 {
  match address.segment(__i64_to_usize(index)) {
    Some(value) -> runtime_tcp_u16_to_i64(value)
    None -> 0
  }
}

fn runtime_tcp_encode_address(address: SocketAddress, storage: i64) -[Unsafe]> i64 {
  runtime_tcp_zero(storage, RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
  match address {
    SocketV4(ip, port) -> {
      let raw_port = runtime_tcp_u16_to_i64(port)
      let family = __platform_tcp_af_inet()
      runtime_tcp_store_u16(
        storage,
        __platform_tcp_sockaddr_prefix(family, RUNTIME_TCP_SOCKADDR_IN_SIZE)
      )
      __mem_store8(storage + 2, (raw_port bshr 8) band 255)
      __mem_store8(storage + 3, raw_port band 255)
      for index in 0..4 {
        __mem_store8(storage + 4 + index, runtime_tcp_ipv4_octet(ip, index))
      }
      RUNTIME_TCP_SOCKADDR_IN_SIZE
    }
    SocketV6(ip, port, scope) -> {
      let raw_port = runtime_tcp_u16_to_i64(port)
      let family = __platform_tcp_af_inet6()
      runtime_tcp_store_u16(
        storage,
        __platform_tcp_sockaddr_prefix(family, RUNTIME_TCP_SOCKADDR_IN6_SIZE)
      )
      __mem_store8(storage + 2, (raw_port bshr 8) band 255)
      __mem_store8(storage + 3, raw_port band 255)
      for index in 0..8 {
        let segment = runtime_tcp_ipv6_segment(ip, index)
        __mem_store8(storage + 8 + index * 2, (segment bshr 8) band 255)
        __mem_store8(storage + 9 + index * 2, segment band 255)
      }
      runtime_tcp_store_u32(storage + 24, runtime_tcp_u32_to_i64(scope))
      RUNTIME_TCP_SOCKADDR_IN6_SIZE
    }
  }
}

fn runtime_tcp_decode_ipv6_segment(storage: i64, index: i64) -[Unsafe]> u16 {
  let offset = storage + 8 + index * 2
  runtime_tcp_i64_to_u16(__mem_load8(offset) * 256 + __mem_load8(offset + 1))
}

fn runtime_tcp_decode_address(
  storage: i64,
  length: i64
) -[Unsafe]> Result<SocketAddress, TcpError> {
  let prefix = runtime_tcp_load_u16(storage)
  let family = if (prefix band 255) == RUNTIME_TCP_SOCKADDR_IN_SIZE or
    (prefix band 255) == RUNTIME_TCP_SOCKADDR_IN6_SIZE {
      (prefix bshr 8) band 255
    } else { prefix }
  let port = runtime_tcp_i64_to_u16(__mem_load8(storage + 2) * 256 + __mem_load8(storage + 3))
  if family == __platform_tcp_af_inet() and length >= RUNTIME_TCP_SOCKADDR_IN_SIZE {
    Ok<SocketAddress, TcpError>(
      SocketV4(
        net.ipv4(
          runtime_tcp_i64_to_u8(__mem_load8(storage + 4)),
          runtime_tcp_i64_to_u8(__mem_load8(storage + 5)),
          runtime_tcp_i64_to_u8(__mem_load8(storage + 6)),
          runtime_tcp_i64_to_u8(__mem_load8(storage + 7))
        ),
        port
      )
    )
  } else {
    if family == __platform_tcp_af_inet6() and length >= RUNTIME_TCP_SOCKADDR_IN6_SIZE {
      Ok<SocketAddress, TcpError>(
        SocketV6(
          net.ipv6(
            runtime_tcp_decode_ipv6_segment(storage, 0),
            runtime_tcp_decode_ipv6_segment(storage, 1),
            runtime_tcp_decode_ipv6_segment(storage, 2),
            runtime_tcp_decode_ipv6_segment(storage, 3),
            runtime_tcp_decode_ipv6_segment(storage, 4),
            runtime_tcp_decode_ipv6_segment(storage, 5),
            runtime_tcp_decode_ipv6_segment(storage, 6),
            runtime_tcp_decode_ipv6_segment(storage, 7)
          ),
          port,
          runtime_tcp_i64_to_u32(runtime_tcp_load_u32(storage + 24))
        )
      )
    } else {
      Err<SocketAddress, TcpError>(TcpPlatform(47))
    }
  }
}

fn runtime_tcp_family(address: SocketAddress) -[Unsafe]> i64 {
  match address {
    SocketV4(ip, port) -> __platform_tcp_af_inet()
    SocketV6(ip, port, scope) -> __platform_tcp_af_inet6()
  }
}

fn runtime_tcp_socket(address: SocketAddress) -[Unsafe]> i64 {
  __platform_tcp_socket(runtime_tcp_family(address))
}

fn runtime_tcp_configure_fd(fd: i64, options: TcpConnectOptions) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let value = alloc_bump(4)
  runtime_tcp_store_u32(value, if options.no_delay { 1 } else { 0 })
  let no_delay = __platform_tcp_set_no_delay(fd, value)
  let keep_alive = if no_delay == 0 {
    runtime_tcp_store_u32(value, if options.keep_alive { 1 } else { 0 })
    __platform_tcp_set_keep_alive(fd, value)
  } else { 0 }
  alloc_bump_restore_same_segment(mark)
  if no_delay != 0 { no_delay } else { keep_alive }
}

-- The socket address lives in scoped runtime storage for the duration of the
-- call only; no caller observes it.
fn runtime_tcp_connect_descriptor(fd: i64, address: SocketAddress) -[Unsafe]> i64 {
  let mark = alloc_bump_mark()
  let storage = alloc_bump(RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
  let length = runtime_tcp_encode_address(address, storage)
  let connected = __platform_tcp_connect(fd, storage, length)
  alloc_bump_restore_same_segment(mark)
  connected
}

fn runtime_tcp_connect_raw(address: SocketAddress, options: TcpConnectOptions) -[Unsafe]> i64 {
  let fd = runtime_tcp_socket(address)
  if fd < 0 { fd }
  else {
    let connected = runtime_tcp_connect_descriptor(fd, address)
    let configured = if connected == 0 { runtime_tcp_configure_fd(fd, options) } else {
      connected
    }
    if configured == 0 { fd }
    else { sys_close(fd); configured }
  }
}

fn runtime_tcp_listen_raw(address: SocketAddress, options: TcpListenOptions) -[Unsafe]> i64 {
  let backlog = runtime_tcp_usize_to_i64(options.backlog)
  if backlog < 0 { 0 - 22 }
  else {
    let fd = runtime_tcp_socket(address)
    if fd < 0 { fd }
    else {
      let mark = alloc_bump_mark()
      let reuse_status = if options.reuse_address {
        let value = alloc_bump(4)
        runtime_tcp_store_u32(value, 1)
        __platform_tcp_set_reuse_address(fd, value)
      } else { 0 }
      let storage = alloc_bump(RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
      let length = runtime_tcp_encode_address(address, storage)
      let bound = if reuse_status == 0 {
        __platform_tcp_bind(fd, storage, length)
      } else { reuse_status }
      let listening = if bound == 0 {
        __platform_tcp_listen(fd, backlog)
      } else { bound }
      alloc_bump_restore_same_segment(mark)
      if listening == 0 { fd }
      else { sys_close(fd); listening }
    }
  }
}

fn runtime_tcp_read(
  stream: borrow mut TcpStream,
  buffer: [mut u8]
) -[Unsafe]> Result<IoReadProgress, TcpError> {
  match tcp_stream_descriptor(stream) {
    None -> Err<IoReadProgress, TcpError>(TcpOwnerForeign)
    Some(descriptor) -> runtime_tcp_read_descriptor(descriptor, buffer)
  }
}

fn runtime_tcp_read_descriptor(
  descriptor: i64,
  buffer: [mut u8]
) -[Unsafe]> Result<IoReadProgress, TcpError> {
  let length = runtime_tcp_usize_to_i64(buffer.len)
  if length < 0 {
    Err<IoReadProgress, TcpError>(TcpInvalidProgress)
  } else {
    if length == 0 {
      Ok<IoReadProgress, TcpError>(IoReadBytes(__i64_to_usize(0)))
    } else {
      let scratch: Vector<u8> = vector.with_capacity<u8>(buffer.len)
      for index in 0..length { vector_push<u8>(scratch, runtime_tcp_i64_to_u8(0)) }
      let status = sys_read(descriptor, vector_data<u8>(scratch), length)
      if status < 0 {
        Err<IoReadProgress, TcpError>(tcp_error_from_platform_status(status))
      } else {
        if status == 0 {
          Ok<IoReadProgress, TcpError>(IoEndOfFile)
        } else {
          if status > length {
            Err<IoReadProgress, TcpError>(TcpInvalidProgress)
          } else {
            for index in 0..status {
              buffer[__i64_to_usize(index)] = vector_get_in_bounds<u8>(scratch, index)
            }
            Ok<IoReadProgress, TcpError>(IoReadBytes(__i64_to_usize(status)))
          }
        }
      }
    }
  }
}

fn runtime_tcp_write(
  stream: borrow mut TcpStream,
  buffer: [u8]
) -[Unsafe]> Result<IoWriteProgress, TcpError> {
  match tcp_stream_descriptor(stream) {
    None -> Err<IoWriteProgress, TcpError>(TcpOwnerForeign)
    Some(descriptor) -> runtime_tcp_write_descriptor(descriptor, buffer)
  }
}

fn runtime_tcp_write_descriptor(
  descriptor: i64,
  buffer: [u8]
) -[Unsafe]> Result<IoWriteProgress, TcpError> {
  let length = runtime_tcp_usize_to_i64(buffer.len)
  if length < 0 {
    Err<IoWriteProgress, TcpError>(TcpInvalidProgress)
  } else {
    if length == 0 {
      Ok<IoWriteProgress, TcpError>(IoWroteBytes(__i64_to_usize(0)))
    } else {
      let scratch: Vector<u8> = vector.with_capacity<u8>(buffer.len)
      for index in 0..length { vector_push<u8>(scratch, buffer[__i64_to_usize(index)]) }
      let status = sys_write(descriptor, vector_data<u8>(scratch), length)
      if status < 0 {
        Err<IoWriteProgress, TcpError>(tcp_error_from_platform_status(status))
      } else {
        if status > length {
          Err<IoWriteProgress, TcpError>(TcpInvalidProgress)
        } else {
          Ok<IoWriteProgress, TcpError>(IoWroteBytes(__i64_to_usize(status)))
        }
      }
    }
  }
}

fn runtime_tcp_shutdown_code(direction: TcpShutdown) -> i64 {
  match direction {
    TcpShutdownRead -> 0
    TcpShutdownWrite -> 1
    TcpShutdownBoth -> 2
  }
}

fn runtime_tcp_shutdown(
  stream: borrow mut TcpStream,
  direction: TcpShutdown
) -[Unsafe]> Result<nil, TcpError> {
  match tcp_stream_descriptor(stream) {
    None -> Err<nil, TcpError>(TcpOwnerForeign)
    Some(descriptor) -> {
      let status = __platform_tcp_shutdown(descriptor, runtime_tcp_shutdown_code(direction))
      if status == 0 { Ok<nil, TcpError>(nil) }
      else { Err<nil, TcpError>(tcp_error_from_platform_status(status)) }
    }
  }
}

fn runtime_tcp_socket_address(fd: i64, peer: bool) -[Unsafe]> Result<SocketAddress, TcpError> {
  let mark = alloc_bump_mark()
  let storage = alloc_bump(RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
  let length = alloc_bump(4)
  runtime_tcp_zero(storage, RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
  runtime_tcp_store_u32(length, RUNTIME_TCP_SOCKADDR_STORAGE_SIZE)
  let status = if peer {
    __platform_tcp_getpeername(fd, storage, length)
  } else {
    __platform_tcp_getsockname(fd, storage, length)
  }
  let result = if status == 0 {
    runtime_tcp_decode_address(storage, runtime_tcp_load_u32(length))
  } else {
    Err<SocketAddress, TcpError>(tcp_error_from_platform_status(status))
  }
  alloc_bump_restore_same_segment(mark)
  result
}

-- The address of an owner's socket, refusing an owner of another TCP
-- interpretation.
fn runtime_tcp_owner_address(
  descriptor: Option<i64>,
  peer: bool
) -[Unsafe]> Result<SocketAddress, TcpError> {
  match descriptor {
    None -> Err<SocketAddress, TcpError>(TcpOwnerForeign)
    Some(fd) -> runtime_tcp_socket_address(fd, peer)
  }
}

-- Close an owner's descriptor. An owner of another TCP interpretation names
-- no descriptor of ours, so it reports EBADF.
fn runtime_tcp_close_owner(descriptor: Option<i64>) -[Unsafe]> i64 {
  match descriptor {
    None -> 0 - 9
    Some(fd) -> sys_close(fd)
  }
}

fn runtime_tcp_connect(
  address: SocketAddress,
  options: TcpConnectOptions
) -[Unsafe]> Result<owned TcpStream, TcpError> {
  let status = runtime_tcp_connect_raw(address, options)
  if status < 0 {
    Err<owned TcpStream, TcpError>(tcp_error_from_platform_status(status))
  } else {
    Ok<owned TcpStream, TcpError>(tcp_stream_from_platform(status))
  }
}

fn runtime_tcp_listen(
  address: SocketAddress,
  options: TcpListenOptions
) -[Unsafe]> Result<owned TcpListener, TcpError> {
  let status = runtime_tcp_listen_raw(address, options)
  if status < 0 {
    Err<owned TcpListener, TcpError>(tcp_error_from_platform_status(status))
  } else {
    Ok<owned TcpListener, TcpError>(tcp_listener_from_platform(status))
  }
}

fn runtime_tcp_accept(
  listener: borrow mut TcpListener
) -[Unsafe]> Result<owned TcpStream, TcpError> {
  match tcp_listener_descriptor(listener) {
    None -> Err<owned TcpStream, TcpError>(TcpOwnerForeign)
    Some(descriptor) -> {
      let status = __platform_tcp_accept(descriptor)
      if status < 0 {
        Err<owned TcpStream, TcpError>(tcp_error_from_platform_status(status))
      } else {
        Ok<owned TcpStream, TcpError>(tcp_stream_from_platform(status))
      }
    }
  }
}

pub(package) fn runtime_tcp_connect_safe(
  address: SocketAddress,
  options: TcpConnectOptions
) -> Result<owned TcpStream, TcpError> {
  handle runtime_tcp_connect(address, options) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

--- Connect an open stream or datagram socket to an address. Returns 0, or
--- the negative platform status; the descriptor stays owned by the caller.
pub(package) fn runtime_tcp_connect_descriptor_safe(fd: i64, address: SocketAddress) -> i64 {
  handle runtime_tcp_connect_descriptor(fd, address) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_listen_safe(
  address: SocketAddress,
  options: TcpListenOptions
) -> Result<owned TcpListener, TcpError> {
  handle runtime_tcp_listen(address, options) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_accept_safe(
  listener: borrow mut TcpListener
) -> Result<owned TcpStream, TcpError> {
  handle runtime_tcp_accept(listener) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_listener_local_address_safe(
  listener: borrow TcpListener
) -> Result<SocketAddress, TcpError> {
  handle runtime_tcp_owner_address(tcp_listener_descriptor(listener), false) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_listener_release_safe(listener: TcpListener) -> i64 {
  handle runtime_tcp_close_owner(tcp_listener_release_descriptor(listener)) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_read_safe(
  stream: borrow mut TcpStream,
  buffer: [mut u8]
) -> Result<IoReadProgress, TcpError> {
  handle runtime_tcp_read(stream, buffer) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_write_safe(
  stream: borrow mut TcpStream,
  buffer: [u8]
) -> Result<IoWriteProgress, TcpError> {
  handle runtime_tcp_write(stream, buffer) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_configure_safe(
  stream: borrow mut TcpStream,
  options: TcpConnectOptions
) -> Result<nil, TcpError> {
  handle {
    match tcp_stream_descriptor(stream) {
      None -> Err<nil, TcpError>(TcpOwnerForeign)
      Some(descriptor) -> {
        let status = runtime_tcp_configure_fd(descriptor, options)
        if status == 0 { Ok<nil, TcpError>(nil) }
        else { Err<nil, TcpError>(tcp_error_from_platform_status(status)) }
      }
    }
  } {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_shutdown_safe(
  stream: borrow mut TcpStream,
  direction: TcpShutdown
) -> Result<nil, TcpError> {
  handle runtime_tcp_shutdown(stream, direction) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_stream_local_address_safe(
  stream: borrow TcpStream
) -> Result<SocketAddress, TcpError> {
  handle runtime_tcp_owner_address(tcp_stream_descriptor(stream), false) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_stream_peer_address_safe(
  stream: borrow TcpStream
) -> Result<SocketAddress, TcpError> {
  handle runtime_tcp_owner_address(tcp_stream_descriptor(stream), true) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_tcp_stream_release_safe(stream: TcpStream) -> i64 {
  handle runtime_tcp_close_owner(tcp_stream_release_descriptor(stream)) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}
