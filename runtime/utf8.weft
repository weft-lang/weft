-- Canonical UTF-8 decoding over any byte storage.
-- The decoder never reads memory itself: each caller supplies the bytes
-- through its own `Utf8StorageBytes` reader, keeps them live, and supplies
-- their exact length. Signed storage offsets remain package-private.

pub(package) type Utf8StorageDecode {
  Utf8StorageScalar(i64, i64), -- next byte offset, scalar value
  Utf8StorageMalformed(i64)
}

--- The bytes a decoder reads. The decoder asks only for offsets inside the
--- length it was given, so a reader never sees an offset outside its bytes.
pub(package) trait Utf8StorageBytes {
  fn byte(self, offset: i64) -> i64
}

-- Private result construction is statically selected for each consumer.
-- The public facade and trusted storage loops share one decoding algorithm.
pub(package) trait Utf8StorageResult {
  type Output
  fn decoded(next: usize, scalar: i64) -> Self.Output
  fn malformed(offset: usize) -> Self.Output
}

fn utf8_storage_continuation(byte: i64) -> bool {
  byte >= 128 and byte <= 191
}

pub(package) fn utf8_storage_decode<B: Utf8StorageBytes>(
  bytes: B,
  length: i64,
  offset: i64
) -> Utf8StorageDecode {
  if offset < 0 or length < 0 { Utf8StorageMalformed(offset) }
  else {
    utf8_storage_decode_as<B, Utf8StorageDecode>(bytes, length, __i64_to_usize(offset))
  }
}

impl Utf8StorageResult for Utf8StorageDecode {
  type Output = Utf8StorageDecode

  fn decoded(next: usize, scalar: i64) -> Self {
    Utf8StorageScalar(__u64_to_i64(__usize_to_u64(next)), scalar)
  }
  fn malformed(offset: usize) -> Self {
    Utf8StorageMalformed(__u64_to_i64(__usize_to_u64(offset)))
  }
}

-- The offset just past the scalar that begins at a position, or the position
-- itself when no scalar begins there. Scans advance by it without building a
-- result value per scalar.
pub(package) type Utf8StorageEnd { Utf8StorageEnd }

impl Utf8StorageResult for Utf8StorageEnd {
  type Output = usize

  fn decoded(next: usize, scalar: i64) -> usize { next }
  fn malformed(offset: usize) -> usize { offset }
}

--- The end of the scalar that begins at `offset`, or `offset` itself when
--- none does, including every offset outside `[0, length)`.
pub(package) fn utf8_storage_scalar_end<B: Utf8StorageBytes>(
  bytes: B,
  length: i64,
  offset: i64
) -> i64 {
  if offset < 0 or length < 0 { offset }
  else {
    __u64_to_i64(
      __usize_to_u64(
        utf8_storage_decode_as<B, Utf8StorageEnd>(bytes, length, __i64_to_usize(offset))
      )
    )
  }
}

--- The first offset at which `length` bytes stop being well-formed UTF-8,
--- or `-1` when every byte belongs to a canonical scalar.
pub(package) fn utf8_storage_first_malformed<B: Utf8StorageBytes>(bytes: B, length: i64) -> i64 {
  let mut position = 0
  while position < length {
    -- ASCII is one byte and always a scalar.
    if bytes.byte(position) <= 127 { position = position + 1 }
    else {
      let next = utf8_storage_scalar_end<B>(bytes, length, position)
      if next == position { return position }
      position = next
    }
  }
  0 - 1
}

-- Construct the caller's typed result without an intermediate managed value.
-- Check finite offsets before narrowing to the signed storage address domain.
pub(package) fn utf8_storage_decode_as<B: Utf8StorageBytes, R: Utf8StorageResult>(
  bytes: B,
  length: i64,
  position: usize
) -> R.Output {
  if position >= __i64_to_usize(length) { R.malformed(position) }
  else {
    let offset = __u64_to_i64(__usize_to_u64(position))
    let remaining = length - offset
    let first = bytes.byte(offset)
    match first {
      byte if byte <= 127 -> R.decoded(position + 1, byte)
      byte if byte >= 194 and byte <= 223 and remaining >= 2 -> {
        let second = bytes.byte(offset + 1)
        if utf8_storage_continuation(second) {
          R.decoded(position + 2, (byte - 192) * 64 + second - 128)
        } else { R.malformed(position) }
      }
      byte if byte >= 224 and byte <= 239 and remaining >= 3 -> {
        let second = bytes.byte(offset + 1)
        let third = bytes.byte(offset + 2)
        let valid_second = match byte {
          224 -> second >= 160 and second <= 191
          237 -> second >= 128 and second <= 159
          _ -> utf8_storage_continuation(second)
        }
        if valid_second and utf8_storage_continuation(third) {
          R.decoded(position + 3, (byte - 224) * 4096 + (second - 128) * 64 + third - 128)
        } else { R.malformed(position) }
      }
      byte if byte >= 240 and byte <= 244 and remaining >= 4 -> {
        let second = bytes.byte(offset + 1)
        let third = bytes.byte(offset + 2)
        let fourth = bytes.byte(offset + 3)
        let valid_second = match byte {
          240 -> second >= 144 and second <= 191
          244 -> second >= 128 and second <= 143
          _ -> utf8_storage_continuation(second)
        }
        if valid_second and utf8_storage_continuation(third) and utf8_storage_continuation(fourth) {
          R.decoded(
            position + 4,
            (byte - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
          )
        } else { R.malformed(position) }
      }
      _ -> R.malformed(position)
    }
  }
}
