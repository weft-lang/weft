-- Canonical UTF-8 decoding at the trusted byte-storage boundary.
-- Raw addresses and signed storage offsets remain package-private. The
-- caller keeps the source allocation live and supplies its exact byte length.

use runtime/memory.{mem_load8_at}

pub(package) type Utf8StorageDecode {
  Utf8StorageScalar(i64, i64), -- next byte offset, scalar value
  Utf8StorageMalformed(i64)
}

fn utf8_storage_continuation(byte: i64) -> bool {
  byte >= 128 and byte <= 191
}

pub(package) fn utf8_storage_decode(src: i64, length: i64, offset: i64) -> Utf8StorageDecode {
  if offset < 0 or offset >= length { Utf8StorageMalformed(offset) }
  else {
    let remaining = length - offset
    let first = mem_load8_at(src, offset)
    match first {
      byte if byte <= 127 -> Utf8StorageScalar(offset + 1, byte)
      byte if byte >= 194 and byte <= 223 and remaining >= 2 -> {
        let second = mem_load8_at(src, offset + 1)
        if utf8_storage_continuation(second) {
          Utf8StorageScalar(offset + 2, (byte - 192) * 64 + second - 128)
        } else { Utf8StorageMalformed(offset) }
      }
      byte if byte >= 224 and byte <= 239 and remaining >= 3 -> {
        let second = mem_load8_at(src, offset + 1)
        let third = mem_load8_at(src, offset + 2)
        let valid_second = match byte {
          224 -> second >= 160 and second <= 191
          237 -> second >= 128 and second <= 159
          _ -> utf8_storage_continuation(second)
        }
        if valid_second and utf8_storage_continuation(third) {
          Utf8StorageScalar(offset + 3, (byte - 224) * 4096 + (second - 128) * 64 + third - 128)
        } else { Utf8StorageMalformed(offset) }
      }
      byte if byte >= 240 and byte <= 244 and remaining >= 4 -> {
        let second = mem_load8_at(src, offset + 1)
        let third = mem_load8_at(src, offset + 2)
        let fourth = mem_load8_at(src, offset + 3)
        let valid_second = match byte {
          240 -> second >= 144 and second <= 191
          244 -> second >= 128 and second <= 143
          _ -> utf8_storage_continuation(second)
        }
        if valid_second and utf8_storage_continuation(third) and utf8_storage_continuation(fourth) {
          Utf8StorageScalar(offset + 4, (byte - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128)
        } else { Utf8StorageMalformed(offset) }
      }
      _ -> Utf8StorageMalformed(offset)
    }
  }
}
