-- runtime/safe_file.weft — production whole-file capability interpretation
--
-- This module is capability-scoped: typed file authority imports semantic
-- open/read/write/close/remove/rename leaves, but no directory enumeration,
-- metadata, process, console, networking, foreign-library, or raw flag policy.

use runtime/safe_file_core.{runtime_safe_file_read_result, runtime_safe_file_write_result}
use stdlib/file.{FileRead, FileWrite}

pub fn runtime_platform_file_read(body: () -[FileRead]> i64) -> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub fn runtime_platform_file_read_with<E>(body: () -[FileRead, E]> i64) -[E]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub fn runtime_platform_file_write(body: () -[FileWrite]> i64) -> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

pub fn runtime_platform_file_write_with<E>(body: () -[FileWrite, E]> i64) -[E]> i64 {
  handle body() {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}

fn runtime_platform_file_read_write_read(body: () -[FileRead, FileWrite]> i64) -[FileWrite]> i64 {
  handle body() {
    FileRead.read_all(path, limit) -> resume(runtime_safe_file_read_result(path, limit))
  }
}

pub fn runtime_platform_file_read_write(body: () -[FileRead, FileWrite]> i64) -> i64 {
  handle runtime_platform_file_read_write_read(body) {
    FileWrite.write_all(path, values, mode) -> resume(runtime_safe_file_write_result(path, values, mode))
  }
}
