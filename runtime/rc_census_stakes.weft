-- runtime/rc_census_stakes.weft -- measurement-only semantic stake shims
--
-- Bound only by `weft compile --rc-census`, after the ordinary native
-- runtime. Keeping this leaf separate makes disabled mode source-, byte-,
-- and cost-inert while allowing the census to distinguish compiler-generated
-- ownership operations from raw runtime helper traffic.

use runtime/rc.{closure_default_release, closure_default_retain, rc_default_release, rc_default_retain, rc_default_weak_release, rc_default_weak_retain}

pub(package) fn rc_census_managed_rc_retain(value: i64) -> i64 { rc_default_retain(value) }
pub(package) fn rc_census_managed_closure_retain(value: i64) -> i64 { closure_default_retain(value) }
pub(package) fn rc_census_managed_weak_retain(value: i64) -> i64 { rc_default_weak_retain(value) }
pub(package) fn rc_census_managed_rc_release(value: i64) -> i64 { rc_default_release(value) }
pub(package) fn rc_census_managed_closure_release(value: i64) -> i64 { closure_default_release(value) }
pub(package) fn rc_census_managed_weak_release(value: i64) -> i64 { rc_default_weak_release(value) }
