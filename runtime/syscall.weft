-- runtime/syscall.weft -- raw macOS aarch64 syscall surface

fn syscall_number_exit() -> i64 { 1 }
fn syscall_number_read() -> i64 { 3 }
fn syscall_number_write() -> i64 { 4 }
fn syscall_number_open() -> i64 { 5 }
fn syscall_number_close() -> i64 { 6 }
fn syscall_number_unlink() -> i64 { 10 }
fn syscall_number_munmap() -> i64 { 73 }
fn syscall_number_mmap() -> i64 { 197 }

fn sys_exit(code: i64) -> i64 {
  __syscall(syscall_number_exit(), code, 0, 0, 0, 0, 0)
}

fn sys_read(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(syscall_number_read(), fd, buf, len, 0, 0, 0)
}

fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  __syscall(syscall_number_write(), fd, buf, len, 0, 0, 0)
}

fn sys_open(path: i64, flags: i64, mode: i64) -> i64 {
  __syscall(syscall_number_open(), path, flags, mode, 0, 0, 0)
}

fn sys_close(fd: i64) -> i64 {
  __syscall(syscall_number_close(), fd, 0, 0, 0, 0, 0)
}

fn sys_unlink(path: i64) -> i64 {
  __syscall(syscall_number_unlink(), path, 0, 0, 0, 0, 0)
}

fn sys_munmap(addr: i64, len: i64) -> i64 {
  __syscall(syscall_number_munmap(), addr, len, 0, 0, 0, 0)
}

fn sys_mmap(addr: i64, len: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64 {
  __syscall(syscall_number_mmap(), addr, len, prot, flags, fd, offset)
}
