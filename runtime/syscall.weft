-- runtime/syscall.weft -- raw macOS aarch64 syscall surface

use runtime/unsafe.{*}

pub(package) fn syscall_number_exit() -> i64 { 1 }
pub(package) fn syscall_number_read() -> i64 { 3 }
pub(package) fn syscall_number_write() -> i64 { 4 }
pub(package) fn syscall_number_open() -> i64 { 5 }
pub(package) fn syscall_number_close() -> i64 { 6 }
pub(package) fn syscall_number_unlink() -> i64 { 10 }
pub(package) fn syscall_number_fsync() -> i64 { 95 }
pub(package) fn syscall_number_lseek() -> i64 { 199 }
pub(package) fn syscall_number_lstat() -> i64 { 340 }
pub(package) fn syscall_number_munmap() -> i64 { 73 }
pub(package) fn syscall_number_mmap() -> i64 { 197 }

pub(package) fn sys_raw(num: i64, a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 {
  handle unsafe_raw_syscall(num, a0, a1, a2, a3, a4, a5) {
    Unsafe.raw_syscall(n, b0, b1, b2, b3, b4, b5) -> resume(__syscall(n, b0, b1, b2, b3, b4, b5))
  }
}

pub(package) fn sys_exit(code: i64) -> never {
  sys_raw(syscall_number_exit(), code, 0, 0, 0, 0, 0)
  -- The kernel call cannot return on success. Keep the impossible error path
  -- divergent too, so the trusted signature remains an honest `never`.
  sys_exit(code)
}

pub(package) fn sys_read(fd: i64, buf: i64, len: i64) -> i64 {
  sys_raw(syscall_number_read(), fd, buf, len, 0, 0, 0)
}

pub(package) fn sys_write(fd: i64, buf: i64, len: i64) -> i64 {
  sys_raw(syscall_number_write(), fd, buf, len, 0, 0, 0)
}

pub(package) fn sys_open(path: i64, flags: i64, mode: i64) -> i64 {
  sys_raw(syscall_number_open(), path, flags, mode, 0, 0, 0)
}

pub(package) fn sys_close(fd: i64) -> i64 {
  sys_raw(syscall_number_close(), fd, 0, 0, 0, 0, 0)
}

pub(package) fn sys_unlink(path: i64) -> i64 {
  sys_raw(syscall_number_unlink(), path, 0, 0, 0, 0, 0)
}

pub(package) fn sys_fsync(fd: i64) -> i64 {
  sys_raw(syscall_number_fsync(), fd, 0, 0, 0, 0, 0)
}

pub(package) fn sys_lseek(fd: i64, offset: i64, whence: i64) -> i64 {
  sys_raw(syscall_number_lseek(), fd, offset, whence, 0, 0, 0)
}

pub(package) fn sys_lstat(path: i64, stat_buf: i64) -> i64 {
  sys_raw(syscall_number_lstat(), path, stat_buf, 0, 0, 0, 0)
}

pub(package) fn sys_munmap(addr: i64, len: i64) -> i64 {
  sys_raw(syscall_number_munmap(), addr, len, 0, 0, 0, 0)
}

pub(package) fn sys_mmap(addr: i64, len: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64 {
  sys_raw(syscall_number_mmap(), addr, len, prot, flags, fd, offset)
}
