-- runtime/par_task.weft -- trusted Par task/future cell storage

use "runtime/alloc.weft"
use "runtime/rc.weft"
use "runtime/unsafe.weft"

fn runtime_par_task_closure_offset() -> i64 { 0 }
fn runtime_par_task_fn_ptr_offset() -> i64 { 0 }
fn runtime_par_task_env_ptr_offset() -> i64 { 8 }
fn runtime_par_task_arg_offset() -> i64 { 16 }
fn runtime_par_task_result_offset() -> i64 { 24 }
fn runtime_par_task_done_offset() -> i64 { 32 }
fn runtime_par_task_awaited_offset() -> i64 { 40 }
fn runtime_par_task_size() -> i64 { 48 }

fn runtime_par_task_closure_word(f: (i64) -> i64) -> i64 {
  handle unsafe_transmute<(i64) -> i64, i64>(f) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn runtime_par_task_new(f: (i64) -> i64, arg: i64) -> i64 {
  let closure = runtime_par_task_closure_word(f)
  let task = alloc_bump(runtime_par_task_size())
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), __mem_load64(closure))
  __mem_store64(task + runtime_par_task_env_ptr_offset(), closure_env_bump_clone_raw(__mem_load64(closure + 8)))
  __mem_store64(task + runtime_par_task_arg_offset(), arg)
  __mem_store64(task + runtime_par_task_result_offset(), 0)
  __mem_store64(task + runtime_par_task_done_offset(), 0)
  __mem_store64(task + runtime_par_task_awaited_offset(), 0)
  task
}

fn runtime_par_task_arg(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_arg_offset())
}

fn runtime_par_task_result(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_result_offset())
}

fn runtime_par_task_done(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_done_offset())
}

fn runtime_par_task_awaited(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_awaited_offset())
}

fn runtime_par_task_run_raw(task: i64) -[Unsafe]> i64 {
  let value = __call_closure_i64(task + runtime_par_task_closure_offset(), runtime_par_task_arg(task))
  __mem_store64(task + runtime_par_task_result_offset(), value)
  __mem_store64(task + runtime_par_task_done_offset(), 1)
  value
}

fn runtime_par_task_run(task: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_task_run_raw(task))
  }
}

fn runtime_par_task_release_for_await(task: i64) -> i64 {
  closure_env_release_captures_raw(__mem_load64(task + runtime_par_task_env_ptr_offset()))
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_env_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_awaited_offset(), 1)
  0
}

fn runtime_par_task_discard_unawaited(task: i64) -> i64 {
  closure_env_release_captures_raw(__mem_load64(task + runtime_par_task_env_ptr_offset()))
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_env_ptr_offset(), 0)
  0
}
