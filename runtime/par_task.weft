-- runtime/par_task.weft -- trusted Par task/future cell storage

use runtime/alloc.{*}
use runtime/panic.{*}
use runtime/rc.{*}
use runtime/unsafe.{*}

pub(package) type ParTask<T> {
  ParTask(i64)
}

-- ParTask is a sealed one-word observation right, not a heap variant. These
-- are the only representation crossings; `unique` makes the public right
-- consumable exactly once while the handler scope retains carrier ownership.
pub(package) fn runtime_par_task_from_word<T>(word: i64) -> unique ParTask<T> {
  handle unsafe_transmute<i64, unique ParTask<T>>(word) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_par_task_observation_word<T>(task: unique ParTask<T>) -> i64 {
  handle unsafe_transmute<unique ParTask<T>, i64>(task) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Runtime twin of compiler/pipeline.weft's static ParWork descriptor ABI.
-- Keep these offsets literal and versioned: descriptors are compiler-emitted
-- read-only data and are the only authority for typed result transport.
pub(package) fn runtime_par_work_descriptor_magic() -> i64 { 6289459449259127 }
pub(package) fn runtime_par_work_descriptor_version() -> i64 { 1 }
pub(package) fn runtime_par_work_descriptor_magic_offset() -> i64 { 0 }
pub(package) fn runtime_par_work_descriptor_version_offset() -> i64 { 8 }
pub(package) fn runtime_par_work_descriptor_lane_count_offset() -> i64 { 16 }
pub(package) fn runtime_par_work_descriptor_storage_size_offset() -> i64 { 24 }
pub(package) fn runtime_par_work_descriptor_storage_align_offset() -> i64 { 32 }
pub(package) fn runtime_par_work_descriptor_header_size() -> i64 { 40 }
pub(package) fn runtime_par_work_descriptor_entry_size() -> i64 { 16 }
pub(package) fn runtime_par_work_descriptor_lane_class_offset(lane: i64) -> i64 { runtime_par_work_descriptor_header_size() + lane * runtime_par_work_descriptor_entry_size() }
pub(package) fn runtime_par_work_descriptor_lane_cleanup_offset(lane: i64) -> i64 { runtime_par_work_descriptor_lane_class_offset(lane) + 8 }

pub(package) fn runtime_par_work_descriptor_lane_count(descriptor: i64) -> i64 {
  if descriptor == 0 { 0 - 1 } else { __mem_load64(descriptor + runtime_par_work_descriptor_lane_count_offset()) }
}

pub(package) fn runtime_par_work_descriptor_storage_size(descriptor: i64) -> i64 {
  if descriptor == 0 { 0 - 1 } else { __mem_load64(descriptor + runtime_par_work_descriptor_storage_size_offset()) }
}

pub(package) fn runtime_par_work_descriptor_storage_align(descriptor: i64) -> i64 {
  if descriptor == 0 { 0 - 1 } else { __mem_load64(descriptor + runtime_par_work_descriptor_storage_align_offset()) }
}

pub(package) fn runtime_par_work_descriptor_lane_class(descriptor: i64, lane: i64) -> i64 {
  let lanes = runtime_par_work_descriptor_lane_count(descriptor)
  if lane < 0 or lane >= lanes { 0 }
  else { __mem_load64(descriptor + runtime_par_work_descriptor_lane_class_offset(lane)) }
}

pub(package) fn runtime_par_work_descriptor_lane_cleanup_kind(descriptor: i64, lane: i64) -> i64 {
  let lanes = runtime_par_work_descriptor_lane_count(descriptor)
  if lane < 0 or lane >= lanes { continuation_cleanup_kind_none() }
  else { __mem_load64(descriptor + runtime_par_work_descriptor_lane_cleanup_offset(lane)) }
}

pub(package) fn runtime_par_work_descriptor_is_valid(descriptor: i64) -> i64 {
  if descriptor == 0 or __mem_load64(descriptor + runtime_par_work_descriptor_magic_offset()) != runtime_par_work_descriptor_magic() or
    __mem_load64(descriptor + runtime_par_work_descriptor_version_offset()) != runtime_par_work_descriptor_version() { 0 }
  else {
    let lanes = runtime_par_work_descriptor_lane_count(descriptor)
    let storage_size = runtime_par_work_descriptor_storage_size(descriptor)
    let storage_align = runtime_par_work_descriptor_storage_align(descriptor)
    if lanes < 0 or lanes > 8 or storage_size != lanes * 8 or storage_align != if lanes == 0 { 1 } else { 8 } { 0 }
    else {
      let mut valid = 1
      let mut lane = 0
      while lane < lanes and valid == 1 {
        let lane_class = runtime_par_work_descriptor_lane_class(descriptor, lane)
        let cleanup_kind = runtime_par_work_descriptor_lane_cleanup_kind(descriptor, lane)
        let class_valid = if lane_class == 1 or lane_class == 2 or lane_class == 3 { 1 } else { 0 }
        let cleanup_valid = if cleanup_kind == continuation_cleanup_kind_none() or rc_layout_descriptor_drop_kind_is_valid(cleanup_kind) == 1 { 1 } else { 0 }
        if class_valid == 0 or cleanup_valid == 0 or (lane_class != 1 and cleanup_kind != continuation_cleanup_kind_none()) { valid = 0 }
        else { lane = lane + 1 }
      }
      valid
    }
  }
}

-- A ParWork owns one closure pair and storage for a concrete result shape.
-- Result states: empty while the worker initializes lanes, ready after
-- promotion/publication, moved after join or drop. The carrier never infers a
-- type from its raw words; every operation validates and walks the descriptor.
pub(package) fn runtime_par_work_descriptor_offset() -> i64 { 0 }
pub(package) fn runtime_par_work_entry_ptr_offset() -> i64 { 8 }
pub(package) fn runtime_par_work_fn_ptr_offset() -> i64 { 16 }
pub(package) fn runtime_par_work_env_ptr_offset() -> i64 { 24 }
pub(package) fn runtime_par_work_result_state_offset() -> i64 { 32 }
pub(package) fn runtime_par_work_result_initialized_mask_offset() -> i64 { 40 }
pub(package) fn runtime_par_work_result_lock_offset() -> i64 { 48 }
pub(package) fn runtime_par_work_result_data_offset() -> i64 { 56 }
pub(package) fn runtime_par_work_result_empty() -> i64 { 0 }
pub(package) fn runtime_par_work_result_ready() -> i64 { 1 }
pub(package) fn runtime_par_work_result_moved() -> i64 { 2 }

pub(package) fn runtime_par_work_lane_bit(lane: i64) -> i64 {
  if lane < 0 or lane >= 8 { 0 }
  else {
    let mut bit = 1
    for i in 0..lane { bit = bit * 2 }
    bit
  }
}

pub(package) fn runtime_par_work_result_full_mask(descriptor: i64) -> i64 {
  let lanes = runtime_par_work_descriptor_lane_count(descriptor)
  if lanes < 0 or lanes > 8 { 0 - 1 }
  else {
    let mut mask = 0
    for lane in 0..lanes { mask = mask bor runtime_par_work_lane_bit(lane) }
    mask
  }
}

pub(package) fn runtime_par_work_size_for_descriptor(descriptor: i64) -> i64 {
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else { runtime_par_work_result_data_offset() + runtime_par_work_descriptor_storage_size(descriptor) }
}

pub(package) fn runtime_par_work_new_raw(descriptor: i64, entry_ptr: i64, fn_ptr: i64, env_ptr: i64) -> i64 {
  let size = runtime_par_work_size_for_descriptor(descriptor)
  if size == 0 or entry_ptr == 0 or fn_ptr == 0 { 0 }
  else {
    let work = alloc_zeroed(size)
    __mem_store64(work + runtime_par_work_descriptor_offset(), descriptor)
    __mem_store64(work + runtime_par_work_entry_ptr_offset(), entry_ptr)
    __mem_store64(work + runtime_par_work_fn_ptr_offset(), fn_ptr)
    __mem_store64(work + runtime_par_work_env_ptr_offset(), closure_env_bump_clone_raw(env_ptr))
    work
  }
}

-- These generic declarations are compiler-intercepted carrier operations.
-- Their trap bodies are a fail-closed backstop for any path that attempts to
-- take a function value instead of making the direct, specialised call.
pub(package) fn runtime_par_work_pack<T>(f: () -> T) -> i64 {
  runtime_trap(46, 0)
}

pub(package) fn runtime_par_work_take<T>(work: i64) -> T {
  runtime_trap(46, 0)
}

pub(package) fn runtime_par_work_descriptor(work: i64) -> i64 {
  if work == 0 { 0 } else { __mem_load64(work + runtime_par_work_descriptor_offset()) }
}

pub(package) fn runtime_par_work_entry(work: i64) -> i64 {
  if work == 0 { 0 } else { __mem_load64(work + runtime_par_work_entry_ptr_offset()) }
}

pub(package) fn runtime_par_work_result_state(work: i64) -> i64 {
  if work == 0 { 0 - 1 } else { __mem_load64(work + runtime_par_work_result_state_offset()) }
}

-- Publication is the one cross-thread state edge in a carrier. The AArch64
-- atomic lock intrinsic acquires with LDAXR and releases with STLR, so a join
-- that observes ready also observes every descriptor lane written before it.
-- Sequential policies pay the same tiny lock seam and therefore exercise the
-- exact pthread contract instead of maintaining a second relaxed path.
pub(package) fn runtime_par_work_result_state_acquire(work: i64) -> i64 {
  if work == 0 { 0 - 1 }
  else {
    __atomic_lock64(work + runtime_par_work_result_lock_offset())
    let state = __mem_load64(work + runtime_par_work_result_state_offset())
    __atomic_unlock64(work + runtime_par_work_result_lock_offset())
    state
  }
}

pub(package) fn runtime_par_work_result_initialized_mask(work: i64) -> i64 {
  if work == 0 { 0 } else { __mem_load64(work + runtime_par_work_result_initialized_mask_offset()) }
}

pub(package) fn runtime_par_work_result_data(work: i64) -> i64 {
  if work == 0 { 0 } else { work + runtime_par_work_result_data_offset() }
}

pub(package) fn runtime_par_work_result_store_lane(work: i64, lane: i64, value: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  let lane_bit = runtime_par_work_lane_bit(lane)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or runtime_par_work_result_state(work) != runtime_par_work_result_empty() or
    lane < 0 or lane >= runtime_par_work_descriptor_lane_count(descriptor) or lane_bit == 0 or
    (runtime_par_work_result_initialized_mask(work) band lane_bit) != 0 { 0 }
  else {
    __mem_store64(runtime_par_work_result_data(work) + lane * 8, value)
    __mem_store64(work + runtime_par_work_result_initialized_mask_offset(), runtime_par_work_result_initialized_mask(work) bor lane_bit)
    1
  }
}

pub(package) fn runtime_par_work_result_load_lane_or(work: i64, lane: i64, default: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  let lane_bit = runtime_par_work_lane_bit(lane)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or lane < 0 or lane >= runtime_par_work_descriptor_lane_count(descriptor) or
    lane_bit == 0 or (runtime_par_work_result_initialized_mask(work) band lane_bit) == 0 { default }
  else { __mem_load64(runtime_par_work_result_data(work) + lane * 8) }
}

pub(package) fn runtime_par_work_promote_lane(value: i64, kind: i64) -> i64 {
  if value == 0 or kind == continuation_cleanup_kind_none() { 0 }
  else {
    if kind == continuation_cleanup_kind_closure() { closure_default_promote(value) }
    else { if kind == continuation_cleanup_kind_rc() or kind == continuation_cleanup_kind_weak() { rc_default_promote_maybe(value) }
    else { 0 } }
  }
}

pub(package) fn runtime_par_work_result_promote(work: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  let state = runtime_par_work_result_state(work)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or state == runtime_par_work_result_moved() { 0 }
  else {
    let mut promoted = 0
    for lane in 0..runtime_par_work_descriptor_lane_count(descriptor) {
      if (runtime_par_work_result_initialized_mask(work) band runtime_par_work_lane_bit(lane)) != 0 {
        promoted = promoted + runtime_par_work_promote_lane(
          runtime_par_work_result_load_lane_or(work, lane, 0),
          runtime_par_work_descriptor_lane_cleanup_kind(descriptor, lane)
        )
      } else { 0 }
    }
    promoted
  }
}

pub(package) fn runtime_par_work_result_publish(work: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    __atomic_lock64(work + runtime_par_work_result_lock_offset())
    let published = if runtime_par_work_result_state(work) != runtime_par_work_result_empty() or
      runtime_par_work_result_initialized_mask(work) != runtime_par_work_result_full_mask(descriptor) { 0 }
    else {
      runtime_par_work_result_promote(work)
      -- Ready is the complete worker-lifetime publication edge, not merely a
      -- result-lane edge. Retire the carrier's closure before publishing so a
      -- joiner may immediately clean the carrier without racing this release.
      -- Promotion must stay first because a result may alias a managed capture.
      runtime_par_work_release_closure(work)
      __mem_store64(work + runtime_par_work_result_state_offset(), runtime_par_work_result_ready())
      1
    }
    __atomic_unlock64(work + runtime_par_work_result_lock_offset())
    published
  }
}

pub(package) fn runtime_par_work_result_clear(work: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    mem_zero(runtime_par_work_result_data(work), runtime_par_work_descriptor_storage_size(descriptor))
    __mem_store64(work + runtime_par_work_result_initialized_mask_offset(), 0)
    1
  }
}

pub(package) fn runtime_par_work_result_destination_is_valid(work: i64, destination: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 { 0 }
  else {
    let size = runtime_par_work_descriptor_storage_size(descriptor)
    if size == 0 { 1 }
    else {
      if destination == 0 { 0 }
      else {
        let source = runtime_par_work_result_data(work)
        if destination < source + size and source < destination + size { 0 } else { 1 }
      }
    }
  }
}

pub(package) fn runtime_par_work_result_copy_to(work: i64, destination: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  let lanes = runtime_par_work_descriptor_lane_count(descriptor)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or runtime_par_work_result_state(work) != runtime_par_work_result_ready() or
    runtime_par_work_result_destination_is_valid(work, destination) == 0 { 0 }
  else {
    for lane in 0..lanes {
      let value = runtime_par_work_result_load_lane_or(work, lane, 0)
      rc_retain_kind(value, runtime_par_work_descriptor_lane_cleanup_kind(descriptor, lane))
      __mem_store64(destination + lane * 8, value)
    }
    1
  }
}

pub(package) fn runtime_par_work_result_move_to(work: i64, destination: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  let lanes = runtime_par_work_descriptor_lane_count(descriptor)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or runtime_par_work_result_state(work) != runtime_par_work_result_ready() or
    runtime_par_work_result_destination_is_valid(work, destination) == 0 { 0 }
  else {
    if lanes > 0 { mem_copy(destination, runtime_par_work_result_data(work), lanes * 8) } else { 0 }
    runtime_par_work_result_clear(work)
    __mem_store64(work + runtime_par_work_result_state_offset(), runtime_par_work_result_moved())
    1
  }
}

pub(package) fn runtime_par_work_result_move_to_expected(work: i64, expected_descriptor: i64, destination: i64) -> i64 {
  if runtime_par_work_descriptor(work) != expected_descriptor { 0 }
  else { runtime_par_work_result_move_to(work, destination) }
}

pub(package) fn runtime_par_work_result_drop(work: i64) -> i64 {
  let descriptor = runtime_par_work_descriptor(work)
  if runtime_par_work_descriptor_is_valid(descriptor) == 0 or runtime_par_work_result_state(work) == runtime_par_work_result_moved() { 0 }
  else {
    let mut lane = runtime_par_work_descriptor_lane_count(descriptor)
    let mut released = 0
    while lane > 0 {
      lane = lane - 1
      if (runtime_par_work_result_initialized_mask(work) band runtime_par_work_lane_bit(lane)) != 0 {
        released = released + continuation_cleanup_release_value(
          runtime_par_work_descriptor_lane_cleanup_kind(descriptor, lane),
          runtime_par_work_result_load_lane_or(work, lane, 0)
        )
      } else { 0 }
    }
    runtime_par_work_result_clear(work)
    __mem_store64(work + runtime_par_work_result_state_offset(), runtime_par_work_result_moved())
    released
  }
}

pub(package) fn runtime_par_work_release_closure(work: i64) -> i64 {
  if work == 0 { 0 }
  else {
    let fn_ptr = __mem_load64(work + runtime_par_work_fn_ptr_offset())
    let env_ptr = __mem_load64(work + runtime_par_work_env_ptr_offset())
    if fn_ptr == 0 and env_ptr == 0 { 0 }
    else {
      closure_env_release_captures_raw(env_ptr)
      __mem_store64(work + runtime_par_work_fn_ptr_offset(), 0)
      __mem_store64(work + runtime_par_work_env_ptr_offset(), 0)
      1
    }
  }
}

-- Thread crossing promotes the exact compiler-proved Sendable capture graph
-- held by the carrier's private environment clone. The environment itself is
-- immutable bump storage; only its managed leaves require atomic promotion.
pub(package) fn runtime_par_work_promote_closure(work: i64) -> i64 {
  if work == 0 { 0 }
  else { closure_env_promote_captures_raw(__mem_load64(work + runtime_par_work_env_ptr_offset())) }
}

pub(package) fn runtime_par_work_discard(work: i64) -> i64 {
  if work == 0 { 0 }
  else {
    let released = runtime_par_work_result_drop(work)
    runtime_par_work_release_closure(work)
    released
  }
}

pub(package) fn runtime_par_work_run_raw(work: i64) -[Unsafe]> i64 {
  let entry = runtime_par_work_entry(work)
  if runtime_par_work_descriptor_is_valid(runtime_par_work_descriptor(work)) == 0 or entry == 0 or
    runtime_par_work_result_state(work) != runtime_par_work_result_empty() { 0 }
  else { __call_i64(entry, work) }
}

pub(package) fn runtime_par_work_run(work: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_work_run_raw(work))
  }
}

-- Handler scopes own carriers independently of the public move-only
-- observation right. Await moves the result out; cleanup destroys only a
-- still-initialized result and is therefore idempotent for observed work.
pub(package) fn runtime_par_work_scope_head_offset() -> i64 { 0 }
pub(package) fn runtime_par_work_scope_size() -> i64 { 8 }
pub(package) fn runtime_par_work_scope_node_work_offset() -> i64 { 0 }
pub(package) fn runtime_par_work_scope_node_next_offset() -> i64 { 8 }
pub(package) fn runtime_par_work_scope_node_size() -> i64 { 16 }

pub(package) fn runtime_par_work_scope_new() -> i64 {
  let scope = alloc_bump(runtime_par_work_scope_size())
  __mem_store64(scope + runtime_par_work_scope_head_offset(), 0)
  scope
}

pub(package) fn runtime_par_work_scope_track(scope: i64, work: i64) -> i64 {
  if scope == 0 or work == 0 { work }
  else {
    let node = alloc_bump(runtime_par_work_scope_node_size())
    __mem_store64(node + runtime_par_work_scope_node_work_offset(), work)
    __mem_store64(node + runtime_par_work_scope_node_next_offset(), __mem_load64(scope + runtime_par_work_scope_head_offset()))
    __mem_store64(scope + runtime_par_work_scope_head_offset(), node)
    work
  }
}

pub(package) fn runtime_par_work_join(work: i64) -> i64 {
  if work == 0 { 0 }
  else {
    let mut state = runtime_par_work_result_state_acquire(work)
    while state == runtime_par_work_result_empty() {
      state = runtime_par_work_result_state_acquire(work)
    }
    if state == runtime_par_work_result_ready() { work } else { 0 }
  }
}

pub(package) fn runtime_par_work_scope_cleanup(scope: i64) -> i64 {
  if scope == 0 { 0 }
  else {
    let mut node = __mem_load64(scope + runtime_par_work_scope_head_offset())
    while node != 0 {
      runtime_par_work_discard(__mem_load64(node + runtime_par_work_scope_node_work_offset()))
      node = __mem_load64(node + runtime_par_work_scope_node_next_offset())
    }
    __mem_store64(scope + runtime_par_work_scope_head_offset(), 0)
    0
  }
}

pub(package) fn runtime_par_task_closure_offset() -> i64 { 0 }
pub(package) fn runtime_par_task_fn_ptr_offset() -> i64 { 0 }
pub(package) fn runtime_par_task_env_ptr_offset() -> i64 { 8 }
pub(package) fn runtime_par_task_arg_offset() -> i64 { 16 }
pub(package) fn runtime_par_task_result_offset() -> i64 { 24 }
pub(package) fn runtime_par_task_done_offset() -> i64 { 32 }
pub(package) fn runtime_par_task_awaited_offset() -> i64 { 40 }
pub(package) fn runtime_par_task_size() -> i64 { 48 }

-- A Par handler scope owns every task handle it returns until that handle is
-- awaited. Registry nodes are runtime-internal bookkeeping; cleanup is
-- idempotent and releases only task environments that await did not already
-- consume. The 4l owned task carrier replaces the raw handle representation,
-- but this ownership boundary survives unchanged.
pub(package) fn runtime_par_task_scope_head_offset() -> i64 { 0 }
pub(package) fn runtime_par_task_scope_size() -> i64 { 8 }
pub(package) fn runtime_par_task_scope_node_task_offset() -> i64 { 0 }
pub(package) fn runtime_par_task_scope_node_next_offset() -> i64 { 8 }
pub(package) fn runtime_par_task_scope_node_size() -> i64 { 16 }

pub(package) fn runtime_par_task_scope_new() -> i64 {
  let scope = alloc_bump(runtime_par_task_scope_size())
  __mem_store64(scope + runtime_par_task_scope_head_offset(), 0)
  scope
}

pub(package) fn runtime_par_task_scope_track(scope: i64, task: i64) -> i64 {
  if scope == 0 or task == 0 { task }
  else {
    let node = alloc_bump(runtime_par_task_scope_node_size())
    __mem_store64(node + runtime_par_task_scope_node_task_offset(), task)
    __mem_store64(node + runtime_par_task_scope_node_next_offset(), __mem_load64(scope + runtime_par_task_scope_head_offset()))
    __mem_store64(scope + runtime_par_task_scope_head_offset(), node)
    task
  }
}

pub(package) fn runtime_par_task_closure_word(f: (i64) -> i64) -> i64 {
  handle unsafe_transmute<(i64) -> i64, i64>(f) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn runtime_par_task_new(f: (i64) -> i64, arg: i64) -> i64 {
  let closure = runtime_par_task_closure_word(f)
  let task = alloc_bump(runtime_par_task_size())
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), __mem_load64(closure))
  __mem_store64(task + runtime_par_task_env_ptr_offset(), closure_env_bump_clone_raw(__mem_load64(closure + 8)))
  __mem_store64(task + runtime_par_task_arg_offset(), arg)
  __mem_store64(task + runtime_par_task_result_offset(), 0)
  __mem_store64(task + runtime_par_task_done_offset(), 0)
  __mem_store64(task + runtime_par_task_awaited_offset(), 0)
  task
}

pub(package) fn runtime_par_task_arg(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_arg_offset())
}

pub(package) fn runtime_par_task_result(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_result_offset())
}

pub(package) fn runtime_par_task_done(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_done_offset())
}

pub(package) fn runtime_par_task_awaited(task: i64) -> i64 {
  __mem_load64(task + runtime_par_task_awaited_offset())
}

pub(package) fn runtime_par_task_run_raw(task: i64) -[Unsafe]> i64 {
  let value = __call_closure_i64(task + runtime_par_task_closure_offset(), runtime_par_task_arg(task))
  __mem_store64(task + runtime_par_task_result_offset(), value)
  __mem_store64(task + runtime_par_task_done_offset(), 1)
  value
}

pub(package) fn runtime_par_task_run(task: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_task_run_raw(task))
  }
}

pub(package) fn runtime_par_task_release_for_await(task: i64) -> i64 {
  closure_env_release_captures_raw(__mem_load64(task + runtime_par_task_env_ptr_offset()))
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_env_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_awaited_offset(), 1)
  0
}

pub(package) fn runtime_par_task_discard_unawaited(task: i64) -> i64 {
  closure_env_release_captures_raw(__mem_load64(task + runtime_par_task_env_ptr_offset()))
  __mem_store64(task + runtime_par_task_fn_ptr_offset(), 0)
  __mem_store64(task + runtime_par_task_env_ptr_offset(), 0)
  0
}

pub(package) fn runtime_par_task_scope_cleanup(scope: i64) -> i64 {
  if scope == 0 { 0 }
  else {
    let mut node = __mem_load64(scope + runtime_par_task_scope_head_offset())
    while node != 0 {
      let task = __mem_load64(node + runtime_par_task_scope_node_task_offset())
      if task != 0 and runtime_par_task_awaited(task) == 0 {
        runtime_par_task_discard_unawaited(task)
      } else { 0 }
      node = __mem_load64(node + runtime_par_task_scope_node_next_offset())
    }
    __mem_store64(scope + runtime_par_task_scope_head_offset(), 0)
    0
  }
}
