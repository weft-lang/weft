-- runtime/object_storage.weft -- trusted relocatable object emission storage bridge

use runtime/alloc.{*}

pub(package) fn object_storage_alloc_scratch(size: i64) -> i64 {
  alloc_bump(size)
}

pub(package) fn object_storage_got_patch_count(fm: i64) -> i64 {
  __mem_load64(fm + 128)
}

pub(package) fn object_storage_got_patch_base(fm: i64) -> i64 {
  __mem_load64(fm + 120)
}

pub(package) fn object_storage_got_patch_code_pos(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_got_patch_base(fm) + index * 16)
}

pub(package) fn object_storage_got_patch_index(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_got_patch_base(fm) + index * 16 + 8)
}

-- Manifest-native used-symbol list (fmap +2960). The runtime bridge reads the
-- scalar storage shape only; package semantics remain compiler-owned.
pub(package) fn object_storage_native_external_list(fm: i64) -> i64 {
  __mem_load64(fm + 2960)
}

pub(package) fn object_storage_native_external_count(fm: i64) -> i64 {
  __mem_load64(object_storage_native_external_list(fm) + 8)
}

pub(package) fn object_storage_native_external_entry(fm: i64, index: i64) -> i64 {
  let list = object_storage_native_external_list(fm)
  __mem_load64(__mem_load64(list) + index * 8)
}

pub(package) fn object_storage_native_external_symbol_ptr(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_native_external_entry(fm, index) + 8)
}

pub(package) fn object_storage_native_external_symbol_len(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_native_external_entry(fm, index) + 16)
}

-- Ordered selected-target native link plan (fmap +2968). Library facts are
-- projected by the compiler producer; this trusted bridge exposes only the
-- system-library fields needed by Mach-O auto-link emission. Package artifact
-- paths remain compiler-owned and are consumed by the build handler.
pub(package) fn object_storage_native_link_library_list(fm: i64) -> i64 {
  if fm == 0 { 0 } else { __mem_load64(fm + 2968) }
}

pub(package) fn object_storage_native_link_library_count(fm: i64) -> i64 {
  let list = object_storage_native_link_library_list(fm)
  if list == 0 { 0 } else { __mem_load64(list + 8) }
}

pub(package) fn object_storage_native_link_library_entry(fm: i64, index: i64) -> i64 {
  let list = object_storage_native_link_library_list(fm)
  __mem_load64(__mem_load64(list) + index * 8)
}

pub(package) fn object_storage_native_link_library_kind(entry: i64) -> i64 { __mem_load64(entry + 8) }
pub(package) fn object_storage_native_link_library_link_ptr(entry: i64) -> i64 { __mem_load64(entry + 16) }
pub(package) fn object_storage_native_link_library_link_len(entry: i64) -> i64 { __mem_load64(entry + 24) }
pub(package) fn object_storage_native_link_library_is_used(entry: i64) -> i64 { __mem_load64(entry + 80) }

-- Static closure-pair slots (2q slice 1): fmap offsets 1480 (slot
-- count) and 1488/1496 (ADRP patch list [code_pos, slot_off]).
pub(package) fn object_storage_static_pair_slot_count(fm: i64) -> i64 {
  __mem_load64(fm + 1480)
}

pub(package) fn object_storage_static_pair_patch_base(fm: i64) -> i64 {
  __mem_load64(fm + 1488)
}

pub(package) fn object_storage_static_pair_patch_count(fm: i64) -> i64 {
  __mem_load64(fm + 1496)
}

pub(package) fn object_storage_static_pair_patch_code_pos(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_static_pair_patch_base(fm) + index * 16)
}

pub(package) fn object_storage_static_pair_patch_slot_off(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_static_pair_patch_base(fm) + index * 16 + 8)
}

-- 6b embedded native-provenance ABI (fmap twins in codegen.weft).
pub(package) fn object_storage_native_provenance_adrp_pos(fm: i64) -> i64 {
  __mem_load64(fm + 2888)
}

pub(package) fn object_storage_native_provenance_table_offset(fm: i64) -> i64 {
  __mem_load64(fm + 2896)
}

pub(package) fn object_storage_store_word(base: i64, index: i64, value: i64) -> i64 {
  __mem_store64(base + index * 8, value)
  value
}

pub(package) fn object_storage_word_at(base: i64, index: i64) -> i64 {
  __mem_load64(base + index * 8)
}
