-- runtime/object_storage.weft -- trusted relocatable object emission storage bridge

use "runtime/alloc.weft"

fn object_storage_alloc_scratch(size: i64) -> i64 {
  alloc_bump(size)
}

fn object_storage_got_patch_count(fm: i64) -> i64 {
  __mem_load64(fm + 128)
}

fn object_storage_got_patch_base(fm: i64) -> i64 {
  __mem_load64(fm + 120)
}

fn object_storage_got_patch_code_pos(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_got_patch_base(fm) + index * 16)
}

fn object_storage_got_patch_index(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_got_patch_base(fm) + index * 16 + 8)
}

-- Static closure-pair slots (2q slice 1): fmap offsets 1480 (slot
-- count) and 1488/1496 (ADRP patch list [code_pos, slot_off]).
fn object_storage_static_pair_slot_count(fm: i64) -> i64 {
  __mem_load64(fm + 1480)
}

fn object_storage_static_pair_patch_base(fm: i64) -> i64 {
  __mem_load64(fm + 1488)
}

fn object_storage_static_pair_patch_count(fm: i64) -> i64 {
  __mem_load64(fm + 1496)
}

fn object_storage_static_pair_patch_code_pos(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_static_pair_patch_base(fm) + index * 16)
}

fn object_storage_static_pair_patch_slot_off(fm: i64, index: i64) -> i64 {
  __mem_load64(object_storage_static_pair_patch_base(fm) + index * 16 + 8)
}

fn object_storage_store_word(base: i64, index: i64, value: i64) -> i64 {
  __mem_store64(base + index * 8, value)
  value
}

fn object_storage_word_at(base: i64, index: i64) -> i64 {
  __mem_load64(base + index * 8)
}
