-- Trusted helper surface for fiber runtime tests.

use runtime/effects.{*}
use runtime/thread.{*}
use runtime/unsafe.{*}

pub(package) fn fiber_test_body_return(x: i64) -[Unsafe]> i64 {
  x + 2
}

pub(package) fn fiber_test_body_once(x: i64) -[Unsafe]> i64 {
  let resumed = fiber_suspend(x + 1)
  resumed + 1
}

pub(package) fn fiber_test_body_twice(x: i64) -[Unsafe]> i64 {
  let first = fiber_suspend(x + 1)
  let second = fiber_suspend(first + 1)
  second + 1
}

pub(package) fn fiber_test_body_nested_inner(x: i64) -[Unsafe]> i64 {
  let resumed = fiber_suspend(x + 1)
  resumed + 1
}

pub(package) fn fiber_test_body_nested_outer(prompt_inner: i64) -[Unsafe]> i64 {
  let first_inner = fiber_resume(prompt_inner, 10)
  fiber_suspend(first_inner + 1)
  99
}

pub(package) fn fiber_test_run_unsafe(thunk: () -[Unsafe]> i64) -> i64 {
  handle thunk() {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
}

pub(package) fn fiber_test_direct_return_raw() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let result = fiber_trampoline(prompt, runtime_fn_addr_unsafe(fiber_test_body_return), 40)
  let done = fiber_is_done()
  result * 10 + done
}

pub(package) fn fiber_test_once_raw() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let first = fiber_trampoline(prompt, runtime_fn_addr_unsafe(fiber_test_body_once), 40)
  let done0 = fiber_is_done()
  let second = fiber_resume(prompt, 42)
  let done1 = fiber_is_done()
  first * 100000 + done0 * 10000 + second * 10 + done1
}

pub(package) fn fiber_test_twice_raw() -[Unsafe]> i64 {
  let segment = fiber_segment_new(65536)
  let prompt = fiber_prompt_new(segment)
  let first = fiber_trampoline(prompt, runtime_fn_addr_unsafe(fiber_test_body_twice), 10)
  let done0 = fiber_is_done()
  let second = fiber_resume(prompt, 20)
  let done1 = fiber_is_done()
  let final = fiber_resume(prompt, 30)
  let done2 = fiber_is_done()
  first * 1000000 + done0 * 100000 + second * 1000 + done1 * 100 + final * 10 + done2
}

pub(package) fn fiber_test_two_suspended_raw() -[Unsafe]> i64 {
  let segment_a = fiber_segment_new(65536)
  let prompt_a = fiber_prompt_new(segment_a)
  let segment_b = fiber_segment_new(65536)
  let prompt_b = fiber_prompt_new(segment_b)
  let first_a = fiber_trampoline(prompt_a, runtime_fn_addr_unsafe(fiber_test_body_once), 5)
  let first_b = fiber_trampoline(prompt_b, runtime_fn_addr_unsafe(fiber_test_body_once), 7)
  let final_a = fiber_resume(prompt_a, 10)
  let done_a = fiber_is_done()
  let final_b = fiber_resume(prompt_b, 20)
  let done_b = fiber_is_done()
  first_a * 100000 + first_b * 1000 + final_a * 100 + done_a * 10 + final_b + done_b
}

pub(package) fn fiber_test_nested_resume_restores_outer_prompt_raw() -[Unsafe]> i64 {
  let segment_inner = fiber_segment_new(65536)
  let prompt_inner = fiber_prompt_new(segment_inner)
  let first_inner = fiber_trampoline(prompt_inner, runtime_fn_addr_unsafe(fiber_test_body_nested_inner), 1)
  let segment_outer = fiber_segment_new(65536)
  let prompt_outer = fiber_prompt_new(segment_outer)
  let first_outer = fiber_trampoline(prompt_outer, runtime_fn_addr_unsafe(fiber_test_body_nested_outer), prompt_inner)
  let done0 = fiber_is_done()
  let final_outer = fiber_resume(prompt_outer, 40)
  let done1 = fiber_is_done()
  first_inner * 100000 + first_outer * 1000 + done0 * 100 + final_outer * 10 + done1
}

pub(package) fn fiber_test_direct_return() -> i64 {
  fiber_test_run_unsafe(fiber_test_direct_return_raw)
}

pub(package) fn fiber_test_once() -> i64 {
  fiber_test_run_unsafe(fiber_test_once_raw)
}

pub(package) fn fiber_test_twice() -> i64 {
  fiber_test_run_unsafe(fiber_test_twice_raw)
}

pub(package) fn fiber_test_two_suspended() -> i64 {
  fiber_test_run_unsafe(fiber_test_two_suspended_raw)
}

pub(package) fn fiber_test_nested_resume_restores_outer_prompt() -> i64 {
  fiber_test_run_unsafe(fiber_test_nested_resume_restores_outer_prompt_raw)
}
