-- runtime/memory.weft -- raw memory helpers over compiler intrinsics

fn mem_copy(dst: i64, src: i64, n: i64) -> i64 {
  let mut i = 0
  while i < n {
    __mem_store8(dst + i, __mem_load8(src + i))
    i = i + 1
  }
  0
}

fn mem_load8(ptr: i64) -> i64 {
  __mem_load8(ptr)
}

fn mem_store8(ptr: i64, value: i64) -> i64 {
  __mem_store8(ptr, value)
  0
}

fn mem_load64(ptr: i64) -> i64 {
  __mem_load64(ptr)
}

fn mem_store64(ptr: i64, value: i64) -> i64 {
  __mem_store64(ptr, value)
  0
}

fn mem_load8_at(ptr: i64, index: i64) -> i64 {
  __mem_load8(ptr + index)
}

fn mem_store8_at(ptr: i64, index: i64, value: i64) -> i64 {
  __mem_store8(ptr + index, value)
  0
}

fn mem_load64_at(ptr: i64, index: i64) -> i64 {
  __mem_load64(ptr + index)
}

fn mem_store64_at(ptr: i64, index: i64, value: i64) -> i64 {
  __mem_store64(ptr + index, value)
  0
}

fn mem_load_sized(ptr: i64, size: i64, mode: i64) -> i64 {
  __mem_load_sized(ptr, size, mode)
}

fn mem_store_sized(ptr: i64, size: i64, mode: i64, value: i64) -> i64 {
  __mem_store_sized(ptr, size, mode, value)
  0
}

fn mem_fill8(dst: i64, n: i64, value: i64) -> i64 {
  let mut i = 0
  while i < n {
    __mem_store8(dst + i, value)
    i = i + 1
  }
  0
}

-- Word-unrolled zeroing: byte head to 8-alignment, 64-byte unrolled
-- body, word then byte tail (the bfill64 shape from runtime/buffer.weft,
-- applied to the primitive every zeroing path shares). The byte-loop
-- mem_fill8 stays for generic value fills; nothing hot routes there.
fn mem_zero(dst: i64, n: i64) -> i64 {
  let mut p = dst
  let mut left = n
  while left > 0 and (p band 7) != 0 {
    __mem_store8(p, 0)
    p = p + 1
    left = left - 1
  }
  while left >= 64 {
    __mem_store64(p, 0)
    __mem_store64(p + 8, 0)
    __mem_store64(p + 16, 0)
    __mem_store64(p + 24, 0)
    __mem_store64(p + 32, 0)
    __mem_store64(p + 40, 0)
    __mem_store64(p + 48, 0)
    __mem_store64(p + 56, 0)
    p = p + 64
    left = left - 64
  }
  while left >= 8 {
    __mem_store64(p, 0)
    p = p + 8
    left = left - 8
  }
  while left > 0 {
    __mem_store8(p, 0)
    p = p + 1
    left = left - 1
  }
  0
}
