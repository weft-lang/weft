-- runtime/net_poller.weft — generation-safe target-neutral readiness seam
--
-- The scheduler-facing contract keeps descriptors and native event storage
-- inside the runtime package. A monotonically assigned resource identity,
-- one-shot generation and interest are carried through kqueue udata or epoll
-- data. Runtime-owned tables remain the authority: a stale notification or
-- cancellation must match the exact active token before it can resolve or
-- delete a registration for a reused descriptor.

use runtime/alloc.{alloc_bump, alloc_bump_mark, alloc_bump_restore_same_segment, alloc_page_size, alloc_runtime_shared_state_ptr}
use runtime/memory.{mem_load64_at, mem_store64_at, mem_zero}
use runtime/syscall.{sys_close, sys_map_rw_anonymous, sys_munmap}
use runtime/unsafe.{Unsafe}
use stdlib/drop.{Drop}
use stdlib/num.{num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/result.{Err, Ok, Result, result_err, result_ok}
use stdlib/tcp.{TcpListener, TcpStream, tcp_listener_token, tcp_stream_token}

const NET_POLLER_EINTR: i64 = 4

const NET_POLLER_EBADF: i64 = 9

const NET_POLLER_ENOENT: i64 = 2

const NET_POLLER_EVENT_SIZE: i64 = 32

const NET_POLLER_STATE_DESCRIPTOR_OFFSET: i64 = 0

const NET_POLLER_STATE_NEXT_RESOURCE_OFFSET: i64 = 8

const NET_POLLER_STATE_EPOCH_OFFSET: i64 = 16

const NET_POLLER_STATE_SHUTDOWN_AUX0_OFFSET: i64 = 24

const NET_POLLER_STATE_SHUTDOWN_AUX1_OFFSET: i64 = 32

const NET_POLLER_STATE_SHUTDOWN_ACTIVE_OFFSET: i64 = 40

const NET_POLLER_STATE_ACTIVE_TABLE_OFFSET: i64 = 48

const NET_POLLER_STATE_RESOURCE_TABLE_OFFSET: i64 = 56

const NET_POLLER_SIGINT: i64 = 2

const NET_POLLER_SIGTERM: i64 = 15

-- Runtime twin: runtime_state_net_poller_epoch_offset in compiler/codegen.weft.
const NET_POLLER_RUNTIME_EPOCH_OFFSET: i64 = 176

const NET_POLLER_RUNTIME_EPOCH_LOCK_OFFSET: i64 = 184

const NET_POLLER_GENERATION_LIMIT: i64 = 1073741824

const NET_POLLER_IDENTITY_LIMIT: i64 = 1073741824

const NET_POLLER_RESOURCE_SLOT_LIMIT: i64 = 65536

const NET_POLLER_DESCRIPTOR_LIMIT: i64 = 1048576

const NET_POLLER_ACTIVE_TABLE_SIZE: i64 = 8388608

const NET_POLLER_RESOURCE_TABLE_SIZE: i64 = 1048576

const NET_POLLER_OPERATION_ADD: i64 = 0

const NET_POLLER_OPERATION_REARM: i64 = 1

const NET_POLLER_OPERATION_CANCEL: i64 = 2

const NET_POLLER_EVENT_EOF: i64 = 2

const NET_POLLER_TIMEOUT_LIMIT: i64 = 2147483647

-- Runtime-internal types are package-visible for the structured executor. None of
-- their hidden pointer/descriptor representations cross the public package
-- boundary.
pub (package) type NetPoller = opaque i64

pub (package) type NetPollResource = opaque(i64, i64, (i64, i64))

pub (package) type NetPollRegistration = opaque(i64, i64, (i64, i64, (i64, i64)))

pub (package) type NetPollInterest {
  NetPollReadable,
    NetPollWritable
}

pub (package) type NetPollDeadline {
  NetPollForever,
    NetPollImmediate,
    NetPollForMillis(usize)
}

pub (package) type NetPollError {
  NetPollInterrupted,
    NetPollLimit,
    NetPollInvalidRegistration,
    NetPollInvalidEvent,
    NetPollPlatform(i64)
}

pub (package) type NetPollCancel {
  NetPollCancelled,
    NetPollAlreadyResolved
}

pub (package) type NetPollEvent {
  NetPollReady(NetPollRegistration, i64, bool),
    NetPollReadyError(NetPollRegistration, NetPollError),
    NetPollTermination(NetPollTerminationSignal, i64)
}

pub (package) type NetPollTerminationSignal {
  NetPollInterrupt,
    NetPollTerminate
}

pub (package) type NetPollWait {
  NetPollTimedOut,
    NetPollEventReady(NetPollEvent)
}

fn net_poller_state(poller: borrow NetPoller) -> i64 {
  match poller { NetPoller(state) -> state }
}

fn net_poller_descriptor(poller: borrow NetPoller) -> i64 {
  mem_load64_at(net_poller_state(poller), NET_POLLER_STATE_DESCRIPTOR_OFFSET)
}

fn net_poller_epoch(poller: borrow NetPoller) -> i64 {
  mem_load64_at(net_poller_state(poller), NET_POLLER_STATE_EPOCH_OFFSET)
}

fn net_poller_active_table(poller: borrow NetPoller) -> i64 {
  mem_load64_at(net_poller_state(poller), NET_POLLER_STATE_ACTIVE_TABLE_OFFSET)
}

fn net_poller_resource_table(poller: borrow NetPoller) -> i64 {
  mem_load64_at(net_poller_state(poller), NET_POLLER_STATE_RESOURCE_TABLE_OFFSET)
}

fn net_poller_resource_slot(identity: i64) -> i64 {
  identity % NET_POLLER_RESOURCE_SLOT_LIMIT
}

fn net_poller_resource_slot_identity(poller: borrow NetPoller, slot: i64) -> i64 {
  mem_load64_at(net_poller_resource_table(poller), slot * 16)
}

fn net_poller_resource_slot_descriptor(poller: borrow NetPoller, slot: i64) -> i64 {
  mem_load64_at(net_poller_resource_table(poller), slot * 16 + 8)
}

fn net_poller_active_token(poller: borrow NetPoller, descriptor: i64) -> i64 {
  mem_load64_at(net_poller_active_table(poller), descriptor * 8)
}

fn net_poller_set_active_token(
  poller: borrow mut NetPoller,
  descriptor: i64,
  token: i64
) -> nil {
  mem_store64_at(net_poller_active_table(poller), descriptor * 8, token)
  nil
}

fn net_poller_resource_descriptor_for(poller: borrow NetPoller, identity: i64) -> i64 {
  let slot = net_poller_resource_slot(identity)
  if net_poller_resource_slot_identity(poller, slot) == identity {
    net_poller_resource_slot_descriptor(poller, slot)
  } else { 0 - 1 }
}

fn net_poller_set_resource_descriptor(
  poller: borrow mut NetPoller,
  identity: i64,
  descriptor: i64
) -> nil {
  let slot = net_poller_resource_slot(identity)
  mem_store64_at(net_poller_resource_table(poller), slot * 16, identity)
  mem_store64_at(net_poller_resource_table(poller), slot * 16 + 8, descriptor)
  nil
}

fn net_poller_platform_open_unsafe() -[Unsafe]> i64 {
  __platform_net_poller_open()
}

fn net_poller_platform_open() -> i64 {
  handle net_poller_platform_open_unsafe() {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn net_poller_platform_set_nonblocking_unsafe(descriptor: i64) -[Unsafe]> i64 {
  __platform_net_poller_set_nonblocking(descriptor)
}

fn net_poller_platform_set_nonblocking(descriptor: i64) -> i64 {
  handle net_poller_platform_set_nonblocking_unsafe(descriptor) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

