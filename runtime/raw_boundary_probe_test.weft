-- runtime/raw_boundary_probe_test.weft -- ring surface for raw-boundary tests
--
-- Trusted test support exporting a handler outside the raw boundary's audited
-- table, so the boundary's tests can show that strict code may not install an
-- unaudited runtime handler. Nothing else installs it.

--- Report a value only the trusted runtime chooses.
pub effect RawProbe {
  --- The value the installed handler reports.
  fn address() -> i64
}

--- Interpret RawProbe inside the trusted runtime.
pub implements RawProbe() {
  RawProbe.address() -> resume(0)
}
