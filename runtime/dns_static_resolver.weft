-- runtime/dns_static_resolver.weft — standalone DNS client
--
-- Used on any target whose platform exposes no authoritative system resolver
-- to a standalone product. It deliberately does not import libc, NSS,
-- getaddrinfo or a dynamic loader. It consults canonical /etc/hosts entries first, reads a
-- bounded resolver policy from /etc/resolv.conf, uses connected UDP with
-- kernel receive deadlines and retries, and falls back to framed TCP whenever
-- the authoritative response is truncated. Wire parsing lives in the pure
-- dns_static module and all returned addresses are copied typed values.

use runtime/dns_static.{
  DnsStaticConfig,
  DnsWireA,
  DnsWireAAAA,
  DnsWireAnswers,
  DnsWireMalformed,
  DnsWireNameNotFound,
  DnsWireNoData,
  DnsWirePermanent,
  DnsWireRecordType,
  DnsWireReply,
  DnsWireResourceExhausted,
  DnsWireTemporary,
  DnsWireTruncated,
  dns_static_config_attempts,
  dns_static_config_servers,
  dns_static_config_timeout_ms,
  dns_static_hosts_lookup,
  dns_static_parse_resolv,
  dns_static_text,
  dns_wire_parse_reply,
  dns_wire_query
}
use runtime/descriptor_io.{descriptor_read_append, descriptor_write_suffix}
use runtime/secure_random.{runtime_secure_random_bytes}
use runtime/syscall.{
  sys_close,
  sys_dns_set_receive_timeout,
  sys_dns_tcp_socket,
  sys_dns_udp_socket,
  sys_socket_af_inet,
  sys_socket_af_inet6
}
use runtime/tcp.{runtime_tcp_connect_descriptor_safe}
use stdlib/bytes.{Bytes}
use stdlib/dns as dns
use stdlib/dns.{
  DnsAnyFamily,
  DnsError,
  DnsFamily,
  DnsFamilyUnavailable,
  DnsIpv4Only,
  DnsIpv6Only,
  DnsNameNotFound,
  DnsPermanentFailure,
  DnsResolve,
  DnsResourceExhausted,
  DnsTemporaryFailure,
  dns_candidates_from_addresses
}
use stdlib/idna.{DomainName}
use stdlib/io.{io_read_file_bytes_raw}
use stdlib/net_address as net
use stdlib/net_address.{IpAddress, IpV4, IpV6, SocketAddress, SocketV4, SocketV6}
use stdlib/num
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_push}
use stdlib/vector/handles.{Vector}

type DnsLinuxExchange {
  DnsLinuxExchangeBytes(Vector<u8>),
  DnsLinuxExchangeTemporary,
  DnsLinuxExchangeResourceExhausted
}

fn dns_resolver_u8(value: i64) -> u8 {
  value.to_u8_checked().unwrap_or(0)
}

fn dns_resolver_server_family(server: IpAddress) -> i64 {
  match server {
    IpV4(_) -> sys_socket_af_inet()
    IpV6(_) -> sys_socket_af_inet6()
  }
}

--- Nameservers listen on the DNS port of their configured address.
fn dns_resolver_server_address(server: IpAddress) -> SocketAddress {
  match server {
    IpV4(address) -> SocketV4(address, 53)
    IpV6(address) -> SocketV6(address, 53, 0)
  }
}

fn dns_resolver_connected_socket(server: IpAddress, stream: bool, timeout_ms: i64) -> i64 {
  let fd = if stream {
    sys_dns_tcp_socket(dns_resolver_server_family(server))
  } else {
    sys_dns_udp_socket(dns_resolver_server_family(server))
  }
  if fd < 0 { fd }
  else {
    let timeout_status = sys_dns_set_receive_timeout(fd, timeout_ms)
    let connect_status = if timeout_status == 0 {
      runtime_tcp_connect_descriptor_safe(fd, dns_resolver_server_address(server))
    } else { timeout_status }
    if connect_status == 0 { fd } else { sys_close(fd); connect_status }
  }
}

fn dns_resolver_udp_exchange(
  server: IpAddress,
  query: Vector<u8>,
  timeout_ms: i64
) -> DnsLinuxExchange {
  let fd = dns_resolver_connected_socket(server, false, timeout_ms)
  if fd < 0 { DnsLinuxExchangeTemporary }
  else {
    let query_len = vector_len<u8>(query)
    let written = descriptor_write_suffix(fd, query, 0)
    let mut reply = vector.new<u8>()
    let received = if written == query_len { descriptor_read_append(fd, reply, 4096) } else {
      0 - 1
    }
    let close_status = sys_close(fd)
    if received > 0 and received <= 4096 { DnsLinuxExchangeBytes(reply) } else {
      DnsLinuxExchangeTemporary
    }
  }
}

fn dns_resolver_write_all(fd: i64, values: Vector<u8>) -> bool {
  let total = vector_len<u8>(values)
  let mut offset = 0
  let mut failed = false
  while offset < total and not failed {
    let status = descriptor_write_suffix(fd, values, __i64_to_usize(offset))
    if status > 0 and status <= total - offset { offset = offset + status }
    else { failed = true }
  }
  not failed
}

fn dns_resolver_read_exact(fd: i64, count: i64) -> DnsLinuxExchange {
  if count < 0 or count > 65535 { DnsLinuxExchangeResourceExhausted }
  else {
    let mut values = vector.with_capacity<u8>(__i64_to_usize(count))
    let mut failed = false
    while vector_len<u8>(values) < count and not failed {
      let remaining = count - vector_len<u8>(values)
      let status = descriptor_read_append(fd, values, __i64_to_usize(remaining))
      if status <= 0 or status > remaining { failed = true } else { nil }
    }
    if failed { DnsLinuxExchangeTemporary } else { DnsLinuxExchangeBytes(values) }
  }
}

fn dns_resolver_tcp_exchange(
  server: IpAddress,
  query: Vector<u8>,
  timeout_ms: i64
) -> DnsLinuxExchange {
  let fd = dns_resolver_connected_socket(server, true, timeout_ms)
  if fd < 0 { DnsLinuxExchangeTemporary }
  else {
    let query_len = vector_len<u8>(query)
    let frame = vector.with_capacity<u8>(
      (query_len + 2).to_usize_checked().expect("DNS query length fits storage")
    )
    vector_push<u8>(frame, dns_resolver_u8((query_len bshr 8) band 255))
    vector_push<u8>(frame, dns_resolver_u8(query_len band 255))
    for index in 0..query_len { vector_push<u8>(frame, vector_get_in_bounds<u8>(query, index)) }
    let result = if not dns_resolver_write_all(fd, frame) { DnsLinuxExchangeTemporary }
    else {
      match dns_resolver_read_exact(fd, 2) {
        DnsLinuxExchangeBytes(prefix) -> {
          let response_len = __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(prefix, 0))) *
            256 +
            __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(prefix, 1)))
          if response_len < 12 { DnsLinuxExchangeTemporary }
          else { dns_resolver_read_exact(fd, response_len) }
        }
        DnsLinuxExchangeResourceExhausted -> DnsLinuxExchangeResourceExhausted
        DnsLinuxExchangeTemporary -> DnsLinuxExchangeTemporary
      }
    }
    sys_close(fd)
    result
  }
}

fn dns_resolver_random_byte(values: Bytes, index: i64) -> i64 {
  match values.get(__i64_to_usize(index)) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0 - 1
  }
}

--- A transaction id must be unpredictable: a counter or clock would let an
--- off-path answer be forged. The kernel CSPRNG is the only source, and a
--- failed draw suppresses the query rather than falling back.
fn dns_resolver_transaction() -> i64 {
  match runtime_secure_random_bytes(__i64_to_usize(2)) {
    Err(_) -> 0 - 1
    Ok(values) -> {
      let high = dns_resolver_random_byte(values, 0)
      let low = dns_resolver_random_byte(values, 1)
      if high < 0 or low < 0 { 0 - 1 } else { high * 256 + low }
    }
  }
}

fn dns_resolver_exchange_reply(
  exchange: DnsLinuxExchange,
  transaction: i64,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  match exchange {
    DnsLinuxExchangeBytes(packet) -> dns_wire_parse_reply(packet, transaction, name, record)
    DnsLinuxExchangeTemporary -> DnsWireTemporary
    DnsLinuxExchangeResourceExhausted -> DnsWireResourceExhausted
  }
}

fn dns_resolver_query_server(
  server: IpAddress,
  timeout_ms: i64,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  let transaction = dns_resolver_transaction()
  if transaction < 0 { DnsWireResourceExhausted }
  else {
    let query = dns_wire_query(transaction, name, record)
    match dns_resolver_exchange_reply(
      dns_resolver_udp_exchange(server, query, timeout_ms),
      transaction,
      name,
      record
    ) {
      DnsWireTruncated -> dns_resolver_exchange_reply(
        dns_resolver_tcp_exchange(server, query, timeout_ms),
        transaction,
        name,
        record
      )
      reply -> reply
    }
  }
}

fn dns_resolver_reply_final(reply: DnsWireReply) -> bool {
  match reply {
    DnsWireAnswers(_) -> true
    DnsWireNoData -> true
    DnsWireNameNotFound -> true
    DnsWirePermanent -> true
    DnsWireResourceExhausted -> true
    DnsWireTemporary -> false
    DnsWireTruncated -> false
    DnsWireMalformed(_) -> false
  }
}

fn dns_resolver_query_record(
  config: DnsStaticConfig,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  let servers = dns_static_config_servers(config)
  let attempts = dns_static_config_attempts(config)
  let timeout_ms = dns_static_config_timeout_ms(config)
  let mut attempt = 0
  let mut answer: DnsWireReply = DnsWireTemporary
  let mut final = false
  while attempt < attempts and not final {
    let mut server_index = 0
    while server_index < vector_len<IpAddress>(servers) and not final {
      answer = dns_resolver_query_server(
        vector_get_in_bounds<IpAddress>(servers, server_index),
        timeout_ms,
        name,
        record
      )
      final = dns_resolver_reply_final(answer)
      server_index = server_index + 1
    }
    attempt = attempt + 1
  }
  answer
}

fn dns_resolver_reply_error(reply: DnsWireReply) -> DnsError {
  match reply {
    DnsWireNameNotFound -> DnsNameNotFound
    DnsWireNoData -> DnsFamilyUnavailable
    DnsWireTemporary -> DnsTemporaryFailure
    DnsWireResourceExhausted -> DnsResourceExhausted
    DnsWirePermanent -> DnsPermanentFailure
    DnsWireTruncated -> DnsTemporaryFailure
    DnsWireMalformed(_) -> DnsPermanentFailure
    DnsWireAnswers(_) -> DnsPermanentFailure
  }
}

fn dns_resolver_one_family(
  config: DnsStaticConfig,
  name: str,
  port: u16,
  family: DnsFamily,
  record: DnsWireRecordType
) -> Result<Vector<SocketAddress>, DnsError> {
  let reply = dns_resolver_query_record(config, name, record)
  match reply {
    DnsWireAnswers(addresses) -> dns_candidates_from_addresses(addresses, port, family)
    _ -> Err<Vector<SocketAddress>, DnsError>(dns_resolver_reply_error(reply))
  }
}

fn dns_resolver_both_families(
  config: DnsStaticConfig,
  name: str,
  port: u16
) -> Result<Vector<SocketAddress>, DnsError> {
  let ipv6 = dns_resolver_query_record(config, name, DnsWireAAAA)
  if match ipv6 { DnsWireNameNotFound -> true _ -> false } {
    return Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
  } else { 0 }
  let ipv4 = dns_resolver_query_record(config, name, DnsWireA)
  let addresses = vector.with_capacity<IpAddress>(4)
  match ipv6 {
    DnsWireAnswers(values) -> for index in 0..vector_len<IpAddress>(values) {
      vector_push<IpAddress>(addresses, vector_get_in_bounds<IpAddress>(values, index))
    }
    _ -> nil
  }
  match ipv4 {
    DnsWireAnswers(values) -> for index in 0..vector_len<IpAddress>(values) {
      vector_push<IpAddress>(addresses, vector_get_in_bounds<IpAddress>(values, index))
    }
    _ -> nil
  }
  if vector_len<IpAddress>(addresses) > 0 {
    dns_candidates_from_addresses(addresses, port, DnsAnyFamily)
  } else {
    if match ipv4 { DnsWireNameNotFound -> true _ -> false } {
      Err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
    } else {
      if match ipv6 { DnsWireResourceExhausted -> true _ -> false } or
        match ipv4 { DnsWireResourceExhausted -> true _ -> false } {
          Err<Vector<SocketAddress>, DnsError>(DnsResourceExhausted)
        } else {
          if match ipv6 {
            DnsWireTemporary -> true
            DnsWireMalformed(_) -> true
            DnsWireTruncated -> true
            _ -> false
          } or
            match ipv4 {
              DnsWireTemporary -> true
              DnsWireMalformed(_) -> true
              DnsWireTruncated -> true
              _ -> false
            } {
              Err<Vector<SocketAddress>, DnsError>(DnsTemporaryFailure)
            } else {
              Err<Vector<SocketAddress>, DnsError>(DnsFamilyUnavailable)
            }
        }
    }
  }
}

-- An unreadable resolver file contributes no policy, like an empty one.
fn dns_static_file_text(path: str) -> str {
  match io_read_file_bytes_raw(path) {
    Ok(values) -> dns_static_text(values)
    Err(_) -> ""
  }
}

--- Resolve through the standard resolver files for the enclosing platform.
pub(package) fn dns_static_resolve(
  host: DomainName,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  match net.parse_ip(host.ascii()) {
    Ok(address) -> dns.numeric_candidates(address, port, family)
    Err(_) -> {
      let hosts = dns_static_hosts_lookup(dns_static_file_text("/etc/hosts"), host)
      if vector_len<IpAddress>(hosts) > 0 {
        dns_candidates_from_addresses(hosts, port, family)
      } else {
        let config = dns_static_parse_resolv(dns_static_file_text("/etc/resolv.conf"))
        match family {
          DnsIpv4Only -> dns_resolver_one_family(config, host.ascii(), port, family, DnsWireA)
          DnsIpv6Only -> dns_resolver_one_family(config, host.ascii(), port, family, DnsWireAAAA)
          DnsAnyFamily -> dns_resolver_both_families(config, host.ascii(), port)
        }
      }
    }
  }
}
