-- runtime/dns_static_resolver.weft — standalone DNS client
--
-- Used on any target whose platform exposes no authoritative system resolver
-- to a standalone product. It deliberately does not import libc, NSS,
-- getaddrinfo or a dynamic loader. It consults canonical /etc/hosts entries first, reads a
-- bounded resolver policy from /etc/resolv.conf, uses connected UDP with
-- kernel receive deadlines and retries, and falls back to framed TCP whenever
-- the authoritative response is truncated. Wire parsing lives in the pure
-- dns_static module and all returned addresses are copied typed values.

use runtime/dns_static.{DnsStaticConfig, DnsWireA, DnsWireAAAA, DnsWireAnswers, DnsWireMalformed, DnsWireNameNotFound, DnsWireNoData, DnsWirePermanent, DnsWireRecordType, DnsWireReply, DnsWireResourceExhausted, DnsWireTemporary, DnsWireTruncated, dns_static_config_attempts, dns_static_config_servers, dns_static_config_timeout_ms, dns_static_hosts_lookup, dns_static_parse_resolv, dns_wire_parse_reply, dns_wire_query}
use runtime/memory.{mem_store8_at}
use runtime/secure_random.{runtime_secure_random_bytes}
use runtime/syscall.{sys_close, sys_dns_connect, sys_dns_set_receive_timeout, sys_dns_tcp_socket, sys_dns_udp_socket, sys_read, sys_socket_af_inet, sys_socket_af_inet6, sys_socket_sockaddr_prefix, sys_write}
use stdlib/bytes.{Bytes, bytes_get}
use stdlib/dns.{DnsAnyFamily, DnsError, DnsFamily, DnsFamilyUnavailable, DnsIpv4Only, DnsIpv6Only, DnsNameNotFound, DnsPermanentFailure, DnsResolve, DnsResourceExhausted, DnsTemporaryFailure, dns_candidates_from_addresses, dns_numeric_candidates}
use stdlib/idna.{DomainName}
use stdlib/io.{io_read_file_raw}
use stdlib/net_address.{IpAddress, IpV4, IpV6, Ipv4Address, Ipv6Address, SocketAddress, ip_address_parse}
use stdlib/num.{num_i64_to_u8_checked, num_int_cast_value_or, num_u16_to_u64}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok, Result, result_err}
use stdlib/vector.{vector_data, vector_get_in_bounds, vector_len, vector_push, vector_with_capacity}
use stdlib/vector/handles.{Vector}

type DnsLinuxExchange {
  DnsLinuxExchangeBytes(Vector<u8>),
  DnsLinuxExchangeTemporary,
  DnsLinuxExchangeResourceExhausted
}

fn dns_resolver_u8(value: i64) -> u8 {
  num_int_cast_value_or<u8>(num_i64_to_u8_checked(value), 0)
}

fn dns_resolver_u16_i64(value: u16) -> i64 { __u64_to_i64(num_u16_to_u64(value)) }

fn dns_resolver_ipv4_octet(address: Ipv4Address, index: i64) -> i64 {
  match address.octet(__i64_to_usize(index)) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0
  }
}

fn dns_resolver_ipv6_segment(address: Ipv6Address, index: i64) -> i64 {
  match address.segment(__i64_to_usize(index)) {
    Some(value) -> dns_resolver_u16_i64(value)
    None -> 0
  }
}

fn dns_resolver_store_u16(pointer: i64, offset: i64, value: i64) -> i64 {
  mem_store8_at(pointer, offset, value band 255)
  mem_store8_at(pointer, offset + 1, (value bshr 8) band 255)
}

fn dns_resolver_zero(pointer: i64, count: i64) -> i64 {
  for index in 0..count { mem_store8_at(pointer, index, 0) }
  count
}

fn dns_resolver_server_family(server: IpAddress) -> i64 {
  match server {
    IpV4(_) -> sys_socket_af_inet()
    IpV6(_) -> sys_socket_af_inet6()
  }
}

fn dns_resolver_encode_server(server: IpAddress, storage: i64) -> i64 {
  dns_resolver_zero(storage, 28)
  match server {
    IpV4(address) -> {
      let family = sys_socket_af_inet()
      dns_resolver_store_u16(storage, 0, sys_socket_sockaddr_prefix(family, 16))
      mem_store8_at(storage, 2, 0)
      mem_store8_at(storage, 3, 53)
      for index in 0..4 {
        mem_store8_at(storage, 4 + index, dns_resolver_ipv4_octet(address, index))
      }
      16
    }
    IpV6(address) -> {
      let family = sys_socket_af_inet6()
      dns_resolver_store_u16(storage, 0, sys_socket_sockaddr_prefix(family, 28))
      mem_store8_at(storage, 2, 0)
      mem_store8_at(storage, 3, 53)
      for index in 0..8 {
        let segment = dns_resolver_ipv6_segment(address, index)
        mem_store8_at(storage, 8 + index * 2, (segment bshr 8) band 255)
        mem_store8_at(storage, 9 + index * 2, segment band 255)
      }
      28
    }
  }
}

fn dns_resolver_response_buffer(size: i64) -> Vector<u8> {
  let values = vector_with_capacity<u8>(size)
  for index in 0..size { vector_push<u8>(values, dns_resolver_u8(0)) }
  values
}

fn dns_resolver_copy_prefix(values: Vector<u8>, count: i64) -> Vector<u8> {
  let out = vector_with_capacity<u8>(count)
  for index in 0..count { vector_push<u8>(out, vector_get_in_bounds<u8>(values, index)) }
  out
}

fn dns_resolver_connected_socket(server: IpAddress, stream: bool, timeout_ms: i64) -> i64 {
  let fd = if stream {
    sys_dns_tcp_socket(dns_resolver_server_family(server))
  } else {
    sys_dns_udp_socket(dns_resolver_server_family(server))
  }
  if fd < 0 { fd }
  else {
    let storage = dns_resolver_response_buffer(28)
    let size = dns_resolver_encode_server(server, vector_data<u8>(storage))
    let timeout_status = sys_dns_set_receive_timeout(fd, timeout_ms)
    let connect_status = if timeout_status == 0 { sys_dns_connect(fd, vector_data<u8>(storage), size) } else { timeout_status }
    if connect_status == 0 { fd } else { sys_close(fd); connect_status }
  }
}

fn dns_resolver_udp_exchange(
  server: IpAddress,
  query: Vector<u8>,
  timeout_ms: i64
) -> DnsLinuxExchange {
  let fd = dns_resolver_connected_socket(server, false, timeout_ms)
  if fd < 0 { DnsLinuxExchangeTemporary }
  else {
    let query_len = vector_len<u8>(query)
    let written = sys_write(fd, vector_data<u8>(query), query_len)
    let scratch = dns_resolver_response_buffer(4096)
    let received = if written == query_len { sys_read(fd, vector_data<u8>(scratch), 4096) } else { 0 - 1 }
    let close_status = sys_close(fd)
    if received > 0 and received <= 4096 {
      DnsLinuxExchangeBytes(dns_resolver_copy_prefix(scratch, received))
    } else { DnsLinuxExchangeTemporary }
  }
}

fn dns_resolver_write_all(fd: i64, values: Vector<u8>) -> bool {
  let total = vector_len<u8>(values)
  let mut offset = 0
  let mut failed = false
  while offset < total and not failed {
    let status = sys_write(fd, vector_data<u8>(values) + offset, total - offset)
    if status > 0 and status <= total - offset { offset = offset + status }
    else { failed = true }
  }
  not failed
}

fn dns_resolver_read_exact(fd: i64, count: i64) -> DnsLinuxExchange {
  if count < 0 or count > 65535 { DnsLinuxExchangeResourceExhausted }
  else {
    let values = dns_resolver_response_buffer(count)
    let mut offset = 0
    let mut failed = false
    while offset < count and not failed {
      let status = sys_read(fd, vector_data<u8>(values) + offset, count - offset)
      if status > 0 and status <= count - offset { offset = offset + status }
      else { failed = true }
    }
    if failed { DnsLinuxExchangeTemporary } else { DnsLinuxExchangeBytes(values) }
  }
}

fn dns_resolver_tcp_exchange(
  server: IpAddress,
  query: Vector<u8>,
  timeout_ms: i64
) -> DnsLinuxExchange {
  let fd = dns_resolver_connected_socket(server, true, timeout_ms)
  if fd < 0 { DnsLinuxExchangeTemporary }
  else {
    let query_len = vector_len<u8>(query)
    let frame = vector_with_capacity<u8>(query_len + 2)
    vector_push<u8>(frame, dns_resolver_u8((query_len bshr 8) band 255))
    vector_push<u8>(frame, dns_resolver_u8(query_len band 255))
    for index in 0..query_len { vector_push<u8>(frame, vector_get_in_bounds<u8>(query, index)) }
    let result = if not dns_resolver_write_all(fd, frame) { DnsLinuxExchangeTemporary }
    else {
      match dns_resolver_read_exact(fd, 2) {
        DnsLinuxExchangeBytes(prefix) -> {
          let response_len = __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(prefix, 0))) * 256 +
            __u64_to_i64(__u8_to_u64(vector_get_in_bounds<u8>(prefix, 1)))
          if response_len < 12 { DnsLinuxExchangeTemporary }
          else { dns_resolver_read_exact(fd, response_len) }
        }
        DnsLinuxExchangeResourceExhausted -> DnsLinuxExchangeResourceExhausted
        DnsLinuxExchangeTemporary -> DnsLinuxExchangeTemporary
      }
    }
    sys_close(fd)
    result
  }
}

fn dns_resolver_random_byte(values: Bytes, index: i64) -> i64 {
  match bytes_get(values, index) {
    Some(value) -> __u64_to_i64(__u8_to_u64(value))
    None -> 0 - 1
  }
}

--- A transaction id must be unpredictable: a counter or clock would let an
--- off-path answer be forged. The kernel CSPRNG is the only source, and a
--- failed draw suppresses the query rather than falling back.
fn dns_resolver_transaction() -> i64 {
  match runtime_secure_random_bytes(__i64_to_usize(2)) {
    Err(_) -> 0 - 1
    Ok(values) -> {
      let high = dns_resolver_random_byte(values, 0)
      let low = dns_resolver_random_byte(values, 1)
      if high < 0 or low < 0 { 0 - 1 } else { high * 256 + low }
    }
  }
}

fn dns_resolver_exchange_reply(
  exchange: DnsLinuxExchange,
  transaction: i64,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  match exchange {
    DnsLinuxExchangeBytes(packet) -> dns_wire_parse_reply(packet, transaction, name, record)
    DnsLinuxExchangeTemporary -> DnsWireTemporary
    DnsLinuxExchangeResourceExhausted -> DnsWireResourceExhausted
  }
}

fn dns_resolver_query_server(
  server: IpAddress,
  timeout_ms: i64,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  let transaction = dns_resolver_transaction()
  if transaction < 0 { DnsWireResourceExhausted }
  else {
    let query = dns_wire_query(transaction, name, record)
    match dns_resolver_exchange_reply(dns_resolver_udp_exchange(server, query, timeout_ms), transaction, name, record) {
      DnsWireTruncated -> dns_resolver_exchange_reply(
        dns_resolver_tcp_exchange(server, query, timeout_ms), transaction, name, record
      )
      reply -> reply
    }
  }
}

fn dns_resolver_reply_final(reply: DnsWireReply) -> bool {
  match reply {
    DnsWireAnswers(_) -> true
    DnsWireNoData -> true
    DnsWireNameNotFound -> true
    DnsWirePermanent -> true
    DnsWireResourceExhausted -> true
    DnsWireTemporary -> false
    DnsWireTruncated -> false
    DnsWireMalformed(_) -> false
  }
}

fn dns_resolver_query_record(
  config: DnsStaticConfig,
  name: str,
  record: DnsWireRecordType
) -> DnsWireReply {
  let servers = dns_static_config_servers(config)
  let attempts = dns_static_config_attempts(config)
  let timeout_ms = dns_static_config_timeout_ms(config)
  let mut attempt = 0
  let mut answer: DnsWireReply = DnsWireTemporary
  let mut final = false
  while attempt < attempts and not final {
    let mut server_index = 0
    while server_index < vector_len<IpAddress>(servers) and not final {
      answer = dns_resolver_query_server(
        vector_get_in_bounds<IpAddress>(servers, server_index), timeout_ms, name, record
      )
      final = dns_resolver_reply_final(answer)
      server_index = server_index + 1
    }
    attempt = attempt + 1
  }
  answer
}

fn dns_resolver_reply_error(reply: DnsWireReply) -> DnsError {
  match reply {
    DnsWireNameNotFound -> DnsNameNotFound
    DnsWireNoData -> DnsFamilyUnavailable
    DnsWireTemporary -> DnsTemporaryFailure
    DnsWireResourceExhausted -> DnsResourceExhausted
    DnsWirePermanent -> DnsPermanentFailure
    DnsWireTruncated -> DnsTemporaryFailure
    DnsWireMalformed(_) -> DnsPermanentFailure
    DnsWireAnswers(_) -> DnsPermanentFailure
  }
}

fn dns_resolver_one_family(
  config: DnsStaticConfig,
  name: str,
  port: u16,
  family: DnsFamily,
  record: DnsWireRecordType
) -> Result<Vector<SocketAddress>, DnsError> {
  let reply = dns_resolver_query_record(config, name, record)
  match reply {
    DnsWireAnswers(addresses) -> dns_candidates_from_addresses(addresses, port, family)
    _ -> result_err<Vector<SocketAddress>, DnsError>(dns_resolver_reply_error(reply))
  }
}

fn dns_resolver_both_families(
  config: DnsStaticConfig,
  name: str,
  port: u16
) -> Result<Vector<SocketAddress>, DnsError> {
  let ipv6 = dns_resolver_query_record(config, name, DnsWireAAAA)
  if match ipv6 { DnsWireNameNotFound -> true _ -> false } {
    return result_err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
  } else { 0 }
  let ipv4 = dns_resolver_query_record(config, name, DnsWireA)
  let addresses = vector_with_capacity<IpAddress>(4)
  match ipv6 {
    DnsWireAnswers(values) -> for index in 0..vector_len<IpAddress>(values) {
      vector_push<IpAddress>(addresses, vector_get_in_bounds<IpAddress>(values, index))
    }
    _ -> nil
  }
  match ipv4 {
    DnsWireAnswers(values) -> for index in 0..vector_len<IpAddress>(values) {
      vector_push<IpAddress>(addresses, vector_get_in_bounds<IpAddress>(values, index))
    }
    _ -> nil
  }
  if vector_len<IpAddress>(addresses) > 0 {
    dns_candidates_from_addresses(addresses, port, DnsAnyFamily)
  } else { if match ipv4 { DnsWireNameNotFound -> true _ -> false } {
    result_err<Vector<SocketAddress>, DnsError>(DnsNameNotFound)
  } else { if match ipv6 { DnsWireResourceExhausted -> true _ -> false } or
              match ipv4 { DnsWireResourceExhausted -> true _ -> false } {
    result_err<Vector<SocketAddress>, DnsError>(DnsResourceExhausted)
  } else { if match ipv6 { DnsWireTemporary -> true DnsWireMalformed(_) -> true DnsWireTruncated -> true _ -> false } or
              match ipv4 { DnsWireTemporary -> true DnsWireMalformed(_) -> true DnsWireTruncated -> true _ -> false } {
    result_err<Vector<SocketAddress>, DnsError>(DnsTemporaryFailure)
  } else {
    result_err<Vector<SocketAddress>, DnsError>(DnsFamilyUnavailable)
  } } } }
}

--- Resolve through the standard resolver files for the enclosing platform.
pub(package) fn dns_static_resolve(
  host: DomainName,
  port: u16,
  family: DnsFamily
) -> Result<Vector<SocketAddress>, DnsError> {
  match ip_address_parse(host.ascii()) {
    Ok(address) -> dns_numeric_candidates(address, port, family)
    Err(_) -> {
      let hosts = dns_static_hosts_lookup(io_read_file_raw("/etc/hosts"), host)
      if vector_len<IpAddress>(hosts) > 0 {
        dns_candidates_from_addresses(hosts, port, family)
      } else {
        let config = dns_static_parse_resolv(io_read_file_raw("/etc/resolv.conf"))
        match family {
          DnsIpv4Only -> dns_resolver_one_family(config, host.ascii(), port, family, DnsWireA)
          DnsIpv6Only -> dns_resolver_one_family(config, host.ascii(), port, family, DnsWireAAAA)
          DnsAnyFamily -> dns_resolver_both_families(config, host.ascii(), port)
        }
      }
    }
  }
}
