-- runtime/secure_random.weft — sealed target-neutral CSPRNG handler
--
-- The semantic platform leaf returns positive kernel progress or a normalized
-- error. This engine loops interruption/partial progress and publishes only
-- immutable Bytes plus typed errors through the public SecureRandom effect.

use runtime/syscall.{sys_secure_random_read}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/num
use stdlib/result.{Result, Err, Ok}
use stdlib/secure_random.{SecureRandom, SecureRandomError, SecureRandomLimitExceeded, SecureRandomPlatform}
use stdlib/vector as vector
use stdlib/vector.{vector_data, vector_push}
use stdlib/vector/handles.{Vector}

fn runtime_secure_random_chunk_limit() -> i64 { 256 }

fn runtime_secure_random_count_i64(count: usize) -> i64 {
  count.to_u64().to_i64_checked().unwrap_or(0 - 1)
}

fn runtime_secure_random_fill_raw(buffer: i64, count: i64) -> i64 {
  let mut offset = 0
  let mut failure = 0
  while offset < count and failure == 0 {
    let remaining = count - offset
    let chunk = if remaining < runtime_secure_random_chunk_limit() { remaining } else { runtime_secure_random_chunk_limit() }
    let mut status = sys_secure_random_read(buffer + offset, chunk)
    while status == 0 - 4 {
      status = sys_secure_random_read(buffer + offset, chunk)
    }
    if status > 0 and status <= chunk { offset = offset + status }
    else { failure = if status < 0 { 0 - status } else { 5 } }
  }
  failure
}

--- Draw exactly `count` fresh bytes for another trusted runtime module.
--- The raw fill loop stays private so no caller receives a writable buffer.
pub(package) fn runtime_secure_random_bytes(count: usize) -> Result<Bytes, SecureRandomError> {
  let raw_count = runtime_secure_random_count_i64(count)
  if raw_count < 0 {
    Err<Bytes, SecureRandomError>(SecureRandomLimitExceeded(count))
  } else { if raw_count == 0 {
    Ok<Bytes, SecureRandomError>(bytes.empty())
  } else {
    let values: Vector<u8> = vector.with_capacity<u8>(count)
    for i in 0..raw_count { vector_push<u8>(values, 0) }
    let failure = runtime_secure_random_fill_raw(vector_data<u8>(values), raw_count)
    if failure == 0 {
      Ok<Bytes, SecureRandomError>(bytes.from_vector(values))
    } else {
      Err<Bytes, SecureRandomError>(SecureRandomPlatform(failure))
    }
  } }
}

--- Interpret SecureRandom through the target platform CSPRNG.
pub implements SecureRandom() {
  SecureRandom.bytes(count) -> resume(runtime_secure_random_bytes(count))
}
