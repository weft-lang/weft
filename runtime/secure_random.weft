-- runtime/secure_random.weft — sealed Darwin CSPRNG handler
--
-- Darwin getentropy is a direct syscall with a 256-byte maximum per request.
-- This trusted leaf loops that mechanical limit and publishes only immutable
-- Bytes plus typed errors through the public SecureRandom effect.

use runtime/syscall.{sys_raw}
use stdlib/bytes.{Bytes, bytes_empty, bytes_from_vector}
use stdlib/num.{num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64}
use stdlib/result.{Result, result_err, result_ok}
use stdlib/secure_random.{SecureRandom, SecureRandomError, SecureRandomLimitExceeded, SecureRandomPlatform}
use stdlib/vector.{vector_data, vector_push, vector_with_capacity}
use stdlib/vector_type.{Vector}

fn runtime_secure_random_getentropy_syscall() -> i64 { 500 }
fn runtime_secure_random_getentropy_limit() -> i64 { 256 }

fn runtime_secure_random_count_i64(count: usize) -> i64 {
  num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(count)), 0 - 1)
}

fn runtime_secure_random_fill_raw(buffer: i64, count: i64) -> i64 {
  let mut offset = 0
  let mut failure = 0
  while offset < count and failure == 0 {
    let remaining = count - offset
    let chunk = if remaining < runtime_secure_random_getentropy_limit() { remaining } else { runtime_secure_random_getentropy_limit() }
    let mut status = sys_raw(runtime_secure_random_getentropy_syscall(), buffer + offset, chunk, 0, 0, 0, 0)
    while status == 0 - 4 {
      status = sys_raw(runtime_secure_random_getentropy_syscall(), buffer + offset, chunk, 0, 0, 0, 0)
    }
    if status == 0 { offset = offset + chunk }
    else { failure = if status < 0 { 0 - status } else { status } }
  }
  failure
}

fn runtime_secure_random_bytes(count: usize) -> Result<Bytes, SecureRandomError> {
  let raw_count = runtime_secure_random_count_i64(count)
  if raw_count < 0 {
    result_err<Bytes, SecureRandomError>(SecureRandomLimitExceeded(count))
  } else { if raw_count == 0 {
    result_ok<Bytes, SecureRandomError>(bytes_empty())
  } else {
    let values: Vector<u8> = vector_with_capacity<u8>(raw_count)
    for i in 0..raw_count { vector_push<u8>(values, 0) }
    let failure = runtime_secure_random_fill_raw(vector_data<u8>(values), raw_count)
    if failure == 0 {
      result_ok<Bytes, SecureRandomError>(bytes_from_vector(values))
    } else {
      result_err<Bytes, SecureRandomError>(SecureRandomPlatform(failure))
    }
  } }
}

--- Install the Darwin production CSPRNG while preserving result and residual effects.
pub fn runtime_platform_secure_random<T, E>(body: () -[SecureRandom, E]> T) -[E]> T {
  handle body() {
    SecureRandom.bytes(count) -> resume(runtime_secure_random_bytes(count))
  }
}
