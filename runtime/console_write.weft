-- runtime/console_write.weft — package-private host console-output leaves

use runtime/safe_write_core.{runtime_safe_write_fd}
use stdlib/bytes.{Bytes}
use stdlib/console.{ConsoleStderr, ConsoleStdout, ConsoleStream}
use stdlib/io/types.{IoError}
use stdlib/result.{Result, Ok}

fn runtime_safe_console_write_fd(stream: ConsoleStream) -> i64 {
  match stream {
    ConsoleStdout -> 1
    ConsoleStderr -> 2
  }
}

pub(package) fn runtime_safe_console_write_result(
  stream: ConsoleStream,
  values: Bytes
) -> Result<usize, IoError> {
  runtime_safe_write_fd(runtime_safe_console_write_fd(stream), values)
}

pub(package) fn runtime_safe_console_flush_result(stream: ConsoleStream) -> Result<nil, IoError> {
  -- Raw descriptor writes are unbuffered at this layer.
  Ok<nil, IoError>(nil)
}
