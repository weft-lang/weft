-- runtime/safe_console_write.weft — production ConsoleWrite interpretation
--
-- Standard-output authority selects only a stream descriptor and the shared
-- complete-write semantics. It imports no file, directory, or process policy.

use runtime/safe_write_core.{runtime_safe_write_fd}
use stdlib/bytes.{Bytes}
use stdlib/console.{ConsoleStderr, ConsoleStdout, ConsoleStream, ConsoleWrite}
use stdlib/io/types.{IoError}
use stdlib/result.{Result, result_ok}

fn runtime_safe_console_write_fd(stream: ConsoleStream) -> i64 {
  match stream {
    ConsoleStdout -> 1
    ConsoleStderr -> 2
  }
}

pub(package) fn runtime_safe_console_write_result(
  stream: ConsoleStream,
  values: Bytes
) -> Result<usize, IoError> {
  runtime_safe_write_fd(runtime_safe_console_write_fd(stream), values)
}

pub(package) fn runtime_safe_console_flush_result(stream: ConsoleStream) -> Result<nil, IoError> {
  -- Raw descriptor writes are unbuffered at this layer.
  result_ok<nil, IoError>(nil)
}

pub fn runtime_platform_console_write(body: () -[ConsoleWrite]> i64) -> i64 {
  handle body() {
    ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_console_write_result(stream, values))
    ConsoleWrite.flush(stream) -> resume(runtime_safe_console_flush_result(stream))
  }
}

pub fn runtime_platform_console_write_with<E>(body: () -[ConsoleWrite, E]> i64) -[E]> i64 {
  handle body() {
    ConsoleWrite.write_all(stream, values) -> resume(runtime_safe_console_write_result(stream, values))
    ConsoleWrite.flush(stream) -> resume(runtime_safe_console_flush_result(stream))
  }
}
