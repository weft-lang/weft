fn tls_mbedtls_seal_close_step(raw: * any) -> i64 {
  handle tls_mbedtls_close_step(raw) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_native_raw(session: borrow TlsSession) -> * any {
  match session { TlsSession(raw) -> raw }
}

impl Drop for TlsSession {
  fn drop(self) -> i64 {
    match self { TlsSession(raw) -> tls_mbedtls_seal_free(raw) }
  }
}

pub (package) fn tls_native_client_open(
  trust_roots: [u8],
  identity: [u8],
  seed: [u8],
  verification_time: i64
) -> TlsNativeOpen {
  let raw = tls_mbedtls_seal_client_new(trust_roots, identity, seed, verification_time)
  let status = tls_mbedtls_seal_last_error(raw)
  if status == 0 {
    TlsNativeOpened(TlsSession(raw))
  } else {
    let detail = tls_mbedtls_seal_last_detail(raw)
    tls_mbedtls_seal_free(raw)
    TlsNativeOpenFailed(status, detail)
  }
}

pub (package) fn tls_native_server_open(
  certificate: [u8],
  private_key: [u8],
  seed: [u8]
) -> TlsNativeOpen {
  let raw = tls_mbedtls_seal_server_new(certificate, private_key, seed)
  let status = tls_mbedtls_seal_last_error(raw)
  if status == 0 {
    TlsNativeOpened(TlsSession(raw))
  } else {
    let detail = tls_mbedtls_seal_last_detail(raw)
    tls_mbedtls_seal_free(raw)
    TlsNativeOpenFailed(status, detail)
  }
}

pub (package) fn tls_native_last_detail(session: borrow TlsSession) -> i64 {
  tls_mbedtls_seal_last_detail(tls_native_raw(session))
}

