  handle tls_mbedtls_last_count(raw) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_mbedtls_seal_pending_output(raw: * any) -> i64 {
  handle tls_mbedtls_pending_output(raw) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_mbedtls_seal_feed(raw: * any, values: [u8]) -> i64 {
