fn tls_mbedtls_seal_drain(raw: * any, buffer: [mut u8]) -> i64 {
  handle tls_mbedtls_drain(raw, buffer) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_mbedtls_seal_handshake(raw: * any) -> i64 {
