-- runtime/tls_mbedtls.weft — sealed Mbed TLS native-binding leaf
--
-- The manifest supplies the exact callback-free static adapter for each alpha
-- target. This trusted module seals Unsafe and the foreign pointer; ordinary
-- code receives only an owned opaque session and package-private typed steps.

use runtime/unsafe.{Unsafe}
use stdlib/drop.{Drop}

--- An opaque single-owner TLS engine session.
---
--- Import this through `stdlib/tls`; its representation and raw operations are
--- deliberately unavailable outside this trusted binding module.
pub type TlsSession = opaque * any

pub (package) type TlsNativeOpen {
  TlsNativeOpened(owned TlsSession),
    TlsNativeOpenFailed(i64, i64)
}

fn tls_mbedtls_seal_client_new(
  trust_roots: [u8],
  identity: [u8],
  seed: [u8],
  verification_time: i64
) -> * any {
  handle tls_mbedtls_client_new(trust_roots, identity, seed, verification_time) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn tls_mbedtls_seal_server_new(
  certificate: [u8],
  private_key: [u8],
  seed: [u8]
) -> * any {
  handle tls_mbedtls_server_new(certificate, private_key, seed) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn tls_mbedtls_seal_free(raw: * any) -> i64 {
  handle { tls_mbedtls_session_free(raw) 0 } {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_mbedtls_seal_last_error(raw: * any) -> i64 {
  handle tls_mbedtls_last_error(raw) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

fn tls_mbedtls_seal_last_detail(raw: * any) -> i64 {
  handle tls_mbedtls_last_detail(raw) {
    Unsafe.transmute(value) -> resume(__transmute(value))
  }
}

