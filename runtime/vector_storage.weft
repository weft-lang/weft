-- runtime/vector_storage.weft -- trusted raw storage bridge for stdlib/vector.

use "runtime/alloc.weft"
use "runtime/memory.weft"
use "runtime/rc.weft"
use "runtime/unsafe.weft"

fn vector_storage_header_size() -> i64 { 40 }
fn vector_storage_data_offset() -> i64 { 0 }
fn vector_storage_len_offset() -> i64 { 8 }
fn vector_storage_capacity_offset() -> i64 { 16 }
fn vector_storage_element_size_offset() -> i64 { 24 }
fn vector_storage_element_mode_offset() -> i64 { 32 }

fn vector_storage_word_mode() -> i64 { 0 }

-- Vector<T> is a sealed nominal machine-word handle. Only this trusted
-- storage bridge crosses between its public type identity and the raw RC
-- pointer used by the allocator and memory primitives.
fn vector_storage_handle_from_word<T>(value: i64) -> Vector<T> {
  -- The raw rc local in vector_storage_new releases at function exit, so
  -- establish the typed result's stake before changing only static identity.
  rc_default_retain(value)
  handle unsafe_transmute<i64, Vector<T>>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn vector_storage_handle_word<T>(vec: Vector<T>) -> i64 {
  handle unsafe_transmute<Vector<T>, i64>(vec) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Data buffers and their compiler-managed headers live on the default
-- managed heap. Growth returns abandoned buffers immediately; the RC
-- header's vector finalizer returns final storage and drops managed
-- elements when the last handle dies.
fn vector_storage_alloc_bytes(n: i64) -> i64 {
  if n <= 0 { 0 } else { heap_alloc(rc_default_heap(), n, 8) }
}

fn vector_storage_free_bytes(ptr: i64, n: i64) -> i64 {
  if ptr == 0 or n <= 0 { 0 } else { heap_free(rc_default_heap(), ptr, n) }
}

fn vector_storage_new<T>(cap: i64, elem_size: i64, elem_mode: i64) -> Vector<T> {
  let header: rc i64 = rc_default_alloc_finalized(vector_storage_header_size(), 8, rc_finalizer_vector())
  let raw: i64 = header
  let data = if cap == 0 or elem_size <= 0 { 0 } else { vector_storage_alloc_bytes(cap * elem_size) }
  __mem_store64(raw + vector_storage_data_offset(), data)
  __mem_store64(raw + vector_storage_len_offset(), 0)
  __mem_store64(raw + vector_storage_capacity_offset(), cap)
  __mem_store64(raw + vector_storage_element_size_offset(), elem_size)
  __mem_store64(raw + vector_storage_element_mode_offset(), elem_mode)
  vector_storage_handle_from_word<T>(raw)
}

fn vector_storage_is_null<T>(vec: Vector<T>) -> i64 {
  if vector_storage_handle_word<T>(vec) == 0 { 1 } else { 0 }
}

fn vector_storage_promote<T>(vec: Vector<T>) -> i64 {
  rc_default_promote_maybe(vector_storage_handle_word<T>(vec))
}

fn vector_storage_is_promoted<T>(vec: Vector<T>) -> i64 {
  rc_default_is_promoted_maybe(vector_storage_handle_word<T>(vec))
}

fn vector_storage_len<T>(vec: Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_len_offset()) }
}

fn vector_storage_capacity<T>(vec: Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_capacity_offset()) }
}

fn vector_storage_data<T>(vec: Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_data_offset()) }
}

fn vector_storage_element_size<T>(vec: Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_element_size_offset()) }
}

fn vector_storage_element_mode<T>(vec: Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { vector_storage_word_mode() } else { __mem_load64(raw + vector_storage_element_mode_offset()) }
}

fn vector_storage_set_data_capacity<T>(vec: Vector<T>, data: i64, cap: i64) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  __mem_store64(raw + vector_storage_data_offset(), data)
  __mem_store64(raw + vector_storage_capacity_offset(), cap)
  0
}

fn vector_storage_set_len<T>(vec: Vector<T>, len: i64) -> i64 {
  __mem_store64(vector_storage_handle_word<T>(vec) + vector_storage_len_offset(), len)
  0
}

fn vector_storage_word_as<T>(value: i64) -> T {
  handle unsafe_transmute<i64, T>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

fn vector_storage_word_from<T>(value: T) -> i64 {
  handle unsafe_transmute<T, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Managed word elements (2q slice 2): the container owns its elements.
-- Stores retain, element drops release, loads retain (call results are
-- owned — the caller's ownership machinery releases at lifetime end).
-- Compile-time twin: cg_layout_vector_managed_mode.
fn vector_storage_managed_mode() -> i64 { 8 }

fn vector_storage_load_value<T>(addr: i64, elem_size: i64, elem_mode: i64, default: T) -> T {
  if elem_size <= 0 { default } else {
    let w = __mem_load_sized(addr, elem_size, elem_mode)
    if elem_mode == vector_storage_managed_mode() { rc_default_retain(w) } else { 0 }
    vector_storage_word_as<T>(w)
  }
}

fn vector_storage_load_value_in_bounds<T>(addr: i64, elem_size: i64, elem_mode: i64) -> T {
  let w = __mem_load_sized(addr, elem_size, elem_mode)
  if elem_mode == vector_storage_managed_mode() { rc_default_retain(w) } else { 0 }
  vector_storage_word_as<T>(w)
}

fn vector_storage_store_value<T>(addr: i64, elem_size: i64, elem_mode: i64, value: T) -> i64 {
  if elem_size <= 0 { 0 }
  else {
    let w = vector_storage_word_from<T>(value)
    __mem_store_sized(addr, elem_size, elem_mode, w)
    if elem_mode == vector_storage_managed_mode() { rc_default_retain(w) } else { 0 }
    0
  }
}

-- Releases the container's stake in the element at addr. No-op for
-- non-managed modes and for immediates/foreign pointers (the rc magic
-- bounds check rejects them).
fn vector_storage_release_element(addr: i64, elem_mode: i64) -> i64 {
  if elem_mode == vector_storage_managed_mode() {
    rc_default_release(__mem_load64(addr))
  } else { 0 }
}

-- Borrowed field read from a MANAGED element slot: loads payload
-- `field` of the heap object whose pointer sits at addr, without
-- materialising an owned element reference. The container keeps the
-- element alive across the two loads (nothing user-visible runs in
-- between). Ownership of the RESULT is the caller's concern — see
-- vector_get_field_in_bounds, which retains managed payloads.
fn vector_storage_field_word(addr: i64, field: i64) -> i64 {
  __mem_load64(__mem_load64(addr) + 8 + field * 8)
}

-- Ownership hook for the borrowed field read: managed payload words
-- become owned (+1) before crossing back into safe code.
fn vector_storage_retain_word(w: i64) -> i64 {
  rc_default_retain(w)
}

fn persistent_vector_storage_chunk_size() -> i64 { 32 }
fn persistent_vector_storage_header_size() -> i64 { 56 }
fn persistent_vector_storage_node_size() -> i64 { 256 }
fn persistent_vector_storage_len_offset() -> i64 { 0 }
fn persistent_vector_storage_element_size_offset() -> i64 { 8 }
fn persistent_vector_storage_element_mode_offset() -> i64 { 16 }
fn persistent_vector_storage_tree_count_offset() -> i64 { 24 }
fn persistent_vector_storage_tree_depth_offset() -> i64 { 32 }
fn persistent_vector_storage_tree_root_offset() -> i64 { 40 }
fn persistent_vector_storage_tail_offset() -> i64 { 48 }
fn persistent_vector_storage_box_size() -> i64 { 16 }
fn persistent_vector_storage_box_region_offset() -> i64 { 8 }
fn persistent_vector_storage_box_region_mask() -> i64 { 4 }

fn persistent_vector_storage_region_new() -> rc i64 {
  rc_persistent_region_new()
}

fn persistent_vector_storage_box(root: i64, region: i64) -> rc i64 {
  let box: rc i64 = rc_default_alloc(persistent_vector_storage_box_size(), 8)
  let raw: i64 = box
  rc_set_field_mask_word(raw, persistent_vector_storage_box_size(), persistent_vector_storage_box_region_mask())
  __mem_store64(raw, root)
  __mem_store64(raw + persistent_vector_storage_box_region_offset(), region)
  rc_default_retain(region)
  box
}

fn persistent_vector_storage_region(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec + persistent_vector_storage_box_region_offset()) }
}

fn persistent_vector_storage_make_root(region: i64, len: i64, elem_size: i64, elem_mode: i64, tree_count: i64, tree_depth: i64, tree_root: i64, tail: i64) -> i64 {
  let root = rc_persistent_region_alloc(region, persistent_vector_storage_header_size(), 8)
  __mem_store64(root + persistent_vector_storage_len_offset(), len)
  __mem_store64(root + persistent_vector_storage_element_size_offset(), elem_size)
  __mem_store64(root + persistent_vector_storage_element_mode_offset(), elem_mode)
  __mem_store64(root + persistent_vector_storage_tree_count_offset(), tree_count)
  __mem_store64(root + persistent_vector_storage_tree_depth_offset(), tree_depth)
  __mem_store64(root + persistent_vector_storage_tree_root_offset(), tree_root)
  __mem_store64(root + persistent_vector_storage_tail_offset(), tail)
  root
}

fn persistent_vector_storage_root(vec: i64) -> i64 {
  if vec == 0 { 0 } else { __mem_load64(vec) }
}

fn persistent_vector_storage_len(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_len_offset()) }
}

fn persistent_vector_storage_element_size(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_element_size_offset()) }
}

fn persistent_vector_storage_element_mode(root: i64) -> i64 {
  if root == 0 { vector_storage_word_mode() } else { __mem_load64(root + persistent_vector_storage_element_mode_offset()) }
}

fn persistent_vector_storage_tree_count(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tree_count_offset()) }
}

fn persistent_vector_storage_tree_depth(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tree_depth_offset()) }
}

fn persistent_vector_storage_tree_root(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tree_root_offset()) }
}

fn persistent_vector_storage_tail(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tail_offset()) }
}

fn persistent_vector_storage_copy_node(region: i64, node: i64) -> i64 {
  let next = rc_persistent_region_alloc(region, persistent_vector_storage_node_size(), 8)
  if node != 0 {
    mem_copy(next, node, persistent_vector_storage_node_size())
  } else {
    for i in 0..persistent_vector_storage_chunk_size() {
      __mem_store64(next + i * 8, 0)
    }
  }
  next
}

fn persistent_vector_storage_copy_chunk(region: i64, chunk: i64, elem_size: i64, elem_mode: i64) -> i64 {
  let bytes = persistent_vector_storage_chunk_size() * elem_size
  let next = rc_persistent_region_alloc(region, bytes, 8)
  if chunk != 0 {
    mem_copy(next, chunk, bytes)
    if elem_mode == vector_storage_managed_mode() {
      for i in 0..persistent_vector_storage_chunk_size() {
        rc_persistent_region_retain_managed(region, __mem_load64(next + i * elem_size))
      }
    } else { 0 }
  } else {
    mem_zero(next, bytes)
  }
  next
}

fn persistent_vector_storage_register_stored(region: i64, addr: i64, elem_mode: i64) -> i64 {
  if elem_mode == vector_storage_managed_mode() {
    rc_persistent_region_register_retained(region, __mem_load64(addr))
  } else { 0 }
}

fn persistent_vector_storage_node_child(node: i64, slot: i64) -> i64 {
  __mem_load64(node + slot * 8)
}

fn persistent_vector_storage_node_set_child(node: i64, slot: i64, child: i64) -> i64 {
  __mem_store64(node + slot * 8, child)
  0
}
