pub(package) fn persistent_vector_storage_copy_node(region: i64, node: i64) -> i64 {
  let next = rc_persistent_region_alloc(region, persistent_vector_storage_node_size(), 8)
  if node != 0 {
    mem_copy(next, node, persistent_vector_storage_node_size())
  } else {
    for i in 0..persistent_vector_storage_chunk_size() {
      __mem_store64(next + i * 8, 0)
    }
  }
  next
}

pub(package) fn persistent_vector_storage_copy_chunk(region: i64, chunk: i64, elem_size: i64, elem_mode: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  let bytes = persistent_vector_storage_chunk_size() * elem_size
  let next = rc_persistent_region_alloc(region, bytes, 8)
  if chunk != 0 {
    mem_copy(next, chunk, bytes)
    if leaf_count >= 0 {
      for i in 0..persistent_vector_storage_chunk_size() {
        let mut leaf = 0
        while leaf < leaf_count and leaf_stride > 0 {
          rc_persistent_region_retain_kind(region, __mem_load64(next + i * elem_size + leaf * leaf_stride), leaf_kind)
          leaf = leaf + 1
        }
      }
    } else {
      let elem_kind = rc_vector_element_cleanup_kind(elem_mode)
      if elem_kind != 0 {
      for i in 0..persistent_vector_storage_chunk_size() {
        rc_persistent_region_retain_kind(region, __mem_load64(next + i * elem_size), elem_kind)
      }
      } else { 0 }
    }
  } else {
    mem_zero(next, bytes)
  }
  next
}

pub(package) fn persistent_vector_storage_register_stored(region: i64, addr: i64, elem_mode: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if leaf_count >= 0 {
    let mut leaf = 0
    while leaf < leaf_count and leaf_stride > 0 {
      rc_persistent_region_register_retained_kind(region, __mem_load64(addr + leaf * leaf_stride), leaf_kind)
      leaf = leaf + 1
    }
    leaf_count
  } else {
    rc_persistent_region_register_retained_kind(region, __mem_load64(addr), rc_vector_element_cleanup_kind(elem_mode))
  }
}

pub(package) fn persistent_vector_storage_node_child(node: i64, slot: i64) -> i64 {
  __mem_load64(node + slot * 8)
}

pub(package) fn persistent_vector_storage_node_set_child(node: i64, slot: i64, child: i64) -> i64 {
  __mem_store64(node + slot * 8, child)
  0
}
