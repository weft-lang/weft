pub(package) fn vector_storage_word_as<T>(value: i64) -> T {
  handle unsafe_transmute<i64, T>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn vector_storage_word_from<T>(value: T) -> i64 {
  handle unsafe_transmute<T, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Managed word elements: the container owns its elements.
-- Stores retain, element drops release, loads retain (call results are
-- owned — the caller's ownership machinery releases at lifetime end).
-- Compile-time twin: cg_layout_vector_managed_mode.
pub(package) fn vector_storage_managed_mode() -> i64 { 8 }
pub(package) fn vector_storage_closure_mode() -> i64 { 9 }
pub(package) fn vector_storage_weak_mode() -> i64 { 10 }

pub(package) fn vector_storage_retain_for_mode(value: i64, elem_mode: i64) -> i64 {
  rc_retain_kind(value, rc_vector_element_cleanup_kind(elem_mode))
}

pub(package) fn vector_storage_load_value<T>(addr: i64, elem_size: i64, elem_mode: i64, default: T) -> T {
  if elem_size <= 0 { default } else {
    let w = __mem_load_sized(addr, elem_size, elem_mode)
    vector_storage_retain_for_mode(w, elem_mode)
    vector_storage_word_as<T>(w)
  }
}

pub(package) fn vector_storage_load_value_in_bounds<T>(addr: i64, elem_size: i64, elem_mode: i64) -> T {
  let w = __mem_load_sized(addr, elem_size, elem_mode)
  vector_storage_retain_for_mode(w, elem_mode)
  vector_storage_word_as<T>(w)
}

pub(package) fn vector_storage_store_value<T>(addr: i64, elem_size: i64, elem_mode: i64, value: T) -> i64 {
  if elem_size <= 0 { 0 }
  else {
    let w = vector_storage_word_from<T>(value)
    __mem_store_sized(addr, elem_size, elem_mode, w)
    vector_storage_retain_for_mode(w, elem_mode)
    0
  }
}

-- Releases the container's stake in the element at addr. No-op for
-- non-managed modes and for immediates/foreign pointers (the rc magic
-- bounds check rejects them).
pub(package) fn vector_storage_release_element(addr: i64, elem_mode: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> i64 {
  if leaf_count >= 0 {
    let mut i = 0
    let mut released = 0
    while i < leaf_count and leaf_stride > 0 {
      released = released + continuation_cleanup_release_value(leaf_kind, __mem_load64(addr + i * leaf_stride))
      i = i + 1
    }
    released
  } else {
    continuation_cleanup_release_value(rc_vector_element_cleanup_kind(elem_mode), __mem_load64(addr))
  }
}

-- Borrowed field read from a managed element slot: loads payload
-- `field` of the heap object whose pointer sits at addr, without
-- materialising an owned element reference. The container keeps the
-- element alive across the two loads (nothing user-visible runs in
-- between). Ownership of the RESULT is the caller's concern — see
-- vector_get_field_in_bounds, which retains managed payloads.
pub(package) fn vector_storage_field_word(addr: i64, field: i64) -> i64 {
  __mem_load64(__mem_load64(addr) + 8 + field * 8)
}

-- Ownership hook for the borrowed field read: managed payload words
-- become owned (+1) before crossing back into safe code.
pub(package) fn vector_storage_retain_word(w: i64) -> i64 {
  rc_default_retain(w)
}

