pub(package) fn vector_storage_word_set_data_capacity(word: i64, data: i64, cap: i64) -> i64 {
  __mem_store64(word + vector_storage_data_offset(), data)
  __mem_store64(word + vector_storage_capacity_offset(), cap)
  0
}

pub(package) fn vector_storage_word_set_len(word: i64, len: i64) -> i64 {
