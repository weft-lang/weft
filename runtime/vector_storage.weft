-- runtime/vector_storage.weft -- trusted raw storage bridge for stdlib/vector.

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/rc.{*}
use runtime/unsafe.{*}

pub(package) fn vector_storage_header_size() -> i64 { 64 }
pub(package) fn vector_storage_data_offset() -> i64 { 0 }
pub(package) fn vector_storage_len_offset() -> i64 { 8 }
pub(package) fn vector_storage_capacity_offset() -> i64 { 16 }
pub(package) fn vector_storage_element_size_offset() -> i64 { 24 }
pub(package) fn vector_storage_element_mode_offset() -> i64 { 32 }
pub(package) fn vector_storage_element_leaf_count_offset() -> i64 { 40 }
pub(package) fn vector_storage_element_leaf_stride_offset() -> i64 { 48 }
pub(package) fn vector_storage_element_leaf_kind_offset() -> i64 { 56 }

pub(package) fn vector_storage_word_mode() -> i64 { 0 }

-- Vector<T> is a sealed nominal machine-word handle. Only this trusted
-- storage bridge crosses between its public type identity and the raw RC
-- pointer used by the allocator and memory primitives.
pub(package) fn vector_storage_handle_from_word<T>(value: i64) -> owned Vector<T> {
  -- The raw rc local in vector_storage_new releases at function exit, so
  -- establish the typed result's stake before changing only static identity.
  rc_default_retain(value)
  handle unsafe_transmute<i64, owned Vector<T>>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn vector_storage_handle_word<T>(vec: borrow Vector<T>) -> i64 {
  -- Stable named calls lower directly to the transmute identity intrinsic.
  -- This fallback is unreachable in compiled stdlib code.
  0
}

-- Data buffers and their compiler-managed headers live on the default
-- managed heap. Growth returns abandoned buffers immediately; the RC
-- header's vector finalizer returns final storage and drops managed
-- elements when the last handle dies.
pub(package) fn vector_storage_alloc_bytes(n: i64) -> i64 {
  if n <= 0 { 0 } else { heap_alloc(rc_default_heap(), n, 8) }
}

pub(package) fn vector_storage_free_bytes(ptr: i64, n: i64) -> i64 {
  if ptr == 0 or n <= 0 { 0 } else { heap_free(rc_default_heap(), ptr, n) }
}

pub(package) fn vector_storage_new<T>(cap: i64, data_bytes: i64, elem_size: i64, elem_mode: i64, leaf_count: i64, leaf_stride: i64, leaf_kind: i64) -> owned Vector<T> {
  let header: rc i64 = rc_default_alloc_finalized(vector_storage_header_size(), 8, rc_finalizer_vector())
  let raw: i64 = header
  let data = vector_storage_alloc_bytes(data_bytes)
  __mem_store64(raw + vector_storage_data_offset(), data)
  __mem_store64(raw + vector_storage_len_offset(), 0)
  __mem_store64(raw + vector_storage_capacity_offset(), cap)
  __mem_store64(raw + vector_storage_element_size_offset(), elem_size)
  __mem_store64(raw + vector_storage_element_mode_offset(), elem_mode)
  __mem_store64(raw + vector_storage_element_leaf_count_offset(), leaf_count)
  __mem_store64(raw + vector_storage_element_leaf_stride_offset(), leaf_stride)
  __mem_store64(raw + vector_storage_element_leaf_kind_offset(), leaf_kind)
  vector_storage_handle_from_word<T>(raw)
}

-- Transfer one storage stake into private iterator state. The owned parameter
-- is still reclaimed by its ordinary Drop epilogue, so retain the raw word
-- before that epilogue releases the source stake; the iterator dropper later
-- releases the transferred stake exactly once.
pub(package) fn vector_storage_take_owned_word<T>(vec: owned Vector<T>) -> i64 {
  let word = vector_storage_handle_word<T>(vec)
  rc_default_retain(word)
  word
}

pub(package) fn vector_storage_release_word(word: i64) -> i64 {
  if word == 0 { 0 } else { rc_default_release(word) }
}

pub(package) fn vector_storage_word_len(word: i64) -> i64 {
  if word == 0 { 0 } else { __mem_load64(word + vector_storage_len_offset()) }
}

pub(package) fn vector_storage_word_capacity(word: i64) -> i64 {
