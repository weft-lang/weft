-- runtime/vector_storage.weft -- trusted raw storage bridge for stdlib/vector.

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/rc.{*}
use runtime/unsafe.{*}
use stdlib/num/scalar.{
  num_scalar_i64_to_usize,
  num_scalar_usize_checked_mul,
  num_scalar_usize_to_i64
}
use stdlib/option.{None, Option, Some}
use stdlib/vector/handles.{PersistentVector, PersistentVectorStorageRegion, Vector}

pub(package) fn vector_storage_header_size() -> i64 { 64 }

pub(package) fn vector_storage_data_offset() -> i64 { 0 }

pub(package) fn vector_storage_len_offset() -> i64 { 8 }

pub(package) fn vector_storage_capacity_offset() -> i64 { 16 }

pub(package) fn vector_storage_element_size_offset() -> i64 { 24 }

pub(package) fn vector_storage_element_mode_offset() -> i64 { 32 }

pub(package) fn vector_storage_element_leaf_count_offset() -> i64 { 40 }

pub(package) fn vector_storage_element_leaf_stride_offset() -> i64 { 48 }

pub(package) fn vector_storage_element_leaf_kind_offset() -> i64 { 56 }

pub(package) fn vector_storage_word_mode() -> i64 { 0 }

-- Vector<T> is a sealed nominal machine-word handle. Only this trusted
-- storage bridge crosses between its public type identity and the raw RC
-- pointer used by the allocator and memory primitives.
pub(package) fn vector_storage_handle_from_word<T>(value: i64) -> owned Vector<T> {
  -- The raw rc local in vector_storage_new releases at function exit, so
  -- establish the typed result's stake before changing only static identity.
  rc_default_retain(value)
  handle unsafe_transmute<i64, owned Vector<T>>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn vector_storage_handle_word<T>(vec: borrow Vector<T>) -> i64 {
  -- Stable named calls lower directly to the transmute identity intrinsic.
  -- This fallback is unreachable in compiled stdlib code.
  0
}

-- Data buffers and their compiler-managed headers live on the default
-- managed heap. Growth returns abandoned buffers immediately; the RC
-- header's vector finalizer returns final storage and drops managed
-- elements when the last handle dies.
pub(package) fn vector_storage_alloc_bytes(n: i64) -> i64 {
  if n <= 0 { 0 } else { heap_alloc(rc_default_heap(), n, 8) }
}

pub(package) fn vector_storage_free_bytes(ptr: i64, n: i64) -> i64 {
  if ptr == 0 or n <= 0 { 0 } else { heap_free(rc_default_heap(), ptr, n) }
}

pub(package) fn vector_storage_new<T>(
  cap: i64,
  data_bytes: i64,
  elem_size: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64
) -> owned Vector<T> {
  let header: rc i64 = rc_default_alloc_finalized(
    vector_storage_header_size(),
    8,
    rc_finalizer_vector()
  )
  let raw: i64 = header
  let data = vector_storage_alloc_bytes(data_bytes)
  __mem_store64(raw + vector_storage_data_offset(), data)
  __mem_store64(raw + vector_storage_len_offset(), 0)
  __mem_store64(raw + vector_storage_capacity_offset(), cap)
  __mem_store64(raw + vector_storage_element_size_offset(), elem_size)
  __mem_store64(raw + vector_storage_element_mode_offset(), elem_mode)
  __mem_store64(raw + vector_storage_element_leaf_count_offset(), leaf_count)
  __mem_store64(raw + vector_storage_element_leaf_stride_offset(), leaf_stride)
  __mem_store64(raw + vector_storage_element_leaf_kind_offset(), leaf_kind)
  vector_storage_handle_from_word<T>(raw)
}

-- Transfer one storage stake into private iterator state. The owned parameter
-- is still reclaimed by its ordinary Drop epilogue, so retain the raw word
-- before that epilogue releases the source stake; the iterator dropper later
-- releases the transferred stake exactly once.
pub(package) fn vector_storage_take_owned_word<T>(vec: owned Vector<T>) -> i64 {
  let word = vector_storage_handle_word<T>(vec)
  rc_default_retain(word)
  word
}

pub(package) fn vector_storage_release_word(word: i64) -> i64 {
  if word == 0 { 0 } else { rc_default_release(word) }
}

pub(package) fn vector_storage_word_len(word: i64) -> i64 {
  if word == 0 { 0 } else { __mem_load64(word + vector_storage_len_offset()) }
}

pub(package) fn vector_storage_word_capacity(word: i64) -> i64 {
  if word == 0 { 0 } else { __mem_load64(word + vector_storage_capacity_offset()) }
}

pub(package) fn vector_storage_word_data(word: i64) -> i64 {
  if word == 0 { 0 } else { __mem_load64(word + vector_storage_data_offset()) }
}

pub(package) fn vector_storage_word_element_size(word: i64) -> i64 {
  if word == 0 { 0 } else { __mem_load64(word + vector_storage_element_size_offset()) }
}

pub(package) fn vector_storage_word_element_mode(word: i64) -> i64 {
  if word == 0 { vector_storage_word_mode() }
  else { __mem_load64(word + vector_storage_element_mode_offset()) }
}

pub(package) fn vector_storage_word_element_leaf_count(word: i64) -> i64 {
  if word == 0 { 0 }
  else { __mem_load64(word + vector_storage_element_leaf_count_offset()) }
}

pub(package) fn vector_storage_word_element_leaf_stride(word: i64) -> i64 {
  if word == 0 { 0 }
  else { __mem_load64(word + vector_storage_element_leaf_stride_offset()) }
}

pub(package) fn vector_storage_word_element_leaf_kind(word: i64) -> i64 {
  if word == 0 { 0 }
  else { __mem_load64(word + vector_storage_element_leaf_kind_offset()) }
}

pub(package) fn vector_storage_word_set_data_capacity(word: i64, data: i64, cap: i64) -> i64 {
  __mem_store64(word + vector_storage_data_offset(), data)
  __mem_store64(word + vector_storage_capacity_offset(), cap)
  0
}

pub(package) fn vector_storage_word_set_len(word: i64, len: i64) -> i64 {
  __mem_store64(word + vector_storage_len_offset(), len)
  0
}

pub(package) fn vector_storage_word_load_in_bounds<T>(word: i64, index: i64) -> T {
  let data = __mem_load64(word + vector_storage_data_offset())
  let elem_size = __mem_load64(word + vector_storage_element_size_offset())
  let elem_mode = __mem_load64(word + vector_storage_element_mode_offset())
  vector_storage_load_value_in_bounds<T>(data + index * elem_size, elem_size, elem_mode)
}

pub(package) fn vector_storage_is_null<T>(vec: borrow Vector<T>) -> i64 {
  if vector_storage_handle_word<T>(vec) == 0 { 1 } else { 0 }
}

pub(package) fn vector_storage_promote<T>(vec: borrow mut Vector<T>) -> i64 {
  rc_default_promote_maybe(vector_storage_handle_word<T>(vec))
}

pub(package) fn vector_storage_is_promoted<T>(vec: borrow Vector<T>) -> i64 {
  rc_default_is_promoted_maybe(vector_storage_handle_word<T>(vec))
}

pub(package) fn vector_storage_len<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_len_offset()) }
}

pub(package) fn vector_storage_capacity<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_capacity_offset()) }
}

pub(package) fn vector_storage_data<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_data_offset()) }
}

--- Copy `count` bytes of `text`, starting at byte offset `start`, into a byte
--- vector's reserved capacity. The caller reserves first. The copy is refused
--- unless the source range lies within `text` and the reservation holds it, so
--- neither address leaves the trusted ring.
pub(package) fn vector_storage_append_text_bytes(
  values: borrow Vector<u8>,
  text: str,
  start: i64,
  count: i64
) -> bool {
  let word = vector_storage_handle_word<u8>(values)
  if word == 0 or start < 0 or count < 0 or start > __str_len(text) - count { false }
  else {
    let len = __mem_load64(word + vector_storage_len_offset())
    let capacity = __mem_load64(word + vector_storage_capacity_offset())
    if __mem_load64(word + vector_storage_element_size_offset()) != 1 or
      count > capacity - len { false }
    else {
      if count > 0 {
        mem_copy(
          __mem_load64(word + vector_storage_data_offset()) + len,
          __str_ptr(text) + start,
          count
        )
      } else { 0 }
      __mem_store64(word + vector_storage_len_offset(), len + count)
      true
    }
  }
}

pub(package) fn vector_storage_element_size<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_element_size_offset()) }
}

pub(package) fn vector_storage_element_mode<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { vector_storage_word_mode() } else {
    __mem_load64(raw + vector_storage_element_mode_offset())
  }
}

pub(package) fn vector_storage_element_leaf_count<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_element_leaf_count_offset()) }
}

pub(package) fn vector_storage_element_leaf_stride<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_element_leaf_stride_offset()) }
}

pub(package) fn vector_storage_element_leaf_kind<T>(vec: borrow Vector<T>) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + vector_storage_element_leaf_kind_offset()) }
}

pub(package) fn vector_storage_set_data_capacity<T>(
  vec: borrow mut Vector<T>,
  data: i64,
  cap: i64
) -> i64 {
  let raw = vector_storage_handle_word<T>(vec)
  __mem_store64(raw + vector_storage_data_offset(), data)
  __mem_store64(raw + vector_storage_capacity_offset(), cap)
  0
}

pub(package) fn vector_storage_set_len<T>(vec: borrow mut Vector<T>, len: i64) -> i64 {
  __mem_store64(vector_storage_handle_word<T>(vec) + vector_storage_len_offset(), len)
  0
}

pub(package) fn vector_storage_word_as<T>(value: i64) -> T {
  handle unsafe_transmute<i64, T>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn vector_storage_word_from<T>(value: T) -> i64 {
  handle unsafe_transmute<T, i64>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

-- Managed word elements: the container owns its elements.
-- Stores retain, element drops release, loads retain (call results are
-- owned — the caller's ownership machinery releases at lifetime end).
-- Compile-time twin: cg_layout_vector_managed_mode.
pub(package) fn vector_storage_managed_mode() -> i64 { 8 }

pub(package) fn vector_storage_closure_mode() -> i64 { 9 }

pub(package) fn vector_storage_weak_mode() -> i64 { 10 }

pub(package) fn vector_storage_retain_for_mode(value: i64, elem_mode: i64) -> i64 {
  rc_retain_kind(value, rc_vector_element_cleanup_kind(elem_mode))
}

pub(package) fn vector_storage_load_value<T>(
  addr: i64,
  elem_size: i64,
  elem_mode: i64,
  default: T
) -> T {
  if elem_size <= 0 { default } else {
    let w = __mem_load_sized(addr, elem_size, elem_mode)
    vector_storage_retain_for_mode(w, elem_mode)
    vector_storage_word_as<T>(w)
  }
}

pub(package) fn vector_storage_load_value_in_bounds<T>(
  addr: i64,
  elem_size: i64,
  elem_mode: i64
) -> T {
  let w = __mem_load_sized(addr, elem_size, elem_mode)
  vector_storage_retain_for_mode(w, elem_mode)
  vector_storage_word_as<T>(w)
}

pub(package) fn vector_storage_store_value<T>(
  addr: i64,
  elem_size: i64,
  elem_mode: i64,
  value: T
) -> i64 {
  if elem_size <= 0 { 0 }
  else {
    let w = vector_storage_word_from<T>(value)
    __mem_store_sized(addr, elem_size, elem_mode, w)
    vector_storage_retain_for_mode(w, elem_mode)
    0
  }
}

-- Releases the container's stake in the element at addr. No-op for
-- non-managed modes and for immediates/foreign pointers (the rc magic
-- bounds check rejects them).
pub(package) fn vector_storage_release_element(
  addr: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64
) -> i64 {
  if leaf_count >= 0 {
    let mut i = 0
    let mut released = 0
    while i < leaf_count and leaf_stride > 0 {
      released = released + continuation_cleanup_release_value(
        leaf_kind,
        __mem_load64(addr + i * leaf_stride)
      )
      i = i + 1
    }
    released
  } else {
    continuation_cleanup_release_value(
      rc_vector_element_cleanup_kind(elem_mode),
      __mem_load64(addr)
    )
  }
}

-- Borrowed field read from a managed element slot: loads payload
-- `field` of the heap object whose pointer sits at addr, without
-- materialising an owned element reference. The container keeps the
-- element alive across the two loads (nothing user-visible runs in
-- between). Ownership of the RESULT is the caller's concern — see
-- vector_get_field_in_bounds, which retains managed payloads.
pub(package) fn vector_storage_field_word(addr: i64, field: i64) -> i64 {
  __mem_load64(__mem_load64(addr) + 8 + field * 8)
}

-- Ownership hook for the borrowed field read: managed payload words
-- become owned (+1) before crossing back into safe code.
pub(package) fn vector_storage_retain_word(w: i64) -> i64 {
  rc_default_retain(w)
}

-- Typed vector storage operations. Package code names a vector by its
-- handle and elements by index; data addresses, header words and element
-- stakes stay inside this leaf.
-- A checked proof that a public count and element layout fit the private
-- signed storage representation. Keeping both values together prevents raw
-- storage code from repeating or weakening the multiplication check.
pub(package) type VectorStorageSize {
  VectorStorageSized(i64, i64),
  VectorStorageUnrepresentable
}

-- Growth either needs no mutation, carries exact old/new byte counts for one
-- resize, or rejects the request before touching storage.
pub(package) type VectorGrowth {
  VectorGrowthReady,
  VectorGrowthResize(i64, i64, i64),
  VectorGrowthUnrepresentable
}

pub(package) fn vector_storage_size(count: usize, elem_size: i64) -> VectorStorageSize {
  match num_scalar_usize_to_i64(count) {
    None -> VectorStorageUnrepresentable
    Some(capacity) -> match elem_size {
      size if size < 0 -> VectorStorageUnrepresentable
      0 -> VectorStorageSized(capacity, 0)
      size if capacity > 9223372036854775807 / size -> VectorStorageUnrepresentable
      size -> VectorStorageSized(capacity, capacity * size)
    }
  }
}

pub(package) fn vector_storage_size_i64(count: i64, elem_size: i64) -> VectorStorageSize {
  match num_scalar_i64_to_usize(count) {
    None -> VectorStorageUnrepresentable
    Some(unsigned) -> vector_storage_size(unsigned, elem_size)
  }
}

pub(package) fn vector_growth(current: i64, needed: usize, elem_size: i64) -> VectorGrowth {
  match num_scalar_i64_to_usize(current) {
    None -> VectorGrowthUnrepresentable
    Some(current_count) -> match vector_storage_size(current_count, elem_size) {
      VectorStorageUnrepresentable -> VectorGrowthUnrepresentable
      VectorStorageSized(_, current_bytes) -> if needed <= current_count {
        VectorGrowthReady
      } else {
        let one: usize = 1
        let mut candidate: usize = if current_count == 0 { one } else { current_count }
        let mut exact = false
        while candidate < needed and not exact {
          match num_scalar_usize_checked_mul(candidate, 2) {
            Some(doubled) -> { candidate = doubled }
            None -> {
              candidate = needed
              exact = true
            }
          }
        }
        match vector_storage_size(candidate, elem_size) {
          VectorStorageUnrepresentable -> if candidate == needed {
            VectorGrowthUnrepresentable
          } else {
            match vector_storage_size(needed, elem_size) {
              VectorStorageUnrepresentable -> VectorGrowthUnrepresentable
              VectorStorageSized(next_capacity, next_bytes) ->
                VectorGrowthResize(next_capacity, current_bytes, next_bytes)
            }
          }
          VectorStorageSized(next_capacity, next_bytes) ->
            VectorGrowthResize(next_capacity, current_bytes, next_bytes)
        }
      }
    }
  }
}

fn vector_storage_word_release_at(word: i64, address: i64) -> i64 {
  vector_storage_release_element(
    address,
    vector_storage_word_element_mode(word),
    vector_storage_word_element_leaf_count(word),
    vector_storage_word_element_leaf_stride(word),
    vector_storage_word_element_leaf_kind(word)
  )
}

fn vector_storage_word_reserve(word: i64, needed: usize) -> bool {
  if word == 0 { false }
  else {
    let cap = vector_storage_word_capacity(word)
    let elem_size = vector_storage_word_element_size(word)
    match vector_growth(cap, needed, elem_size) {
      VectorGrowthReady -> true
      VectorGrowthUnrepresentable -> false
      VectorGrowthResize(new_cap, old_bytes, new_bytes) -> {
        let len = vector_storage_word_len(word)
        match vector_storage_size_i64(len, elem_size) {
          VectorStorageUnrepresentable -> false
          VectorStorageSized(_, copy_bytes) -> if len > cap or copy_bytes > old_bytes {
            false
          } else {
            let old_data = vector_storage_word_data(word)
            let new_data = vector_storage_alloc_bytes(new_bytes)
            if old_data != 0 and new_data != 0 { mem_copy(new_data, old_data, copy_bytes) } else {
              0
            }
            -- Growth abandons the old buffer; element stakes moved with the
            -- copy, so the raw bytes go straight back to the heap. Valid
            -- positive allocations on the default heap are process-terminal
            -- on exhaustion, while zero-sized elements need no allocation.
            if new_bytes == 0 {
              vector_storage_word_set_data_capacity(word, 0, new_cap)
              true
            } else {
              if new_data != 0 {
                vector_storage_free_bytes(old_data, old_bytes)
                vector_storage_word_set_data_capacity(word, new_data, new_cap)
                true
              } else { false }
            }
          }
        }
      }
    }
  }
}

--- Ensure capacity for at least `needed` elements.
pub(package) fn vector_storage_reserve<T>(vec: borrow Vector<T>, needed: usize) -> bool {
  vector_storage_word_reserve(vector_storage_handle_word<T>(vec), needed)
}

-- The capacity check keeps a violated reservation from writing past
-- initialized storage without repeating growth work for every element.
fn vector_storage_word_push_reserved<T>(word: i64, value: T) -> bool {
  if word == 0 { false }
  else {
    let len = vector_storage_word_len(word)
    if len < 0 or len >= vector_storage_word_capacity(word) { false }
    else {
      let elem_size = vector_storage_word_element_size(word)
      vector_storage_store_value<T>(
        vector_storage_word_data(word) + len * elem_size,
        elem_size,
        vector_storage_word_element_mode(word),
        value
      )
      vector_storage_word_set_len(word, len + 1)
      true
    }
  }
}

--- Append one element, growing storage as needed.
pub(package) fn vector_storage_push<T>(vec: borrow Vector<T>, value: T) -> bool {
  let word = vector_storage_handle_word<T>(vec)
  if word == 0 { false }
  else {
    match num_scalar_i64_to_usize(vector_storage_word_len(word) + 1) {
      None -> false
      Some(needed) -> if vector_storage_word_reserve(word, needed) {
        vector_storage_word_push_reserved<T>(word, value)
      } else { false }
    }
  }
}

--- Append one element into capacity an enclosing batch already reserved.
pub(package) fn vector_storage_push_reserved<T>(vec: borrow Vector<T>, value: T) -> bool {
  vector_storage_word_push_reserved<T>(vector_storage_handle_word<T>(vec), value)
}

--- Read the element at `index`, which the caller keeps within the length.
pub(package) fn vector_storage_get_in_bounds<T>(vec: borrow Vector<T>, index: i64) -> T {
  let elem_size = vector_storage_element_size<T>(vec)
  vector_storage_load_value_in_bounds<T>(
    vector_storage_data<T>(vec) + index * elem_size,
    elem_size,
    vector_storage_element_mode<T>(vec)
  )
}

--- Read the element at `index`, or `default` for an empty element layout.
pub(package) fn vector_storage_get_or<T>(vec: borrow Vector<T>, index: i64, default: T) -> T {
  let elem_size = vector_storage_element_size<T>(vec)
  vector_storage_load_value<T>(
    vector_storage_data<T>(vec) + index * elem_size,
    elem_size,
    vector_storage_element_mode<T>(vec),
    default
  )
}

--- Read payload `field` of the managed element at `index` without an owned
--- element reference. `field_mode` is the field's element mode; managed
--- payloads are retained for the caller.
pub(package) fn vector_storage_get_field_in_bounds<T, F>(
  vec: borrow Vector<T>,
  index: i64,
  field: i64,
  field_mode: i64
) -> F {
  let w = vector_storage_field_word(
    vector_storage_data<T>(vec) + index * vector_storage_element_size<T>(vec),
    field
  )
  vector_storage_retain_for_mode(w, field_mode)
  vector_storage_word_as<F>(w)
}

--- Overwrite the element at `index`, dropping the container's stake in the
--- previous value. Out-of-range indices leave the vector unchanged.
pub(package) fn vector_storage_set<T>(vec: borrow Vector<T>, index: i64, value: T) -> bool {
  let word = vector_storage_handle_word<T>(vec)
  if index < 0 or index >= vector_storage_word_len(word) {
    false
  } else {
    let elem_size = vector_storage_word_element_size(word)
    let address = vector_storage_word_data(word) + index * elem_size
    -- Overwrite drops the container's stake in the old element before
    -- the store retains the new one under the managed-element contract.
    vector_storage_word_release_at(word, address)
    vector_storage_store_value<T>(
      address,
      elem_size,
      vector_storage_word_element_mode(word),
      value
    )
    true
  }
}

--- Replace the in-bounds element at `index` and return the previous value.
pub(package) fn vector_storage_replace<T>(vec: borrow Vector<T>, index: i64, value: T) -> T {
  let word = vector_storage_handle_word<T>(vec)
  let elem_size = vector_storage_word_element_size(word)
  let elem_mode = vector_storage_word_element_mode(word)
  let address = vector_storage_word_data(word) + index * elem_size
  let previous = vector_storage_load_value_in_bounds<T>(address, elem_size, elem_mode)
  vector_storage_word_release_at(word, address)
  vector_storage_store_value<T>(address, elem_size, elem_mode, value)
  previous
}

--- Remove and return the last element, or `None` when empty.
pub(package) fn vector_storage_pop<T>(vec: borrow Vector<T>) -> Option<T> {
  let word = vector_storage_handle_word<T>(vec)
  let len = vector_storage_word_len(word)
  if len <= 0 {
    None<T>()
  } else {
    let next_len = len - 1
    let elem_size = vector_storage_word_element_size(word)
    let address = vector_storage_word_data(word) + next_len * elem_size
    let value = vector_storage_load_value_in_bounds<T>(
      address,
      elem_size,
      vector_storage_word_element_mode(word)
    )
    vector_storage_word_set_len(word, next_len)
    -- Wrap first (the option constructor retains the payload), then drop
    -- the container's stake in the popped slot.
    let result = Some<T>(value)
    vector_storage_word_release_at(word, address)
    result
  }
}

--- Shorten to at most `requested` elements, releasing every removed stake.
pub(package) fn vector_storage_truncate<T>(vec: borrow Vector<T>, requested: i64) -> nil {
  let word = vector_storage_handle_word<T>(vec)
  if word == 0 { nil }
  else {
    let len = vector_storage_word_len(word)
    let target = if requested < 0 { 0 } else { if requested < len { requested } else { len } }
    let data = vector_storage_word_data(word)
    let elem_size = vector_storage_word_element_size(word)
    let mut index = len
    while index > target {
      index = index - 1
      vector_storage_word_release_at(word, data + index * elem_size)
    }
    vector_storage_word_set_len(word, target)
    nil
  }
}

--- Exchange two in-range elements. Invalid indices leave the vector unchanged.
pub(package) fn vector_storage_swap<T>(vec: borrow Vector<T>, left: i64, right: i64) -> bool {
  let word = vector_storage_handle_word<T>(vec)
  let len = vector_storage_word_len(word)
  if left < 0 or left >= len or right < 0 or right >= len { false }
  else {
    if left == right { true }
    else {
      let data = vector_storage_word_data(word)
      let elem_size = vector_storage_word_element_size(word)
      let elem_mode = vector_storage_word_element_mode(word)
      let left_addr = data + left * elem_size
      let right_addr = data + right * elem_size
      let a = vector_storage_load_value_in_bounds<T>(left_addr, elem_size, elem_mode)
      let b = vector_storage_load_value_in_bounds<T>(right_addr, elem_size, elem_mode)
      -- The owned temporaries keep both values alive while the vector gives up
      -- its old stakes; each replacement store then establishes the new stake.
      -- Without the releases, every managed swap leaked two references.
      vector_storage_word_release_at(word, left_addr)
      vector_storage_word_release_at(word, right_addr)
      vector_storage_store_value<T>(left_addr, elem_size, elem_mode, b)
      vector_storage_store_value<T>(right_addr, elem_size, elem_mode, a)
      true
    }
  }
}

pub(package) fn persistent_vector_storage_chunk_size() -> i64 { 32 }

pub(package) fn persistent_vector_storage_header_size() -> i64 { 80 }

pub(package) fn persistent_vector_storage_node_size() -> i64 { 256 }

pub(package) fn persistent_vector_storage_len_offset() -> i64 { 0 }

pub(package) fn persistent_vector_storage_element_size_offset() -> i64 { 8 }

pub(package) fn persistent_vector_storage_element_mode_offset() -> i64 { 16 }

pub(package) fn persistent_vector_storage_tree_count_offset() -> i64 { 24 }

pub(package) fn persistent_vector_storage_tree_depth_offset() -> i64 { 32 }

pub(package) fn persistent_vector_storage_tree_root_offset() -> i64 { 40 }

pub(package) fn persistent_vector_storage_tail_offset() -> i64 { 48 }

pub(package) fn persistent_vector_storage_element_leaf_count_offset() -> i64 { 56 }

pub(package) fn persistent_vector_storage_element_leaf_stride_offset() -> i64 { 64 }

pub(package) fn persistent_vector_storage_element_leaf_kind_offset() -> i64 { 72 }

pub(package) fn persistent_vector_storage_box_size() -> i64 { 16 }

pub(package) fn persistent_vector_storage_box_region_offset() -> i64 { 8 }

pub(package) fn persistent_vector_storage_box_region_mask() -> i64 { 4 }

pub(package) fn persistent_vector_storage_region_handle_from_owned_word(
  value: i64
) -> PersistentVectorStorageRegion {
  handle unsafe_transmute<i64, PersistentVectorStorageRegion>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn persistent_vector_storage_region_word(
  region: PersistentVectorStorageRegion
) -> i64 {
  handle unsafe_transmute<PersistentVectorStorageRegion, i64>(region) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn persistent_vector_storage_region_new() -> PersistentVectorStorageRegion {
  let region: rc i64 = rc_persistent_region_new()
  let raw: i64 = region
  rc_default_retain(raw)
  persistent_vector_storage_region_handle_from_owned_word(raw)
}

pub(package) fn persistent_vector_storage_handle_from_owned_word<T>(
  value: i64
) -> PersistentVector<T> {
  handle unsafe_transmute<i64, PersistentVector<T>>(value) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn persistent_vector_storage_handle_from_word<T>(value: i64) -> PersistentVector<T> {
  rc_default_retain(value)
  persistent_vector_storage_handle_from_owned_word<T>(value)
}

pub(package) fn persistent_vector_storage_handle_word<T>(vec: PersistentVector<T>) -> i64 {
  handle unsafe_transmute<PersistentVector<T>, i64>(vec) {
    Unsafe.transmute(raw) -> resume(__transmute(raw))
  }
}

pub(package) fn persistent_vector_storage_box<T>(root: i64, region: i64) -> PersistentVector<T> {
  -- Move the allocation's initial stake into the nominal result. Keeping an
  -- rc local here would make the transmuted result look like a second owner.
  let raw: i64 = rc_default_alloc(persistent_vector_storage_box_size(), 8)
  rc_set_field_mask_word(
    raw,
    persistent_vector_storage_box_size(),
    persistent_vector_storage_box_region_mask()
  )
  __mem_store64(raw, root)
  __mem_store64(raw + persistent_vector_storage_box_region_offset(), region)
  rc_default_retain(region)
  persistent_vector_storage_handle_from_owned_word<T>(raw)
}

pub(package) fn persistent_vector_storage_region<T>(vec: PersistentVector<T>) -> i64 {
  let raw = persistent_vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw + persistent_vector_storage_box_region_offset()) }
}

pub(package) fn persistent_vector_storage_make_root(
  region: i64,
  len: i64,
  elem_size: i64,
  elem_mode: i64,
  leaf_count: i64,
  leaf_stride: i64,
  leaf_kind: i64,
  tree_count: i64,
  tree_depth: i64,
  tree_root: i64,
  tail: i64
) -> i64 {
  let root = rc_persistent_region_alloc(region, persistent_vector_storage_header_size(), 8)
  __mem_store64(root + persistent_vector_storage_len_offset(), len)
  __mem_store64(root + persistent_vector_storage_element_size_offset(), elem_size)
  __mem_store64(root + persistent_vector_storage_element_mode_offset(), elem_mode)
  __mem_store64(root + persistent_vector_storage_element_leaf_count_offset(), leaf_count)
  __mem_store64(root + persistent_vector_storage_element_leaf_stride_offset(), leaf_stride)
  __mem_store64(root + persistent_vector_storage_element_leaf_kind_offset(), leaf_kind)
  __mem_store64(root + persistent_vector_storage_tree_count_offset(), tree_count)
  __mem_store64(root + persistent_vector_storage_tree_depth_offset(), tree_depth)
  __mem_store64(root + persistent_vector_storage_tree_root_offset(), tree_root)
  __mem_store64(root + persistent_vector_storage_tail_offset(), tail)
  root
}

pub(package) fn persistent_vector_storage_root<T>(vec: PersistentVector<T>) -> i64 {
  let raw = persistent_vector_storage_handle_word<T>(vec)
  if raw == 0 { 0 } else { __mem_load64(raw) }
}

pub(package) fn persistent_vector_storage_promote<T>(vec: PersistentVector<T>) -> i64 {
  rc_default_promote_maybe(persistent_vector_storage_handle_word<T>(vec))
}

pub(package) fn persistent_vector_storage_is_promoted<T>(vec: PersistentVector<T>) -> i64 {
  rc_default_is_promoted_maybe(persistent_vector_storage_handle_word<T>(vec))
}

pub(package) fn persistent_vector_storage_len(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_len_offset()) }
}

pub(package) fn persistent_vector_storage_element_size(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_element_size_offset()) }
}

pub(package) fn persistent_vector_storage_element_mode(root: i64) -> i64 {
  if root == 0 { vector_storage_word_mode() } else {
    __mem_load64(root + persistent_vector_storage_element_mode_offset())
  }
}

pub(package) fn persistent_vector_storage_element_leaf_count(root: i64) -> i64 {
  if root == 0 { 0 } else {
    __mem_load64(root + persistent_vector_storage_element_leaf_count_offset())
  }
}

pub(package) fn persistent_vector_storage_element_leaf_stride(root: i64) -> i64 {
  if root == 0 { 0 } else {
    __mem_load64(root + persistent_vector_storage_element_leaf_stride_offset())
  }
}

pub(package) fn persistent_vector_storage_element_leaf_kind(root: i64) -> i64 {
  if root == 0 { 0 } else {
    __mem_load64(root + persistent_vector_storage_element_leaf_kind_offset())
  }
}

pub(package) fn persistent_vector_storage_tree_count(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tree_count_offset()) }
}

pub(package) fn persistent_vector_storage_tree_depth(root: i64) -> i64 {
  if root == 0 { 0 } else { __mem_load64(root + persistent_vector_storage_tree_depth_offset()) }
