-- runtime/dir_standalone.weft -- sealed Darwin Dir installer for static tools
--
-- The ordinary runtime/dir.weft bridge uses libSystem and therefore selects
-- relocatable-object output. The self-hosted compiler must remain a standalone
-- executable, so its program boundary uses these direct Darwin syscalls.

use runtime/alloc.{*}
use runtime/memory.{*}
use runtime/string.{runtime_str_cstring, runtime_str_from_bytes_copy}
use runtime/syscall.{*}
use stdlib/dir.{*}
use stdlib/result.{*}
use stdlib/vector.{*}

pub(package) fn runtime_standalone_cstr_len(ptr: i64) -> i64 {
  let mut len = 0
  while mem_load8_at(ptr, len) != 0 { len = len + 1 }
  len
}

pub(package) fn runtime_standalone_dir_list(path: str) -> Result<Vector<str>, i64> {
  let mark = alloc_bump_mark()
  let raw_path = runtime_str_cstring(path)
  let fd = sys_open(raw_path, 0, 0)
  let result: Result<Vector<str>, i64> = if fd < 0 {
    result_err<Vector<str>, i64>(0 - fd)
  } else {
    let entries = vector_new<str>()
    let bytes = alloc_zeroed(16384)
    let base = alloc_zeroed(8)
    mem_store64_at(base, 0, 0)
    let mut done = 0
    let mut failure = 0
    while done == 0 {
      let count = sys_raw(344, fd, bytes, 16384, base, 0, 0)
      if count == 0 { done = 1 }
      else { if count < 0 {
        failure = 0 - count
        done = 1
      } else {
        let mut offset = 0
        while offset < count and failure == 0 {
          let entry = bytes + offset
          let record_len = mem_load8_at(entry, 16) + mem_load8_at(entry, 17) * 256
          let name_len = mem_load8_at(entry, 18) + mem_load8_at(entry, 19) * 256
          if record_len < 21 or offset + record_len > count or name_len + 21 > record_len {
            failure = 5
          } else {
            let name = entry + 21
            let is_dot = if name_len == 1 and mem_load8_at(name, 0) == 46 { 1 }
            else { if name_len == 2 and mem_load8_at(name, 0) == 46 and mem_load8_at(name, 1) == 46 { 1 } else { 0 } }
            if is_dot == 0 { vector_push<str>(entries, runtime_str_from_bytes_copy(name, name_len)) } else { 0 }
            offset = offset + record_len
          }
        }
      } }
    }
    sys_close(fd)
    if failure == 0 { result_ok<Vector<str>, i64>(entries) }
    else { result_err<Vector<str>, i64>(failure) }
  }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_standalone_dir_missing_metadata() -> DirMetadata {
  DirMetadata { exists: false, kind: DirOther, size: 0, modified_millis: 0, device: 0, inode: 0 }
}

pub(package) fn runtime_standalone_dir_stat(path: str) -> Result<DirMetadata, i64> {
  let mark = alloc_bump_mark()
  let raw_path = runtime_str_cstring(path)
  let stat_buf = alloc_zeroed(144)
  let status = sys_raw(338, raw_path, stat_buf, 0, 0, 0, 0)
  let result: Result<DirMetadata, i64> = if status == 0 {
    let mode = mem_load8_at(stat_buf, 4) + mem_load8_at(stat_buf, 5) * 256
    let kind = if (mode band 61440) == 32768 { DirFile }
    else { if (mode band 61440) == 16384 { DirDirectory } else { DirOther } }
    result_ok<DirMetadata, i64>(DirMetadata {
      exists: true,
      kind: kind,
      size: mem_load64_at(stat_buf, 96),
      modified_millis: mem_load64_at(stat_buf, 48) * 1000 + mem_load64_at(stat_buf, 56) / 1000000,
      device: mem_load8_at(stat_buf, 0) + mem_load8_at(stat_buf, 1) * 256 + mem_load8_at(stat_buf, 2) * 65536 + mem_load8_at(stat_buf, 3) * 16777216,
      inode: mem_load64_at(stat_buf, 8)
    })
  } else { if status == 0 - 2 {
    result_ok<DirMetadata, i64>(runtime_standalone_dir_missing_metadata())
  } else {
    result_err<DirMetadata, i64>(0 - status)
  } }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_standalone_dir_status_1(path: str, syscall: i64, arg: i64) -> i64 {
  let mark = alloc_bump_mark()
  let raw_path = runtime_str_cstring(path)
  let status = sys_raw(syscall, raw_path, arg, 0, 0, 0, 0)
  alloc_bump_restore_same_segment(mark)
  if status < 0 { 0 - status } else { status }
}

pub(package) fn runtime_standalone_dir_rename(from: str, to: str) -> i64 {
  let mark = alloc_bump_mark()
  let raw_from = runtime_str_cstring(from)
  let raw_to = runtime_str_cstring(to)
  let status = sys_raw(128, raw_from, raw_to, 0, 0, 0, 0)
  alloc_bump_restore_same_segment(mark)
  if status < 0 { 0 - status } else { status }
}

pub(package) fn runtime_standalone_dir_getcwd() -> Result<str, i64> {
  let mark = alloc_bump_mark()
  let capacity = 4096
  let bytes = alloc_zeroed(capacity)
  let status = sys_raw(326, bytes, capacity, 0, 0, 0, 0)
  let result: Result<str, i64> = if status < 0 { result_err<str, i64>(0 - status) }
  else { result_ok<str, i64>(runtime_str_from_bytes_copy(bytes, runtime_standalone_cstr_len(bytes))) }
  alloc_bump_restore_same_segment(mark)
  result
}

pub(package) fn runtime_standalone_dir(body: () -[Dir]> i64) -> i64 {
  handle body() {
    Dir.list(path) -> resume(runtime_standalone_dir_list(path))
    Dir.stat(path) -> resume(runtime_standalone_dir_stat(path))
    Dir.mkdir(path) -> resume(runtime_standalone_dir_status_1(path, 136, 493))
    Dir.remove(path) -> resume(runtime_standalone_dir_status_1(path, 10, 0))
    Dir.rename(from, to) -> resume(runtime_standalone_dir_rename(from, to))
    Dir.getcwd() -> resume(runtime_standalone_dir_getcwd())
  }
}
