-- runtime/alloc.weft -- allocation facade and mmap-backed arenas

use runtime/memory.{*}
use runtime/syscall.{*}
use runtime/unsafe.{*}

pub(package) effect Alloc {
  fn alloc(size: i64, align: i64) -> i64
  fn free(ptr: i64, size: i64) -> i64
}

pub(package) fn alloc_bump(size: i64) -> i64 {
  __bump_alloc(size)
}

pub(package) fn alloc_zeroed(size: i64) -> i64 {
  let p = alloc_bump(size)
  mem_zero(p, size)
  p
}

pub(package) fn alloc_words(words: i64) -> i64 {
  alloc_bump(words * 8)
}

pub(package) fn alloc_runtime_state_ptr() -> i64 {
  handle unsafe_runtime_state() {
    Unsafe.runtime_state() -> resume(__runtime_state())
  }
}

pub(package) fn alloc_bump_mark() -> i64 {
  let st = alloc_runtime_state_ptr()
  __mem_load64(st)
}

-- Compile-time twin: runtime_state_bump_base_offset in codegen.weft.
pub(package) fn alloc_bump_base_offset() -> i64 { 112 }

pub(package) fn alloc_bump_segment_base() -> i64 {
  let st = alloc_runtime_state_ptr()
  __mem_load64(st + alloc_bump_base_offset())
}

-- Apple Silicon VM page size. alloc_page_size() (4096) stays as the
-- arena size-rounding quantum; address-range VM operations must use the
-- real 16 KiB page.
pub(package) fn alloc_vm_page_size() -> i64 { 16384 }

-- Reclaimed spans at least this large release pages back to the OS
-- instead of being memset; below it a memset is cheaper than a syscall,
-- and the per-function optimiser restore loop re-touches its span
-- immediately (releasing there is fault churn, measured as a wall
-- outlier at a 128 KiB threshold and flat at 1 MiB — 2t).
pub(package) fn alloc_release_threshold() -> i64 { 1048576 }

pub(package) fn alloc_align_down(v: i64, align: i64) -> i64 { v / align * align }

-- Replace the page-aligned range [lo, hi) with fresh zero-fill pages:
-- MAP_FIXED anonymous mmap over our own mapping returns the RSS to the
-- OS immediately AND re-establishes the zero invariant without touching
-- a single page (an eager memset both forces the whole span resident
-- and dirties it). Deterministic: pure function of the request, no
-- reclaim-timing dependence (MADV_FREE-style advice leaves stale
-- contents visible until the kernel reclaims, which would break the
-- fresh-memory-is-zero invariant nondeterministically).
pub(package) fn alloc_release_zero_range(lo: i64, hi: i64) -> i64 {
  if hi > lo {
    let mapped = sys_remap_rw_anonymous_fixed(lo, hi - lo)
    if mapped == lo { 0 } else {
      -- MAP_FIXED refused (should not happen for our own mapping): the
      -- zero invariant must hold regardless, so fall back to memset.
      mem_zero(lo, hi - lo)
    }
  } else { 0 }
}

-- Zero [mark, current): small spans memset; large spans zero only the
-- sub-page head/tail fragments and remap the aligned interior.
pub(package) fn alloc_zero_reclaimed_span(mark: i64, current: i64) -> i64 {
  let span = current - mark
  if span >= alloc_release_threshold() {
    let lo = alloc_round_up(mark, alloc_vm_page_size())
    let hi = alloc_align_down(current, alloc_vm_page_size())
    if hi > lo {
      mem_zero(mark, lo - mark)
      mem_zero(hi, current - hi)
      alloc_release_zero_range(lo, hi)
    } else { mem_zero(mark, span) }
  } else { mem_zero(mark, span) }
}

pub(package) fn alloc_bump_restore_same_segment(mark: i64) -> i64 {
  let st = alloc_runtime_state_ptr()
  let base = __mem_load64(st + alloc_bump_base_offset())
  let current = __mem_load64(st)
  -- Same-segment proof must be EXACT: segments are disjoint mappings, so
  -- a mark inside [base, current] can only belong to the live segment.
  -- The old end-distance heuristic (end - mark <= 512MB) accepted marks
  -- from a PREVIOUS segment whenever a freshly chained segment happened
  -- to land within 512MB above them; the restore then zeroed across the
  -- inter-segment gap and rewound the bump pointer out of the live
  -- segment, and later bump allocations overwrote live structures (rc
  -- arena descriptors included). Layout-dependent heap corruption.
  if mark > 0 and mark >= base and mark <= current {
    -- Fresh bump memory is zero-filled (mmap); allocations may rely on it.
    -- Re-establish the memory-above-the-pointer-is-zero invariant on
    -- rollback so reused regions behave like a fresh process.
    if current > mark { alloc_zero_reclaimed_span(mark, current) } else { 0 }
    __mem_store64(st, mark)
  } else { 0 }
}

pub(package) fn alloc_round_up(size: i64, align: i64) -> i64 {
  if align <= 1 {
    size
  } else {
    let rem = size - size / align * align
    if rem == 0 { size } else { size + align - rem }
  }
}

pub(package) fn alloc_bump_rounded(size: i64, align: i64) -> i64 {
  alloc_bump(alloc_round_up(size, align))
}

pub(package) fn alloc_effect(size: i64, align: i64) -[Alloc]> i64 {
  Alloc.alloc(size, align)
}

pub(package) fn alloc_effect_zeroed(size: i64, align: i64) -[Alloc]> i64 {
  let p = Alloc.alloc(size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

pub(package) fn alloc_effect_words(words: i64) -[Alloc]> i64 {
  Alloc.alloc(words * 8, 8)
}

pub(package) fn alloc_effect_free(ptr: i64, size: i64) -[Alloc]> i64 {
  Alloc.free(ptr, size)
}

pub(package) fn alloc_page_size() -> i64 { 4096 }
-- Arena header layout:
-- [base(8), offset(8), capacity(8), mapped_len(8), previous(8)] = 40 bytes.
-- The descriptor lives at the HEAD OF ITS OWN MAPPING (data starts 64
-- bytes in), never in bump memory: arenas are created and grown from
-- inside bump mark/restore windows (optimiser scratch reclaim, probe
-- wrappers), and a bump-allocated descriptor created mid-window was
-- rewound over by the restore while the heap still pointed at it —
-- later bump allocations then overwrote the live descriptor
-- (layout-dependent heap corruption). Self-contained descriptors are
-- immune to any bump rollback by construction.
pub(package) fn arena_descriptor_reserve() -> i64 { 64 }

pub(package) fn arena_new(size: i64) -> i64 {
  let capacity = if size <= 0 { alloc_page_size() } else { size }
  let mapped_len = alloc_round_up(capacity + arena_descriptor_reserve(), alloc_page_size())
  let base = sys_map_rw_anonymous(0, mapped_len)
  if base <= 0 { 0 }
  else {
    let arena = base
    __mem_store64(arena, base + arena_descriptor_reserve())
    __mem_store64(arena + 8, 0)
    __mem_store64(arena + 16, capacity)
    __mem_store64(arena + 24, mapped_len)
    arena
  }
}

pub(package) fn arena_base(arena: i64) -> i64 { __mem_load64(arena) }
pub(package) fn arena_offset(arena: i64) -> i64 { __mem_load64(arena + 8) }
pub(package) fn arena_capacity(arena: i64) -> i64 { __mem_load64(arena + 16) }
pub(package) fn arena_mapped_len(arena: i64) -> i64 { __mem_load64(arena + 24) }
pub(package) fn arena_previous(arena: i64) -> i64 { if arena == 0 { 0 } else { __mem_load64(arena + 32) } }
pub(package) fn arena_set_previous(arena: i64, previous: i64) -> i64 {
  if arena == 0 { 0 } else { __mem_store64(arena + 32, previous) }
}
pub(package) fn arena_remaining(arena: i64) -> i64 { arena_capacity(arena) - arena_offset(arena) }

pub(package) fn arena_reset(arena: i64) -> i64 {
  __mem_store64(arena + 8, 0)
  arena
}

pub(package) fn arena_mark(arena: i64) -> i64 {
  if arena == 0 { 0 - 1 } else { arena_offset(arena) }
}

pub(package) fn arena_restore(arena: i64, mark: i64) -> i64 {
  if arena == 0 { 0 - 1 }
  else { if mark < 0 { 0 - 1 }
  else { if mark > arena_capacity(arena) { 0 - 1 }
  else {
    -- A cursor-only restore keeps every high-water page resident
    -- forever. Large reclaimed spans hand their aligned interior back
    -- to the OS (fresh zero pages on next touch); arena_alloc makes no
    -- zero promise, so the only observable change is lower RSS.
    let current = arena_offset(arena)
    if current > mark and current - mark >= alloc_release_threshold() {
      let data = arena_base(arena)
      let lo = alloc_round_up(data + mark, alloc_vm_page_size())
      let hi = alloc_align_down(data + current, alloc_vm_page_size())
      alloc_release_zero_range(lo, hi)
    } else { 0 }
    __mem_store64(arena + 8, mark)
    arena
  } } }
}

pub(package) fn arena_alloc(arena: i64, size: i64, align: i64) -> i64 {
  if arena == 0 { 0 }
  else {
    let offset = arena_offset(arena)
    let aligned = alloc_round_up(offset, align)
    let next = aligned + size
    if size < 0 { 0 }
    else { if next > arena_capacity(arena) { 0 }
    else {
      __mem_store64(arena + 8, next)
      arena_base(arena) + aligned
    } }
  }
}

pub(package) fn arena_alloc_zeroed(arena: i64, size: i64, align: i64) -> i64 {
  let p = arena_alloc(arena, size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

pub(package) fn arena_alloc_words(arena: i64, words: i64) -> i64 {
  arena_alloc(arena, words * 8, 8)
}

pub(package) fn arena_free(arena: i64) -> i64 {
  if arena == 0 { 0 - 1 }
  else {
    let mapped_len = arena_mapped_len(arena)
    if arena_base(arena) == 0 { 0 - 1 }
    else {
      -- The descriptor lives at the head of the mapping: unmapping the
      -- arena unmaps the descriptor with it. No field zeroing — the
      -- memory is gone and any later use of this arena pointer faults
      -- loudly instead of reading stale zeros.
      sys_munmap(arena, mapped_len)
    }
  }
}

-- Heap descriptor layout:
-- [arena(8), overflow_head(8), bins[33](264), mutation lock(8)] = 288 bytes.
-- Small blocks (16..256 bytes, 8-rounded) recycle through exact-size
-- bins: free pushes, alloc pops — O(1) either way, no scanning. Blocks
-- above the bin limit use the first-fit overflow list. Freed blocks
-- store [next(8), size(8)] in the block itself. Sizes are normalized to
-- 8-byte multiples so a bin holds exactly one size class.
pub(package) fn heap_min_block_size() -> i64 { 16 }
pub(package) fn heap_bin_limit() -> i64 { 256 }
pub(package) fn heap_lock_offset() -> i64 { 280 }
pub(package) fn heap_header_size() -> i64 { 288 }

pub(package) fn heap_lock(heap: i64) -> i64 {
  if heap == 0 { 0 } else { __atomic_lock64(heap + heap_lock_offset()) }
}

pub(package) fn heap_unlock(heap: i64) -> i64 {
  if heap == 0 { 0 } else { __atomic_unlock64(heap + heap_lock_offset()) }
}

pub(package) fn heap_normalized_size(size: i64) -> i64 {
  let rounded = (size + 7) / 8 * 8
  if rounded < heap_min_block_size() { heap_min_block_size() } else { rounded }
}

pub(package) fn heap_bin_cell(heap: i64, need: i64) -> i64 {
  heap + 16 + (need / 8) * 8
}

pub(package) fn alloc_is_aligned(ptr: i64, align: i64) -> bool {
  if align <= 1 { true }
  else {
    let rem = ptr - ptr / align * align
    rem == 0
  }
}

-- The heap header is carved from the heap's own arena for the same
-- rollback-immunity reason as the arena descriptor: heaps can be
-- created inside bump mark/restore windows. The arena is sized up by
-- the header so the caller's requested capacity stays fully usable.
pub(package) fn heap_new(size: i64) -> i64 {
  -- The header carve is rounded to 16 so user allocations start at the
  -- same alignment they had when data began at arena offset zero.
  let header_carve = alloc_round_up(heap_header_size(), 16)
  let arena = arena_new(size + header_carve)
  if arena == 0 { 0 }
  else {
    let heap = arena_alloc(arena, header_carve, 16)
    if heap == 0 { 0 }
    else {
      mem_zero(heap, heap_header_size())
      __mem_store64(heap, arena)
      heap
    }
  }
}

pub(package) fn heap_arena(heap: i64) -> i64 { __mem_load64(heap) }
pub(package) fn heap_free_head(heap: i64) -> i64 { __mem_load64(heap + 8) }
pub(package) fn heap_free_node_next(node: i64) -> i64 { __mem_load64(node) }
pub(package) fn heap_free_node_size(node: i64) -> i64 { __mem_load64(node + 8) }

pub(package) fn heap_bin_head(heap: i64, need: i64) -> i64 { __mem_load64(heap_bin_cell(heap, need)) }

pub(package) fn heap_capacity(heap: i64) -> i64 {
  if heap == 0 { 0 } else { arena_capacity(heap_arena(heap)) }
}

pub(package) fn heap_remaining(heap: i64) -> i64 {
  if heap == 0 { 0 } else { arena_remaining(heap_arena(heap)) }
}

-- Heap growth preserves every superseded arena: live objects and free-list
-- blocks may both still point into them. The current arena stays the fast
-- allocation path; validation falls back to this short geometric chain only
-- when a pointer misses the current arena's cached bounds.
pub(package) fn heap_contains_range(heap: i64, ptr: i64, size: i64) -> i64 {
  if heap == 0 or ptr == 0 or size < 0 { 0 }
  else {
    let range_end = ptr + size
    if range_end < ptr { 0 }
    else {
      let mut arena = heap_arena(heap)
      let mut found = 0
      while arena != 0 and found == 0 {
        let base = arena_base(arena)
        let end = base + arena_capacity(arena)
        if ptr >= base and range_end <= end { found = 1 }
        else { arena = arena_previous(arena) }
      }
      found
    }
  }
}

pub(package) fn heap_alloc_unlocked(heap: i64, size: i64, align: i64) -> i64 {
  if heap == 0 { 0 }
  else { if size < 0 { 0 }
  else {
    let need = heap_normalized_size(size)
    let binned = if need <= heap_bin_limit() and align <= 8 {
      let cell = heap_bin_cell(heap, need)
      let head = __mem_load64(cell)
      if head != 0 {
        __mem_store64(cell, heap_free_node_next(head))
        head
      } else { 0 }
    } else { 0 }
    if binned != 0 { binned }
    else {
    -- Overflow list scan is BEST-FIT: LIFO insertion puts the largest
    -- recently-freed block at the head, and first-fit shreds it into
    -- fragments for small requests, forcing arena bumps when the big
    -- request comes back around (doubling growth ladders hit this
    -- systematically). The list is short — bins absorb everything
    -- <= 256 bytes — so the full scan is cheap.
    let mut prev = 0
    let mut cur = heap_free_head(heap)
    let mut best = 0
    let mut best_prev = 0
    let mut best_size = 0
    while cur != 0 {
      let next = heap_free_node_next(cur)
      let available = heap_free_node_size(cur)
      if available >= need and alloc_is_aligned(cur, align) {
        let rem = available - need
        if rem == 0 or rem >= heap_min_block_size() {
          if best == 0 or available < best_size {
            best = cur
            best_prev = prev
            best_size = available
          } else { 0 }
        } else { 0 }
      } else { 0 }
      prev = cur
      cur = next
    }
    let result = if best != 0 {
      let rem = best_size - need
      let next = heap_free_node_next(best)
      let replacement = if rem == 0 { next } else {
        let split = best + need
        __mem_store64(split, next)
        __mem_store64(split + 8, rem)
        split
      }
      if best_prev == 0 {
        __mem_store64(heap + 8, replacement)
      } else {
        __mem_store64(best_prev, replacement)
      }
      best
    } else { 0 }
    if result != 0 { result } else {
      let direct = arena_alloc(heap_arena(heap), need, align)
      if direct != 0 { direct }
      else {
        -- Arena exhausted: chain a larger arena. Blocks in the old
        -- arena stay valid and freeable (the free list is
        -- address-based), so growth converts hard exhaustion into a
        -- bounded leak of the old arena's unused tail. If the OS
        -- refuses the new mapping, abort with a diagnostic — a null
        -- return here becomes a store through zero in safe code.
        let old_arena = heap_arena(heap)
        let old_cap = arena_capacity(old_arena)
        let doubled = if old_cap * 2 > need * 2 { old_cap * 2 } else { need * 2 }
        let grown = arena_new(doubled)
        if grown == 0 {
          sys_write(2, __str_ptr("weft: managed heap exhausted and arena growth failed\n"), __str_len("weft: managed heap exhausted and arena growth failed\n"))
          sys_exit(70)
          0
        } else {
          arena_set_previous(grown, old_arena)
          __mem_store64(heap, grown)
          -- If this is the DEFAULT rc heap, refresh the cached arena
          -- bounds the retain/release magic guard reads (runtime state
          -- offsets 8 = heap cell, 96/104 = bounds; rc.weft owns the
          -- offset names but cannot be imported from here).
          let st = alloc_runtime_state_ptr()
          if __mem_load64(st + 8) == heap {
            __mem_store64(st + 96, arena_base(grown))
            __mem_store64(st + 104, arena_base(grown) + arena_capacity(grown))
          } else { 0 }
          arena_alloc(grown, need, align)
        }
      }
    }
    }
  } }
}

pub(package) fn heap_alloc(heap: i64, size: i64, align: i64) -> i64 {
  if heap == 0 { 0 }
  else {
    heap_lock(heap)
    let result = heap_alloc_unlocked(heap, size, align)
    heap_unlock(heap)
    result
  }
}

pub(package) fn heap_alloc_zeroed(heap: i64, size: i64, align: i64) -> i64 {
  let p = heap_alloc(heap, size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

pub(package) fn heap_alloc_words(heap: i64, words: i64) -> i64 {
  heap_alloc(heap, words * 8, 8)
}

pub(package) fn heap_free_unlocked(heap: i64, ptr: i64, size: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if ptr == 0 { 0 - 1 }
  else { if size < 0 { 0 - 1 }
  else {
    let node_size = heap_normalized_size(size)
    if node_size <= heap_bin_limit() {
      let cell = heap_bin_cell(heap, node_size)
      __mem_store64(ptr, __mem_load64(cell))
      __mem_store64(ptr + 8, node_size)
      __mem_store64(cell, ptr)
    } else {
      __mem_store64(ptr, heap_free_head(heap))
      __mem_store64(ptr + 8, node_size)
      __mem_store64(heap + 8, ptr)
    }
    0
  } } }
}

pub(package) fn heap_free(heap: i64, ptr: i64, size: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else {
    heap_lock(heap)
    let result = heap_free_unlocked(heap, ptr, size)
    heap_unlock(heap)
    result
  }
}

pub(package) fn heap_destroy(heap: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else {
    -- The header lives inside the oldest arena mapping. Read each predecessor
    -- before unmapping the current descriptor; the final unmap also destroys
    -- the heap header itself.
    let mut arena = heap_arena(heap)
    while arena != 0 {
      let previous = arena_previous(arena)
      arena_free(arena)
      arena = previous
    }
    0
  }
}

pub(package) fn with_arena_alloc(arena: i64, f: () -[Alloc]> i64) -> i64 {
  with_arena_alloc_value<i64>(arena, f)
}

pub(package) fn with_arena_alloc_value<T>(arena: i64, f: () -[Alloc]> T) -> T {
  handle f() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
    Alloc.free(ptr, size) -> resume(0)
  }
}

pub(package) fn with_scoped_arena_alloc(arena: i64, f: () -[Alloc]> i64) -> i64 {
  with_scoped_arena_alloc_value<i64>(arena, f)
}

pub(package) fn with_scoped_arena_alloc_value<T>(arena: i64, f: () -[Alloc]> T) -> T {
  let mark = arena_mark(arena)
  let result = handle f() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
    Alloc.free(ptr, size) -> resume(0)
  }
  if mark < 0 { 0 } else { arena_restore(arena, mark) }
  result
}

pub(package) fn with_heap_alloc(heap: i64, f: () -[Alloc]> i64) -> i64 {
  with_heap_alloc_value<i64>(heap, f)
}

pub(package) fn with_heap_alloc_value<T>(heap: i64, f: () -[Alloc]> T) -> T {
  handle f() {
    Alloc.alloc(size, align) -> resume(heap_alloc(heap, size, align))
    Alloc.free(ptr, size) -> resume(heap_free(heap, ptr, size))
  }
}
