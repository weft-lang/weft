-- runtime/alloc.weft -- allocation facade over the trusted bump intrinsic

use "runtime/memory.weft"

fn alloc_bump(size: i64) -> i64 {
  __bump_alloc(size)
}

fn alloc_zeroed(size: i64) -> i64 {
  let p = alloc_bump(size)
  mem_zero(p, size)
  p
}

fn alloc_words(words: i64) -> i64 {
  alloc_bump(words * 8)
}

fn alloc_round_up(size: i64, align: i64) -> i64 {
  if align <= 1 {
    size
  } else {
    let rem = size - size / align * align
    if rem == 0 { size } else { size + align - rem }
  }
}

fn alloc_bump_rounded(size: i64, align: i64) -> i64 {
  alloc_bump(alloc_round_up(size, align))
}
