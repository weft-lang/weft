-- runtime/alloc.weft -- allocation facade and mmap-backed arenas

use "runtime/memory.weft"
use "runtime/syscall.weft"

effect Alloc {
  fn alloc(size: i64, align: i64) -> i64
  fn free(ptr: i64, size: i64) -> i64
}

fn alloc_bump(size: i64) -> i64 {
  __bump_alloc(size)
}

fn alloc_zeroed(size: i64) -> i64 {
  let p = alloc_bump(size)
  mem_zero(p, size)
  p
}

fn alloc_words(words: i64) -> i64 {
  alloc_bump(words * 8)
}

fn alloc_round_up(size: i64, align: i64) -> i64 {
  if align <= 1 {
    size
  } else {
    let rem = size - size / align * align
    if rem == 0 { size } else { size + align - rem }
  }
}

fn alloc_bump_rounded(size: i64, align: i64) -> i64 {
  alloc_bump(alloc_round_up(size, align))
}

fn alloc_effect(size: i64, align: i64) -[Alloc]> i64 {
  Alloc.alloc(size, align)
}

fn alloc_effect_zeroed(size: i64, align: i64) -[Alloc]> i64 {
  let p = Alloc.alloc(size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

fn alloc_effect_words(words: i64) -[Alloc]> i64 {
  Alloc.alloc(words * 8, 8)
}

fn alloc_effect_free(ptr: i64, size: i64) -[Alloc]> i64 {
  Alloc.free(ptr, size)
}

fn alloc_page_size() -> i64 { 4096 }
fn alloc_mmap_prot_rw() -> i64 { 3 }
fn alloc_mmap_flags_private_anon() -> i64 { 4098 }

-- Arena header layout:
-- [base(8), offset(8), capacity(8), mapped_len(8)] = 32 bytes.
fn arena_new(size: i64) -> i64 {
  let capacity = if size <= 0 { alloc_page_size() } else { size }
  let mapped_len = alloc_round_up(capacity, alloc_page_size())
  let base = sys_mmap(0, mapped_len, alloc_mmap_prot_rw(), alloc_mmap_flags_private_anon(), 0 - 1, 0)
  if base <= 0 { 0 }
  else {
    let arena = alloc_bump(32)
    __mem_store64(arena, base)
    __mem_store64(arena + 8, 0)
    __mem_store64(arena + 16, capacity)
    __mem_store64(arena + 24, mapped_len)
    arena
  }
}

fn arena_base(arena: i64) -> i64 { __mem_load64(arena) }
fn arena_offset(arena: i64) -> i64 { __mem_load64(arena + 8) }
fn arena_capacity(arena: i64) -> i64 { __mem_load64(arena + 16) }
fn arena_mapped_len(arena: i64) -> i64 { __mem_load64(arena + 24) }
fn arena_remaining(arena: i64) -> i64 { arena_capacity(arena) - arena_offset(arena) }

fn arena_reset(arena: i64) -> i64 {
  __mem_store64(arena + 8, 0)
  arena
}

fn arena_mark(arena: i64) -> i64 {
  if arena == 0 { 0 - 1 } else { arena_offset(arena) }
}

fn arena_restore(arena: i64, mark: i64) -> i64 {
  if arena == 0 { 0 - 1 }
  else { if mark < 0 { 0 - 1 }
  else { if mark > arena_capacity(arena) { 0 - 1 }
  else {
    __mem_store64(arena + 8, mark)
    arena
  } } }
}

fn arena_alloc(arena: i64, size: i64, align: i64) -> i64 {
  if arena == 0 { 0 }
  else {
    let offset = arena_offset(arena)
    let aligned = alloc_round_up(offset, align)
    let next = aligned + size
    if size < 0 { 0 }
    else { if next > arena_capacity(arena) { 0 }
    else {
      __mem_store64(arena + 8, next)
      arena_base(arena) + aligned
    } }
  }
}

fn arena_alloc_zeroed(arena: i64, size: i64, align: i64) -> i64 {
  let p = arena_alloc(arena, size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

fn arena_alloc_words(arena: i64, words: i64) -> i64 {
  arena_alloc(arena, words * 8, 8)
}

fn arena_free(arena: i64) -> i64 {
  if arena == 0 { 0 - 1 }
  else {
    let base = arena_base(arena)
    let mapped_len = arena_mapped_len(arena)
    if base == 0 { 0 - 1 }
    else {
      let result = sys_munmap(base, mapped_len)
      __mem_store64(arena, 0)
      __mem_store64(arena + 8, 0)
      __mem_store64(arena + 16, 0)
      __mem_store64(arena + 24, 0)
      result
    }
  }
}

-- Heap descriptor layout:
-- [arena(8), free_head(8)] = 16 bytes.
-- Freed blocks store [next(8), size(8)] in the block itself.
fn heap_min_block_size() -> i64 { 16 }

fn heap_normalized_size(size: i64) -> i64 {
  if size < heap_min_block_size() { heap_min_block_size() } else { size }
}

fn alloc_is_aligned(ptr: i64, align: i64) -> bool {
  if align <= 1 { true }
  else {
    let rem = ptr - ptr / align * align
    rem == 0
  }
}

fn heap_new(size: i64) -> i64 {
  let arena = arena_new(size)
  if arena == 0 { 0 }
  else {
    let heap = alloc_bump(16)
    __mem_store64(heap, arena)
    __mem_store64(heap + 8, 0)
    heap
  }
}

fn heap_arena(heap: i64) -> i64 { __mem_load64(heap) }
fn heap_free_head(heap: i64) -> i64 { __mem_load64(heap + 8) }
fn heap_free_node_next(node: i64) -> i64 { __mem_load64(node) }
fn heap_free_node_size(node: i64) -> i64 { __mem_load64(node + 8) }

fn heap_capacity(heap: i64) -> i64 {
  if heap == 0 { 0 } else { arena_capacity(heap_arena(heap)) }
}

fn heap_remaining(heap: i64) -> i64 {
  if heap == 0 { 0 } else { arena_remaining(heap_arena(heap)) }
}

fn heap_alloc(heap: i64, size: i64, align: i64) -> i64 {
  if heap == 0 { 0 }
  else { if size < 0 { 0 }
  else {
    let need = heap_normalized_size(size)
    let mut prev = 0
    let mut cur = heap_free_head(heap)
    let mut result = 0
    while cur != 0 {
      let next = heap_free_node_next(cur)
      let available = heap_free_node_size(cur)
      if available >= need {
        if alloc_is_aligned(cur, align) {
          if prev == 0 {
            __mem_store64(heap + 8, next)
          } else {
            __mem_store64(prev, next)
          }
          result = cur
          cur = 0
        } else {
          prev = cur
          cur = next
        }
      } else {
        prev = cur
        cur = next
      }
    }
    if result != 0 { result } else { arena_alloc(heap_arena(heap), need, align) }
  } }
}

fn heap_alloc_zeroed(heap: i64, size: i64, align: i64) -> i64 {
  let p = heap_alloc(heap, size, align)
  if p != 0 { mem_zero(p, size) } else { 0 }
  p
}

fn heap_alloc_words(heap: i64, words: i64) -> i64 {
  heap_alloc(heap, words * 8, 8)
}

fn heap_free(heap: i64, ptr: i64, size: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else { if ptr == 0 { 0 - 1 }
  else { if size < 0 { 0 - 1 }
  else {
    let node_size = heap_normalized_size(size)
    __mem_store64(ptr, heap_free_head(heap))
    __mem_store64(ptr + 8, node_size)
    __mem_store64(heap + 8, ptr)
    0
  } } }
}

fn heap_destroy(heap: i64) -> i64 {
  if heap == 0 { 0 - 1 }
  else {
    let arena = heap_arena(heap)
    let result = arena_free(arena)
    __mem_store64(heap, 0)
    __mem_store64(heap + 8, 0)
    result
  }
}

fn with_arena_alloc(arena: i64, f: () -[Alloc]> i64) -> i64 {
  with_arena_alloc_value<i64>(arena, f)
}

fn with_arena_alloc_value<T>(arena: i64, f: () -[Alloc]> T) -> T {
  handle f() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
    Alloc.free(ptr, size) -> resume(0)
  }
}

fn with_scoped_arena_alloc(arena: i64, f: () -[Alloc]> i64) -> i64 {
  with_scoped_arena_alloc_value<i64>(arena, f)
}

fn with_scoped_arena_alloc_value<T>(arena: i64, f: () -[Alloc]> T) -> T {
  let mark = arena_mark(arena)
  let result = handle f() {
    Alloc.alloc(size, align) -> resume(arena_alloc(arena, size, align))
    Alloc.free(ptr, size) -> resume(0)
  }
  if mark < 0 { 0 } else { arena_restore(arena, mark) }
  result
}

fn with_heap_alloc(heap: i64, f: () -[Alloc]> i64) -> i64 {
  with_heap_alloc_value<i64>(heap, f)
}

fn with_heap_alloc_value<T>(heap: i64, f: () -[Alloc]> T) -> T {
  handle f() {
    Alloc.alloc(size, align) -> resume(heap_alloc(heap, size, align))
    Alloc.free(ptr, size) -> resume(heap_free(heap, ptr, size))
  }
}
