-- runtime/safe_env.weft — production process-environment interpretation
--
-- Raw startup pointers remain inside runtime/env. Applications retain the
-- canonical mockable Env effect and receive managed optional strings only.

use runtime/env as runtime_env_handler
use stdlib/env.{Env}

pub fn runtime_platform_env(argc: i64, argv: i64, body: () -[Env]> i64) -> i64 {
  with runtime_env_handler(argc, argv) { body() }
}

pub fn runtime_platform_env_with<E>(argc: i64, argv: i64, body: () -[Env, E]> i64) -[E]> i64 {
  with runtime_env_handler(argc, argv) { body() }
}
