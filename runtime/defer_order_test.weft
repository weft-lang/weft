-- Trusted helper surface for defer-order tests that need raw logging cells.

use "runtime/alloc.weft"

trait Drop {
  fn drop(self: i64) -> i64
}

type OwnedDropToken {
  log: i64
}

impl Drop for OwnedDropToken {
  fn drop(self: i64) -> i64 {
    let log = __mem_load64(self)
    __mem_store64(log, __mem_load64(log) * 10 + 2)
    0
  }
}

fn owned_drop_token_new(log: i64) -> owned OwnedDropToken {
  OwnedDropToken { log: log }
}

fn owned_drop_token_consume(token: owned OwnedDropToken) -> i64 {
  0
}

fn defer_order_body_result() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  {
    defer __mem_store64(log, 7)
    42
  }
}

fn defer_order_body_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, 7)
    42
  }
  __mem_load64(log)
}

fn defer_order_lifo_result() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  {
    defer __mem_store64(log, __mem_load64(log) * 10 + 1)
    defer __mem_store64(log, __mem_load64(log) * 10 + 2)
    __mem_store64(log, 3)
    99
  }
}

fn defer_order_lifo_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 1)
    defer __mem_store64(log, __mem_load64(log) * 10 + 2)
    __mem_store64(log, 3)
    99
  }
  __mem_load64(log)
}

fn defer_order_tail_scope_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let ignored = {
    defer __mem_store64(log, 5)
  }
  __mem_load64(log)
}

fn defer_order_return_helper(log: i64) -> i64 {
  defer __mem_store64(log, __mem_load64(log) * 10 + 4)
  return 88
}

fn defer_order_return_result() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  defer_order_return_helper(log)
}

fn defer_order_return_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = defer_order_return_helper(log)
  __mem_load64(log)
}

fn defer_order_break_result() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  {
    defer __mem_store64(log, __mem_load64(log) * 10 + 9)
    while true {
      defer __mem_store64(log, __mem_load64(log) * 10 + 1)
      break
    }
    __mem_load64(log)
  }
}

fn defer_order_break_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 9)
    while true {
      defer __mem_store64(log, __mem_load64(log) * 10 + 1)
      break
    }
    __mem_load64(log)
  }
  __mem_load64(log)
}

fn defer_order_continue_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let mut i = 0
  while i < 3 {
    i = i + 1
    defer __mem_store64(log, __mem_load64(log) + 1)
    if i < 3 { continue } else { 0 }
  }
  __mem_load64(log)
}

fn defer_before_owned_drop_order_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    defer __mem_store64(log, __mem_load64(log) * 10 + 1)
    let token: owned OwnedDropToken = owned_drop_token_new(log)
    0
  }
  __mem_load64(log)
}

fn owned_drop_after_move_runs_once_log() -> i64 {
  let log = alloc_bump(8)
  __mem_store64(log, 0)
  let got = {
    let token: owned OwnedDropToken = owned_drop_token_new(log)
    owned_drop_token_consume(token)
  }
  __mem_load64(log)
}
