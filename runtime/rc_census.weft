-- runtime/rc_census.weft -- measurement-only reclamation census reporter
--
-- This trusted leaf is parsed only for `weft compile --rc-census`. Ordinary
-- programs neither contain it nor reserve the counter tail. Compiler twin:
-- runtime_state_rc_census_* in compiler/codegen.weft.

use runtime/alloc.{alloc_bump, alloc_runtime_shared_state_ptr}
use runtime/memory.{*}
use runtime/syscall.{sys_write}

pub(package) fn rc_census_base_offset() -> i64 { 208 }
pub(package) fn rc_census_event_count() -> i64 { 39 }

pub(package) fn rc_census_runtime_state() -> i64 {
  alloc_runtime_shared_state_ptr()
}

pub(package) fn rc_census_value(state: i64, event: i64) -> i64 {
  if state == 0 or event < 0 or event >= rc_census_event_count() { 0 }
  else { __mem_load64(state + rc_census_base_offset() + event * 8) }
}

pub(package) fn rc_census_write(text: str) -> i64 {
  sys_write(2, __str_ptr(text), __str_len(text))
}

pub(package) fn rc_census_write_i64(value: i64) -> i64 {
  if value <= 0 { rc_census_write("0") }
  else {
    -- The reporter runs after main and its scratch is bump-owned. Census
    -- events cover managed/region RC helpers, not raw bump reservations, so
    -- formatting cannot perturb the vector it is reporting.
    let digits = alloc_bump(32)
    let mut cursor = 32
    let mut remaining = value
    while remaining > 0 {
      cursor = cursor - 1
      __mem_store8(digits + cursor, 48 + remaining % 10)
      remaining = remaining / 10
    }
    sys_write(2, digits + cursor, 32 - cursor)
  }
}

pub(package) fn rc_census_write_field(state: i64, event: i64) -> i64 {
  rc_census_write(" ")
  rc_census_write_i64(rc_census_value(state, event))
}

pub(package) fn rc_census_report_human(state: i64) -> i64 {
  rc_census_write("rc census: default_alloc=") rc_census_write_i64(rc_census_value(state, 0))
  rc_census_write(" default_retain=") rc_census_write_i64(rc_census_value(state, 1))
  rc_census_write(" default_release=") rc_census_write_i64(rc_census_value(state, 2))
  rc_census_write(" deep_release_child=") rc_census_write_i64(rc_census_value(state, 3))
  rc_census_write(" promoted_retain=") rc_census_write_i64(rc_census_value(state, 4))
  rc_census_write(" promoted_release=") rc_census_write_i64(rc_census_value(state, 5))
  rc_census_write(" closure_retain=") rc_census_write_i64(rc_census_value(state, 6))
  rc_census_write(" closure_release=") rc_census_write_i64(rc_census_value(state, 7))
  rc_census_write(" closure_promoted_release=") rc_census_write_i64(rc_census_value(state, 8))
  rc_census_write(" weak_retain=") rc_census_write_i64(rc_census_value(state, 9))
  rc_census_write(" weak_release=") rc_census_write_i64(rc_census_value(state, 10))
  rc_census_write(" weak_load=") rc_census_write_i64(rc_census_value(state, 11))
  rc_census_write(" region_alloc=") rc_census_write_i64(rc_census_value(state, 12))
  rc_census_write(" promotions=") rc_census_write_i64(rc_census_value(state, 13))
  rc_census_write(" call_param_owned_lanes=") rc_census_write_i64(rc_census_value(state, 14))
  rc_census_write(" call_param_borrowed_lanes=") rc_census_write_i64(rc_census_value(state, 15))
  rc_census_write(" reuse_drop_attempts=") rc_census_write_i64(rc_census_value(state, 16))
  rc_census_write(" reuse_alloc_sites=") rc_census_write_i64(rc_census_value(state, 17))
  rc_census_write(" reuse_hits=") rc_census_write_i64(rc_census_value(state, 18))
  rc_census_write(" managed_retain=") rc_census_write_i64(rc_census_value(state, 19))
  rc_census_write(" managed_release=") rc_census_write_i64(rc_census_value(state, 20))
  rc_census_write(" origin_unknown_retain=") rc_census_write_i64(rc_census_value(state, 21))
  rc_census_write(" origin_unknown_release=") rc_census_write_i64(rc_census_value(state, 22))
  rc_census_write(" origin_result_transfer_retain=") rc_census_write_i64(rc_census_value(state, 23))
  rc_census_write(" origin_result_transfer_release=") rc_census_write_i64(rc_census_value(state, 24))
  rc_census_write(" origin_call_transport_retain=") rc_census_write_i64(rc_census_value(state, 25))
  rc_census_write(" origin_call_transport_release=") rc_census_write_i64(rc_census_value(state, 26))
  rc_census_write(" origin_binding_retain=") rc_census_write_i64(rc_census_value(state, 27))
  rc_census_write(" origin_binding_release=") rc_census_write_i64(rc_census_value(state, 28))
  rc_census_write(" origin_aggregate_retain=") rc_census_write_i64(rc_census_value(state, 29))
  rc_census_write(" origin_aggregate_release=") rc_census_write_i64(rc_census_value(state, 30))
  rc_census_write(" origin_arm_normalization_retain=") rc_census_write_i64(rc_census_value(state, 31))
  rc_census_write(" origin_arm_normalization_release=") rc_census_write_i64(rc_census_value(state, 32))
  rc_census_write(" origin_discard_retain=") rc_census_write_i64(rc_census_value(state, 33))
  rc_census_write(" origin_discard_release=") rc_census_write_i64(rc_census_value(state, 34))
  rc_census_write(" origin_cleanup_retain=") rc_census_write_i64(rc_census_value(state, 35))
  rc_census_write(" origin_cleanup_release=") rc_census_write_i64(rc_census_value(state, 36))
  rc_census_write(" origin_control_retain=") rc_census_write_i64(rc_census_value(state, 37))
  rc_census_write(" origin_control_release=") rc_census_write_i64(rc_census_value(state, 38))
  rc_census_write("\n")
}

-- Versioned positional schema:
-- default_alloc, default_retain, default_release, deep_release_child,
-- promoted_retain, promoted_release, closure_retain, closure_release,
-- closure_promoted_release, weak_retain, weak_release, weak_load,
-- region_alloc, promotions, call_param_owned_lanes,
-- call_param_borrowed_lanes, reuse_drop_attempts, reuse_alloc_sites,
-- reuse_hits, managed_retain, managed_release, then retain/release pairs for
-- unknown, result_transfer, call_transport, binding, aggregate,
-- arm_normalization, discard, cleanup, and control origins.
pub(package) fn rc_census_report() -> i64 {
  let state = rc_census_runtime_state()
  rc_census_write("WEFT_RC_CENSUS 5")
  for event in 0..rc_census_event_count() { rc_census_write_field(state, event) }
  rc_census_write("\n")
  rc_census_report_human(state)
  0
}
