-- runtime/dir_syscall.weft -- sealed libSystem filesystem leaves
--
-- This module is deliberately separate from runtime/syscall.weft: that module
-- sits on the universal runtime import path, while these GOT references must
-- only make programs using Dir switch to linked-object emission.

use runtime/unsafe.{*}

pub(package) fn sys_opendir(path: i64) -[Unsafe]> i64 {
  __got_opendir(path, 0, 0, 0, 0, 0)
}

pub(package) fn sys_readdir(dir: i64) -[Unsafe]> i64 {
  __got_readdir(dir, 0, 0, 0, 0, 0)
}

pub(package) fn sys_closedir(dir: i64) -[Unsafe]> i64 {
  __got_closedir(dir, 0, 0, 0, 0, 0)
}

pub(package) fn sys_stat(path: i64, stat_buf: i64) -[Unsafe]> i64 {
  __got_stat(path, stat_buf, 0, 0, 0, 0)
}

pub(package) fn sys_mkdir(path: i64, mode: i64) -[Unsafe]> i64 {
  __got_mkdir(path, mode, 0, 0, 0, 0)
}

pub(package) fn sys_remove(path: i64) -[Unsafe]> i64 {
  __got_remove(path, 0, 0, 0, 0, 0)
}

pub(package) fn sys_rename(from: i64, to: i64) -[Unsafe]> i64 {
  __got_rename(from, to, 0, 0, 0, 0)
}

pub(package) fn sys_getcwd(buf: i64, capacity: i64) -[Unsafe]> i64 {
  __got_getcwd(buf, capacity, 0, 0, 0, 0)
}

pub(package) fn sys_errno_ptr() -[Unsafe]> i64 {
  __got___error(0, 0, 0, 0, 0, 0)
}
