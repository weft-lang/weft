-- runtime/effects.weft -- handler frame layout and lookup helpers

use runtime/alloc.{*}
use runtime/unsafe.{*}

pub(package) fn handler_frame_size() -> i64 { 32 }
pub(package) fn handler_frame_eff_hash_offset() -> i64 { 0 }
pub(package) fn handler_frame_num_ops_offset() -> i64 { 8 }
pub(package) fn handler_frame_ops_offset() -> i64 { 16 }
pub(package) fn handler_frame_prev_offset() -> i64 { 24 }

-- 4j abort edge: handles with an ABORTIVE clause (one that never resumes)
-- allocate an extended frame that additionally records the handle site's
-- machine state, so a non-resuming clause can return control to the handle
-- instead of to its perform site (kernel §7.3).
--
-- The saved-register block holds x19-x28, x29 (fp) and, in the x30 slot,
-- the ADDRESS OF THE ABORT LANDING BLOCK — not a real return address. The
-- abortive epilogue restores this block and executes `ret`, which
-- therefore lands at the abort block. Same trick the fiber prompt path
-- uses (cg_fiber_restore_handler_and_ret).
--
-- x27 (the handler-frame pointer) is inside the saved block and is
-- captured BEFORE this frame is pushed, so restoring it pops the handler
-- frame as a side effect — the abort path needs no separate pop.
--
-- Handles with no abortive clause keep the 32-byte frame and save
-- nothing: the abort edge is pay-for-what-you-use, and non-abortive
-- handler code is byte-identical to pre-4j output.
pub(package) fn handler_frame_abort_sp_offset() -> i64 { 32 }
pub(package) fn handler_frame_abort_regs_offset() -> i64 { 40 }
pub(package) fn handler_frame_abort_regs_size() -> i64 { 96 }
-- J3 dynamic-wind state. The cleanup boundary is the shadow-chain head at
-- handle entry; prev-active restores an enclosing abortive handle on either
-- normal completion or abort. These words sit after the saved-register block
-- so the J2 restore layout stays unchanged.
pub(package) fn handler_frame_abort_cleanup_boundary_offset() -> i64 { 136 }
pub(package) fn handler_frame_abort_prev_active_offset() -> i64 { 144 }
pub(package) fn handler_frame_abort_size() -> i64 { 160 }

pub(package) fn handler_ops_entry_size() -> i64 { 24 }
pub(package) fn handler_ops_op_hash_offset() -> i64 { 0 }
pub(package) fn handler_ops_fn_ptr_offset() -> i64 { 8 }
pub(package) fn handler_ops_env_ptr_offset() -> i64 { 16 }

pub(package) fn handler_ops_new(num_ops: i64) -> i64 {
  alloc_zeroed(num_ops * handler_ops_entry_size())
}

pub(package) fn handler_ops_entry(ops: i64, index: i64) -> i64 {
  ops + index * handler_ops_entry_size()
}

pub(package) fn handler_ops_set(ops: i64, index: i64, op_hash: i64, fn_ptr: i64, env_ptr: i64) -> i64 {
  let entry = handler_ops_entry(ops, index)
  __mem_store64(entry + handler_ops_op_hash_offset(), op_hash)
  __mem_store64(entry + handler_ops_fn_ptr_offset(), fn_ptr)
  __mem_store64(entry + handler_ops_env_ptr_offset(), env_ptr)
  0
}

pub(package) fn handler_frame_new(eff_hash: i64, num_ops: i64, ops: i64, prev: i64) -> i64 {
  let frame = alloc_bump(handler_frame_size())
  __mem_store64(frame + handler_frame_eff_hash_offset(), eff_hash)
  __mem_store64(frame + handler_frame_num_ops_offset(), num_ops)
  __mem_store64(frame + handler_frame_ops_offset(), ops)
  __mem_store64(frame + handler_frame_prev_offset(), prev)
  frame
}

pub(package) fn handler_frame_eff_hash(frame: i64) -> i64 { __mem_load64(frame + handler_frame_eff_hash_offset()) }
pub(package) fn handler_frame_num_ops(frame: i64) -> i64 { __mem_load64(frame + handler_frame_num_ops_offset()) }
pub(package) fn handler_frame_ops(frame: i64) -> i64 { __mem_load64(frame + handler_frame_ops_offset()) }
pub(package) fn handler_frame_prev(frame: i64) -> i64 { __mem_load64(frame + handler_frame_prev_offset()) }
pub(package) fn handler_ops_entry_op_hash(entry: i64) -> i64 { __mem_load64(entry + handler_ops_op_hash_offset()) }
pub(package) fn handler_ops_entry_fn_ptr(entry: i64) -> i64 { __mem_load64(entry + handler_ops_fn_ptr_offset()) }
pub(package) fn handler_ops_entry_env_ptr(entry: i64) -> i64 { __mem_load64(entry + handler_ops_env_ptr_offset()) }
pub(package) fn handler_closure_fn_ptr(closure: i64) -> i64 { __mem_load64(closure) }
pub(package) fn handler_closure_env_ptr(closure: i64) -> i64 { __mem_load64(closure + 8) }

pub(package) fn continuation_record_size() -> i64 { 64 }
pub(package) fn continuation_status_offset() -> i64 { 0 }
pub(package) fn continuation_cleanup_fn_offset() -> i64 { 8 }
pub(package) fn continuation_cleanup_env_offset() -> i64 { 16 }
pub(package) fn continuation_segment_offset() -> i64 { 24 }
pub(package) fn continuation_saved_sp_offset() -> i64 { 32 }
pub(package) fn continuation_saved_fp_offset() -> i64 { 40 }
pub(package) fn continuation_resume_value_offset() -> i64 { 48 }
pub(package) fn continuation_flags_offset() -> i64 { 56 }

pub(package) fn continuation_status_active() -> i64 { 0 }
pub(package) fn continuation_status_resumed() -> i64 { 1 }
pub(package) fn continuation_status_dropped() -> i64 { 2 }
pub(package) fn continuation_status_stored() -> i64 { 3 }

pub(package) fn continuation_cleanup_desc_header_size() -> i64 { 8 }
pub(package) fn continuation_cleanup_entry_size() -> i64 { 24 }
pub(package) fn continuation_cleanup_entry_kind_offset() -> i64 { 0 }
pub(package) fn continuation_cleanup_entry_slot_offset() -> i64 { 8 }
pub(package) fn continuation_cleanup_entry_live_offset() -> i64 { 16 }

pub(package) fn continuation_cleanup_kind_none() -> i64 { 0 }
pub(package) fn continuation_cleanup_kind_rc() -> i64 { 1 }
pub(package) fn continuation_cleanup_kind_closure() -> i64 { 2 }
pub(package) fn continuation_cleanup_kind_continuation() -> i64 { 3 }
pub(package) fn continuation_cleanup_kind_weak() -> i64 { 4 }
pub(package) fn continuation_cleanup_kind_rc_drop_only() -> i64 { 5 }
pub(package) fn continuation_cleanup_kind_closure_drop_only() -> i64 { 6 }
pub(package) fn continuation_cleanup_kind_weak_drop_only() -> i64 { 7 }

pub(package) fn continuation_cleanup_desc_size(count: i64) -> i64 {
  let n = if count < 0 { 0 } else { count }
  continuation_cleanup_desc_header_size() + n * continuation_cleanup_entry_size()
}

pub(package) fn continuation_cleanup_desc_new(count: i64) -> i64 {
  let n = if count < 0 { 0 } else { count }
  let desc = alloc_zeroed(continuation_cleanup_desc_size(n))
  __mem_store64(desc, n)
  desc
}

pub(package) fn continuation_cleanup_desc_count(desc: i64) -> i64 {
  if desc == 0 { 0 } else { __mem_load64(desc) }
}

pub(package) fn continuation_cleanup_desc_entry(desc: i64, index: i64) -> i64 {
  if desc == 0 { 0 }
  else {
    let count = continuation_cleanup_desc_count(desc)
    if index < 0 or index >= count { 0 }
    else { desc + continuation_cleanup_desc_header_size() + index * continuation_cleanup_entry_size() }
  }
}

pub(package) fn continuation_cleanup_desc_set(desc: i64, index: i64, kind: i64, slot: i64, live: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { 0 }
  else {
    __mem_store64(entry + continuation_cleanup_entry_kind_offset(), kind)
    __mem_store64(entry + continuation_cleanup_entry_slot_offset(), slot)
    __mem_store64(entry + continuation_cleanup_entry_live_offset(), live)
    1
  }
}

pub(package) fn continuation_cleanup_desc_kind(desc: i64, index: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { continuation_cleanup_kind_none() }
  else { __mem_load64(entry + continuation_cleanup_entry_kind_offset()) }
}

pub(package) fn continuation_cleanup_desc_slot(desc: i64, index: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { 0 } else { __mem_load64(entry + continuation_cleanup_entry_slot_offset()) }
}

pub(package) fn continuation_cleanup_desc_live(desc: i64, index: i64) -> i64 {
  let entry = continuation_cleanup_desc_entry(desc, index)
  if entry == 0 { 0 } else { __mem_load64(entry + continuation_cleanup_entry_live_offset()) }
}

pub(package) fn continuation_new(cleanup_fn: i64, cleanup_env: i64) -> i64 {
  let k = alloc_zeroed(continuation_record_size())
  __mem_store64(k + continuation_status_offset(), continuation_status_active())
  __mem_store64(k + continuation_cleanup_fn_offset(), cleanup_fn)
  __mem_store64(k + continuation_cleanup_env_offset(), cleanup_env)
  k
}

pub(package) fn continuation_new_with_cleanup_desc(desc: i64) -> i64 {
  continuation_new(0, desc)
}

pub(package) fn continuation_new_noop() -> i64 {
  continuation_new(0, 0)
}

pub(package) fn continuation_status(k: i64) -> i64 {
  if k == 0 { 0 - 1 } else { __mem_load64(k + continuation_status_offset()) }
}

pub(package) fn continuation_cleanup_fn(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_cleanup_fn_offset()) }
}

pub(package) fn continuation_cleanup_env(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_cleanup_env_offset()) }
}

pub(package) fn continuation_cleanup_desc(k: i64) -> i64 {
  continuation_cleanup_env(k)
}

pub(package) fn continuation_segment(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_segment_offset()) }
}

pub(package) fn continuation_saved_sp(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_saved_sp_offset()) }
}

pub(package) fn continuation_saved_fp(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_saved_fp_offset()) }
}

pub(package) fn continuation_resume_value(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_resume_value_offset()) }
}

pub(package) fn continuation_flags(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_flags_offset()) }
}

pub(package) fn continuation_status_is_owned(status: i64) -> bool {
  status == continuation_status_active() or status == continuation_status_stored()
}

pub(package) fn continuation_set_segment(k: i64, segment: i64, saved_sp: i64, saved_fp: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_segment_offset(), segment)
    __mem_store64(k + continuation_saved_sp_offset(), saved_sp)
    __mem_store64(k + continuation_saved_fp_offset(), saved_fp)
    1
  }
}

pub(package) fn continuation_set_resume_value(k: i64, value: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_resume_value_offset(), value)
    1
  }
}

pub(package) fn continuation_set_flags(k: i64, flags: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_flags_offset(), flags)
    1
  }
}

pub(package) fn continuation_mark_resumed(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if continuation_status_is_owned(__mem_load64(k + continuation_status_offset())) {
      __mem_store64(k + continuation_status_offset(), continuation_status_resumed())
      1
    } else { 0 }
  }
}

pub(package) fn continuation_mark_stored(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if __mem_load64(k + continuation_status_offset()) == continuation_status_active() {
      __mem_store64(k + continuation_status_offset(), continuation_status_stored())
      1
    } else { 0 }
  }
}

pub(package) fn continuation_drop(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if continuation_status_is_owned(__mem_load64(k + continuation_status_offset())) {
      __mem_store64(k + continuation_status_offset(), continuation_status_dropped())
      1
    } else { 0 }
  }
}

pub(package) fn continuation_cleanup_needed(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if __mem_load64(k + continuation_cleanup_fn_offset()) != 0 { 1 }
    else { if __mem_load64(k + continuation_cleanup_env_offset()) != 0 { 1 }
    else { if __mem_load64(k + continuation_segment_offset()) != 0 { 1 } else { 0 } } }
  }
}

pub(package) fn fiber_segment_saved_sp_offset() -> i64 { 0 }
pub(package) fn fiber_segment_saved_regs_offset() -> i64 { 8 }
pub(package) fn fiber_segment_stack_top_offset() -> i64 { 104 }
pub(package) fn fiber_segment_stack_len_offset() -> i64 { 112 }
-- Eight ABI result lanes survive the register restore that switches back
-- into a suspended fiber.
pub(package) fn fiber_segment_result_lanes_offset() -> i64 { 120 }
pub(package) fn fiber_segment_size() -> i64 { 184 }
-- The native backend's conservative SSA home area is 2 KiB per frame.
-- Leave enough headroom for recursive effectful code plus abort-cleanup
-- records; 64 KiB was crossed by the depth-25 EH generator after J3.
pub(package) fn fiber_default_stack_size() -> i64 { 131072 }

pub(package) fn fiber_prompt_handler_sp_offset() -> i64 { 0 }
pub(package) fn fiber_prompt_handler_regs_offset() -> i64 { 8 }
pub(package) fn fiber_prompt_segment_offset() -> i64 { 104 }
pub(package) fn fiber_prompt_prev_prompt_offset() -> i64 { 112 }
-- Symmetric result transport for a fiber returning to its handler.
pub(package) fn fiber_prompt_result_lanes_offset() -> i64 { 120 }
-- One managed closure-shaped owner keeps the deferred body's captures alive
-- across suspension through arbitrarily deep ordinary call frames. The
-- continuation cleanup descriptor carries this owner as drop-only: resume
-- leaves it with the fiber, while dropping k releases the complete bundle.
pub(package) fn fiber_prompt_capture_owner_offset() -> i64 { 184 }
-- 3w: a fiber is a separate dynamic-cleanup context. Sharing the thread's
-- abort-cleanup head across a stack switch leaves pointers into the suspended
-- stack in the caller's chain; ordinary caller disarms can then splice those
-- records, and resuming the fiber follows a corrupt link. Prompts therefore
-- save both sides of the context switch. Generator prompts enable cleanup
-- tracking so explicit generator drop can unwind suspended locals; deferred
-- handler prompts leave it disabled because their continuation descriptors
-- already own exactly that cleanup population.
pub(package) fn fiber_prompt_cleanup_tracking_offset() -> i64 { 192 }
pub(package) fn fiber_prompt_cleanup_top_offset() -> i64 { 200 }
pub(package) fn fiber_prompt_cleanup_active_offset() -> i64 { 208 }
pub(package) fn fiber_prompt_handler_cleanup_top_offset() -> i64 { 216 }
pub(package) fn fiber_prompt_handler_cleanup_active_offset() -> i64 { 224 }
pub(package) fn fiber_prompt_size() -> i64 { 240 }

pub(package) fn fiber_align_down(value: i64, align: i64) -> i64 {
  if align <= 1 { value }
  else { value - (value - value / align * align) }
}

pub(package) fn fiber_segment_new(stack_size: i64) -> i64 {
  let size = if stack_size < 4096 { 4096 } else { stack_size }
  let stack = alloc_zeroed(size + 16)
  let segment = alloc_zeroed(fiber_segment_size())
  let top = fiber_align_down(stack + size + 16, 16)
  __mem_store64(segment + fiber_segment_stack_top_offset(), top)
  __mem_store64(segment + fiber_segment_stack_len_offset(), size)
  segment
}

pub(package) fn fiber_prompt_new(segment: i64) -> i64 {
  let prompt = alloc_zeroed(fiber_prompt_size())
  __mem_store64(prompt + fiber_prompt_segment_offset(), segment)
  prompt
}

pub(package) fn fiber_segment_stack_top(segment: i64) -> i64 {
  if segment == 0 { 0 } else { __mem_load64(segment + fiber_segment_stack_top_offset()) }
}

pub(package) fn fiber_segment_stack_len(segment: i64) -> i64 {
  if segment == 0 { 0 } else { __mem_load64(segment + fiber_segment_stack_len_offset()) }
}

pub(package) fn fiber_segment_saved_sp(segment: i64) -> i64 {
  if segment == 0 { 0 } else { __mem_load64(segment + fiber_segment_saved_sp_offset()) }
}

pub(package) fn fiber_prompt_segment(prompt: i64) -> i64 {
  if prompt == 0 { 0 } else { __mem_load64(prompt + fiber_prompt_segment_offset()) }
}

pub(package) fn fiber_prompt_prev_prompt(prompt: i64) -> i64 {
  if prompt == 0 { 0 } else { __mem_load64(prompt + fiber_prompt_prev_prompt_offset()) }
}

pub(package) fn fiber_prompt_capture_owner(prompt: i64) -> i64 {
  if prompt == 0 { 0 } else { __mem_load64(prompt + fiber_prompt_capture_owner_offset()) }
}

pub(package) fn fiber_prompt_enable_cleanup(prompt: i64) -> i64 {
  if prompt == 0 { 0 }
  else {
    __mem_store64(prompt + fiber_prompt_cleanup_tracking_offset(), 1)
    __mem_store64(prompt + fiber_prompt_cleanup_top_offset(), 0)
    -- The dynamic cleanup emitter only needs a non-zero guard. A private
    -- sentinel keeps generator cleanup recording active even when the
    -- generator is created outside an abortive handler.
    __mem_store64(prompt + fiber_prompt_cleanup_active_offset(), 1)
    1
  }
}

pub(package) fn fiber_prompt_cleanup_record_count(prompt: i64) -> i64 {
  if prompt == 0 { 0 }
  else {
    let mut record = __mem_load64(prompt + fiber_prompt_cleanup_top_offset())
    let mut count = 0
    while record != 0 {
      count = count + 1
      record = __mem_load64(record + handler_abort_cleanup_record_prev_offset())
    }
    count
  }
}

pub(package) fn fiber_prompt_drop_cleanup_raw(prompt: i64) -[Unsafe]> i64 {
  if prompt == 0 { 0 }
  else {
    let st = alloc_runtime_state_ptr()
    let saved_top = __mem_load64(st + handler_abort_cleanup_top_offset())
    let saved_active = __mem_load64(st + handler_abort_cleanup_active_offset())
    __mem_store64(st + handler_abort_cleanup_top_offset(), __mem_load64(prompt + fiber_prompt_cleanup_top_offset()))
    __mem_store64(st + handler_abort_cleanup_active_offset(), 1)
    let mut dropped = 0
    let mut record = __mem_load64(st + handler_abort_cleanup_top_offset())
    while record != 0 {
      let next = __mem_load64(record + handler_abort_cleanup_record_prev_offset())
      __mem_store64(st + handler_abort_cleanup_top_offset(), next)
      __mem_store64(prompt + fiber_prompt_cleanup_top_offset(), next)
      let cleanup_fn = __mem_load64(record + handler_abort_cleanup_record_fn_offset())
      let value = __mem_load64(record + handler_abort_cleanup_record_value_offset())
      unsafe_raw_call_i64(cleanup_fn, value)
      dropped = dropped + 1
      record = __mem_load64(st + handler_abort_cleanup_top_offset())
    }
    __mem_store64(prompt + fiber_prompt_cleanup_active_offset(), 0)
    __mem_store64(st + handler_abort_cleanup_top_offset(), saved_top)
    __mem_store64(st + handler_abort_cleanup_active_offset(), saved_active)
    dropped
  }
}

pub(package) fn fiber_prompt_drop_cleanup(prompt: i64) -> i64 {
  handle fiber_prompt_drop_cleanup_raw(prompt) {
    Unsafe.raw_call_i64(fn_ptr, arg) -> resume(__call_i64(fn_ptr, arg))
  }
}

pub(package) fn fiber_trampoline(prompt: i64, fn_ptr: i64, arg: i64) -[Unsafe]> i64 {
  __fiber_trampoline(prompt, fn_ptr, arg)
}

pub(package) fn fiber_suspend(value: i64) -[Unsafe]> i64 {
  __fiber_suspend(value)
}

pub(package) fn fiber_resume(prompt: i64, value: i64) -[Unsafe]> i64 {
  __fiber_resume(prompt, value)
}

pub(package) fn fiber_is_done() -[Unsafe]> i64 {
  __fiber_is_done()
}

-- Returns the matching ops entry for Tier 2 handler dispatch, or 0.
-- Codegen twin: runtime_state_dispatch_prev_offset in codegen.weft.
-- handler_find_entry stores the FOUND frame's prev here so the perform
-- site can run the clause with the handler's own frame masked out of
-- x27. Without the mask, a tail-resumptive clause performing an effect
-- of its own label re-enters itself (the under/evidence-masking trap,
-- Xie & Leijen ICFP'21 2.9.2) instead of dispatching to the enclosing
-- handler — observed as unbounded self-recursion.
pub(package) fn handler_dispatch_prev_offset() -> i64 { 120 }
-- 4j twin: runtime_state_dispatch_frame_offset in codegen.weft. The
-- dispatcher also hands the FOUND frame to an abortive clause. The clause
-- copies this shared slot into its own frame in the prologue because nested
-- performs may overwrite it before the abortive epilogue runs.
pub(package) fn handler_dispatch_frame_offset() -> i64 { 128 }
-- J3 twins: runtime_state_abort_cleanup_* in codegen.weft. Cleanup records
-- are stack-resident triples [prev, cleanup_fn, value]. Only code executing
-- inside an abortive handler links records into this chain.
pub(package) fn handler_abort_cleanup_top_offset() -> i64 { 136 }
pub(package) fn handler_abort_cleanup_active_offset() -> i64 { 144 }

pub(package) fn handler_abort_cleanup_record_prev_offset() -> i64 { 0 }
pub(package) fn handler_abort_cleanup_record_fn_offset() -> i64 { 8 }
pub(package) fn handler_abort_cleanup_record_value_offset() -> i64 { 16 }
-- Stable semantic identity for disarm. The callable address may be a local
-- forward thunk at registration and a direct target by the later release;
-- those addresses are operationally equivalent but not pointer-equal.
pub(package) fn handler_abort_cleanup_record_action_offset() -> i64 { 24 }
pub(package) fn handler_abort_cleanup_record_size() -> i64 { 32 }

-- Remove one exact stack-resident obligation after its ordinary release or
-- Drop path has taken ownership. Records normally leave in LIFO order; the
-- splice handles branch joins and transfers without leaving pointers into a
-- returned native frame.
pub(package) fn handler_abort_cleanup_disarm(record: i64) -> i64 {
  if record == 0 { 0 }
  else {
    let st = alloc_runtime_state_ptr()
    if __mem_load64(st + handler_abort_cleanup_active_offset()) == 0 { 0 }
    else {
      let top = __mem_load64(st + handler_abort_cleanup_top_offset())
      if top == record {
        __mem_store64(st + handler_abort_cleanup_top_offset(), __mem_load64(record + handler_abort_cleanup_record_prev_offset()))
        1
      } else {
        let mut cur = top
        let mut removed = 0
        while cur != 0 and removed == 0 {
          let next = __mem_load64(cur + handler_abort_cleanup_record_prev_offset())
          if next == record {
            __mem_store64(cur + handler_abort_cleanup_record_prev_offset(), __mem_load64(record + handler_abort_cleanup_record_prev_offset()))
            removed = 1
          } else {
            cur = next
          }
        }
        removed
      }
    }
  }
}

pub(package) fn handler_find_entry(stack: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut frame = stack
  let mut result = 0
  while frame != 0 {
    if handler_frame_eff_hash(frame) == eff_hash {
      let num_ops = handler_frame_num_ops(frame)
      let ops = handler_frame_ops(frame)
      let mut i = 0
      while i < num_ops {
        let entry = handler_ops_entry(ops, i)
        if handler_ops_entry_op_hash(entry) == op_hash {
          result = entry
          let st = alloc_runtime_state_ptr()
          __mem_store64(st + handler_dispatch_prev_offset(), handler_frame_prev(frame))
          __mem_store64(st + handler_dispatch_frame_offset(), frame)
          i = num_ops
          frame = 0
        } else { i = i + 1 }
      }
      if result == 0 { frame = handler_frame_prev(frame) } else { frame = 0 }
    } else {
      frame = handler_frame_prev(frame)
    }
  }
  result
}

-- Returns a closure pair [fn_ptr, env_ptr] for the matching clause, or 0.
pub(package) fn handler_lookup(stack: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let entry = handler_find_entry(stack, eff_hash, op_hash)
  if entry == 0 {
    0
  } else {
    let closure = alloc_bump(16)
    __mem_store64(closure, handler_ops_entry_fn_ptr(entry))
    __mem_store64(closure + 8, handler_ops_entry_env_ptr(entry))
    closure
  }
}
