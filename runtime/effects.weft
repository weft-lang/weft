-- runtime/effects.weft -- handler frame layout and lookup helpers

use "runtime/alloc.weft"

fn handler_frame_size() -> i64 { 32 }
fn handler_frame_eff_hash_offset() -> i64 { 0 }
fn handler_frame_num_ops_offset() -> i64 { 8 }
fn handler_frame_ops_offset() -> i64 { 16 }
fn handler_frame_prev_offset() -> i64 { 24 }

fn handler_ops_entry_size() -> i64 { 24 }
fn handler_ops_op_hash_offset() -> i64 { 0 }
fn handler_ops_fn_ptr_offset() -> i64 { 8 }
fn handler_ops_env_ptr_offset() -> i64 { 16 }

fn handler_ops_new(num_ops: i64) -> i64 {
  alloc_zeroed(num_ops * handler_ops_entry_size())
}

fn handler_ops_entry(ops: i64, index: i64) -> i64 {
  ops + index * handler_ops_entry_size()
}

fn handler_ops_set(ops: i64, index: i64, op_hash: i64, fn_ptr: i64, env_ptr: i64) -> i64 {
  let entry = handler_ops_entry(ops, index)
  __mem_store64(entry + handler_ops_op_hash_offset(), op_hash)
  __mem_store64(entry + handler_ops_fn_ptr_offset(), fn_ptr)
  __mem_store64(entry + handler_ops_env_ptr_offset(), env_ptr)
  0
}

fn handler_frame_new(eff_hash: i64, num_ops: i64, ops: i64, prev: i64) -> i64 {
  let frame = alloc_bump(handler_frame_size())
  __mem_store64(frame + handler_frame_eff_hash_offset(), eff_hash)
  __mem_store64(frame + handler_frame_num_ops_offset(), num_ops)
  __mem_store64(frame + handler_frame_ops_offset(), ops)
  __mem_store64(frame + handler_frame_prev_offset(), prev)
  frame
}

fn handler_frame_eff_hash(frame: i64) -> i64 { __mem_load64(frame + handler_frame_eff_hash_offset()) }
fn handler_frame_num_ops(frame: i64) -> i64 { __mem_load64(frame + handler_frame_num_ops_offset()) }
fn handler_frame_ops(frame: i64) -> i64 { __mem_load64(frame + handler_frame_ops_offset()) }
fn handler_frame_prev(frame: i64) -> i64 { __mem_load64(frame + handler_frame_prev_offset()) }
fn handler_ops_entry_op_hash(entry: i64) -> i64 { __mem_load64(entry + handler_ops_op_hash_offset()) }
fn handler_ops_entry_fn_ptr(entry: i64) -> i64 { __mem_load64(entry + handler_ops_fn_ptr_offset()) }
fn handler_ops_entry_env_ptr(entry: i64) -> i64 { __mem_load64(entry + handler_ops_env_ptr_offset()) }
fn handler_closure_fn_ptr(closure: i64) -> i64 { __mem_load64(closure) }
fn handler_closure_env_ptr(closure: i64) -> i64 { __mem_load64(closure + 8) }

fn continuation_record_size() -> i64 { 64 }
fn continuation_status_offset() -> i64 { 0 }
fn continuation_cleanup_fn_offset() -> i64 { 8 }
fn continuation_cleanup_env_offset() -> i64 { 16 }
fn continuation_segment_offset() -> i64 { 24 }
fn continuation_saved_sp_offset() -> i64 { 32 }
fn continuation_saved_fp_offset() -> i64 { 40 }
fn continuation_resume_value_offset() -> i64 { 48 }
fn continuation_flags_offset() -> i64 { 56 }

fn continuation_status_active() -> i64 { 0 }
fn continuation_status_resumed() -> i64 { 1 }
fn continuation_status_dropped() -> i64 { 2 }

fn continuation_new(cleanup_fn: i64, cleanup_env: i64) -> i64 {
  let k = alloc_zeroed(continuation_record_size())
  __mem_store64(k + continuation_status_offset(), continuation_status_active())
  __mem_store64(k + continuation_cleanup_fn_offset(), cleanup_fn)
  __mem_store64(k + continuation_cleanup_env_offset(), cleanup_env)
  k
}

fn continuation_new_noop() -> i64 {
  continuation_new(0, 0)
}

fn continuation_status(k: i64) -> i64 {
  if k == 0 { 0 - 1 } else { __mem_load64(k + continuation_status_offset()) }
}

fn continuation_cleanup_fn(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_cleanup_fn_offset()) }
}

fn continuation_cleanup_env(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_cleanup_env_offset()) }
}

fn continuation_segment(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_segment_offset()) }
}

fn continuation_saved_sp(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_saved_sp_offset()) }
}

fn continuation_saved_fp(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_saved_fp_offset()) }
}

fn continuation_resume_value(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_resume_value_offset()) }
}

fn continuation_flags(k: i64) -> i64 {
  if k == 0 { 0 } else { __mem_load64(k + continuation_flags_offset()) }
}

fn continuation_set_segment(k: i64, segment: i64, saved_sp: i64, saved_fp: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_segment_offset(), segment)
    __mem_store64(k + continuation_saved_sp_offset(), saved_sp)
    __mem_store64(k + continuation_saved_fp_offset(), saved_fp)
    1
  }
}

fn continuation_set_resume_value(k: i64, value: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_resume_value_offset(), value)
    1
  }
}

fn continuation_set_flags(k: i64, flags: i64) -> i64 {
  if k == 0 { 0 }
  else {
    __mem_store64(k + continuation_flags_offset(), flags)
    1
  }
}

fn continuation_mark_resumed(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if __mem_load64(k + continuation_status_offset()) == continuation_status_active() {
      __mem_store64(k + continuation_status_offset(), continuation_status_resumed())
      1
    } else { 0 }
  }
}

fn continuation_drop(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if __mem_load64(k + continuation_status_offset()) == continuation_status_active() {
      __mem_store64(k + continuation_status_offset(), continuation_status_dropped())
      1
    } else { 0 }
  }
}

fn continuation_cleanup_needed(k: i64) -> i64 {
  if k == 0 { 0 }
  else {
    if __mem_load64(k + continuation_cleanup_fn_offset()) != 0 { 1 }
    else { if __mem_load64(k + continuation_segment_offset()) != 0 { 1 } else { 0 } }
  }
}

-- Returns the matching ops entry for Tier 2 handler dispatch, or 0.
fn handler_find_entry(stack: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let mut frame = stack
  let mut result = 0
  while frame != 0 {
    if handler_frame_eff_hash(frame) == eff_hash {
      let num_ops = handler_frame_num_ops(frame)
      let ops = handler_frame_ops(frame)
      let mut i = 0
      while i < num_ops {
        let entry = handler_ops_entry(ops, i)
        if handler_ops_entry_op_hash(entry) == op_hash {
          result = entry
          i = num_ops
          frame = 0
        } else { i = i + 1 }
      }
      if result == 0 { frame = handler_frame_prev(frame) } else { frame = 0 }
    } else {
      frame = handler_frame_prev(frame)
    }
  }
  result
}

-- Returns a closure pair [fn_ptr, env_ptr] for the matching clause, or 0.
fn handler_lookup(stack: i64, eff_hash: i64, op_hash: i64) -> i64 {
  let entry = handler_find_entry(stack, eff_hash, op_hash)
  if entry == 0 {
    0
  } else {
    let closure = alloc_bump(16)
    __mem_store64(closure, handler_ops_entry_fn_ptr(entry))
    __mem_store64(closure + 8, handler_ops_entry_env_ptr(entry))
    closure
  }
}
