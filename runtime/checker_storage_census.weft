-- Measurement-only checker-storage migration census.
--
-- This trusted leaf is parsed only for
-- `weft compile --checker-storage-census`. Ordinary programs neither contain
-- it nor reserve the counter tail. Compiler twin: runtime_state_checker_storage_census_*
-- in compiler/backend/aarch64/codegen.weft.

use runtime/alloc.{alloc_bump, alloc_runtime_shared_state_ptr}
use runtime/syscall.{sys_write}

pub(package) fn checker_storage_census_base_offset() -> i64 { 208 }

pub(package) fn checker_storage_census_event_count() -> i64 { 6 }

pub(package) fn checker_storage_census_runtime_state() -> i64 {
  alloc_runtime_shared_state_ptr()
}

pub(package) fn checker_storage_census_value(state: i64, event: i64) -> i64 {
  if state == 0 or event < 0 or event >= checker_storage_census_event_count() { 0 }
  else { __mem_load64(state + checker_storage_census_base_offset() + event * 8) }
}

pub(package) fn checker_storage_census_write(text: str) -> i64 {
  sys_write(2, __str_ptr(text), __str_len(text))
}

pub(package) fn checker_storage_census_write_i64(value: i64) -> i64 {
  if value <= 0 { checker_storage_census_write("0") }
  else {
    let digits = alloc_bump(32)
    let mut cursor = 32
    let mut remaining = value
    while remaining > 0 {
      cursor = cursor - 1
      __mem_store8(digits + cursor, 48 + remaining % 10)
      remaining = remaining / 10
    }
    sys_write(2, digits + cursor, 32 - cursor)
  }
}

pub(package) fn checker_storage_census_write_field(state: i64, event: i64) -> i64 {
  checker_storage_census_write(" ")
  checker_storage_census_write_i64(checker_storage_census_value(state, event))
}

pub(package) fn checker_storage_census_report_human(state: i64) -> i64 {
  checker_storage_census_write("checker storage census: registered_modules=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 0))
  checker_storage_census_write(" checked_expressions=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 1))
  checker_storage_census_write(" semantic_type_nodes=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 2))
  checker_storage_census_write(" typed_to_raw_calls=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 3))
  checker_storage_census_write(" raw_to_typed_calls=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 4))
  checker_storage_census_write(" checked_type_clone_passes=")
  checker_storage_census_write_i64(checker_storage_census_value(state, 5))
  checker_storage_census_write("\n")
}

-- Versioned positional schema: registered module roots, check_expr entries,
-- ty_new entries, typed-to-raw facade entries, raw-to-typed facade entries,
-- and checked type-table clone passes. These are exact dynamic entry counts in
-- the instrumented image, not static source call-site counts.
pub(package) fn checker_storage_census_report() -> i64 {
  let state = checker_storage_census_runtime_state()
  checker_storage_census_write("WEFT_CHECKER_STORAGE_CENSUS 1")
  for event in 0..checker_storage_census_event_count() {
    checker_storage_census_write_field(state, event)
  }
  checker_storage_census_write("\n")
  checker_storage_census_report_human(state)
  0
}
