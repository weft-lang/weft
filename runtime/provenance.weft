-- runtime/provenance.weft -- sealed lookup over embedded native provenance
--
-- This is the runtime consumer of pipeline.weft's versioned, relative-offset
-- table ABI. Every public raw entry accessor validates that its pointer names
-- an aligned entry in the installed read-only table before dereferencing it.

use runtime/alloc.{*}

pub(package) fn runtime_native_provenance_state_offset() -> i64 { 152 }
pub(package) fn runtime_native_provenance_magic() -> i64 { 1464225841 }
pub(package) fn runtime_native_provenance_version() -> i64 { 1 }
pub(package) fn runtime_native_provenance_header_size() -> i64 { 64 }
pub(package) fn runtime_native_provenance_entry_size() -> i64 { 72 }
pub(package) fn runtime_native_provenance_file_entry_size() -> i64 { 16 }

pub(package) fn runtime_native_provenance_table_raw() -> i64 {
  __mem_load64(alloc_runtime_shared_state_ptr() + runtime_native_provenance_state_offset())
}

pub(package) fn runtime_native_provenance_table() -> i64 {
  let table = runtime_native_provenance_table_raw()
  if table == 0 { 0 }
  else {
    if __mem_load64(table) != runtime_native_provenance_magic() { 0 }
    else { if __mem_load64(table + 8) != runtime_native_provenance_version() { 0 }
    else { if __mem_load64(table + 24) != runtime_native_provenance_entry_size() { 0 }
    else { if __mem_load64(table + 40) != runtime_native_provenance_file_entry_size() { 0 }
    else { table } } } }
  }
}

pub(package) fn runtime_native_provenance_count() -> i64 {
  let table = runtime_native_provenance_table()
  if table == 0 { 0 } else { __mem_load64(table + 16) }
}

pub(package) fn runtime_native_provenance_file_count() -> i64 {
  let table = runtime_native_provenance_table()
  if table == 0 { 0 } else { __mem_load64(table + 32) }
}

pub(package) fn runtime_native_provenance_code_base(table: i64) -> i64 {
  let current = runtime_native_provenance_table()
  if current == 0 or table != current { 0 } else { current - __mem_load64(current + 48) }
}

pub(package) fn runtime_native_provenance_entry_at(table: i64, index: i64) -> i64 {
  let current = runtime_native_provenance_table()
  if current == 0 or table != current or index < 0 or index >= __mem_load64(current + 16) { 0 }
  else { current + runtime_native_provenance_header_size() + index * runtime_native_provenance_entry_size() }
}

pub(package) fn runtime_native_provenance_entry_is_valid(entry: i64) -> i64 {
  let table = runtime_native_provenance_table()
  if table == 0 or entry == 0 { 0 }
  else {
    let first = table + runtime_native_provenance_header_size()
    let limit = first + __mem_load64(table + 16) * runtime_native_provenance_entry_size()
    if entry < first or entry >= limit { 0 }
    else { if (entry - first) % runtime_native_provenance_entry_size() == 0 { 1 } else { 0 } }
  }
}

pub(package) fn runtime_native_provenance_lookup_offset_in(table: i64, code_offset: i64) -> i64 {
  let current = runtime_native_provenance_table()
  if current == 0 or table != current { return 0 } else { 0 }
  let count = __mem_load64(current + 16)
  let mut lo = 0
  let mut hi = count
  let mut found = 0
  while lo < hi and found == 0 {
    let mid = lo + (hi - lo) / 2
    let entry = runtime_native_provenance_entry_at(current, mid)
    let start = __mem_load64(entry)
    let end = __mem_load64(entry + 8)
    if code_offset < start { hi = mid }
    else { if code_offset >= end { lo = mid + 1 }
    else { found = entry } }
  }
  found
}

pub(package) fn runtime_native_provenance_lookup_offset(code_offset: i64) -> i64 {
  let table = runtime_native_provenance_table()
  if table == 0 { 0 } else { runtime_native_provenance_lookup_offset_in(table, code_offset) }
}

pub(package) fn runtime_native_provenance_lookup_pc(pc: i64) -> i64 {
  let table = runtime_native_provenance_table()
  if table == 0 { 0 }
  else { runtime_native_provenance_lookup_offset_in(table, pc - runtime_native_provenance_code_base(table)) }
}

pub(package) fn runtime_native_provenance_entry_start(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry) } }
pub(package) fn runtime_native_provenance_entry_end(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry + 8) } }
pub(package) fn runtime_native_provenance_entry_hash(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry + 16) } }
pub(package) fn runtime_native_provenance_entry_flags(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry + 24) } }
pub(package) fn runtime_native_provenance_entry_is_framed(entry: i64) -> i64 { runtime_native_provenance_entry_flags(entry) band 1 }
pub(package) fn runtime_native_provenance_entry_is_named(entry: i64) -> i64 { (runtime_native_provenance_entry_flags(entry) bshr 1) band 1 }

pub(package) fn runtime_native_provenance_entry_name_ptr(entry: i64) -> i64 {
  if runtime_native_provenance_entry_is_valid(entry) == 0 or runtime_native_provenance_entry_is_named(entry) == 0 { 0 }
  else {
    let table = runtime_native_provenance_table()
    table + __mem_load64(entry + 32)
  }
}

pub(package) fn runtime_native_provenance_entry_name_len(entry: i64) -> i64 {
  if runtime_native_provenance_entry_is_valid(entry) == 0 or runtime_native_provenance_entry_is_named(entry) == 0 { 0 } else { __mem_load64(entry + 40) }
}

pub(package) fn runtime_native_provenance_entry_file_index(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 - 1 } else { __mem_load64(entry + 48) } }
pub(package) fn runtime_native_provenance_entry_line(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry + 56) } }
pub(package) fn runtime_native_provenance_entry_col(entry: i64) -> i64 { if runtime_native_provenance_entry_is_valid(entry) == 0 { 0 } else { __mem_load64(entry + 64) } }

pub(package) fn runtime_native_provenance_file_entry(table: i64, index: i64) -> i64 {
  let current = runtime_native_provenance_table()
  if current == 0 or table != current or index < 0 or index >= __mem_load64(current + 32) { 0 }
  else {
    let count = __mem_load64(current + 16)
    current + runtime_native_provenance_header_size() + count * runtime_native_provenance_entry_size() + index * runtime_native_provenance_file_entry_size()
  }
}

pub(package) fn runtime_native_provenance_entry_path_ptr(entry: i64) -> i64 {
  let table = runtime_native_provenance_table()
  let index = runtime_native_provenance_entry_file_index(entry)
  if table == 0 or index < 0 or index >= __mem_load64(table + 32) { 0 }
  else {
    let file = runtime_native_provenance_file_entry(table, index)
    table + __mem_load64(file)
  }
}

pub(package) fn runtime_native_provenance_entry_path_len(entry: i64) -> i64 {
  let table = runtime_native_provenance_table()
  let index = runtime_native_provenance_entry_file_index(entry)
  if table == 0 or index < 0 or index >= __mem_load64(table + 32) { 0 }
  else { __mem_load64(runtime_native_provenance_file_entry(table, index) + 8) }
}
