-- runtime/safe_time.weft — production Time interpretation
--
-- Applications retain the typed Time capability and deterministic tests can
-- replace it. This boundary selects real platform policy while keeping raw
-- clock ids, syscall numbers, pointers and libSystem linkage sealed.

use runtime/time.{runtime_platform_time as runtime_time_handler, runtime_platform_time_with as runtime_time_handler_with}
use stdlib/time.{Time}

pub fn runtime_platform_time(body: () -[Time]> i64) -> i64 {
  runtime_time_handler(body)
}

pub fn runtime_platform_time_with<E>(body: () -[Time, E]> i64) -[E]> i64 {
  runtime_time_handler_with<E>(body)
}
