-- runtime/safe_dir.weft — production typed directory interpretation
--
-- This capability-scoped boundary imports semantic directory and metadata
-- operations only. Target syscall numbers, flags and native record layouts
-- remain sealed behind runtime/dir and the compiler's target emitter.

use runtime/dir.{runtime_dir_getcwd, runtime_dir_list, runtime_dir_lstat, runtime_dir_mkdir, runtime_dir_remove, runtime_dir_rename, runtime_dir_stat}
use runtime/safe_dir_core.{runtime_safe_dir_list_result, runtime_safe_dir_metadata_result, runtime_safe_dir_path_result, runtime_safe_nil_status}
use runtime/safe_file_core.{runtime_safe_path_string}
use stdlib/dir.{DirInspect, DirMutate}

pub fn runtime_platform_dir_inspect(body: () -[DirInspect]> i64) -> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(runtime_dir_list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(runtime_dir_getcwd()))
  }
}

pub fn runtime_platform_dir_inspect_with<E>(body: () -[DirInspect, E]> i64) -[E]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(runtime_dir_list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(runtime_dir_getcwd()))
  }
}

pub fn runtime_platform_dir_mutate(body: () -[DirMutate]> i64) -> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(runtime_dir_mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(runtime_dir_remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(runtime_dir_rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

pub fn runtime_platform_dir_mutate_with<E>(body: () -[DirMutate, E]> i64) -[E]> i64 {
  handle body() {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(runtime_dir_mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(runtime_dir_remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(runtime_dir_rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}

fn runtime_platform_directories_inspect(body: () -[DirInspect, DirMutate]> i64) -[DirMutate]> i64 {
  handle body() {
    DirInspect.list(path) -> resume(runtime_safe_dir_list_result(runtime_dir_list(runtime_safe_path_string(path))))
    DirInspect.stat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_stat(runtime_safe_path_string(path))))
    DirInspect.lstat(path) -> resume(runtime_safe_dir_metadata_result(runtime_dir_lstat(runtime_safe_path_string(path))))
    DirInspect.current() -> resume(runtime_safe_dir_path_result(runtime_dir_getcwd()))
  }
}

pub fn runtime_platform_directories(body: () -[DirInspect, DirMutate]> i64) -> i64 {
  handle runtime_platform_directories_inspect(body) {
    DirMutate.mkdir(path) -> resume(runtime_safe_nil_status(runtime_dir_mkdir(runtime_safe_path_string(path))))
    DirMutate.remove(path) -> resume(runtime_safe_nil_status(runtime_dir_remove(runtime_safe_path_string(path))))
    DirMutate.rename(from, to) -> resume(runtime_safe_nil_status(runtime_dir_rename(runtime_safe_path_string(from), runtime_safe_path_string(to))))
  }
}
