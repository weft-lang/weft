-- runtime/par_queue.weft -- trusted Par queue/deque storage

use runtime/alloc.{*}
use runtime/par_sync.{*}
use runtime/unsafe.{*}

pub(package) fn runtime_par_queue_empty_value() -> i64 { 0 - 1 }
pub(package) fn runtime_par_queue_mutex_offset() -> i64 { 0 }
pub(package) fn runtime_par_queue_buffer_offset() -> i64 { 8 }
pub(package) fn runtime_par_queue_capacity_offset() -> i64 { 16 }
pub(package) fn runtime_par_queue_head_offset() -> i64 { 24 }
pub(package) fn runtime_par_queue_tail_offset() -> i64 { 32 }
pub(package) fn runtime_par_queue_count_offset() -> i64 { 40 }
pub(package) fn runtime_par_queue_size() -> i64 { 48 }

pub(package) fn runtime_par_queue_new(capacity: i64) -> i64 {
  let cap = if capacity <= 0 { 1 } else { capacity }
  let queue = alloc_bump(runtime_par_queue_size())
  __mem_store64(queue + runtime_par_queue_mutex_offset(), runtime_par_pthread_mutex_new())
  __mem_store64(queue + runtime_par_queue_buffer_offset(), alloc_bump(cap * 8))
  __mem_store64(queue + runtime_par_queue_capacity_offset(), cap)
  __mem_store64(queue + runtime_par_queue_head_offset(), 0)
  __mem_store64(queue + runtime_par_queue_tail_offset(), 0)
  __mem_store64(queue + runtime_par_queue_count_offset(), 0)
  queue
}

pub(package) fn runtime_par_queue_destroy(queue: i64) -> i64 {
  runtime_par_pthread_mutex_destroy(__mem_load64(queue + runtime_par_queue_mutex_offset()))
}

pub(package) fn runtime_par_queue_next(index: i64, capacity: i64) -> i64 {
  let next = index + 1
  if next >= capacity { 0 } else { next }
}

pub(package) fn runtime_par_queue_prev(index: i64, capacity: i64) -> i64 {
  if index <= 0 { capacity - 1 } else { index - 1 }
}

pub(package) fn runtime_par_queue_push_raw(queue: i64, item: i64) -[Unsafe]> i64 {
  let mutex = __mem_load64(queue + runtime_par_queue_mutex_offset())
  runtime_par_pthread_mutex_lock_raw(mutex)
  let count = __mem_load64(queue + runtime_par_queue_count_offset())
  let capacity = __mem_load64(queue + runtime_par_queue_capacity_offset())
  if count >= capacity {
    runtime_par_pthread_mutex_unlock_raw(mutex)
    0
  } else {
    let buffer = __mem_load64(queue + runtime_par_queue_buffer_offset())
    let tail = __mem_load64(queue + runtime_par_queue_tail_offset())
    __mem_store64(buffer + tail * 8, item)
    __mem_store64(queue + runtime_par_queue_tail_offset(), runtime_par_queue_next(tail, capacity))
    __mem_store64(queue + runtime_par_queue_count_offset(), count + 1)
    runtime_par_pthread_mutex_unlock_raw(mutex)
    1
  }
}

pub(package) fn runtime_par_queue_pop_raw(queue: i64) -[Unsafe]> i64 {
  let mutex = __mem_load64(queue + runtime_par_queue_mutex_offset())
  runtime_par_pthread_mutex_lock_raw(mutex)
  let count = __mem_load64(queue + runtime_par_queue_count_offset())
  if count <= 0 {
    runtime_par_pthread_mutex_unlock_raw(mutex)
    runtime_par_queue_empty_value()
  } else {
    let buffer = __mem_load64(queue + runtime_par_queue_buffer_offset())
    let capacity = __mem_load64(queue + runtime_par_queue_capacity_offset())
    let head = __mem_load64(queue + runtime_par_queue_head_offset())
    let item = __mem_load64(buffer + head * 8)
    __mem_store64(queue + runtime_par_queue_head_offset(), runtime_par_queue_next(head, capacity))
    __mem_store64(queue + runtime_par_queue_count_offset(), count - 1)
    runtime_par_pthread_mutex_unlock_raw(mutex)
    item
  }
}

pub(package) fn runtime_par_queue_push(queue: i64, item: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_queue_push_raw(queue, item))
  }
}

pub(package) fn runtime_par_queue_pop(queue: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_queue_pop_raw(queue))
  }
}

pub(package) fn runtime_par_deque_new(capacity: i64) -> i64 {
  runtime_par_queue_new(capacity)
}

pub(package) fn runtime_par_deque_destroy(deque: i64) -> i64 {
  runtime_par_queue_destroy(deque)
}

pub(package) fn runtime_par_deque_push_bottom_raw(deque: i64, item: i64) -[Unsafe]> i64 {
  runtime_par_queue_push_raw(deque, item)
}

pub(package) fn runtime_par_deque_pop_bottom_raw(deque: i64) -[Unsafe]> i64 {
  let mutex = __mem_load64(deque + runtime_par_queue_mutex_offset())
  runtime_par_pthread_mutex_lock_raw(mutex)
  let count = __mem_load64(deque + runtime_par_queue_count_offset())
  if count <= 0 {
    runtime_par_pthread_mutex_unlock_raw(mutex)
    runtime_par_queue_empty_value()
  } else {
    let buffer = __mem_load64(deque + runtime_par_queue_buffer_offset())
    let capacity = __mem_load64(deque + runtime_par_queue_capacity_offset())
    let tail = __mem_load64(deque + runtime_par_queue_tail_offset())
    let bottom = runtime_par_queue_prev(tail, capacity)
    let item = __mem_load64(buffer + bottom * 8)
    __mem_store64(deque + runtime_par_queue_tail_offset(), bottom)
    __mem_store64(deque + runtime_par_queue_count_offset(), count - 1)
    runtime_par_pthread_mutex_unlock_raw(mutex)
    item
  }
}

pub(package) fn runtime_par_deque_steal_top_raw(deque: i64) -[Unsafe]> i64 {
  runtime_par_queue_pop_raw(deque)
}

pub(package) fn runtime_par_deque_push_bottom(deque: i64, item: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_deque_push_bottom_raw(deque, item))
  }
}

pub(package) fn runtime_par_deque_pop_bottom(deque: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_deque_pop_bottom_raw(deque))
  }
}

pub(package) fn runtime_par_deque_steal_top(deque: i64) -> i64 {
  handle unsafe_raw_syscall(0, 0, 0, 0, 0, 0, 0) {
    Unsafe.raw_syscall(num, a0, a1, a2, a3, a4, a5) -> resume(runtime_par_deque_steal_top_raw(deque))
  }
}
