-- runtime/safe_process.weft — production child-process interpretation
--
-- Applications retain the typed, mockable Proc capability. Raw startup
-- environment pointers, descriptors, argv packets, wait status and target
-- process primitives remain sealed in runtime/process.

use runtime/process.{runtime_platform_proc as runtime_proc_handler, runtime_platform_proc_time as runtime_proc_time_handler, runtime_platform_proc_with as runtime_proc_handler_with}
use stdlib/process.{Proc}
use stdlib/time.{Time}

pub fn runtime_platform_proc(argc: i64, argv: i64, body: () -[Proc]> i64) -> i64 {
  runtime_proc_handler(argc, argv, body)
}

pub fn runtime_platform_proc_with<E>(argc: i64, argv: i64, body: () -[Proc, E]> i64) -[E]> i64 {
  runtime_proc_handler_with<E>(argc, argv, body)
}

pub fn runtime_platform_proc_time(argc: i64, argv: i64, body: () -[Proc, Time]> i64) -> i64 {
  runtime_proc_time_handler(argc, argv, body)
}
