-- tools/elf_linux_aarch64_smoke.weft -- standalone Linux ELF product fixture
--
-- The generator itself is a Darwin Weft product. Its output is a Linux
-- AArch64 executable containing only exit(42): x0=42, x8=__NR_exit, svc #0.

use compiler/elf.{*}
use compiler/encode.{*}
use runtime/syscall.{sys_write}
use stdlib/bytes as bytes
use stdlib/num
use stdlib/result.{Result}
use stdlib/vector as vector
use stdlib/vector.{*}

fn smoke_append_u32(output: Vector<u8>, value: i64) -> i64 {
  vector_push<u8>(output, (value - value / 256 * 256).to_u8_checked().expect("encoded instruction byte is within u8 range"))
  vector_push<u8>(output, (value / 256 - value / 65536 * 256).to_u8_checked().expect("encoded instruction byte is within u8 range"))
  vector_push<u8>(output, (value / 65536 - value / 16777216 * 256).to_u8_checked().expect("encoded instruction byte is within u8 range"))
  vector_push<u8>(output, (value / 16777216 - value / 4294967296 * 256).to_u8_checked().expect("encoded instruction byte is within u8 range"))
}

pub fn main() -> i64 {
  let code = vector.with_capacity<u8>(12)
  smoke_append_u32(code, arch_encode_movz(arch_aarch64(), 0, 42, 0))
  smoke_append_u32(code, arch_encode_movz(arch_aarch64(), 8, 93, 0))
  smoke_append_u32(code, arch_encode_svc_immediate(arch_aarch64(), 0))
  match emit_elf_aarch64_standalone_executable(bytes.from_vector(code), 0) {
    ElfExecutableEmitted(image) -> {
      let contiguous = image.to_vector()
      sys_write(1, vector_data<u8>(contiguous), vector_len<u8>(contiguous))
      0
    }
    ElfExecutableInvalidEntryOffset(_, _) -> 1
  }
}
