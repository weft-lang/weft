-- tools/elf_linux_aarch64_process_smoke.weft -- Linux typed Proc product
--
-- Generates an ordinary Weft program that runs, captures, times out, drops,
-- and directly matches typed child-process outcomes. The emitted product is
-- a static ELF and reaches Linux only through sealed semantic process leaves.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/safe_process."
    |> str_concat("{")
    |> str_concat("runtime_platform_proc_time")
    |> str_concat("}\nuse stdlib/list.")
    |> str_concat("{")
    |> str_concat("List, list_cons, list_nil")
    |> str_concat("}\nuse stdlib/process.")
    |> str_concat("{")
    |> str_concat("*")
    |> str_concat("}\nuse stdlib/result.")
    |> str_concat("{")
    |> str_concat("Err, Ok")
    |> str_concat("}\nuse stdlib/string.")
    |> str_concat("{")
    |> str_concat("str_eq")
    |> str_concat("}\nuse stdlib/time.")
    |> str_concat("{")
    |> str_concat("Time")
    |> str_concat("}\nfn args1(first: str) -> List<str> ")
    |> str_concat("{")
    |> str_concat(" list_cons<str>(first, list_nil<str>()) ")
    |> str_concat("}")
    |> str_concat("\nfn args2(first: str, second: str) -> List<str> ")
    |> str_concat("{")
    |> str_concat(" list_cons<str>(first, list_cons<str>(second, list_nil<str>())) ")
    |> str_concat("}")
    |> str_concat("\nfn run_exit(command: str, expected: i64) -[Proc]> bool ")
    |> str_concat("{")
    |> str_concat(" match Proc.run(\"/bin/sh\", args2(\"-c\", command)) ")
    |> str_concat("{")
    |> str_concat(" Ok(ProcExited(status)) -> status == expected _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn run_signal() -[Proc]> bool ")
    |> str_concat("{")
    |> str_concat(" match Proc.run(\"/bin/sh\", args2(\"-c\", \"kill -TERM $$\")) ")
    |> str_concat("{")
    |> str_concat(" Ok(ProcSignaled(signal)) -> signal == 15 _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn run_missing() -[Proc]> bool ")
    |> str_concat("{")
    |> str_concat(" match Proc.run(\"/weft-proc-definitely-missing\", list_nil<str>()) ")
    |> str_concat("{")
    |> str_concat(" Err(ProcSpawnFailed(error)) -> error > 0 _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn capture() -[Proc]> bool ")
    |> str_concat("{")
    |> str_concat(" let child: owned ProcHandle = Proc.spawn(\"/bin/sh\", args2(\"-c\", \"printf out; printf err >&2; exit 3\"))")
    |> str_concat(" match Proc.wait(child) ")
    |> str_concat("{")
    |> str_concat(" ProcCompleted(ProcExited(status), stdout_text, stderr_text) -> status == 3 and str_eq(stdout_text, \"out\") == 1 and str_eq(stderr_text, \"err\") == 1 _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn inherited_env() -[Proc]> bool ")
    |> str_concat("{")
    |> str_concat(" let child: owned ProcHandle = Proc.spawn(\"/bin/sh\", args2(\"-c\", \"printf '%s' \\\"$WEFT_PROC_ENV\\\"\"))")
    |> str_concat(" match Proc.wait(child) ")
    |> str_concat("{")
    |> str_concat(" ProcCompleted(ProcExited(status), stdout_text, stderr_text) -> status == 0 and str_eq(stdout_text, \"inherited\") == 1 and str_eq(stderr_text, \"\") == 1 _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn timeout() -[Proc, Time]> bool ")
    |> str_concat("{")
    |> str_concat(" let before = Time.now_nanos()")
    |> str_concat(" let child: owned ProcHandle = Proc.spawn(\"/bin/sh\", args2(\"-c\", \"printf timeout; while :; do :; done\"))")
    |> str_concat(" match Proc.wait_until(child, before + 100000000) ")
    |> str_concat("{")
    |> str_concat(" ProcTimedOut(ProcSignaled(signal), stdout_text, stderr_text) -> signal == 9 and str_eq(stdout_text, \"timeout\") == 1 and str_eq(stderr_text, \"\") == 1 _ -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn abandon() -[Proc]> i64 ")
    |> str_concat("{")
    |> str_concat(" let child: owned ProcHandle = Proc.spawn(\"/bin/sh\", args2(\"-c\", \"while :; do :; done\")) 0 ")
    |> str_concat("}")
    |> str_concat("\nfn exercise() -[Proc, Time]> i64 ")
    |> str_concat("{")
    |> str_concat(" if run_exit(\"exit 7\", 7) == false ")
    |> str_concat("{")
    |> str_concat(" return 71 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if run_signal() == false ")
    |> str_concat("{")
    |> str_concat(" return 72 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if run_missing() == false ")
    |> str_concat("{")
    |> str_concat(" return 73 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if capture() == false ")
    |> str_concat("{")
    |> str_concat(" return 74 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if inherited_env() == false ")
    |> str_concat("{")
    |> str_concat(" return 75 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if timeout() == false ")
    |> str_concat("{")
    |> str_concat(" return 76 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" abandon() ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\npub fn main(argc: i64, argv: i64) -> i64 ")
    |> str_concat("{")
    |> str_concat(" runtime_platform_proc_time(argc, argv, exercise) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
