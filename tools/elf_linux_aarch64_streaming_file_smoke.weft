-- tools/elf_linux_aarch64_streaming_file_smoke.weft -- Linux stream product
--
-- Generates an ordinary typed streaming-file program that exercises every
-- semantic open and seek operation plus read/write/flush/close on Linux.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/safe_file_stream."
    |> str_concat("{ runtime_platform_file_stream}")
    |> str_concat("\nuse stdlib/bytes.")
    |> str_concat("{ bytes_from_str, bytes_from_vector, bytes_to_utf8, bytes_to_vector}")
    |> str_concat("\nuse stdlib/fail.")
    |> str_concat("{ Fail}")
    |> str_concat("\nuse stdlib/file.")
    |> str_concat("{ FileSeekCurrent, FileSeekEnd, FileSeekStart, file_close, file_flush, file_open_append, file_open_read, file_open_read_write, file_open_write, file_read, file_seek, file_write}")
    |> str_concat("\nuse stdlib/io.")
    |> str_concat("{ FileHandle, IO}")
    |> str_concat("\nuse stdlib/io_types.")
    |> str_concat("{ IoError, IoReadProgress, IoWriteProgress, io_error_kind, io_read_progress_count_or, io_write_progress_count}")
    |> str_concat("\nuse stdlib/path.")
    |> str_concat("{ Path, path_from_utf8}")
    |> str_concat("\nuse stdlib/result.")
    |> str_concat("{ Err, Ok, Result}")
    |> str_concat("\nuse stdlib/string.")
    |> str_concat("{ str_eq}\n")
    |> str_concat("fn write_count(result: Result<IoWriteProgress, IoError>) -> i64 { match result { Err(error) -> 0 - io_error_kind(error) Ok(progress) -> io_write_progress_count(progress) } }\n")
    |> str_concat("fn read_count(result: Result<IoReadProgress, IoError>) -> i64 { match result { Err(error) -> 0 - io_error_kind(error) Ok(progress) -> io_read_progress_count_or(progress, 0) } }\n")
    |> str_concat("fn nil_ok(result: Result<nil, IoError>) -> i64 { match result { Err(error) -> 0 Ok(value) -> 1 } }\n")
    |> str_concat("fn seek_position(result: Result<i64, IoError>) -> i64 { match result { Err(error) -> 99 Ok(position) -> position } }\n")
    |> str_concat("fn exercise(path: Path) -[IO, Fail<IoError>]> i64 {")
    |> str_concat(" let mut write_file: owned FileHandle = file_open_write(path)")
    |> str_concat(" let initial = bytes_to_vector(bytes_from_str(\"ab\"))")
    |> str_concat(" let initial_view: [u8] = initial[..]")
    |> str_concat(" let wrote_initial = write_count(file_write(write_file, initial_view))")
    |> str_concat(" let closed_write = nil_ok(file_close(write_file))")
    |> str_concat(" let mut append_file: owned FileHandle = file_open_append(path)")
    |> str_concat(" let suffix = bytes_to_vector(bytes_from_str(\"c\"))")
    |> str_concat(" let suffix_view: [u8] = suffix[..]")
    |> str_concat(" let wrote_suffix = write_count(file_write(append_file, suffix_view))")
    |> str_concat(" let closed_append = nil_ok(file_close(append_file))")
    |> str_concat(" let mut read_file: owned FileHandle = file_open_read(path)")
    |> str_concat(" let first_out = bytes_to_vector(bytes_from_str(\"000\"))")
    |> str_concat(" let first_view: [mut u8] = first_out[..]")
    |> str_concat(" let first_read = read_count(file_read(read_file, first_view))")
    |> str_concat(" let closed_read = nil_ok(file_close(read_file))")
    |> str_concat(" let first_text = match bytes_to_utf8(bytes_from_vector(first_out)) { Err(error) -> 0 Ok(text) -> if str_eq(text, \"abc\") == 1 { 1 } else { 0 } }")
    |> str_concat(" let mut read_write_file: owned FileHandle = file_open_read_write(path)")
    |> str_concat(" let replacement = bytes_to_vector(bytes_from_str(\"xyz\"))")
    |> str_concat(" let replacement_view: [u8] = replacement[..]")
    |> str_concat(" let wrote_replacement = write_count(file_write(read_write_file, replacement_view))")
    |> str_concat(" let flushed = nil_ok(file_flush(read_write_file))")
    |> str_concat(" let start = seek_position(file_seek(read_write_file, 0, FileSeekStart))")
    |> str_concat(" let current = seek_position(file_seek(read_write_file, 1, FileSeekCurrent))")
    |> str_concat(" let ended = seek_position(file_seek(read_write_file, 0 - 3, FileSeekEnd))")
    |> str_concat(" let second_out = bytes_to_vector(bytes_from_str(\"000\"))")
    |> str_concat(" let second_view: [mut u8] = second_out[..]")
    |> str_concat(" let second_read = read_count(file_read(read_write_file, second_view))")
    |> str_concat(" let closed_read_write = nil_ok(file_close(read_write_file))")
    |> str_concat(" let second_text = match bytes_to_utf8(bytes_from_vector(second_out)) { Err(error) -> 0 Ok(text) -> if str_eq(text, \"xyz\") == 1 { 1 } else { 0 } }")
    |> str_concat(" if wrote_initial == 2 and closed_write == 1 and wrote_suffix == 1 and closed_append == 1 and first_read == 3 and closed_read == 1 and first_text == 1 and wrote_replacement == 3 and flushed == 1 and start == 0 and current == 1 and ended == 0 and second_read == 3 and closed_read_write == 1 and second_text == 1 { 0 } else { 70 } }")
    |> str_concat("\npub fn main() -> i64 { match path_from_utf8(\"/tmp/weft-alpha-stream\") { Err(error) -> 80 Ok(path) -> runtime_platform_file_stream(() => handle exercise(path) { Fail.fail(error) -> 90 + io_error_kind(error) }) } }")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
