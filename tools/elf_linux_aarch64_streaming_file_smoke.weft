-- tools/elf_linux_aarch64_streaming_file_smoke.weft -- Linux stream product
--
-- Generates an ordinary typed streaming-file program that exercises every
-- semantic open and seek operation plus read/write/flush/close on Linux.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/file_stream as file_stream_handler"
    |> str_concat("\nuse stdlib/bytes as bytes")
    |> str_concat("\nuse stdlib/fail.")
    |> str_concat("{ Fail}")
    |> str_concat("\nuse stdlib/file as file")
    |> str_concat("\nuse stdlib/file.")
    |> str_concat("{ FileHandle, FileSeekCurrent, FileSeekEnd, FileSeekStart}")
    |> str_concat("\nuse stdlib/io.")
    |> str_concat("{ IO}")
    |> str_concat("\nuse stdlib/io/types.")
    |> str_concat("{ IoEndOfFile, IoError, IoReadBytes, IoReadProgress, IoWriteProgress, IoWroteBytes, io_error_kind}")
    |> str_concat("\nuse stdlib/path as path")
    |> str_concat("\nuse stdlib/path.")
    |> str_concat("{ Path}")
    |> str_concat("\nuse stdlib/result.")
    |> str_concat("{ Err, Ok, Result}")
    |> str_concat("\nuse stdlib/string.")
    |> str_concat("{ str_eq}\n")
    |> str_concat("fn write_count(result: Result<IoWriteProgress, IoError>) -> i64 { match result { Err(error) -> 0 - io_error_kind(error) Ok(progress) -> match progress { IoWroteBytes(count) -> __u64_to_i64(__usize_to_u64(count)) } } }\n")
    |> str_concat("fn read_count(result: Result<IoReadProgress, IoError>) -> i64 { match result { Err(error) -> 0 - io_error_kind(error) Ok(progress) -> match progress { IoEndOfFile -> 0 IoReadBytes(count) -> __u64_to_i64(__usize_to_u64(count)) } } }\n")
    |> str_concat("fn nil_ok(result: Result<nil, IoError>) -> i64 { match result { Err(error) -> 0 Ok(value) -> 1 } }\n")
    |> str_concat("fn seek_position(result: Result<i64, IoError>) -> i64 { match result { Err(error) -> 99 Ok(position) -> position } }\n")
    |> str_concat("fn exercise(path: Path) -[IO, Fail<IoError>]> i64 {")
    |> str_concat(" let mut write_file: owned FileHandle = file.open_write(path)")
    |> str_concat(" let initial = bytes.from_str(\"ab\").to_vector()")
    |> str_concat(" let initial_view: [u8] = initial[..]")
    |> str_concat(" let wrote_initial = write_count(write_file.write(initial_view))")
    |> str_concat(" let closed_write = nil_ok(write_file.close())")
    |> str_concat(" let mut append_file: owned FileHandle = file.open_append(path)")
    |> str_concat(" let suffix = bytes.from_str(\"c\").to_vector()")
    |> str_concat(" let suffix_view: [u8] = suffix[..]")
    |> str_concat(" let wrote_suffix = write_count(append_file.write(suffix_view))")
    |> str_concat(" let closed_append = nil_ok(append_file.close())")
    |> str_concat(" let mut read_file: owned FileHandle = file.open_read(path)")
    |> str_concat(" let first_out = bytes.from_str(\"000\").to_vector()")
    |> str_concat(" let first_view: [mut u8] = first_out[..]")
    |> str_concat(" let first_read = read_count(read_file.read(first_view))")
    |> str_concat(" let closed_read = nil_ok(read_file.close())")
    |> str_concat(" let first_text = match bytes.from_vector(first_out).to_utf8() { Err(error) -> 0 Ok(text) -> if str_eq(text, \"abc\") == 1 { 1 } else { 0 } }")
    |> str_concat(" let mut read_write_file: owned FileHandle = file.open_read_write(path)")
    |> str_concat(" let replacement = bytes.from_str(\"xyz\").to_vector()")
    |> str_concat(" let replacement_view: [u8] = replacement[..]")
    |> str_concat(" let wrote_replacement = write_count(read_write_file.write(replacement_view))")
    |> str_concat(" let flushed = nil_ok(read_write_file.flush())")
    |> str_concat(" let start = seek_position(read_write_file.seek(0, FileSeekStart))")
    |> str_concat(" let current = seek_position(read_write_file.seek(1, FileSeekCurrent))")
    |> str_concat(" let ended = seek_position(read_write_file.seek(0 - 3, FileSeekEnd))")
    |> str_concat(" let second_out = bytes.from_str(\"000\").to_vector()")
    |> str_concat(" let second_view: [mut u8] = second_out[..]")
    |> str_concat(" let second_read = read_count(read_write_file.read(second_view))")
    |> str_concat(" let closed_read_write = nil_ok(read_write_file.close())")
    |> str_concat(" let second_text = match bytes.from_vector(second_out).to_utf8() { Err(error) -> 0 Ok(text) -> if str_eq(text, \"xyz\") == 1 { 1 } else { 0 } }")
    |> str_concat(" if wrote_initial == 2 and closed_write == 1 and wrote_suffix == 1 and closed_append == 1 and first_read == 3 and closed_read == 1 and first_text == 1 and wrote_replacement == 3 and flushed == 1 and start == 0 and current == 1 and ended == 0 and second_read == 3 and closed_read_write == 1 and second_text == 1 { 0 } else { 70 } }")
    |> str_concat("\npub fn main() -> i64 { match path.from_utf8(\"/tmp/weft-alpha-stream\") { Err(error) -> 80 Ok(path) -> with file_stream_handler() { handle exercise(path) { Fail.fail(error) -> 90 + io_error_kind(error) } } } }")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
