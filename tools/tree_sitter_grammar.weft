-- tools/tree_sitter_grammar.weft -- standalone Tree-sitter grammar generator
--
-- This editor/package tool is deliberately not a `weft` compiler subcommand:
-- the full typed concrete grammar would otherwise be linked into every
-- compiler and inflate whole-compiler analysis memory.

use compiler/tree_sitter.{tree_sitter_weft_grammar_source}
use runtime/syscall.{sys_write}

pub fn main() -> i64 {
  let source = tree_sitter_weft_grammar_source()
  sys_write(1, __str_ptr(source), __str_len(source))
  0
}
