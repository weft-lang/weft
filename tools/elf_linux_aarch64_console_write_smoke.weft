-- tools/elf_linux_aarch64_console_write_smoke.weft -- Linux typed output product
--
-- Generates an ordinary Weft program that writes through ConsoleWrite to both
-- standard streams, flushes both streams, and returns the total byte count.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/safe_console_write."
    |> str_concat("{")
    |> str_concat("runtime_platform_console_write")
    |> str_concat("}\nuse stdlib/bytes.")
    |> str_concat("{")
    |> str_concat("bytes_from_str")
    |> str_concat("}\nuse stdlib/console.")
    |> str_concat("{")
    |> str_concat("ConsoleStderr, ConsoleStdout, ConsoleWrite, console_eprint, console_flush, console_print")
    |> str_concat("}\nuse stdlib/num.")
    |> str_concat("{")
    |> str_concat("num_int_cast_value_or, num_u64_to_i64_checked, num_usize_to_u64")
    |> str_concat("}\nuse stdlib/result.")
    |> str_concat("{")
    |> str_concat("Err, Ok")
    |> str_concat("}\nfn count_i64(value: usize) -> i64 ")
    |> str_concat("{")
    |> str_concat(" num_int_cast_value_or<i64>(num_u64_to_i64_checked(num_usize_to_u64(value)), 100) ")
    |> str_concat("}")
    |> str_concat("\nfn write_count() -[ConsoleWrite]> i64 ")
    |> str_concat("{")
    |> str_concat(" let out = match console_print(bytes_from_str(\"out\")) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 100 Ok(count) -> count_i64(count) ")
    |> str_concat("}")
    |> str_concat(" let err = match console_eprint(bytes_from_str(\"err\")) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 100 Ok(count) -> count_i64(count) ")
    |> str_concat("}")
    |> str_concat(" let out_flush = match console_flush(ConsoleStdout) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 100 Ok(value) -> 0 ")
    |> str_concat("}")
    |> str_concat(" let err_flush = match console_flush(ConsoleStderr) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 100 Ok(value) -> 0 ")
    |> str_concat("}")
    |> str_concat(" out + err + out_flush + err_flush ")
    |> str_concat("}")
    |> str_concat("\npub fn main() -> i64 ")
    |> str_concat("{")
    |> str_concat(" runtime_platform_console_write(() => write_count()) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
