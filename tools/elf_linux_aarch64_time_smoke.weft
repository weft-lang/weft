-- tools/elf_linux_aarch64_time_smoke.weft -- Linux typed Time product
--
-- Generates an ordinary Weft program that reads wall and monotonic clocks,
-- sleeps through the Time effect, and checks invalid-duration policy.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/safe_time."
    |> str_concat("{")
    |> str_concat("runtime_platform_time")
    |> str_concat("}\nuse stdlib/time.")
    |> str_concat("{")
    |> str_concat("Time")
    |> str_concat("}\nfn exercise() -[Time]> i64 ")
    |> str_concat("{")
    |> str_concat(" let wall = Time.now_millis()")
    |> str_concat(" let before = Time.now_nanos()")
    |> str_concat(" let invalid = Time.sleep_millis(0 - 1)")
    |> str_concat(" let slept = Time.sleep_millis(2)")
    |> str_concat(" let after = Time.now_nanos()")
    |> str_concat(" if wall < 1700000000000 ")
    |> str_concat("{")
    |> str_concat(" return 71 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if before <= 0 ")
    |> str_concat("{")
    |> str_concat(" return 72 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if invalid != 0 - 1 ")
    |> str_concat("{")
    |> str_concat(" return 73 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if slept != 0 ")
    |> str_concat("{")
    |> str_concat(" return 74 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if after < before + 1000000 ")
    |> str_concat("{")
    |> str_concat(" 75 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat("}")
    |> str_concat("\npub fn main() -> i64 ")
    |> str_concat("{")
    |> str_concat(" runtime_platform_time(exercise) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
