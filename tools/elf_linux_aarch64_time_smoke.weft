-- tools/elf_linux_aarch64_time_smoke.weft -- Linux split time-capability product
--
-- Generates an ordinary Weft program that reads wall and monotonic clocks,
-- sleeps through explicit authority, and checks invalid-duration policy.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  -- Split selected-import braces so the outer source lexer cannot treat
  -- declarations inside this generated program as declarations of this tool.
  let source = "use runtime/time as platform_time\nuse stdlib/result."
    |> str_concat("{")
    |> str_concat("Err, Ok")
    |> str_concat("}\nuse stdlib/time as time")
    |> str_concat("\nuse stdlib/time/monotonic as monotonic")
    |> str_concat("\nuse stdlib/time/monotonic.")
    |> str_concat("{")
    |> str_concat("MonotonicClock")
    |> str_concat("}\nuse stdlib/time/sleep as sleep")
    |> str_concat("\nuse stdlib/time/sleep.")
    |> str_concat("{")
    |> str_concat("InvalidSleepDuration, Sleep")
    |> str_concat("}\nuse stdlib/time/wall as wall")
    |> str_concat("\nuse stdlib/time/wall.")
    |> str_concat("{")
    |> str_concat("WallClock")
    |> str_concat("}")
    |> str_concat("\nfn exercise() -[WallClock, MonotonicClock, Sleep]> i64 ")
    |> str_concat("{")
    |> str_concat(" let wall_millis = match wall.now() { Ok(timestamp) -> timestamp.milliseconds_since_unix_epoch() Err(error) -> 0 }")
    |> str_concat(" let before = monotonic.now().nanoseconds()")
    |> str_concat(" let invalid = match sleep.wait(time.milliseconds(0 - 1)) { Err(InvalidSleepDuration) -> true _ -> false }")
    |> str_concat(" let slept = match sleep.wait(time.milliseconds(2)) { Ok(nil) -> true _ -> false }")
    |> str_concat(" let after = monotonic.now().nanoseconds()")
    |> str_concat(" if wall_millis < 1700000000000 ")
    |> str_concat("{")
    |> str_concat(" return 71 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if before <= 0 ")
    |> str_concat("{")
    |> str_concat(" return 72 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if not invalid ")
    |> str_concat("{")
    |> str_concat(" return 73 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if not slept ")
    |> str_concat("{")
    |> str_concat(" return 74 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if after < before + 1000000 ")
    |> str_concat("{")
    |> str_concat(" 75 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat("}")
    |> str_concat("\npub fn main() -> i64 ")
    |> str_concat("{")
    |> str_concat(" platform_time.with_platform(exercise) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
