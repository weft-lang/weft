-- tools/elf_linux_aarch64_env_smoke.weft -- Linux typed Env product
--
-- Generates an ordinary Weft program that reads argc/argv/envp through the
-- public Env effect and its libc-free production interpretation.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/safe_env."
    |> str_concat("{")
    |> str_concat("runtime_platform_env")
    |> str_concat("}\nuse stdlib/env.")
    |> str_concat("{")
    |> str_concat("Env")
    |> str_concat("}\nuse stdlib/string.")
    |> str_concat("{")
    |> str_concat("str_eq")
    |> str_concat("}\nfn same(value: str?, expected: str) -> bool ")
    |> str_concat("{")
    |> str_concat(" match value ")
    |> str_concat("{")
    |> str_concat(" nil -> false actual: str -> str_eq(actual, expected) == 1 ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn absent(value: str?) -> bool ")
    |> str_concat("{")
    |> str_concat(" match value ")
    |> str_concat("{")
    |> str_concat(" nil -> true actual: str -> false ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn exercise() -[Env]> i64 ")
    |> str_concat("{")
    |> str_concat(" if Env.arg_count() != 4 ")
    |> str_concat("{")
    |> str_concat(" return 71 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if same(Env.arg(1), \"alpha\") == false ")
    |> str_concat("{")
    |> str_concat(" return 72 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if same(Env.arg(2), \"\") == false ")
    |> str_concat("{")
    |> str_concat(" return 73 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if same(Env.arg(3), \"omega\") == false ")
    |> str_concat("{")
    |> str_concat(" return 74 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if absent(Env.arg(4)) == false or absent(Env.arg(0 - 1)) == false ")
    |> str_concat("{")
    |> str_concat(" return 75 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if same(Env.var(\"WEFT_ENV_PRESENT\"), \"hello\") == false ")
    |> str_concat("{")
    |> str_concat(" return 76 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if same(Env.var(\"WEFT_ENV_EMPTY\"), \"\") == false ")
    |> str_concat("{")
    |> str_concat(" return 77 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if absent(Env.var(\"WEFT_ENV_MISSING\")) == false ")
    |> str_concat("{")
    |> str_concat(" return 78 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if absent(Env.var(\"\")) == false ")
    |> str_concat("{")
    |> str_concat(" return 79 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" if absent(Env.var(\"WEFT_ENV_PRESENT=hello\")) == false ")
    |> str_concat("{")
    |> str_concat(" 80 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\npub fn main(argc: i64, argv: i64) -> i64 ")
    |> str_concat("{")
    |> str_concat(" runtime_platform_env(argc, argv, exercise) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
