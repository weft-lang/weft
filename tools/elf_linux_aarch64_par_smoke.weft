-- tools/elf_linux_aarch64_par_smoke.weft -- Linux typed Par product
--
-- Generates an ordinary Weft program that exercises typed Par carriers,
-- managed captures, skewed completion order, and the bounded parallel handler.
-- The emitted ELF reaches Linux only through sealed thread leaves.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use stdlib/par as par\n"
    |> str_concat("fn skew(value: i64) -> i64 {\n")
    |> str_concat("  let rounds = (32 - value) * 1000\n")
    |> str_concat("  let mut remaining = rounds\n")
    |> str_concat("  let mut proof = value\n")
    |> str_concat("  while remaining > 0 { proof = proof + 1 remaining = remaining - 1 }\n")
    |> str_concat("  proof - rounds\n}\n")
    |> str_concat("fn exercise() -[par.Par]> i64 {\n")
    |> str_concat("  let prefix = \"we\"\n")
    |> str_concat("  let left = par.fork<i64>(() => skew(20))\n")
    |> str_concat("  let right = par.fork<i64>(() => skew(21))\n")
    |> str_concat("  let third = par.fork<i64>(() => skew(22))\n")
    |> str_concat("  let text = par.fork<i64>(() => __str_len(prefix))\n")
    |> str_concat("  let right_value = right.join()\n")
    |> str_concat("  let left_value = left.join()\n")
    |> str_concat("  let third_value = third.join()\n")
    |> str_concat("  let text_value = text.join()\n")
    |> str_concat("  if left_value != 20 or right_value != 21 or third_value != 22 or text_value != 2 { 71 } else { 0 }\n")
    |> str_concat("}\n")
    |> str_concat("pub fn main() -> i64 { par.with_pool(4, 16, exercise) }")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
