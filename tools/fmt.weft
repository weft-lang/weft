-- tools/fmt.weft -- standalone thin entry point for the shared formatter

use compiler/diagnostic/render.{*}
use compiler/weft/format.{*}
use compiler/weft/format/config as format_config
use compiler/storage.{*}
use compiler/weft/check/table.{*}
use runtime/memory.{*}
use runtime/syscall.{*}
use runtime/env as environment
use stdlib/env.{Env}
use stdlib/string
use stdlib/diagnostic/schema.{*}
use stdlib/option.{Some, None}

pub fn main(argc: i64, argv: i64) -> i64 {
  with environment(argc, argv) { run() }
}

fn run() -[Env]> i64 {
  let argc = Env.arg_count()
  let config = if argc == 1 { format_config.defaults() }
  else if argc == 3 and Env.arg(1) == "--max-line-length" {
    let text = match Env.arg(2) { value: str -> value, nil -> "" }
    match format_config.from_text(text) {
      Some(config) -> config
      None -> { eprint("fmt: --max-line-length requires one positive integer\n") return 1 }
    }
  } else {
    eprint("usage: fmt [--max-line-length N]\n")
    return 1
  }
  let input = read_stdin_all()
  let src = mem_load64_at(input, 0)
  let n = mem_load64_at(input, 8)
  let tt = ttable_new()
  let result = handle formatter_format_source_with_config(src, n, tt, config) {
    Diagnose.report(diagnostic) -> { diagnose_render_report_in_registry(tt, diagnostic) resume(0) }
    Diagnose.error(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.warn(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
    Diagnose.note(msg, span) -> { diagnose_render(src, msg, span) resume(0) }
  }
  match result {
    FormatterSuccess(formatted) -> {
      sys_write(1, __str_ptr(formatted), __str_len(formatted))
      0
    }
    FormatterFailure(error_count) -> {
      eprint("fmt: parse failed with ")
      eprint_i(error_count)
      eprint(" errors; no output written\n")
      1
    }
  }
}
