-- tools/elf_linux_aarch64_directory_smoke.weft -- Linux directory product
--
-- Generates an ordinary typed program covering directory inspection,
-- metadata, current-directory discovery and namespace mutation on Linux.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/dir_inspect as dir_inspect_handler"
    |> str_concat("\nuse runtime/dir_mutate as dir_mutate_handler")
    |> str_concat("\nuse stdlib/dir as dir")
    |> str_concat("\nuse stdlib/dir.")
    |> str_concat("{ DirDirectory, DirFile, DirInspect, DirMetadata, DirMutate}")
    |> str_concat("\nuse stdlib/bytes as bytes")
    |> str_concat("\nuse stdlib/io/types.")
    |> str_concat("{ IoAlreadyExists, IoError, IoInterrupted, IoInvalidPath, IoInvalidProgress, IoLimitExceeded, IoNotFound, IoPermissionDenied, IoPlatform, IoUnexpectedEof, IoWouldBlock, IoWrongKind}")
    |> str_concat("\nuse stdlib/num.")
    |> str_concat("{ num_i64_to_u8_checked}")
    |> str_concat("\nuse stdlib/path as path")
    |> str_concat("\nuse stdlib/path.")
    |> str_concat("{ Path}")
    |> str_concat("\nuse stdlib/result.")
    |> str_concat("{ Err, Ok, Result}")
    |> str_concat("\nuse stdlib/vector.")
    |> str_concat("{ vector_get_in_bounds, vector_len, vector_push}")
    |> str_concat("\nuse stdlib/vector/handles.")
    |> str_concat("{ Vector}\n")
    |> str_concat("fn checked_path(text: str) -> Path { match path.from_utf8(text) { Ok(path) -> path Err(error) -> match path.from_utf8(\"\") { Ok(path) -> path Err(other) -> checked_path(\"\") } } }\n")
    |> str_concat("fn checked_non_utf8_path(prefix: str) -> Path { let values = bytes.from_str(prefix).to_vector() vector_push<u8>(values, num_i64_to_u8_checked(255).expect(\"fixture byte is within u8 range\")) match path.from_vector(values) { Ok(path) -> path Err(error) -> checked_path(\"\") } }\n")
    |> str_concat("fn io_error_code(error: IoError) -> i64 { match error { IoInterrupted -> 1 IoWouldBlock -> 2 IoNotFound -> 3 IoPermissionDenied -> 4 IoAlreadyExists -> 5 IoWrongKind -> 6 IoInvalidPath -> 7 IoPlatform(code) -> 8 IoLimitExceeded(limit) -> 9 IoUnexpectedEof(received) -> 10 IoInvalidProgress -> 11 } }\n")
    |> str_concat("fn nil_ok(result: Result<nil, IoError>) -> i64 { match result { Ok(value) -> 1 Err(error) -> 0 } }\n")
    |> str_concat("fn nil_error_kind(result: Result<nil, IoError>) -> i64 { match result { Ok(value) -> 0 Err(error) -> io_error_code(error) } }\n")
    |> str_concat("fn directory_metadata(result: Result<DirMetadata, IoError>) -> i64 { match result { Err(error) -> 0 Ok(metadata) -> match metadata.kind { DirDirectory -> if metadata.exists and metadata.device != 0 and metadata.inode > 0 { 1 } else { 0 } other -> 0 } } }\n")
    |> str_concat("fn missing_metadata(result: Result<DirMetadata, IoError>) -> i64 { match result { Err(error) -> 0 Ok(metadata) -> if metadata.exists { 0 } else { 1 } } }\n")
    |> str_concat("fn file_metadata(result: Result<DirMetadata, IoError>) -> i64 { match result { Err(error) -> 0 Ok(metadata) -> match metadata.kind { DirFile -> if metadata.exists and metadata.size > 0 { 1 } else { 0 } other -> 0 } } }\n")
    |> str_concat("fn list_has(result: Result<Vector<Path>, IoError>, target: Path) -> i64 { match result { Err(error) -> 100 + io_error_code(error) Ok(entries) -> { let mut found = 0 for i in 0..vector_len<Path>(entries) { if vector_get_in_bounds<Path>(entries, i).eq(target) { found = 1 } else { 0 } } if found == 1 { 1 } else { 10 + vector_len<Path>(entries) } } } }\n")
    |> str_concat("fn current_ok(result: Result<Path, IoError>) -> i64 { match result { Err(error) -> 0 Ok(path) -> if path.len() > 0 and path.is_absolute() { 1 } else { 0 } } }\n")
    |> str_concat("fn exercise() -[DirInspect, DirMutate]> i64 {")
    |> str_concat(" let base = checked_path(\"/tmp/weft-alpha-directory\")")
    |> str_concat(" let renamed = checked_path(\"/tmp/weft-alpha-directory-renamed\")")
    |> str_concat(" let parent = checked_path(\"/tmp\")")
    |> str_concat(" let entry_name = checked_path(\"weft-alpha-directory-renamed\")")
    |> str_concat(" let byte_path = checked_non_utf8_path(\"/tmp/weft-alpha-directory-\")")
    |> str_concat(" let byte_name = checked_non_utf8_path(\"weft-alpha-directory-\")")
    |> str_concat(" let file = checked_path(\"/etc/hosts\")")
    |> str_concat(" dir.remove(base) dir.remove(renamed) dir.remove(byte_path)")
    |> str_concat(" let created = nil_ok(dir.create(base))")
    |> str_concat(" let duplicate = nil_error_kind(dir.create(base))")
    |> str_concat(" let moved = nil_ok(dir.rename(base, renamed))")
    |> str_concat(" let old_missing = missing_metadata(dir.metadata(base))")
    |> str_concat(" let followed = directory_metadata(dir.metadata(renamed))")
    |> str_concat(" let direct = directory_metadata(dir.symlink_metadata(renamed))")
    |> str_concat(" let listed = list_has(dir.list(parent), entry_name)")
    |> str_concat(" let ordinary_file = file_metadata(dir.metadata(file))")
    |> str_concat(" let current = current_ok(dir.current())")
    |> str_concat(" let removed = nil_ok(dir.remove(renamed))")
    |> str_concat(" let missing_remove = nil_error_kind(dir.remove(renamed))")
    |> str_concat(" let byte_created = nil_ok(dir.create(byte_path))")
    |> str_concat(" let byte_listed = list_has(dir.list(parent), byte_name)")
    |> str_concat(" let byte_metadata = directory_metadata(dir.metadata(byte_path))")
    |> str_concat(" let byte_removed = nil_ok(dir.remove(byte_path))")
    |> str_concat(" if created != 1 { 71 } else { if duplicate != 5 { 72 } else { if moved != 1 { 73 } else { if old_missing != 1 { 74 } else { if followed != 1 { 75 } else { if direct != 1 { 76 } else { if listed != 1 { listed } else { if ordinary_file != 1 { 78 } else { if current != 1 { 79 } else { if removed != 1 { 80 } else { if missing_remove != 3 { 81 } else { if byte_created != 1 { 82 } else { if byte_listed != 1 { 83 } else { if byte_metadata != 1 { 84 } else { if byte_removed != 1 { 85 } else { 0 } } } } } } } } } } } } } } } } }\n")
    |> str_concat("pub fn main() -> i64 { with dir_inspect_handler() { with dir_mutate_handler() { exercise() } } }")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
