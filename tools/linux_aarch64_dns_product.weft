-- Ordinary typed DNS product compiled as a static Linux/aarch64 executable by
-- elf_linux_aarch64_dns_smoke.weft. A hermetic Docker network supplies the
-- `weft-dns.test` answer during target-local execution.

use runtime/dns_linux.{runtime_platform_linux_dns}
use stdlib/dns.{DnsAnyFamily, DnsIpv4Only, DnsResolve, dns_resolve}
use stdlib/idna.{DomainName, domain_name_parse}
use stdlib/net_address.{SocketV4, SocketV6, ipv4_address}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{vector_get_in_bounds, vector_len}

fn dns_product_domain(source: str) -> DomainName {
  domain_name_parse(source).expect("static DNS product name must be valid")
}

fn dns_product_probe() -[DnsResolve]> i64 {
  let localhost = match dns_resolve(dns_product_domain("localhost."), 443, DnsAnyFamily) {
    Err(_) -> false
    Ok(candidates) -> vector_len(candidates) > 0
  }
  if not localhost { return 81 } else { nil }

  let numeric = match dns_resolve(dns_product_domain("127.0.0.1."), 0, DnsIpv4Only) {
    Err(_) -> false
    Ok(candidates) -> if vector_len(candidates) != 1 { false }
    else { match vector_get_in_bounds(candidates, 0) {
      SocketV4(address, port) -> address == ipv4_address(127, 0, 0, 1) and port == 0
      SocketV6(_, _, _) -> false
    } }
  }
  if not numeric { return 82 } else { nil }

  match dns_resolve(dns_product_domain("weft-dns.test."), 8443, DnsIpv4Only) {
    Err(_) -> 83
    Ok(candidates) -> if vector_len(candidates) == 0 { 84 }
    else { match vector_get_in_bounds(candidates, 0) {
      SocketV4(address, port) -> if port == 8443 { 0 } else { 85 }
      SocketV6(_, _, _) -> 86
    } }
  }
}

pub fn main() -> i64 {
  runtime_platform_linux_dns(dns_product_probe)
}
