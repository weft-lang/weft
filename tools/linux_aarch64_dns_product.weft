-- Ordinary typed DNS product compiled as a static Linux/aarch64 executable by
-- elf_linux_aarch64_dns_smoke.weft. A hermetic Docker network supplies the
-- `weft-dns.test` answer during target-local execution.

use runtime/dns as platform_dns
use stdlib/dns as dns
use stdlib/dns.{DnsAnyFamily, DnsIpv4Only, DnsResolve}
use stdlib/idna as idna
use stdlib/idna.{DomainName}
use stdlib/net_address as net
use stdlib/net_address.{SocketV4, SocketV6}
use stdlib/option.{Some, None}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{Vector}

fn dns_product_domain(source: str) -> DomainName {
  idna.parse(source).expect("static DNS product name must be valid")
}

fn dns_product_probe() -[DnsResolve]> i64 {
  let localhost = match dns.resolve(dns_product_domain("localhost."), 443, DnsAnyFamily) {
    Err(_) -> false
    Ok(candidates) -> candidates.len() > 0
  }
  if not localhost { return 81 } else { nil }

  let numeric = match dns.resolve(dns_product_domain("127.0.0.1."), 0, DnsIpv4Only) {
    Err(_) -> false
    Ok(candidates) -> if candidates.len() != 1 { false }
    else { match candidates.get(0) {
      Some(SocketV4(address, port)) -> address == net.ipv4(127, 0, 0, 1) and port == 0
      Some(SocketV6(_, _, _)) -> false
      None -> false
    } }
  }
  if not numeric { return 82 } else { nil }

  match dns.resolve(dns_product_domain("weft-dns.test."), 8443, DnsIpv4Only) {
    Err(_) -> 83
    Ok(candidates) -> match candidates.get(0) {
      Some(SocketV4(address, port)) -> if port == 8443 { 0 } else { 85 }
      Some(SocketV6(_, _, _)) -> 86
      None -> 84
    }
  }
}

pub fn main() -> i64 {
  with platform_dns() { dns_product_probe() }
}
