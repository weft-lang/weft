-- Ordinary typed Proc/Spawn/Time/shutdown product compiled as a static
-- Linux/aarch64 executable by elf_linux_aarch64_shutdown_smoke.weft.

use runtime/process as process_handler
use stdlib/cancellation as cancellation
use stdlib/cancellation.{CancellationOutcome}
use stdlib/list.{Cons, List, Nil}
use stdlib/process.{Proc, ProcHandle}
use stdlib/shutdown as shutdown
use stdlib/spawn as spawn
use stdlib/time as time
use stdlib/vector.{vector_get_in_bounds, vector_len, vector_new, vector_push}
use stdlib/vector/handles.{Vector}

fn shutdown_product_args(command: str) -> List<str> {
  Cons<str>("-c", Cons<str>(command, Nil<str>()))
}

fn shutdown_product_wait(trace: Vector<i64>) -[Proc, time.Time]> i64 {
  defer vector_push<i64>(trace, 1)
  {
    defer vector_push<i64>(trace, 2)
    let child: owned ProcHandle = Proc.spawn(
      "/bin/sh",
      shutdown_product_args("kill -TERM $PPID $PPID $PPID")
    )
    time.sleep_millis(10000)
    let output = Proc.wait(child)
    71
  }
}

fn shutdown_product_signal(outcome: CancellationOutcome<i64>) -> i64 {
  match outcome {
    cancellation.CancellationCompleted(value) -> 0 - value
    cancellation.CancellationCancelled(reason) -> match reason {
      cancellation.CancellationShutdown(signal) -> match signal {
        shutdown.ShutdownInterrupt() -> 2
        shutdown.ShutdownTerminate() -> 15
      }
      cancellation.CancellationRequested() -> 0 - 1
      cancellation.CancellationDeadlineExceeded(deadline) -> 0 - 2
    }
  }
}

fn shutdown_product_trace(trace: Vector<i64>) -> i64 {
  if vector_len<i64>(trace) != 2 { 0 }
  else {
    vector_get_in_bounds<i64>(trace, 0) * 10 +
      vector_get_in_bounds<i64>(trace, 1)
  }
}

fn shutdown_product_probe() -[Proc]> i64 {
  -- A normally completed first scope exercises mask restoration before a
  -- second scope proves a real process signal wakes epoll through signalfd.
  let completed = match spawn.with_event_loop_shutdown(() => 7) {
    cancellation.CancellationCompleted(value) -> value == 7
    cancellation.CancellationCancelled(reason) -> false
  }
  if not completed { return 72 } else { nil }

  let trace = vector_new<i64>()
  let outcome = spawn.with_event_loop_shutdown(
    () => shutdown_product_wait(trace)
  )
  if shutdown_product_signal(outcome) != 15 { 73 }
  else { if shutdown_product_trace(trace) != 21 { 74 } else { 0 } }
}

pub fn main(argc: i64, argv: i64) -> i64 {
  with process_handler(argc, argv) { shutdown_product_probe() }
}
