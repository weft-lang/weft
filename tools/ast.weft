-- Parse-only AST inspection shares the compiler's Grammar product and renderer.

use compiler/weft/syntax/inspection as inspection
use compiler/source/input.{source_from_bytes}
use compiler/pipeline.{
  PipelineParseResult,
  pipeline_parse_local_with_error_count,
  pipeline_ast_source_declarations
}
use compiler/weft/check/table.{ttable_new}
use compiler/storage.{read_stdin_all, eprint}
use runtime/memory.{mem_load64_at}

pub fn main() -> i64 {
  let input = read_stdin_all()
  let source = source_from_bytes(mem_load64_at(input, 0), mem_load64_at(input, 8))
  let parsed = pipeline_parse_local_with_error_count(source, ttable_new())
  let declarations = match parsed {
    PipelineParseResult(ast, _) -> pipeline_ast_source_declarations(ast)
  }
  eprint(inspection.render(declarations, source.text))
  0
}
