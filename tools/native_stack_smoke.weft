-- Executable contract test for stack-address materialization and spill scratch
-- registers. Direct emitter calls keep the large offsets explicit even if
-- ordinary source optimization would eliminate or reassign the test values.

use compiler/backend/aarch64/codegen.{*}
use compiler/backend/elf.{*}
use compiler/backend/aarch64/encode.{*}
use compiler/backend/link.{*}
use compiler/backend/macho.{emit_native_link_macho}
use compiler/backend/target.{*}
use runtime/buffer.{*}
use runtime/memory.{mem_load8}
use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/console as console
use stdlib/console/terminal as terminal
use stdlib/list.{Nil}
use stdlib/num
use stdlib/result.{Err, Ok, Result}
use stdlib/vector as vector

fn expect_register(code: i64, register: i64, expected: i64) -> nil {
  emit_mov_imm_safe(code, 1, expected)
  bu32(code, encode_cmp(register, 1))
  bu32(code, encode_cset(2, 1))
  bu32(code, encode_orr_reg(19, 19, 2))
  nil
}

fn native_stack_write(image: Bytes) -> i64 {
  with terminal() {
    match console.write_stdout(image) {
      Ok(_) -> 0
      Err(_) -> 1
    }
  }
}

pub fn main() -> i64 {
  let code = buf_new(1024)
  emit_stack_sub(code, 65536)
  emit_mov_imm_safe(code, 19, 0)
  emit_mov_imm_safe(code, 17, 13)
  emit_store_spill_offset(code, 17, 40000)
  emit_mov_imm_safe(code, 17, 37)
  emit_store_spill_offset(code, 17, 40008)

  -- A forwarded rhs survives the lhs load; reversing the operand roles must
  -- preserve the already loaded lhs as well.
  emit_mov_imm_safe(code, 17, 9)
  emit_load_spill_offset(code, 16, 40000)
  bu32(code, encode_add_reg(17, 16, 17))
  expect_register(code, 17, 22)
  emit_mov_imm_safe(code, 16, 5)
  emit_load_spill_offset(code, 17, 40008)
  bu32(code, encode_add_reg(17, 16, 17))
  expect_register(code, 17, 42)

  emit_mov_imm_safe(code, 15, 31)
  emit_mov_imm_safe(code, 16, 37)
  emit_mov_imm_safe(code, 17, 41)
  emit_load_spill_offset(code, 0, 40000)
  expect_register(code, 0, 13)
  expect_register(code, 15, 31)
  expect_register(code, 16, 37)
  expect_register(code, 17, 41)

  emit_store_spill_offset(code, 17, 40016)
  expect_register(code, 15, 31)
  expect_register(code, 17, 41)
  emit_load_spill_offset(code, 0, 40016)
  expect_register(code, 0, 41)
  emit_mov_imm_safe(code, 16, 47)
  emit_store_spill_offset(code, 16, 40024)
  expect_register(code, 15, 31)
  expect_register(code, 16, 47)
  emit_load_spill_offset(code, 0, 40024)
  expect_register(code, 0, 47)

  emit_stack_add(code, 65536)
  bu32(code, encode_add_imm(0, 19, 0))
  let target = native_link_target_host()
  cg_emit_platform_syscall(code, target, 1, 93)
  match target {
    NativeLinkMacosAarch64 -> {
      let plan = NativeLinkPlan(
        target,
        code,
        Nil<NativeLinkLibrary>(),
        Nil<NativeLinkImport>(),
        Nil<NativeLinkPlanRelocation>(),
        0,
        NativeLinkDebugInformationAbsent,
        Nil<NativeArtifactTrustGrant>()
      )
      match native_link_resolve(plan) {
        NativeLinkSucceeded(graph, _) -> native_stack_write(
          emit_native_link_macho(graph)
        )
        NativeLinkRejected(_) -> 1
      }
    }
    NativeLinkLinuxAarch64 -> {
      let mut instructions = vector.new<u8>()
      for i in 0..buf_len(code) {
        instructions.push(
          mem_load8(buf_ptr(code) + i).to_u8_checked().expect("instruction byte is in range")
        )
      }
      match emit_elf_aarch64_standalone_executable(
        bytes.from_vector(instructions),
        0,
        bytes.empty(),
        0,
        nil
      ) {
        ElfExecutableEmitted(image) -> native_stack_write(image)
        ElfExecutableInvalidEntryOffset(_, _) -> 1
      }
    }
  }
}
