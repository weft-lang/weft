-- tools/elf_linux_aarch64_console_read_smoke.weft -- Linux typed console read product
--
-- Generates an ordinary Weft program that installs the production ConsoleRead
-- handler and returns the number of bytes read from standard input. Raw
-- descriptors, buffers, and syscall numbers remain below that public effect.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  -- Braces are separate fragments because braces inside a source string are
  -- Weft interpolation delimiters in this generator, not generated syntax.
  let source = "use runtime/safe_console_read."
    |> str_concat("{")
    |> str_concat("runtime_platform_console_read")
    |> str_concat("}\nuse stdlib/bytes.")
    |> str_concat("{")
    |> str_concat("bytes_len")
    |> str_concat("}\nuse stdlib/console.")
    |> str_concat("{")
    |> str_concat("ConsoleRead, console_read")
    |> str_concat("}\nuse stdlib/result.")
    |> str_concat("{")
    |> str_concat("Err, Ok")
    |> str_concat("}\nfn read_count() -[ConsoleRead]> i64 ")
    |> str_concat("{")
    |> str_concat(" match console_read(4) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 100 Ok(values) -> bytes_len(values) ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\npub fn main() -> i64 ")
    |> str_concat("{")
    |> str_concat(" runtime_platform_console_read(() => read_count()) ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
