use module_fixtures/compiler_probe.{require_checked}
-- tools/elf_linux_aarch64_console_read_smoke.weft -- Linux typed console read product
--
-- Generates an ordinary Weft program that installs the production ConsoleRead
-- handler and returns the number of bytes read from standard input. Raw
-- descriptors, buffers, and syscall numbers remain below that public effect.

use compiler/backend/target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use stdlib/console/input as input\ndefault handler input()\n"
    |> str_concat("use stdlib/console.{read_bytes}\nuse stdlib/num\n")
    |> str_concat("use stdlib/result.{Err, Ok}\n")
    |> str_concat("fn count_i64(value: usize) -> i64 { ")
    |> str_concat("match value.to_u64().to_i64_checked() { ")
    |> str_concat("Err(error) -> 100 Ok(converted) -> converted } }\n")
    |> str_concat("fn read_count() -> i64 { match read_bytes(4) { ")
    |> str_concat("Err(error) -> 100 Ok(values) -> count_i64(values.len()) } }\n")
    |> str_concat("pub fn main() -> i64 { read_count() }")
  let typed = require_checked(pipeline_check_source_standalone(__str_ptr(source), __str_len(source)))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
