-- Ordinary typed DNS transport product compiled as a static Linux/aarch64
-- executable by elf_linux_aarch64_dns_transport_smoke.weft. A hermetic
-- adversarial nameserver on a private Docker network serves the fixed
-- `weft.test` zone, and the first configured nameserver is deliberately
-- unroutable so kernel receive deadlines and server failover run for real.

use runtime/dns.{runtime_platform_dns}
use stdlib/dns.{DnsAnyFamily, DnsError, DnsFamily, DnsFamilyUnavailable, DnsIpv4Only, DnsIpv6Only, DnsNameNotFound, DnsPermanentFailure, DnsPlatform, DnsPolicyDenied, DnsResolve, DnsResourceExhausted, DnsTemporaryFailure, dns_resolve}
use stdlib/eq.{Eq}
use stdlib/idna.{DomainName, domain_name_parse}
use stdlib/net_address as net
use stdlib/net_address.{SocketV4, SocketV6}
use stdlib/result.{Err, Ok, Result}
use stdlib/vector.{vector_get_in_bounds, vector_len}

fn dns_transport_domain(source: str) -> DomainName {
  domain_name_parse(source).expect("static DNS transport name must be valid")
}

fn dns_transport_error_code(error: DnsError) -> i64 {
  match error {
    DnsNameNotFound -> 1
    DnsTemporaryFailure -> 2
    DnsPermanentFailure -> 3
    DnsFamilyUnavailable -> 4
    DnsPolicyDenied -> 5
    DnsResourceExhausted -> 6
    DnsPlatform(_) -> 7
  }
}

fn dns_transport_failure(name: str, family: DnsFamily) -[DnsResolve]> i64 {
  match dns_resolve(dns_transport_domain(name), 53, family) {
    Ok(_) -> 0
    Err(error) -> dns_transport_error_code(error)
  }
}

fn dns_transport_probe() -[DnsResolve]> i64 {
  -- The zone answers this name over UDP with TC=1 and no records, so only a
  -- framed TCP retry can carry the address.
  let truncated = match dns_resolve(dns_transport_domain("truncated.weft.test."), 8053, DnsIpv4Only) {
    Err(_) -> false
    Ok(candidates) -> if vector_len(candidates) != 1 { false }
    else { match vector_get_in_bounds(candidates, 0) {
      SocketV4(address, port) -> address.eq(net.ipv4(198, 51, 100, 7)) and port == 8053
      SocketV6(_, _, _) -> false
    } }
  }
  if not truncated { return 71 } else { nil }

  -- Authoritative refusals stay typed and distinct from empty answers.
  if dns_transport_failure("missing.weft.test.", DnsIpv4Only) != 1 { return 72 } else { nil }
  if dns_transport_failure("refused.weft.test.", DnsIpv4Only) != 3 { return 73 } else { nil }
  if dns_transport_failure("nodata.weft.test.", DnsIpv4Only) != 4 { return 74 } else { nil }
  if dns_transport_failure("missing.weft.test.", DnsAnyFamily) != 1 { return 75 } else { nil }

  -- Dual-family resolution preserves resolver observation order: AAAA first.
  let dual = match dns_resolve(dns_transport_domain("weft-dns.test."), 443, DnsAnyFamily) {
    Err(_) -> false
    Ok(candidates) -> if vector_len(candidates) != 2 { false }
    else { match vector_get_in_bounds(candidates, 0) {
      SocketV6(address, port, scope) ->
        address.eq(net.ipv6(8193, 3512, 0, 0, 0, 0, 0, 16)) and port == 443 and scope == 0
      SocketV4(_, _) -> false
    } and match vector_get_in_bounds(candidates, 1) {
      SocketV4(address, port) -> address.eq(net.ipv4(192, 0, 2, 10)) and port == 443
      SocketV6(_, _, _) -> false
    } }
  }
  if not dual { return 76 } else { nil }

  -- The same zone narrows to exactly its AAAA record under an IPv6-only policy.
  match dns_resolve(dns_transport_domain("weft-dns.test."), 443, DnsIpv6Only) {
    Err(_) -> 77
    Ok(candidates) -> if vector_len(candidates) != 1 { 78 }
    else { match vector_get_in_bounds(candidates, 0) {
      SocketV6(address, port, scope) ->
        if address.eq(net.ipv6(8193, 3512, 0, 0, 0, 0, 0, 16)) { 0 } else { 79 }
      SocketV4(_, _) -> 80
    } }
  }
}

pub fn main() -> i64 {
  runtime_platform_dns(dns_transport_probe)
}
