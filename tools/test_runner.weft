-- tools/test_runner.weft -- native test runner capability showcase
--
-- Usage: ./test_runner ./weft test/basics.weft test/effects.weft ...
--        ./test_runner ./weft test/
--
-- This is ordinary untrusted code. Env supplies arguments, Dir recursively
-- discovers .weft files, Time supplies monotonic deadlines/timings, and Proc
-- spawns the compiler with captured output. The trusted platform handlers are
-- installed once at main; no shell command, raw descriptor, or Unsafe surface
-- crosses into this file.

use compiler/lib.{*}
use runtime/process.{Proc, ProcOutput}
use runtime/tool_platform.{*}
use stdlib/dir.{*}
use stdlib/env.{Env}
use stdlib/list.{*}
use stdlib/num.{*}
use stdlib/process.{*}
use stdlib/string.{*}
use stdlib/time.{*}
use stdlib/vector.{*}

fn runner_timeout_nanos() -> i64 { 120000000000 }

fn runner_add_unique(paths: Vector<str>, path: str) -> i64 {
  if vector_contains<str>(paths, path) == 1 { 0 }
  else { vector_push<str>(paths, path) 1 }
}

fn runner_join_path(dir: str, name: str) -> str {
  if str_ends_with(dir, "/") == 1 { str_concat(dir, name) }
  else { str_concat(dir, str_concat("/", name)) }
}

fn runner_directory_identity_add(identities: Vector<i64>, metadata: DirMetadata) -> i64 {
  let mut i = 0
  let mut duplicate = false
  while i < vector_len<i64>(identities) and duplicate == false {
    if vector_get_in_bounds<i64>(identities, i) == metadata.device and
      vector_get_in_bounds<i64>(identities, i + 1) == metadata.inode {
      duplicate = true
    } else { i = i + 2 }
  }
  if duplicate { 0 }
  else {
    vector_push<i64>(identities, metadata.device)
    vector_push<i64>(identities, metadata.inode)
    1
  }
}

fn runner_report_directory_error(dir: str, error: i64) -> i64 {
  eprint("test_runner: could not list directory: ")
  eprint(dir)
  eprint(" (errno ")
  eprint_i(error)
  eprint(")\n")
  1
}

fn runner_report_inspect_error(path: str, error: i64) -> i64 {
  eprint("test_runner: could not inspect path: ")
  eprint(path)
  eprint(" (errno ")
  eprint_i(error)
  eprint(")\n")
  1
}

fn runner_collect_directory(paths: Vector<str>, root: str, root_metadata: DirMetadata) -[Dir]> i64 {
  let pending = vector_new<str>()
  let identities = vector_new<i64>()
  runner_directory_identity_add(identities, root_metadata)
  runner_add_unique(pending, root)
  let mut index = 0
  let mut matched = 0
  let mut failures = 0
  while index < vector_len<str>(pending) {
    let dir = vector_get_in_bounds<str>(pending, index)
    match Dir.list(dir) {
      Err(error) -> { failures = failures + runner_report_directory_error(dir, error) 0 }
      Ok(entries) -> {
        vector_sort<str>(entries)
        for i in 0..vector_len<str>(entries) {
          let name = vector_get_in_bounds<str>(entries, i)
          let path = runner_join_path(dir, name)
          match Dir.stat(path) {
            Err(error) -> { failures = failures + runner_report_inspect_error(path, error) 0 }
            Ok(metadata) -> {
              if metadata.exists and dir_kind_code(metadata.kind) == 2 {
                if runner_directory_identity_add(identities, metadata) == 1 {
                  runner_add_unique(pending, path)
                } else { 0 }
              } else { if metadata.exists and dir_kind_code(metadata.kind) == 1 and str_ends_with(name, ".weft") == 1 {
                matched = matched + 1
                runner_add_unique(paths, path)
              } else { 0 } }
              0
            }
          }
        }
        vector_sort<str>(pending)
        0
      }
    }
    index = index + 1
  }
  if matched == 0 and failures == 0 {
    eprint("test_runner: no .weft files in directory: ")
    eprint(root)
    eprint("\n")
    1
  } else { failures }
}

fn runner_collect_arg(paths: Vector<str>, path: str) -[Dir]> i64 {
  match Dir.stat(path) {
    Err(error) -> {
      eprint("test_runner: could not inspect path: ")
      eprint(path)
      eprint(" (errno ")
      eprint_i(error)
      eprint(")\n")
      1
    }
    Ok(metadata) -> {
      if metadata.exists == false {
        eprint("test_runner: path does not exist: ")
        eprint(path)
        eprint("\n")
        1
      } else { if dir_kind_code(metadata.kind) == 2 {
        runner_collect_directory(paths, path, metadata)
      } else {
        runner_add_unique(paths, path)
        0
      } }
    }
  }
}

fn runner_test_args(file: str) -> List<str> {
  list_cons<str>("test",
    list_cons<str>("--jobs",
      list_cons<str>("1",
        list_cons<str>(file, list_nil<str>()))))
}

fn runner_elapsed_millis(start: i64, finish: i64) -> i64 {
  if start < 0 or finish < start { 0 } else { (finish - start) / 1000000 }
}

type RunnerStructuredTestResult {
  RunnerStructuredTestResult(i64, i64, i64), -- passed, failed, total
  MissingRunnerStructuredTestResult
}

fn runner_result_last_prefix(text: str, prefix: str) -> i64 {
  let mut search = 0
  let mut found = 0 - 1
  let mut done = 0
  while done == 0 {
    let next = str_find_from(text, prefix, search)
    if next < 0 {
      done = 1
    } else {
      found = next
      search = next + 1
    }
  }
  found
}

fn runner_parse_structured_result(text: str) -> RunnerStructuredTestResult {
  let prefix = "WEFT_TEST_RESULT 1 "
  let start = runner_result_last_prefix(text, prefix)
  if start < 0 {
    MissingRunnerStructuredTestResult
  } else {
    let passed_parse = num_parse_i64_prefix(text, start + str_len(prefix))
    let passed_end = num_parse_i64_next_pos(passed_parse)
    if num_parse_i64_is_ok(passed_parse) == 0 or passed_end >= str_len(text) or str_byte_at(text, passed_end) != 32 {
      MissingRunnerStructuredTestResult
    } else {
      let failed_parse = num_parse_i64_prefix(text, passed_end + 1)
      let failed_end = num_parse_i64_next_pos(failed_parse)
      if num_parse_i64_is_ok(failed_parse) == 0 or failed_end >= str_len(text) or str_byte_at(text, failed_end) != 32 {
        MissingRunnerStructuredTestResult
      } else {
        let total_parse = num_parse_i64_prefix(text, failed_end + 1)
        let total_end = num_parse_i64_next_pos(total_parse)
        let passed = num_parse_i64_value_or(passed_parse, 0 - 1)
        let failed = num_parse_i64_value_or(failed_parse, 0 - 1)
        let total = num_parse_i64_value_or(total_parse, 0 - 1)
        if num_parse_i64_is_ok(total_parse) == 0 or total_end >= str_len(text) or str_byte_at(text, total_end) != 10 or passed < 0 or failed < 0 or total < 0 or passed + failed != total {
          MissingRunnerStructuredTestResult
        } else {
          RunnerStructuredTestResult(passed, failed, total)
        }
      }
    }
  }
}

fn runner_result_is_valid(result: RunnerStructuredTestResult) -> i64 {
  match result {
    RunnerStructuredTestResult(passed, failed, total) -> 1
    MissingRunnerStructuredTestResult -> 0
  }
}

fn runner_result_failed_count(result: RunnerStructuredTestResult) -> i64 {
  match result {
    RunnerStructuredTestResult(passed, failed, total) -> failed
    MissingRunnerStructuredTestResult -> 0
  }
}

fn runner_report(file: str, output: ProcOutput, elapsed_millis: i64) -> i64 {
  let result = runner_parse_structured_result(output.stderr_text)
  let result_valid = runner_result_is_valid(result)
  let result_failures = runner_result_failed_count(result)
  let expected_status = if result_failures == 0 { 0 } else { 1 }
  let protocol_error = result_valid == 0 or output.status != expected_status
  let failed = output.error != 0 or output.timed_out or output.status > 1 or protocol_error or result_failures != 0
  if failed {
    if str_len(output.stdout_text) > 0 { eprint(output.stdout_text) } else { 0 }
    if str_len(output.stderr_text) > 0 { eprint(output.stderr_text) } else { 0 }
    eprint("  FAIL: ")
  } else {
    -- Test programs may intentionally write stdout. Proc captures it so the
    -- runner must replay it even though normal harness output lives on stderr.
    if str_len(output.stdout_text) > 0 { eprint(output.stdout_text) } else { 0 }
    eprint("  pass: ")
  }
  eprint(file)
  eprint(" (")
  eprint_i(elapsed_millis)
  eprint(" ms")
  if output.timed_out { eprint(", timeout") }
  else { if output.error != 0 {
    eprint(", error ")
    eprint_i(output.error)
  } else { if output.status > 1 {
    eprint(", exit ")
    eprint_i(output.status)
  } else { if protocol_error {
    eprint(", invalid test-result protocol")
  } else { if result_failures != 0 {
    eprint(", ")
    eprint_i(result_failures)
    eprint(" tests failed")
  } else { 0 } } } } }
  eprint(")\n")
  if failed { 1 } else { 0 }
}

fn run_test_file(weft: str, file: str) -[Proc, Time]> i64 {
  let start = Time.now_nanos()
  let deadline = if start < 0 { 0 - 1 } else { start + runner_timeout_nanos() }
  let output = Proc.wait_until(Proc.spawn(weft, runner_test_args(file)), deadline)
  runner_report(file, output, runner_elapsed_millis(start, Time.now_nanos()))
}

fn run_all_tests() -[Dir, Env, Proc, Time]> i64 {
  match Env.arg(1) {
    nil -> {
      eprint("test_runner: argument vector changed during execution\n")
      1
    }
    weft: str -> {
      let paths = vector_new<str>()
      let mut discovery_failures = 0
      for i in 2..Env.arg_count() {
        match Env.arg(i) {
          nil -> {
            eprint("test_runner: argument vector changed during execution\n")
            discovery_failures = discovery_failures + 1
          }
          path: str -> {
            discovery_failures = discovery_failures + runner_collect_arg(paths, path)
          }
        }
      }
      vector_sort<str>(paths)
      let mut pass = 0
      let mut fail = discovery_failures
      for i in 0..vector_len<str>(paths) {
        let result = run_test_file(weft, vector_get_in_bounds<str>(paths, i))
        if result == 0 { pass = pass + 1 } else { fail = fail + 1 }
      }
      eprint("\n")
      eprint_i(pass)
      eprint(" passed, ")
      eprint_i(fail)
      eprint(" failed\n")
      if fail == 0 { 0 } else { 1 }
    }
  }
}

fn runner_entry() -[Dir, Env, Proc, Time]> i64 {
  if Env.arg_count() < 3 {
    eprint("usage: test_runner <weft> <paths...>\n")
    1
  } else { run_all_tests() }
}

pub fn main(argc: i64, argv: i64) -> i64 {
  runtime_platform_tool(argc, argv, runner_entry)
}
