-- tools/test_runner.weft — Native test runner using posix_spawn
-- Usage: ./test_runner ./weft test/basics.weft test/effects.weft ...

use "stdlib/process.weft"

fn cstr_len(ptr: i64) -> i64 {
  let mut i = 0
  while __mem_load8(ptr + i) != 0 { i = i + 1 }
  i
}

fn cstr_copy(dst: i64, src: i64) -> i64 {
  let mut i = 0
  while __mem_load8(src + i) != 0 {
    __mem_store8(dst + i, __mem_load8(src + i))
    i = i + 1
  }
  i
}

fn str_copy(dst: i64, s: str) -> i64 {
  let p = __str_ptr(s)
  let l = __str_len(s)
  let mut i = 0
  while i < l { __mem_store8(dst + i, __mem_load8(p + i)) i = i + 1 }
  l
}

fn run_test_file(weft: i64, file: i64) -> i64 {
  let cmd = __bump_alloc(512)
  let mut p = 0
  p = p + cstr_copy(cmd + p, weft)
  p = p + str_copy(cmd + p, " test < ")
  p = p + cstr_copy(cmd + p, file)
  p = p + str_copy(cmd + p, " > /tmp/_wtr 2>/dev/null; chmod +x /tmp/_wtr 2>/dev/null; /tmp/_wtr")
  __mem_store8(cmd + p, 0)
  let sh = make_cstr("/bin/sh")
  let flag = make_cstr("-c")
  let argv = __bump_alloc(32)
  __mem_store64(argv, sh)
  __mem_store64(argv + 8, flag)
  __mem_store64(argv + 16, cmd)
  __mem_store64(argv + 24, 0)
  run_command(sh, argv)
}

fn main(argc: i64, argv: i64) -> i64 {
  if argc < 3 {
    eprint("usage: test_runner <weft> <files...>\n")
    1
  } else { run_all_tests(argc, argv) }
}

fn run_all_tests(argc: i64, argv: i64) -> i64 {
  let weft = __mem_load64(argv + 8)
  let mut pass = 0
  let mut fail = 0
  let mut i = 2
  while i < argc {
    let file = __mem_load64(argv + i * 8)
    let r = run_test_file(weft, file)
    if r == 0 {
      eprint("  pass: ")
      sys_write(2, file, cstr_len(file))
      eprint("\n")
      pass = pass + 1
    } else {
      eprint("  FAIL: ")
      sys_write(2, file, cstr_len(file))
      eprint("\n")
      fail = fail + 1
    }
    i = i + 1
  }
  eprint("\n")
  eprint_i(pass)
  eprint(" passed, ")
  eprint_i(fail)
  eprint(" failed\n")
  fail
}
