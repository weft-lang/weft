-- tools/test_runner.weft — Native test runner over the Env/Proc capability
-- effects. Usage: ./test_runner ./weft test/basics.weft test/effects.weft ...
--
-- This tool is ordinary untrusted code: arguments arrive as str values via
-- the Env effect and processes run through the Proc effect; the trusted
-- platform handlers are installed once at the program boundary in main.
-- A test can mock either capability by installing its own handler.

use "compiler/lib.weft"
use "stdlib/string.weft"
use "stdlib/list.weft"
use "stdlib/process.weft"

-- $$ keeps the compiled binary's path unique per spawn: macOS kills
-- binaries rewritten at a previously-executed path (signature cache).
fn runner_command(weft: str, file: str) -> str {
  str_concat(weft, str_concat(" test < ", str_concat(file, " > /tmp/_wtr$$ 2>/dev/null; chmod +x /tmp/_wtr$$; /tmp/_wtr$$; s=$?; rm -f /tmp/_wtr$$; exit $s")))
}

fn run_test_file(weft: str, file: str) -[Proc]> i64 {
  Proc.run("/bin/sh", list_cons<str>("-c", list_cons<str>(runner_command(weft, file), list_nil<str>())))
}

fn run_all_tests() -[Env, Proc]> i64 {
  let weft = Env.arg(1)
  let argc = Env.arg_count()
  let mut pass = 0
  let mut fail = 0
  for i in 2..argc {
    let file = Env.arg(i)
    let r = run_test_file(weft, file)
    if r == 0 {
      eprint("  pass: ")
      eprint(file)
      eprint("\n")
      pass = pass + 1
    } else {
      eprint("  FAIL: ")
      eprint(file)
      eprint("\n")
      fail = fail + 1
    }
  }
  eprint("\n")
  eprint_i(pass)
  eprint(" passed, ")
  eprint_i(fail)
  eprint(" failed\n")
  fail
}

fn runner_entry() -[Env, Proc]> i64 {
  if Env.arg_count() < 3 {
    eprint("usage: test_runner <weft> <files...>\n")
    1
  } else { run_all_tests() }
}

fn main(argc: i64, argv: i64) -> i64 {
  runtime_platform_env_proc(argc, argv, () => runner_entry())
}
