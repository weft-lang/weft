-- tools/elf_linux_aarch64_dynamic_smoke.weft -- ELF dynamic product
--
-- Resolve one manifest-style import through the shared native link graph and
-- emit a Linux executable with an explicit interpreter, DT_NEEDED identity,
-- non-lazy symbol relocation, and the ordinary function/file/line DWARF view.
-- The Debian/AArch64 product gate supplies the declared libc deployment leaf;
-- getuid returns zero in that isolated root and becomes the process status.

use compiler/elf_link.{*}
use compiler/encode.{*}
use compiler/native_link.{*}
use compiler/native_target.{*}
use compiler/package.{NativeLibraryLicenseUnspecified}
use runtime/buffer.{*}
use runtime/syscall.{sys_write}
use stdlib/list.{*}
use stdlib/vector.{vector_data, vector_len}

pub fn main() -> i64 {
  let code = buf_new(12)
  bu32(code, encode_bl(0))
  bu32(code, encode_movz(8, 93, 0))
  bu32(code, 3556769793)
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkDynamicLibrary(
      "c",
      "/lib/aarch64-linux-gnu/libc.so.6",
      "libc.so.6",
      "sha256:fixture",
      NativeLibraryLicenseUnspecified,
      list_nil<NativeLinkDynamicLoad>()
    ),
    list_nil<NativeLinkLibrary>()
  )
  let imports = list_cons<NativeLinkImport>(
    NativeLinkImport("getuid", 0, NativeLinkManifestImport(0)),
    list_nil<NativeLinkImport>()
  )
  let relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(0, 0),
    list_nil<NativeLinkPlanRelocation>()
  )
  let functions = list_cons<NativeLinkDebugFunction>(
    NativeLinkDebugFunction(0, 12, "main", "dynamic_product.weft", 1, 1, false),
    list_nil<NativeLinkDebugFunction>()
  )
  let plan = NativeLinkPlan(
    NativeLinkLinuxAarch64,
    code,
    libraries,
    imports,
    relocations,
    0,
    NativeLinkDwarfFunctionLineInformation(functions),
    list_nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(plan) {
    NativeLinkRejected(errors) -> 2
    NativeLinkSucceeded(graph, facts) -> match emit_native_link_elf(graph) {
      ElfNativeLinkEmitted(image) -> {
        let output = image.to_vector()
        sys_write(1, vector_data<u8>(output), vector_len<u8>(output))
        0
      }
      _ -> 3
    }
  }
}
