-- tools/elf_linux_aarch64_readiness_smoke.weft
-- Linux static TaskScope/Sleep/TCP-readiness product generator

use compiler/lib.{read_file_text}
use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/memory.{mem_load64_at}
use runtime/syscall.{sys_write}

pub fn main() -> i64 {
  let source = read_file_text("tools/linux_aarch64_readiness_product.weft")
  let source_ptr = mem_load64_at(source, 0)
  let source_len = mem_load64_at(source, 8)
  let typed = pipeline_check_source_standalone(source_ptr, source_len)
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, source_ptr, PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
