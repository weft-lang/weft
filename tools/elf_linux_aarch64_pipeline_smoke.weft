use module_fixtures/compiler_probe.{require_checked}
-- tools/elf_linux_aarch64_pipeline_smoke.weft -- real compiler-pipeline ELF
--
-- This Darwin-hosted fixture checks and lowers ordinary Weft source with the
-- typed Linux target, resolves the shared LinkPlan -> LinkGraph, finalizes it
-- as a standalone ELF image, and writes only that image to stdout.
use compiler/backend/target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use stdlib/console as console
use stdlib/console/terminal as terminal
use stdlib/result.{Err, Ok}

pub fn main() -> i64 {
  let source = "pub fn main() -> i64 { 42 }"
  let typed = require_checked(
    pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  )
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let binary = pipeline_emit_native_binary(native, __str_ptr(source))
  let output = pipeline_binary_bytes(binary)
  if pipeline_native_emit_error_count(native) == 0 and
    pipeline_native_unmaterialized_trap_count(native) == 0 and
    pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and
    not output.is_empty() {
      with terminal() { match console.write_stdout(output) { Ok(_) -> 0, Err(_) -> 1 } }
    } else { 1 }
}
