-- tools/elf_linux_aarch64_archive_smoke.weft -- ELF static archive product
--
-- Read an archive from stdin, resolve one manifest-style import through the
-- shared native link graph, and emit a static Linux executable. The fixture
-- function returns 42; the compiler-owned root preserves that value as the
-- process exit status.

use compiler/elf_link.{*}
use compiler/encode.{*}
use compiler/lib.{read_fd_all}
use compiler/native_link.{*}
use compiler/native_target.{*}
use compiler/package.{NativeLibraryLicenseUnspecified}
use runtime/buffer.{*}
use runtime/memory.{mem_load64_at}
use runtime/syscall.{sys_write}
use stdlib/bytes.{bytes_to_vector}
use stdlib/list.{*}
use stdlib/vector.{vector_data, vector_len}

pub fn main() -> i64 {
  let archive = read_fd_all(0)
  let archive_bytes = mem_load64_at(archive, 0)
  let archive_len = mem_load64_at(archive, 8)
  let code = buf_new(12)
  bu32(code, encode_bl(0))
  bu32(code, encode_movz(8, 93, 0))
  bu32(code, 3556769793)
  let libraries = list_cons<NativeLinkLibrary>(
    NativeLinkStaticArchive(
      "fixture",
      "libweft_linux_archive_fixture.a",
      "sha256:fixture",
      NativeLibraryLicenseUnspecified,
      archive_bytes,
      archive_len
    ),
    list_nil<NativeLinkLibrary>()
  )
  let imports = list_cons<NativeLinkImport>(
    NativeLinkImport("weft_linux_archive_value", 0, NativeLinkManifestImport(0)),
    list_nil<NativeLinkImport>()
  )
  let relocations = list_cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(0, 0),
    list_nil<NativeLinkPlanRelocation>()
  )
  let plan = NativeLinkPlan(
    NativeLinkLinuxAarch64,
    code,
    libraries,
    imports,
    relocations,
    0,
    NativeLinkDebugInformationAbsent,
    list_nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(plan) {
    NativeLinkRejected(errors) -> 2
    NativeLinkSucceeded(graph, facts) -> match emit_native_link_elf(graph) {
      ElfNativeLinkEmitted(image) -> {
        let output = bytes_to_vector(image)
        sys_write(1, vector_data<u8>(output), vector_len<u8>(output))
        0
      }
      _ -> 3
    }
  }
}
