-- tools/elf_linux_aarch64_archive_smoke.weft -- ELF static archive product
--
-- Read an archive from stdin, resolve one manifest-style import through the
-- shared native link graph, and emit a static Linux executable. The fixture
-- fixture combines initialized and zero-fill storage to return 42; the
-- compiler-owned root preserves that value as the process exit status.

use compiler/backend/binary.{binary_u32}
use compiler/backend/elf_link.{*}
use compiler/backend/aarch64/encode.{*}
use compiler/backend/link.{*}
use compiler/backend/target.{*}
use compiler/package/manifest.{NativeLibraryLicenseUnspecified}
use stdlib/bytes as bytes
use stdlib/bytes/builder as byte_builder
use stdlib/console as console
use stdlib/console/input as input
use stdlib/console/terminal as terminal
use stdlib/list.{Cons, Nil}
use stdlib/result.{Err, Ok}

pub fn main() -> i64 {
  let archive = with input() {
    match console.read_all(__i64_to_usize(16777216)) {
      Ok(values) -> values
      Err(_) -> bytes.empty()
    }
  }
  let mut code = byte_builder.new()
  binary_u32(code, encode_bl(0))
  binary_u32(code, encode_movz(8, 93, 0))
  binary_u32(code, 3556769793)
  let libraries = Cons<NativeLinkLibrary>(
    NativeLinkStaticArchive(
      "fixture",
      "libweft_linux_archive_fixture.a",
      "sha256:fixture",
      NativeLibraryLicenseUnspecified,
      archive
    ),
    Nil<NativeLinkLibrary>()
  )
  let imports = Cons<NativeLinkImport>(
    NativeLinkImport("weft_linux_archive_value", 0, NativeLinkManifestImport(0)),
    Nil<NativeLinkImport>()
  )
  let relocations = Cons<NativeLinkPlanRelocation>(
    NativeLinkPlanBranch26(0, 0),
    Nil<NativeLinkPlanRelocation>()
  )
  let plan = NativeLinkPlan(
    NativeLinkLinuxAarch64,
    code.finish(),
    libraries,
    imports,
    relocations,
    0,
    NativeLinkDebugInformationAbsent,
    Nil<NativeArtifactTrustGrant>()
  )
  match native_link_resolve(plan) {
    NativeLinkRejected(errors) -> 2
    NativeLinkSucceeded(graph, facts) -> match emit_native_link_elf(graph) {
      ElfNativeLinkEmitted(image) -> with terminal() {
        match console.write_stdout(image) {
          Ok(_) -> 0
          Err(_) -> 4
        }
      }
      _ -> 3
    }
  }
}
