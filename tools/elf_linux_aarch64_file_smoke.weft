-- tools/elf_linux_aarch64_file_smoke.weft -- Linux typed whole-file product
--
-- Generates an ordinary program exercising every FileWriteMode, bounded
-- FileRead success/failure, and typed errno families through the production
-- capability-scoped file interpretation.

use compiler/native_target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use runtime/buffer.{buf_len, buf_ptr}
use runtime/syscall.{sys_write}
use stdlib/string.{str_concat}

pub fn main() -> i64 {
  let source = "use runtime/file_read as file_read_handler\nuse runtime/file_write as file_write_handler\nuse stdlib/bytes as bytes\nuse stdlib/file as file\nuse stdlib/file."
    |> str_concat("{")
    |> str_concat("FileRead, FileWrite")
    |> str_concat("}\nuse stdlib/io/types.")
    |> str_concat("{")
    |> str_concat("IoAlreadyExists, IoError, IoLimitExceeded")
    |> str_concat("}\nuse stdlib/path as path\nuse stdlib/path.")
    |> str_concat("{")
    |> str_concat("Path")
    |> str_concat("}\nuse stdlib/result.")
    |> str_concat("{")
    |> str_concat("Err, Ok, Result")
    |> str_concat("}\nuse stdlib/string.")
    |> str_concat("{")
    |> str_concat("str_eq")
    |> str_concat("}\nfn expect_count(result: Result<usize, IoError>, expected: usize, failure: i64) -> i64 ")
    |> str_concat("{")
    |> str_concat(" match result ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> failure Ok(count) -> if count == expected ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" failure ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn exercise_path(path: Path) -[FileRead, FileWrite]> i64 ")
    |> str_concat("{")
    |> str_concat(" let created = expect_count(file.create_new(path, bytes.from_str(\"ab\")), 2, 10) if created != 0 ")
    |> str_concat("{")
    |> str_concat(" return created ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" match file.create_new(path, bytes.from_str(\"z\")) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> match error ")
    |> str_concat("{")
    |> str_concat(" IoAlreadyExists -> 0 _ -> return 11 ")
    |> str_concat("}")
    |> str_concat(" Ok(count) -> return 12 ")
    |> str_concat("}")
    |> str_concat(" let appended = expect_count(file.append_all(path, bytes.from_str(\"cd\")), 2, 13) if appended != 0 ")
    |> str_concat("{")
    |> str_concat(" return appended ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" match file.read_all(path, 4) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> return 14 Ok(values) -> match values.to_utf8() ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> return 15 Ok(text) -> if str_eq(text, \"abcd\") == 1 ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" return 16 ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat(" match file.read_all(path, 3) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> match error ")
    |> str_concat("{")
    |> str_concat(" IoLimitExceeded(limit) -> if limit == 3 ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" return 17 ")
    |> str_concat("}")
    |> str_concat(" _ -> return 18 ")
    |> str_concat("}")
    |> str_concat(" Ok(values) -> return 19 ")
    |> str_concat("}")
    |> str_concat(" let truncated = expect_count(file.write_all(path, bytes.from_str(\"q\")), 1, 20) if truncated != 0 ")
    |> str_concat("{")
    |> str_concat(" return truncated ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" let replaced = expect_count(file.atomic_replace(path, bytes.from_str(\"xy\")), 2, 21) if replaced != 0 ")
    |> str_concat("{")
    |> str_concat(" return replaced ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" match file.read_all(path, 2) ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 22 Ok(values) -> match values.to_utf8() ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 23 Ok(text) -> if str_eq(text, \"xy\") == 1 ")
    |> str_concat("{")
    |> str_concat(" 0 ")
    |> str_concat("}")
    |> str_concat(" else ")
    |> str_concat("{")
    |> str_concat(" 24 ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\nfn exercise() -[FileRead, FileWrite]> i64 ")
    |> str_concat("{")
    |> str_concat(" match path.from_utf8(\"/tmp/weft-alpha-file\") ")
    |> str_concat("{")
    |> str_concat(" Err(error) -> 1 Ok(path) -> exercise_path(path) ")
    |> str_concat("}")
    |> str_concat(" ")
    |> str_concat("}")
    |> str_concat("\npub fn main() -> i64 ")
    |> str_concat("{")
    |> str_concat(" with file_read_handler() { with file_write_handler() { exercise() } } ")
    |> str_concat("}")
  let typed = pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(native, __str_ptr(source), PipelineNativeDebugInformationStripped)
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_buf(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and buf_len(output) > 0 {
        sys_write(1, buf_ptr(output), buf_len(output))
        0
      } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
