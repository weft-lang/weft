-- tools/check.weft — Weft type checker (no codegen)
--
-- Tool-as-handler-configuration: parse + check, no lower/emit.
-- Same pipeline as the compiler but stops after type checking.
-- The LSP would use this same subset with incremental handlers.

use compiler/backend/aarch64/codegen.{*}
use compiler/storage.{*}
use compiler/pipeline.{*}
use compiler/weft/check/body.{*}
use runtime/memory.{*}
use stdlib/grammar.{Checked, CheckRejected}

pub fn main() -> i64 {
  let input = read_stdin_all()
  let src = mem_load64_at(input, 0)
  let n = mem_load64_at(input, 8)
  match pipeline_check_source_standalone(src, n) {
    Checked(typed) -> {
      let fns = pipeline_typed_fns(typed)
      eprint("check: ")
      eprint_i(nlist_len(fns))
      eprint(" functions, 0 errors\n")
      0
    }
    CheckRejected -> { eprint("check: source rejected\n"); 1 }
  }
}
