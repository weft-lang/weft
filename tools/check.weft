-- tools/check.weft — Weft type checker (no codegen)
--
-- Tool-as-handler-configuration: parse + check, no lower/emit.
-- Same pipeline as the compiler but stops after type checking.
-- The LSP would use this same subset with incremental handlers.

use "compiler/codegen.weft"
use "compiler/typeck.weft"
use "compiler/grammar.weft"
use "compiler/pipeline.weft"

fn main() -> i64 {
  let src = __bump_alloc(131072)
  let n = sys_read(0, src, 131072)
  let grammar = weft_grammar()
  let tt = ttable_new()
  let fns = pipeline_parse(grammar, src, n, tt)
  pipeline_check_module(fns, src, tt)
  let nfns = nlist_len(fns)
  eprint("check: ")
  eprint_i(nfns)
  eprint(" functions, 0 errors\n")
  0
}
