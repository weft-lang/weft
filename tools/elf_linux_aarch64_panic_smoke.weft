use module_fixtures/compiler_probe.{require_checked}
-- tools/elf_linux_aarch64_panic_smoke.weft -- Linux fatal substrate product
--
-- Generates an ordinary Weft program whose panic path must write through the
-- target-selected kernel operation and terminate with the stable panic status.
use compiler/backend/target.{NativeLinkLinuxAarch64}
use compiler/pipeline.{*}
use stdlib/console as console
use stdlib/console/terminal as terminal
use stdlib/result.{Err, Ok}

pub fn main() -> i64 {
  let source = "use stdlib/panic.{ panic }\npub fn main() -> i64 { panic(\"linux panic\") }\n"
  let typed = require_checked(
    pipeline_check_source_standalone(__str_ptr(source), __str_len(source))
  )
  let native = pipeline_lower_native_ir_for_target_closed(typed, NativeLinkLinuxAarch64)
  let product = pipeline_checked_native_product(
    native,
    __str_ptr(source),
    PipelineNativeDebugInformationStripped
  )
  match product {
    PipelineNativeProductReady(binary, facts) -> {
      let output = pipeline_binary_bytes(binary)
      if pipeline_binary_kind(binary) == pipeline_binary_kind_elf_executable() and
        not output.is_empty() {
          with terminal() { match console.write_stdout(output) { Ok(_) -> 0, Err(_) -> 1 } }
        } else { 1 }
    }
    PipelineNativeProductFailed(binary) -> 1
  }
}
