-- Direct-loop control for iterator_pipeline.weft over the same values.

fn direct_sum(n: i64) -> i64 {
  let mut acc = 0
  let mut remaining = n / 3
  for value in 0..n {
    let mapped = value * 3 + 1
    if remaining > 0 and mapped % 2 == 0 {
      acc = acc + mapped
      remaining = remaining - 1
    } else { 0 }
  }
  acc
}

fn main() -> i64 {
  let mut total = 0
  for repetition in 0..300 {
    total = total + direct_sum(1000000 + repetition * 3)
  }
  if total == 100089626820300 { 0 } else { 1 }
}
