-- Comparative benchmark: Mandelbrot escape count over f64 arithmetic.
-- Expected checksum: 3 runs * 17067 bounded points on a 256x256 grid = 51201.

use stdlib/num.{*}

fn mandelbrot_count(size: i64, max_iter: i64) -> i64 {
  let inv_size = 1.0 / size.to_f64()
  let mut total: i64 = 0

  for y in 0..size {
    let ci = y.to_f64() * 2.0 * inv_size - 1.0
    for x in 0..size {
      let cr = x.to_f64() * 3.0 * inv_size - 2.0
      let mut zr: f64 = 0.0
      let mut zi: f64 = 0.0
      let mut mag2: f64 = 0.0
      let mut iter: i64 = 0

      while iter < max_iter and mag2 <= 4.0 {
        let zr2 = zr * zr
        let zi2 = zi * zi
        let next_zi = 2.0 * zr * zi
        let next_zr = zr2 - zi2
        zi = next_zi + ci
        zr = next_zr + cr
        let mag_zr = zr * zr
        let mag_zi = zi * zi
        mag2 = mag_zr + mag_zi
        iter = iter + 1
      }

      if iter == max_iter { total = total + 1 } else { 0 }
    }
  }

  total
}

fn main() -> i64 {
  let size = 256
  let max_iter = 80
  let runs = 3
  let mut total = 0

  for i in 0..runs {
    total = total + mandelbrot_count(size, max_iter)
  }

  if total == 51201 { 0 } else { 1 }
}
