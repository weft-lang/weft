-- Lazy range/map/filter/take/fold pipeline over the public iterator surface.

use stdlib/iter.{*}

fn iterator_sum(n: i64) -> i64 {
  let mapped = iter_map<i64, i64>(iter_range(0, n), (value: i64) => value * 3 + 1)
  let filtered = iter_filter<i64>(mapped, (value: i64) => if value % 2 == 0 { 1 } else { 0 })
  let limited = iter_take<i64>(filtered, n / 3)
  iter_fold<i64, i64>(limited, 0, (acc: i64, value: i64) => acc + value)
}

fn main() -> i64 {
  let mut total = 0
  for repetition in 0..10 {
    total = total + iterator_sum(10000)
  }
  if total == 333300000 { 0 } else { 1 }
}
