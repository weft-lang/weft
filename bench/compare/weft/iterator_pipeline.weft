-- Lazy range/map/filter/take/fold pipeline over the public iterator surface.

use stdlib/iter as iter
use stdlib/num.{*}
use stdlib/result.{*}

fn iterator_sum(n: i64) -> i64 {
  let mapped = iter.map(iter.range(0, n), (value: i64) => value * 3 + 1)
  let filtered = iter.filter(mapped, (value: i64) => value % 2 == 0)
  let limit = (n / 3).to_usize_checked().unwrap_or(0)
  let limited = iter.take(filtered, limit)
  iter.fold(limited, 0, (acc: i64, value: i64) => acc + value)
}

fn main() -> i64 {
  let mut total = 0
  for repetition in 0..10 {
    total = total + iterator_sum(10000)
  }
  if total == 333300000 { 0 } else { 1 }
}
