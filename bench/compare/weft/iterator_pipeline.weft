-- Lazy range/map/filter/take/fold pipeline over the public iterator surface.

use stdlib/iter as iter
use stdlib/num.{*}
use stdlib/result.{*}

fn iterator_sum(n: i64) -> i64 {
  let limit = (n / 3).to_usize_checked().unwrap_or(0)
  iter.range(0, n)
    |> iter.map((value: i64) => value * 3 + 1)
    |> iter.filter((value: i64) => value % 2 == 0)
    |> iter.take(limit)
    |> iter.fold(0, (acc: i64, value: i64) => acc + value)
}

fn main() -> i64 {
  let mut total = 0
  for repetition in 0..300 {
    total = total + iterator_sum(1000000 + repetition * 3)
  }
  if total == 100089626820300 { 0 } else { 1 }
}
