-- Comparative benchmark: vector-backed insertion sort plus binary search.
-- Reverse input stresses nested loops and vector get/set call overhead.

use "stdlib/vector.weft"

fn insertion_sort_i64(items: i64) -> i64 {
  let len = vector_len(items)
  let mut i = 1
  while i < len {
    let key = vector_get<i64>(items, i, 0)
    let mut j = i - 1
    let mut moving = 1
    while moving == 1 {
      if j >= 0 and vector_get<i64>(items, j, 0) > key {
        vector_set<i64>(items, j + 1, vector_get<i64>(items, j, 0))
        j = j - 1
      } else {
        moving = 0
      }
    }
    vector_set<i64>(items, j + 1, key)
    i = i + 1
  }
  items
}

fn binary_search_i64(items: i64, needle: i64) -> i64 {
  let mut lo = 0
  let mut hi = vector_len(items)
  let mut found = 0 - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let value = vector_get<i64>(items, mid, 0)
    if value == needle {
      found = mid
      lo = hi
    } else {
      if value < needle {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
  }
  found
}

fn build_reverse(n: i64) -> i64 {
  let items = vector_with_capacity<i64>(n)
  let mut i = n - 1
  while i >= 0 {
    vector_push<i64>(items, i)
    i = i - 1
  }
  items
}

fn checksum_i64(items: i64) -> i64 {
  vector_fold<i64, i64>(items, 0, (acc: i64, x: i64) => acc + x)
}

fn run_once(n: i64) -> i64 {
  let items = build_reverse(n)
  insertion_sort_i64(items)
  let sum = checksum_i64(items)
  let a = binary_search_i64(items, 0)
  let b = binary_search_i64(items, n / 2)
  let c = binary_search_i64(items, n - 1)
  sum + a + b + c
}

fn main() -> i64 {
  let n = 600
  let runs = 5
  let mut total = 0
  for i in 0..runs {
    total = total + run_once(n)
  }
  if total == 902995 { 0 } else { 1 }
}
