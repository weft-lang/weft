-- Comparative benchmark: stdlib heapsort plus binary search.
-- Reverse input stresses vector access, swaps, and comparator dispatch.

use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/num
use stdlib/option.{None, Option, Some}
use stdlib/result.{Result}

fn binary_search_i64(items: [i64], needle: i64) -> Option<usize> {
  let mut lo: usize = 0
  let mut hi = items.len
  let mut found = None<usize>()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    match items[mid] {
      value if value == needle -> {
        found = Some<usize>(mid)
        lo = hi
      }
      value if value < needle -> { lo = mid + 1 }
      _ -> { hi = mid }
    }
  }
  found
}

fn build_reverse(n: i64) -> owned Vector<i64> {
  let mut items = vector.with_capacity<i64>(n.to_usize_checked().expect("benchmark size is nonnegative"))
  let mut i = n - 1
  while i >= 0 {
    items.push(i)
    i = i - 1
  }
  items
}

fn checksum_i64(items: borrow Vector<i64>) -> i64 {
  items.fold<i64>(0, (acc: i64, x: i64) => acc + x)
}

fn run_once(n: i64) -> i64 {
  let items = build_reverse(n)
  let sorted = items.sort()
  let sum = checksum_i64(sorted)
  let a = binary_search_i64(sorted[..], 0).expect("first value exists").to_u64().to_i64_checked().expect("index fits checksum")
  let b = binary_search_i64(sorted[..], n / 2).expect("middle value exists").to_u64().to_i64_checked().expect("index fits checksum")
  let c = binary_search_i64(sorted[..], n - 1).expect("last value exists").to_u64().to_i64_checked().expect("index fits checksum")
  sum + a + b + c
}

fn main() -> i64 {
  let n = 30000
  let runs = 60
  let mut total = 0
  for i in 0..runs {
    total = total + run_once(n + i)
  }
  if total == 27054936800 { 0 } else { 1 }
}
