-- Comparative benchmark: stdlib heapsort plus binary search.
-- Reverse input stresses vector access, swaps, and comparator dispatch.

use stdlib/vector as vector
use stdlib/vector.{*}

fn binary_search_i64(items: borrow Vector<i64>, needle: i64) -> i64 {
  let mut lo = 0
  let mut hi = vector_len<i64>(items)
  let mut found = 0 - 1
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let value = vector_get<i64>(items, mid, 0)
    if value == needle {
      found = mid
      lo = hi
    } else {
      if value < needle {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
  }
  found
}

fn build_reverse(n: i64) -> owned Vector<i64> {
  let mut items = vector.with_capacity<i64>(n)
  let mut i = n - 1
  while i >= 0 {
    items.push(i)
    i = i - 1
  }
  items
}

fn checksum_i64(items: borrow Vector<i64>) -> i64 {
  vector_fold<i64, i64>(items, 0, (acc: i64, x: i64) => acc + x)
}

fn run_once(n: i64) -> i64 {
  let items = build_reverse(n)
  let sorted = items.sort()
  let sum = checksum_i64(sorted)
  let a = binary_search_i64(sorted, 0)
  let b = binary_search_i64(sorted, n / 2)
  let c = binary_search_i64(sorted, n - 1)
  sum + a + b + c
}

fn main() -> i64 {
  let n = 600
  let runs = 5
  let mut total = 0
  for i in 0..runs {
    total = total + run_once(n)
  }
  if total == 902995 { 0 } else { 1 }
}
