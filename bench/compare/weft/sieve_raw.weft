-- TRACKING REFERENCE, not run by bench_compare.sh: Sieve of
-- Eratosthenes over raw word memory (runtime-trusted surface ordinary
-- application code cannot write). The published sieve benchmark is the
-- stdlib-vector version in sieve.weft; the paired delta between the
-- two (~16% on 2026-08-03) tracks vector/bounds overhead on this
-- shape.
-- Expected checksum: 20 runs * 17984 primes below 200000 = 359680.

use runtime/alloc.{*}
use runtime/memory.{*}

fn sieve_count(arr: i64, limit: i64) -> i64 {
  for i in 0..limit {
    if i >= 2 { mem_store64(arr + i * 8, 1) }
    else { mem_store64(arr + i * 8, 0) }
  }

  let mut p = 2
  while p * p < limit {
    if mem_load64(arr + p * 8) == 1 {
      let mut j = p * p
      while j < limit {
        mem_store64(arr + j * 8, 0)
        j = j + p
      }
    } else { 0 }
    p = p + 1
  }

  let mut count = 0
  for i in 0..limit {
    if mem_load64(arr + i * 8) == 1 { count = count + 1 } else { 0 }
  }
  count
}

fn main() -> i64 {
  let limit = 200000
  let runs = 20
  let arena = arena_new(limit * 8)
  let arr = arena_alloc(arena, limit * 8, 8)
  let mut total = 0
  for i in 0..runs {
    total = total + sieve_count(arr, limit)
  }
  arena_free(arena)
  if total == 359680 { 0 } else { 1 }
}
