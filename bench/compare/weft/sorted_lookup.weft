-- Comparative benchmark: sorted_map build plus binary-search lookups.
-- Exercises the stdlib ordered-map find path: indirect comparator
-- calls per iteration, generic entry unwrapping, and the map's
-- bounds/coherence discipline.

use stdlib/vector.{*}
use stdlib/option.{*}
use stdlib/sorted_map.{*}

fn build_map(n: i64) -> SortedMap<i64, i64> {
  let m = sorted_map_new<i64, i64>()
  for i in 0..n {
    sorted_map_put<i64, i64>(m, i * 2, i, sorted_cmp_i64)
  }
  m
}

fn lookup_sweep(m: SortedMap<i64, i64>, span: i64) -> i64 {
  let mut sum = 0
  for k in 0..span {
    match sorted_map_find<i64, i64>(m, k, sorted_cmp_i64) {
      SortedFound(index) -> {
        let entry = sorted_map_entry_at<i64, i64>(m, index)
        sum = sum + sorted_entry_value<i64, i64>(entry)
      }
      SortedMissing(index) -> { sum = sum + 1 }
    }
  }
  sum
}

fn main() -> i64 {
  let n = 20000
  let reps = 10
  let m = build_map(n)
  let mut total = 0
  for r in 0..reps {
    total = total + lookup_sweep(m, n * 2)
  }
  -- Per sweep: hit values sum to n*(n-1)/2 = 199,990,000 and the
  -- n odd probes miss for +20,000 -> 200,010,000; ten sweeps.
  if total == 2000100000 { 0 } else { 1 }
}
