-- Comparative benchmark: adjacency matrix plus queue reachability.
-- The directed chain makes the total reachability checksum n * (n + 1) / 2.

use stdlib/vector as vector
use stdlib/vector.{Vector}
use stdlib/num
use stdlib/option.{Option}

fn graph_capacity(nodes: usize) -> usize {
  nodes.checked_mul(nodes).expect("benchmark graph fits storage")
}

fn graph_new(nodes: usize) -> owned Vector<i64> {
  let mut graph = vector.with_capacity<i64>(graph_capacity(nodes))
  let first: usize = 0
  for i in first..nodes * nodes {
    graph.push(0)
  }
  graph
}

fn graph_index(nodes: usize, from: usize, to: usize) -> usize {
  from * nodes + to
}

fn graph_add_edge(graph: [mut i64], nodes: usize, from: usize, to: usize) -> nil {
  graph[graph_index(nodes, from, to)] = 1
}

fn graph_has_edge(graph: [i64], nodes: usize, from: usize, to: usize) -> i64 {
  graph[graph_index(nodes, from, to)]
}

fn build_graph(nodes: usize) -> owned Vector<i64> {
  let mut graph = graph_new(nodes)
  let first: usize = 0
  for i in first..nodes - 1 {
    graph_add_edge(graph[..], nodes, i, i + 1)
    if i + 7 < nodes {
      graph_add_edge(graph[..], nodes, i, i + 7)
    } else { nil }
  }
  graph
}

fn graph_reachable_count(graph: [i64], nodes: usize, start: usize) -> i64 {
  let mut seen = vector.with_capacity<i64>(nodes)
  let first: usize = 0
  for i in first..nodes {
    seen.push(0)
  }

  let mut queue = vector.with_capacity<usize>(nodes)
  let marks: [mut i64] = seen[..]
  marks[start] = 1
  queue.push(start)

  let mut head: usize = 0
  while head < queue.len() {
    let node = queue[..][head]
    head = head + 1
    for next in first..nodes {
      if graph_has_edge(graph, nodes, node, next) == 1 and marks[next] == 0 {
        marks[next] = 1
        queue.push(next)
      } else { nil }
    }
  }
  seen.fold<i64>(0, (acc: i64, mark: i64) => acc + mark)
}

fn main() -> i64 {
  let nodes: usize = 160
  let first: usize = 0
  let graph = build_graph(nodes)
  let mut total = 0
  for start in first..nodes {
    total = total + graph_reachable_count(graph[..], nodes, start)
  }
  if total == 12880 { 0 } else { 1 }
}
