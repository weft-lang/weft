-- Comparative benchmark: adjacency matrix plus queue reachability.
-- The directed chain makes the total reachability checksum n * (n + 1) / 2.

use stdlib/vector as vector
use stdlib/vector.{*}

fn graph_new(nodes: i64) -> Vector<i64> {
  let graph = vector.with_capacity<i64>(nodes * nodes)
  for i in 0..nodes * nodes {
    vector_push<i64>(graph, 0)
  }
  graph
}

fn graph_index(nodes: i64, from: i64, to: i64) -> i64 {
  from * nodes + to
}

fn graph_add_edge(graph: Vector<i64>, nodes: i64, from: i64, to: i64) -> i64 {
  vector_set<i64>(graph, graph_index(nodes, from, to), 1)
}

fn graph_has_edge(graph: Vector<i64>, nodes: i64, from: i64, to: i64) -> i64 {
  vector_get<i64>(graph, graph_index(nodes, from, to), 0)
}

fn build_graph(nodes: i64) -> Vector<i64> {
  let graph = graph_new(nodes)
  for i in 0..nodes - 1 {
    graph_add_edge(graph, nodes, i, i + 1)
    if i + 7 < nodes {
      graph_add_edge(graph, nodes, i, i + 7)
    } else { 0 }
  }
  graph
}

fn graph_reachable_count(graph: Vector<i64>, nodes: i64, start: i64) -> i64 {
  let seen = vector.with_capacity<i64>(nodes)
  for i in 0..nodes {
    vector_push<i64>(seen, 0)
  }

  let queue = vector.with_capacity<i64>(nodes)
  vector_set<i64>(seen, start, 1)
  vector_push<i64>(queue, start)

  let mut head = 0
  while head < vector_len(queue) {
    let node = vector_get<i64>(queue, head, 0)
    head = head + 1
    for next in 0..nodes {
      if graph_has_edge(graph, nodes, node, next) == 1 and vector_get<i64>(seen, next, 0) == 0 {
        vector_set<i64>(seen, next, 1)
        vector_push<i64>(queue, next)
      } else { 0 }
    }
  }
  vector_fold<i64, i64>(seen, 0, (acc: i64, mark: i64) => acc + mark)
}

fn main() -> i64 {
  let nodes = 160
  let graph = build_graph(nodes)
  let mut total = 0
  for start in 0..nodes {
    total = total + graph_reachable_count(graph, nodes, start)
  }
  if total == 12880 { 0 } else { 1 }
}
