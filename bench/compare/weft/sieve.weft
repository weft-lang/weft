-- Comparative benchmark: Sieve of Eratosthenes over raw word memory.
-- Expected checksum: 20 runs * 17984 primes below 200000 = 359680.

fn sieve_count(limit: i64) -> i64 {
  let arr = __bump_alloc(limit * 8)
  for i in 0..limit {
    if i >= 2 { __mem_store64(arr + i * 8, 1) }
    else { __mem_store64(arr + i * 8, 0) }
  }

  let mut p = 2
  while p * p < limit {
    if __mem_load64(arr + p * 8) == 1 {
      let mut j = p * p
      while j < limit {
        __mem_store64(arr + j * 8, 0)
        j = j + p
      }
    } else { 0 }
    p = p + 1
  }

  let mut count = 0
  for i in 0..limit {
    if __mem_load64(arr + i * 8) == 1 { count = count + 1 } else { 0 }
  }
  count
}

fn main() -> i64 {
  let limit = 200000
  let runs = 20
  let mut total = 0
  for i in 0..runs {
    total = total + sieve_count(limit)
  }
  if total == 359680 { 0 } else { 1 }
}
