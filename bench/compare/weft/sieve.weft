-- Sieve of Eratosthenes over a stdlib vector — the surface application
-- code actually writes (bounds-checked vector_get/vector_set).
-- Expected checksum: 20 runs * 17984 primes below 200000 = 359680.

use stdlib/vector as vector
use stdlib/vector.{*}

fn sieve_count(arr: Vector<i64>, limit: i64) -> i64 {
  for i in 0..limit {
    if i >= 2 { vector_set<i64>(arr, i, 1) } else { vector_set<i64>(arr, i, 0) }
  }

  let mut p = 2
  while p * p < limit {
    if vector_get<i64>(arr, p, 0) == 1 {
      let mut j = p * p
      while j < limit {
        vector_set<i64>(arr, j, 0)
        j = j + p
      }
    } else { 0 }
    p = p + 1
  }

  let mut count = 0
  for i in 0..limit {
    if vector_get<i64>(arr, i, 0) == 1 { count = count + 1 } else { 0 }
  }
  count
}

fn main() -> i64 {
  let limit = 200000
  let runs = 20
  let arr = vector.new<i64>()
  for i in 0..limit { vector_push<i64>(arr, 0) }
  let mut total = 0
  for r in 0..runs {
    total = total + sieve_count(arr, limit)
  }
  if total == 359680 { 0 } else { 1 }
}
