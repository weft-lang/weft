-- Sieve of Eratosthenes over a stdlib vector — the surface application
-- code actually writes, with checked indexing and an explicit mutable borrow.
-- Expected checksum: 240 runs * 17984 primes below 200000 = 4316160.

use stdlib/vector as vector
use stdlib/vector.{Vector}

fn sieve_count(arr: [mut i64]) -> i64 {
  let limit = arr.len
  let first: usize = 0
  for i in first..limit {
    arr[i] = if i >= 2 { 1 } else { 0 }
  }

  let mut p: usize = 2
  while p * p < limit {
    if arr[p] == 1 {
      let mut j = p * p
      while j < limit {
        arr[j] = 0
        j = j + p
      }
    } else { nil }
    p = p + 1
  }

  let mut count = 0
  for i in first..limit {
    if arr[i] == 1 { count = count + 1 } else { nil }
  }
  count
}

fn main() -> i64 {
  let limit: usize = 200000
  let first: usize = 0
  let runs = 240
  let mut arr = vector.new<i64>()
  for i in first..limit { arr.push(0) }
  let mut total = 0
  for r in 0..runs {
    total = total + sieve_count(arr[..])
  }
  if total == 4316160 { 0 } else { 1 }
}
