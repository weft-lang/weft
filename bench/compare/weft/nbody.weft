-- Comparative benchmark: five-body solar-system n-body kernel over f64 state.
-- Expected final energy after 50,000 steps: approximately -0.16907807060863048.

use stdlib/math as math
use stdlib/f64_table as f64_table
use stdlib/f64_table.{F64Table}
use stdlib/option.{Option}

fn nbody_count() -> i64 { 5 }

fn nbody_x(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 0).unwrap()
}

fn nbody_y(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 1).unwrap()
}

fn nbody_z(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 2).unwrap()
}

fn nbody_vx(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 3).unwrap()
}

fn nbody_vy(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 4).unwrap()
}

fn nbody_vz(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 5).unwrap()
}

fn nbody_mass(bodies: F64Table, body: i64) -> f64 {
  bodies.get(body, 6).unwrap()
}

fn nbody_set_x(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 0, value)
}

fn nbody_set_y(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 1, value)
}

fn nbody_set_z(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 2, value)
}

fn nbody_set_vx(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 3, value)
}

fn nbody_set_vy(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 4, value)
}

fn nbody_set_vz(bodies: F64Table, body: i64, value: f64) -> bool {
  bodies.set(body, 5, value)
}

fn nbody_init() -> F64Table {
  let days_per_year = 365.24
  let solar_mass = 39.47841760435743
  let bodies = f64_table.zeros(nbody_count(), 7).unwrap()

  bodies.set(0, 6, solar_mass)

  bodies.set(1, 0, 4.84143144246472090)
  bodies.set(1, 1, 0.0 - 1.16032004402742839)
  bodies.set(1, 2, 0.0 - 0.103622044471123109)
  bodies.set(1, 3, 0.00166007664274403694 * days_per_year)
  bodies.set(1, 4, 0.00769901118419740425 * days_per_year)
  bodies.set(1, 5, (0.0 - 0.0000690460016972063023) * days_per_year)
  bodies.set(1, 6, 0.000954791938424326609 * solar_mass)

  bodies.set(2, 0, 8.34336671824457987)
  bodies.set(2, 1, 4.12479856412430479)
  bodies.set(2, 2, 0.0 - 0.403523417114321381)
  bodies.set(2, 3, (0.0 - 0.00276742510726862411) * days_per_year)
  bodies.set(2, 4, 0.00499852801234917238 * days_per_year)
  bodies.set(2, 5, 0.0000230417297573763929 * days_per_year)
  bodies.set(2, 6, 0.000285885980666130812 * solar_mass)

  bodies.set(3, 0, 12.8943695621391310)
  bodies.set(3, 1, 0.0 - 15.1111514016986312)
  bodies.set(3, 2, 0.0 - 0.223307578892655734)
  bodies.set(3, 3, 0.00296460137564761618 * days_per_year)
  bodies.set(3, 4, 0.00237847173959480950 * days_per_year)
  bodies.set(3, 5, (0.0 - 0.0000296589568540237556) * days_per_year)
  bodies.set(3, 6, 0.0000436624404335156298 * solar_mass)

  bodies.set(4, 0, 15.3796971148509165)
  bodies.set(4, 1, 0.0 - 25.9193146099879641)
  bodies.set(4, 2, 0.179258772950371181)
  bodies.set(4, 3, 0.00268067772490389322 * days_per_year)
  bodies.set(4, 4, 0.00162824170038242295 * days_per_year)
  bodies.set(4, 5, (0.0 - 0.0000951592254519715870) * days_per_year)
  bodies.set(4, 6, 0.0000515138902046611451 * solar_mass)

  let mut px: f64 = 0.0
  let mut py: f64 = 0.0
  let mut pz: f64 = 0.0
  let count = bodies.rows()
  for i in 0..count {
    let mass = nbody_mass(bodies, i)
    px = px + nbody_vx(bodies, i) * mass
    py = py + nbody_vy(bodies, i) * mass
    pz = pz + nbody_vz(bodies, i) * mass
  }
  nbody_set_vx(bodies, 0, (0.0 - px) / solar_mass)
  nbody_set_vy(bodies, 0, (0.0 - py) / solar_mass)
  nbody_set_vz(bodies, 0, (0.0 - pz) / solar_mass)
  bodies
}

fn nbody_advance(bodies: F64Table, steps: i64) -> F64Table {
  let dt = 0.01
  let count = bodies.rows()
  for step in 0..steps {
    for i in 0..count {
      let mut j = i + 1
      while j < count {
        let xi = nbody_x(bodies, i)
        let yi = nbody_y(bodies, i)
        let zi = nbody_z(bodies, i)
        let xj = nbody_x(bodies, j)
        let yj = nbody_y(bodies, j)
        let zj = nbody_z(bodies, j)
        let dx = xi - xj
        let dy = yi - yj
        let dz = zi - zj
        let d2 = dx * dx + dy * dy + dz * dz
        let mag = dt / (d2 * d2.sqrt())
        let mi = nbody_mass(bodies, i)
        let mj = nbody_mass(bodies, j)
        let vxi = nbody_vx(bodies, i)
        let vyi = nbody_vy(bodies, i)
        let vzi = nbody_vz(bodies, i)
        let vxj = nbody_vx(bodies, j)
        let vyj = nbody_vy(bodies, j)
        let vzj = nbody_vz(bodies, j)
        nbody_set_vx(bodies, i, vxi - dx * mj * mag)
        nbody_set_vy(bodies, i, vyi - dy * mj * mag)
        nbody_set_vz(bodies, i, vzi - dz * mj * mag)
        nbody_set_vx(bodies, j, vxj + dx * mi * mag)
        nbody_set_vy(bodies, j, vyj + dy * mi * mag)
        nbody_set_vz(bodies, j, vzj + dz * mi * mag)
        j = j + 1
      }
    }
    for i in 0..count {
      let x = nbody_x(bodies, i)
      let y = nbody_y(bodies, i)
      let z = nbody_z(bodies, i)
      let vx = nbody_vx(bodies, i)
      let vy = nbody_vy(bodies, i)
      let vz = nbody_vz(bodies, i)
      nbody_set_x(bodies, i, x + dt * vx)
      nbody_set_y(bodies, i, y + dt * vy)
      nbody_set_z(bodies, i, z + dt * vz)
    }
  }
  bodies
}

fn nbody_energy(bodies: F64Table) -> f64 {
  let mut energy: f64 = 0.0
  let count = bodies.rows()
  for i in 0..count {
    let mass = nbody_mass(bodies, i)
    let vx = nbody_vx(bodies, i)
    let vy = nbody_vy(bodies, i)
    let vz = nbody_vz(bodies, i)
    energy = energy + 0.5 * mass * (vx * vx + vy * vy + vz * vz)

    let mut j = i + 1
    while j < count {
      let xi = nbody_x(bodies, i)
      let yi = nbody_y(bodies, i)
      let zi = nbody_z(bodies, i)
      let xj = nbody_x(bodies, j)
      let yj = nbody_y(bodies, j)
      let zj = nbody_z(bodies, j)
      let mj = nbody_mass(bodies, j)
      let dx = xi - xj
      let dy = yi - yj
      let dz = zi - zj
      let distance = (dx * dx + dy * dy + dz * dz).sqrt()
      energy = energy - mass * mj / distance
      j = j + 1
    }
  }
  energy
}

fn nbody_final_energy(steps: i64) -> f64 {
  let bodies = nbody_init()
  nbody_advance(bodies, steps)
  nbody_energy(bodies)
}

fn main() -> i64 {
  let expected = 0.0 - 0.16907807060863048
  let got = nbody_final_energy(50000)
  if (got - expected).abs() < 0.000000001 { 0 } else { 1 }
}
