-- Comparative benchmark: five-body solar-system n-body kernel over f64 state.
-- Expected final energy after 50,000 steps: approximately -0.16907807060863048.

use "stdlib/math.weft"
use "stdlib/vector.weft"
use "stdlib/f64_table.weft"

fn nbody_body_width() -> i64 { 7 }
fn nbody_count() -> i64 { 5 }

fn nbody_x(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 0, 0.0)
}

fn nbody_y(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 1, 0.0)
}

fn nbody_z(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 2, 0.0)
}

fn nbody_vx(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 3, 0.0)
}

fn nbody_vy(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 4, 0.0)
}

fn nbody_vz(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 5, 0.0)
}

fn nbody_mass(bodies: Vector<f64>, body: i64) -> f64 {
  f64_table_get(bodies, body, 7, 6, 0.0)
}

fn nbody_set_x(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 0, value)
}

fn nbody_set_y(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 1, value)
}

fn nbody_set_z(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 2, value)
}

fn nbody_set_vx(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 3, value)
}

fn nbody_set_vy(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 4, value)
}

fn nbody_set_vz(bodies: Vector<f64>, body: i64, value: f64) -> i64 {
  f64_table_set(bodies, body, 7, 5, value)
}

fn nbody_init() -> Vector<f64> {
  let days_per_year = 365.24
  let solar_mass = 39.47841760435743
  let bodies = f64_table_new(nbody_body_width(), nbody_count())

  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, solar_mass)

  vector_push<f64>(bodies, 4.84143144246472090)
  vector_push<f64>(bodies, 0.0 - 1.16032004402742839)
  vector_push<f64>(bodies, 0.0 - 0.103622044471123109)
  vector_push<f64>(bodies, 0.00166007664274403694 * days_per_year)
  vector_push<f64>(bodies, 0.00769901118419740425 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000690460016972063023) * days_per_year)
  vector_push<f64>(bodies, 0.000954791938424326609 * solar_mass)

  vector_push<f64>(bodies, 8.34336671824457987)
  vector_push<f64>(bodies, 4.12479856412430479)
  vector_push<f64>(bodies, 0.0 - 0.403523417114321381)
  vector_push<f64>(bodies, (0.0 - 0.00276742510726862411) * days_per_year)
  vector_push<f64>(bodies, 0.00499852801234917238 * days_per_year)
  vector_push<f64>(bodies, 0.0000230417297573763929 * days_per_year)
  vector_push<f64>(bodies, 0.000285885980666130812 * solar_mass)

  vector_push<f64>(bodies, 12.8943695621391310)
  vector_push<f64>(bodies, 0.0 - 15.1111514016986312)
  vector_push<f64>(bodies, 0.0 - 0.223307578892655734)
  vector_push<f64>(bodies, 0.00296460137564761618 * days_per_year)
  vector_push<f64>(bodies, 0.00237847173959480950 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000296589568540237556) * days_per_year)
  vector_push<f64>(bodies, 0.0000436624404335156298 * solar_mass)

  vector_push<f64>(bodies, 15.3796971148509165)
  vector_push<f64>(bodies, 0.0 - 25.9193146099879641)
  vector_push<f64>(bodies, 0.179258772950371181)
  vector_push<f64>(bodies, 0.00268067772490389322 * days_per_year)
  vector_push<f64>(bodies, 0.00162824170038242295 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000951592254519715870) * days_per_year)
  vector_push<f64>(bodies, 0.0000515138902046611451 * solar_mass)

  let mut px: f64 = 0.0
  let mut py: f64 = 0.0
  let mut pz: f64 = 0.0
  let count = f64_table_row_count(bodies, 7)
  for i in 0..count {
    let mass = nbody_mass(bodies, i)
    px = px + nbody_vx(bodies, i) * mass
    py = py + nbody_vy(bodies, i) * mass
    pz = pz + nbody_vz(bodies, i) * mass
  }
  nbody_set_vx(bodies, 0, (0.0 - px) / solar_mass)
  nbody_set_vy(bodies, 0, (0.0 - py) / solar_mass)
  nbody_set_vz(bodies, 0, (0.0 - pz) / solar_mass)
  bodies
}

fn nbody_advance(bodies: Vector<f64>, steps: i64) -> Vector<f64> {
  let dt = 0.01
  let count = f64_table_row_count(bodies, 7)
  for step in 0..steps {
    for i in 0..count {
      let mut j = i + 1
      while j < count {
        let xi = nbody_x(bodies, i)
        let yi = nbody_y(bodies, i)
        let zi = nbody_z(bodies, i)
        let xj = nbody_x(bodies, j)
        let yj = nbody_y(bodies, j)
        let zj = nbody_z(bodies, j)
        let dx = xi - xj
        let dy = yi - yj
        let dz = zi - zj
        let d2 = dx * dx + dy * dy + dz * dz
        let mag = dt / (d2 * math_sqrt_f64(d2))
        let mi = nbody_mass(bodies, i)
        let mj = nbody_mass(bodies, j)
        let vxi = nbody_vx(bodies, i)
        let vyi = nbody_vy(bodies, i)
        let vzi = nbody_vz(bodies, i)
        let vxj = nbody_vx(bodies, j)
        let vyj = nbody_vy(bodies, j)
        let vzj = nbody_vz(bodies, j)
        nbody_set_vx(bodies, i, vxi - dx * mj * mag)
        nbody_set_vy(bodies, i, vyi - dy * mj * mag)
        nbody_set_vz(bodies, i, vzi - dz * mj * mag)
        nbody_set_vx(bodies, j, vxj + dx * mi * mag)
        nbody_set_vy(bodies, j, vyj + dy * mi * mag)
        nbody_set_vz(bodies, j, vzj + dz * mi * mag)
        j = j + 1
      }
    }
    for i in 0..count {
      let x = nbody_x(bodies, i)
      let y = nbody_y(bodies, i)
      let z = nbody_z(bodies, i)
      let vx = nbody_vx(bodies, i)
      let vy = nbody_vy(bodies, i)
      let vz = nbody_vz(bodies, i)
      nbody_set_x(bodies, i, x + dt * vx)
      nbody_set_y(bodies, i, y + dt * vy)
      nbody_set_z(bodies, i, z + dt * vz)
    }
  }
  bodies
}

fn nbody_energy(bodies: Vector<f64>) -> f64 {
  let mut energy: f64 = 0.0
  let count = f64_table_row_count(bodies, 7)
  for i in 0..count {
    let mass = nbody_mass(bodies, i)
    let vx = nbody_vx(bodies, i)
    let vy = nbody_vy(bodies, i)
    let vz = nbody_vz(bodies, i)
    energy = energy + 0.5 * mass * (vx * vx + vy * vy + vz * vz)

    let mut j = i + 1
    while j < count {
      let xi = nbody_x(bodies, i)
      let yi = nbody_y(bodies, i)
      let zi = nbody_z(bodies, i)
      let xj = nbody_x(bodies, j)
      let yj = nbody_y(bodies, j)
      let zj = nbody_z(bodies, j)
      let mj = nbody_mass(bodies, j)
      let dx = xi - xj
      let dy = yi - yj
      let dz = zi - zj
      let distance = math_sqrt_f64(dx * dx + dy * dy + dz * dz)
      energy = energy - mass * mj / distance
      j = j + 1
    }
  }
  energy
}

fn nbody_final_energy(steps: i64) -> f64 {
  let bodies = nbody_init()
  nbody_advance(bodies, steps)
  nbody_energy(bodies)
}

fn main() -> i64 {
  let expected = 0.0 - 0.16907807060863048
  let got = nbody_final_energy(50000)
  if math_abs_f64(got - expected) < 0.000000001 { 0 } else { 1 }
}
