-- Comparative benchmark: five-body solar-system n-body kernel over f64 state.
-- Expected final energy after 50,000 steps: approximately -0.16907807060863048.

use "stdlib/math.weft"
use "stdlib/vector.weft"

fn nbody_body_width() -> i64 { 7 }
fn nbody_count() -> i64 { 5 }

fn nbody_slot(body: i64, field: i64) -> i64 {
  body * nbody_body_width() + field
}

fn nbody_get(bodies: i64, body: i64, field: i64) -> f64 {
  vector_get<f64>(bodies, nbody_slot(body, field), 0.0)
}

fn nbody_set(bodies: i64, body: i64, field: i64, value: f64) -> i64 {
  vector_set<f64>(bodies, nbody_slot(body, field), value)
}

fn nbody_init() -> i64 {
  let days_per_year = 365.24
  let solar_mass = 39.47841760435743
  let bodies = vector_with_capacity<f64>(nbody_count() * nbody_body_width())

  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, 0.0)
  vector_push<f64>(bodies, solar_mass)

  vector_push<f64>(bodies, 4.84143144246472090)
  vector_push<f64>(bodies, 0.0 - 1.16032004402742839)
  vector_push<f64>(bodies, 0.0 - 0.103622044471123109)
  vector_push<f64>(bodies, 0.00166007664274403694 * days_per_year)
  vector_push<f64>(bodies, 0.00769901118419740425 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000690460016972063023) * days_per_year)
  vector_push<f64>(bodies, 0.000954791938424326609 * solar_mass)

  vector_push<f64>(bodies, 8.34336671824457987)
  vector_push<f64>(bodies, 4.12479856412430479)
  vector_push<f64>(bodies, 0.0 - 0.403523417114321381)
  vector_push<f64>(bodies, (0.0 - 0.00276742510726862411) * days_per_year)
  vector_push<f64>(bodies, 0.00499852801234917238 * days_per_year)
  vector_push<f64>(bodies, 0.0000230417297573763929 * days_per_year)
  vector_push<f64>(bodies, 0.000285885980666130812 * solar_mass)

  vector_push<f64>(bodies, 12.8943695621391310)
  vector_push<f64>(bodies, 0.0 - 15.1111514016986312)
  vector_push<f64>(bodies, 0.0 - 0.223307578892655734)
  vector_push<f64>(bodies, 0.00296460137564761618 * days_per_year)
  vector_push<f64>(bodies, 0.00237847173959480950 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000296589568540237556) * days_per_year)
  vector_push<f64>(bodies, 0.0000436624404335156298 * solar_mass)

  vector_push<f64>(bodies, 15.3796971148509165)
  vector_push<f64>(bodies, 0.0 - 25.9193146099879641)
  vector_push<f64>(bodies, 0.179258772950371181)
  vector_push<f64>(bodies, 0.00268067772490389322 * days_per_year)
  vector_push<f64>(bodies, 0.00162824170038242295 * days_per_year)
  vector_push<f64>(bodies, (0.0 - 0.0000951592254519715870) * days_per_year)
  vector_push<f64>(bodies, 0.0000515138902046611451 * solar_mass)

  let mut px: f64 = 0.0
  let mut py: f64 = 0.0
  let mut pz: f64 = 0.0
  for i in 0..nbody_count() {
    let mass = nbody_get(bodies, i, 6)
    px = px + nbody_get(bodies, i, 3) * mass
    py = py + nbody_get(bodies, i, 4) * mass
    pz = pz + nbody_get(bodies, i, 5) * mass
  }
  nbody_set(bodies, 0, 3, (0.0 - px) / solar_mass)
  nbody_set(bodies, 0, 4, (0.0 - py) / solar_mass)
  nbody_set(bodies, 0, 5, (0.0 - pz) / solar_mass)
  bodies
}

fn nbody_advance(bodies: i64, steps: i64) -> i64 {
  let dt = 0.01
  for step in 0..steps {
    for i in 0..nbody_count() {
      let mut j = i + 1
      while j < nbody_count() {
        let xi = nbody_get(bodies, i, 0)
        let yi = nbody_get(bodies, i, 1)
        let zi = nbody_get(bodies, i, 2)
        let xj = nbody_get(bodies, j, 0)
        let yj = nbody_get(bodies, j, 1)
        let zj = nbody_get(bodies, j, 2)
        let dx = xi - xj
        let dy = yi - yj
        let dz = zi - zj
        let d2 = dx * dx + dy * dy + dz * dz
        let mag = dt / (d2 * math_sqrt_f64(d2))
        let mi = nbody_get(bodies, i, 6)
        let mj = nbody_get(bodies, j, 6)
        let vxi = nbody_get(bodies, i, 3)
        let vyi = nbody_get(bodies, i, 4)
        let vzi = nbody_get(bodies, i, 5)
        let vxj = nbody_get(bodies, j, 3)
        let vyj = nbody_get(bodies, j, 4)
        let vzj = nbody_get(bodies, j, 5)
        nbody_set(bodies, i, 3, vxi - dx * mj * mag)
        nbody_set(bodies, i, 4, vyi - dy * mj * mag)
        nbody_set(bodies, i, 5, vzi - dz * mj * mag)
        nbody_set(bodies, j, 3, vxj + dx * mi * mag)
        nbody_set(bodies, j, 4, vyj + dy * mi * mag)
        nbody_set(bodies, j, 5, vzj + dz * mi * mag)
        j = j + 1
      }
    }
    for i in 0..nbody_count() {
      let x = nbody_get(bodies, i, 0)
      let y = nbody_get(bodies, i, 1)
      let z = nbody_get(bodies, i, 2)
      let vx = nbody_get(bodies, i, 3)
      let vy = nbody_get(bodies, i, 4)
      let vz = nbody_get(bodies, i, 5)
      nbody_set(bodies, i, 0, x + dt * vx)
      nbody_set(bodies, i, 1, y + dt * vy)
      nbody_set(bodies, i, 2, z + dt * vz)
    }
  }
  bodies
}

fn nbody_energy(bodies: i64) -> f64 {
  let mut energy: f64 = 0.0
  for i in 0..nbody_count() {
    let mass = nbody_get(bodies, i, 6)
    let vx = nbody_get(bodies, i, 3)
    let vy = nbody_get(bodies, i, 4)
    let vz = nbody_get(bodies, i, 5)
    energy = energy + 0.5 * mass * (vx * vx + vy * vy + vz * vz)

    let mut j = i + 1
    while j < nbody_count() {
      let xi = nbody_get(bodies, i, 0)
      let yi = nbody_get(bodies, i, 1)
      let zi = nbody_get(bodies, i, 2)
      let xj = nbody_get(bodies, j, 0)
      let yj = nbody_get(bodies, j, 1)
      let zj = nbody_get(bodies, j, 2)
      let mj = nbody_get(bodies, j, 6)
      let dx = xi - xj
      let dy = yi - yj
      let dz = zi - zj
      let distance = math_sqrt_f64(dx * dx + dy * dy + dz * dz)
      energy = energy - mass * mj / distance
      j = j + 1
    }
  }
  energy
}

fn nbody_final_energy(steps: i64) -> f64 {
  let bodies = nbody_init()
  nbody_advance(bodies, steps)
  nbody_energy(bodies)
}

fn main() -> i64 {
  let expected = 0.0 - 0.16907807060863048
  let got = nbody_final_energy(50000)
  if math_abs_f64(got - expected) < 0.000000001 { 0 } else { 1 }
}
