-- Same-source canary for scanner representations and finite byte offsets.
-- The process status verifies every parse before paired wall-time sampling.
use stdlib/num as num
use stdlib/num.{NumParseUnderflow, NumParseOverflow}
use stdlib/json as json
use stdlib/json.{JsonInvalidSyntax}
use stdlib/result.{Ok, Err}
use stdlib/option.{Option}

fn parse_sample() -> i64 {
  let integer = match num.parse_i64_prefix("Ω42!", 2) {
    Ok((value, next)) if value == 42 and next == 4 -> 1
    _ -> 0
  }
  let double = match num.parse_f64_prefix("Ω1.5!", 2) {
    Ok((value, next)) if value == 1.5 and next == 5 -> 1
    _ -> 0
  }
  let single = match num.parse_f32_prefix("Ω-0!", 2) {
    Ok((value, next)) if value.to_bits() == 2147483648 and next == 4 -> 1
    _ -> 0
  }
  let underflow = match num.parse_f64("1e-324") {
    Err(NumParseUnderflow(6)) -> 1
    _ -> 0
  }
  let overflow = match num.parse_f32("1e999999999999999999") {
    Err(NumParseOverflow(20)) -> 1
    _ -> 0
  }
  let document = match json.parse("{\"n\":1.5}") {
    Ok(value) -> if value.get("n").unwrap().as_f64().unwrap() == 1.5 { 1 } else { 0 }
    _ -> 0
  }
  let failure = match json.parse("[\"Ω\",1e-324]") {
    Err(JsonInvalidSyntax(12)) -> 1
    _ -> 0
  }
  integer + double + single + underflow + overflow + document + failure
}

fn main() -> i64 {
  let mut checksum = 0
  for _ in 0..10000 { checksum = checksum + parse_sample() }
  if checksum == 70000 { 0 } else { 1 }
}
