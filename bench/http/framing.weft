-- Same-source canary for finite HTTP scanner and field representations.
-- Every sample validates framing and consumed boundaries before timing counts.

use stdlib/bytes as bytes
use stdlib/http as http
use stdlib/http.{HttpChunkData, HttpChunkReady, HttpContentLength, HttpRequestHeadReady}
use stdlib/result.{Result}

fn sample() -> i64 {
  let wire = bytes.from_str("POST /records HTTP/1.1\r\nHost: example.com\r\nX-Trace: a\r\nContent-Length: 5, 5\r\n\r\nhello").to_vector()
  let request = match http.parse_request_head(wire[..], http.default_limits()) {
    HttpRequestHeadReady(head, HttpContentLength(count), consumed) -> if count == 5 and consumed == wire.len() - 5 and head.headers().len() == 3 { 1 } else { 0 }
    _ -> 0
  }
  let chunk = bytes.from_str("5;name=token\r\nhello\r\nNEXT").to_vector()
  let body = match http.parse_chunk(chunk[..], http.default_limits()) {
    HttpChunkReady(HttpChunkData(data), consumed) -> if data.to_utf8().unwrap() == "hello" and consumed == chunk.len() - 4 { 1 } else { 0 }
    _ -> 0
  }
  request + body
}

fn main() -> i64 {
  let mut checksum = 0
  for _ in 0..5000 { checksum = checksum + sample() }
  if checksum == 10000 { 0 } else { 1 }
}
