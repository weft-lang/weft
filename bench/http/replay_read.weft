-- Same-source canary for bounded replay reads from a larger immutable transcript.
-- Exact bytes, body length, and terminal cleanup are checked in every exchange.

use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/http as http
use stdlib/http.{Http11, HttpGet, HttpRequestHead}
use stdlib/http/endpoint.{HttpClient, HttpClientRequestReady, HttpClientResponseReady}
use stdlib/http/replay as replay
use stdlib/http/replay.{HttpReplayReadComplete, HttpReplayWriteComplete}
use stdlib/http/stream as stream
use stdlib/http/stream.{HttpBodyIO, HttpBodyReadData, HttpBodyReadEndClosed, HttpBodyStream, HttpBodyFinished}
use stdlib/http/transport.{HttpReplayTransportState, HttpTransportRelease}
use stdlib/result.{Result}
use stdlib/string.{*}
use stdlib/url as url
use stdlib/vector as vector

fn request() -> HttpRequestHead {
  http.request(HttpGet, http.parse_request_target("/bytes").unwrap(), Http11,
    http.headers().append(http.header(http.parse_field_name("Host").unwrap(), bytes.from_str("example.com")).unwrap()),
    http.default_limits()).unwrap()
}

fn exchange() -[HttpClient<HttpReplayTransportState>, HttpBodyIO<HttpReplayTransportState>, HttpTransportRelease<HttpReplayTransportState>]> i64 {
  match HttpClient<HttpReplayTransportState>.begin(url.parse("https://example.com/bytes").unwrap(), request(), http.default_limits()) {
    HttpClientRequestReady(writer) -> match writer.finish(http.headers()) {
      HttpBodyFinished(connection) -> match HttpClient<HttpReplayTransportState>.response(connection, HttpGet, http.default_limits()) {
        HttpClientResponseReady(head, reader) -> {
          let mut current: owned HttpBodyStream<HttpReplayTransportState> = reader
          let mut count: usize = 0
          loop {
            match current.read(256) {
              HttpBodyReadData(returned, data) -> {
                let view = data.to_vector()
                for byte in view[..] { if byte != 97 { return 1 } }
                count = count + data.len()
                current = returned
              }
              HttpBodyReadEndClosed(trailers) -> return if count == 16384 { 0 } else { 2 }
              _ -> return 3
            }
          }
        }
        _ -> 4
      }
      _ -> 5
    }
    _ -> 6
  }
}

fn main() -> i64 {
  let mut values = vector.with_capacity<u8>(16384)
  for _ in 0..16384 { values.push(97) }
  let payload = bytes.from_vector(values).to_utf8().unwrap()
  let input = bytes.from_str("HTTP/1.1 200 OK\r\ncontent-length: 16384\r\nconnection: close\r\n\r\n".concat(payload))
  let output = bytes.from_str("GET /bytes HTTP/1.1\r\nhost: example.com\r\n\r\n")
  for _ in 0..10 {
    let fixture = replay.fixture(input, output, 32, 256, HttpReplayReadComplete, HttpReplayWriteComplete).unwrap()
    if replay.with_client(fixture, exchange) != 0 { return 7 }
    let stats = fixture.stats()
    if stats.closes != 1 or stats.releases != 0 or stats.errors != 0 { return 8 }
  }
  0
}
