-- Comparative benchmark: five bodies represented by named records.
-- Expected final energy after 50,000 steps: approximately -0.16907807060863048.

use stdlib/math

type Body {
  x: f64, y: f64, z: f64,
  vx: f64, vy: f64, vz: f64,
  mass: f64
}

fn initial_bodies() -> [Body; 5] {
  let days_per_year = 365.24
  let solar_mass = 39.47841760435743
  [
    Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass },
    Body {
      x: 4.84143144246472090, y: -1.16032004402742839, z: -0.103622044471123109,
      vx: 0.00166007664274403694 * days_per_year,
      vy: 0.00769901118419740425 * days_per_year,
      vz: -0.0000690460016972063023 * days_per_year,
      mass: 0.000954791938424326609 * solar_mass
    },
    Body {
      x: 8.34336671824457987, y: 4.12479856412430479, z: -0.403523417114321381,
      vx: -0.00276742510726862411 * days_per_year,
      vy: 0.00499852801234917238 * days_per_year,
      vz: 0.0000230417297573763929 * days_per_year,
      mass: 0.000285885980666130812 * solar_mass
    },
    Body {
      x: 12.8943695621391310, y: -15.1111514016986312, z: -0.223307578892655734,
      vx: 0.00296460137564761618 * days_per_year,
      vy: 0.00237847173959480950 * days_per_year,
      vz: -0.0000296589568540237556 * days_per_year,
      mass: 0.0000436624404335156298 * solar_mass
    },
    Body {
      x: 15.3796971148509165, y: -25.9193146099879641, z: 0.179258772950371181,
      vx: 0.00268067772490389322 * days_per_year,
      vy: 0.00162824170038242295 * days_per_year,
      vz: -0.0000951592254519715870 * days_per_year,
      mass: 0.0000515138902046611451 * solar_mass
    }
  ]
}

fn offset_momentum(bodies: [mut Body]) -> nil {
  let mut px = 0.0
  let mut py = 0.0
  let mut pz = 0.0
  for body in bodies {
    px = px + body.vx * body.mass
    py = py + body.vy * body.mass
    pz = pz + body.vz * body.mass
  }
  let sun = bodies[0]
  bodies[0] = sun.{vx: -px / sun.mass, vy: -py / sun.mass, vz: -pz / sun.mass}
}

fn advance(bodies: [mut Body], dt: f64) -> nil {
  let first: usize = 0
  for i in first..bodies.len {
    for j in i + 1..bodies.len {
      let a = bodies[i]
      let b = bodies[j]
      let dx = a.x - b.x
      let dy = a.y - b.y
      let dz = a.z - b.z
      let d2 = dx * dx + dy * dy + dz * dz
      let mag = dt / (d2 * d2.sqrt())
      bodies[i] = a.{
        vx: a.vx - dx * b.mass * mag,
        vy: a.vy - dy * b.mass * mag,
        vz: a.vz - dz * b.mass * mag,
      }
      bodies[j] = b.{
        vx: b.vx + dx * a.mass * mag,
        vy: b.vy + dy * a.mass * mag,
        vz: b.vz + dz * a.mass * mag,
      }
    }
  }
  for i in first..bodies.len {
    let body = bodies[i]
    bodies[i] = body.{
      x: body.x + dt * body.vx,
      y: body.y + dt * body.vy,
      z: body.z + dt * body.vz,
    }
  }
}

fn energy(bodies: [Body]) -> f64 {
  let mut total = 0.0
  let first: usize = 0
  for i in first..bodies.len {
    let a = bodies[i]
    total = total + 0.5 * a.mass * (a.vx * a.vx + a.vy * a.vy + a.vz * a.vz)
    for j in i + 1..bodies.len {
      let b = bodies[j]
      let dx = a.x - b.x
      let dy = a.y - b.y
      let dz = a.z - b.z
      total = total - a.mass * b.mass / (dx * dx + dy * dy + dz * dz).sqrt()
    }
  }
  total
}

fn nbody_final_energy(steps: i64) -> f64 {
  let mut bodies = initial_bodies()
  offset_momentum(bodies[..])
  for _ in 0..steps { advance(bodies[..], 0.01) }
  energy(bodies[..])
}

fn main() -> i64 {
  let expected = -0.16907807060863048
  let got = nbody_final_energy(50000)
  if (got - expected).abs() < 0.000000001 { 0 } else { 1 }
}
