-- effect-handlers-bench: handler_sieve (spec large input 60000 -> 171848738)
-- Sum of all primes below n by trial division, where the set of known
-- primes lives implicitly in a stack of nested handlers: each newly
-- found prime installs a handler whose clause checks divisibility by
-- that prime and DELEGATES to the next outer handler by performing the
-- effect's own label from inside the clause (the under/evidence-masking
-- shape). Label: DEEP_STACK_OF_HANDLERS (~6057 nested Prime handlers).

effect Prime {
  fn is_prime(x: i64) -> bool
}

fn sieve(i: i64, n: i64, acc: i64) -[Prime]> i64 {
  if i >= n { acc }
  else {
    if Prime.is_prime(i) {
      handle sieve(i + 1, n, acc + i) {
        Prime.is_prime(x) -> resume(if x % i == 0 { false } else { Prime.is_prime(x) })
      }
    } else {
      sieve(i + 1, n, acc)
    }
  }
}

fn main() -> i64 {
  -- Spec large input is 60000 (-> 171848738), but sieve recursion keeps
  -- one native frame per candidate and overflows the 64MB stack between
  -- n=20000 and n=30000 (2t measurement). Pinned at 20000 until frames
  -- shrink or self-tail-calls stop consuming stack (roadmap A5).
  let total = handle sieve(2, 20000, 0) {
    Prime.is_prime(x) -> resume(true)
  }
  if total == 21171191 { 0 } else { 1 }
}
