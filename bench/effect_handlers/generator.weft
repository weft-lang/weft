-- effect-handlers-bench: generator (spec large input 25 -> 67108837)
-- Sum a complete binary tree of height h via a generator that yields
-- node values in depth-first order (left, node, right). The tree is the
-- space-efficient DAG: Node(t, n, t) shares subtrees, h nodes total.
-- Exercises the Tier-5 deferred/fiber path: 2^25 - 1 yields.

use runtime/memory.{*}
use stdlib/generator as generator
use stdlib/generator.{*}
use stdlib/option.{*}

type Tree {
  Leaf,
  Node(Tree, i64, Tree)
}

fn make_tree(n: i64) -> Tree {
  if n == 0 { Leaf }
  else {
    let t = make_tree(n - 1)
    Node(t, n, t)
  }
}

fn walk(t: Tree) -[GeneratorYield]> i64 {
  match t {
    Leaf -> 0
    Node(l, v, r) -> {
      walk(l)
      generator.yield<i64>(v)
      walk(r)
    }
  }
}

fn produce() -[GeneratorYield]> i64 {
  walk(make_tree(25))
  0
}

fn main() -> i64 {
  let g = generator.start<i64, i64>(produce)
  let mut total = 0
  let mut running = true
  while running {
    match g.next() {
      Some(value) -> { total = total + value }
      None -> { running = false }
    }
  }
  if total == 67108837 { 0 } else { 1 }
}
