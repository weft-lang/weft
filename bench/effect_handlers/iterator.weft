-- effect-handlers-bench: iterator (spec large input 40000000 -> 800000020000000)
-- Emit an ascending range of values through an effect, sum in the handler.

use "runtime/memory.weft"
use "runtime/alloc.weft"

effect Emit {
  fn emit(v: i64) -> i64
}

fn range_emit(n: i64) -[Emit]> i64 {
  for i in 1..(n + 1) {
    Emit.emit(i)
  }
  0
}

fn main() -> i64 {
  let n = 40000000
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, 0)
  handle range_emit(n) {
    Emit.emit(v) -> {
      mem_store64(cell, mem_load64(cell) + v)
      resume(0)
    }
  }
  let total = mem_load64(cell)
  arena_free(arena)
  if total == 800000020000000 { 0 } else { 1 }
}
