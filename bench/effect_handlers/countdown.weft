-- effect-handlers-bench: countdown (spec large input 200000000 -> 0)
-- Count down in a loop using State get/put through a handler.
-- Deviation from the OCaml reference: the self-tail-call is written as
-- a while loop (Weft has no TCO yet — tail-call optimization); the measured work
-- (200M get/put pairs through the handler) is identical.

use runtime/memory.{*}
use runtime/alloc.{*}

effect CState {
  fn get() -> i64
  fn put(v: i64) -> i64
}

fn countdown() -[CState]> i64 {
  let mut i = CState.get()
  while i != 0 {
    CState.put(i - 1)
    i = CState.get()
  }
  i
}

fn run(n: i64) -> i64 {
  let arena = arena_new(64)
  let cell = arena_alloc(arena, 8, 8)
  mem_store64(cell, n)
  let result = handle countdown() {
    CState.get() -> resume(mem_load64(cell))
    CState.put(v) -> {
      mem_store64(cell, v)
      resume(0)
    }
  }
  arena_free(arena)
  result
}

fn main() -> i64 {
  if run(200000000) == 0 { 0 } else { 1 }
}
