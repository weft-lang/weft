-- effect-handlers-bench: product_early (spec large input 100000 -> 0)
-- Product of a 1000-element descending list ending in 0, non-tail
-- recursive, aborting via a non-resuming handler clause on the 0.
-- Builds and discards a 1000-frame stack per iteration.

effect Abort {
  fn abort() -> i64
}

type IntList {
  Nil,
  Cons(i64, IntList)
}

fn product(l: IntList) -[Abort]> i64 {
  match l {
    Nil -> 1
    Cons(x, rest) -> if x == 0 { Abort.abort() } else { x * product(rest) }
  }
}

fn run_once(l: IntList) -> i64 {
  handle product(l) {
    Abort.abort() -> 0
  }
}

fn main() -> i64 {
  -- Prepending 0..999 yields walk order 999, 998, ..., 1, 0: a
  -- descending list of 1000 numbers ending in a 0 at the deep end.
  let mut desc = Nil
  for i in 0..1000 {
    desc = Cons(i, desc)
  }
  let n = 100000
  let mut total = 0
  for i in 0..n {
    total = total + run_once(desc)
  }
  if total == 0 { 0 } else { 1 }
}
