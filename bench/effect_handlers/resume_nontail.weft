-- effect-handlers-bench: resume_nontail (spec large input 10000 -> 860)
-- Repeatedly perform an operation whose handler resumes in NON-tail
-- position: clause computes abs(x - 503*y + 37) mod 1009 where y is the
-- continuation's result. Repeated 1000 times, threading the previous
-- result as the next initial value. Exercises the deferred (Tier-5)
-- continuation path; stack depth is linear in n by design.

effect Operator {
  @deferred fn op(x: i64) -> i64
}

fn rn_loop(i: i64, initial: i64) -[Operator]> i64 {
  if i == 0 { initial }
  else {
    Operator.op(i)
    rn_loop(i - 1, initial)
  }
}

fn run_once(n: i64, initial: i64) -> i64 {
  handle rn_loop(n, initial) {
    Operator.op(x) with k -> {
      let y = k(0)
      let d = x - 503 * y + 37
      let a = if d < 0 { 0 - d } else { d }
      a % 1009
    }
  }
}

fn main() -> i64 {
  let n = 10000
  let mut result = 0
  for r in 0..1000 {
    result = run_once(n, result)
  }
  if result == 860 { 0 } else { 1 }
}
