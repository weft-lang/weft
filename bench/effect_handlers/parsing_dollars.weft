-- effect-handlers-bench: parsing_dollars (spec large input 20000 -> 200010000)
-- Parse a simulated file of n lines where line i holds i dollar chars:
-- count dollars per line, emit the count at each newline, stop on any
-- other character, and sum the emitted counts. Chars are simulated as
-- ints supplied by a Read effect; the sum accumulates in an Emit
-- handler. Exercises multiple simultaneous effects.

use "runtime/memory.weft"
use "runtime/alloc.weft"

effect PRead {
  fn read() -> i64
}

effect PEmit {
  fn emit(v: i64) -> i64
}

fn dollar() -> i64 { 36 }
fn newline() -> i64 { 10 }

fn parse_lines() -[PRead, PEmit]> i64 {
  let mut count = 0
  let mut running = 1
  while running == 1 {
    let c = PRead.read()
    if c == dollar() {
      count = count + 1
    } else { if c == newline() {
      PEmit.emit(count)
      count = 0
    } else {
      running = 0
    } }
  }
  0
}

fn main() -> i64 {
  let n = 20000
  -- Reader state: current line i (1..n), position j within the line
  -- (j < i emits a dollar, j == i emits the newline, i > n ends input).
  let arena = arena_new(64)
  let line = arena_alloc(arena, 8, 8)
  let pos = arena_alloc(arena, 8, 8)
  let acc = arena_alloc(arena, 8, 8)
  mem_store64(line, 1)
  mem_store64(pos, 0)
  mem_store64(acc, 0)
  handle {
    handle parse_lines() {
      PRead.read() -> {
        let i = mem_load64(line)
        let j = mem_load64(pos)
        if i > n {
          resume(0)
        } else { if j < i {
          mem_store64(pos, j + 1)
          resume(dollar())
        } else {
          mem_store64(line, i + 1)
          mem_store64(pos, 0)
          resume(newline())
        } }
      }
    }
  } {
    PEmit.emit(v) -> {
      mem_store64(acc, mem_load64(acc) + v)
      resume(0)
    }
  }
  let total = mem_load64(acc)
  arena_free(arena)
  if total == 200010000 { 0 } else { 1 }
}
