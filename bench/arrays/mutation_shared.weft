-- Exercise both exclusive mutation and copying with an immutable snapshot.

type Sharing { Exclusive, Shared }

fn increment(values: [mut i64]) -> nil {
  let first: usize = 0
  for index in first..values.len { values[index] = values[index] + 1 }
}

fn sum(values: [i64]) -> i64 {
  let mut total = 0
  for value in values { total = total + value }
  total
}

fn mutate(sharing: Sharing) -> i64 {
  let mut values = [1, 2, 3, 4, 5, 6, 7, 8]
  let mut observed = 0
  for _ in 0..100000 {
    match sharing {
      Exclusive -> increment(values[..])
      Shared -> {
        let snapshot = values
        increment(values[..])
        observed = observed + sum(snapshot[..])
      }
    }
  }
  sum(values[..]) + observed
}

fn main() -> i64 {
  if mutate(Shared) == 40004000036 { 0 } else { 1 }
}
