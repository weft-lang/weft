-- Each semantic boundary policy shares the same decoding and scratch scope.
use stdlib/unicode

fn main() -> i64 {
  let mut checked = 0
  for index in 0..20000 {
    let text = if index % 2 == 0 { "can't 32.3" } else { "One. Two!" }
    let valid = if index % 2 == 0 {
      text.grapheme_count() == 10 and text.word_segment_count() == 3 and text.sentence_segment_count() == 1
    } else {
      text.grapheme_count() == 9 and text.word_segment_count() == 5 and text.sentence_segment_count() == 2
    }
    if not valid { return 1 }
    checked = checked + 1
  }
  if checked == 20000 { 0 } else { 2 }
}
