-- Public decoding over alternating two- and four-byte scalars. The checksum
-- keeps scalar transport observable without timing console or file effects.
use stdlib/utf8 as utf8
use stdlib/utf8.{Utf8Decoded, Utf8Malformed}

fn main() -> i64 {
  let mut total = 0
  for index in 0..1000000 {
    let text = if index % 2 == 0 { "Ω" } else { "😀" }
    match utf8.decode_next(text, 0) {
      Utf8Decoded(_, scalar) -> { total = total + scalar }
      Utf8Malformed(_) -> return 1
    }
  }
  if total == 64724500000 { 0 } else { 2 }
}
