use stdlib/bytes as bytes
use stdlib/bytes.{Bytes}
use stdlib/option.{None, Some}
use stdlib/result.{Err, Ok}
use stdlib/websocket as websocket
use stdlib/websocket.{WebSocketText}
use stdlib/vector as vector

fn valid(payload: Bytes) -> bool {
  match websocket.message_state().write(websocket.close_handshake(), true, WebSocketText, payload, websocket.default_limits()) {
    Ok(state) -> match state.pending() { None -> true Some(kind) -> false }
    Err(error) -> false
  }
}

fn main() -> i64 {
  let mut ascii = vector.with_capacity<u8>(16384)
  let mut mixed = vector.with_capacity<u8>(16384)
  for _ in 0..4096 {
    ascii.push(97); ascii.push(98); ascii.push(99); ascii.push(100)
    mixed.push(240); mixed.push(159); mixed.push(152); mixed.push(128)
  }
  let left = bytes.from_vector(ascii)
  let right = bytes.from_vector(mixed)
  for _ in 0..1000 {
    if not valid(left) or not valid(right) { return 1 }
  }
  0
}
